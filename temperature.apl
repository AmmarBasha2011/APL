# محول درجات الحرارة
دالة تحويل_مئوي_فهرنهايت(م):
    ارجع م * 9 / 5 + 32

دالة تحويل_فهرنهايت_مئوي(ف):
    ارجع (ف - 32) * 5 / 9

دالة محول():
    اطبع "=== محول درجات الحرارة ==="
    اطبع "1- مئوي ← فهرنهايت"
    اطبع "2- فهرنهايت ← مئوي"
    اطبع "3- خروج"
    
    المتغير خيار = صحيح(ادخل("اختر: "))
    
    لو خيار == 1:
        المتغير م = عشري(ادخل("أدخل درجة الحرارة بالمئوي: "))
        المتغير ف = تحويل_مئوي_فهرنهايت(م)
        اطبع م, "°م =", ف, "°ف"
    الا لو خيار == 2:
        المتغير ف = عشري(ادخل("أدخل درجة الحرارة بالفهرنهايت: "))
        المتغير م = تحويل_فهرنهايت_مئوي(ف)
        اطبع ف, "°ف =", م, "°م"
    الا لو خيار == 3:
        اطبع "مع السلامة"
        ارجع
    الا:
        اطبع "اختيار غير صحيح"
    
    محول()

محول()
