# سلسلة فيبوناتشي
دالة فيبوناتشي(ن):
    لو ن <= 0:
        ارجع []
    الا لو ن == 1:
        ارجع [0]
    الا لو ن == 2:
        ارجع [0, 1]
    
    المتغير سلسلة = [0, 1]
    لكل عداد في نطاق(2, ن):
        المتغير التالي = سلسلة[عداد - 1] + سلسلة[عداد - 2]
        سلسلة.أضف(التالي)
    
    ارجع سلسلة

المتغير عدد = صحيح(ادخل("أدخل عدد حدود فيبوناتشي: "))
المتغير نتيجة = فيبوناتشي(عدد)
اطبع "سلسلة فيبوناتشي:", نتيجة

المتغير مجموع = مجموع(نتيجة)
اطبع "مجموع الأعداد:", مجموع

المتغير معكوس = نتيجة
معكوس.عكس()
اطبع "المعكوس:", معكوس
