# برنامج آلة حاسبة بلغة APL

دالة جمع(أ, ب):
    ارجع أ + ب

دالة طرح(أ, ب):
    ارجع أ - ب

دالة ضرب(أ, ب):
    ارجع أ * ب

دالة قسمة(أ, ب):
    لو ب == 0:
        ارجع "خطأ: لا يمكن القسمة على صفر!"
    ارجع أ / ب

أبدا:
    اطبع "=== آلة حاسبة APL ==="
    اطبع "1. جمع (+)"
    اطبع "2. طرح (-)"
    اطبع "3. ضرب (*)"
    اطبع "4. قسمة (/)"
    اطبع "5. خروج"
    
    المتغير خيار = ادخل("اختر العملية (1-5): ")
    
    لو خيار == "5":
        اطبع "شكراً لاستخدامك الآلة الحاسبة!"
        توقف
        
    لو خيار في ["1", "2", "3", "4"]:
        حاول:
            المتغير العدد1 = عشري(ادخل("أدخل الرقم الأول: "))
            المتغير العدد2 = عشري(ادخل("أدخل الرقم الثاني: "))
            
            لو خيار == "1":
                اطبع "النتيجة:", جمع(العدد1, العدد2)
            الا لو خيار == "2":
                اطبع "النتيجة:", طرح(العدد1, العدد2)
            الا لو خيار == "3":
                اطبع "النتيجة:", ضرب(العدد1, العدد2)
            الا لو خيار == "4":
                اطبع "النتيجة:", قسمة(العدد1, العدد2)
        إمسك ValueError:
            اطبع "خطأ: يرجى إدخال أرقام صحيحة أو عشرية فقط!"
    الا:
        اطبع "خيار غير صحيح، حاول مرة أخرى."
    
    اطبع "-----------------------------"