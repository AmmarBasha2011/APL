المتغير نص1 = "  أهلاً بالعالم  "
اطبع(نص1.تقليم_يمين() + "|")
اطبع("|" + نص1.تقليم_يسار())
اطبع("hello world".حروف_عنوان())
اطبع("hello".كبّر_الأول())
اطبع("abc".بدّل_الحالة().بدّل_الحالة())
اطبع("a-b-c".تقسيم_يمين("-", 1))
اطبع("a\nb".تقسيم_أسطر())
اطبع("7".ملء_أصفار(3))
اطبع("x".وسّط(5, "*"))
اطبع("x".محاذاة_يسار(3, ".") + "x".محاذاة_يمين(3, "."))
اطبع("a=b".تقسيم_ثلاثي("="))
اطبع("hello".ابحث("l"), "hello".ابحث_يمين("l"), "hello".ابحث("z"))
اطبع("{} و {}".تنسيق(1, 2))
اطبع("123".هل_رقمي(), "abc".هل_حرفي(), "a1".هل_حرفي_رقمي(), " ".هل_مسافة(), "AB".هل_علوي(), "ab".هل_سفلي())
اطبع("abc".ترميز_بايت().فك_الترميز())
اطبع("prefix-x".إزالة_بادئة("prefix-"), "x.txt".إزالة_لاحقة(".txt"))

المتغير ق = [3, 1, 2]
ق.مسح_الكل()
اطبع(ق)

المتغير د = {"أ": 1, "ب": 2}
اطبع(قائمة(د.المفاتيح()), قائمة(د.القيم()), قائمة(د.العناصر()))
اطبع(د.اجلب("أ"), د.اجلب("ج", 0))
د.حدّث_القاموس({"ج": 3})
اطبع(د.أضف_افتراضي("د", 4), طول(د))

المتغير م1 = {1, 2}
المتغير م2 = {1, 2, 3}
اطبع(م1.جزء_من(م2), م2.يحوي_كل(م1), م1.منفصلة({9}))
اطبع(م1.فرق_متماثل(م2))
م2.تجاهل_عنصر(3)
م2.تجاهل_عنصر(99)
اطبع(م2)
