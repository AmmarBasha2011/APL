# لعبة تخمين الرقم
المتغير الحد_الأدنى = 1
المتغير الحد_الأعلى = 100
المتغير الرقم_السري = عشوائي(نطاق(1, 101))
المتغير محاولات = 0

اطبع "=== لعبة تخمين الرقم ==="
اطبع "خمن رقما بين", الحد_الأدنى, "و", الحد_الأعلى

طالما صواب:
    المتغير تخمين = صحيح(ادخل("تخمينك: "))
    محاولات = محاولات + 1
    
    لو تخمين == الرقم_السري:
        اطبع "مبروك! خمنت الرقم في", محاولات, "محاولة"
        اطبع "الرقم كان:", الرقم_السري
        توقف
    الا لو تخمين < الرقم_السري:
        اطبع "الرقم أكبر من تخمينك"
    الا:
        اطبع "الرقم أصغر من تخمينك"
