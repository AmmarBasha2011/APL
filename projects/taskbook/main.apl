استورد sys
من storage استورد افتح, أضف, أكمل, اعرض

المتغير وسائط = sys.argv[1:]
لو طول(وسائط) < 2:
    اطبع "Usage: apl run main.apl DATABASE add TITLE | list | done ID"
    sys.exit(2)
المتغير قاعدة = افتح(وسائط[0])
المتغير أمر = وسائط[1]
لو أمر == "add" و طول(وسائط) == 3:
    أضف(قاعدة, وسائط[2])
والا_لو أمر == "done" و طول(وسائط) == 3:
    أكمل(قاعدة, int(وسائط[2]))
والا_لو أمر == "list":
    لكل صف في اعرض(قاعدة):
        اطبع صف
والا:
    اطبع "Invalid command"
    sys.exit(2)
قاعدة.close()
