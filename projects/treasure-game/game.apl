# لعبة «كنز الواحة» — مشروع تجريبي مكتوب بالكامل بـ APL
# لعبة مغامرة نصية: تنقّل بين الأماكن، اجمع الأغراض، وافتح الصندوق.
#
# التشغيل:  python apl.py demos/treasure-game/game.apl
# الأوامر:  شمال | جنوب | شرق | غرب | خذ | حقيبة | وصف | مساعدة | خروج

صنف لاعب:
    دالة_إنشاء(ذات):
        ذات.مكان = "الواحة"
        ذات.حقيبة = []
        ذات.خطوات = 0

    دالة معه(ذات, غرض):
        ارجع غرض في ذات.حقيبة

المتغير الخريطة = {
    "الواحة": {
        "وصف": "أنت عند واحة صغيرة وسط الصحراء. نخلة طويلة وبئر قديم.",
        "خروج": {"شرق": "الكهف", "شمال": "الخيمة"},
        "غرض": "حبل"
    },
    "الخيمة": {
        "وصف": "خيمة تاجر قديم. على الطاولة مفتاح نحاسي صغير.",
        "خروج": {"جنوب": "الواحة"},
        "غرض": "مفتاح"
    },
    "الكهف": {
        "وصف": "كهف مظلم وبارد. في آخره صندوق خشبي مقفل.",
        "خروج": {"غرب": "الواحة", "جنوب": "البئر"},
        "غرض": لا_شيء
    },
    "البئر": {
        "وصف": "بئر عميق تحت الكهف. تلمع في قاعه قطعة ذهبية كبيرة.",
        "خروج": {"شمال": "الكهف"},
        "غرض": "ذهب"
    }
}

المتغير اللاعب = لاعب()
المتغير مأخوذ = []

دالة اعرض():
    المتغير م = الخريطة[اللاعب.مكان]
    اطبع ""
    اطبع "[" + اللاعب.مكان + "]"
    اطبع م["وصف"]
    المتغير اتجاهات = "، ".join(م["خروج"].keys())
    اطبع "الاتجاهات: " + اتجاهات
    لو م["غرض"] و ليس م["غرض"] في مأخوذ:
        اطبع "ترى هنا: " + م["غرض"]

دالة مساعدة():
    اطبع "الأوامر: شمال، جنوب، شرق، غرب، خذ، حقيبة، وصف، مساعدة، خروج"

دالة افتح_الصندوق():
    لو اللاعب.مكان != "الكهف":
        اطبع "لا يوجد صندوق هنا."
        ارجع خطأ
    لو اللاعب.معه("مفتاح"):
        اطبع "فتحت الصندوق بالمفتاح النحاسي..."
        ارجع صواب
    اطبع "الصندوق مقفل. تحتاج مفتاحا."
    ارجع خطأ

دالة خذ():
    المتغير م = الخريطة[اللاعب.مكان]
    المتغير غ = م["غرض"]
    لو غ == لا_شيء أو غ في مأخوذ:
        اطبع "لا يوجد شيء تأخذه هنا."
        ارجع
    لو غ == "ذهب" و ليس اللاعب.معه("حبل"):
        اطبع "البئر عميق جدا. تحتاج حبلا لتنزل."
        ارجع
    اللاعب.حقيبة.append(غ)
    مأخوذ.append(غ)
    اطبع "أخذت: " + غ

اطبع "=== كنز الواحة ==="
اطبع "اجمع الحبل والمفتاح، انزل البئر، ثم افتح الصندوق في الكهف."
مساعدة()
اعرض()

المتغير انتهت = خطأ
طالما ليس انتهت:
    حاول:
        المتغير أمر = ادخل("> ").strip()
    إمسك:
        اطبع ""
        اطبع "انتهى الإدخال. مع السلامة!"
        توقف

    لو أمر == "خروج":
        اطبع "مع السلامة!"
        توقف
    الا لو أمر == "مساعدة":
        مساعدة()
    الا لو أمر == "وصف":
        اعرض()
    الا لو أمر == "حقيبة":
        اطبع "الحقيبة: " + ("، ".join(اللاعب.حقيبة) إذا اللاعب.حقيبة والا "فارغة")
    الا لو أمر == "خذ":
        خذ()
    الا لو أمر == "افتح":
        لو افتح_الصندوق():
            لو اللاعب.معه("ذهب"):
                اطبع f"وجدت الكنز! أنهيت اللعبة في {اللاعب.خطوات} خطوة. مبروك!"
                انتهت = صواب
            والا:
                اطبع "الصندوق فارغ إلا من ورقة: «اجلب الذهب من البئر أولا»."
    الا لو أمر في الخريطة[اللاعب.مكان]["خروج"]:
        اللاعب.مكان = الخريطة[اللاعب.مكان]["خروج"][أمر]
        اللاعب.خطوات = اللاعب.خطوات + 1
        اعرض()
    الا:
        اطبع "لا أفهم هذا الأمر. اكتب: مساعدة"
