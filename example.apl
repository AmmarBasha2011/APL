# آلة حاسبة كاملة بالعربية
دالة آلة_حاسبة():
    اطبع "=== الآلة الحاسبة ==="
    اطبع "1- جمع"
    اطبع "2- طرح"
    اطبع "3- ضرب"
    اطبع "4- قسمة"
    اطبع "5- خروج"

    المتغير اختيار = صحيح(ادخل("اختر العملية: "))

    لو اختيار >= 1 و اختيار <= 4:
        المتغير أ = عشري(ادخل("أدخل الرقم الأول: "))
        المتغير ب = عشري(ادخل("أدخل الرقم الثاني: "))

        لو اختيار == 1:
            اطبع "النتيجة:", أ + ب
        الا لو اختيار == 2:
            اطبع "النتيجة:", أ - ب
        الا لو اختيار == 3:
            اطبع "النتيجة:", أ * ب
        الا لو اختيار == 4:
            لو ب != 0:
                اطبع "النتيجة:", أ / ب
            الا:
                اطبع "خطأ: القسمة على صفر"
    الا لو اختيار == 5:
        اطبع "مع السلامة"
        ارجع
    الا:
        اطبع "اختيار غير صحيح"

آلة_حاسبة()

# مثال: صنف (class)
صنف شخص:
    المتغير عدد = 0

    دالة __init__(ذات, اسم, عمر):
        ذات.اسم = اسم
        ذات.عمر = عمر
        شخص.عدد = شخص.عدد + 1

    دالة تعريف(ذات):
        اطبع "الاسم:", ذات.اسم, "العمر:", ذات.عمر

# مثال: خاص / عام
خاص المتغير سر = 123
عام المتغير ظاهر = "علني"

# مثال: JSON
المتغير بيانات = جسون('{"اسم": "عمار", "عمر": 25}')
اطبع "JSON:", بيانات
المتغير نص_جسون = جسون_تحويل(بيانات)
اطبع "JSON نص:", نص_جسون

# مثال: التاريخ والوقت
المتغير الآن = الساعة()
المتغير اليوم = التاريخ()
اطبع "التاريخ:", اليوم, "الوقت:", الآن