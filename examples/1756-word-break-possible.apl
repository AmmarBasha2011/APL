# مثال 1756 — هل تتقطع الجملة إلى كلمات
# Word break possible
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1756-word-break-possible.apl

# جدول للمواضع الممكنة
# نختبر كل كلمة عند كل موضع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تتقطع(س, كلمات):
  ن = طول(س)
  ممكن = [صواب]
  لكل ك في نطاق(ن):
    ممكن.append(خطأ)
  لكل ي في نطاق(1, ن + 1):
    لكل ك في كلمات:
      ط = طول(ك)
      لو ط <= ي:
        لو ممكن[ي - ط] و س[ي - ط:ي] == ك:
          ممكن[ي] = صواب
  ارجع ممكن[ن]

تأكد_يساوي(تتقطع("applepen", ["apple", "pen"]), صواب, "تقطيع")
تأكد_يساوي(تتقطع("catsand", ["cats", "dog"]), خطأ, "لا")
تأكد_يساوي(تتقطع("", ["a"]), صواب, "فارغ")
