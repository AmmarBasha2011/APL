# مثال 3178 — الحد النوني بخطوة 31
# Nth term step 31
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3178-nth-term-arithmetic-sequence-step-31.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 31

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 34, "حالة 2")
تأكد_يساوي(ف(10), 282, "حالة 3")
تأكد_يساوي(ف(100), 3072, "حالة 4")
