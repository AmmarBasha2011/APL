# مثال 4338 — مجموع الأعداد من 48 إلى ن
# Sum from 48 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4338-sum-of-integers-from-48-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(48, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(48), 48, "حالة 1")
تأكد_يساوي(ف(49), 97, "حالة 2")
تأكد_يساوي(ف(58), 583, "حالة 3")
تأكد_يساوي(ف(100), 3922, "حالة 4")
