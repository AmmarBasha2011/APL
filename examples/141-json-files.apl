# مثال 141 — حفظ وقراءة JSON من ملف
# JSON file save and load
# Demonstrates: اكتب_ملف_جسون، اقرأ_ملف_جسون
#
# Run:  python apl.py examples/141-json-files.apl

المتغير مسار = "/tmp/apl_json_demo.json"
المتغير إعدادات = {"اللغة": "العربية", "السمة": "داكنة", "الخط": 14}

اكتب_ملف_جسون(إعدادات, مسار)
اطبع "حُفظ في:", مسار

المتغير مقروء = اقرأ_ملف_جسون(مسار)
اطبع "السمة:", مقروء["السمة"]
اطبع "حجم الخط:", مقروء["الخط"]

احذف_ملف(مسار)
اطبع "تم التنظيف."
