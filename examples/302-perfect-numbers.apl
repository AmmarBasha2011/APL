# مثال 302 — الأعداد الكاملة
# Perfect numbers
# Demonstrates: مجموع القواسم
#
# Run:  python apl.py examples/302-perfect-numbers.apl

دالة كامل(عدد):
    المتغير مجموع = 0
    لكل ق في نطاق(1, عدد):
        لو عدد % ق == 0:
            مجموع = مجموع + ق
    ارجع مجموع == عدد

اطبع "6:", كامل(6)
اطبع "28:", كامل(28)
اطبع "12:", كامل(12)

المتغير قائمة = [ن لكل ن في نطاق(1, 10000) لو كامل(ن)]
اطبع "الكاملة حتى 10000:", قائمة
