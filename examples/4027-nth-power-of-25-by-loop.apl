# مثال 4027 — قوة 25 بالحلقة
# Power of 25 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4027-nth-power-of-25-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 25
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 25, "حالة 2")
تأكد_يساوي(ف(3), 15625, "حالة 3")
تأكد_يساوي(ف(6), 244140625, "حالة 4")
تأكد_يساوي(ف(10), 95367431640625, "حالة 5")
