# مثال 2242 — مجموع كل زوج متتالي
# Sum of consecutive pairs
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2242-list-flatten-pairs-sum-first-second.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ي في نطاق(طول(ق) - 1):
    ر = ر + [ق[ي] + ق[ي + 1]]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [4, 3], "حالة 1")
تأكد_يساوي(ف([5]), [], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [3, 5, 7, 9, 11], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-2, 7, 14, 11], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [30, 30, 40, 50, 30], "حالة 5")
