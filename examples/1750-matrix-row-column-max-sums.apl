# مثال 1750 — أكبر مجموع صف أو عمود
# Max row or column sum
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1750-matrix-row-column-max-sums.apl

# نجمع كل صف وكل عمود
# نأخذ الأكبر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أكبر_مجموع(م):
  أفضل = 0
  لكل ي في نطاق(طول(م)):
    مجموع = 0
    لكل ك في نطاق(طول(م[0])):
      مجموع = مجموع + م[ي][ك]
    أفضل = أكبر(أفضل, مجموع)
  لكل ك في نطاق(طول(م[0])):
    مجموع = 0
    لكل ي في نطاق(طول(م)):
      مجموع = مجموع + م[ي][ك]
    أفضل = أكبر(أفضل, مجموع)
  ارجع أفضل

تأكد_يساوي(أكبر_مجموع([[1, 2], [3, 4]]), 7, "عمود")
تأكد_يساوي(أكبر_مجموع([[5, 5], [0, 0]]), 10, "صف")
