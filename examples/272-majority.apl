# مثال 272 — العنصر الأغلبي (بوير-مور)
# Boyer-Moore majority vote
# Demonstrates: إيجاد العنصر الأكثر تكرارا بلا عد كامل
#
# Run:  python apl.py examples/272-majority.apl

دالة أغلبي(قائمة):
    المتغير مرشح = قائمة[0]
    المتغير رصيد = 1
    لكل ي في نطاق(1, طول(قائمة)):
        لو قائمة[ي] == مرشح:
            رصيد = رصيد + 1
        الا:
            رصيد = رصيد - 1
        لو رصيد == 0:
            مرشح = قائمة[ي]
            رصيد = 1
    ارجع مرشح

اطبع أغلبي([3, 2, 3])
اطبع أغلبي([2, 2, 1, 1, 1, 2, 2])
