# مثال 3737 — مجموع الأعداد من 32 إلى ن
# Sum from 32 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3737-sum-of-integers-from-32-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(32, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(32), 32, "حالة 1")
تأكد_يساوي(ف(33), 65, "حالة 2")
تأكد_يساوي(ف(42), 407, "حالة 3")
تأكد_يساوي(ف(100), 4554, "حالة 4")
