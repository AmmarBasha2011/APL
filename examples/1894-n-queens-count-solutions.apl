# مثال 1894 — عدد حلول الملكات
# Count N-Queens solutions
# Demonstrates: تراجع
#
# Run:  python apl.py examples/1894-n-queens-count-solutions.apl

# نضع ملكة في كل صف على عمود آمن
# نفحص العمود والقطرين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة آمن(مواضع, صف, عمود):
  لكل ص في نطاق(صف):
    ع = مواضع[ص]
    لو ع == عمود:
      ارجع خطأ
    لو ع - عمود == ص - صف:
      ارجع خطأ
    لو عمود - ع == ص - صف:
      ارجع خطأ
  ارجع صواب

دالة ملكات(ن, مواضع):
  صف = طول(مواضع)
  لو صف == ن:
    ارجع 1
  عد = 0
  لكل عمود في نطاق(ن):
    لو آمن(مواضع, صف, عمود):
      عد = عد + ملكات(ن, مواضع + [عمود])
  ارجع عد

تأكد_يساوي(ملكات(4, []), 2, "رقعة ٤")
تأكد_يساوي(ملكات(5, []), 10, "رقعة ٥")
تأكد_يساوي(ملكات(6, []), 4, "رقعة ٦")
