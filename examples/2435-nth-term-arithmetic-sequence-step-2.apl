# مثال 2435 — الحد النوني بخطوة 2
# Nth term step 2
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2435-nth-term-arithmetic-sequence-step-2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 2

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 5, "حالة 2")
تأكد_يساوي(ف(10), 21, "حالة 3")
تأكد_يساوي(ف(100), 201, "حالة 4")
