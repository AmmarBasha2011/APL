# مثال 2407 — ضرب كل عنصر في 5
# Multiply each item by 5
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2407-list-multiply-each-by-5.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 5]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [15, 5, 10], "حالة 1")
تأكد_يساوي(ف([5]), [25], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [5, 10, 15, 20, 25, 30], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-10, 0, 35, 35, 20], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [50, 100, 50, 150, 100, 50], "حالة 5")
