# مثال 668 — التلدين المحاكى لمندوب السفر
# Simulated annealing TSP
# Demonstrates: تلدين، قبول احتمالي، تبريد
#
# Run:  python apl.py examples/668-simulated-annealing-tsp.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# التلدين المحاكى لمندوب السفر
# Demonstrates: قبول احتمالي للأسوأ, جدول تبريد, مبادلة مقطع
# يهرب من الحلول المحلية بقبول مؤقت للتراجع

بذرة = [123]
دالة تالي(ب):
  ب[0] = (ب[0] * 1103515245 + 12345) % 2147483648
  ارجع ب[0]

مدن = [[0, 0], [2, 4], [5, 1], [7, 5], [3, 7], [9, 2], [1, 8], [6, 3]]

دالة مربع_مسافة(أ, ب):
  فرق_س = مدن[أ][0] - مدن[ب][0]
  فرق_ص = مدن[أ][1] - مدن[ب][1]
  ارجع فرق_س * فرق_س + فرق_ص * فرق_ص

دالة طول_جولة(جولة):
  حاصل = 0
  لكل ي في نطاق(طول(جولة)):
    حاصل = حاصل + مربع_مسافة(جولة[ي], جولة[(ي + 1) % طول(جولة)])
  ارجع حاصل

جولة = [0, 1, 2, 3, 4, 5, 6, 7]
بداية = طول_جولة(جولة)
حرارة = 50.0
لكل خطوة في نطاق(2000):
  ي = تالي(بذرة) % 8
  ج = تالي(بذرة) % 8
  لو ي > ج:
    ت = ي
    ي = ج
    ج = ت
  لو ي != ج:
    مقطع = جولة[ي:ج + 1]
    مقطع = مقطع[::-1]
    مرشحة = جولة[:ي] + مقطع + جولة[ج + 1:]
    فرق = طول_جولة(مرشحة) - طول_جولة(جولة)
    لو فرق < 0:
      جولة = مرشحة
    والا:
      لو فرق < 3 و تالي(بذرة) % 100 < حرارة:
        جولة = مرشحة
  حرارة = حرارة * 0.999

نهاية = طول_جولة(جولة)
تأكد_يساوي(نهاية < بداية, صواب, "تحسن عن البداية")
تأكد_يساوي(طول(مجموعة_فريدة(جولة)), 8, "كل المدن مرة واحدة")
اطبع "بداية:", بداية
اطبع "نهاية:", نهاية
