# مثال 1817 — هل نص تدوير لآخر
# String rotation check
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1817-string-rotation-check.apl

# الطول متساو
# نبحث في النص مكرراً مرتين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تدوير(أ, ب):
  لو طول(أ) != طول(ب):
    ارجع خطأ
  ارجع (أ + أ).find(ب) != -1

تأكد_يساوي(تدوير("abcde", "cdeab"), صواب, "تدوير")
تأكد_يساوي(تدوير("abcde", "abced"), خطأ, "ليس تدويراً")
تأكد_يساوي(تدوير("a", "a"), صواب, "حرف")
