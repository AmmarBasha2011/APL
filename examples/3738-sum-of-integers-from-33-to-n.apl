# مثال 3738 — مجموع الأعداد من 33 إلى ن
# Sum from 33 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3738-sum-of-integers-from-33-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(33, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(33), 33, "حالة 1")
تأكد_يساوي(ف(34), 67, "حالة 2")
تأكد_يساوي(ف(43), 418, "حالة 3")
تأكد_يساوي(ف(100), 4522, "حالة 4")
