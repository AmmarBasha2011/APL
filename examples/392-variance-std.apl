# مثال 392 — التباين والانحراف المعياري
# Variance and std dev
# Demonstrates: حساب يدوي مع تربيعي
#
# Run:  python apl.py examples/392-variance-std.apl

دالة تباين_انحراف(قائمة):
    المتغير مجموع = 0
    لكل ق in قائمة:
        مجموع = مجموع + ق
    المتغير م = مجموع / طول(قائمة)
    المتغير تربيع = 0
    لكل ق in قائمة:
        تربيع = تربيع + (ق - م) * (ق - م)
    المتغير تباين = تربيع / طول(قائمة)
    ارجع [تباين, جذر(تباين)]

المتغير بيانات = [2, 4, 4, 4, 5, 5, 7, 9]
المتغير نتيجة = تباين_انحراف(بيانات)
اطبع "التباين:", نتيجة[0]
اطبع "الانحراف المعياري:", نتيجة[1]
