# مثال 3284 — ضرب كل عنصر في 38
# Multiply each item by 38
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3284-list-multiply-each-by-38.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 38]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [114, 38, 76], "حالة 1")
تأكد_يساوي(ف([5]), [190], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [38, 76, 114, 152, 190, 228], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-76, 0, 266, 266, 152], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [380, 760, 380, 1140, 760, 380], "حالة 5")
