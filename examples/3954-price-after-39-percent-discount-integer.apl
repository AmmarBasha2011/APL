# مثال 3954 — السعر بعد خصم 39 بالمئة
# Price after 39 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3954-price-after-39-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 39 // 100

تأكد_يساوي(ف(100), 61, "حالة 1")
تأكد_يساوي(ف(250), 153, "حالة 2")
تأكد_يساوي(ف(999), 610, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
