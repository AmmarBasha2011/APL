# مثال 2249 — فهرسا مجموع تسعة
# Two sum target nine
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2249-list-two-sum-indices-target-nine.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لكل ي في نطاق(طول(ق)):
    لكل ك في نطاق(ي + 1, طول(ق)):
      لو ق[ي] + ق[ك] == 9:
        ارجع [ي, ك]
  ارجع []

تأكد_يساوي(ف([2, 7, 11, 15]), [0, 1], "حالة 1")
تأكد_يساوي(ف([1, 2, 3]), [], "حالة 2")
تأكد_يساوي(ف([4, 5]), [0, 1], "حالة 3")
تأكد_يساوي(ف([3, 6, 1, 8]), [0, 1], "حالة 4")
