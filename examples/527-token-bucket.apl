# مثال 527 — دلو الرموز
# Token bucket rate limiter
# Demonstrates: دلو رموز، تحديد معدل
#
# Run:  python apl.py examples/527-token-bucket.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# دلو الرموز: محدد معدل الطلبات
صنف دلو_رموز:
    دالة_إنشاء(ذات, سعة, معدل):
        ذات.سعة = سعة
        ذات.رموز = سعة
        ذات.معدل = معدل
    دالة تعبئة(ذات, ثوان):
        ذات.رموز = أصغر(ذات.سعة, ذات.رموز + ثوان * ذات.معدل)
    دالة اسمح(ذات):
        لو ذات.رموز >= 1:
            ذات.رموز = ذات.رموز - 1
            ارجع صواب
        ارجع خطأ

المتغير دلو = دلو_رموز(3, 1)
تأكد_يساوي(دلو.اسمح(), صواب, "أول طلب")
تأكد_يساوي(دلو.اسمح(), صواب, "ثاني طلب")
تأكد_يساوي(دلو.اسمح(), صواب, "ثالث طلب")
تأكد_يساوي(دلو.اسمح(), خطأ, "الرابع مرفوض")
دلو.تعبئة(2)
تأكد_يساوي(دلو.اسمح(), صواب, "بعد ثانيتين")
تأكد_يساوي(دلو.رموز, 1, "بقي رمز واحد")
