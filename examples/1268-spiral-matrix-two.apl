# مثال 1268 — حلزون ملء
# Generate spiral matrix
# Demonstrates: حدود أربعة
#
# Run:  python apl.py examples/1268-spiral-matrix-two.apl

# نملأ الضلع العلوي ثم الأيمن ثم السفلي ثم الأيسر
# ونضيق الحدود بعد كل ضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة املأ_حلزونيا(ن):
  م = []
  لكل ع في نطاق(ن):
    م.ألحق([0] * ن)
  أعلى = 0
  أسفل = ن - 1
  يسار = 0
  يمين = ن - 1
  ق = 1
  طالما (أعلى <= أسفل) و (يسار <= يمين):
    لكل ج في نطاق(يسار, يمين + 1):
      م[أعلى][ج] = ق
      ق = ق + 1
    أعلى = أعلى + 1
    لكل ص في نطاق(أعلى, أسفل + 1):
      م[ص][يمين] = ق
      ق = ق + 1
    يمين = يمين - 1
    لو أعلى <= أسفل:
      لكل ج في نطاق(يمين, يسار - 1, -1):
        م[أسفل][ج] = ق
        ق = ق + 1
      أسفل = أسفل - 1
    لو يسار <= يمين:
      لكل ص في نطاق(أسفل, أعلى - 1, -1):
        م[ص][يسار] = ق
        ق = ق + 1
      يسار = يسار + 1
  ارجع م

تأكد_يساوي(املأ_حلزونيا(3), [[1,2,3],[8,9,4],[7,6,5]], "ثلاثة")
تأكد_يساوي(املأ_حلزونيا(1), [[1]], "واحد")
تأكد_يساوي(املأ_حلزونيا(4), [[1,2,3,4],[12,13,14,5],[11,16,15,6],[10,9,8,7]], "أربعة")
