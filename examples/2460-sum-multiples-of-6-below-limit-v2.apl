# مثال 2460 — مجموع مضاعفات 6 تحت حد
# Sum of multiples of 6 below limit
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2460-sum-multiples-of-6-below-limit-v2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(0, ن, 6):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(7), 6, "حالة 2")
تأكد_يساوي(ف(12), 6, "حالة 3")
تأكد_يساوي(ف(50), 216, "حالة 4")
تأكد_يساوي(ف(100), 816, "حالة 5")
