# مثال 3139 — إضافة 32 لكل عنصر
# Add 32 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3139-list-add-32-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 32]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [35, 33, 34], "حالة 1")
تأكد_يساوي(ف([5]), [37], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [33, 34, 35, 36, 37, 38], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [30, 32, 39, 39, 36], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [42, 52, 42, 62, 52, 42], "حالة 5")
