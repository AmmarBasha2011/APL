# مثال 3259 — مجموع ord مع إزاحة 9
# Sum of ord values plus 9 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3259-sum-of-ord-values-offset-9.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 9
  ارجع م

تأكد_يساوي(ف("a"), 106, "حالة 1")
تأكد_يساوي(ف("abc"), 321, "حالة 2")
تأكد_يساوي(ف("xyz"), 390, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
