# مثال 3510 — مجموع قوى 41
# Sum of powers of 41
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3510-sum-of-powers-of-41-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 41 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 42, "حالة 2")
تأكد_يساوي(ف(3), 70644, "حالة 3")
تأكد_يساوي(ف(6), 4868856847, "حالة 4")
تأكد_يساوي(ف(10), 13758225792906211, "حالة 5")
