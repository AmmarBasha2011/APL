# مثال 1394 — أولية دائرية
# Circular primes
# Demonstrates: رياضيات
#
# Run:  python apl.py examples/1394-circular-primes.apl

# ندير الأرقام بنقل أول رقم لآخره
# كل دوران يجب أن يكون أولياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  ع = 2
  طالما ع * ع <= ن:
    لو ن % ع == 0:
      ارجع خطأ
    ع = ع + 1
  ارجع صواب

دالة دائري(ن):
  ن_نص = نص(ن)
  لكل ع في نطاق(طول(ن_نص)):
    دوران = ن_نص[ع:] + ن_نص[:ع]
    لو ليس اولي(صحيح(دوران)):
      ارجع خطأ
  ارجع صواب

دالة عد_دائرية(حد):
  عدد = 0
  لكل ن في نطاق(2, حد):
    لو دائري(ن):
      عدد = عدد + 1
  ارجع عدد

تأكد_يساوي(دائري(197), صواب, "مئة وسبعة وتسعون")
تأكد_يساوي(دائري(19), خطأ, "تسعة عشر")
تأكد_يساوي(عد_دائرية(100), 13, "أقل من مئة")
