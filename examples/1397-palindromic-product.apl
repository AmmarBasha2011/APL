# مثال 1397 — حاصل ضرب متماثل
# Largest palindromic product
# Demonstrates: رياضيات
#
# Run:  python apl.py examples/1397-palindromic-product.apl

# نجرب كل الأزواج من الأكبر
# ونقارن النص بنص_عكسيه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متماثل(ن):
  ن_نص = نص(ن)
  نص_عكسي = ""
  لكل ح في ن_نص:
    نص_عكسي = ح + نص_عكسي
  ارجع ن_نص == نص_عكسي

دالة اكبر_حاصل(ارقام):
  ادنى = 10 ** (ارقام - 1)
  اعلى = 10 ** ارقام - 1
  افضل = 0
  لكل أ في نطاق(اعلى, ادنى - 1, -1):
    لكل ب في نطاق(أ, ادنى - 1, -1):
      ض = أ * ب
      لو ض > افضل:
        لو متماثل(ض):
          افضل = ض
  ارجع افضل

تأكد_يساوي(اكبر_حاصل(1), 9, "رقم واحد")
تأكد_يساوي(اكبر_حاصل(2), 9009, "رقمان")
تأكد_يساوي(متماثل(12321), صواب, "متماثل")
