# مثال 3593 — مجموع المربعات من 15 إلى ن
# Sum of squares from 15
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3593-sum-of-squares-from-15-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(15, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(15), 225, "حالة 1")
تأكد_يساوي(ف(16), 481, "حالة 2")
تأكد_يساوي(ف(25), 4510, "حالة 3")
تأكد_يساوي(ف(100), 337335, "حالة 4")
