# مثال 2064 — فرز الألوان بعلم هولندا
# Dutch national flag sort
# Demonstrates: فرز
#
# Run:  python apl.py examples/2064-sort-colors-dutch-flag-three-way.apl

# # الصفر يذهب لليسار والاثنان لليمين
# # نمر مرة واحدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة الوان(ق):
  ق = ق[:]
  ي = 0
  ك = 0
  ل = طول(ق) - 1
  طالما ك <= ل:
    لو ق[ك] == 0:
      ت = ق[ي]
      ق[ي] = ق[ك]
      ق[ك] = ت
      ي = ي + 1
      ك = ك + 1
    والا_لو ق[ك] == 2:
      ت = ق[ل]
      ق[ل] = ق[ك]
      ق[ك] = ت
      ل = ل - 1
    والا:
      ك = ك + 1
  ارجع ق

تأكد_يساوي(الوان([2, 0, 2, 1, 1, 0]), [0, 0, 1, 1, 2, 2], "ستة")
تأكد_يساوي(الوان([2, 0, 1]), [0, 1, 2], "ثلاثة")
تأكد_يساوي(الوان([1]), [1], "واحد")
