# مثال 2809 — السعر مع ضريبة 4 بالمئة
# Price with 4 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2809-price-with-4-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 4 // 100

تأكد_يساوي(ف(100), 104, "حالة 1")
تأكد_يساوي(ف(250), 260, "حالة 2")
تأكد_يساوي(ف(999), 1038, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
