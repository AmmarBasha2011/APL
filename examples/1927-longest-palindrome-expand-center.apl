# مثال 1927 — أطول نص متماثل بالتوسع من المركز
# Longest palindromic substring by center expansion
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1927-longest-palindrome-expand-center.apl

# لكل مركز نوسع طالما تطابق الطرفان
# نحفظ الأطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة وسع(س, ي, ك):
  طالما ي >= 0 و ك < طول(س) و س[ي] == س[ك]:
    ي = ي - 1
    ك = ك + 1
  ارجع س[ي + 1:ك]

دالة أطول_متماثل(س):
  أفضل = ""
  لكل م في نطاق(طول(س)):
    فردي = وسع(س, م, م)
    زوجي = وسع(س, م, م + 1)
    لو طول(فردي) > طول(أفضل):
      أفضل = فردي
    لو طول(زوجي) > طول(أفضل):
      أفضل = زوجي
  ارجع أفضل

تأكد_يساوي(أطول_متماثل("babad"), "bab", "babad")
تأكد_يساوي(أطول_متماثل("cbbd"), "bb", "زوجي")
تأكد_يساوي(أطول_متماثل("a"), "a", "حرف")
