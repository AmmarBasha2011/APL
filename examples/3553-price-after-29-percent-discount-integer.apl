# مثال 3553 — السعر بعد خصم 29 بالمئة
# Price after 29 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3553-price-after-29-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 29 // 100

تأكد_يساوي(ف(100), 71, "حالة 1")
تأكد_يساوي(ف(250), 178, "حالة 2")
تأكد_يساوي(ف(999), 710, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
