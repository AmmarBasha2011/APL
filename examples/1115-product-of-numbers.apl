# مثال 1115 — حاصل ضرب آخر الأعداد
# Product of the last K numbers
# Demonstrates: ضرب تراكمي
#
# Run:  python apl.py examples/1115-product-of-numbers.apl

# نحفظ حاصل الضرب التراكمي ونعيد البناء عند الصفر
# وحاصل الآخر ك قسمة تراكميين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف حاصل_ضرب:
    دالة_إنشاء(ذات):
        ذات.تراكمي = [1]

    دالة اضف_عدد(ذات, س):
        لو س == 0:
            ذات.تراكمي = [1]
        والا:
            ذات.تراكمي.ألحق(ذات.تراكمي[-1] * س)

    دالة اخر(ذات, ك):
        لو ك >= طول(ذات.تراكمي):
            ارجع 0
        ارجع ذات.تراكمي[-1] // ذات.تراكمي[-1 - ك]

ح = حاصل_ضرب()
لكل س في [3, 0, 2, 5, 4]:
    ح.اضف_عدد(س)
تأكد_يساوي(ح.اخر(2), 20, "آخر اثنين")
تأكد_يساوي(ح.اخر(3), 40, "آخر ثلاثة")
تأكد_يساوي(ح.اخر(4), 0, "يشمل الصفر")
ح.اضف_عدد(8)
تأكد_يساوي(ح.اخر(2), 32, "بعد إضافة 8")
