# مثال 4191 — مجموع المربعات من 22 إلى ن
# Sum of squares from 22
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4191-sum-of-squares-from-22-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(22, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(22), 484, "حالة 1")
تأكد_يساوي(ف(23), 1013, "حالة 2")
تأكد_يساوي(ف(32), 8129, "حالة 3")
تأكد_يساوي(ف(100), 335039, "حالة 4")
