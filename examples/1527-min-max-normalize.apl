# مثال 1527 — التطبيع بين صفر وواحد
# Min max normalization
# Demonstrates: إحصاء
#
# Run:  python apl.py examples/1527-min-max-normalize.apl

# نطرح الأصغر من كل قيمة
# نقسم على المدى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة طبّع(أ):
  صغرى = أ[0]
  كبرى = أ[0]
  لكل ع في أ:
    لو ع < صغرى:
      صغرى = ع
    لو ع > كبرى:
      كبرى = ع
  مدى = كبرى - صغرى
  ناتج = []
  لكل ع في أ:
    لو مدى == 0:
      ناتج.append(0.0)
    والا:
      ناتج.append((ع - صغرى) / مدى)
  ارجع ناتج

تأكد_يساوي(طبّع([10, 20, 30]), [0.0, 0.5, 1.0], "ثلاث قيم")
تأكد_يساوي(طبّع([4, 4]), [0.0, 0.0], "متساوية")
