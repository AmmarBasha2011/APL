# مثال 845 — أولية صوفي جرمان
# Sophie Germain primes
# Demonstrates: ف و 2ف+1 أوليان
#
# Run:  python apl.py examples/845-sophie-germain.apl

# أولية صوفي جرمان: ف أولي و 2ف+1 أولي أيضاً
# فُقدت في برهان صوفي جرمان لحالة من مبرهنة فيرما الأخيرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أولي(ن):
  لو ن < 2:
    ارجع خطأ
  لو ن < 4:
    ارجع 1 == 1
  لو ن % 2 == 0:
    ارجع خطأ
  قاسم = 3
  طالما قاسم * قاسم <= ن:
    لو ن % قاسم == 0:
      ارجع خطأ
    قاسم = قاسم + 2
  ارجع 1 == 1

صوفي = []
لكل ف في نطاق(2, 100):
  لو أولي(ف) و أولي(2 * ف + 1):
    صوفي.ألحق(ف)

اطبع "أولية صوفي جرمان تحت 100:", صوفي

تأكد_يساوي(طول(صوفي), 10, "عشرة تحت 100")
تأكد_يساوي(صوفي[0], 2, "الأول")
تأكد_يساوي(صوفي[3], 11, "الرابع")
تأكد_يساوي(صوفي[9], 89, "الأخير")

# تحقق: 2*41+1 = 83 أولي (الزوج الآمن المقابل)
تأكد_يساوي(أولي(2 * 41 + 1), 1 == 1, "83 أولي آمن")
تأكد_يساوي(أولي(2 * 7 + 1), خطأ, "7 ليست صوفي لأن 15 مفكك")
