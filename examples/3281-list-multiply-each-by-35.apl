# مثال 3281 — ضرب كل عنصر في 35
# Multiply each item by 35
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3281-list-multiply-each-by-35.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 35]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [105, 35, 70], "حالة 1")
تأكد_يساوي(ف([5]), [175], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [35, 70, 105, 140, 175, 210], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-70, 0, 245, 245, 140], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [350, 700, 350, 1050, 700, 350], "حالة 5")
