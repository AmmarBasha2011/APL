# مثال 1124 — نظام المترو
# Underground system average travel time
# Demonstrates: تسجيل الدخول والخروج
#
# Run:  python apl.py examples/1124-underground-system.apl

# نسجل وقت دخول كل راكب ومحطته
# وعند الخروج نخزن زمن الرحلة لحساب المتوسط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مترو:
    دالة_إنشاء(ذات):
        ذات.ركاب = []
        ذات.دخول = []
        ذات.ازواج = []
        ذات.ازمنة = []

    دالة دخل(ذات, رقم, محطة, وقت):
        ذات.ركاب.ألحق(رقم)
        ذات.دخول.ألحق([محطة, وقت])

    دالة خرج(ذات, رقم, محطة, وقت):
        ف = 0
        طالما ذات.ركاب[ف] != رقم:
            ف = ف + 1
        بدأ = ذات.دخول[ف]
        ذات.ركاب[ف] = -1
        زوج = [بدأ[0], محطة]
        لو زوج ليس في ذات.ازواج:
            ذات.ازواج.ألحق(زوج)
            ذات.ازمنة.ألحق([])
        ك = 0
        طالما ذات.ازواج[ك] != زوج:
            ك = ك + 1
        ذات.ازمنة[ك].ألحق(وقت - بدأ[1])

    دالة متوسط_رحلة(ذات, من, الى):
        ك = 0
        طالما ذات.ازواج[ك] != [من, الى]:
            ك = ك + 1
        مج = 0
        لكل ز في ذات.ازمنة[ك]:
            مج = مج + ز
        ارجع مج / طول(ذات.ازمنة[ك])

م = مترو()
م.دخل(45, "Leyton", 3)
م.دخل(32, "Paradise", 8)
م.دخل(27, "Leyton", 10)
م.خرج(45, "Waterloo", 15)
م.خرج(27, "Waterloo", 20)
م.خرج(32, "Cambridge", 22)
تأكد_يساوي(م.متوسط_رحلة("Paradise", "Cambridge"), 14.0, "باراديس إلى كامبريدج")
تأكد_يساوي(م.متوسط_رحلة("Leyton", "Waterloo"), 11.0, "ليتون إلى واترلو")
م.دخل(10, "Leyton", 24)
تأكد_يساوي(م.متوسط_رحلة("Leyton", "Waterloo"), 11.0, "لم يتغير بعد")
م.خرج(10, "Waterloo", 38)
تأكد_يساوي(م.متوسط_رحلة("Leyton", "Waterloo"), 12.0, "بعد رحلة ثالثة")
