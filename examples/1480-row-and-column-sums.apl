# مثال 1480 — مجاميع الصفوف والأعمدة
# Row and column sums
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1480-row-and-column-sums.apl

# نحتفظ بمجموع لكل صف ولكل عمود
# نضيف كل خانة للمجموعين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة المجاميع(م):
  صفوف = []
  أعمدة = []
  لكل ع في نطاق(طول(م[0])):
    أعمدة.append(0)
  لكل ص في م:
    مجموع = 0
    لكل ع في نطاق(طول(ص)):
      مجموع = مجموع + ص[ع]
      أعمدة[ع] = أعمدة[ع] + ص[ع]
    صفوف.append(مجموع)
  ارجع [صفوف, أعمدة]

تأكد_يساوي(المجاميع([[1, 2, 3], [4, 5, 6]]), [[6, 15], [5, 7, 9]], "اثنان في ثلاثة")
تأكد_يساوي(المجاميع([[5]]), [[5], [5]], "وحيدة")
