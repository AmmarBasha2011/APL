# مثال 2295 — قلب الصفوف عموديا
# Flip rows vertically
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2295-matrix-flip-rows-vertical.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ارجع م[::-1]

تأكد_يساوي(ف([[1, 2], [3, 4]]), [[3, 4], [1, 2]], "حالة 1")
تأكد_يساوي(ف([[5]]), [[5]], "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [[7, 8, 9], [4, 5, 6], [1, 2, 3]], "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), [[1, 0], [0, 1]], "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), [[1, 1, 1], [0, 3, 1], [2, -1, 0]], "حالة 5")
