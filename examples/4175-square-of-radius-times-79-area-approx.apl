# مثال 4175 — مساحة دائرة بتقريب 79
# Circle area with pi approx 79/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4175-square-of-radius-times-79-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 79 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 11, "حالة 2")
تأكد_يساوي(ف(7), 553, "حالة 3")
تأكد_يساوي(ف(14), 2212, "حالة 4")
تأكد_يساوي(ف(21), 4977, "حالة 5")
