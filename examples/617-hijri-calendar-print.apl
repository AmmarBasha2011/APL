# مثال 617 — طباعة شهر هجري
# Hijri month print
# Demonstrates: هجري، شبكة أسابيع، أطوال شهور
#
# Run:  python apl.py examples/617-hijri-calendar-print.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# طباعة شهر هجري كشبكة أسابيع
# Demonstrates: التقويم الهجري الاصطلاحي, أطوال الشهور, شبكة طباعة
# السنة الهجرية 354 أو 355 يوما في دورة ثلاثينية

أشهر = ["محرم", "صفر", "ربيع الأول", "ربيع الآخر", "جمادى الأولى", "جمادى الآخرة", "رجب", "شعبان", "رمضان", "شوال", "ذو القعدة", "ذو الحجة"]

دالة كبيسة(سنة):
  ارجع سنة % 30 في [2, 5, 7, 10, 13, 16, 18, 21, 24, 26, 29]

دالة طول_شهر(سنة, شهر):
  لو شهر % 2 == 1:
    ارجع 30
  لو شهر == 12 و كبيسة(سنة):
    ارجع 30
  ارجع 29

دالة طول_سنة(سنة):
  لو كبيسة(سنة):
    ارجع 355
  ارجع 354

اطبع "شبكة رمضان 1447 (بداية افتراضية: سبت):"
إزاحة = 0
سطر = ""
لكل فراغ في نطاق(إزاحة):
  سطر = سطر + "    "
لكل يوم في نطاق(1, طول_شهر(1447, 9) + 1):
  نص_يوم = نص(يوم)
  طالما طول(نص_يوم) < 3:
    نص_يوم = " " + نص_يوم
  سطر = سطر + نص_يوم + " "
  لو (يوم + إزاحة) % 7 == 0:
    اطبع سطر
    سطر = ""
لو سطر != "":
  اطبع سطر

تأكد_يساوي(طول_شهر(1447, 9), 30, "رمضان 30 في الاصطلاحي")
تأكد_يساوي(طول_سنة(1446), 354, "1446 سنة بسيطة")
تأكد_يساوي(كبيسة(1447), صواب, "1447 سنة كبيسة")
تأكد_يساوي(طول_سنة(1447), 355, "1447 فيها 355 يوما")
تأكد_يساوي(طول(أشهر), 12, "اثنا عشر شهرا")
