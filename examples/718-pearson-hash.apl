# مثال 718 — هاش بيرسون
# Pearson hashing
# Demonstrates: جدول تبديل، XOR، بايت واحد
#
# Run:  python apl.py examples/718-pearson-hash.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تجزئة بيرسون: بايت واحد بجدول تبديل
# Demonstrates: جدول تبديل 256, XOR تراكمي, تجزئة متعددة البايتات
# الجدول هنا دالة حتمية بدل تخزين 256 ثابتا

دالة جدول(ي):
  ح = (ي * 2654435761 + 1013904223) % 4294967296
  ح = ح ^ (ح // 65536)
  ح = (ح * 2246822519) % 4294967296
  ارجع ح % 256

دالة بيرسون(نص, إزاحة):
  ح = إزاحة
  لكل ي في نطاق(طول(نص)):
    ح = جدول((ح ^ ترميز_حرف(نص[ي])) % 256)
  ارجع ح

دالة بيرسون64(نص):
  مجموع = 0
  لكل إزاحة في نطاق(8):
    مجموع = مجموع * 256 + بيرسون(نص, إزاحة)
  ارجع مجموع

تأكد_يساوي(بيرسون("hello", 0), بيرسون("hello", 0), "حتمي")
تأكد_يساوي(بيرسون("hello", 0) != بيرسون("hellp", 0), صواب, "حرف يغير")
تأكد_يساوي(بيرسون("hello", 0) != بيرسون("hello", 1), صواب, "الإزاحة تغير")
م = بيرسون64("hello")
تأكد_يساوي(م, بيرسون64("hello"), "64-بت حتمي")
تأكد_يساوي(م != بيرسون64("hellp"), صواب, "64-بت حساس")
توزيع = [0] * 8
لكل ي في نطاق(800):
  توزيع[بيرسون("عنصر" + نص(ي), 0) % 8] = توزيع[بيرسون("عنصر" + نص(ي), 0) % 8] + 1
تأكد_يساوي(توزيع[0] > 60 و توزيع[0] < 140, صواب, "الدلو الأول متوازن")
اطبع "بيرسون64(hello):", م
