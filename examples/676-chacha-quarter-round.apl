# مثال 676 — ربع دورة تشاتشا
# ChaCha quarter round
# Demonstrates: دوران بتات، جمع معياري، XOR
#
# Run:  python apl.py examples/676-chacha-quarter-round.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ربع دورة تشاتشا
# Demonstrates: جمع معياري 32 بت, تدوير بتات, خلط ARX
# اللبنة التي يبنى منها تشفير ChaCha20 كله

قناع = 4294967295

دالة دوّر(س, ك):
  ارجع ((س << ك) & قناع) | (س >> (32 - ك))

دالة ربع_دورة(أ, ب, ج, د):
  أ = (أ + ب) & قناع
  د = دوّر(د ^ أ, 16)
  ج = (ج + د) & قناع
  ب = دوّر(ب ^ ج, 12)
  أ = (أ + ب) & قناع
  د = دوّر(د ^ أ, 8)
  ج = (ج + د) & قناع
  ب = دوّر(ب ^ ج, 7)
  ارجع [أ, ب, ج, د]

نتيجة = ربع_دورة(0x11111111, 0x01020304, 0x9b8d6f43, 0x01234567)
تأكد_يساوي(نتيجة, [0xea2a92f4, 0xcb1cf8ce, 0x4581472e, 0x5881c4bb], "متجه RFC")
صفر = ربع_دورة(0, 0, 0, 0)
تأكد_يساوي(صفر, [0, 0, 0, 0], "الأصفار تبقى أصفارا")
تأكد_يساوي(نتيجة[0] <= قناع, صواب, "ضمن 32 بت")
اطبع "النتيجة:", نتيجة
