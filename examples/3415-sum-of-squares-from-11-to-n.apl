# مثال 3415 — مجموع المربعات من 11 إلى ن
# Sum of squares from 11
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3415-sum-of-squares-from-11-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(11, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(11), 121, "حالة 1")
تأكد_يساوي(ف(12), 265, "حالة 2")
تأكد_يساوي(ف(21), 2926, "حالة 3")
تأكد_يساوي(ف(100), 337965, "حالة 4")
