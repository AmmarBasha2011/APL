# مثال 3181 — الحد النوني بخطوة 34
# Nth term step 34
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3181-nth-term-arithmetic-sequence-step-34.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 34

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 37, "حالة 2")
تأكد_يساوي(ف(10), 309, "حالة 3")
تأكد_يساوي(ف(100), 3369, "حالة 4")
