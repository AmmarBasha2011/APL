# مثال 3711 — مجموع قوى 46
# Sum of powers of 46
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3711-sum-of-powers-of-46-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 46 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 47, "حالة 2")
تأكد_يساوي(ف(3), 99499, "حالة 3")
تأكد_يساوي(ف(6), 9684836827, "حالة 4")
تأكد_يساوي(ف(10), 43363430760171611, "حالة 5")
