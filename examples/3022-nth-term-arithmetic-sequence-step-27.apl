# مثال 3022 — الحد النوني بخطوة 27
# Nth term step 27
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3022-nth-term-arithmetic-sequence-step-27.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 27

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 30, "حالة 2")
تأكد_يساوي(ف(10), 246, "حالة 3")
تأكد_يساوي(ف(100), 2676, "حالة 4")
