# مثال 1113 — مجموعة بحذف سريع
# Randomized set with swap delete
# Demonstrates: بدل بآخر عنصر
#
# Run:  python apl.py examples/1113-randomized-set.apl

# الحذف يبدل العنصر بآخر عنصر ثم يحذف الأخير
# فلا نحتاج إزاحة بقية العناصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مجموعة_سريعة:
    دالة_إنشاء(ذات):
        ذات.عناصر = []

    دالة ادرج(ذات, س):
        لو س في ذات.عناصر:
            ارجع خطأ
        ذات.عناصر.ألحق(س)
        ارجع صواب

    دالة ازل(ذات, س):
        لو س ليس في ذات.عناصر:
            ارجع خطأ
        ف = 0
        طالما ذات.عناصر[ف] != س:
            ف = ف + 1
        ذات.عناصر[ف] = ذات.عناصر[-1]
        ذات.عناصر.pop()
        ارجع صواب

    دالة حجم_المجموعة(ذات):
        ارجع طول(ذات.عناصر)

م = مجموعة_سريعة()
تأكد_يساوي(م.ادرج(1), صواب, "إدراج 1")
تأكد_يساوي(م.ازل(2), خطأ, "حذف غائب")
تأكد_يساوي(م.ادرج(2), صواب, "إدراج 2")
تأكد_يساوي(م.حجم_المجموعة(), 2, "حجمان")
تأكد_يساوي(م.ازل(1), صواب, "حذف 1")
تأكد_يساوي(م.ادرج(2), خطأ, "إدراج مكرر")
تأكد_يساوي(م.حجم_المجموعة(), 1, "حجم واحد")
