# مثال 4158 — السعر مع ضريبة 43 بالمئة
# Price with 43 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4158-price-with-43-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 43 // 100

تأكد_يساوي(ف(100), 143, "حالة 1")
تأكد_يساوي(ف(250), 357, "حالة 2")
تأكد_يساوي(ف(999), 1428, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
