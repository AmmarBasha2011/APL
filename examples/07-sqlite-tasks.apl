# مثال 7 — قاعدة بيانات المهام (SQLite)
# Task Database with SQLite
# Demonstrates: sqlite3 library, CRUD, cursors, transactions, file handling
#
# Run:  python apl.py examples/07-sqlite-tasks.apl

المتغير مسار_القاعدة = "_apl_tasks.db"
إذا مسار_موجود(مسار_القاعدة):
    احذف_ملف(مسار_القاعدة)

المتغير قاعدة = افتح_قاعدة(مسار_القاعدة)
المتغير مؤشر = قاعدة.مؤشر()

مؤشر.نفذ("CREATE TABLE مهام (id INTEGER PRIMARY KEY, العنوان TEXT, الحالة TEXT)")

المتغير المهام = [
    ["كتابة_الوثائق", "منجز"],
    ["مراجعة_الكود", "قيد_التنفيذ"],
    ["إطلاق_الإصدار", "منجز"]
]

المتغير رقم = 1
لكل مهمة في المهام:
    مؤشر.نفذ("INSERT INTO مهام (id, العنوان, الحالة) VALUES (?, ?, ?)",
         (رقم, مهمة[0], مهمة[1]))
    رقم = رقم + 1
قاعدة.تأكد()

اطبع "=== قاعدة بيانات المهام ==="
لكل صف في مؤشر.execute("SELECT id, العنوان, الحالة FROM مهام").جلب_الكل():
    اطبع f"  {صف[0]}. {صف[1]:20s} -> {صف[2]}"

اطبع ""
مؤشر.نفذ("UPDATE مهام SET الحالة = 'قيد_التنفيذ' WHERE العنوان = 'كتابة_الوثائق'")
قاعدة.تأكد()
اطبع "بعد التحديث (قيد التنفيذ):"
لكل صف في مؤشر.execute("SELECT العنوان FROM مهام WHERE الحالة = 'قيد_التنفيذ'").جلب_الكل():
    اطبع "  - " + صف[0]

مؤشر.نفذ("DELETE FROM مهام WHERE الحالة = 'منجز'")
قاعدة.تأكد()
المتغير الباقي = مؤشر.execute("SELECT COUNT(*) FROM مهام").جلب_واحد()
اطبع ""
اطبع "عدد المهام المتبقية: " + نص(الباقي[0])

قاعدة.أغلق_اتصال()
احذف_ملف(مسار_القاعدة)
اطبع "تم حذف ملف قاعدة البيانات المؤقت"
