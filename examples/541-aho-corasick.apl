# مثال 541 — أتمتة أهو-كوراسيك
# Aho-Corasick automaton
# Demonstrates: أنماط متعددة، أتمتة، روابط فشل
#
# Run:  python apl.py examples/541-aho-corasick.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# أتمتة أهو-كوراسيك للبحث بعدة أنماط معاً
المتغير أنماط = ["he", "she", "his", "hers"]
المتغير عقد = [قاموس()]
المتغير فشل = [0]
المتغير مخرجات = [قائمة()]

لكل نمط في أنماط:
    المتغير عقدة = 0
    لكل حرف في نمط:
        لو حرف ليس في عقد[عقدة]:
            عقد[عقدة][حرف] = طول(عقد)
            عقد.أضف(قاموس())
            فشل.أضف(0)
            مخرجات.أضف(قائمة())
        عقدة = عقد[عقدة][حرف]
    مخرجات[عقدة].أضف(نمط)

المتغير طابور = قائمة()
لكل حرف في عقد[0]:
    طابور.أضف(عقد[0][حرف])
طالما طول(طابور) > 0:
    المتغير حالية = طابور.pop(0)
    لكل حرف في عقد[حالية]:
        المتغير تالية = عقد[حالية][حرف]
        طابور.أضف(تالية)
        المتغير ج = فشل[حالية]
        طالما ج != 0 و حرف ليس في عقد[ج]:
            ج = فشل[ج]
        لو حرف في عقد[ج]:
            فشل[تالية] = عقد[ج][حرف]
        مخرجات[تالية] = مخرجات[تالية] + مخرجات[فشل[تالية]]

المتغير نص = "ushers"
المتغير عقدة = 0
المتغير نتائج = قائمة()
لكل حرف في نص:
    طالما عقدة != 0 و حرف ليس في عقد[عقدة]:
        عقدة = فشل[عقدة]
    لو حرف في عقد[عقدة]:
        عقدة = عقد[عقدة][حرف]
    لكل نمط في مخرجات[عقدة]:
        نتائج.أضف(نمط)

اطبع "التطابقات:", نتائج
تأكد_يساوي(نتائج, ["she", "he", "hers"], "أهو-كوراسيك: ثلاثة تطابقات")
