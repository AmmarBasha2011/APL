# مثال 2570 — ضرب كل عنصر في 11
# Multiply each item by 11
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2570-list-multiply-each-by-11.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 11]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [33, 11, 22], "حالة 1")
تأكد_يساوي(ف([5]), [55], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [11, 22, 33, 44, 55, 66], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-22, 0, 77, 77, 44], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [110, 220, 110, 330, 220, 110], "حالة 5")
