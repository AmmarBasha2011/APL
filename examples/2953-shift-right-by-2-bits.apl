# مثال 2953 — إزاحة يمين 2
# Shift right by 2
# Demonstrates: بتات
#
# Run:  python apl.py examples/2953-shift-right-by-2-bits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 2

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(16), 4, "حالة 2")
تأكد_يساوي(ف(255), 63, "حالة 3")
تأكد_يساوي(ف(1000), 250, "حالة 4")
تأكد_يساوي(ف(65535), 16383, "حالة 5")
