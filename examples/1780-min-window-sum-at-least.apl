# مثال 1780 — أقصر نافذة بمجموع كاف
# Shortest subarray with sum at least target
# Demonstrates: نوافذ
#
# Run:  python apl.py examples/1780-min-window-sum-at-least.apl

# نمدد اليمين حتى يكفي المجموع
# ثم نقلص اليسار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أقصر_نافذة(ق, هدف):
  يسار = 0
  مجموع = 0
  أفضل = طول(ق) + 1
  لكل يمين في نطاق(طول(ق)):
    مجموع = مجموع + ق[يمين]
    طالما مجموع >= هدف:
      أفضل = أصغر(أفضل, يمين - يسار + 1)
      مجموع = مجموع - ق[يسار]
      يسار = يسار + 1
  لو أفضل > طول(ق):
    ارجع 0
  ارجع أفضل

تأكد_يساوي(أقصر_نافذة([2, 3, 1, 2, 4, 3], 7), 2, "اثنان")
تأكد_يساوي(أقصر_نافذة([1, 1, 1], 10), 0, "لا تكفي")
تأكد_يساوي(أقصر_نافذة([5], 5), 1, "واحد")
