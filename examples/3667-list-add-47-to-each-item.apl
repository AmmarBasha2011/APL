# مثال 3667 — إضافة 47 لكل عنصر
# Add 47 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3667-list-add-47-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 47]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [50, 48, 49], "حالة 1")
تأكد_يساوي(ف([5]), [52], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [48, 49, 50, 51, 52, 53], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [45, 47, 54, 54, 51], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [57, 67, 57, 77, 67, 57], "حالة 5")
