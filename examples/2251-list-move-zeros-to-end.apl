# مثال 2251 — نقل الأصفار للنهاية
# Move zeros to end
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2251-list-move-zeros-to-end.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  ص = 0
  لكل ع في ق:
    لو ع == 0:
      ص = ص + 1
    والا:
      ر = ر + [ع]
  لكل ي في نطاق(ص):
    ر = ر + [0]
  ارجع ر

تأكد_يساوي(ف([0, 1, 0, 3]), [1, 3, 0, 0], "حالة 1")
تأكد_يساوي(ف([1, 2]), [1, 2], "حالة 2")
تأكد_يساوي(ف([0, 0]), [0, 0], "حالة 3")
تأكد_يساوي(ف([4, 0, 5, 0, 6]), [4, 5, 6, 0, 0], "حالة 4")
