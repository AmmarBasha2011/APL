# مثال 233 — نمط المراقب
# Observer pattern
# Demonstrates: اشتراك وإشعار
#
# Run:  python apl.py examples/233-observer.apl

صنف ناشر:
    دالة_إنشاء(ذات):
        ذات.مشتركون = []

    دالة اشترك(ذات, مشترك):
        ذات.مشتركون.أضف(مشترك)

    دالة أشعر(ذات, خبر):
        لكل مشترك في ذات.مشتركون:
            مشترك.استلم(خبر)

صنف مشترك:
    دالة_إنشاء(ذات, اسم):
        ذات.اسم = اسم

    دالة استلم(ذات, خبر):
        اطبع ذات.اسم, "استلم:", خبر

المتغير ن = ناشر()
ن.اشترك(مشترك("أحمد"))
ن.اشترك(مشترك("سارة"))
ن.أشعر("عدد جديد صدر!")
