# مثال 418 — مجاميع تحقق
# Checksums
# Demonstrates: مجموع بسيط و XOR
#
# Run:  python apl.py examples/418-checksum.apl

دالة مجموع_تحقق(نص_الدخل):
    المتغير مجموع = 0
    لكل حرف in نص_الدخل:
        مجموع = (مجموع + ترميز_حرف(حرف)) % 256
    ارجع مجموع

دالة تحقق_سطر(سطر):
    المتغير أجزاء = سطر.تقسيم("|")
    ارجع مجموع_تحقق(أجزاء[0]) == صحيح(أجزاء[1])

المتغير بيانات = "HELLO"
اطبع "المجموع:", مجموع_تحقق(بيانات)
اطبع "سطر صحيح؟", تحقق_سطر("HELLO|" + نص(مجموع_تحقق("HELLO")))
اطبع "سطر فاسد؟", تحقق_سطر("HELLO|1")
