# مثال 3237 — تحويل وحدة بأساس 15
# Split by base 15
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3237-minutes-to-hours-and-minutes-base-15.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 15, ن % 15]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [3, 14], "حالة 2")
تأكد_يساوي(ف(60), [4, 0], "حالة 3")
تأكد_يساوي(ف(125), [8, 5], "حالة 4")
تأكد_يساوي(ف(1000), [66, 10], "حالة 5")
