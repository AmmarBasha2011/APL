# مثال 427 — فلويد وارشال
# Floyd-Warshall
# Demonstrates: كل أزواج المسارات
#
# Run:  python apl.py examples/427-floyd-warshall.apl

المتغير ن = 4
المتغير بعيد = 999
المتغير مسافة = []
لكل ي في نطاق(ن):
    المتغير سطر = []
    لكل ز في نطاق(ن):
        لو ي == ز:
            سطر.append(0)
        الا:
            سطر.append(بعيد)
    مسافة.append(سطر)

مسافة[0][1] = 3
مسافة[0][2] = 8
مسافة[1][2] = 2
مسافة[2][3] = 1
مسافة[1][3] = 7

لكل ك في نطاق(ن):
    لكل ي في نطاق(ن):
        لكل ز في نطاق(ن):
            لو مسافة[ي][ك] + مسافة[ك][ز] < مسافة[ي][ز]:
                مسافة[ي][ز] = مسافة[ي][ك] + مسافة[ك][ز]

لكل سطر في مسافة:
    اطبع سطر
