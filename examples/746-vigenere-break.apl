# مثال 746 — كسر فيجنير
# Vigenère cryptanalysis
# Demonstrates: أعمدة، كاي تربيع، استعادة مفتاح
#
# Run:  python apl.py examples/746-vigenere-break.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# كسر تشفير فيجنير بتحليل الأعمدة (طول المفتاح معلوم)
# Demonstrates: تقسيم أعمدة, كاي تربيع ضد تكرارات الإنجليزية, استعادة المفتاح
# كل عمود هو تشفير قيصر مستقل فيكفي أفضل إزاحة لكل عمود

تكرارات = [8.2, 1.5, 2.8, 4.3, 12.7, 2.2, 2.0, 6.1, 7.0, 0.2, 0.8, 4.0, 2.4,
           6.7, 7.5, 1.9, 0.1, 6.0, 6.3, 9.1, 2.8, 1.0, 2.4, 0.2, 2.0, 0.1]

دالة أفضل_إزاحة(عمود):
  ن = طول(عمود)
  أفضل = 0
  أدنى = 1000000.0
  لكل إزاحة في نطاق(26):
    كاي = 0.0
    لكل حرف في نطاق(26):
      مرصود = 0
      لكل ي في نطاق(ن):
        لو (ترميز_حرف(عمود[ي]) - 97 - إزاحة) % 26 == حرف:
          مرصود = مرصود + 1
      متوقع = ن * تكرارات[حرف] / 100.0
      فرق = مرصود - متوقع
      كاي = كاي + فرق * فرق / (متوقع + 0.01)
    لو كاي < أدنى:
      أدنى = كاي
      أفضل = إزاحة
  ارجع أفضل

دالة اكسر(مشفر, طول_مفتاح):
  مفتاح = ""
  لكل عمود في نطاق(طول_مفتاح):
    حروف = ""
    ي = عمود
    طالما ي < طول(مشفر):
      حروف = حروف + مشفر[ي]
      ي = ي + طول_مفتاح
    مفتاح = مفتاح + فك_ترميز_حرف(أفضل_إزاحة(حروف) + 97)
  ارجع مفتاح

دالة فك_فيجنير(مشفر, مفتاح):
  ناتج = ""
  لكل ي في نطاق(طول(مشفر)):
    إزاحة = ترميز_حرف(مفتاح[ي % طول(مفتاح)]) - 97
    ناتج = ناتج + فك_ترميز_حرف((ترميز_حرف(مشفر[ي]) - 97 - إزاحة) % 26 + 97)
  ارجع ناتج

مشفر = "txiofelqprdxatgtqqgveamggsiicedxatgtqqgveamggsimurzjiwfosywgheehupessbqjacytwtbrdwuhjlwfvrptaquzjnsytirwgheehupibcpssrwanvqrhwmfmveamggsiesndszcswmsvgtxiofelqgrlwabbqhmfxyiegveamggsiedetrscsssbsveamggsiiwaeidcsoiedntvisulhqjrccfvvyknsszvqifhitoqysfvvyknsszvqif"

مفتاح = اكسر(مشفر, 5)
تأكد_يساوي(مفتاح, "lemon", "المفتاح المكتشف")
مستعاد = فك_فيجنير(مشفر, مفتاح)
تأكد_يساوي(مستعاد[0:12], "itwasthebest", "بداية النص المستعاد")
تأكد_يساوي(طول(مستعاد), طول(مشفر), "الطول محفوظ")

# نص قصير بمفتاح قصير آخر
دالة شفر_فيجنير(نص, مفتاح):
  ناتج = ""
  لكل ي في نطاق(طول(نص)):
    إزاحة = ترميز_حرف(مفتاح[ي % طول(مفتاح)]) - 97
    ناتج = ناتج + فك_ترميز_حرف((ترميز_حرف(نص[ي]) - 97 + إزاحة) % 26 + 97)
  ارجع ناتج

تأكد_يساوي(فك_فيجنير(شفر_فيجنير("hellohellohello", "abc"), "abc"), "hellohellohello", "ذهاب وإياب")

اطبع "المفتاح:", مفتاح
