# مثال 1576 — هل المصفوفة رتيبة
# Monotonic array check
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1576-monotonic-array-check.apl

# نتتبع هل ظهر صعود وهل ظهر هبوط
# الرتيبة لا يظهر فيها الاثنان

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رتيبة(أ):
  صعود = خطأ
  هبوط = خطأ
  لكل ع في نطاق(1, طول(أ)):
    لو أ[ع] > أ[ع - 1]:
      صعود = صواب
    لو أ[ع] < أ[ع - 1]:
      هبوط = صواب
  ارجع (صعود و هبوط) == خطأ

تأكد_يساوي(رتيبة([1, 2, 2, 3]), صواب, "تصاعدية")
تأكد_يساوي(رتيبة([6, 5, 4, 4]), صواب, "تنازلية")
تأكد_يساوي(رتيبة([1, 3, 2]), خطأ, "ليست رتيبة")
تأكد_يساوي(رتيبة([5]), صواب, "وحيدة")
