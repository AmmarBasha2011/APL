# مثال 2528 — مجموع قوى 9
# Sum of powers of 9
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2528-sum-of-powers-of-9-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 9 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 10, "حالة 2")
تأكد_يساوي(ف(3), 820, "حالة 3")
تأكد_يساوي(ف(6), 597871, "حالة 4")
تأكد_يساوي(ف(10), 3922632451, "حالة 5")
