# مثال 282 — التبديلات يدويا
# Permutations by hand
# Demonstrates: توليد كل الترتيبات بالتراجع
#
# Run:  python apl.py examples/282-permutations-manual.apl

دالة تبديلات(عناصر):
    لو طول(عناصر) <= 1:
        ارجع [عناصر]
    المتغير نتيجة = []
    لكل ي في نطاق(طول(عناصر)):
        المتغير باقي = عناصر[0:ي] + عناصر[ي + 1:]
        لكل ترتيب في تبديلات(باقي):
            نتيجة.أضف([عناصر[ي]] + ترتيب)
    ارجع نتيجة

اطبع تبديلات([1, 2, 3])
اطبع "عدد تبديلات 4 عناصر:", طول(تبديلات([1, 2, 3, 4]))
