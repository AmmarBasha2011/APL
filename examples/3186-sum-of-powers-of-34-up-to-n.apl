# مثال 3186 — مجموع قوى 34
# Sum of powers of 34
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3186-sum-of-powers-of-34-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 34 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 35, "حالة 2")
تأكد_يساوي(ف(3), 40495, "حالة 3")
تأكد_يساوي(ف(6), 1591616671, "حالة 4")
تأكد_يساوي(ف(10), 2126934655697951, "حالة 5")
