# مثال 197 — إحصاءات درجات الحرارة
# Temperature statistics
# Demonstrates: حسابات يدوية، مفرز، تقرير
#
# Run:  python apl.py examples/197-temperature-stats.apl

المتغير درجات = [22, 25, 19, 30, 27, 24, 21, 26, 28, 23]

المتغير مجموع = 0
لكل د في درجات:
    مجموع = مجموع + د
المتغير متوسط = مجموع / طول(درجات)

المتغير مرتبة = مفرز(درجات)
المتغير أدنى = مرتبة[0]
المتغير أقصى = مرتبة[-1]
المتغير قيمة_وسيطة = (مرتبة[4] + مرتبة[5]) / 2

اطبع "القراءات:", درجات
اطبع "المتوسط:", متوسط
اطبع "القيمة_وسيطة:", قيمة_وسيطة
اطبع "أدنى:", أدنى, "| أقصى:", أقصى
اطبع "المدى:", أقصى - أدنى
