# مثال 3966 — تحويل وحدة بأساس 36
# Split by base 36
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3966-minutes-to-hours-and-minutes-base-36.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 36, ن % 36]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 23], "حالة 2")
تأكد_يساوي(ف(60), [1, 24], "حالة 3")
تأكد_يساوي(ف(125), [3, 17], "حالة 4")
تأكد_يساوي(ف(1000), [27, 28], "حالة 5")
