# مثال 445 — تحويل الزوايا
# Angle conversions
# Demonstrates: درجات وراديان
#
# Run:  python apl.py examples/445-angles.apl

المتغير باي = 3.14159265358979

دالة إلى_راديان(درجة):
    ارجع درجة * باي / 180

دالة إلى_درجة(راديان):
    ارجع راديان * 180 / باي

اطبع "90 درجة =", إلى_راديان(90), "راديان"
اطبع "1 راديان =", إلى_درجة(1), "درجة"
اطبع "360 درجة =", إلى_راديان(360), "راديان"
