# مثال 3866 — إضافة 51 لكل عنصر
# Add 51 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3866-list-add-51-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 51]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [54, 52, 53], "حالة 1")
تأكد_يساوي(ف([5]), [56], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [52, 53, 54, 55, 56, 57], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [49, 51, 58, 58, 55], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [61, 71, 61, 81, 71, 61], "حالة 5")
