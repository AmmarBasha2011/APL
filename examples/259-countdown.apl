# مثال 259 — عداد تنازلي لتاريخ
# Countdown to a date
# Demonstrates: فرق التواريخ بالأيام
#
# Run:  python apl.py examples/259-countdown.apl

دالة كبيسة(سنة_م):
    لو سنة_م % 400 == 0:
        ارجع صواب
    لو سنة_م % 100 == 0:
        ارجع خطأ
    ارجع سنة_م % 4 == 0

دالة أيام_منذ_الميلاد(يوم_م, شهر_م, سنة_م):
    المتغير أيام_شهور = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    المتغير مجموع = يوم_م
    لكل س في نطاق(1, سنة_م):
        لو كبيسة(س):
            مجموع = مجموع + 366
        الا:
            مجموع = مجموع + 365
    لكل م في نطاق(شهر_م - 1):
        مجموع = مجموع + أيام_شهور[م]
    لو شهر_م > 2 و كبيسة(سنة_م):
        مجموع = مجموع + 1
    ارجع مجموع

المتغير اليوم_م = أيام_منذ_الميلاد(23, 11, 2026)
المتغير رأس_السنة_م = أيام_منذ_الميلاد(1, 1, 2027)
اطبع "باقي على رأس السنة_م:", رأس_السنة_م - اليوم_م, "يوم_ما"
