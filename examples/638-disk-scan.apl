# مثال 638 — جدولة القرص بالمصعد
# Disk SCAN scheduling
# Demonstrates: SCAN، مصعد، ذراع
#
# Run:  python apl.py examples/638-disk-scan.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# جدولة القرص بخوارزمية المصعد (SCAN)
# Demonstrates: حركة ذراع اتجاهية, خدمة بالطريق, حساب الحركة الكلية
# الذراع تخدم الطلبات باتجاهها ثم تنعكس

دالة مصعد(طلبات, بداية, اتجاه_أعلى, أقصى_أسطوانة):
  أقل = []
  أعلى = []
  لكل ط في طلبات:
    لو ط < بداية:
      أقل.append(ط)
    والا:
      أعلى.append(ط)
  أقل.sort()
  أعلى.sort()
  ترتيب = []
  لو اتجاه_أعلى:
    ترتيب = أعلى + [أقصى_أسطوانة] + أقل[::-1]
  والا:
    ترتيب = أقل[::-1] + [0] + أعلى
  حركة = 0
  موضع = بداية
  لكل محطة في ترتيب:
    حركة = حركة + أكبر(محطة - موضع, موضع - محطة)
    موضع = محطة
  ارجع [ترتيب, حركة]

طلبات = [98, 183, 37, 122, 14, 124, 65, 67]
نتيجة = مصعد(طلبات, 53, صواب, 199)
اطبع "الترتيب:", نتيجة[0]
اطبع "الحركة الكلية:", نتيجة[1]
تأكد_يساوي(نتيجة[0], [65, 67, 98, 122, 124, 183, 199, 37, 14], "ترتيب المصعد صعودا")
تأكد_يساوي(نتيجة[1], 331, "حركة 331 أسطوانة")
