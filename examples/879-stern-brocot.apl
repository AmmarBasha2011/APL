# مثال 879 — شجرة ستيرن-بروكو
# Stern-Brocot tree
# Demonstrates: وسط حسابي بين حدين
#
# Run:  python apl.py examples/879-stern-brocot.apl

# شجرة ستيرن-بروكو: مسار كل كسر موجب مختزل بين 0/1 و1/0
# المسار L/R يشكل تمثيلاً فريداً ويطابق الكسر المستمر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مسار_ستيرن_بروكو(بسط, مقام):
  أدنى_ب = 0
  أدنى_م = 1
  أعلى_ب = 1
  أعلى_م = 0
  مسار = ""
  طالما 1 == 1:
    وسط_ب = أدنى_ب + أعلى_ب
    وسط_م = أدنى_م + أعلى_م
    لو (وسط_ب == بسط) و (وسط_م == مقام):
      ارجع مسار
    لو بسط * وسط_م < مقام * وسط_ب:
      مسار = مسار + "L"
      أعلى_ب = وسط_ب
      أعلى_م = وسط_م
    والا:
      مسار = مسار + "R"
      أدنى_ب = وسط_ب
      أدنى_م = وسط_م

مسار = مسار_ستيرن_بروكو(5, 7)
اطبع "مسار 5/7:", مسار

تأكد_يساوي(مسار, "LRRL", "مسار 5/7 هو LRRL")
تأكد_يساوي(مسار_ستيرن_بروكو(1, 2), "L", "1/2 خطوة يسار")
تأكد_يساوي(مسار_ستيرن_بروكو(2, 3), "LR", "2/3 = LR")
تأكد_يساوي(مسار_ستيرن_بروكو(3, 1), "RR", "3/1 = RR")

# إعادة البناء من المسار تعيد الكسر
دالة ابن_من_مسار(مسار):
  أدنى_ب = 0
  أدنى_م = 1
  أعلى_ب = 1
  أعلى_م = 0
  لكل i في نطاق(طول(مسار)):
    وسط_ب = أدنى_ب + أعلى_ب
    وسط_م = أدنى_م + أعلى_م
    لو مسار[i] == "L":
      أعلى_ب = وسط_ب
      أعلى_م = وسط_م
    والا:
      أدنى_ب = وسط_ب
      أدنى_م = وسط_م
  ارجع [أدنى_ب + أعلى_ب, أدنى_م + أعلى_م]

كسر = ابن_من_مسار("LRRL")
تأكد_يساوي(كسر[0], 5, "إعادة البناء: البسط")
تأكد_يساوي(كسر[1], 7, "إعادة البناء: المقام")
