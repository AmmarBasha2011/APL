# مثال 3537 — مجموع الأعداد من 28 إلى ن
# Sum from 28 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3537-sum-of-integers-from-28-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(28, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(28), 28, "حالة 1")
تأكد_يساوي(ف(29), 57, "حالة 2")
تأكد_يساوي(ف(38), 363, "حالة 3")
تأكد_يساوي(ف(100), 4672, "حالة 4")
