# مثال 728 — لوحة T9
# Phone T9 keypad
# Demonstrates: خريطة أرقام، ضغطات، تتابع
#
# Run:  python apl.py examples/728-phone-t9.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# لوحة T9 القديمة: حروف إلى أرقام وتخمين كلمات
# Demonstrates: خريطة حرف-رقم, بحث عكسي بقاموس, كلمات متجانية رقميا
# 4663 تعني home و good و gone معا

دالة رقم_t9(ح):
  لو ح في "abc":
    ارجع "2"
  لو ح في "def":
    ارجع "3"
  لو ح في "ghi":
    ارجع "4"
  لو ح في "jkl":
    ارجع "5"
  لو ح في "mno":
    ارجع "6"
  لو ح في "pqrs":
    ارجع "7"
  لو ح في "tuv":
    ارجع "8"
  لو ح في "wxyz":
    ارجع "9"
  ارجع "0"

دالة إلى_أرقام(كلمة):
  ناتج = ""
  لكل ي في نطاق(طول(كلمة)):
    ناتج = ناتج + رقم_t9(كلمة[ي])
  ارجع ناتج

دالة تخمين(أرقام, قاموس):
  ناتج = []
  لكل ك في قاموس:
    لو إلى_أرقام(ك) == أرقام:
      ناتج.append(ك)
  ارجع ناتج

تأكد_يساوي(إلى_أرقام("hello"), "43556", "مرحبا")
تأكد_يساوي(إلى_أرقام("world"), "96753", "عالم")
تأكد_يساوي(إلى_أرقام("home"), "4663", "منزل")
قاموس = ["home", "good", "gone", "hood", "hoof", "inn", "cat", "act", "bat"]
ت = تخمين("4663", قاموس)
تأكد_يساوي("home" في ت, صواب, "home ضمن التخمينات")
تأكد_يساوي("good" في ت, صواب, "good ضمن التخمينات")
تأكد_يساوي("gone" في ت, صواب, "gone ضمن التخمينات")
تأكد_يساوي("cat" في ت, خطأ, "cat ليست 4663")
ت2 = تخمين("228", قاموس)
تأكد_يساوي("cat" في ت2 و "act" في ت2 و "bat" في ت2, صواب, "228 ثلاث كلمات")
تأكد_يساوي(طول(تخمين("9999", قاموس)), 0, "لا تطابق")
اطبع "4663:", ت
