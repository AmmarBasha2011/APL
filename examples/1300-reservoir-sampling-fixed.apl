# مثال 1300 — عينة بالخزان
# Reservoir sampling with seeded generator
# Demonstrates: عينات
#
# Run:  python apl.py examples/1300-reservoir-sampling-fixed.apl

# العنصر ذو الترتيب i يحل محل المختار باحتمال 1 على i
# نستخدم مولداً ثابت البذرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مولد_بسيط:
  دالة_إنشاء(ذات, بذرة):
    ذات.ح = بذرة

  دالة تالي(ذات):
    ذات.ح = (ذات.ح * 1664525 + 1013904223) % 4294967296
    ارجع ذات.ح

دالة اختر_من_تدفق(تدفق, بذرة):
  م = مولد_بسيط(بذرة)
  مختار = 0
  لكل ع في نطاق(طول(تدفق)):
    لو م.تالي() % (ع + 1) == 0:
      مختار = تدفق[ع]
  ارجع مختار

ت = [10, 20, 30, 40, 50]
ن = اختر_من_تدفق(ت, 7)
تأكد_يساوي(ن في ت, صواب, "من التدفق")
تأكد_يساوي(اختر_من_تدفق(ت, 7), ن, "نفس البذرة")
تأكد_يساوي(اختر_من_تدفق([9], 1), 9, "عنصر واحد")
