# مثال 278 — أطول متتالية مشتركة
# Longest common subsequence
# Demonstrates: جدول ديناميكي ثنائي
#
# Run:  python apl.py examples/278-lcs.apl

دالة أطول_مشتركة(أ, ب):
    المتغير ن = طول(أ)
    المتغير م = طول(ب)
    المتغير جدول = []
    لكل _ في نطاق(ن + 1):
        جدول.أضف([0 لكل _ في نطاق(م + 1)])
    لكل ي في نطاق(1, ن + 1):
        لكل ز في نطاق(1, م + 1):
            لو أ[ي - 1] == ب[ز - 1]:
                جدول[ي][ز] = جدول[ي - 1][ز - 1] + 1
            الا لو جدول[ي - 1][ز] >= جدول[ي][ز - 1]:
                جدول[ي][ز] = جدول[ي - 1][ز]
            الا:
                جدول[ي][ز] = جدول[ي][ز - 1]
    ارجع جدول[ن][م]

اطبع أطول_مشتركة("abcde", "ace")
اطبع أطول_مشتركة("abc", "abc")
اطبع أطول_مشتركة("abc", "def")
