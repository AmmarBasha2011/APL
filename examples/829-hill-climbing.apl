# مثال 829 — تسلق التل
# Hill climbing
# Demonstrates: أفضل جار، قمم محلية
#
# Run:  python apl.py examples/829-hill-climbing.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تسلق التل: تحسين محلي بالانتقال لأفضل جار حتى القمة
# Demonstrates: جوار بخطوة ثابتة, قمة محلية, إعادة تشغيل من نقاط مختلفة

دالة دالة_هدف(س):
  ارجع 0 - (س - 3) * (س - 3) + 10

دالة تسلق(بداية):
  س = بداية
  طالما 1 == 1:
    أفضل = س
    قيمة = دالة_هدف(س)
    لكل جار في [س - 1, س + 1]:
      لو دالة_هدف(جار) > قيمة:
        أفضل = جار
        قيمة = دالة_هدف(جار)
    لو أفضل == س:
      ارجع [س, قيمة]
    س = أفضل

تأكد_يساوي(تسلق(0), [3, 10], "من الصفر")
تأكد_يساوي(تسلق(7), [3, 10], "من السبعة")
تأكد_يساوي(تسلق(3), [3, 10], "من القمة نفسها")

دالة منظر(س):
  لو س < 6:
    ارجع 0 - (س - 3) * (س - 3) + 10
  ارجع 0 - (س - 12) * (س - 12) + 5

دالة تسلق2(بداية):
  س = بداية
  طالما 1 == 1:
    أفضل = س
    قيمة = منظر(س)
    لكل جار في [س - 1, س + 1]:
      لو منظر(جار) > قيمة:
        أفضل = جار
        قيمة = منظر(جار)
    لو أفضل == س:
      ارجع [س, قيمة]
    س = أفضل

تأكد_يساوي(تسلق2(0), [3, 10], "قمة أولى")
تأكد_يساوي(تسلق2(15), [12, 5], "قمة ثانية أدنى")
تأكد_يساوي(منظر(3) > منظر(12) == خطأ, خطأ, "القمة الأولى أعلى")
