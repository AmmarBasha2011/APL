# مثال 230 — تنسيق العناوين الإنجليزية
# Title case formatter
# Demonstrates: تكبير أول حرف، كلمات صغيرة مستثناة
#
# Run:  python apl.py examples/230-title-case.apl

المتغير صغيرة = ["a", "an", "the", "and", "or", "of", "in", "on", "at", "to"]

دالة عنوان_منسق(نص_الدخل):
    المتغير كلمات = نص_الدخل.سفلي().تقسيم(" ")
    المتغير نتيجة = []
    لكل ي في نطاق(طول(كلمات)):
        المتغير ك = كلمات[ي]
        لو ي == 0 أو ك ليس في صغيرة:
            نتيجة.أضف(ك[0].علوي() + ك[1:])
        الا:
            نتيجة.أضف(ك)
    ارجع " ".ضم(نتيجة)

اطبع عنوان_منسق("the lord of the rings")
اطبع عنوان_منسق("a tale of two cities")
