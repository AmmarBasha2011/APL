# مثال 131 — طباعة تقويم شهر
# Printing a month calendar
# Demonstrates: تاريخ، مدة، حلقات، شروط
#
# Run:  python apl.py examples/131-month-calendar.apl

المتغير سنة = 2026
المتغير شهر = 11
اطبع "تقويم", شهر, "/", سنة
اطبع "اث ثلا أرب خم جم سب أح"

المتغير أول = تاريخ(سنة, شهر, 1)
المتغير سطر = ""
لكل _ في نطاق(أول.weekday()):
    سطر = سطر + "    "

المتغير ت = أول
طالما ت.رقم_الشهر == شهر:
    المتغير ي = نص(ت.رقم_اليوم)
    لو طول(ي) < 2:
        ي = " " + ي
    سطر = سطر + ي + "  "
    لو ت.weekday() == 6:
        اطبع سطر
        سطر = ""
    ت = ت + مدة(أيام=1)
لو سطر != "":
    اطبع سطر
