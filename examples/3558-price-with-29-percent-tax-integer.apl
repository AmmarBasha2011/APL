# مثال 3558 — السعر مع ضريبة 29 بالمئة
# Price with 29 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3558-price-with-29-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 29 // 100

تأكد_يساوي(ف(100), 129, "حالة 1")
تأكد_يساوي(ف(250), 322, "حالة 2")
تأكد_يساوي(ف(999), 1288, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
