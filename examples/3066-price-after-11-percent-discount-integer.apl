# مثال 3066 — السعر بعد خصم 11 بالمئة
# Price after 11 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3066-price-after-11-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 11 // 100

تأكد_يساوي(ف(100), 89, "حالة 1")
تأكد_يساوي(ف(250), 223, "حالة 2")
تأكد_يساوي(ف(999), 890, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
