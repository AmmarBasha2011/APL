# مثال 1297 — خمن أعلى أم أقل
# Guess number higher or lower
# Demonstrates: بحث ثنائي
#
# Run:  python apl.py examples/1297-guess-higher-lower.apl

# كل تخمين يخبرنا بالاتجاه
# فنقسم المدى نصفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة خمن(ن, سر):
  يسار = 1
  يمين = ن
  محاولات = 0
  طالما يسار <= يمين:
    وسط = (يسار + يمين) // 2
    محاولات = محاولات + 1
    لو وسط == سر:
      ارجع محاولات
    والا_لو وسط < سر:
      يسار = وسط + 1
    والا:
      يمين = وسط - 1
  ارجع -1

تأكد_يساوي(خمن(10, 6) <= 4, صواب, "عشرة")
تأكد_يساوي(خمن(1, 1), 1, "واحد")
تأكد_يساوي(خمن(1000, 1) <= 10, صواب, "الحد الأدنى")
تأكد_يساوي(خمن(1000, 1000) <= 10, صواب, "الحد الأعلى")
