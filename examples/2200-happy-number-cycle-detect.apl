# مثال 2200 — العدد السعيد
# Happy number
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2200-happy-number-cycle-detect.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  شوهد = []
  طالما ن != 1 و شوهد.count(ن) == 0:
    شوهد = شوهد + [ن]
    م = 0
    لكل ر في نص(ن):
      م = م + int(ر) ** 2
    ن = م
  ارجع ن == 1

تأكد_يساوي(ف(1), صواب, "حالة 1")
تأكد_يساوي(ف(7), صواب, "حالة 7")
تأكد_يساوي(ف(19), صواب, "حالة 19")
تأكد_يساوي(ف(2), خطأ, "حالة 2")
تأكد_يساوي(ف(4), خطأ, "حالة 4")
تأكد_يساوي(ف(100), صواب, "حالة 100")
