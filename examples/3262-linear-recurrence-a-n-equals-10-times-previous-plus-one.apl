# مثال 3262 — متتالية أ=10×السابق+1
# Recurrence times 10 plus one
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/3262-linear-recurrence-a-n-equals-10-times-previous-plus-one.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 1
  لكل ي في نطاق(ن):
    أ = أ * 10 + 1
  ارجع أ

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 11, "حالة 2")
تأكد_يساوي(ف(2), 111, "حالة 3")
تأكد_يساوي(ف(5), 111111, "حالة 4")
تأكد_يساوي(ف(8), 111111111, "حالة 5")
