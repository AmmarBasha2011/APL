# مثال 108 — حساب الأموال بدقة بلا أخطاء عشرية
# Exact money math with decimal
# Demonstrates: عشري_دقيق، جمع وطرح وضرب دقيق
#
# Run:  python apl.py examples/108-decimal-money.apl

اطبع "بالمسار العادي: 0.1 + 0.2 =", 0.1 + 0.2
المتغير أ = عشري_دقيق("0.1")
المتغير ب = عشري_دقيق("0.2")
اطبع "بالعشري الدقيق: 0.1 + 0.2 =", أ + ب

اطبع ""
اطبع "=== فاتورة ==="
المتغير سعر = عشري_دقيق("19.99")
المتغير كمية = عشري_دقيق("3")
المتغير ضريبة = عشري_دقيق("0.14")
المتغير إجمالي = سعر * كمية
اطبع "الإجمالي قبل الضريبة:", إجمالي
اطبع "قيمة الضريبة:", إجمالي * ضريبة
اطبع "الإجمالي النهائي:", إجمالي + إجمالي * ضريبة
