# مثال 4381 — مجموع زوايا مضلع زائد 31
# Polygon angle sum plus 31
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4381-interior-angle-sum-of-polygon-plus-31.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 31

تأكد_يساوي(ف(3), 211, "حالة 1")
تأكد_يساوي(ف(4), 391, "حالة 2")
تأكد_يساوي(ف(5), 571, "حالة 3")
تأكد_يساوي(ف(6), 751, "حالة 4")
تأكد_يساوي(ف(12), 1831, "حالة 5")
