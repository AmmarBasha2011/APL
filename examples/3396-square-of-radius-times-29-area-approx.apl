# مثال 3396 — مساحة دائرة بتقريب 29
# Circle area with pi approx 29/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3396-square-of-radius-times-29-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 29 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 4, "حالة 2")
تأكد_يساوي(ف(7), 203, "حالة 3")
تأكد_يساوي(ف(14), 812, "حالة 4")
تأكد_يساوي(ف(21), 1827, "حالة 5")
