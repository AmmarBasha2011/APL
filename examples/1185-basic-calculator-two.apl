# مثال 1185 — حاسبة بأولويات
# Basic calculator with precedence
# Demonstrates: مكدس
#
# Run:  python apl.py examples/1185-basic-calculator-two.apl

# الضرب والقسمة يُنفذان فوراً
# والجمع والطرح يدخلان المكدس بعلامتهما

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة احسب_اولويات(س):
  س = س.replace(" ", "")
  مكدس = []
  رقم = 0
  عملية = "+"
  لكل ع في نطاق(طول(س)):
    ح = س[ع]
    لو ح.isdigit():
      رقم = رقم * 10 + صحيح(ح)
    لو (ح في "+-*/") أو (ع == طول(س) - 1):
      لو ح != " ":
        لو عملية == "+":
          مكدس.ألحق(رقم)
        والا_لو عملية == "-":
          مكدس.ألحق(-رقم)
        والا_لو عملية == "*":
          مكدس.ألحق(مكدس.pop() * رقم)
        والا:
          ق = مكدس.pop()
          لو ق < 0:
            مكدس.ألحق(-((-ق) // رقم))
          والا:
            مكدس.ألحق(ق // رقم)
        عملية = ح
        رقم = 0
  مج = 0
  لكل ق في مكدس:
    مج = مج + ق
  ارجع مج

تأكد_يساوي(احسب_اولويات("3+2*2"), 7, "ضرب أولاً")
تأكد_يساوي(احسب_اولويات(" 3/2 "), 1, "قسمة")
تأكد_يساوي(احسب_اولويات(" 3+5 / 2 "), 5, "مختلط")
تأكد_يساوي(احسب_اولويات("14-3/2"), 13, "طرح وقسمة")
