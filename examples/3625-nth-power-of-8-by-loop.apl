# مثال 3625 — قوة 8 بالحلقة
# Power of 8 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3625-nth-power-of-8-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 8
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 8, "حالة 2")
تأكد_يساوي(ف(3), 512, "حالة 3")
تأكد_يساوي(ف(6), 262144, "حالة 4")
تأكد_يساوي(ف(10), 1073741824, "حالة 5")
