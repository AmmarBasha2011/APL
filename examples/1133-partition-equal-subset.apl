# مثال 1133 — تقسيم متساوٍ
# Partition equal subset sum
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1133-partition-equal-subset.apl

# لو كان المجموع فردياً فلا حل
# وإلا نبحث عن مجموعة جزئية مجموعها النصف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يقسم(أ):
  مج = 0
  لكل س في أ:
    مج = مج + س
  لو مج % 2 == 1:
    ارجع خطأ
  هدف = مج // 2
  ممكن = [خطأ] * (هدف + 1)
  ممكن[0] = صواب
  لكل س في أ:
    لكل ك في نطاق(هدف, س - 1, -1):
      لو ممكن[ك - س]:
        ممكن[ك] = صواب
  ارجع ممكن[هدف]

تأكد_يساوي(يقسم([1,5,11,5]), صواب, "ممكن")
تأكد_يساوي(يقسم([1,2,3,5]), خطأ, "غير ممكن")
تأكد_يساوي(يقسم([2,2]), صواب, "متساويان")
تأكد_يساوي(يقسم([1]), خطأ, "واحد")
تأكد_يساوي(يقسم([3,3,3,4,5]), صواب, "خمسة")
