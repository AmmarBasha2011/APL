# مثال 927 — تجميع ك-المتوسطات
# K-means clustering
# Demonstrates: تخصيص وتحديث مراكز
#
# Run:  python apl.py examples/927-kmeans.apl

# تجميع ك-المتوسطات: تقسيم النقاط لك مجموعة بتكرار التخصيص والتحديث
# يتقارب لأقرب مراكز محلية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ك_متوسطات(نقاط, ك, تكرارات):
  # مراكز أولية: أول ك نقطة (حتمي)
  مراكز = []
  لكل i في نطاق(ك):
    مراكز.ألحق([نقاط[i][0], نقاط[i][1]])
  لكل _ في نطاق(تكرارات):
    مجموعات = []
    لكل __ في نطاق(ك):
      مجموعات.ألحق([])
    لكل ن في نقاط:
      أقرب = 0
      أقل = (ن[0] - مراكز[0][0]) ** 2 + (ن[1] - مراكز[0][1]) ** 2
      لكل ج في نطاق(1, ك):
        مسافة = (ن[0] - مراكز[ج][0]) ** 2 + (ن[1] - مراكز[ج][1]) ** 2
        لو مسافة < أقل:
          أقل = مسافة
          أقرب = ج
      مجموعات[أقرب].ألحق(ن)
    لكل ج في نطاق(ك):
      لو طول(مجموعات[ج]) > 0:
        مجموع_س = 0
        مجموع_ص = 0
        لكل ن في مجموعات[ج]:
          مجموع_س = مجموع_س + ن[0]
          مجموع_ص = مجموع_ص + ن[1]
        مراكز[ج] = [مجموع_س / طول(مجموعات[ج]), مجموع_ص / طول(مجموعات[ج])]
  ارجع مراكز

نقاط = [[1, 1], [2, 1], [1, 2], [10, 10], [11, 10], [10, 11]]
مراكز = ك_متوسطات(نقاط, 2, 20)
اطبع "المراكز:", مراكز

# المجموعة الأولى حول (4/3, 4/3) والثانية حول (31/3, 31/3)
تأكد_يساوي(مقرب(مراكز[0][0], 4), 1.3333, "مركز أول س")
تأكد_يساوي(مقرب(مراكز[0][1], 4), 1.3333, "مركز أول ص")
تأكد_يساوي(مقرب(مراكز[1][0], 4), 10.3333, "مركز ثانٍ س")
تأكد_يساوي(مقرب(مراكز[1][1], 4), 10.3333, "مركز ثانٍ ص")

# كل نقطة أقرب لمركز مجموعتها
مسافة_قريب = (1 - مراكز[0][0]) ** 2 + (1 - مراكز[0][1]) ** 2
مسافة_بعيد = (1 - مراكز[1][0]) ** 2 + (1 - مراكز[1][1]) ** 2
لو مسافة_قريب >= مسافة_بعيد:
  اطبع "فشل: التخصيص غير سليم"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: التخصيص سليم"
