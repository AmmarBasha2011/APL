# مثال 2619 — الحد النوني بخطوة 10
# Nth term step 10
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2619-nth-term-arithmetic-sequence-step-10.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 10

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 13, "حالة 2")
تأكد_يساوي(ف(10), 93, "حالة 3")
تأكد_يساوي(ف(100), 993, "حالة 4")
