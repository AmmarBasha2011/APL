# مثال 575 — مصفوفة السوابق
# Suffix array
# Demonstrates: سوابق، فرز، بحث في نص
#
# Run:  python apl.py examples/575-suffix-array.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# مصفوفة اللواحق: فرز كل اللواحق والبحث الثنائي فيها
دالة مصفوفة_لواحق(نص):
    المتغير لواحق = قائمة()
    لكل i في نطاق(طول(نص)):
        لواحق.أضف([نص[i:], i])
    ارجع مفرز(لواحق)

دالة بحث(نص, نمط):
    المتغير م = مصفوفة_لواحق(نص)
    المتغير ب = 0
    المتغير ن = طول(م) - 1
    طالما ب <= ن:
        المتغير وسط = (ب + ن) // 2
        المتغير مقطع = م[وسط][0][:طول(نمط)]
        لو مقطع == نمط:
            ارجع م[وسط][1]
        الا لو مقطع < نمط:
            ب = وسط + 1
        الا:
            ن = وسط - 1
    ارجع -1

المتغير نتيجة = مصفوفة_لواحق("banana")
اطبع "اللواحق مفرزة:", نتيجة
تأكد_يساوي(بحث("banana", "nan"), 2, "nan عند 2")
تأكد_يساوي(بحث("banana", "ana"), 1, "ana عند 1")
تأكد_يساوي(بحث("banana", "xyz"), -1, "غائب")
