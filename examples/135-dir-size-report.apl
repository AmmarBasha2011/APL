# مثال 135 — تقرير أحجام المجلدات
# Directory size report
# Demonstrates: حجم_ملف، قائمة_ملفات، هو_ملف، دمج_مسار
#
# Run:  python apl.py examples/135-dir-size-report.apl

المتغير جذر = "/tmp/apl_size_demo"
انشئ_مجلدات(جذر)
اكتب(جذر + "/صغير.txt", "س" * 100)
اكتب(جذر + "/كبير.txt", "ك" * 5000)

المتغير إجمالي = 0
لكل اسم في قائمة_ملفات(جذر):
    المتغير مسار = دمج_مسار(جذر, اسم)
    لو هو_ملف(مسار):
        المتغير حجم = حجم_ملف(مسار)
        إجمالي = إجمالي + حجم
        اطبع اسم, ":", حجم, "بايت"

اطبع "الإجمالي:", إجمالي, "بايت"
احذف_شجرة(جذر)
