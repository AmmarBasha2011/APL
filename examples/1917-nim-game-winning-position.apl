# مثال 1917 — لعبة نيم الموقف الرابح
# Nim game winning position
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1917-nim-game-winning-position.apl

# نحسب xor لأحجام الأكوام
# صفر يعني أن الدور الحالي خاسر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رابح(اكوام):
  س = 0
  لكل ك في اكوام:
    س = س ^ ك
  ارجع س != 0

تأكد_يساوي(رابح([3, 4, 5]), صواب, "٣ ٤ ٥")
تأكد_يساوي(رابح([1, 2, 3]), خطأ, "١ ٢ ٣")
تأكد_يساوي(رابح([7]), صواب, "كومة واحدة")
تأكد_يساوي(رابح([2, 2]), خطأ, "متساويان")
