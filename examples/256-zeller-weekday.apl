# مثال 256 — يوم الأسبوع بمعادلة زيلر
# Zeller's congruence
# Demonstrates: حساب يوم الأسبوع لأي تاريخ
#
# Run:  python apl.py examples/256-zeller-weekday.apl

دالة يوم_الأسبوع_زيلر(يوم_م, شهر_م, سنة_م):
    المتغير ش_معدل = شهر_م
    المتغير س_معدلة = سنة_م
    لو ش_معدل < 3:
        ش_معدل = ش_معدل + 12
        س_معدلة = س_معدلة - 1
    المتغير بقية_قرن = س_معدلة % 100
    المتغير قرن = س_معدلة // 100
    المتغير مؤشر = (يوم_م + (13 * (ش_معدل + 1)) // 5 + بقية_قرن + بقية_قرن // 4 + قرن // 4 + 5 * قرن) % 7
    المتغير أيام = ["السبت", "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة"]
    ارجع أيام[مؤشر]

اطبع "1 يناير 2000:", يوم_الأسبوع_زيلر(1, 1, 2000)
اطبع "23 نوفمبر 2026:", يوم_الأسبوع_زيلر(23, 11, 2026)
اطبع "15 مايو 1990:", يوم_الأسبوع_زيلر(15, 5, 1990)
