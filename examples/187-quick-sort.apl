# مثال 187 — الترتيب السريع
# Quick sort
# Demonstrates: العودية، المحور، توليدات القوائم
#
# Run:  python apl.py examples/187-quick-sort.apl

دالة سريع(قائمة):
    لو طول(قائمة) <= 1:
        ارجع قائمة
    المتغير محور = قائمة[0]
    المتغير أصغر_من = [ع لكل ع في قائمة[1:] لو ع <= محور]
    المتغير أكبر_من = [ع لكل ع في قائمة[1:] لو ع > محور]
    ارجع سريع(أصغر_من) + [محور] + سريع(أكبر_من)

المتغير أرقام = [10, 7, 8, 9, 1, 5]
اطبع "قبل:", أرقام
اطبع "بعد:", سريع(أرقام)
