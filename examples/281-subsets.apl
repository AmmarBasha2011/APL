# مثال 281 — كل المجموعات الفرعية
# All subsets (backtracking)
# Demonstrates: توليد 2^ن مجموعة بالتراجع
#
# Run:  python apl.py examples/281-subsets.apl

دالة فرعيات(عناصر):
    المتغير نتيجة = [[]]
    لكل عنصر في عناصر:
        المتغير جديدة = []
        لكل مجموعة في نتيجة:
            جديدة.أضف(مجموعة + [عنصر])
        لكل مجموعة في جديدة:
            نتيجة.أضف(مجموعة)
    ارجع نتيجة

اطبع فرعيات([1, 2, 3])
اطبع "عدد فرعيات 4 عناصر:", طول(فرعيات([1, 2, 3, 4]))
