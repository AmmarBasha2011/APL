# مثال 3053 — مجموع الأعداد من 13 إلى ن
# Sum from 13 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3053-sum-of-integers-from-13-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(13, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(13), 13, "حالة 1")
تأكد_يساوي(ف(14), 27, "حالة 2")
تأكد_يساوي(ف(23), 198, "حالة 3")
تأكد_يساوي(ف(100), 4972, "حالة 4")
