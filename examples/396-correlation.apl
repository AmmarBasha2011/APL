# مثال 396 — معامل الارتباط
# Correlation coefficient
# Demonstrates: بيرسون يدويا
#
# Run:  python apl.py examples/396-correlation.apl

دالة ارتباط(س, ص):
    المتغير ن = طول(س)
    المتغير مجموع_س = 0
    المتغير مجموع_ص = 0
    لكل ي في نطاق(ن):
        مجموع_س = مجموع_س + س[ي]
        مجموع_ص = مجموع_ص + ص[ي]
    المتغير م_س = مجموع_س / ن
    المتغير م_ص = مجموع_ص / ن
    المتغير بسط = 0
    المتغير ت_س = 0
    المتغير ت_ص = 0
    لكل ي في نطاق(ن):
        المتغير ف_س = س[ي] - م_س
        المتغير ف_ص = ص[ي] - م_ص
        بسط = بسط + ف_س * ف_ص
        ت_س = ت_س + ف_س * ف_س
        ت_ص = ت_ص + ف_ص * ف_ص
    ارجع بسط / جذر(ت_س * ت_ص)

المتغير دراسة = [1, 2, 3, 4, 5, 6]
المتغير درجة = [50, 58, 66, 72, 81, 88]
اطبع "الارتباط:", ارتباط(دراسة, درجة)
