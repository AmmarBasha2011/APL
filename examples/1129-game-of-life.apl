# مثال 1129 — لعبة الحياة
# Conway's game of life
# Demonstrates: جيران ثمانية
#
# Run:  python apl.py examples/1129-game-of-life.apl

# الخلية الحية تبقى بجارين أو ثلاثة
# والميتة تحيا بثلاثة جيران بالضبط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جيران(ل, ص, ج):
  ع = 0
  لكل د1 في [-1, 0, 1]:
    لكل د2 في [-1, 0, 1]:
      لو (د1 != 0) أو (د2 != 0):
        ر = ص + د1
        ك = ج + د2
        لو (ر >= 0) و (ر < طول(ل)):
          لو (ك >= 0) و (ك < طول(ل[0])):
            ع = ع + ل[ر][ك]
  ارجع ع

دالة خطوة(ل):
  ناتج = []
  لكل ص في نطاق(طول(ل)):
    صف = []
    لكل ج في نطاق(طول(ل[0])):
      ع = جيران(ل, ص, ج)
      حية = 0
      لو ل[ص][ج] == 1:
        لو (ع == 2) أو (ع == 3):
          حية = 1
      والا:
        لو ع == 3:
          حية = 1
      صف.ألحق(حية)
    ناتج.ألحق(صف)
  ارجع ناتج

وميض = [[0,0,0],[1,1,1],[0,0,0]]
تأكد_يساوي(خطوة(وميض), [[0,1,0],[0,1,0],[0,1,0]], "وميض")
تأكد_يساوي(خطوة(خطوة(وميض)), وميض, "دورة")
مربع = [[1,1],[1,1]]
تأكد_يساوي(خطوة(مربع), مربع, "مستقر")
تأكد_يساوي(خطوة([[0,0],[0,0]]), [[0,0],[0,0]], "ميتة")
