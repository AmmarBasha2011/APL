# مثال 2208 — هل الكلمة بلا حرف مكرر
# Is isogram
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2208-is-isogram-no-repeated-letters.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  شوهد = ""
  لكل ح في ن:
    لو شوهد.find(ح) != -1:
      ارجع خطأ
    شوهد = شوهد + ح
  ارجع صواب

تأكد_يساوي(ف("abc"), صواب, "حالة 1")
تأكد_يساوي(ف("hello"), خطأ, "حالة 2")
تأكد_يساوي(ف("python"), صواب, "حالة 3")
تأكد_يساوي(ف("banana"), خطأ, "حالة 4")
تأكد_يساوي(ف("a"), صواب, "حالة 5")
