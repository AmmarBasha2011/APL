# مثال 1282 — دمى روسية
# Russian doll envelopes
# Demonstrates: أطول متتالية
#
# Run:  python apl.py examples/1282-russian-doll.apl

# نرتب بالعرض تصاعدياً وبالارتفاع تنازلياً
# ثم نحسب أطول متتالية متزايدة في الارتفاع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اطول_متزايدة(أ):
  ذيول = []
  لكل س في أ:
    ي = 0
    ن = طول(ذيول)
    طالما ي < ن:
      م = (ي + ن) // 2
      لو ذيول[م] < س:
        ي = م + 1
      والا:
        ن = م
    لو ي == طول(ذيول):
      ذيول.ألحق(س)
    والا:
      ذيول[ي] = س
  ارجع طول(ذيول)

دالة مظاريف(م):
  ازواج = []
  لكل ز في م:
    ازواج.ألحق([ز[0], -ز[1]])
  ازواج = مفرز(ازواج)
  ارتفاعات = []
  لكل ز في ازواج:
    ارتفاعات.ألحق(-ز[1])
  ارجع اطول_متزايدة(ارتفاعات)

تأكد_يساوي(مظاريف([[5,4],[6,4],[6,7],[2,3]]), 3, "مثال أول")
تأكد_يساوي(مظاريف([[1,1],[1,1],[1,1]]), 1, "متطابقة")
تأكد_يساوي(مظاريف([]), 0, "فارغة")
