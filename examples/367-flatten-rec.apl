# مثال 367 — عد عناصر متداخلة بالعودية
# Count nested items recursively
# Demonstrates: عد عميق
#
# Run:  python apl.py examples/367-flatten-rec.apl

دالة عد_عميق(عنصر):
    لو نوع(عنصر) == نوع([]):
        المتغير مجموع = 0
        لكل فرعي في عنصر:
            مجموع = مجموع + عد_عميق(فرعي)
        ارجع مجموع
    ارجع 1

اطبع عد_عميق([1, [2, 3], [4, [5, 6]]])
اطبع عد_عميق([[["أ"]], ["ب", "ج"]])
