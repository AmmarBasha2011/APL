# مثال 529 — تحقق ردمك ISBN-13
# ISBN-13 validation
# Demonstrates: ردمك ISBN-13، رقم تحقق
#
# Run:  python apl.py examples/529-isbn13-check.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تحقق من ردمك ISBN-13
دالة ردمك_صالح(رقم):
    لو طول(رقم) != 13:
        ارجع خطأ
    المتغير م = 0
    لكل i في نطاق(12):
        المتغير ر = صحيح(رقم[i])
        لو i % 2 == 0:
            م = م + ر
        الا:
            م = م + 3 * ر
    المتغير تحقق = (10 - م % 10) % 10
    ارجع تحقق == صحيح(رقم[12])

تأكد_يساوي(ردمك_صالح("9780306406157"), صواب, "ردمك صالح")
تأكد_يساوي(ردمك_صالح("9780306406158"), خطأ, "ردمك خاطئ")
تأكد_يساوي(ردمك_صالح("123"), خطأ, "طول خاطئ")
