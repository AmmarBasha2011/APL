# مثال 2238 — وسيط القائمة
# Median of list
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2238-list-median-sorted-middle.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = طول(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) / 2

تأكد_يساوي(ف([3, 1, 2]), 2, "حالة 1")
تأكد_يساوي(ف([5]), 5, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 3.5, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 4, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 15.0, "حالة 5")
