# مثال 4225 — قوة 30 بالحلقة
# Power of 30 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4225-nth-power-of-30-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 30
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 30, "حالة 2")
تأكد_يساوي(ف(3), 27000, "حالة 3")
تأكد_يساوي(ف(6), 729000000, "حالة 4")
تأكد_يساوي(ف(10), 590490000000000, "حالة 5")
