# مثال 1412 — مقارنة مع المسح
# Backspace string compare
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1412-backspace-compare.apl

# نبني كل نص بمكدس
# العلامة تخرج آخر حرف إن وجد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ابن(نص_):
  مكدس = []
  لكل ح في نص_:
    لو ح == "#":
      لو طول(مكدس) > 0:
        مكدس.pop()
    والا:
      مكدس.ألحق(ح)
  ارجع مكدس

دالة متساويان_بعد_المسح(أ, ب):
  ارجع ابن(أ) == ابن(ب)

تأكد_يساوي(متساويان_بعد_المسح("ab#c", "ad#c"), صواب, "ac")
تأكد_يساوي(متساويان_بعد_المسح("ab##", "c#d#"), صواب, "فارغان")
تأكد_يساوي(متساويان_بعد_المسح("a#c", "b"), خطأ, "مختلفان")
