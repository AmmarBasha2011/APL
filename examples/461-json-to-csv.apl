# مثال 461 — تحويل JSON إلى CSV
# JSON to CSV
# Demonstrates: قواميس إلى صفوف
#
# Run:  python apl.py examples/461-json-to-csv.apl

المتغير بيانات = [
    {"اسم": "عمار", "عمر": 26},
    {"اسم": "سارة", "عمر": 24}
]

اكتب_ملف_جسون(بيانات, "/tmp/apl-461.json")
المتغير محمل = اقرأ_ملف_جسون("/tmp/apl-461.json")

اطبع "اسم,عمر"
لكل سجل في محمل:
    اطبع سجل["اسم"] + "," + نص(سجل["عمر"])

احذف_ملف("/tmp/apl-461.json")
