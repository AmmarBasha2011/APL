# مثال 1196 — جدران وبوابات
# Walls and gates distance fill
# Demonstrates: بحث بالعرض من عدة مصادر
#
# Run:  python apl.py examples/1196-walls-and-gates.apl

# نبدأ بالعرض من كل البوابات معاً
# فتصل كل غرفة بأقصر مسافة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة املأ(ش):
  ر_ = طول(ش)
  ك_ = طول(ش[0])
  كبير = 2147483647
  طابور = []
  لكل ص في نطاق(ر_):
    لكل ج في نطاق(ك_):
      لو ش[ص][ج] == 0:
        طابور.ألحق([ص, ج])
  ع = 0
  اتجاهات = [[1, 0], [-1, 0], [0, 1], [0, -1]]
  طالما ع < طول(طابور):
    ص = طابور[ع][0]
    ج = طابور[ع][1]
    ع = ع + 1
    لكل د في اتجاهات:
      ر = ص + د[0]
      ك = ج + د[1]
      لو (ر >= 0) و (ر < ر_) و (ك >= 0) و (ك < ك_):
        لو ش[ر][ك] == كبير:
          ش[ر][ك] = ش[ص][ج] + 1
          طابور.ألحق([ر, ك])
  ارجع ش

ك = 2147483647
م = [[ك,-1,0,ك],[ك,ك,ك,-1],[ك,-1,ك,-1],[0,-1,ك,ك]]
تأكد_يساوي(املأ(م), [[3,-1,0,1],[2,2,1,-1],[1,-1,2,-1],[0,-1,3,4]], "مثال أول")
تأكد_يساوي(املأ([[0]]), [[0]], "بوابة فقط")
