# مثال 2660 — مجموع الأعداد من 3 إلى ن
# Sum from 3 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2660-sum-of-integers-from-3-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(3, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(3), 3, "حالة 1")
تأكد_يساوي(ف(4), 7, "حالة 2")
تأكد_يساوي(ف(13), 88, "حالة 3")
تأكد_يساوي(ف(100), 5047, "حالة 4")
