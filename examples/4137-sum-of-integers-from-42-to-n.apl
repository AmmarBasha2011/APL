# مثال 4137 — مجموع الأعداد من 42 إلى ن
# Sum from 42 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4137-sum-of-integers-from-42-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(42, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(42), 42, "حالة 1")
تأكد_يساوي(ف(43), 85, "حالة 2")
تأكد_يساوي(ف(52), 517, "حالة 3")
تأكد_يساوي(ف(100), 4189, "حالة 4")
