# مثال 4314 — مجموع قوى 64
# Sum of powers of 64
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4314-sum-of-powers-of-64-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 64 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 65, "حالة 2")
تأكد_يساوي(ف(3), 266305, "حالة 3")
تأكد_يساوي(ف(6), 69810262081, "حالة 4")
تأكد_يساوي(ف(10), 1171221845949812801, "حالة 5")
