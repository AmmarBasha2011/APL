# مثال 3762 — تقسيم الفاتورة على 32
# Split bill among 32
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3762-split-bill-among-32-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 32 - 1) // 32

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 1, "حالة 2")
تأكد_يساوي(ف(100), 4, "حالة 3")
تأكد_يساوي(ف(101), 4, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
