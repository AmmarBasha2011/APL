# مثال 3935 — مجموع الأعداد من 35 إلى ن
# Sum from 35 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3935-sum-of-integers-from-35-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(35, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(35), 35, "حالة 1")
تأكد_يساوي(ف(36), 71, "حالة 2")
تأكد_يساوي(ف(45), 440, "حالة 3")
تأكد_يساوي(ف(100), 4455, "حالة 4")
