# مثال 3004 — مجموع البواقي على 29
# Sum of remainders mod 29
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3004-sum-of-remainders-mod-29-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن + 1):
    م = م + ي % 29
  ارجع م

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(7), 28, "حالة 2")
تأكد_يساوي(ف(12), 78, "حالة 3")
تأكد_يساوي(ف(50), 637, "حالة 4")
تأكد_يساوي(ف(100), 1309, "حالة 5")
