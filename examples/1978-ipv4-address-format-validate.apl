# مثال 1978 — التحقق من صيغة عنوان IPv4
# IPv4 format validation
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1978-ipv4-address-format-validate.apl

# # نقسم عند النقطة ونفحص كل جزء
# # الجزء 0 وحده يقبل بصفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صالح(س):
  اجزاء = س.split(".")
  لو طول(اجزاء) != 4:
    ارجع خطأ
  لكل ج في اجزاء:
    لو ج == "" أو (ج.isdigit() == خطأ):
      ارجع خطأ
    لو طول(ج) > 1 و ج[0] == "0":
      ارجع خطأ
    لو int(ج) > 255:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(صالح("192.168.1.1"), صواب, "صحيح")
تأكد_يساوي(صالح("256.1.1.1"), خطأ, "كبير")
تأكد_يساوي(صالح("1.2.3"), خطأ, "ثلاثة أجزاء")
تأكد_يساوي(صالح("01.2.3.4"), خطأ, "صفر بادئ")
تأكد_يساوي(صالح("a.b.c.d"), خطأ, "حروف")
تأكد_يساوي(صالح("0.0.0.0"), صواب, "أصفار")
