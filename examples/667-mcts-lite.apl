# مثال 667 — نواة UCB1 لبحث مونت كارلو
# UCB1 MCTS core
# Demonstrates: UCB1، استكشاف، استغلال
#
# Run:  python apl.py examples/667-mcts-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# UCB1: نواة بحث مونت كارلو الشجري
# Demonstrates: حد ثقة أعلى, استكشاف واستغلال, بذرة ثابتة
# نفس معادلة الاختيار التي تقود MCTS الكامل

بذرة = [1]
دالة تالي(ب):
  ب[0] = (ب[0] * 1103515245 + 12345) % 2147483648
  ارجع ب[0]

دالة محاولة(ذراع):
  حد = [500, 700, 900]
  ارجع تالي(بذرة) % 1000 < حد[ذراع]

دالة جذر_تقريبي(ن):
  س = ن * 1.0
  لكل ي في نطاق(20):
    س = (س + ن / س) / 2.0
  ارجع س

دالة لوغ_تقريبي(س):
  لو س <= 0.0:
    ارجع 0.0
  ن = 0.0
  بينما = س
  طالما بينما > 2.718281828:
    بينما = بينما / 2.718281828
    ن = ن + 1.0
  باقي = بينما - 1.0
  ارجع ن + باقي - باقي * باقي / 2.0 + باقي * باقي * باقي / 3.0

زيارات = [1, 1, 1]
فوز = [0, 0, 0]
لكل ذراع في نطاق(3):
  لو محاولة(ذراع):
    فوز[ذراع] = فوز[ذراع] + 1

دالة اختر_ucb(زيارات, فوز, كلي):
  أفضل = 0
  أعلى = 0 - 1.0
  لكل ذراع في نطاق(3):
    معدل = فوز[ذراع] * 1.0 / زيارات[ذراع]
    استكشاف = 2.0 * لوغ_تقريبي(كلي) / زيارات[ذراع]
    قيمة = معدل + جذر_تقريبي(استكشاف * 100.0) / 10.0
    لو قيمة > أعلى:
      أعلى = قيمة
      أفضل = ذراع
  ارجع أفضل

لكل دورة في نطاق(300):
  كلي = زيارات[0] + زيارات[1] + زيارات[2]
  ذراع = اختر_ucb(زيارات, فوز, كلي * 1.0)
  زيارات[ذراع] = زيارات[ذراع] + 1
  لو محاولة(ذراع):
    فوز[ذراع] = فوز[ذراع] + 1

تأكد_يساوي(زيارات[2] > زيارات[0], صواب, "الأفضل جرب أكثر")
تأكد_يساوي(زيارات[2] > زيارات[1], صواب, "الأفضل جرب أكثر من الوسط")
تأكد_يساوي(زيارات[0] + زيارات[1] + زيارات[2], 303, "عدد المحاولات")
اطبع "زيارات:", زيارات
