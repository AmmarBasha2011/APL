# مثال 2655 — ثلاثيات مجموعها 15
# Triples summing to 15
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2655-count-triples-sum-to-15-small.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل أ في نطاق(1, ن + 1):
    لكل ب في نطاق(أ, ن + 1):
      لكل ج في نطاق(ب, ن + 1):
        لو أ + ب + ج == 15:
          ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(5), 1, "حالة 1")
تأكد_يساوي(ف(15), 19, "حالة 2")
تأكد_يساوي(ف(18), 19, "حالة 3")
