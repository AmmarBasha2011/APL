# مثال 458 — توليد جمل بسلاسل بسيطة
# Simple markov sentences
# Demonstrates: انتقالات كلمة لكلمة
#
# Run:  python apl.py examples/458-markov-lite.apl

بذرة(3)
المتغير انتقالات = {
    "البداية": ["الطالب", "المهندس", "الكاتب"],
    "الطالب": ["يدرس", "يكتب"],
    "المهندس": ["يبني", "يصمم"],
    "الكاتب": ["يكتب", "يقرأ"],
    "يدرس": ["النهاية"],
    "يكتب": ["النهاية"],
    "يبني": ["النهاية"],
    "يصمم": ["النهاية"],
    "يقرأ": ["النهاية"]
}

المتغير حالية = "البداية"
المتغير جملة = []
طالما حالية != "النهاية":
    المتغير تاليات = انتقالات[حالية]
    حالية = تاليات[عشوائي_عدد(0, طول(تاليات) - 1)]
    لو حالية != "النهاية":
        جملة.append(حالية)

اطبع " ".ضم(جملة)
