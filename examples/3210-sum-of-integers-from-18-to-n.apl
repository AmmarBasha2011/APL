# مثال 3210 — مجموع الأعداد من 18 إلى ن
# Sum from 18 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3210-sum-of-integers-from-18-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(18, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(18), 18, "حالة 1")
تأكد_يساوي(ف(19), 37, "حالة 2")
تأكد_يساوي(ف(28), 253, "حالة 3")
تأكد_يساوي(ف(100), 4897, "حالة 4")
