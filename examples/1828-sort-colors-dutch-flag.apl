# مثال 1828 — فرز الألوان صفر واحد اثنان
# Sort colors Dutch flag
# Demonstrates: فرز
#
# Run:  python apl.py examples/1828-sort-colors-dutch-flag.apl

# الصفر إلى البداية والاثنان إلى النهاية
# الواحد يبقى في الوسط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة افرز_الألوان(ق):
  ق = ق + []
  بداية = 0
  وسط = 0
  نهاية = طول(ق) - 1
  طالما وسط <= نهاية:
    لو ق[وسط] == 0:
      ت = ق[بداية]
      ق[بداية] = ق[وسط]
      ق[وسط] = ت
      بداية = بداية + 1
      وسط = وسط + 1
    والا_لو ق[وسط] == 1:
      وسط = وسط + 1
    والا:
      ت = ق[نهاية]
      ق[نهاية] = ق[وسط]
      ق[وسط] = ت
      نهاية = نهاية - 1
  ارجع ق

تأكد_يساوي(افرز_الألوان([2, 0, 2, 1, 1, 0]), [0, 0, 1, 1, 2, 2], "ستة")
تأكد_يساوي(افرز_الألوان([1, 0]), [0, 1], "اثنان")
تأكد_يساوي(افرز_الألوان([0]), [0], "واحد")
