# مثال 4167 — تحويل وحدة بأساس 42
# Split by base 42
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4167-minutes-to-hours-and-minutes-base-42.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 42, ن % 42]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 17], "حالة 2")
تأكد_يساوي(ف(60), [1, 18], "حالة 3")
تأكد_يساوي(ف(125), [2, 41], "حالة 4")
تأكد_يساوي(ف(1000), [23, 34], "حالة 5")
