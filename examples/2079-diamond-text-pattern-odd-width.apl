# مثال 2079 — معين نصي من النجوم
# Diamond text pattern
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2079-diamond-text-pattern-odd-width.apl

# # نبني النصف العلوي
# # ثم ننسخه معكوسا بدون الصف الأوسط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة معين(ن):
  اعلى = []
  لكل ك في نطاق(1, ن + 1):
    اعلى = اعلى + [" " * (ن - ك) + "*" * (2 * ك - 1)]
  اسفل = اعلى[:-1]
  اسفل.reverse()
  ارجع اعلى + اسفل

تأكد_يساوي(معين(3), ["  *", " ***", "*****", " ***", "  *"], "٣")
تأكد_يساوي(معين(1), ["*"], "١")
