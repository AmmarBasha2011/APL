# مثال 209 — طرق صعود السلم (برمجة ديناميكية)
# Climbing stairs (DP)
# Demonstrates: جدول ديناميكي من الأسفل للأعلى
#
# Run:  python apl.py examples/209-climbing-stairs.apl

دالة طرق_الصعود(ن):
    لو ن <= 2:
        ارجع ن
    المتغير طرق = [0 لكل _ في نطاق(ن + 1)]
    طرق[1] = 1
    طرق[2] = 2
    لكل ي في نطاق(3, ن + 1):
        طرق[ي] = طرق[ي - 1] + طرق[ي - 2]
    ارجع طرق[ن]

لكل درجات في [3, 5, 10, 20]:
    اطبع "سلم من", درجات, "درجات:", طرق_الصعود(درجات), "طريقة"
