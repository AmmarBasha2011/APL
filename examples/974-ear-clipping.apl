# مثال 974 — قص الأذن للتثليث
# Ear clipping triangulation
# Demonstrates: رأس محدب خالٍ من النقاط
#
# Run:  python apl.py examples/974-ear-clipping.apl

# تثليث المضلع بقص الأذن: نزع مثلثات محدبة تباعاً
# الأذن رأس محدب لا يقع داخل مثلثه أي رأس آخر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متقاطع(أ, ب, ج):
  ارجع ((ب[0] - أ[0]) * (ج[1] - ب[1])) - ((ب[1] - أ[1]) * (ج[0] - ب[0]))

دالة داخل(ن, أ, ب, ج):
  د1 = متقاطع(أ, ب, ن)
  د2 = متقاطع(ب, ج, ن)
  د3 = متقاطع(ج, أ, ن)
  لو (د1 < 0) أو (د2 < 0) أو (د3 < 0):
    لو (د1 > 0) أو (د2 > 0) أو (د3 > 0):
      ارجع 0
  ارجع 1

دالة قص_أذن(نقاط):
  باقي = نقاط
  عدد = 0
  مساحة = 0
  طالما طول(باقي) > 3:
    ن = طول(باقي)
    وجد = 0
    i = 0
    طالما (وجد == 0) و (i < ن):
      سابق = باقي[((i + ن) - 1) % ن]
      حالي = باقي[i]
      تال = باقي[(i + 1) % ن]
      تقاطع = متقاطع(سابق, حالي, تال)
      لو تقاطع > 0:
        خال = 1
        لكل j في نطاق(ن):
          لو ((j != i) و (j != ((i + ن) - 1) % ن)) و (j != (i + 1) % ن):
            لو داخل(باقي[j], سابق, حالي, تال) == 1:
              خال = 0
        لو خال == 1:
          مساحة = مساحة + (تقاطع / 2)
          عدد = عدد + 1
          باقي = باقي[:i] + باقي[i + 1:]
          وجد = 1
      i = i + 1
    لو وجد == 0:
      اطبع "لا أذن صالحة"
      قياسي_نظام_اخرج(1)
  مساحة = مساحة + (متقاطع(باقي[0], باقي[1], باقي[2]) / 2)
  عدد = عدد + 1
  ارجع [عدد, مساحة]

مربع = قص_أذن([[0, 0], [4, 0], [4, 4], [0, 4]])
خماسي = قص_أذن([[0, 0], [2, 0], [3, 2], [1, 3], [0, 2]])
تأكد_يساوي(مربع[0], 2, "مثلثات المربع")
تأكد_يساوي(مربع[1], 16, "مساحة المربع")
تأكد_يساوي(خماسي[0], 3, "مثلثات الخماسي")
تأكد_يساوي(مقرب(خماسي[1], 6), 6.5, "مساحة الخماسي")
