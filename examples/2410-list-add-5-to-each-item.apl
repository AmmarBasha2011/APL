# مثال 2410 — إضافة 5 لكل عنصر
# Add 5 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2410-list-add-5-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 5]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [8, 6, 7], "حالة 1")
تأكد_يساوي(ف([5]), [10], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [6, 7, 8, 9, 10, 11], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [3, 5, 12, 12, 9], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [15, 25, 15, 35, 25, 15], "حالة 5")
