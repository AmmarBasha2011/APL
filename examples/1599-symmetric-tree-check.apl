# مثال 1599 — هل الشجرة متناظرة
# Symmetric tree check
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1599-symmetric-tree-check.apl

# نقارن الفرع الأيسر بمرآة الأيمن
# القيم متساوية والأبناء متقابلون

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متقابلان(أ, ب):
  لو أ == [] و ب == []:
    ارجع صواب
  لو أ == [] أو ب == []:
    ارجع خطأ
  لو أ[0] != ب[0]:
    ارجع خطأ
  ارجع متقابلان(أ[1], ب[2]) و متقابلان(أ[2], ب[1])

دالة متناظرة(ش):
  لو ش == []:
    ارجع صواب
  ارجع متقابلان(ش[1], ش[2])

تأكد_يساوي(متناظرة([1, [2, [], []], [2, [], []]]), صواب, "متناظرة")
تأكد_يساوي(متناظرة([1, [2, [3, [], []], []], [2, [], []]]), خطأ, "غير متناظرة")
تأكد_يساوي(متناظرة([]), صواب, "فارغة")
