# مثال 1259 — محدد المعدل
# Sliding window rate limiter
# Demonstrates: نافذة زمنية
#
# Run:  python apl.py examples/1259-rate-limiter-window.apl

# نحتفظ بأوقات الطلبات المقبولة
# ونحذف ما خرج من النافذة قبل كل قرار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف محدد:
  دالة_إنشاء(ذات, حد, نافذة):
    ذات.حد = حد
    ذات.نافذة = نافذة
    ذات.اوقات = []

  دالة اسمح(ذات, وقت):
    طالما (طول(ذات.اوقات) > 0) و (ذات.اوقات[0] <= وقت - ذات.نافذة):
      ذات.اوقات.pop(0)
    لو طول(ذات.اوقات) < ذات.حد:
      ذات.اوقات.ألحق(وقت)
      ارجع صواب
    ارجع خطأ

م = محدد(2, 10)
تأكد_يساوي(م.اسمح(1), صواب, "أول")
تأكد_يساوي(م.اسمح(2), صواب, "ثان")
تأكد_يساوي(م.اسمح(3), خطأ, "ثالث مرفوض")
تأكد_يساوي(م.اسمح(11), صواب, "خرج الأول من النافذة")
تأكد_يساوي(م.اسمح(12), صواب, "خرج الثاني")
تأكد_يساوي(م.اسمح(13), خطأ, "ممتلئة")
