# مثال 1706 — أقل قفزات للنهاية
# Minimum jumps to reach the end
# Demonstrates: جشع
#
# Run:  python apl.py examples/1706-min-jumps-to-end.apl

# نتتبع نهاية القفزة الحالية
# نزيد القفزات عند بلوغها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أقل_قفزات(ق):
  لو طول(ق) <= 1:
    ارجع 0
  قفزات = 0
  نهاية = 0
  أبعد = 0
  لكل ك في نطاق(طول(ق) - 1):
    أبعد = أكبر(أبعد, ك + ق[ك])
    لو ك == نهاية:
      قفزات = قفزات + 1
      نهاية = أبعد
  ارجع قفزات

تأكد_يساوي(أقل_قفزات([2, 3, 1, 1, 4]), 2, "اثنان")
تأكد_يساوي(أقل_قفزات([1, 1, 1, 1]), 3, "ثلاثة")
تأكد_يساوي(أقل_قفزات([5]), 0, "واحد")
