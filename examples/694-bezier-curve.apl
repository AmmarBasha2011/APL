# مثال 694 — منحنيات بيزييه
# Bezier curves
# Demonstrates: كاستلجو، أوزان برنشتاين، تقييم
#
# Run:  python apl.py examples/694-bezier-curve.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# منحنيات بيزييه التربيعية والتكعيبية
# Demonstrates: كاستلجو, أوزان برنشتاين, تقييم عند ت
# نقطة المنتصف لمنحنى تكعيبي متماثل تقع في منتصف الرأس

دالة بيزييه_تربيعي(ن0, ن1, ن2, ت):
  س = (1 - ت) * (1 - ت) * ن0[0] + 2 * (1 - ت) * ت * ن1[0] + ت * ت * ن2[0]
  ع = (1 - ت) * (1 - ت) * ن0[1] + 2 * (1 - ت) * ت * ن1[1] + ت * ت * ن2[1]
  ارجع [س, ع]

دالة بيزييه_تكعيبي(ن0, ن1, ن2, ن3, ت):
  ق = 1 - ت
  س = ق * ق * ق * ن0[0] + 3 * ق * ق * ت * ن1[0] + 3 * ق * ت * ت * ن2[0] + ت * ت * ت * ن3[0]
  ع = ق * ق * ق * ن0[1] + 3 * ق * ق * ت * ن1[1] + 3 * ق * ت * ت * ن2[1] + ت * ت * ت * ن3[1]
  ارجع [س, ع]

نق = بيزييه_تكعيبي([0, 0], [1, 2], [3, 2], [4, 0], 0.5)
تأكد_يساوي(نق, [2.0, 1.5], "منتصف التكعيبي")
تأكد_يساوي(بيزييه_تكعيبي([0, 0], [1, 2], [3, 2], [4, 0], 0.0), [0, 0], "البداية")
تأكد_يساوي(بيزييه_تكعيبي([0, 0], [1, 2], [3, 2], [4, 0], 1.0), [4, 0], "النهاية")
ت2 = بيزييه_تربيعي([0, 0], [2, 4], [4, 0], 0.5)
تأكد_يساوي(ت2, [2.0, 2.0], "منتصف التربيعي")
تأكد_يساوي(بيزييه_تربيعي([0, 0], [2, 4], [4, 0], 0.25), [1.0, 1.5], "ربع التربيعي")
اطبع "منتصف:", نق
