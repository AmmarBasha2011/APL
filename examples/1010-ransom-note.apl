# مثال 1010 — رسالة الفدية
# Ransom note
# Demonstrates: جرد الحروف
#
# Run:  python apl.py examples/1010-ransom-note.apl

# نجرد حروف المجلة في قائمة ثم نستهلك منها حروف الرسالة
# لو نفد حرف فالرسالة لا تُبنى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تكفي(رسالة, مجلة):
  متاح = []
  لكل ح في مجلة:
    متاح.ألحق(ح)
  لكل ح في رسالة:
    لو ح في متاح:
      ف = 0
      طالما متاح[ف] != ح:
        ف = ف + 1
      متاح[ف] = ""
    والا:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(تكفي("a", "b"), خطأ, "حرف ناقص")
تأكد_يساوي(تكفي("aa", "ab"), خطأ, "حرف مكرر ناقص")
تأكد_يساوي(تكفي("aa", "aab"), صواب, "يكفي")
تأكد_يساوي(تكفي("", "x"), صواب, "رسالة فارغة")
