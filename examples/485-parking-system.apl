# مثال 485 — نظام مواقف سيارات
# Parking system
# Demonstrates: أماكن ورسوم بالساعة
#
# Run:  python apl.py examples/485-parking-system.apl

صنف موقف:
    دالة_إنشاء(ذات, سعة):
        ذات.سعة = سعة
        ذات.سيارات = []

    دالة ادخل(ذات, لوحة):
        لو طول(ذات.سيارات) >= ذات.سعة:
            اطبع "ممتلئ:", لوحة
            ارجع
        ذات.سيارات.append(لوحة)
        اطبع "دخلت:", لوحة

    دالة اخرج(ذات, لوحة, ساعات_وقوف):
        ذات.سيارات.remove(لوحة)
        المتغير رسوم = ساعات_وقوف * 10
        اطبع "خرجت:", لوحة, "- الرسوم:", رسوم

المتغير م = موقف(2)
م.ادخل("أ ب 123")
م.ادخل("ج د 456")
م.ادخل("هـ و 789")
م.اخرج("أ ب 123", 3)
م.ادخل("هـ و 789")
