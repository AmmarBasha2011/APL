# مثال 551 — ترتيب ضرب المصفوفات
# Matrix chain multiplication DP
# Demonstrates: برمجة ديناميكية، ضرب مصفوفات، أقل كلفة
#
# Run:  python apl.py examples/551-matrix-chain-dp.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# ترتيب ضرب المصفوفات بأقل كلفة (برمجة ديناميكية)
دالة أقل_كلفة(أبعاد):
    المتغير ن = طول(أبعاد) - 1
    المتغير جدول = قائمة()
    لكل i في نطاق(ن):
        جدول.أضف([0] * ن)
    لكل طول_سلسلة في نطاق(2, ن + 1):
        لكل i في نطاق(ن - طول_سلسلة + 1):
            المتغير j = i + طول_سلسلة - 1
            جدول[i][j] = 999999999
            لكل ك في نطاق(i, j):
                المتغير كلفة = جدول[i][ك] + جدول[ك + 1][j] + أبعاد[i] * أبعاد[ك + 1] * أبعاد[j + 1]
                لو كلفة < جدول[i][j]:
                    جدول[i][j] = كلفة
    ارجع جدول[0][ن - 1]

تأكد_يساوي(أقل_كلفة([40, 20, 30, 10, 30]), 26000, "المثال الكلاسيكي")
تأكد_يساوي(أقل_كلفة([10, 20, 30]), 6000, "مصفوفتان")
