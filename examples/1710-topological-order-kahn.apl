# مثال 1710 — ترتيب طوبولوجي بطريقة كان
# Topological order by Kahn
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1710-topological-order-kahn.apl

# نحسب درجة الدخول
# نخفضها عند إزالة كل عقدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ترتيب_طوبولوجي(ن, حواف):
  درجة = []
  جيران = []
  لكل ك في نطاق(ن):
    درجة.append(0)
    جيران.append([])
  لكل ح في حواف:
    جيران[ح[0]].append(ح[1])
    درجة[ح[1]] = درجة[ح[1]] + 1
  طابور = []
  لكل ك في نطاق(ن):
    لو درجة[ك] == 0:
      طابور.append(ك)
  ناتج = []
  طالما طول(طابور) > 0:
    ع = طابور.pop(0)
    ناتج.append(ع)
    لكل ج في جيران[ع]:
      درجة[ج] = درجة[ج] - 1
      لو درجة[ج] == 0:
        طابور.append(ج)
  ارجع ناتج

تأكد_يساوي(ترتيب_طوبولوجي(4, [[0, 1], [0, 2], [1, 3], [2, 3]]), [0, 1, 2, 3], "ماسة")
تأكد_يساوي(طول(ترتيب_طوبولوجي(2, [[0, 1], [1, 0]])), 0, "دورة")
