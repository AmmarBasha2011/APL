# مثال 715 — ترميز ساوندكس
# Soundex
# Demonstrates: تقارب صوتي، دمج، حشو
#
# Run:  python apl.py examples/715-soundex-en.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ترميز ساوندكس للأسماء الإنجليزية
# Demonstrates: خريطة حروف لأرقام, دمج المتجاورات المتماثلة, حشو بأصفار
# الأسماء المتقاربة صوتيا تتشارك الرمز: Robert و Rupert كلاهما R163

دالة رقم_حرف(ح):
  لو ح في "BFPV":
    ارجع "1"
  لو ح في "CGJKQSXZ":
    ارجع "2"
  لو ح في "DT":
    ارجع "3"
  لو ح == "L":
    ارجع "4"
  لو ح في "MN":
    ارجع "5"
  لو ح == "R":
    ارجع "6"
  ارجع ""

دالة ساوندكس(خام):
  اسم = خام.upper()
  أول = اسم[0]
  رموز = ""
  سابق = رقم_حرف(أول)
  لكل ي في نطاق(1, طول(اسم)):
    ر = رقم_حرف(اسم[ي])
    لو ر != "" و ر != سابق:
      رموز = رموز + ر
    لو (اسم[ي] في "HW") == خطأ:
      سابق = ر
  ناتج = أول + رموز
  طالما طول(ناتج) < 4:
    ناتج = ناتج + "0"
  ارجع ناتج[:4]

تأكد_يساوي(ساوندكس("Robert"), "R163", "روبرت")
تأكد_يساوي(ساوندكس("Rupert"), "R163", "روبرت مثل روبرت")
تأكد_يساوي(ساوندكس("Rubin"), "R150", "روبين")
تأكد_يساوي(ساوندكس("Ashcraft"), "A261", "أشكرافت")
تأكد_يساوي(ساوندكس("Lee"), "L000", "لي بلا أرقام")
تأكد_يساوي(ساوندكس("Gutierrez"), "G362", "جوتيريز")
اطبع ساوندكس("Robert"), "=", ساوندكس("Rupert")
