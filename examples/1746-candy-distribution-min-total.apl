# مثال 1746 — أقل عدد حلوى للأطفال
# Minimum candies by ratings
# Demonstrates: جشع
#
# Run:  python apl.py examples/1746-candy-distribution-min-total.apl

# مرور من اليسار ثم من اليمين
# نأخذ الأكبر من الشرطين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حلوى(تقييم):
  ن = طول(تقييم)
  ح = []
  لكل ك في نطاق(ن):
    ح.append(1)
  لكل ك في نطاق(1, ن):
    لو تقييم[ك] > تقييم[ك - 1]:
      ح[ك] = ح[ك - 1] + 1
  لكل ك في نطاق(ن - 2, -1, -1):
    لو تقييم[ك] > تقييم[ك + 1]:
      ح[ك] = أكبر(ح[ك], ح[ك + 1] + 1)
  مجموع = 0
  لكل ع في ح:
    مجموع = مجموع + ع
  ارجع مجموع

تأكد_يساوي(حلوى([1, 0, 2]), 5, "ثلاثة")
تأكد_يساوي(حلوى([1, 2, 2]), 4, "متساوية")
تأكد_يساوي(حلوى([1]), 1, "طفل")
