# مثال 1392 — عدد شامل الأرقام
# Pandigital number check
# Demonstrates: رياضيات
#
# Run:  python apl.py examples/1392-pandigital-check.apl

# الطول يجب أن يساوي ن
# وكل رقم يظهر بالضبط مرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة شامل(نص_, ن):
  لو طول(نص_) != ن:
    ارجع خطأ
  لكل د في نطاق(1, ن + 1):
    لو نص_.count(نص(د)) != 1:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(شامل("123456789", 9), صواب, "تسعة")
تأكد_يساوي(شامل("52314", 5), صواب, "خمسة")
تأكد_يساوي(شامل("12345678", 9), خطأ, "ناقص")
تأكد_يساوي(شامل("1123", 3), خطأ, "تكرار")
