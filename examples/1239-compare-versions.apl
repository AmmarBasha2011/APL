# مثال 1239 — مقارنة الإصدارات
# Compare version numbers
# Demonstrates: تقسيم
#
# Run:  python apl.py examples/1239-compare-versions.apl

# نقسم على النقاط ونقارن رقماً رقماً
# والناقص يعامل كصفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قارن(أ, ب):
  س = أ.split(".")
  ص = ب.split(".")
  ن = أكبر(طول(س), طول(ص))
  لكل ع في نطاق(ن):
    ق1 = 0
    ق2 = 0
    لو ع < طول(س):
      ق1 = صحيح(س[ع])
    لو ع < طول(ص):
      ق2 = صحيح(ص[ع])
    لو ق1 < ق2:
      ارجع -1
    لو ق1 > ق2:
      ارجع 1
  ارجع 0

تأكد_يساوي(قارن("1.01", "1.001"), 0, "أصفار بادئة")
تأكد_يساوي(قارن("1.0", "1.0.0"), 0, "ناقص")
تأكد_يساوي(قارن("0.1", "1.1"), -1, "أصغر")
تأكد_يساوي(قارن("1.2.10", "1.2.9"), 1, "عشرة أكبر من تسعة")
