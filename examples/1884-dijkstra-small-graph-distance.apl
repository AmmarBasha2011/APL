# مثال 1884 — أقصر مسافة بخوارزمية ديكسترا
# Dijkstra shortest distance
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1884-dijkstra-small-graph-distance.apl

# مصفوفة مسافات تبدأ لانهائية
# نحدث الجيران بعد كل اختيار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ديكسترا(ن, حواف, بداية):
  كبير = 1000000
  مسافة = []
  زار = []
  لكل ك في نطاق(ن):
    مسافة.append(كبير)
    زار.append(خطأ)
  مسافة[بداية] = 0
  لكل خطوة في نطاق(ن):
    ع = -1
    لكل ك في نطاق(ن):
      لو زار[ك] == خطأ و (ع == -1 أو مسافة[ك] < مسافة[ع]):
        ع = ك
    لو ع == -1 أو مسافة[ع] == كبير:
      ارجع مسافة
    زار[ع] = صواب
    لكل ح في حواف:
      لو ح[0] == ع و مسافة[ع] + ح[2] < مسافة[ح[1]]:
        مسافة[ح[1]] = مسافة[ع] + ح[2]
  ارجع مسافة

ح = [[0, 1, 4], [0, 2, 1], [2, 1, 2], [1, 3, 1], [2, 3, 5]]
تأكد_يساوي(ديكسترا(4, ح, 0), [0, 3, 1, 4], "أربع عقد")
تأكد_يساوي(ديكسترا(2, [], 0)[1], 1000000, "غير متصل")
