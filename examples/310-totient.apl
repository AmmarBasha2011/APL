# مثال 310 — دالة أويلر (مؤشر القواسم المشتركة)
# Euler's totient
# Demonstrates: عد الأعداد الأولية النسبية
#
# Run:  python apl.py examples/310-totient.apl

دالة قاسم_مشترك(أ, ب):
    طالما ب != 0:
        المتغير مؤقت = ب
        ب = أ % ب
        أ = مؤقت
    ارجع أ

دالة أويلر(ن):
    المتغير عدد = 0
    لكل ك في نطاق(1, ن + 1):
        لو قاسم_مشترك(ك, ن) == 1:
            عدد = عدد + 1
    ارجع عدد

اطبع "φ(9) =", أويلر(9)
اطبع "φ(10) =", أويلر(10)
اطبع "φ(13) =", أويلر(13)
