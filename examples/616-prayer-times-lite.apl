# مثال 616 — مواقيت الصلاة التقريبية
# Prayer times approximation
# Demonstrates: شمس، ميل، زاوية ساعية
#
# Run:  python apl.py examples/616-prayer-times-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مواقيت الصلاة التقريبية للقاهرة من حساب شمسي مبسط
# Demonstrates: ميل الشمس, معادلة الوقت, زاوية ساعية بجيب التمام العكسي
# تقريب تعليمي؛ المواقيت الرسمية تصدر عن جهات الاختصاص

دالة ميل_الشمس(يوم):
  ارجع 23.45 * جب(راديان(360.0 * (284 + يوم) / 365))

دالة معادلة_الوقت(يوم):
  ب = راديان(360.0 * (يوم - 81) / 365)
  ارجع 9.87 * جب(2 * ب) - 7.53 * جتا(ب) - 1.5 * جب(ب)

دالة زاوية_ساعية(عرض, ميل, سمت):
  بسط = جتا(راديان(سمت)) - جب(راديان(عرض)) * جب(راديان(ميل))
  مقام = جتا(راديان(عرض)) * جتا(راديان(ميل))
  ارجع درجات(م_جتا(بسط / مقام))

عرض_القاهرة = 30.0444
طول_القاهرة = 31.2357
يوم = 80

ظهر = 12 + 2 - طول_القاهرة / 15 - معادلة_الوقت(يوم) / 60
ميل = ميل_الشمس(يوم)
سعة = زاوية_ساعية(عرض_القاهرة, ميل, 90.833) / 15
شروق = ظهر - سعة
غروب = ظهر + سعة

اطبع "الظهر:", مقرب(ظهر, 2), " الشروق:", مقرب(شروق, 2), " الغروب:", مقرب(غروب, 2)
تأكد_يساوي(ظهر > 11.5 و ظهر < 12.5, صواب, "الظهر قرب منتصف اليوم")
تأكد_يساوي(شروق > 5.0 و شروق < 7.0, صواب, "شروق الربيع فجرا")
تأكد_يساوي(غروب > 17.0 و غروب < 19.0, صواب, "غروب الربيع مساء")
تأكد_يساوي(غروب - شروق > 11.5 و غروب - شروق < 12.5, صواب, "طول النهار الاعتدالي نحو 12 ساعة")
