# مثال 1667 — هل تتداخل فترتان
# Any pair of intervals overlaps
# Demonstrates: فترات
#
# Run:  python apl.py examples/1667-intervals-any-overlap-check.apl

# بعد الترتيب يكفي فحص الجار
# التداخل إذا بدأت فترة قبل نهاية سابقتها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يوجد_تداخل(فترات):
  ف = []
  لكل ع في فترات:
    ف.append([ع[0], ع[1]])
  ف.sort()
  لكل ك في نطاق(1, طول(ف)):
    لو ف[ك][0] < ف[ك - 1][1]:
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(يوجد_تداخل([[1, 3], [2, 4]]), صواب, "تداخل")
تأكد_يساوي(يوجد_تداخل([[1, 2], [2, 3]]), خطأ, "تلامس فقط")
تأكد_يساوي(يوجد_تداخل([[5, 6], [1, 2], [3, 4]]), خطأ, "غير مرتبة")
