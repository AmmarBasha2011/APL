# مثال 173 — عداد مشترك بقفل بين الخيوط
# Shared counter with a thread lock
# Demonstrates: أنشئ_ثريد، أنشئ_قفل، ابدأ_خيوط، انتظر_خيوط
#
# Run:  python apl.py examples/173-threading-lock.apl

المتغير قفل = أنشئ_قفل()
المتغير عداد = [0]

دالة زد():
    لكل _ في نطاق(10000):
        قفل.acquire()
        عداد[0] = عداد[0] + 1
        قفل.release()

المتغير خيوط = []
لكل _ في نطاق(4):
    المتغير ت = أنشئ_ثريد(target=زد)
    خيوط.أضف(ت)
    ت.start()
لكل ت في خيوط:
    ت.join()

اطبع "القيمة النهائية:", عداد[0]
اطبع "صحيحة؟", عداد[0] == 40000
