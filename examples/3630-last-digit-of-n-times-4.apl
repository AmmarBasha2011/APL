# مثال 3630 — آخر رقم من ن×4
# Last digit of n times 4
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3630-last-digit-of-n-times-4.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 4) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 4, "حالة 2")
تأكد_يساوي(ف(7), 8, "حالة 3")
تأكد_يساوي(ف(12), 8, "حالة 4")
تأكد_يساوي(ف(99), 6, "حالة 5")
