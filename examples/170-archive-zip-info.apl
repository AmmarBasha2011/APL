# مثال 170 — فحص أرشيف ZIP وإحصاءاته
# Inspecting a ZIP archive
# Demonstrates: أنشئ_أرشيف، ملخص_الأرشيف، نسبة_الضغط، نوع_الأرشيف
#
# Run:  python apl.py examples/170-archive-zip-info.apl

المتغير جذر = "/tmp/apl_zipinfo_demo"
انشئ_مجلدات(جذر)
اكتب(جذر + "/سجل.txt", "سطر متكرر للضغط\n" * 50)

أنشئ_أرشيف(جذر + "/بيانات.zip", [جذر + "/سجل.txt"])
اطبع "النوع:", نوع_الأرشيف(جذر + "/بيانات.zip")
اطبع "الأعضاء:", عدد_الأعضاء(جذر + "/بيانات.zip")
اطبع "حجم الملف:", حجم_بشري(حجم_الأرشيف(جذر + "/بيانات.zip"))
اطبع "غير مضغوط:", حجم_بشري(حجم_غير_مضغوط(جذر + "/بيانات.zip"))
اطبع "داخل الأرشيف؟", داخل_الأرشيف(جذر + "/بيانات.zip", "سجل.txt")

احذف_شجرة(جذر)
