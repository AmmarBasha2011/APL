# مثال 75 — الضغط والأرشيف (مكتبة datafiles)
# Compression and archives (zipfile / gzip / bz2)
#
# Run:  python apl.py examples/75-df-archive.apl

اطبع "=== أرشيف مضغوط ==="
المتغير ز = ملف_مضغوط_2("/tmp/apl-df.zip", "w")
ز.أرشيف_مضغوط_ملف_اكتب_نصاً("echo.txt", "أهلاً من مكتبة البيانات")
ز.أرشيف_مضغوط_ملف_أغلق()
اطبع "هو_ملف_مضغوط:", هو_ملف_مضغوط("/tmp/apl-df.zip")

المتغير قراءة = ملف_مضغوط_2("/tmp/apl-df.zip")
اطبع "الأعضاء:", قراءة.أرشيف_مضغوط_ملف_قائمة_الأسماء()
اطبع "المحتوى:", قراءة.أرشيف_مضغوط_ملف_اقرأ("echo.txt")
قراءة.أرشيف_مضغوط_ملف_أغلق()

اطبع ""
اطبع "=== ضغط gzip ==="
المتغير g = افتح_gzip_2("/tmp/apl-df.txt.gz", "wt")
g.نص_إدخال_إخراج_غلاف_اكتب("نص مضغوط بالعربية")
g.نص_إدخال_إخراج_غلاف_أغلق()

المتغير g2 = افتح_gzip_2("/tmp/apl-df.txt.gz", "rt")
اطبع "مقروء:", g2.نص_إدخال_إخراج_غلاف_اقرأ()
g2.نص_إدخال_إخراج_غلاف_أغلق()

اطبع ""
اطبع "=== ضغط bz2 ==="
المتغير b = افتح_bz2_2("/tmp/apl-df.txt.bz2", "wt")
b.BZ_2_ملف_اكتب("نص مضغوط مرتين")
b.BZ_2_ملف_أغلق()
اطبع "الحجم بعد الضغط:", حجم_ملف_2("/tmp/apl-df.txt.bz2")
