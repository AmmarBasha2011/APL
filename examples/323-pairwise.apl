# مثال 323 — أزواج متتالية
# Pairwise iteration
# Demonstrates: عنصر والذي يليه
#
# Run:  python apl.py examples/323-pairwise.apl

دالة أزواج(قائمة):
    المتغير نتيجة = []
    لكل ي في نطاق(طول(قائمة) - 1):
        نتيجة.أضف([قائمة[ي], قائمة[ي + 1]])
    ارجع نتيجة

اطبع أزواج([1, 2, 3, 4])

المتغير فروق = [زوج[1] - زوج[0] لكل زوج في أزواج([10, 13, 17, 18])]
اطبع "الفروق:", فروق
