# مثال 2445 — قيصر بإزاحة 5
# Caesar shift 5
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2445-caesar-shift-by-5-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 5) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "fgh", "حالة 1")
تأكد_يساوي(ف("xyz"), "cde", "حالة 2")
تأكد_يساوي(ف("hello world"), "mjqqt btwqi", "حالة 3")
تأكد_يساوي(ف("a1"), "f1", "حالة 4")
