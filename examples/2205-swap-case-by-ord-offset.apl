# مثال 2205 — عكس حالة الأحرف
# Swap case by ord offset
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2205-swap-case-by-ord-offset.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.isupper():
      ر = ر + chr(ord(ح) + 32)
    والا_لو ح.islower():
      ر = ر + chr(ord(ح) - 32)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("Hello"), "hELLO", "حالة 1")
تأكد_يساوي(ف("abc"), "ABC", "حالة 2")
تأكد_يساوي(ف("ABC"), "abc", "حالة 3")
تأكد_يساوي(ف("aB1 cD"), "Ab1 Cd", "حالة 4")
