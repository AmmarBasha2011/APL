# مثال 3416 — مجموع المربعات من 12 إلى ن
# Sum of squares from 12
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3416-sum-of-squares-from-12-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(12, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(12), 144, "حالة 1")
تأكد_يساوي(ف(13), 313, "حالة 2")
تأكد_يساوي(ف(22), 3289, "حالة 3")
تأكد_يساوي(ف(100), 337844, "حالة 4")
