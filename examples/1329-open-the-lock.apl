# مثال 1329 — فتح القفل
# Open the lock minimum turns
# Demonstrates: بحث بالعرض
#
# Run:  python apl.py examples/1329-open-the-lock.apl

# كل لفة تغير رقماً واحداً بمقدار واحد
# نتجنب الأرقام الميتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة افتح(ميتة, هدف):
  لو "0000" في ميتة:
    ارجع -1
  مرئي = {"0000": صواب}
  طابور = [["0000", 0]]
  ع = 0
  طالما ع < طول(طابور):
    ق = طابور[ع][0]
    خ = طابور[ع][1]
    ع = ع + 1
    لو ق == هدف:
      ارجع خ
    لكل م في نطاق(4):
      لكل د في [1, 9]:
        ر = (صحيح(ق[م]) + د) % 10
        ن = ق[:م] + نص(ر) + ق[م + 1:]
        لو (ن ليس في مرئي) و (ن ليس في ميتة):
          مرئي[ن] = صواب
          طابور.ألحق([ن, خ + 1])
  ارجع -1

تأكد_يساوي(افتح(["0201","0101","0102","1212","2002"], "0202"), 6, "مثال أول")
تأكد_يساوي(افتح(["8888"], "0009"), 1, "لفة واحدة")
تأكد_يساوي(افتح(["0000"], "8888"), -1, "بداية ميتة")
تأكد_يساوي(افتح([], "0000"), 0, "الهدف بداية")
