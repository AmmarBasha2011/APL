# مثال 1711 — هل الرسم ثنائي التجزئة
# Bipartite graph check
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1711-graph-bipartite-check.apl

# نلون الجار بعكس اللون
# التعارض يعني فشلاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ثنائي(جيران):
  ن = طول(جيران)
  لون = []
  لكل ك في نطاق(ن):
    لون.append(-1)
  لكل بداية في نطاق(ن):
    لو لون[بداية] == -1:
      لون[بداية] = 0
      طابور = [بداية]
      طالما طول(طابور) > 0:
        ع = طابور.pop(0)
        لكل ج في جيران[ع]:
          لو لون[ج] == -1:
            لون[ج] = 1 - لون[ع]
            طابور.append(ج)
          والا_لو لون[ج] == لون[ع]:
            ارجع خطأ
  ارجع صواب

تأكد_يساوي(ثنائي([[1, 3], [0, 2], [1, 3], [0, 2]]), صواب, "مربع")
تأكد_يساوي(ثنائي([[1, 2], [0, 2], [0, 1]]), خطأ, "مثلث")
