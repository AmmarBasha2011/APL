# مثال 1024 — الثلاثيات الفيثاغورية
# Pythagorean triples
# Demonstrates: الجذر الصحيح
#
# Run:  python apl.py examples/1024-pythagorean-triples.apl

# أ² + ب² = ج² بأعداد صحيحة
# نجرب كل زوج أ < ب ونتحقق أن مجموع المربعين مربع كامل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جذر_صحيح(ن):
  ج = 0
  طالما (ج + 1) * (ج + 1) <= ن:
    ج = ج + 1
  ارجع ج

دالة ثلاثيات(حد):
  ناتج = []
  لكل أ في نطاق(1, حد + 1):
    لكل ب في نطاق(أ + 1, حد + 1):
      ج = جذر_صحيح((أ * أ) + (ب * ب))
      لو (ج * ج == (أ * أ) + (ب * ب)) و (ج <= حد):
        ناتج.ألحق([أ, ب, ج])
  ارجع ناتج

تأكد_يساوي(ثلاثيات(13), [[3, 4, 5], [5, 12, 13], [6, 8, 10]], "حتى ثلاثة عشر")
تأكد_يساوي(طول(ثلاثيات(20)), 6, "حتى عشرين")
تأكد_يساوي(ثلاثيات(4), [], "لا شيء")
