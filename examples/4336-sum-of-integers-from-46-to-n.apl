# مثال 4336 — مجموع الأعداد من 46 إلى ن
# Sum from 46 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4336-sum-of-integers-from-46-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(46, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(46), 46, "حالة 1")
تأكد_يساوي(ف(47), 93, "حالة 2")
تأكد_يساوي(ف(56), 561, "حالة 3")
تأكد_يساوي(ف(100), 4015, "حالة 4")
