# مثال 3102 — متتالية أ=5×السابق+1
# Recurrence times 5 plus one
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/3102-linear-recurrence-a-n-equals-5-times-previous-plus-one.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 1
  لكل ي في نطاق(ن):
    أ = أ * 5 + 1
  ارجع أ

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 6, "حالة 2")
تأكد_يساوي(ف(2), 31, "حالة 3")
تأكد_يساوي(ف(5), 3906, "حالة 4")
تأكد_يساوي(ف(8), 488281, "حالة 5")
