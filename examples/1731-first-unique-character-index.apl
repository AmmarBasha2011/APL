# مثال 1731 — أول حرف غير مكرر
# First unique character index
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1731-first-unique-character-index.apl

# قاموس للتكرار
# نمر بالترتيب الأصلي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أول_فريد(س):
  عد = {}
  لكل ح في س:
    عد[ح] = عد.get(ح, 0) + 1
  لكل ك في نطاق(طول(س)):
    لو عد[س[ك]] == 1:
      ارجع ك
  ارجع -1

تأكد_يساوي(أول_فريد("leetcode"), 0, "الأول")
تأكد_يساوي(أول_فريد("loveleetcode"), 2, "الثالث")
تأكد_يساوي(أول_فريد("aabb"), -1, "لا يوجد")
