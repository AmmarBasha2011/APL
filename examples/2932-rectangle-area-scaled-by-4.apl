# مثال 2932 — مساحة مستطيل مكبر 4 مرات
# Rectangle area scaled by 4
# Demonstrates: هندسة
#
# Run:  python apl.py examples/2932-rectangle-area-scaled-by-4.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 4) * (ق[1] * 4)

تأكد_يساوي(ف([1, 2]), 32, "حالة 1")
تأكد_يساوي(ف([3, 4]), 192, "حالة 2")
تأكد_يساوي(ف([5, 5]), 400, "حالة 3")
تأكد_يساوي(ف([10, 1]), 160, "حالة 4")
