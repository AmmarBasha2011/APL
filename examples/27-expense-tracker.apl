# مثال 27 — متتبع المصروفات
# Expense Tracker
# Demonstrates: lists of dicts, aggregation, sorting, formatting
#
# Run:  python apl.py examples/27-expense-tracker.apl

المتغير المصروفات = [
    {"الفئة": "طعام", "المبلغ": 250, "الوصف": "عشاء"},
    {"الفئة": "نقل", "المبلغ": 80, "الوصف": "تاكسي"},
    {"الفئة": "طعام", "المبلغ": 120, "الوصف": "غداء"},
    {"الفئة": "تسوق", "المبلغ": 600, "الوصف": "ملابس"},
    {"الفئة": "نقل", "المبلغ": 200, "الوصف": "مواصلات"},
    {"الفئة": "تسوق", "المبلغ": 150, "الوصف": "كتب"}
]

دالة_إجمالي():
    المجموع = 0
    لكل عنصر في المصروفات:
        المجموع = المجموع + عنصر["المبلغ"]
    ارجع المجموع

دالة_حسب_الفئة(الفئة):
    المجموع = 0
    لكل عنصر في المصروفات:
        إذا عنصر["الفئة"] == الفئة:
            المجموع = المجموع + عنصر["المبلغ"]
    ارجع المجموع

دالة_أعلى_مصروف():
    الأعلى = 0
    الوصف = ""
    لكل عنصر في المصروفات:
        إذا عنصر["المبلغ"] > الأعلى:
            الأعلى = عنصر["المبلغ"]
            الوصف = عنصر["الوصف"]
    ارجع [الوصف, الأعلى]

اطبع "=== متتبع المصروفات ==="
اطبع "عدد المصروفات: " + نص(طول(المصروفات))
اطبع ""
اطبع "--- حسب الفئة ---"
لكل فئة in ["طعام", "نقل", "تسوق"]:
    اطبع "  " + فئة + ": " + نص(حسب_الفئة(فئة))
اطبع ""
اطبع "--- التفاصيل ---"
لكل عنصر في المصروفات:
    اطبع f"  {element["الوصف"]}: {element["المبلغ"]} ({element["الفئة"]})" if False else "  " + عنصر["الوصف"] + ": " + نص(عنصر["المبلغ"]) + " (" + عنصر["الفئة"] + ")"
اطبع ""
اطبع "الإجمالي الكلي: " + نص(إجمالي())
المتvariable_أعلى = أعلى_مصروف()
المتغير الاش = أعلى
اطبع "أعلى مصروف: " + أعلى_مصروف()[0] + " (" + نص(أعلى_مصروف()[1]) + ")"
