# مثال 932 — تشابه جارو-وينكلر
# Jaro-Winkler similarity
# Demonstrates: مطابقات وتبديلات وبادئة
#
# Run:  python apl.py examples/932-jaro-winkler.apl

# تشابه جارو-وينكلر: قياس تقارب السلاسل النصية
# جارو + مكافأة للبادئة المشتركة (مناسب للأسماء)

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جارو(س1, س2):
  ن1 = طول(س1)
  ن2 = طول(س2)
  نافذة = (ن1 + ن2) // 4
  لو نافذة < 1:
    نافذة = 1
  م1 = []
  م2 = []
  لكل _ في نطاق(ن1):
    م1.ألحق(0)
  لكل _ في نطاق(ن2):
    م2.ألحق(0)
  مطابقات = 0
  لكل i في نطاق(ن1):
    بداية = i - نافذة
    لو بداية < 0:
      بداية = 0
    نهاية = i + نافذة + 1
    لو نهاية > ن2:
      نهاية = ن2
    لكل ج في نطاق(بداية, نهاية):
      لو (م2[ج] == 0) و (س2[ج] == س1[i]):
        م1[i] = 1
        م2[ج] = 1
        مطابقات = مطابقات + 1
  لو مطابقات == 0:
    ارجع 0
  تبديلات = 0
  k = 0
  لكل i في نطاق(ن1):
    لو م1[i] == 1:
      طالما م2[k] == 0:
        k = k + 1
      لو س1[i] != س2[k]:
        تبديلات = تبديلات + 1
      k = k + 1
  ارجع (مطابقات / ن1 + مطابقات / ن2 + (مطابقات - تبديلات / 2) / مطابقات) / 3

دالة جارو_وينكلر(س1, س2):
  ج = جارو(س1, س2)
  بادئة = 0
  متصل = 1
  لكل i في نطاق(4):
    لو متصل == 1 و (i < طول(س1)) و (i < طول(س2)) و (س1[i] == س2[i]):
      بادئة = بادئة + 1
    والا:
      متصل = 0
  ارجع ج + بادئة * 0.1 * (1 - ج)

اطبع "martha/marhta:", جارو_وينكلر("martha", "marhta")
اطبع "dwayne/duane:", جارو_وينكلر("dwayne", "duane")

تأكد_يساوي(مقرب(جارو_وينكلر("martha", "marhta"), 6), 0.961111, "مارثا")
تأكد_يساوي(مقرب(جارو_وينكلر("dwayne", "duane"), 6), 0.84, "دواين")
تأكد_يساوي(جارو_وينكلر("abc", "abc"), 1, "تطابق تام")

# نافذة المطابقة: نصف طول الأطول ناقص واحد
# ملاحظة: صيغة (ن1+ن2)//4 تقارب max//2-1 للسلاسل المتقاربة
تأكد_يساوي(مقرب(جارو("abcd", "wxyz"), 6), 0, "لا مطابقات")
