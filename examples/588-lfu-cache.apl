# مثال 588 — ذاكرة LFU
# LFU cache
# Demonstrates: LFU، ترددات، طرد
#
# Run:  python apl.py examples/588-lfu-cache.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ذاكرة مؤقتة LFU: طرد الأقل استخداما
# Demonstrates: عد الترددات, سياسة طرد, مقارنة مع LRU
# الأقل استخداما يطرد أولا، والأقدم بين المتساوين

دالة أنشئ(سعة):
  ارجع {"سعة": سعة, "قيم": {}, "تردد": {}, "ترتيب": []}

دالة المس(مخ, مفتاح):
  مخ["تردد"][مفتاح] = مخ["تردد"][مفتاح] + 1
  مخ["ترتيب"].remove(مفتاح)
  مخ["ترتيب"].append(مفتاح)

دالة ضع(مخ, مفتاح, قيمة):
  لو مفتاح في مخ["قيم"]:
    مخ["قيم"][مفتاح] = قيمة
    المس(مخ, مفتاح)
  والا:
    لو طول(مخ["قيم"]) >= مخ["سعة"]:
      أدنى_تردد = أصغر(مخ["تردد"].values())
      مطروح = -1
      لكل م في مخ["ترتيب"]:
        لو مطروح == -1 و مخ["تردد"][م] == أدنى_تردد:
          مطروح = م
      محو_عنصر = مخ["قيم"].pop(مطروح)
      محو_تردد = مخ["تردد"].pop(مطروح)
      مخ["ترتيب"].remove(مطروح)
    مخ["قيم"][مفتاح] = قيمة
    مخ["تردد"][مفتاح] = 1
    مخ["ترتيب"].append(مفتاح)

دالة خذ(مخ, مفتاح):
  لو مفتاح في مخ["قيم"]:
    المس(مخ, مفتاح)
    ارجع مخ["قيم"][مفتاح]
  ارجع -1

مخ = أنشئ(2)
ضع(مخ, "أ", 1)
ضع(مخ, "ب", 2)
تأكد_يساوي(خذ(مخ, "أ"), 1, "قراءة ترفع التردد")
ضع(مخ, "ج", 3)
تأكد_يساوي(خذ(مخ, "ب"), -1, "ب مطروح (الأقل استخداما)")
تأكد_يساوي(خذ(مخ, "أ"), 1, "أ بقي لتردده الأعلى")
ضع(مخ, "د", 4)
تأكد_يساوي(خذ(مخ, "ج"), -1, "ج طرد عند إضافة د (تردد 1)")
تأكد_يساوي(خذ(مخ, "أ"), 1, "أ بقي لتردده الأعلى")
تأكد_يساوي(خذ(مخ, "د"), 4, "د موجود")
