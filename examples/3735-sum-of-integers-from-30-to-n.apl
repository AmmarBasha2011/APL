# مثال 3735 — مجموع الأعداد من 30 إلى ن
# Sum from 30 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3735-sum-of-integers-from-30-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(30, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(30), 30, "حالة 1")
تأكد_يساوي(ف(31), 61, "حالة 2")
تأكد_يساوي(ف(40), 385, "حالة 3")
تأكد_يساوي(ف(100), 4615, "حالة 4")
