# مثال 1088 — استخدام الأحرف الكبيرة
# Detect capital use
# Demonstrates: عد الأحرف الكبيرة
#
# Run:  python apl.py examples/1088-detect-capital.apl

# صحيحة لو كانت كلها كبيرة أو كلها صغيرة أو الأول فقط كبير
# نعد الأحرف الكبيرة ونفحص الحالات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كبير(ح):
  ارجع (ح >= "A") و (ح <= "Z")

دالة استخدام_صحيح(كلمة):
  عدد_ = 0
  لكل ح في كلمة:
    لو كبير(ح):
      عدد_ = عدد_ + 1
  لو (عدد_ == 0) أو (عدد_ == طول(كلمة)):
    ارجع صواب
  ارجع (عدد_ == 1) و كبير(كلمة[0])

تأكد_يساوي(استخدام_صحيح("USA"), صواب, "كلها كبيرة")
تأكد_يساوي(استخدام_صحيح("FlaG"), خطأ, "كبير في النهاية")
تأكد_يساوي(استخدام_صحيح("leetcode"), صواب, "كلها صغيرة")
تأكد_يساوي(استخدام_صحيح("Google"), صواب, "الأول فقط")
تأكد_يساوي(استخدام_صحيح("gOogle"), خطأ, "كبير في الوسط")
