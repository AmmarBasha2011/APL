# مثال 327 — فريد مع الحفاظ على الترتيب
# Unique preserving order
# Demonstrates: قاموس ظهور
#
# Run:  python apl.py examples/327-unique-preserve.apl

دالة فريد(قائمة):
    المتغير مرئية = {}
    المتغير نتيجة = []
    لكل عنصر في قائمة:
        لو عنصر ليس في مرئية:
            مرئية[عنصر] = صواب
            نتيجة.أضف(عنصر)
    ارجع نتيجة

اطبع فريد([3, 1, 3, 2, 1, 4, 2])
اطبع فريد(["ب", "أ", "ب", "ج", "أ"])
