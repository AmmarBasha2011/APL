# مثال 1485 — فرز المشط
# Comb sort
# Demonstrates: فرز
#
# Run:  python apl.py examples/1485-comb-sort-gap.apl

# نقارن عناصر تفصل بينها فجوة
# نقسم الفجوة على 1.3 حتى تصبح واحداً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فرز_المشط(أ):
  فجوة = طول(أ)
  مبدل = صواب
  طالما فجوة > 1 أو مبدل:
    فجوة = صحيح(فجوة / 1.3)
    لو فجوة < 1:
      فجوة = 1
    مبدل = خطأ
    لكل ع في نطاق(طول(أ) - فجوة):
      لو أ[ع] > أ[ع + فجوة]:
        ت = أ[ع]
        أ[ع] = أ[ع + فجوة]
        أ[ع + فجوة] = ت
        مبدل = صواب
  ارجع أ

تأكد_يساوي(فرز_المشط([8, 4, 1, 56, 3, -44, 23]), [-44, 1, 3, 4, 8, 23, 56], "سبعة")
تأكد_يساوي(فرز_المشط([2, 1]), [1, 2], "اثنان")
تأكد_يساوي(فرز_المشط([1]), [1], "واحد")
