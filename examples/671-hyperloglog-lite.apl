# مثال 671 — عد تقريبي بهايبرلوجلوج
# HyperLogLog-lite
# Demonstrates: تقدير عدد مميز، سجلات، تصحيح
#
# Run:  python apl.py examples/671-hyperloglog-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# HyperLogLog مبسط: تقدير العدد المميز
# Demonstrates: سجلات أصفار بادئة, متوسط توافقي, تجزئة ضربية
# يقدر ملايين العناصر المميزة بذاكرة صغيرة ثابتة

دالة تجزئة(عنصر):
  ح = (عنصر * 2654435761) % 4294967296
  ح = ح ^ (ح // 65536)
  ح = (ح * 2246822519) % 4294967296
  ح = ح ^ (ح // 32768)
  ارجع ح % 4294967296

دالة أصفار_بادئة(باقي, بتات):
  بت = 1
  لكل ي في نطاق(بتات - 1):
    بت = بت * 2
  عدد = 0
  طالما بت > 0 و (باقي & بت) == 0:
    عدد = عدد + 1
    بت = بت // 2
  ارجع عدد

دالة قدر(عناصر):
  سجلات = [0] * 64
  لكل عنصر في عناصر:
    ح = تجزئة(عنصر)
    رقم = ح % 64
    باقي = ح // 64
    ر = أصفار_بادئة(باقي, 26) + 1
    لو ر > سجلات[رقم]:
      سجلات[رقم] = ر
  مقام = 0.0
  لكل سجل في سجلات:
    ق = 1.0
    لكل ي في نطاق(سجل):
      ق = ق / 2.0
    مقام = مقام + ق
  خام = 0.7213 / (1.0 + 1.079 / 64.0) * 64.0 * 64.0 / مقام
  لو خام <= 160.0:
    صفار = 0
    لكل سجل في سجلات:
      لو سجل == 0:
        صفار = صفار + 1
    لو صفار > 0:
      ارجع 64.0 * لوغاريتم(64.0 / صفار)
  ارجع خام

عناصر = []
لكل ي في نطاق(1, 2001):
  عناصر.append(ي * 7919 + 13)
تقدير = قدر(عناصر)
اطبع "التقدير:", تقدير
تأكد_يساوي(تقدير > 1600.0 و تقدير < 2500.0, صواب, "التقدير قرب 2000")
تقدير_واحد = قدر([7])
تأكد_يساوي(تقدير_واحد > 0.0, صواب, "عنصر واحد يقدر بموجب")
تأكد_يساوي(تقدير_واحد < 5.0, صواب, "عنصر واحد يقدر بصغير")
