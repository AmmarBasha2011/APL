# مثال 451 — مولد نص عشوائي عربي
# Arabic lorem ipsum
# Demonstrates: جمع كلمات عشوائية في جمل
#
# Run:  python apl.py examples/451-arabic-lorem.apl

بذرة(5)
المتغير كلمات = ["العلم", "نور", "الكتاب", "خير", "جليس", "العمل", "نجاح", "الوقت", "ذهب", "الصبر", "مفتاح"]

دالة جملة(عدد_كلمات):
    المتغير أجزاء = []
    لكل _ في نطاق(عدد_كلمات):
        أجزاء.append(كلمات[عشوائي_عدد(0, طول(كلمات) - 1)])
    ارجع " ".ضم(أجزاء) + "."

لكل _ في نطاق(3):
    اطبع جملة(5)
