# مثال 2904 — قيصر بإزاحة 19
# Caesar shift 19
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2904-caesar-shift-by-19-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 19) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "tuv", "حالة 1")
تأكد_يساوي(ف("xyz"), "qrs", "حالة 2")
تأكد_يساوي(ف("hello world"), "axeeh phkew", "حالة 3")
تأكد_يساوي(ف("a1"), "t1", "حالة 4")
