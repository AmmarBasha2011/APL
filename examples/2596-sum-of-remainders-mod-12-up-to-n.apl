# مثال 2596 — مجموع البواقي على 12
# Sum of remainders mod 12
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2596-sum-of-remainders-mod-12-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن + 1):
    م = م + ي % 12
  ارجع م

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(7), 28, "حالة 2")
تأكد_يساوي(ف(12), 66, "حالة 3")
تأكد_يساوي(ف(50), 267, "حالة 4")
تأكد_يساوي(ف(100), 538, "حالة 5")
