# مثال 291 — عد تكرارات نموذج في نص
# Pattern occurrence count
# Demonstrates: بحث ساذج بكل المواضع
#
# Run:  python apl.py examples/291-string-search-count.apl

دالة عد_التكرارات(نص_الدخل, نموذج):
    المتغير عدد = 0
    المتغير ن = طول(نص_الدخل)
    المتغير م = طول(نموذج)
    لكل ي في نطاق(ن - م + 1):
        لو نص_الدخل[ي:ي + م] == نموذج:
            عدد = عدد + 1
    ارجع عدد

اطبع عد_التكرارات("ababcabc", "abc")
اطبع عد_التكرارات("aaaa", "aa")
اطبع عد_التكرارات("hello world", "xyz")
