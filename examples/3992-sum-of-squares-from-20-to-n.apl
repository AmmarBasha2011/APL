# مثال 3992 — مجموع المربعات من 20 إلى ن
# Sum of squares from 20
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3992-sum-of-squares-from-20-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(20, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(20), 400, "حالة 1")
تأكد_يساوي(ف(21), 841, "حالة 2")
تأكد_يساوي(ف(30), 6985, "حالة 3")
تأكد_يساوي(ف(100), 335880, "حالة 4")
