# مثال 749 — تشفير السياج
# Rail fence cipher
# Demonstrates: مسار متعرج، قضبان، اتجاه متقلب
#
# Run:  python apl.py examples/749-rail-fence.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تشفير السياج (Rail Fence): نص على قضبان متعرجة
# Demonstrates: مسار متعرج, قضبان نصية, اتجاه يتقلب
# الحروف تُوزع صعوداً ونزولاً بين القضبان ثم تُقرأ قضيباً قضيباً

دالة شفر_سياج(نص, قضبان):
  لو قضبان <= 1:
    ارجع نص
  صفوف = []
  لكل ي في نطاق(قضبان):
    صفوف.append("")
  صف = 0
  اتجاه = 1
  لكل ي في نطاق(طول(نص)):
    صفوف[صف] = صفوف[صف] + نص[ي]
    لو صف == 0:
      اتجاه = 1
    والا_لو صف == قضبان - 1:
      اتجاه = -1
    صف = صف + اتجاه
  ناتج = ""
  لكل سطر في صفوف:
    ناتج = ناتج + سطر
  ارجع ناتج

تأكد_يساوي(شفر_سياج("WEAREDISCOVEREDFLEEATONCE", 3), "WECRLTEERDSOEEFEAOCAIVDEN", "المتجه الكلاسيكي")
تأكد_يساوي(شفر_سياج("HELLOWORLD", 2), "HLOOLELWRD", "قضيبان")
تأكد_يساوي(شفر_سياج("ABCDE", 1), "ABCDE", "قضيب واحد لا يغير")
تأكد_يساوي(طول(شفر_سياج("ABCDEFGHIJKLM", 4)), 13, "الطول محفوظ")
تأكد_يساوي(شفر_سياج("", 3), "", "نص فارغ")

اطبع "السياج:", شفر_سياج("WEAREDISCOVEREDFLEEATONCE", 3)
