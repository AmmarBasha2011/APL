# مثال 4 — تحليل نص ومطابقة الأنماط
# Text Analyzer
# Demonstrates: re library, string methods, statistics, list counting
#
# Run:  python apl.py examples/04-text-analyzer.apl

المتغير النص = "اللغة العربية لغة غنية. APL لغة برمجة عربية experimental تطويرها مستمر"

اطبع "=== محلل النصوص ==="
اطبع "النص: " + النص
اطبع ""

# إحصاءات أساسية
اطبع "--- إحصاءات ---"
اطبع "طول النص: " + نص(طول(النص))
اطبع "عدد الكلمات: " + نص(طول(تقسيم(النص, " ")))
اطبع "عدد الحروف: " + نص(طول(إزالة_التفافات(النص)))

# التقسيم إلى كلمات
اطبع ""
اطبع "--- الكلمات ---"
لكل كلمة في تقسيم(النص, " "):
    إذا طول(كلمة) > 0:
        اطبع "  - " + كلمة

# البحث عن نمط
اطبع ""
اطبع "--- بحث ---"
اطبع "هل يوجد 'لغة'؟ " + نص(بحث_نمطي("لغة", النص) != لا_شيء)
اطبع "عدد الأحرف العربية: " + نص(طول(بحث_شامل("[أ-ي]", النص)))
