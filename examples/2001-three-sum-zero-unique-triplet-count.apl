# مثال 2001 — عدد الثلاثيات الفريدة مجموعها صفر
# Unique zero-sum triplets
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/2001-three-sum-zero-unique-triplet-count.apl

# # نتخطى القيم المكررة لتفادي التكرار
# # ونعد الثلاثيات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ثلاثيات(ق):
  ق = sorted(ق)
  عدد = 0
  لكل ك في نطاق(طول(ق)):
    لو ك == 0 أو ق[ك] != ق[ك - 1]:
      ي = ك + 1
      ل = طول(ق) - 1
      طالما ي < ل:
        م = ق[ك] + ق[ي] + ق[ل]
        لو م == 0:
          عدد = عدد + 1
          ي = ي + 1
          ل = ل - 1
          طالما ي < ل و ق[ي] == ق[ي - 1]:
            ي = ي + 1
          طالما ي < ل و ق[ل] == ق[ل + 1]:
            ل = ل - 1
        والا_لو م < 0:
          ي = ي + 1
        والا:
          ل = ل - 1
  ارجع عدد

تأكد_يساوي(ثلاثيات([-1, 0, 1, 2, -1, -4]), 2, "ثنتان")
تأكد_يساوي(ثلاثيات([0, 0, 0, 0]), 1, "أصفار")
تأكد_يساوي(ثلاثيات([1, 2]), 0, "قصيرة")
