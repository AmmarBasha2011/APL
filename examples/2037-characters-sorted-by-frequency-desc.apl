# مثال 2037 — ترتيب الحروف حسب التكرار
# Sort characters by frequency
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2037-characters-sorted-by-frequency-desc.apl

# # نعد الحروف ونرتب بزوج السالب والحرف
# # ثم نكرر كل حرف بعدده

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رتب(س):
  عد = {}
  لكل ح في س:
    عد[ح] = عد.get(ح, 0) + 1
  ازواج = []
  لكل ح في عد:
    ازواج = ازواج + [[-عد[ح], ح]]
  ازواج = sorted(ازواج)
  خرج = ""
  لكل ز في ازواج:
    خرج = خرج + ز[1] * (-ز[0])
  ارجع خرج

تأكد_يساوي(رتب("tree"), "eert", "tree")
تأكد_يساوي(رتب("cccaaa"), "aaaccc", "تعادل")
تأكد_يساوي(رتب(""), "", "فارغ")
