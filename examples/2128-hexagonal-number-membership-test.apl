# مثال 2128 — هل العدد سداسي
# Hexagonal number test
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/2128-hexagonal-number-membership-test.apl

# # نزيد n حتى نبلغ العدد
# # كل عدد سداسي مثلثي أيضا

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة سداسي(ن):
  ك = 1
  طالما ك * (2 * ك - 1) < ن:
    ك = ك + 1
  ارجع ك * (2 * ك - 1) == ن

تأكد_يساوي(سداسي(6), صواب, "٦")
تأكد_يساوي(سداسي(15), صواب, "١٥")
تأكد_يساوي(سداسي(28), صواب, "٢٨")
تأكد_يساوي(سداسي(10), خطأ, "١٠")
تأكد_يساوي(سداسي(1), صواب, "١")
