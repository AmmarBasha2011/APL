# مثال 556 — جذر نيوتن-رافسون
# Newton-Raphson square root
# Demonstrates: نيوتن، جذر تربيعي، تقارب
#
# Run:  python apl.py examples/556-newton-sqrt.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# الجذر التربيعي بطريقة نيوتن-رافسون
دالة جذر_نيوتن(س, تكرارات):
    لو س == 0:
        ارجع 0
    المتغير تخمين = س / 2
    لكل i في نطاق(تكرارات):
        تخمين = (تخمين + س / تخمين) / 2
    ارجع تخمين

المتغير ن2 = جذر_نيوتن(2, 12)
اطبع "جذر 2:", ن2
تأكد_يساوي(مقرب(ن2, 10), مقرب(1.4142135623730951, 10), "جذر 2 بدقة")
تأكد_يساوي(مقرب(جذر_نيوتن(144, 12), 6), 12, "جذر 144")
تأكد_يساوي(جذر_نيوتن(0, 5), 0, "جذر صفر")
