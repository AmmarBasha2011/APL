# مثال 1632 — أقل عدد غرف اجتماعات
# Minimum meeting rooms
# Demonstrates: جشع
#
# Run:  python apl.py examples/1632-minimum-meeting-rooms.apl

# نفرز البدايات والنهايات منفصلة
# نتتبع عدد الاجتماعات الجارية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أقل_غرف(اجتماعات):
  بدايات = []
  نهايات = []
  لكل ا في اجتماعات:
    بدايات.append(ا[0])
    نهايات.append(ا[1])
  بدايات.sort()
  نهايات.sort()
  جارية = 0
  أقصى = 0
  ج = 0
  لكل ب في بدايات:
    طالما نهايات[ج] <= ب:
      جارية = جارية - 1
      ج = ج + 1
    جارية = جارية + 1
    لو جارية > أقصى:
      أقصى = جارية
  ارجع أقصى

تأكد_يساوي(أقل_غرف([[0, 30], [5, 10], [15, 20]]), 2, "غرفتان")
تأكد_يساوي(أقل_غرف([[7, 10], [2, 4]]), 1, "غرفة واحدة")
تأكد_يساوي(أقل_غرف([[1, 5], [2, 6], [3, 7]]), 3, "ثلاث")
