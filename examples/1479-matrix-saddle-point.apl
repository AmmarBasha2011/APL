# مثال 1479 — نقطة السرج
# Matrix saddle point
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1479-matrix-saddle-point.apl

# نأخذ أصغر عنصر في كل صف
# ثم نتأكد أنه أكبر ما في عموده

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نقطة_السرج(م):
  لكل ص في نطاق(طول(م)):
    صغرى = م[ص][0]
    عمود = 0
    لكل ع في نطاق(طول(م[ص])):
      لو م[ص][ع] < صغرى:
        صغرى = م[ص][ع]
        عمود = ع
    أكبر_في_العمود = صواب
    لكل ق في نطاق(طول(م)):
      لو م[ق][عمود] > صغرى:
        أكبر_في_العمود = خطأ
    لو أكبر_في_العمود:
      ارجع صغرى
  ارجع -1

تأكد_يساوي(نقطة_السرج([[3, 1], [1, 3]]), -1, "لا يوجد")
تأكد_يساوي(نقطة_السرج([[1, 2], [3, 4]]), 3, "يوجد")
تأكد_يساوي(نقطة_السرج([[9]]), 9, "وحيدة")
