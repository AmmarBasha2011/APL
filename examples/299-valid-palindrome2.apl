# مثال 299 — متناظر بحذف حرف واحد
# Valid palindrome II
# Demonstrates: مؤشران مع فرصة حذف
#
# Run:  python apl.py examples/299-valid-palindrome2.apl

دالة متناظر(نص_الدخل, أيسر, أيمن):
    طالما أيسر < أيمن:
        لو نص_الدخل[أيسر] != نص_الدخل[أيمن]:
            ارجع خطأ
        أيسر = أيسر + 1
        أيمن = أيمن - 1
    ارجع صواب

دالة متناظر_بحذف(نص_الدخل):
    المتغير أيسر = 0
    المتغير أيمن = طول(نص_الدخل) - 1
    طالما أيسر < أيمن:
        لو نص_الدخل[أيسر] != نص_الدخل[أيمن]:
            ارجع متناظر(نص_الدخل, أيسر + 1, أيمن) أو متناظر(نص_الدخل, أيسر, أيمن - 1)
        أيسر = أيسر + 1
        أيمن = أيمن - 1
    ارجع صواب

اطبع متناظر_بحذف("aba")
اطبع متناظر_بحذف("abca")
اطبع متناظر_بحذف("abc")
