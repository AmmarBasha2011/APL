# مثال 2108 — هل العدد قوة كاملة
# Perfect power test v2
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/2108-perfect-power-base-exponent-test.apl

# # الأساس يبدأ من 2
# # 1 قوة كاملة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة_كاملة(ن):
  لو ن == 1:
    ارجع صواب
  ب = 2
  طالما ب * ب <= ن:
    ق = ب * ب
    طالما ق < ن:
      ق = ق * ب
    لو ق == ن:
      ارجع صواب
    ب = ب + 1
  ارجع خطأ

تأكد_يساوي(قوة_كاملة(8), صواب, "٨")
تأكد_يساوي(قوة_كاملة(9), صواب, "٩")
تأكد_يساوي(قوة_كاملة(10), خطأ, "١٠")
تأكد_يساوي(قوة_كاملة(81), صواب, "٨١")
تأكد_يساوي(قوة_كاملة(72), خطأ, "٧٢")
