# مثال 3256 — مجموع زوايا مضلع زائد 10
# Polygon angle sum plus 10
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3256-interior-angle-sum-of-polygon-plus-10.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 10

تأكد_يساوي(ف(3), 190, "حالة 1")
تأكد_يساوي(ف(4), 370, "حالة 2")
تأكد_يساوي(ف(5), 550, "حالة 3")
تأكد_يساوي(ف(6), 730, "حالة 4")
تأكد_يساوي(ف(12), 1810, "حالة 5")
