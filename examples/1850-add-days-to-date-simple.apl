# مثال 1850 — إضافة أيام إلى تاريخ
# Add days to a date
# Demonstrates: وقت
#
# Run:  python apl.py examples/1850-add-days-to-date-simple.apl

# نزيد اليوم وننتقل للشهر التالي عند تجاوز طوله
# نعالج نهاية السنة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كبيسة(س):
  لو س % 400 == 0:
    ارجع صواب
  لو س % 100 == 0:
    ارجع خطأ
  ارجع س % 4 == 0

دالة أيام_الشهر(س, ش):
  أطوال = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  لو ش == 2 و كبيسة(س):
    ارجع 29
  ارجع أطوال[ش - 1]

دالة أضف_أياماً(س, ش, ي, ن):
  لكل ك في نطاق(ن):
    ي = ي + 1
    لو ي > أيام_الشهر(س, ش):
      ي = 1
      ش = ش + 1
      لو ش > 12:
        ش = 1
        س = س + 1
  ارجع [س, ش, ي]

تأكد_يساوي(أضف_أياماً(2023, 12, 30, 5), [2024, 1, 4], "نهاية السنة")
تأكد_يساوي(أضف_أياماً(2024, 2, 28, 2), [2024, 3, 1], "كبيسة")
تأكد_يساوي(أضف_أياماً(2023, 1, 1, 0), [2023, 1, 1], "صفر")
