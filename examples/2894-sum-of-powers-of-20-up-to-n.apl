# مثال 2894 — مجموع قوى 20
# Sum of powers of 20
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2894-sum-of-powers-of-20-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 20 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 21, "حالة 2")
تأكد_يساوي(ف(3), 8421, "حالة 3")
تأكد_يساوي(ف(6), 67368421, "حالة 4")
تأكد_يساوي(ف(10), 10778947368421, "حالة 5")
