# مثال 904 — معامل جيني
# Gini coefficient
# Demonstrates: مجاميع الفروق المطلقة
#
# Run:  python apl.py examples/904-gini-coefficient.apl

# معامل جيني: قياس عدم المساواة في التوزيع
# G = مجموع |سi - سj| / (2 * ن * مجموع س)

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جيني(قيم):
  ن = طول(قيم)
  مجموع_فروق = 0
  لكل i في نطاق(ن):
    لكل ج في نطاق(ن):
      فرق = قيم[i] - قيم[ج]
      لو فرق < 0:
        فرق = -فرق
      مجموع_فروق = مجموع_فروق + فرق
  مجموع = 0
  لكل x في قيم:
    مجموع = مجموع + x
  ارجع مجموع_فروق / (2 * ن * مجموع)

ز1 = جيني([1, 2, 3, 4, 5])
اطبع "جيني(1..5) =", ز1

تأكد_يساوي(مقرب(ز1, 4), 0.2667, "جيني 1..5")

# المساواة التامة تعطي صفراً
تأكد_يساوي(جيني([7, 7, 7, 7]), 0, "مساواة تامة")

# اللامساواة القصوى تقارب 1 - 1/ن
ز3 = جيني([0, 0, 0, 0, 100])
اطبع "جيني(شبه قصوى) =", ز3
تأكد_يساوي(مقرب(ز3, 4), 0.8, "1 - 1/5")
