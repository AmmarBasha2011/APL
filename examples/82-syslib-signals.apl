# 82 · الإشارات والموارد — signal وresource وerrno
# Signals, limits and errno tables
#
# Run:  python apl.py examples/82-syslib-signals.apl

اطبع "=== الإشارات والموارد ==="
المتغير م = احصل_على_معالج_الإشارة(إشارة_المقاطعة)
اطبع "للمقاطعة معالج مخصص؟", م != لا_شيء
اطبع "رمز EACCES:", رموز_الأخطاء[الوصول_مرفوض]
اطبع "رمز ENOENT:", رموز_الأخطاء[لا_ملف]
المتغير ح = احصل_على_حد_المورد(حد_المورد_عدد_الملفات)
اطبع "حد الملفات الناعم:", ح[0]
اطبع "حد الملفات الأقصى:", ح[1]
