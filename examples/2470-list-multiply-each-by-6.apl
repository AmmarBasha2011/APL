# مثال 2470 — ضرب كل عنصر في 6
# Multiply each item by 6
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2470-list-multiply-each-by-6.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 6]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [18, 6, 12], "حالة 1")
تأكد_يساوي(ف([5]), [30], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [6, 12, 18, 24, 30, 36], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-12, 0, 42, 42, 24], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [60, 120, 60, 180, 120, 60], "حالة 5")
