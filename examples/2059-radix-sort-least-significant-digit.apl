# مثال 2059 — الفرز الجذري بالخانة الأقل أهمية
# Radix sort LSD
# Demonstrates: فرز
#
# Run:  python apl.py examples/2059-radix-sort-least-significant-digit.apl

# # نبدأ من خانة الآحاد
# # كل جولة مستقرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جذري(ق):
  لو طول(ق) == 0:
    ارجع []
  اقصى = أكبر(ق)
  خانة = 1
  طالما اقصى // خانة > 0:
    سلال = []
    لكل ك في نطاق(10):
      سلال = سلال + [[]]
    لكل ع في ق:
      سلال[(ع // خانة) % 10].append(ع)
    ق = []
    لكل س في سلال:
      ق = ق + س
    خانة = خانة * 10
  ارجع ق

تأكد_يساوي(جذري([170, 45, 75, 90, 802, 24, 2, 66]), [2, 24, 45, 66, 75, 90, 170, 802], "كلاسيكي")
تأكد_يساوي(جذري([]), [], "فارغة")
تأكد_يساوي(جذري([5]), [5], "واحد")
