# مثال 2666 — العنصر في الموضع 1 أو -1
# Element at index 1 or default
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2666-list-element-at-index-1-or-default.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لو طول(ق) > 1:
    ارجع ق[1]
  ارجع -1

تأكد_يساوي(ف([3, 1, 2]), 1, "حالة 1")
تأكد_يساوي(ف([5]), -1, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 2, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 0, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 20, "حالة 5")
