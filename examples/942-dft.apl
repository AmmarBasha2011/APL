# مثال 942 — تحويل فورييه المنفصل
# Discrete Fourier transform
# Demonstrates: جيب وجيب تمام
#
# Run:  python apl.py examples/942-dft.apl

# التحويل المنفصل لفورييه: إشارة زمنية إلى طيف ترددي
# صيغة مباشرة O(n^2) بدوال مثلثية بدل الأعداد العقدية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

طاي = 3.14159265358979

# سعة المركبة ك: جذر(حقيقي^2 + تخيلي^2)
دالة سعة(إشارة, ك):
  ن = طول(إشارة)
  حقيقي = 0
  تخيلي = 0
  لكل ت في نطاق(ن):
    زاوية = 2 * طاي * ك * ت / ن
    حقيقي = حقيقي + إشارة[ت] * جتا(زاوية)
    تخيلي = تخيلي - إشارة[ت] * جب(زاوية)
  ارجع جذر(حقيقي * حقيقي + تخيلي * تخيلي)

# نبضة وحدوية: طيف مستوٍ
إشارة1 = [1, 0, 0, 0]
اطبع "طيف النبضة:", سعة(إشارة1, 0), سعة(إشارة1, 1)
تأكد_يساوي(مقرب(سعة(إشارة1, 0), 6), 1, "مركبة صفر")
تأكد_يساوي(مقرب(سعة(إشارة1, 1), 6), 1, "مركبة واحد")
تأكد_يساوي(مقرب(سعة(إشارة1, 2), 6), 1, "مركبة اثنان")
تأكد_يساوي(مقرب(سعة(إشارة1, 3), 6), 1, "مركبة ثلاثة")

# جيب نقي بدورة واحدة: طاقة عند ك=1 وك=3 فقط
إشارة2 = [0, 1, 0, -1]
تأكد_يساوي(مقرب(سعة(إشارة2, 0), 6), 0, "لا مركبة مستمرة")
تأكد_يساوي(مقرب(سعة(إشارة2, 1), 6), 2, "الأساسية")
تأكد_يساوي(مقرب(سعة(إشارة2, 2), 6), 0, "لا توافقية ثانية")
تأكد_يساوي(مقرب(سعة(إشارة2, 3), 6), 2, "الصورة المرآتية")
