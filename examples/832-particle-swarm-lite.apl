# مثال 832 — سرب الجسيمات
# Particle swarm
# Demonstrates: قصور ومعرفة واجتماع
#
# Run:  python apl.py examples/832-particle-swarm-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# سرب جسيمات PSO: سرعة بقصور وذاكرة فردية وجماعية
# Demonstrates: مكونات قصور ومعرفي واجتماعي, أفضل شخصي وعام, LCG حتمي

دالة هدف(س):
  ارجع (س - 2) * (س - 2)

دالة سرب(دورات):
  بذرة = 999
  مواقع = [0 - 5.0, 7.0]
  سرعات = []
  لكل ي في نطاق(2):
    بذرة = (بذرة * 1103515245 + 12345) % 2147483648
    سرعات.append(بذرة / 2147483648.0 * 2 - 1)
  شخصي = [مواقع[0], مواقع[1]]
  قيم_شخصي = [هدف(مواقع[0]), هدف(مواقع[1])]
  أفضل_عام = مواقع[0]
  قيمة_عام = قيم_شخصي[0]
  لو قيم_شخصي[1] < قيمة_عام:
    أفضل_عام = مواقع[1]
    قيمة_عام = قيم_شخصي[1]
  لكل دورة في نطاق(دورات):
    لكل ي في نطاق(2):
      بذرة = (بذرة * 1103515245 + 12345) % 2147483648
      عشوائي1 = بذرة / 2147483648.0
      بذرة = (بذرة * 1103515245 + 12345) % 2147483648
      عشوائي2 = بذرة / 2147483648.0
      سرعات[ي] = 0.7 * سرعات[ي] + 1.4 * عشوائي1 * (شخصي[ي] - مواقع[ي]) + 1.4 * عشوائي2 * (أفضل_عام - مواقع[ي])
      مواقع[ي] = مواقع[ي] + سرعات[ي]
      قيمة = هدف(مواقع[ي])
      لو قيمة < قيم_شخصي[ي]:
        شخصي[ي] = مواقع[ي]
        قيم_شخصي[ي] = قيمة
      لو قيمة < قيمة_عام:
        أفضل_عام = مواقع[ي]
        قيمة_عام = قيمة
  ارجع [أفضل_عام, قيمة_عام]

نتيجة = سرب(30)
تأكد_يساوي(مقرب(نتيجة[0], 4), 2.0021, "موقع الأمثل")
تأكد_يساوي(مقرب(نتيجة[1], 6), 0.000004, "قيمة الأمثل")
نتيجة2 = سرب(5)
تأكد_يساوي(نتيجة2[1] < 4.0 == خطأ, خطأ, "خمس دورات تقرب")
