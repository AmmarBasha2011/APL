# مثال 3588 — صف جدول ضرب 20
# Multiplication row of 20
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3588-multiplication-table-row-of-20.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 20]
  ارجع ر

تأكد_يساوي(ف(1), [20], "حالة 1")
تأكد_يساوي(ف(5), [20, 40, 60, 80, 100], "حالة 2")
تأكد_يساوي(ف(10), [20, 40, 60, 80, 100, 120, 140, 160, 180, 200], "حالة 3")
