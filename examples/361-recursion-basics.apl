# مثال 361 — أساسيات العودية
# Recursion basics
# Demonstrates: عد تنازلي ومجموع وطباعة
#
# Run:  python apl.py examples/361-recursion-basics.apl

دالة عد_تنازلي(ن):
    لو ن == 0:
        اطبع "انتهى"
        ارجع
    اطبع ن
    عد_تنازلي(ن - 1)

عد_تنازلي(3)

دالة مجموع_حتى(ن):
    لو ن == 0:
        ارجع 0
    ارجع ن + مجموع_حتى(ن - 1)

اطبع "المجموع حتى 10:", مجموع_حتى(10)
