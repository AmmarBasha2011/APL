# مثال 1343 — أقل زيارات وقود
# Minimum refueling stops
# Demonstrates: جشع
#
# Run:  python apl.py examples/1343-min-refueling-stops.apl

# نسير بأبعد ما نستطيع
# وعند نفاد الوقود نأخذ أكبر خزان مررنا به

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_محطات(هدف, وقود, محطات):
  خزانات = []
  ع = 0
  زيارات = 0
  مدى = وقود
  طالما مدى < هدف:
    طالما (ع < طول(محطات)) و (محطات[ع][0] <= مدى):
      خزانات.ألحق(محطات[ع][1])
      ع = ع + 1
    لو طول(خزانات) == 0:
      ارجع -1
    خزانات = مفرز(خزانات)
    مدى = مدى + خزانات.pop()
    زيارات = زيارات + 1
  ارجع زيارات

تأكد_يساوي(اقل_محطات(1, 1, []), 0, "لا حاجة")
تأكد_يساوي(اقل_محطات(100, 1, [[10,100]]), -1, "لا يصل")
تأكد_يساوي(اقل_محطات(100, 10, [[10,60],[20,30],[30,30],[60,40]]), 2, "توقفان")
