# مثال 146 — تحويل JSON إلى CSV
# Converting JSON records to CSV
# Demonstrates: جسون، ضم، حلقات
#
# Run:  python apl.py examples/146-json-to-csv.apl

المتغير نص_جسون = '[{"الاسم": "عمار", "النقاط": 90}, {"الاسم": "سارة", "النقاط": 85}]'
المتغير سجلات = جسون(نص_جسون)

المتغير سطور = ["الاسم,النقاط"]
لكل س in سجلات:
    سطور.أضف(س["الاسم"] + "," + نص(س["النقاط"]))

المتغير csv = "\n".ضم(سطور)
اطبع csv
اطبع ""
اطبع "عدد السجلات:", طول(سجلات)
