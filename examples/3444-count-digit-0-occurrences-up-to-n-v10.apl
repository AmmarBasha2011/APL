# مثال 3444 — عدد ظهور الرقم 0 حتى ن
# Occurrences of digit 0 up to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3444-count-digit-0-occurrences-up-to-n-v10.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(1, ن + 1):
    ع = ع + نص(ي).count("0")
  ارجع ع

تأكد_يساوي(ف(9), 0, "حالة 1")
تأكد_يساوي(ف(10), 1, "حالة 2")
تأكد_يساوي(ف(50), 5, "حالة 3")
تأكد_يساوي(ف(100), 11, "حالة 4")
تأكد_يساوي(ف(200), 31, "حالة 5")
