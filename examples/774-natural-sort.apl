# مثال 774 — الفرز الطبيعي
# Natural sort
# Demonstrates: مقاطع رقمية، مقارنة كأعداد
#
# Run:  python apl.py examples/774-natural-sort.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الفرز الطبيعي: img2 قبل img10
# Demonstrates: تقسيم النص إلى مقاطع رقمية ونصية, مقارنة المقاطع الرقمية كأعداد

دالة كلها_ارقام(س):
  نتيجة = صواب
  لكل حرف في س:
    لو حرف < "0" أو حرف > "9":
      نتيجة = خطأ
  ارجع نتيجة

دالة مفاتيح_طبيعية(نص):
  أجزاء = []
  حالي = ""
  رقمي = خطأ
  لكل حرف في نص:
    لو حرف >= "0" و حرف <= "9":
      هو_رقم = صواب
    والا:
      هو_رقم = خطأ
    لو طول(حالي) > 0 و هو_رقم != رقمي:
      أجزاء.append(حالي)
      حالي = ""
    حالي = حالي + حرف
    رقمي = هو_رقم
  لو طول(حالي) > 0:
    أجزاء.append(حالي)
  ارجع أجزاء

دالة اصغر_طبيعي(أ, ب):
  كأ = مفاتيح_طبيعية(أ)
  كب = مفاتيح_طبيعية(ب)
  ن = طول(كأ)
  لو طول(كب) < ن:
    ن = طول(كب)
  لكل ي في نطاق(ن):
    جزءأ = كأ[ي]
    جزءب = كب[ي]
    لو كلها_ارقام(جزءأ) و كلها_ارقام(جزءب):
      لو صحيح(جزءأ) < صحيح(جزءب):
        ارجع صواب
      لو صحيح(جزءأ) > صحيح(جزءب):
        ارجع خطأ
    والا:
      لو جزءأ < جزءب:
        ارجع صواب
      لو جزءأ > جزءب:
        ارجع خطأ
  ارجع طول(كأ) < طول(كب)

دالة فرز_طبيعي(عناصر):
  ن = طول(عناصر)
  لكل ي في نطاق(ن):
    ادنى = ي
    لكل ج في نطاق(ي + 1, ن):
      لو اصغر_طبيعي(عناصر[ج], عناصر[ادنى]):
        ادنى = ج
    مؤقت = عناصر[ي]
    عناصر[ي] = عناصر[ادنى]
    عناصر[ادنى] = مؤقت
  ارجع عناصر

م = فرز_طبيعي(["img12", "img2", "img1", "a10", "a2"])
تأكد_يساوي(م[0], "a2", "الأول")
تأكد_يساوي(م[1], "a10", "الثاني")
تأكد_يساوي(م[2], "img1", "الثالث")
تأكد_يساوي(م[3], "img2", "الرابع")
تأكد_يساوي(م[4], "img12", "الخامس")
ن = فرز_طبيعي(["x10y2", "x10y10", "x9"])
تأكد_يساوي(ن[0], "x9", "مقاطع متعددة 1")
تأكد_يساوي(ن[1], "x10y2", "مقاطع متعددة 2")
تأكد_يساوي(ن[2], "x10y10", "مقاطع متعددة 3")
