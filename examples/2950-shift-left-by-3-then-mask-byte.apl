# مثال 2950 — إزاحة يسار 3 مع قناع بايت
# Shift left 3 and mask byte
# Demonstrates: بتات
#
# Run:  python apl.py examples/2950-shift-left-by-3-then-mask-byte.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن << 3) & 255

تأكد_يساوي(ف(1), 8, "حالة 1")
تأكد_يساوي(ف(3), 24, "حالة 2")
تأكد_يساوي(ف(85), 168, "حالة 3")
تأكد_يساوي(ف(170), 80, "حالة 4")
تأكد_يساوي(ف(255), 248, "حالة 5")
