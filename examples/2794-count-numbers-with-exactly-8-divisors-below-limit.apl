# مثال 2794 — أعداد لها 8 قواسم
# Numbers with exactly 8 divisors
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2794-count-numbers-with-exactly-8-divisors-below-limit.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ك = 0
  لكل ي في نطاق(1, ن):
    د = 0
    لكل ج في نطاق(1, ي + 1):
      لو ي % ج == 0:
        د = د + 1
    لو د == 8:
      ك = ك + 1
  ارجع ك

تأكد_يساوي(ف(10), 0, "حالة 1")
تأكد_يساوي(ف(30), 1, "حالة 2")
تأكد_يساوي(ف(60), 6, "حالة 3")
