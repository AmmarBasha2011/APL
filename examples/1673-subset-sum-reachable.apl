# مثال 1673 — هل يوجد مجموع جزئي
# Subset sum reachable
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1673-subset-sum-reachable.apl

# جدول من الأهداف الممكنة
# نمر على العناصر ونحدث الجدول من النهاية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجموع_ممكن(ق, هدف):
  ممكن = [صواب]
  لكل ك في نطاق(هدف):
    ممكن.append(خطأ)
  لكل ع في ق:
    ن = هدف
    طالما ن >= ع:
      لو ممكن[ن - ع]:
        ممكن[ن] = صواب
      ن = ن - 1
  ارجع ممكن[هدف]

تأكد_يساوي(مجموع_ممكن([3, 34, 4, 12, 5, 2], 9), صواب, "تسعة")
تأكد_يساوي(مجموع_ممكن([3, 34, 4, 12, 5, 2], 30), خطأ, "ثلاثون")
تأكد_يساوي(مجموع_ممكن([5], 0), صواب, "صفر")
