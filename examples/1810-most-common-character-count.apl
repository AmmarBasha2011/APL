# مثال 1810 — أكثر حرف تكراراً
# Most common character
# Demonstrates: قواميس
#
# Run:  python apl.py examples/1810-most-common-character-count.apl

# عند التعادل نأخذ الأول ظهوراً
# نمر بالنص مرتين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أكثر_حرف(س):
  عد = {}
  لكل ح في س:
    عد[ح] = عد.get(ح, 0) + 1
  أفضل = ""
  أعلى = 0
  لكل ح في س:
    لو عد[ح] > أعلى:
      أعلى = عد[ح]
      أفضل = ح
  ارجع أفضل

تأكد_يساوي(أكثر_حرف("abbcc"), "b", "تعادل")
تأكد_يساوي(أكثر_حرف("aaab"), "a", "الأكثر")
تأكد_يساوي(أكثر_حرف("z"), "z", "حرف")
