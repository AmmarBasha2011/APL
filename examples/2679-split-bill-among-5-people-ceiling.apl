# مثال 2679 — تقسيم الفاتورة على 5
# Split bill among 5
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2679-split-bill-among-5-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 5 - 1) // 5

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 2, "حالة 2")
تأكد_يساوي(ف(100), 20, "حالة 3")
تأكد_يساوي(ف(101), 21, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
