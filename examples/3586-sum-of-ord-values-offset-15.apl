# مثال 3586 — مجموع ord مع إزاحة 15
# Sum of ord values plus 15 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3586-sum-of-ord-values-offset-15.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 15
  ارجع م

تأكد_يساوي(ف("a"), 112, "حالة 1")
تأكد_يساوي(ف("abc"), 339, "حالة 2")
تأكد_يساوي(ف("xyz"), 408, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
