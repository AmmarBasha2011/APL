# مثال 3229 — السعر مع ضريبة 17 بالمئة
# Price with 17 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3229-price-with-17-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 17 // 100

تأكد_يساوي(ف(100), 117, "حالة 1")
تأكد_يساوي(ف(250), 292, "حالة 2")
تأكد_يساوي(ف(999), 1168, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
