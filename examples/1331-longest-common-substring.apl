# مثال 1331 — أطول مقطع مشترك
# Longest common substring length
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1331-longest-common-substring.apl

# جدول يخزن طول المقطع المنتهي عند كل زوج حروف
# نأخذ أكبر قيمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مقطع_مشترك(أ, ب):
  جدول = []
  لكل ع في نطاق(طول(أ) + 1):
    جدول.ألحق([0] * (طول(ب) + 1))
  اقصى = 0
  لكل ع في نطاق(1, طول(أ) + 1):
    لكل ج في نطاق(1, طول(ب) + 1):
      لو أ[ع - 1] == ب[ج - 1]:
        جدول[ع][ج] = جدول[ع - 1][ج - 1] + 1
        لو جدول[ع][ج] > اقصى:
          اقصى = جدول[ع][ج]
  ارجع اقصى

تأكد_يساوي(مقطع_مشترك("abcdef", "zcdemf"), 3, "cde")
تأكد_يساوي(مقطع_مشترك("abc", "xyz"), 0, "لا مشترك")
تأكد_يساوي(مقطع_مشترك("hello", "hello"), 5, "متطابقان")
