# مثال 696 — مساحة بقاعدة الحذاء
# Shoelace formula
# Demonstrates: جداءات متقاطعة، إشارة، محيط
#
# Run:  python apl.py examples/696-shoelace-area.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مساحة مضلع بقاعدة الحذاء (شولايس)
# Demonstrates: جداءات متقاطعة, إشارة الاتجاه, قيمة مطلقة
# سالبة إذا كانت الرؤوس بعكس عقارب الساعة

دالة مساحة_موقعة(رؤوس):
  ن = طول(رؤوس)
  مجموع = 0
  لكل ي في نطاق(ن):
    ج = (ي + 1) % ن
    مجموع = مجموع + رؤوس[ي][0] * رؤوس[ج][1] - رؤوس[ج][0] * رؤوس[ي][1]
  ارجع مجموع / 2.0

دالة مساحة(رؤوس):
  م = مساحة_موقعة(رؤوس)
  لو م < 0:
    ارجع -م
  ارجع م

دالة محيط(رؤوس):
  ن = طول(رؤوس)
  م = 0.0
  لكل ي في نطاق(ن):
    ج = (ي + 1) % ن
    فرق_س = رؤوس[ج][0] - رؤوس[ي][0]
    فرق_ع = رؤوس[ج][1] - رؤوس[ي][1]
    م = م + جذر(فرق_س * فرق_س + فرق_ع * فرق_ع)
  ارجع م

تأكد_يساوي(مساحة([[0, 0], [4, 0], [0, 3]]), 6.0, "مثلث قائم")
تأكد_يساوي(مساحة([[0, 0], [2, 0], [2, 2], [0, 2]]), 4.0, "مربع")
تأكد_يساوي(مساحة_موقعة([[0, 0], [0, 2], [2, 2], [2, 0]]), -4.0, "الاتجاه المعاكس سالب")
تأكد_يساوي(مساحة([[0, 0], [5, 0], [5, 3], [2, 5], [0, 3]]), 20.0, "شكل منزلي")
تأكد_يساوي(مقرب(محيط([[0, 0], [4, 0], [0, 3]]), 2), 12.0, "محيط مثلث 3-4-5")
اطبع "مساحة المنزل:", مساحة([[0, 0], [5, 0], [5, 3], [2, 5], [0, 3]])
