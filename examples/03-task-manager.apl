# مثال 3 — مدير المهام (Lists + Dictionary + Search)
# Task Manager
# Demonstrates: dict, list, in-operator, loops, string methods, uuid
#
# Run:  python apl.py examples/03-task-manager.apl

بذرة(5)

المتغير المهام = {
    "كتابة_التقرير": "قيد الانتظار",
    "مراجعة_الكود": "قيد الانتظار",
    "اجتماع_الفريق": "منتهي"
}

المتغير المفتاح = معرف_نص(معرف_فريد())
اطبع "=== مدير المهام ==="
اطبع "معرّف الجلسة: " + المفتاح
اطبع ""

اطبع "--- المهام ---"
لكل اسم في المهام:
    اطبع f"  {اسم} -> {المهام[اسم]}"

اطبع ""
اطبع "--- إكمال أول مهمة ---"
المتغير الهدف = "كتابة_التقرير"
إذا الهدف في المهام:
    المهام[الهدف] = "منجز"
    اطبع "تم تحديث: " + الهدف
والا:
    اطبع "المهمة غير موجودة"

اطبع ""
اطبع "--- إحصاء ---"
منجز = 0
لكل اسم في المهام:
    إذا المهام[اسم] == "منجز":
        منجز = منجز + 1
اطبع "إجمالي المهام: " + نص(طول(المهام))
اطبع "المنجز: " + نص(منجز)
اطبع "المتبقي: " + نص(طول(المهام) - منجز)
