# مثال 1 — آلة حاسبة تفاعلية
# Interactive Calculator
# Demonstrates: input, arithmetic, multi-level conditionals, printing
#
# Run:  echo "1" | python apl.py examples/01-calculator.apl

المتغير العملية = ادخل("العملية (1=جمع، 2=طرح، 3=ضرب، 4=قسمة): ")

بذرة(7)
المتغير أ = عشوائي_عدد(10, 99)
المتغير ب = عشوائي_عدد(10, 99)

اطبع ""
اطبع "=== آلة حاسبة APL ==="
اطبع "الأول: " + نص(أ)
اطبع "الثاني: " + نص(ب)

إذا العملية == "1":
    اطبع "النتيجة (جمع): " + نص(أ + ب)
سإذا العملية == "2":
    اطبع "النتيجة (طرح): " + نص(أ - ب)
سإذا العملية == "3":
    اطبع "النتيجة (ضرب): " + نص(أ * ب)
سإذا العملية == "4":
    إذا ب == 0:
        اطبع "خطأ: القسمة على صفر"
    والا:
        اطبع "النتيجة (قسمة): " + نص(أ / ب)
والا:
    اطبع "عملية غير معروفة"
