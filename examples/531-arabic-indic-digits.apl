# مثال 531 — الأرقام المشرقية
# Arabic-Indic digits
# Demonstrates: أرقام مشرقية، تحويل ترميز أرقام
#
# Run:  python apl.py examples/531-arabic-indic-digits.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تحويل الأرقام بين العربية الغربية والمشرقية
المتغير مشرقية = "٠١٢٣٤٥٦٧٨٩"

دالة إلى_مشرقية(نص):
    المتغير ناتج = ""
    لكل حرف في نص:
        لو حرف في "0123456789":
            ناتج = ناتج + مشرقية[صحيح(حرف)]
        الا:
            ناتج = ناتج + حرف
    ارجع ناتج

دالة إلى_غربية(مدخل):
    المتغير ناتج = ""
    لكل حرف في مدخل:
        المتغير وجد = خطأ
        لكل i في نطاق(10):
            لو حرف == مشرقية[i]:
                ناتج = ناتج + نص(i)
                وجد = صواب
        لو ليس وجد:
            ناتج = ناتج + حرف
    ارجع ناتج

تأكد_يساوي(إلى_مشرقية("السعر 125 جنيه"), "السعر ١٢٥ جنيه", "غربية إلى مشرقية")
تأكد_يساوي(إلى_غربية("السنة ٢٠٢٤"), "السنة 2024", "مشرقية إلى غربية")
