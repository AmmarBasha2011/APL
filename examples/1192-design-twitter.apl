# مثال 1192 — تصميم تويتر
# Design a mini twitter feed
# Demonstrates: قوائم
#
# Run:  python apl.py examples/1192-design-twitter.apl

# نخزن التغريدات بوقت متزايد
# والخلاصة هي أحدث تغريدات المستخدم ومن يتابعهم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف تويتر:
  دالة_إنشاء(ذات):
    ذات.ساعة = 0
    ذات.تغريدات = []
    ذات.متابعون = {}

  دالة نشر(ذات, مستخدم, رقم):
    ذات.ساعة = ذات.ساعة + 1
    ذات.تغريدات.ألحق([ذات.ساعة, مستخدم, رقم])

  دالة تابع(ذات, أ, ب):
    لو أ ليس في ذات.متابعون:
      ذات.متابعون[أ] = []
    لو ب ليس في ذات.متابعون[أ]:
      ذات.متابعون[أ].ألحق(ب)

  دالة الغ_متابعة(ذات, أ, ب):
    لو أ في ذات.متابعون:
      لو ب في ذات.متابعون[أ]:
        ذات.متابعون[أ].remove(ب)

  دالة خلاصة(ذات, مستخدم):
    مسموح = [مستخدم] + ذات.متابعون.get(مستخدم, [])
    ناتج = []
    ع = طول(ذات.تغريدات) - 1
    طالما (ع >= 0) و (طول(ناتج) < 10):
      لو ذات.تغريدات[ع][1] في مسموح:
        ناتج.ألحق(ذات.تغريدات[ع][2])
      ع = ع - 1
    ارجع ناتج

ت = تويتر()
ت.نشر(1, 5)
تأكد_يساوي(ت.خلاصة(1), [5], "تغريدتي")
ت.تابع(1, 2)
ت.نشر(2, 6)
تأكد_يساوي(ت.خلاصة(1), [6, 5], "مع متابعة")
ت.الغ_متابعة(1, 2)
تأكد_يساوي(ت.خلاصة(1), [5], "بعد الإلغاء")
لكل ع في نطاق(12):
  ت.نشر(3, 100 + ع)
تأكد_يساوي(طول(ت.خلاصة(3)), 10, "عشر تغريدات فقط")
