# مثال 204 — الترتيب الجذري
# Radix sort (LSD)
# Demonstrates: الترتيب بالخانات، سلال
#
# Run:  python apl.py examples/204-radix-sort.apl

دالة جذري(قائمة):
    المتغير خانة = 1
    المتغير أكبر = مفرز(قائمة)[-1]
    طالما أكبر // خانة > 0:
        المتغير سلال = []
        لكل _ في نطاق(10):
            سلال.أضف([])
        لكل ع في قائمة:
            سلال[(ع // خانة) % 10].أضف(ع)
        المتغير جديدة = []
        لكل سلة في سلال:
            لكل ع في سلة:
                جديدة.أضف(ع)
        قائمة = جديدة
        خانة = خانة * 10
    ارجع قائمة

المتغير أرقام = [170, 45, 75, 90, 2, 802, 24, 66]
اطبع "قبل:", أرقام
اطبع "بعد:", جذري(أرقام)
