# مثال 1310 — مجموعات جزئية مميزة
# Subsets with duplicates
# Demonstrates: رجوع
#
# Run:  python apl.py examples/1310-subsets-unique.apl

# نرتب القائمة ونضيف كل عنصر لما قبله
# ونتجنب المجموعات المكررة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجموعات(أ):
  ناتج = [[]]
  لكل س في مفرز(أ):
    جديد = []
    لكل ق في ناتج:
      ن = ق + [س]
      لو ن ليس في ناتج:
        جديد.ألحق(ن)
    ناتج = ناتج + جديد
  ارجع ناتج

تأكد_يساوي(طول(مجموعات([1,2,2])), 6, "ست")
تأكد_يساوي(مجموعات([0]), [[], [0]], "صفر")
تأكد_يساوي(طول(مجموعات([1,1,1])), 4, "أربع")
تأكد_يساوي(مجموعات([]), [[]], "فارغة")
