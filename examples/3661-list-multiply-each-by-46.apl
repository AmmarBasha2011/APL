# مثال 3661 — ضرب كل عنصر في 46
# Multiply each item by 46
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3661-list-multiply-each-by-46.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 46]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [138, 46, 92], "حالة 1")
تأكد_يساوي(ف([5]), [230], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [46, 92, 138, 184, 230, 276], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-92, 0, 322, 322, 184], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [460, 920, 460, 1380, 920, 460], "حالة 5")
