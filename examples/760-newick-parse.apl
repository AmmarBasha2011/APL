# مثال 760 — تحليل نيويك
# Newick tree parsing
# Demonstrates: نزول عودي، أطوال فروع، عقد داخلية
#
# Run:  python apl.py examples/760-newick-parse.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحليل صيغة نيويك لأشجار التطور: (A:0.1,B:0.2,(C:0.3,D:0.4):0.5)
# Demonstrates: نزول عودي بمؤشر قابل للتغيير, أطوال فروع, عقد داخلية
# المؤشر قائمة من عنصر واحد لأن APL يمرر القيم بالنسخ

دالة حلل_عشري(رقم):
  أجزاء = رقم.split(".")
  لو طول(أجزاء) == 1:
    ارجع صحيح(رقم) * 1.0
  مقام = 1
  لكل ي في نطاق(طول(أجزاء[1])):
    مقام = مقام * 10
  ارجع صحيح(أجزاء[0]) + صحيح(أجزاء[1]) / مقام

دالة عقدة(نص, مؤشر):
  أبناء = []
  اسم = ""
  طول_فرع = 0.0
  لو نص[مؤشر[0]] == "(":
    مؤشر[0] = مؤشر[0] + 1
    مستمر = صواب
    طالما مستمر:
      أبناء.append(عقدة(نص, مؤشر))
      لو نص[مؤشر[0]] == ",":
        مؤشر[0] = مؤشر[0] + 1
      والا_لو نص[مؤشر[0]] == ")":
        مؤشر[0] = مؤشر[0] + 1
        مستمر = خطأ
  طالما مؤشر[0] < طول(نص) و نص[مؤشر[0]] != "," و نص[مؤشر[0]] != ")" و نص[مؤشر[0]] != ":" و نص[مؤشر[0]] != ";":
    اسم = اسم + نص[مؤشر[0]]
    مؤشر[0] = مؤشر[0] + 1
  لو مؤشر[0] < طول(نص) و نص[مؤشر[0]] == ":":
    مؤشر[0] = مؤشر[0] + 1
    رقم = ""
    طالما مؤشر[0] < طول(نص) و نص[مؤشر[0]] != "," و نص[مؤشر[0]] != ")" و نص[مؤشر[0]] != ";":
      رقم = رقم + نص[مؤشر[0]]
      مؤشر[0] = مؤشر[0] + 1
    طول_فرع = حلل_عشري(رقم)
  ارجع {"اسم": اسم, "طول": طول_فرع, "أبناء": أبناء}

دالة أوراق(عقدة):
  لو طول(عقدة["أبناء"]) == 0:
    ارجع [عقدة["اسم"]]
  ناتج = []
  لكل ابن في عقدة["أبناء"]:
    لكل ورقة في أوراق(ابن):
      ناتج.append(ورقة)
  ارجع ناتج

دالة مجموع_الأطوال(عقدة):
  مجموع = عقدة["طول"]
  لكل ابن في عقدة["أبناء"]:
    مجموع = مجموع + مجموع_الأطوال(ابن)
  ارجع مجموع

دالة عقد_داخلية(عقدة):
  لو طول(عقدة["أبناء"]) == 0:
    ارجع 0
  مجموع = 1
  لكل ابن في عقدة["أبناء"]:
    مجموع = مجموع + عقد_داخلية(ابن)
  ارجع مجموع

شجرة = عقدة("(A:0.1,B:0.2,(C:0.3,D:0.4):0.5);", [0])

تأكد_يساوي(أوراق(شجرة), ["A", "B", "C", "D"], "أربع أوراق")
تأكد_يساوي(مقرب(مجموع_الأطوال(شجرة), 4), 1.5, "مجموع الأطوال")
تأكد_يساوي(عقد_داخلية(شجرة), 2, "عقدتان داخليتان")
تأكد_يساوي(شجرة["أبناء"][2]["طول"], 0.5, "فرع العقدة الداخلية")

بسيطة = عقدة("(X:1.0,Y:2.0)", [0])
تأكد_يساوي(أوراق(بسيطة), ["X", "Y"], "شجرة بسيطة")
تأكد_يساوي(عقد_داخلية(بسيطة), 1, "جذر فقط")

اطبع "الأوراق:", أوراق(شجرة)
