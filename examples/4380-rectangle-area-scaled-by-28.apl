# مثال 4380 — مساحة مستطيل مكبر 28 مرات
# Rectangle area scaled by 28
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4380-rectangle-area-scaled-by-28.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 28) * (ق[1] * 28)

تأكد_يساوي(ف([1, 2]), 1568, "حالة 1")
تأكد_يساوي(ف([3, 4]), 9408, "حالة 2")
تأكد_يساوي(ف([5, 5]), 19600, "حالة 3")
تأكد_يساوي(ف([10, 1]), 7840, "حالة 4")
