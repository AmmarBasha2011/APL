# مثال 738 — قاعدة سيمبسون
# Simpson's rule
# Demonstrates: أوزان 4-2، شرائح، تقارب
#
# Run:  python apl.py examples/738-simpson-integrate.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# التكامل العددي بقاعدة سيمبسون المركبة
# Demonstrates: أوزان 4-2-4-2, دالة تمرر كوسيط, تقارب مع زيادة الشرائح
# سيمبسون دقيق تماماً للكثيرات حتى الدرجة الثالثة

دالة سيمبسون(د, أ, ب, ش):
  ارتفاع = (ب - أ) / ش
  مجموع = د(أ) + د(ب)
  لكل ي في نطاق(1, ش):
    لو ي % 2 == 1:
      مجموع = مجموع + 4 * د(أ + ي * ارتفاع)
    والا:
      مجموع = مجموع + 2 * د(أ + ي * ارتفاع)
  ارجع مجموع * ارتفاع / 3

دالة مربع(س):
  ارجع س * س

دالة تكعيبي(س):
  ارجع س * س * س - 2 * س + 1

دالة قوة_رابعة(س):
  ارجع س * س * س * س

تأكد_يساوي(مقرب(سيمبسون(مربع, 0, 2, 100), 4), 2.6667, "تكامل س^2 من 0 إلى 2")
تأكد_يساوي(مقرب(سيمبسون(تكعيبي, 0, 2, 100), 4), 2.0, "تكعيبي دقيق تماماً")
تأكد_يساوي(مقرب(سيمبسون(قوة_رابعة, 0, 1, 100), 6), 0.2, "س^4 من 0 إلى 1")

# التقارب: شرائح أكثر تعني خطأ أصغر لس^4
خطأ_خشن = 0.2 - سيمبسون(قوة_رابعة, 0, 1, 10)
خطأ_دقيق = 0.2 - سيمبسون(قوة_رابعة, 0, 1, 100)
لو خطأ_خشن < 0:
  خطأ_خشن = -خطأ_خشن
لو خطأ_دقيق < 0:
  خطأ_دقيق = -خطأ_دقيق
تأكد_يساوي(خطأ_دقيق < خطأ_خشن, صواب, "الدقة تتحسن")

تأكد_يساوي(سيمبسون(مربع, 0, 0, 10), 0, "فترة صفرية")

اطبع "∫س^2 من 0 إلى 2 ≈", مقرب(سيمبسون(مربع, 0, 2, 100), 4)
