# مثال 1132 — ثيران وأبقار
# Bulls and cows
# Demonstrates: عد تطابق
#
# Run:  python apl.py examples/1132-bulls-and-cows.apl

# الثور رقم في مكانه الصحيح
# والبقرة رقم صحيح في مكان خاطئ

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قيم(سر, تخمين):
  ثيران = 0
  عد_سر = [0] * 10
  عد_تخ = [0] * 10
  لكل ع في نطاق(طول(سر)):
    لو سر[ع] == تخمين[ع]:
      ثيران = ثيران + 1
    والا:
      عد_سر[صحيح(سر[ع])] = عد_سر[صحيح(سر[ع])] + 1
      عد_تخ[صحيح(تخمين[ع])] = عد_تخ[صحيح(تخمين[ع])] + 1
  ابقار = 0
  لكل ر في نطاق(10):
    ابقار = ابقار + أصغر(عد_سر[ر], عد_تخ[ر])
  ارجع [ثيران, ابقار]

تأكد_يساوي(قيم("1807", "7810"), [1, 3], "مثال أول")
تأكد_يساوي(قيم("1123", "0111"), [1, 1], "تكرار")
تأكد_يساوي(قيم("1234", "1234"), [4, 0], "تطابق كامل")
تأكد_يساوي(قيم("1234", "5678"), [0, 0], "لا تطابق")
