# مثال 1523 — المنوال
# Mode of a list
# Demonstrates: إحصاء
#
# Run:  python apl.py examples/1523-mode-of-list.apl

# نعد تكرار كل قيمة
# عند التعادل نأخذ الأصغر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة المنوال(أ):
  عد = {}
  لكل ع في أ:
    عد[ع] = عد.get(ع, 0) + 1
  أفضل = أ[0]
  لكل ع في أ:
    لو عد[ع] > عد[أفضل] أو (عد[ع] == عد[أفضل] و ع < أفضل):
      أفضل = ع
  ارجع أفضل

تأكد_يساوي(المنوال([1, 2, 2, 3]), 2, "واضح")
تأكد_يساوي(المنوال([4, 1, 4, 1]), 1, "تعادل")
تأكد_يساوي(المنوال([7]), 7, "وحيد")
