# مثال 18 — قائمة مرتبطة
# Linked List Implementation
# Demonstrates: classes, recursion, self-reference, data structures
#
# Run:  python apl.py examples/18-linked-list.apl

صنف العقدة:
    دالة_إنشاء(ذات, قيمة):
        ذات.قيمة = قيمة
        ذات.التالي = لا_شيء

صنف قائمة_مربوطة:
    دالة_إنشاء(ذات):
        ذات.رأس = لا_شيء
        ذات.الطول = 0

    دالة إضافة(ذات, قيمة):
        عقدة = العقدة(قيمة)
        إذا ذات.رأس == لا_شيء:
            ذات.رأس = عقدة
        والا:
            مؤشر = ذات.رأس
            طالما مؤشر.التالي != لا_شيء:
                مؤشر = مؤشر.التالي
            مؤشر.التالي = عقدة
        ذات.الطول = ذات.الطول + 1

    دالة عرض(ذات):
        إذا ذات.رأس == لا_شيء:
            ارجع "(فارغة)"
        نص_الناتج = ""
        مؤشر = ذات.رأس
        طالما مؤشر != لا_شيء:
            نص_الناتج = نص_الناتج + نص(مؤشر.قيمة) + " -> "
            مؤشر = مؤشر.التالي
        ارجع نص_الناتج + "None"

المتغير القائمة_مربوطة = قائمة_مربوطة()
لكل قيمة في [10, 20, 30, 40, 50]:
    القائمة_مربوطة.إضافة(قيمة)

اطبع "=== قائمة مرتبطة ==="
اطبع "محتوى القائمة: " + القائمة_مربوطة.عرض()
اطبع "الطول (متغير):  " + نص(القائمة_مربوطة.الطول)
دالة عد_العقد(عقدة):
    إذا عقدة == لا_شيء:
        ارجع 0
    ارجع 1 + عد_العقد(عقدة.التالي)

اطبع "الطول (متكرر):  " + نص(عد_العقد(القائمة_مربوطة.رأس))
