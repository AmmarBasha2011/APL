# مثال 3240 — تحويل وحدة بأساس 18
# Split by base 18
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3240-minutes-to-hours-and-minutes-base-18.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 18, ن % 18]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [3, 5], "حالة 2")
تأكد_يساوي(ف(60), [3, 6], "حالة 3")
تأكد_يساوي(ف(125), [6, 17], "حالة 4")
تأكد_يساوي(ف(1000), [55, 10], "حالة 5")
