# مثال 2636 — قيصر بإزاحة 10
# Caesar shift 10
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2636-caesar-shift-by-10-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 10) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "klm", "حالة 1")
تأكد_يساوي(ف("xyz"), "hij", "حالة 2")
تأكد_يساوي(ف("hello world"), "rovvy gybvn", "حالة 3")
تأكد_يساوي(ف("a1"), "k1", "حالة 4")
