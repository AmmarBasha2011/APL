# مثال 3326 — الحد النوني بخطوة 35
# Nth term step 35
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3326-nth-term-arithmetic-sequence-step-35.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 35

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 38, "حالة 2")
تأكد_يساوي(ف(10), 318, "حالة 3")
تأكد_يساوي(ف(100), 3468, "حالة 4")
