# مثال 2030 — هل يفصل النصين تعديل واحد بالضبط
# One edit distance
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2030-one-edit-distance-string-check.apl

# # نجد أول موضع اختلاف
# # ثم نقارن الباقي حسب فرق الطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تعديل_واحد(ا, ب):
  لو طول(ا) > طول(ب):
    ت = ا
    ا = ب
    ب = ت
  لو طول(ب) - طول(ا) > 1:
    ارجع خطأ
  ي = 0
  طالما ي < طول(ا) و ا[ي] == ب[ي]:
    ي = ي + 1
  لو ي == طول(ا):
    ارجع طول(ب) - طول(ا) == 1
  لو طول(ا) == طول(ب):
    ارجع ا[ي + 1:] == ب[ي + 1:]
  ارجع ا[ي:] == ب[ي + 1:]

تأكد_يساوي(تعديل_واحد("ab", "acb"), صواب, "إدراج")
تأكد_يساوي(تعديل_واحد("ab", "ab"), خطأ, "متساويان")
تأكد_يساوي(تعديل_واحد("a", ""), صواب, "حذف")
تأكد_يساوي(تعديل_واحد("abc", "adc"), صواب, "استبدال")
تأكد_يساوي(تعديل_واحد("abc", "xyz"), خطأ, "ثلاثة فروق")
