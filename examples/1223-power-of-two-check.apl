# مثال 1223 — قوة العدد اثنين
# Power of two and four check
# Demonstrates: عمليات بتات
#
# Run:  python apl.py examples/1223-power-of-two-check.apl

# القوة اثنين فيها بت واحد
# والقوة أربعة بتها في موضع زوجي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة_اثنين(ن):
  ارجع (ن > 0) و ((ن & (ن - 1)) == 0)

دالة قوة_اربعة(ن):
  لو ليس قوة_اثنين(ن):
    ارجع خطأ
  ارجع (ن & 0x55555555) != 0

تأكد_يساوي(قوة_اثنين(1), صواب, "واحد")
تأكد_يساوي(قوة_اثنين(16), صواب, "ستة عشر")
تأكد_يساوي(قوة_اثنين(18), خطأ, "ثمانية عشر")
تأكد_يساوي(قوة_اثنين(0), خطأ, "صفر")
تأكد_يساوي(قوة_اربعة(16), صواب, "أربعة")
تأكد_يساوي(قوة_اربعة(8), خطأ, "ثمانية")
تأكد_يساوي(قوة_اربعة(64), صواب, "أربع وستون")
