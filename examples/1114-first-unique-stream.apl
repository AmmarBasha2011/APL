# مثال 1114 — أول عدد فريد في تدفق
# First unique number in a stream
# Demonstrates: عد الظهور
#
# Run:  python apl.py examples/1114-first-unique-stream.apl

# نحتفظ بالعناصر بترتيب وصولها
# ونفحص أول عنصر يظهر مرة واحدة فقط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف اول_فريد:
    دالة_إنشاء(ذات, بداية):
        ذات.عناصر = قائمة(بداية)

    دالة ظهور(ذات, س):
        ن = 0
        لكل ع في ذات.عناصر:
            لو ع == س:
                ن = ن + 1
        ارجع ن

    دالة اظهر_الاول(ذات):
        لكل ع في ذات.عناصر:
            لو ذات.ظهور(ع) == 1:
                ارجع ع
        ارجع -1

    دالة اضف_قيمة(ذات, س):
        ذات.عناصر.ألحق(س)

ف = اول_فريد([2, 3, 5])
تأكد_يساوي(ف.اظهر_الاول(), 2, "البداية")
ف.اضف_قيمة(5)
تأكد_يساوي(ف.اظهر_الاول(), 2, "بعد 5")
ف.اضف_قيمة(2)
تأكد_يساوي(ف.اظهر_الاول(), 3, "بعد 2")
ف.اضف_قيمة(3)
تأكد_يساوي(ف.اظهر_الاول(), -1, "لا فريد")
