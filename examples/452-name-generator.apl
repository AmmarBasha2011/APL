# مثال 452 — مولد أسماء مستعارة
# Nickname generator
# Demonstrates: تركيب صفة واسم
#
# Run:  python apl.py examples/452-name-generator.apl

بذرة(9)
المتغير صفات = ["السريع", "الشجاع", "الحكيم", "الهادئ", "اللامع"]
المتغير أسماء = ["صقر", "أسد", "ذئب", "نسر", "فهد"]

لكل _ في نطاق(5):
    اطبع صفات[عشوائي_عدد(0, 4)] + " " + أسماء[عشوائي_عدد(0, 4)]
