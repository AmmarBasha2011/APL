# مثال 2298 — المرور الحلزوني
# Spiral order
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2298-matrix-spiral-order-walk.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ر = []
  ع = [ص[:] لكل ص في م] if False else م
  أ = 0
  ب = طول(م) - 1
  ي = 0
  ك = طول(م[0]) - 1
  طالما أ <= ب و ي <= ك:
    لكل ج في نطاق(ي, ك + 1):
      ر = ر + [م[أ][ج]]
    أ = أ + 1
    لكل ج في نطاق(أ, ب + 1):
      ر = ر + [م[ج][ك]]
    ك = ك - 1
    لو أ <= ب:
      لكل ج في نطاق(ك, ي - 1, -1):
        ر = ر + [م[ب][ج]]
      ب = ب - 1
    لو ي <= ك:
      لكل ج في نطاق(ب, أ - 1, -1):
        ر = ر + [م[ج][ي]]
      ي = ي + 1
  ارجع ر

تأكد_يساوي(ف([[1, 2], [3, 4]]), [1, 2, 4, 3], "حالة 1")
تأكد_يساوي(ف([[5]]), [5], "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [1, 2, 3, 6, 9, 8, 7, 4, 5], "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), [0, 1, 0, 1], "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), [2, -1, 0, 1, 1, 1, 1, 0, 3], "حالة 5")
