# مثال 3470 — عدد العناصر الأكبر من 41
# Count items greater than 41
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3470-list-count-greater-than-41.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع = 0
  لكل خ في ق:
    لو خ > 41:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([3, 1, 2]), 0, "حالة 1")
تأكد_يساوي(ف([5]), 0, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 0, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 0, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 0, "حالة 5")
