# مثال 155 — جرد المنتجات بفئات البيانات
# Product inventory with dataclasses
# Demonstrates: @فئة_بيانات، حقول، قيم افتراضية
#
# Run:  python apl.py examples/155-dataclass-inventory.apl

@فئة_بيانات
صنف منتج:
    اسم: نص
    سعر: عشري
    كمية: صحيح = 0

المتغير أ = منتج("تفاح", 5.5, 100)
المتغير ب = منتج("موز", 3.25)
اطبع أ
اطبع "إجمالي قيمة التفاح:", أ.سعر * أ.كمية
اطبع "موز بدون كمية:", ب.كمية
اطبع "متساويان؟", أ == منتج("تفاح", 5.5, 100)
