# مثال 1486 — فرز ستوج
# Stooge sort
# Demonstrates: فرز
#
# Run:  python apl.py examples/1486-stooge-sort-recursive.apl

# نرتب الثلثين الأولين ثم الأخيرين
# ثم الأولين مرة أخرى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ستوج(أ, ي, ن):
  لو أ[ي] > أ[ن]:
    ت = أ[ي]
    أ[ي] = أ[ن]
    أ[ن] = ت
  لو ن - ي + 1 > 2:
    ثلث = (ن - ي + 1) // 3
    ستوج(أ, ي, ن - ثلث)
    ستوج(أ, ي + ثلث, ن)
    ستوج(أ, ي, ن - ثلث)
  ارجع أ

تأكد_يساوي(ستوج([5, 3, 1, 4, 2], 0, 4), [1, 2, 3, 4, 5], "خمسة")
تأكد_يساوي(ستوج([2, 1], 0, 1), [1, 2], "اثنان")
تأكد_يساوي(ستوج([9, 8, 7], 0, 2), [7, 8, 9], "ثلاثة")
