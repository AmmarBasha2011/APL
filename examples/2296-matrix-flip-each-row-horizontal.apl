# مثال 2296 — قلب كل صف أفقيا
# Flip each row
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2296-matrix-flip-each-row-horizontal.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ر = []
  لكل ص في م:
    ر = ر + [ص[::-1]]
  ارجع ر

تأكد_يساوي(ف([[1, 2], [3, 4]]), [[2, 1], [4, 3]], "حالة 1")
تأكد_يساوي(ف([[5]]), [[5]], "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [[3, 2, 1], [6, 5, 4], [9, 8, 7]], "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), [[1, 0], [0, 1]], "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), [[0, -1, 2], [1, 3, 0], [1, 1, 1]], "حالة 5")
