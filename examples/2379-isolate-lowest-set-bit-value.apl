# مثال 2379 — أدنى بت مضاء
# Lowest set bit value
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2379-isolate-lowest-set-bit-value.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & (0 - ن)

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 2, "حالة 2")
تأكد_يساوي(ف(12), 4, "حالة 3")
تأكد_يساوي(ف(40), 8, "حالة 4")
تأكد_يساوي(ف(96), 32, "حالة 5")
تأكد_يساوي(ف(7), 1, "حالة 6")
