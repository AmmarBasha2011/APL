# مثال 1737 — عدد الكلمات في فيز بز
# FizzBuzz counts
# Demonstrates: منطق
#
# Run:  python apl.py examples/1737-fizz-buzz-count-range.apl

# مضاعفات الثلاثة والخمسة والاثنين معاً
# نصنف كل عدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عد_فيز(ن):
  فيز = 0
  بز = 0
  كلاهما = 0
  لكل ك في نطاق(1, ن + 1):
    لو ك % 15 == 0:
      كلاهما = كلاهما + 1
    والا_لو ك % 3 == 0:
      فيز = فيز + 1
    والا_لو ك % 5 == 0:
      بز = بز + 1
  ارجع [فيز, بز, كلاهما]

تأكد_يساوي(عد_فيز(15), [4, 2, 1], "خمسة عشر")
تأكد_يساوي(عد_فيز(2), [0, 0, 0], "اثنان")
تأكد_يساوي(عد_فيز(30), [8, 4, 2], "ثلاثون")
