# مثال 1188 — حذف أقل أقواس
# Minimum remove to make valid parentheses
# Demonstrates: مسحان
#
# Run:  python apl.py examples/1188-min-remove-valid-parens.apl

# نمسح من اليسار ونحذف الإغلاق الزائد
# ثم من اليمين ونحذف الفتح الزائد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نظف(س):
  رصيد = 0
  أ = []
  لكل ح في س:
    لو ح == "(":
      رصيد = رصيد + 1
      أ.ألحق(ح)
    والا_لو ح == ")":
      لو رصيد > 0:
        رصيد = رصيد - 1
        أ.ألحق(ح)
    والا:
      أ.ألحق(ح)
  ب = []
  رصيد = 0
  لكل ح في أ[::-1]:
    لو ح == ")":
      رصيد = رصيد + 1
      ب.ألحق(ح)
    والا_لو ح == "(":
      لو رصيد > 0:
        رصيد = رصيد - 1
        ب.ألحق(ح)
    والا:
      ب.ألحق(ح)
  ارجع "".join(ب[::-1])

تأكد_يساوي(نظف("lee(t(c)o)de)"), "lee(t(c)o)de", "إغلاق زائد")
تأكد_يساوي(نظف("a)b(c)d"), "ab(c)d", "في الوسط")
تأكد_يساوي(نظف("))(("), "", "كلها زائدة")
تأكد_يساوي(نظف("(a(b(c)d)"), "a(b(c)d)", "فتح زائد")
