# مثال 3939 — مجموع الأعداد من 39 إلى ن
# Sum from 39 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3939-sum-of-integers-from-39-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(39, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(39), 39, "حالة 1")
تأكد_يساوي(ف(40), 79, "حالة 2")
تأكد_يساوي(ف(49), 484, "حالة 3")
تأكد_يساوي(ف(100), 4309, "حالة 4")
