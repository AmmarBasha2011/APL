# مثال 1123 — مكرر متعرج
# Zigzag iterator
# Demonstrates: تناوب بين قائمتين
#
# Run:  python apl.py examples/1123-zigzag-iterator.apl

# نأخذ عنصراً من القائمة الأولى ثم الثانية ثم نعود
# ولو انتهت قائمة أكملنا من الأخرى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف متعرج:
    دالة_إنشاء(ذات, أ, ب):
        ذات.قوائم = [أ, ب]
        ذات.مواضع = [0, 0]
        ذات.دور = 0

    دالة لديه_تالي(ذات):
        ارجع (ذات.مواضع[0] < طول(ذات.قوائم[0])) أو (ذات.مواضع[1] < طول(ذات.قوائم[1]))

    دالة تالي(ذات):
        لو ذات.مواضع[ذات.دور] >= طول(ذات.قوائم[ذات.دور]):
            ذات.دور = 1 - ذات.دور
        س = ذات.قوائم[ذات.دور][ذات.مواضع[ذات.دور]]
        ذات.مواضع[ذات.دور] = ذات.مواضع[ذات.دور] + 1
        ذات.دور = 1 - ذات.دور
        ارجع س

م = متعرج([1, 2], [3, 4, 5, 6])
ناتج = []
طالما م.لديه_تالي():
    ناتج.ألحق(م.تالي())
تأكد_يساوي(ناتج, [1, 3, 2, 4, 5, 6], "قائمتان مختلفتا الطول")
ن = متعرج([], [7, 8])
ناتج2 = []
طالما ن.لديه_تالي():
    ناتج2.ألحق(ن.تالي())
تأكد_يساوي(ناتج2, [7, 8], "الأولى فارغة")
