# مثال 3410 — متتالية أ=12×السابق+1
# Recurrence times 12 plus one
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/3410-linear-recurrence-a-n-equals-12-times-previous-plus-one.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 1
  لكل ي في نطاق(ن):
    أ = أ * 12 + 1
  ارجع أ

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 13, "حالة 2")
تأكد_يساوي(ف(2), 157, "حالة 3")
تأكد_يساوي(ف(5), 271453, "حالة 4")
تأكد_يساوي(ف(8), 469070941, "حالة 5")
