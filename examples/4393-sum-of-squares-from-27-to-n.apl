# مثال 4393 — مجموع المربعات من 27 إلى ن
# Sum of squares from 27
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4393-sum-of-squares-from-27-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(27, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(27), 729, "حالة 1")
تأكد_يساوي(ف(28), 1513, "حالة 2")
تأكد_يساوي(ف(37), 11374, "حالة 3")
تأكد_يساوي(ف(100), 332149, "حالة 4")
