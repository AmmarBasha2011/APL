# مثال 1225 — أكبر xor
# Maximum XOR of two numbers
# Demonstrates: عمليات بتات
#
# Run:  python apl.py examples/1225-max-xor-pair.apl

# نبني الجواب بتاً بتاً من الأعلى
# ونتحقق بوجود زوج بنفس البادئات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اكبر_xor(أ):
  ناتج = 0
  قناع = 0
  لكل ب في نطاق(31, -1, -1):
    قناع = قناع | (1 << ب)
    بوادئ = []
    لكل س في أ:
      بوادئ.ألحق(س & قناع)
    تجربة = ناتج | (1 << ب)
    وجد = خطأ
    لكل ز في بوادئ:
      لو (تجربة ^ ز) في بوادئ:
        وجد = صواب
    لو وجد:
      ناتج = تجربة
  ارجع ناتج

تأكد_يساوي(اكبر_xor([3,10,5,25,2,8]), 28, "مثال أول")
تأكد_يساوي(اكبر_xor([14,70,53,83,49,91,36,80,92,51,66,70]), 127, "مثال ثان")
تأكد_يساوي(اكبر_xor([0]), 0, "عنصر")
