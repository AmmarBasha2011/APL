# مثال 3208 — مجموع الأعداد من 16 إلى ن
# Sum from 16 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3208-sum-of-integers-from-16-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(16, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(16), 16, "حالة 1")
تأكد_يساوي(ف(17), 33, "حالة 2")
تأكد_يساوي(ف(26), 231, "حالة 3")
تأكد_يساوي(ف(100), 4930, "حالة 4")
