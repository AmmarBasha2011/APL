# مثال 164 — تجزئة ملف قبل وبعد النسخ
# Hashing a file before and after copy
# Demonstrates: تجزئة_sha256، اقرأ، انسخ_ملف
#
# Run:  python apl.py examples/164-hash-file.apl

دالة تجزئة_ملف(مسار):
    ارجع تجزئة_sha256(اقرأ(مسار).encode()).hexdigest()

المتغير أصل = "/tmp/apl_hash_src.txt"
المتغير نسخة = "/tmp/apl_hash_dst.txt"
اكتب(أصل, "بيانات لا يجب أن تتغير أثناء النسخ\n")

انسخ_ملف(أصل, نسخة)
اطبع "تجزئة الأصل:", تجزئة_ملف(أصل)[:16], "..."
اطبع "تجزئة النسخة:", تجزئة_ملف(نسخة)[:16], "..."
اطبع "النسخة مطابقة؟", تجزئة_ملف(أصل) == تجزئة_ملف(نسخة)

احذف_ملف(أصل)
احذف_ملف(نسخة)
