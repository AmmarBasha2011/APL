# مثال 1427 — تشابه الجمل
# Sentence similarity with pairs
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1427-sentence-similarity-pairs.apl

# الجملتان بنفس الطول
# كل كلمتين متقابلتين متساويتان أو زوج متشابه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متشابهتان(أ, ب, ازواج):
  لو طول(أ) != طول(ب):
    ارجع خطأ
  مشابه = {}
  لكل ز في ازواج:
    مشابه[ز[0] + "|" + ز[1]] = صواب
    مشابه[ز[1] + "|" + ز[0]] = صواب
  لكل ع في نطاق(طول(أ)):
    لو أ[ع] != ب[ع]:
      لو ليس مشابه.get(أ[ع] + "|" + ب[ع], خطأ):
        ارجع خطأ
  ارجع صواب

ز = [["great","fine"],["drama","acting"],["skills","talent"]]
تأكد_يساوي(متشابهتان(["great","acting","skills"], ["fine","drama","talent"], ز), صواب, "متشابهتان")
تأكد_يساوي(متشابهتان(["great"], ["great"], []), صواب, "نفس الكلمة")
تأكد_يساوي(متشابهتان(["great"], ["double"], ز), خطأ, "مختلفتان")
