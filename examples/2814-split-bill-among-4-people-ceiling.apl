# مثال 2814 — تقسيم الفاتورة على 4
# Split bill among 4
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2814-split-bill-among-4-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 4 - 1) // 4

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 3, "حالة 2")
تأكد_يساوي(ف(100), 25, "حالة 3")
تأكد_يساوي(ف(101), 26, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
