# مثال 371 — مهلة على مهمة غير متزامنة
# Async timeout
# Demonstrates: انتظر_أي، مهلة
#
# Run:  python apl.py examples/371-async-timeout.apl

async def مهمة_بطيئة():
    await نوم(5)
    return "انتهت متأخرة"

async def مهمة_سريعة():
    await نوم(0.01)
    return "انتهت بسرعة"

async def الرئيسية():
    حاول:
        المتغير ن = await انتظر_أي(مهمة_سريعة(), 1)
        اطبع "النتيجة:", ن
    إمسك مثل خطأ:
        اطبع "انتهت المهلة"
    حاول:
        المتغير م = await انتظر_أي(مهمة_بطيئة(), 0.01)
        اطبع "النتيجة:", م
    إمسك مثل خطأ:
        اطبع "المهمة البطيئة تجاوزت المهلة كما هو متوقع"

شغل_تزامن(الرئيسية())
