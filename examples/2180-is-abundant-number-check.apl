# مثال 2180 — هل العدد وافر
# Is number abundant
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2180-is-abundant-number-check.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن):
    لو ن % ي == 0:
      م = م + ي
  ارجع م > ن

تأكد_يساوي(ف(12), صواب, "حالة 12")
تأكد_يساوي(ف(18), صواب, "حالة 18")
تأكد_يساوي(ف(6), خطأ, "حالة 6")
تأكد_يساوي(ف(15), خطأ, "حالة 15")
تأكد_يساوي(ف(20), صواب, "حالة 20")
