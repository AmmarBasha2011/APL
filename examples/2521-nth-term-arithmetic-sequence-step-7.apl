# مثال 2521 — الحد النوني بخطوة 7
# Nth term step 7
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2521-nth-term-arithmetic-sequence-step-7.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 7

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 10, "حالة 2")
تأكد_يساوي(ف(10), 66, "حالة 3")
تأكد_يساوي(ف(100), 696, "حالة 4")
