# مثال 1061 — أقل قطع للتناظر
# Palindrome partitioning minimum cuts
# Demonstrates: جدول تناظر
#
# Run:  python apl.py examples/1061-min-cuts-palindrome.apl

# نبني أولاً جدولاً يقول هل كل جزء من النص متناظر
# ثم نحسب أقل قطع لكل بادئة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_قطع(نص_):
  ن = طول(نص_)
  تناظر = []
  لكل ر في نطاق(ن):
    تناظر.ألحق([خطأ] * ن)
  لكل نهاية في نطاق(ن):
    لكل بداية في نطاق(نهاية + 1):
      لو نص_[بداية] == نص_[نهاية]:
        لو ((نهاية - بداية) < 2) أو تناظر[بداية + 1][نهاية - 1]:
          تناظر[بداية][نهاية] = صواب
  قطع = [0] * ن
  لكل نهاية في نطاق(ن):
    لو تناظر[0][نهاية]:
      قطع[نهاية] = 0
    والا:
      قطع[نهاية] = نهاية
      لكل بداية في نطاق(1, نهاية + 1):
        لو تناظر[بداية][نهاية] و ((قطع[بداية - 1] + 1) < قطع[نهاية]):
          قطع[نهاية] = قطع[بداية - 1] + 1
  ارجع قطع[ن - 1]

تأكد_يساوي(اقل_قطع("aab"), 1, "aab")
تأكد_يساوي(اقل_قطع("a"), 0, "حرف")
تأكد_يساوي(اقل_قطع("ab"), 1, "ab")
تأكد_يساوي(اقل_قطع("racecar"), 0, "متناظر كله")
تأكد_يساوي(اقل_قطع("abccbc"), 2, "abccbc")
