# مثال 1040 — إيجاد قمة
# Find peak element
# Demonstrates: بحث ثنائي على الميل
#
# Run:  python apl.py examples/1040-find-peak.apl

# لو كان العنصر أصغر من التالي ففي اليمين قمة
# وإلا ففي اليسار قمة أو هو نفسه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قمة(ق):
  ي = 0
  ل = طول(ق) - 1
  طالما ي < ل:
    وسط = (ي + ل) // 2
    لو ق[وسط] < ق[وسط + 1]:
      ي = وسط + 1
    والا:
      ل = وسط
  ارجع ي

تأكد_يساوي(قمة([1, 2, 3, 1]), 2, "قمة واحدة")
تأكد_يساوي(قمة([1]), 0, "عنصر واحد")
تأكد_يساوي(قمة([1, 2, 1, 3, 5, 6, 4]) في [1, 5], صواب, "إحدى القمتين")
