# مثال 1333 — نص متداخل
# Interleaving string check
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1333-interleaving-string.apl

# جدول صواب وخطأ لكل بادئتين
# نتقدم من أحد النصين في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متداخل(أ, ب, ج):
  لو طول(أ) + طول(ب) != طول(ج):
    ارجع خطأ
  جدول = []
  لكل ع في نطاق(طول(أ) + 1):
    جدول.ألحق([خطأ] * (طول(ب) + 1))
  جدول[0][0] = صواب
  لكل ع في نطاق(طول(أ) + 1):
    لكل ك في نطاق(طول(ب) + 1):
      لو (ع > 0) و جدول[ع - 1][ك] و (أ[ع - 1] == ج[ع + ك - 1]):
        جدول[ع][ك] = صواب
      لو (ك > 0) و جدول[ع][ك - 1] و (ب[ك - 1] == ج[ع + ك - 1]):
        جدول[ع][ك] = صواب
  ارجع جدول[طول(أ)][طول(ب)]

تأكد_يساوي(متداخل("aabcc", "dbbca", "aadbbcbcac"), صواب, "ممكن")
تأكد_يساوي(متداخل("aabcc", "dbbca", "aadbbbaccc"), خطأ, "غير ممكن")
تأكد_يساوي(متداخل("", "", ""), صواب, "فارغة")
