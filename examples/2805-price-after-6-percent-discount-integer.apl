# مثال 2805 — السعر بعد خصم 6 بالمئة
# Price after 6 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2805-price-after-6-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 6 // 100

تأكد_يساوي(ف(100), 94, "حالة 1")
تأكد_يساوي(ف(250), 235, "حالة 2")
تأكد_يساوي(ف(999), 940, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
