# مثال 664 — مشاركة سر شامير
# Shamir secret sharing
# Demonstrates: شامير، حقل منته، لاغرانج
#
# Run:  python apl.py examples/664-shamir-secret.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مشاركة سر شامير (3 من 5)
# Demonstrates: كثيرة حدود على حقل منته, معكوس معياري, إدخال لاغرانج
# أي 3 حصص تكفي وأي 2 لا تكشف شيئا

أولي = 257
سر = 42

دالة باقي(س):
  ن = س % أولي
  لو ن < 0:
    ن = ن + أولي
  ارجع ن

دالة عكس(س):
  ق = 1
  أس = أولي - 2
  قاعدة = س
  طالما أس > 0:
    لو أس % 2 == 1:
      ق = باقي(ق * قاعدة)
    قاعدة = باقي(قاعدة * قاعدة)
    أس = أس // 2
  ارجع ق

دالة قيمة_كثيرة(س):
  ارجع باقي(سر + 17 * س + 91 * س * س)

حصص = []
لكل س في نطاق(1, 6):
  حصص.append([س, قيمة_كثيرة(س)])

دالة استعد(ثلاث):
  حاصل = 0
  لكل ي في نطاق(3):
    بسط = 1
    مقام = 1
    لكل ج في نطاق(3):
      لو ي != ج:
        بسط = باقي(بسط * (0 - ثلاث[ج][0]))
        مقام = باقي(مقام * (ثلاث[ي][0] - ثلاث[ج][0]))
    حد = باقي(ثلاث[ي][1] * بسط * عكس(مقام))
    حاصل = باقي(حاصل + حد)
  ارجع حاصل

تأكد_يساوي(استعد([حصص[0], حصص[2], حصص[4]]), سر, "حصص 1 و3 و5")
تأكد_يساوي(استعد([حصص[1], حصص[2], حصص[3]]), سر, "حصص 2 و3 و4")
تأكد_يساوي(استعد([حصص[0], حصص[1], حصص[2]]), سر, "حصص 1 و2 و3")
تأكد_يساوي(قيمة_كثيرة(1), باقي(42 + 17 + 91), "حصة أولى يدويا")
اطبع "حصة 1:", حصص[0][1]
