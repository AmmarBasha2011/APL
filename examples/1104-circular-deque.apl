# مثال 1104 — طابور مزدوج دائري
# Circular double-ended queue
# Demonstrates: فهرس بالباقي
#
# Run:  python apl.py examples/1104-circular-deque.apl

# مؤشر رأس وحجم على مصفوفة بسعة ثابتة
# الإدخال من الأمام يرجع الرأس خطوة بالباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مزدوج_دائري:
    دالة_إنشاء(ذات, سعة):
        ذات.بيانات = [0] * سعة
        ذات.سعة = سعة
        ذات.رأس = 0
        ذات.حجم = 0

    دالة ادخل_امام(ذات, س):
        لو ذات.حجم == ذات.سعة:
            ارجع خطأ
        ذات.رأس = (ذات.رأس - 1) % ذات.سعة
        ذات.بيانات[ذات.رأس] = س
        ذات.حجم = ذات.حجم + 1
        ارجع صواب

    دالة ادخل_خلف(ذات, س):
        لو ذات.حجم == ذات.سعة:
            ارجع خطأ
        ذات.بيانات[(ذات.رأس + ذات.حجم) % ذات.سعة] = س
        ذات.حجم = ذات.حجم + 1
        ارجع صواب

    دالة احذف_خلف(ذات):
        لو ذات.حجم == 0:
            ارجع خطأ
        ذات.حجم = ذات.حجم - 1
        ارجع صواب

    دالة امام(ذات):
        ارجع ذات.بيانات[ذات.رأس]

    دالة خلف(ذات):
        ارجع ذات.بيانات[(ذات.رأس + ذات.حجم - 1) % ذات.سعة]

د = مزدوج_دائري(3)
تأكد_يساوي(د.ادخل_خلف(1), صواب, "إدخال خلفي أول")
تأكد_يساوي(د.ادخل_خلف(2), صواب, "إدخال خلفي ثان")
تأكد_يساوي(د.ادخل_امام(3), صواب, "إدخال أمامي")
تأكد_يساوي(د.ادخل_امام(4), خطأ, "ممتلئ")
تأكد_يساوي(د.خلف(), 2, "الخلف")
تأكد_يساوي(د.احذف_خلف(), صواب, "حذف الخلف")
تأكد_يساوي(د.ادخل_امام(4), صواب, "بعد الحذف")
تأكد_يساوي(د.امام(), 4, "الأمام")
تأكد_يساوي(د.خلف(), 1, "الخلف الجديد")
