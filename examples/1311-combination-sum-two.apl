# مثال 1311 — مجموع التركيبات ٢
# Combination sum II no reuse
# Demonstrates: رجوع
#
# Run:  python apl.py examples/1311-combination-sum-two.apl

# نرتب القائمة ونتخطى القيم المكررة في نفس المستوى
# وكل عنصر يستعمل مرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تركيبات(أ, هدف):
  ق = مفرز(أ)
  ناتج = []
  مكدس = [[0, [], 0]]
  طالما طول(مكدس) > 0:
    ح = مكدس.pop()
    بداية = ح[0]
    مسار = ح[1]
    مج = ح[2]
    لو مج == هدف:
      لو مسار ليس في ناتج:
        ناتج.ألحق(مسار)
    لو مج < هدف:
      لكل ع في نطاق(بداية, طول(ق)):
        لو مج + ق[ع] <= هدف:
          مكدس.ألحق([ع + 1, مسار + [ق[ع]], مج + ق[ع]])
  ارجع مفرز(ناتج)

تأكد_يساوي(تركيبات([10,1,2,7,6,1,5], 8), [[1,1,6],[1,2,5],[1,7],[2,6]], "مثال أول")
تأكد_يساوي(تركيبات([2,5,2,1,2], 5), [[1,2,2],[5]], "مثال ثان")
تأكد_يساوي(تركيبات([3], 5), [], "لا حل")
