# مثال 4227 — قوة 32 بالحلقة
# Power of 32 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4227-nth-power-of-32-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 32
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 32, "حالة 2")
تأكد_يساوي(ف(3), 32768, "حالة 3")
تأكد_يساوي(ف(6), 1073741824, "حالة 4")
تأكد_يساوي(ف(10), 1125899906842624, "حالة 5")
