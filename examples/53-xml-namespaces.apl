# مثال 53 — مساحات الأسماء والتحليل التدريجي والباني
# Namespaces, Pull Parsing, TreeBuilder & Canonical Output
# Demonstrates: سجل_مساحة_أسماء, مساحة_أسماء, محلل_سحب, أحداث, غذِّ_المحلل,
#               اقرأ_الأحداث, باني_الشجرة, ابدأ_وسم, غذِّ_نص, أنهِ_وسم,
#               شجرة_إكس_إم_إل, إكس_إم_إل_قياسي, تحقق_من_عنصر, عنصر_بالمعرف
#
# Run:  python apl.py examples/53-xml-namespaces.apl

المتغير المساحة = "http://example.com/library"

# ---------- 1) مساحات الأسماء ----------
اطبع "=== مساحات الأسماء ==="
سجل_مساحة_أسماء("مكتبة", المساحة)

المتغير المستند = """<مكتبة:مكتبة xmlns:مكتبة="http://example.com/library">
    <مكتبة:كتاب مكتبة:الرقم="1">
        <مكتبة:العنوان>الأيام</مكتبة:العنوان>
    </مكتبة:كتاب>
    <مكتبة:كتاب مكتبة:الرقم="2">
        <مكتبة:العنوان>الفيزياء الحديثة</مكتبة:العنوان>
    </مكتبة:كتاب>
</مكتبة:مكتبة>"""

المتغير الجذر = إكس_إم_إل_من_نص(المستند)
اطبع "اسم الجذر الكامل: " + الجذر.اسم_العنصر
اطبع "مساحة الجذر: " + مساحة_أسماء(الجذر.اسم_العنصر)
اطبع "عدد الكتب: " + نص(عد_العناصر(الجذر))
اطبع ""

اطبع "--- العناوين (بحث بمساحة أسماء) ---"
المتغير سجل_البادئات = {"م": المساحة}
المتغير العناوين = الجذر.ابحث_الكل(".//م:العنوان", سجل_البادئات)
لكل عنوان في العناوين:
    اطبع "  • " + عنوان.نص_العنصر

اطبع ""
اطبع "--- أرقام الكتب (خصائص مؤهلة) ---"
لكل كتاب في أبناء_مباشرون(الجذر):
    اطبع "  الرقم: " + اقرأ_خاصية(كتاب, "{" + المساحة + "}الرقم")
اطبع ""

# ---------- 2) التحليل التدريجي (Pull Parsing) ----------
اطبع "=== التحليل التدريجي ==="
المتغير محلل = محلل_سحب(أحداث = [حدث_بداية])
محلل.غذِّ_المحلل("<مذكرة>")
محلل.غذِّ_المحلل("<بند الحالة='جديد'>")
محلل.غذِّ_المحلل("شراء كتب")
محلل.غذِّ_المحلل("</بند></مذكرة>")
المتغير الأحداث = محلل.اقرأ_الأحداث()
لكل زوج في الأحداث:
    اطبع "  حدث: " + زوج[0] + " ← الوسم: " + زوج[1].اسم_العنصر
محلل.أغلق_المحلل()
اطبع ""

# ---------- 3) بناء شجرة يدوياً عبر الباني ----------
اطبع "=== الباني (TreeBuilder) ==="
المتغير باني = باني_الشجرة()
باني.ابدأ_وسم("مذكرة", {})
باني.ابدأ_وسم("بند", {"الحالة": "جديد"})
باني.غذِّ_نص("مرحباً بالعالم")
باني.أنهِ_وسم("بند")
باني.أنهِ_وسم("مذكرة")
المتغير الشجرة = شجرة_إكس_إم_إل(باني.أغلق_الشجرة())
المتغير جذر_المذكرة = الشجرة.جذر_الشجرة()
اطبع "النتيجة: " + إكس_إم_إل_إلى_نص(جذر_المذكرة)
اطبع ""

# ---------- 4) أدوات الفحص ----------
اطبع "=== أدوات الفحص ==="
اطبع "صياغة صحيحة؟ " + نص(تحقق_من_عنصر("<جذر><ابن/></جذر>"))
اطبع "صياغة خاطئة؟ " + نص(تحقق_من_عنصر("<جذر><ابن></جذر>"))
اطبع ""

# ---------- 5) البحث بالمعرف وشروط XPath ----------
اطبع "=== البحث بالمعرف والشروط ==="
المتغير نص_المخزون = "<مخزون><صنف id='قلم' سعر='2'/><صنف id='دفتر' سعر='15'/><صنف id='ممحاة' سعر='5'/></مخزون>"
المتغير مخزون = إكس_إم_إل_من_نص(نص_المخزون)
اطبع "عدد الأصناف: " + نص(عد_العناصر(مخزون, "صنف"))
اطبع "الأبناء المباشرون: " + نص(طول(أبناء_مباشرون(مخزون)))

المتغير دفتر = عنصر_بالمعرف(مخزون, "دفتر")
اطبع "الصنف دفتر: سعره " + اقرأ_خاصية(دفتر, "سعر")

المتغير الغالي = تجد_الكل(مخزون, "صنف[@سعر='15']")
اطبع "أغلى صنف: " + اقرأ_خاصية(الغالي[0], "id")
اطبع ""

# ---------- 6) الصيغة الحرة (بدون نقطة) ----------
اطبع "=== الصيغة الحرة للتعديل ==="
المتغير ملاحظة = عنصر_جديد("ملاحظة")
غذِّ_نص_العنصر(ملاحظة, "نص الملاحظة")
غذِّ_ذيل_العنصر(ملاحظة, "  ")
اطبع "العنصر الجديد: " + إكس_إم_إل_إلى_نص(ملاحظة)
تضيف(مخزون, ملاحظة)
اطبع "بعد الإضافة: " + نص(طول(أبناء_مباشرون(مخزون))) + " أبناء"
تحذف(مخزون, ملاحظة)
اطبع "بعد الحذف: " + نص(طول(أبناء_مباشرون(مخزون))) + " أبناء"
اطبع ""

# ---------- 7) الإخراج القياسي ----------
اطبع "=== الإخراج القياسي ==="
اطبع "قياسي: " + إكس_إم_إل_قياسي("<مخزون  ><صنف سعر='2' id='قلم' /></مخزون>")
اطبع ""
اطبع "تم."
