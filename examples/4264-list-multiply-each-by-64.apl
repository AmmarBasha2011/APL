# مثال 4264 — ضرب كل عنصر في 64
# Multiply each item by 64
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4264-list-multiply-each-by-64.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 64]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [192, 64, 128], "حالة 1")
تأكد_يساوي(ف([5]), [320], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [64, 128, 192, 256, 320, 384], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-128, 0, 448, 448, 256], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [640, 1280, 640, 1920, 1280, 640], "حالة 5")
