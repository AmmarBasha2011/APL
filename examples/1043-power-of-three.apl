# مثال 1043 — قوة العدد ثلاثة
# Power of three check
# Demonstrates: قسمة متكررة
#
# Run:  python apl.py examples/1043-power-of-three.apl

# نقسم على ثلاثة ما دام العدد يقبل القسمة
# فلو وصلنا إلى واحد فهو قوة للثلاثة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة_ثلاثة(ن):
  لو ن < 1:
    ارجع خطأ
  طالما ن % 3 == 0:
    ن = ن // 3
  ارجع ن == 1

تأكد_يساوي(قوة_ثلاثة(27), صواب, "سبعة وعشرون")
تأكد_يساوي(قوة_ثلاثة(0), خطأ, "صفر")
تأكد_يساوي(قوة_ثلاثة(9), صواب, "تسعة")
تأكد_يساوي(قوة_ثلاثة(45), خطأ, "خمسة وأربعون")
تأكد_يساوي(قوة_ثلاثة(1), صواب, "واحد")
