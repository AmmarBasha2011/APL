# مثال 274 — تدوير المصفوفة
# Array rotation
# Demonstrates: تدوير يمين بخطوات
#
# Run:  python apl.py examples/274-rotate-array.apl

دالة دور(قائمة, خطوات):
    المتغير ن = طول(قائمة)
    خطوات = خطوات % ن
    ارجع قائمة[ن - خطوات:] + قائمة[0:ن - خطوات]

اطبع دور([1, 2, 3, 4, 5, 6, 7], 3)
اطبع دور([1, 2, 3], 4)
اطبع دور([10, 20], 0)
