# مثال 4084 — مجموع أرقام 59 أس ن
# Digit sum of 59 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4084-digit-sum-of-59-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 59 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 14, "حالة 2")
تأكد_يساوي(ف(5), 47, "حالة 3")
تأكد_يساوي(ف(10), 49, "حالة 4")
تأكد_يساوي(ف(20), 151, "حالة 5")
