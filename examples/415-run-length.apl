# مثال 415 — ترميز طول التسلسل
# Run-length encoding
# Demonstrates: ضغط وفك
#
# Run:  python apl.py examples/415-run-length.apl

دالة اضغط(نص_الدخل):
    المتغير ناتج = ""
    المتغير ي = 0
    طالما ي < طول(نص_الدخل):
        المتغير عد = 1
        طالما ي + عد < طول(نص_الدخل) و نص_الدخل[ي + عد] == نص_الدخل[ي]:
            عد = عد + 1
        ناتج = ناتج + نص(عد) + نص_الدخل[ي]
        ي = ي + عد
    ارجع ناتج

دالة افكك(مكبوس):
    المتغير ناتج = ""
    المتغير ي = 0
    طالما ي < طول(مكبوس):
        المتغير عدد = صحيح(مكبوس[ي])
        المتغير حرف = مكبوس[ي + 1]
        لكل _ في نطاق(عدد):
            ناتج = ناتج + حرف
        ي = ي + 2
    ارجع ناتج

المتغير م = اضغط("aaabbbbcddddd")
اطبع "مكبوس:", م
اطبع "مفكوك:", افكك(م)
