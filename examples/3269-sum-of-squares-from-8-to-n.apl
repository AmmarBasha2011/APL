# مثال 3269 — مجموع المربعات من 8 إلى ن
# Sum of squares from 8
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3269-sum-of-squares-from-8-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(8, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(8), 64, "حالة 1")
تأكد_يساوي(ف(9), 145, "حالة 2")
تأكد_يساوي(ف(18), 1969, "حالة 3")
تأكد_يساوي(ف(100), 338210, "حالة 4")
