# مثال 1742 — كمية الماء المحبوس
# Trapping rain water
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1742-trapping-rain-water-total.apl

# أعلى جدار يساراً ويميناً
# الماء الأقل منهما ناقص العمود

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ماء_محبوس(ع):
  ن = طول(ع)
  لو ن == 0:
    ارجع 0
  يسار = []
  يمين = []
  لكل ك في نطاق(ن):
    يسار.append(0)
    يمين.append(0)
  يسار[0] = ع[0]
  لكل ك في نطاق(1, ن):
    يسار[ك] = أكبر(يسار[ك - 1], ع[ك])
  يمين[ن - 1] = ع[ن - 1]
  لكل ك في نطاق(ن - 2, -1, -1):
    يمين[ك] = أكبر(يمين[ك + 1], ع[ك])
  مجموع = 0
  لكل ك في نطاق(ن):
    مجموع = مجموع + أصغر(يسار[ك], يمين[ك]) - ع[ك]
  ارجع مجموع

تأكد_يساوي(ماء_محبوس([0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]), 6, "كلاسيكي")
تأكد_يساوي(ماء_محبوس([3, 0, 3]), 3, "حفرة")
تأكد_يساوي(ماء_محبوس([1, 2, 3]), 0, "صاعدة")
