# مثال 1186 — تقييم الصيغة العكسية
# Evaluate reverse polish notation
# Demonstrates: مكدس
#
# Run:  python apl.py examples/1186-evaluate-rpn.apl

# الأرقام تدخل المكدس
# والعملية تأخذ آخر رقمين وتدفع الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قيّم(رموز):
  مكدس = []
  لكل ر في رموز:
    لو ر في ["+", "-", "*", "/"]:
      ب = مكدس.pop()
      أ = مكدس.pop()
      لو ر == "+":
        مكدس.ألحق(أ + ب)
      والا_لو ر == "-":
        مكدس.ألحق(أ - ب)
      والا_لو ر == "*":
        مكدس.ألحق(أ * ب)
      والا:
        مكدس.ألحق(صحيح(أ / ب))
    والا:
      مكدس.ألحق(صحيح(ر))
  ارجع مكدس[0]

تأكد_يساوي(قيّم(["2","1","+","3","*"]), 9, "مثال أول")
تأكد_يساوي(قيّم(["4","13","5","/","+"]), 6, "قسمة")
تأكد_يساوي(قيّم(["10","6","9","3","+","-11","*","/","*","17","+","5","+"]), 22, "طويل")
تأكد_يساوي(قيّم(["7"]), 7, "رقم واحد")
