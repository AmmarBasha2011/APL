# مثال 1844 — فرز بالقيمة المطلقة
# Sort by absolute value
# Demonstrates: فرز
#
# Run:  python apl.py examples/1844-sort-by-absolute-value-stable.apl

# نبني مفتاحاً من القيمة المطلقة
# نعيد القيم الأصلية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مطلق(ن):
  لو ن < 0:
    ارجع -ن
  ارجع ن

دالة افرز_مطلق(ق):
  أزواج = []
  لكل ع في ق:
    أزواج.append([مطلق(ع), ع])
  أزواج.sort()
  ناتج = []
  لكل ز في أزواج:
    ناتج.append(ز[1])
  ارجع ناتج

تأكد_يساوي(افرز_مطلق([-4, 1, -2, 3]), [1, -2, 3, -4], "مختلط")
تأكد_يساوي(افرز_مطلق([2, -2]), [-2, 2], "تعادل")
تأكد_يساوي(افرز_مطلق([]), [], "فارغة")
