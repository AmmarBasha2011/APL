# مثال 981 — السبلين التكعيبي
# Cubic spline
# Demonstrates: ثلاثي القطر بتوماس
#
# Run:  python apl.py examples/981-cubic-spline.apl

# السبلين التكعيبي الطبيعي: منحنى أملس يمر بالنقاط بمشتقتين متصلتين
# حل نظام ثلاثي القطر بخوارزمية توماس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حل_ثلاثي(أ, ب, ج, د, ن):
  ب2 = []
  د2 = []
  لكل i في نطاق(ن):
    ب2.ألحق(ب[i])
    د2.ألحق(د[i])
  لكل i في نطاق(1, ن):
    وزن = أ[i] / ب2[i - 1]
    ب2[i] = ب2[i] - (وزن * ج[i - 1])
    د2[i] = د2[i] - (وزن * د2[i - 1])
  م = []
  لكل i في نطاق(ن):
    م.ألحق(0)
  م[ن - 1] = د2[ن - 1] / ب2[ن - 1]
  لكل i في نطاق(ن - 2, -1, -1):
    م[i] = (د2[i] - (ج[i] * م[i + 1])) / ب2[i]
  ارجع م

نقاط_س = [0, 1, 2, 3]
نقاط_ص = [0, 1, 0, 1]
ن = 4
ح = []
لكل i في نطاق(ن - 1):
  ح.ألحق(نقاط_س[i + 1] - نقاط_س[i])
أ = [0, 0, 0, 0]
ب = [1, 0, 0, 1]
ج = [0, 0, 0, 0]
د = [0, 0, 0, 0]
لكل i في نطاق(1, ن - 1):
  أ[i] = ح[i - 1]
  ب[i] = 2 * (ح[i - 1] + ح[i])
  ج[i] = ح[i]
  د[i] = 6 * (((نقاط_ص[i + 1] - نقاط_ص[i]) / ح[i]) - ((نقاط_ص[i] - نقاط_ص[i - 1]) / ح[i - 1]))

م = حل_ثلاثي(أ, ب, ج, د, ن)

دالة قيم(س):
  i = 0
  طالما (i < (ن - 2)) و (س > نقاط_س[i + 1]):
    i = i + 1
  عرض = نقاط_س[i + 1] - نقاط_س[i]
  آ = (نقاط_س[i + 1] - س) / عرض
  بق = (س - نقاط_س[i]) / عرض
  حد1 = (آ * نقاط_ص[i]) + (بق * نقاط_ص[i + 1])
  حد2 = ((((آ * آ * آ) - آ) * م[i]) + (((بق * بق * بق) - بق) * م[i + 1])) * عرض * عرض / 6
  ارجع حد1 + حد2

تأكد_يساوي(مقرب(م[0], 6), 0, "طبيعي عند الطرف")
تأكد_يساوي(مقرب(م[1], 6), -4, "الانحناء الأول")
تأكد_يساوي(مقرب(م[2], 6), 4, "الانحناء الثاني")
تأكد_يساوي(مقرب(قيم(0.5), 6), 0.75, "تقييم عند النصف")
تأكد_يساوي(مقرب(قيم(1.5), 6), 0.5, "تقييم عند الواحد ونصف")
تأكد_يساوي(مقرب(قيم(2), 6), 0, "يمر بالنقاط")
