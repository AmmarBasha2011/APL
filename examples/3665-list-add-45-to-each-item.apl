# مثال 3665 — إضافة 45 لكل عنصر
# Add 45 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3665-list-add-45-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 45]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [48, 46, 47], "حالة 1")
تأكد_يساوي(ف([5]), [50], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [46, 47, 48, 49, 50, 51], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [43, 45, 52, 52, 49], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [55, 65, 55, 75, 65, 55], "حالة 5")
