# مثال 334 — أسابيع بين تاريخين
# Weeks between dates
# Demonstrates: فرق مقسم
#
# Run:  python apl.py examples/334-weeks-between.apl

المتغير بداية_العام = تاريخ(2026, 1, 1)
المتغير اليوم = التاريخ_اليوم()
المتغير أيام = (اليوم - بداية_العام).days
اطبع "من بداية 2026:", أيام, "يوما"
اطبع "أي", أيام // 7, "أسبوعا و", أيام % 7, "أيام"

المتغير حدث = تاريخ(2027, 6, 1)
المتغير فرق = (حدث - اليوم).days
اطبع "حتى يونيو 2027:", فرق // 7, "أسبوعا"
