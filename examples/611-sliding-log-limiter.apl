# مثال 611 — تحديد معدل بسجل منزلق
# Sliding log rate limiter
# Demonstrates: معدل، سجل منزلق، طوابع
#
# Run:  python apl.py examples/611-sliding-log-limiter.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحديد المعدل بسجل منزلق: ن طلبات في نافذة زمنية
# Demonstrates: طوابع زمنية, إسقاط القديم, قرار سماح
# أدق من النافذة الثابتة لأنه يتذكر كل طلب

دالة أنشئ_محدد(سقف, نافذة):
  ارجع {"سقف": سقف, "نافذة": نافذة, "طوابع": []}

دالة اسمح(م, الآن):
  قديم = الآن - م["نافذة"]
  جديدة = []
  لكل ط في م["طوابع"]:
    لو ط > قديم:
      جديدة.append(ط)
  م["طوابع"] = جديدة
  لو طول(م["طوابع"]) < م["سقف"]:
    م["طوابع"].append(الآن)
    ارجع صواب
  ارجع خطأ

م = أنشئ_محدد(3, 10)
تأكد_يساوي(اسمح(م, 0), صواب, "طلب 1")
تأكد_يساوي(اسمح(م, 1), صواب, "طلب 2")
تأكد_يساوي(اسمح(م, 2), صواب, "طلب 3")
تأكد_يساوي(اسمح(م, 3), خطأ, "طلب 4 مرفوض")
تأكد_يساوي(اسمح(م, 10), صواب, "سقوط أول طلب يسمح")
تأكد_يساوي(اسمح(م, 10), خطأ, "الثالثة في النافذة مرفوضة")
اطبع "طوابع مسجلة:", م["طوابع"]
