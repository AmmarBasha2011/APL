# مثال 3247 — مساحة دائرة بتقريب 17
# Circle area with pi approx 17/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3247-square-of-radius-times-17-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 17 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(7), 119, "حالة 3")
تأكد_يساوي(ف(14), 476, "حالة 4")
تأكد_يساوي(ف(21), 1071, "حالة 5")
