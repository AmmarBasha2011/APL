# مثال 695 — شريحة كاتمول-روم
# Catmull-Rom spline
# Demonstrates: استيفاء هرمايت، توتر، مقاطع
#
# Run:  python apl.py examples/695-catmull-rom.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شريحة كاتمول-روم: منحنى يمر بكل نقاط التحكم
# Demonstrates: استيفاء هرمايت, توتر نصف, مقطع بين نقطتين
# على عكس بيزييه، المنحنى يمر فعلا بالنقاط

دالة كاتمول(ن0, ن1, ن2, ن3, ت):
  ت2 = ت * ت
  ت3 = ت2 * ت
  س = 0.5 * ((2 * ن1[0]) + (ن2[0] - ن0[0]) * ت + (2 * ن0[0] - 5 * ن1[0] + 4 * ن2[0] - ن3[0]) * ت2 + (3 * ن1[0] - ن0[0] - 3 * ن2[0] + ن3[0]) * ت3)
  ع = 0.5 * ((2 * ن1[1]) + (ن2[1] - ن0[1]) * ت + (2 * ن0[1] - 5 * ن1[1] + 4 * ن2[1] - ن3[1]) * ت2 + (3 * ن1[1] - ن0[1] - 3 * ن2[1] + ن3[1]) * ت3)
  ارجع [س, ع]

نقاط = [[0, 0], [1, 1], [2, 1], [3, 0]]
تأكد_يساوي(كاتمول(نقاط[0], نقاط[1], نقاط[2], نقاط[3], 0.0), [1.0, 1.0], "يبدأ من ن1")
تأكد_يساوي(كاتمول(نقاط[0], نقاط[1], نقاط[2], نقاط[3], 1.0), [2.0, 1.0], "ينتهي عند ن2")
منتصف = كاتمول(نقاط[0], نقاط[1], نقاط[2], نقاط[3], 0.5)
تأكد_يساوي(منتصف, [1.5, 1.125], "المنتصف أعلى من الوتر")
مسار = []
لكل ي في نطاق(5):
  مسار.append(كاتمول(نقاط[0], نقاط[1], نقاط[2], نقاط[3], ي / 4.0))
تأكد_يساوي(مسار[4], [2.0, 1.0], "آخر عينة عند ن2")
تأكد_يساوي(مسار[0][1] < مسار[2][1], صواب, "المنحنى ينتفخ للأعلى")
اطبع "المنتصف:", منتصف
