# مثال 3468 — إضافة 44 لكل عنصر
# Add 44 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3468-list-add-44-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 44]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [47, 45, 46], "حالة 1")
تأكد_يساوي(ف([5]), [49], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [45, 46, 47, 48, 49, 50], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [42, 44, 51, 51, 48], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [54, 64, 54, 74, 64, 54], "حالة 5")
