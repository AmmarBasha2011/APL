# مثال 2077 — نمط رقعة الشطرنج النصي
# Checkerboard text pattern
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2077-checkerboard-text-pattern-rows.apl

# # نبدأ الصف بنفس العلامة إذا كان رقمه زوجيا
# # ونعكس في الصف الفردي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رقعة(ن):
  خرج = []
  لكل ي في نطاق(ن):
    صف = ""
    لكل ك في نطاق(ن):
      لو (ي + ك) % 2 == 0:
        صف = صف + "#"
      والا:
        صف = صف + "."
    خرج = خرج + [صف]
  ارجع خرج

تأكد_يساوي(رقعة(3), ["#.#", ".#.", "#.#"], "٣")
تأكد_يساوي(رقعة(1), ["#"], "١")
تأكد_يساوي(رقعة(0), [], "صفر")
