# مثال 639 — جدولة بالتناوب الدائري
# Round robin scheduling
# Demonstrates: كم زمني، طابور جاهز، انتظار
#
# Run:  python apl.py examples/639-round-robin.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# جدولة المعالج بالتناوب الدائري (Round Robin)
# Demonstrates: كم زمني, طابور جاهز, أزمنة انتظار واستدارة
# كل عملية تأخذ حصتها ثم تعود لآخر الطابور

دالة جدول(عمليات, كم):
  جاهز = []
  لكل ي في نطاق(طول(عمليات)):
    جاهز.append([ي, عمليات[ي]])
  متبقي = عمليات.copy()
  انتظار = [0] * طول(عمليات)
  انتهاء = [0] * طول(عمليات)
  زمن = 0
  طالما طول(جاهز) > 0:
    حالي = جاهز.pop(0)
    ي = حالي[0]
    تنفيذ = أصغر(كم, متبقي[ي])
    لكل ج في نطاق(طول(عمليات)):
      لو ج != ي و متبقي[ج] > 0 و انتهاء[ج] == 0:
        انتظار[ج] = انتظار[ج] + تنفيذ
    زمن = زمن + تنفيذ
    متبقي[ي] = متبقي[ي] - تنفيذ
    لو متبقي[ي] > 0:
      جاهز.append([ي, متبقي[ي]])
    والا:
      انتهاء[ي] = زمن
  ارجع [انتظار, انتهاء]

نتيجة = جدول([10, 4, 6], 3)
اطبع "انتظار:", نتيجة[0], " انتهاء:", نتيجة[1]
تأكد_يساوي(نتيجة[1], [20, 13, 16], "أزمنة الانتهاء")
تأكد_يساوي(نتيجة[0], [10, 9, 10], "أزمنة الانتظار (الانتهاء ناقص التنفيذ)")
