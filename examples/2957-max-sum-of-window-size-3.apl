# مثال 2957 — أكبر مجموع لنافذة بحجم 3
# Max window sum size 3
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2957-max-sum-of-window-size-3.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ك = sum(ق[:3])
  لكل ي في نطاق(طول(ق) - 3 + 1):
    م = sum(ق[ي:ي + 3])
    لو م > ك:
      ك = م
  ارجع ك

تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 15, "حالة 1")
تأكد_يساوي(ف([5, 1, 5, 1, 5, 1, 9]), 15, "حالة 2")
تأكد_يساوي(ف([3, 3, 3, 3]), 9, "حالة 3")
تأكد_يساوي(ف([-1, 2, -3, 4, 5, 6]), 15, "حالة 4")
