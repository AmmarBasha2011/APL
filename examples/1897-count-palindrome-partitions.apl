# مثال 1897 — عدد تقسيمات النص لمتماثلات
# Count palindrome partitions
# Demonstrates: تراجع
#
# Run:  python apl.py examples/1897-count-palindrome-partitions.apl

# نجرب كل بداية جزء
# نكمل الباقي بالتراجع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متماثل(س):
  لكل ك في نطاق(طول(س) // 2):
    لو س[ك] != س[طول(س) - 1 - ك]:
      ارجع خطأ
  ارجع صواب

دالة تقسيمات(س):
  لو طول(س) == 0:
    ارجع 1
  عد = 0
  لكل ك في نطاق(1, طول(س) + 1):
    لو متماثل(س[0:ك]):
      عد = عد + تقسيمات(س[ك:طول(س)])
  ارجع عد

تأكد_يساوي(تقسيمات("aab"), 2, "aab")
تأكد_يساوي(تقسيمات("aaa"), 4, "aaa")
تأكد_يساوي(تقسيمات("abc"), 1, "abc")
