# مثال 1647 — العدد المستطيلي
# Pronic number check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1647-pronic-number-check.apl

# نجرب ك حتى يزيد ك×(ك+1) عن العدد
# إن ساواه فهو مستطيلي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مستطيلي(ن):
  ك = 0
  طالما ك * (ك + 1) < ن:
    ك = ك + 1
  ارجع ك * (ك + 1) == ن

تأكد_يساوي(مستطيلي(0), صواب, "صفر")
تأكد_يساوي(مستطيلي(12), صواب, "اثنا عشر")
تأكد_يساوي(مستطيلي(20), صواب, "عشرون")
تأكد_يساوي(مستطيلي(15), خطأ, "خمسة عشر")
