# مثال 1985 — حجم الملف بوحدة مقروءة
# Human readable file size
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1985-file-size-human-readable-units.apl

# # الوحدات B وKB وMB وGB
# # نقرب إلى منزلة عشرية واحدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حجم(ب):
  وحدات = ["B", "KB", "MB", "GB"]
  ق = ب
  ك = 0
  طالما ق >= 1024 و ك < 3:
    ق = ق / 1024
    ك = ك + 1
  لو ك == 0:
    ارجع نص(ب) + " B"
  ارجع نص(round(ق, 1)) + " " + وحدات[ك]

تأكد_يساوي(حجم(512), "512 B", "بايت")
تأكد_يساوي(حجم(1536), "1.5 KB", "كيلو")
تأكد_يساوي(حجم(1048576), "1.0 MB", "ميجا")
تأكد_يساوي(حجم(5 * 1024 ** 3), "5.0 GB", "جيجا")
