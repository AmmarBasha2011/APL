# مثال 467 — قارئ ملفات البيئة
# .env parser
# Demonstrates: متغيرات بيئة من ملف
#
# Run:  python apl.py examples/467-env-parser.apl

اكتب("/tmp/apl-467.env", "APP_NAME=MyApp\nDEBUG=true\nPORT=3000\n# تعليق")

المتغير بيئة = {}
المتغير سطور = اقرأ("/tmp/apl-467.env").تقليم().تقسيم("\n")
لكل سطر في سطور:
    لو سطر != "" و سطر.بداية("#") == خطأ:
        المتغير أجزاء = سطر.تقسيم("=")
        بيئة[أجزاء[0]] = أجزاء[1]

اطبع "المنفذ:", بيئة["PORT"]
اطبع "التصحيح:", بيئة["DEBUG"]
احذف_ملف("/tmp/apl-467.env")
