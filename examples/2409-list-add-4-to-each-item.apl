# مثال 2409 — إضافة 4 لكل عنصر
# Add 4 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2409-list-add-4-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 4]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [7, 5, 6], "حالة 1")
تأكد_يساوي(ف([5]), [9], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [5, 6, 7, 8, 9, 10], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [2, 4, 11, 11, 8], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [14, 24, 14, 34, 24, 14], "حالة 5")
