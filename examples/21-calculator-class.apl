# مثال 21 — آلة حاسبة كصنف
# Calculator as a Class
# Demonstrates: OOP, static state, operator overloading via methods
#
# Run:  python apl.py examples/21-calculator-class.apl

صنف آلة_حاسبة:
    دالة_إنشاء(ذات, دقيقة=2):
        ذات.سجل = []
        ذات.دقة = دقيقة

    دالة إضافة(ذات, أ, ب):
        نتيجة = أ + ب
        ذات.سجل.ألحق("(" + نص(أ) + " + " + نص(ب) + ") = " + نص(نتيجة))
        ارجع نتيجة

    دالة طرح(ذات, أ, ب):
        ارجع أ - ب

    دالة ضرب(ذات, أ, ب):
        ارجع أ * ب

    دالة قسمة(ذات, أ, ب):
        إذا ب == 0:
            ارجع "خطأ: قسمة على صفر"
        ارجع مقرب(أ / ب, ذات.دقة)

    دالة عرضالسجل(ذات):
        ارجع "عدد العمليات: " + نص(طول(ذات.سجل))

المتغير حاسبة = آلة_حاسبة(3)

اطبع "=== آلة حاسبة كصنف ==="
اطبع "6 + 4 = " + نص(حاسبة.إضافة(6, 4))
اطبع "9 - 2 = " + نص(حاسبة.طرح(9, 2))
اطبع "7 × 8 = " + نص(حاسبة.ضرب(7, 8))
اطبع "10 / 4 = " + نص(حاسبة.قسمة(10, 4))
اطبع "10 / 0 = " + نص(حاسبة.قسمة(10, 0))
اطبع ""
حاسبة.إضافة(100, 1)
حاسبة.إضافة(200, 2)
اطبع حاسبة.عرضالسجل()
