# مثال 2644 — ملء الأصفار لعرض 9
# Zero pad to width 9
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2644-pad-number-with-zeros-to-width-9.apl

# # ندخل القيمة
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع نص(ن).zfill(9)

تأكد_يساوي(ف(7), "000000007", "حالة 1")
تأكد_يساوي(ف(42), "000000042", "حالة 2")
تأكد_يساوي(ف(123), "000000123", "حالة 3")
تأكد_يساوي(ف(99999), "000099999", "حالة 4")
