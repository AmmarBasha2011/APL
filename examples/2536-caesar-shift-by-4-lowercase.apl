# مثال 2536 — قيصر بإزاحة 4
# Caesar shift 4
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2536-caesar-shift-by-4-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 4) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "efg", "حالة 1")
تأكد_يساوي(ف("xyz"), "bcd", "حالة 2")
تأكد_يساوي(ف("hello world"), "lipps asvph", "حالة 3")
تأكد_يساوي(ف("a1"), "e1", "حالة 4")
