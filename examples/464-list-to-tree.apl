# مثال 464 — بناء شجرة من قائمة مسطحة
# Flat list to tree
# Demonstrates: عناصر بآباء
#
# Run:  python apl.py examples/464-list-to-tree.apl

المتغير عناصر = [
    {"م": 1, "أب": 0, "اسم": "جذر"},
    {"م": 2, "أب": 1, "اسم": "فرع أ"},
    {"م": 3, "أب": 1, "اسم": "فرع ب"},
    {"م": 4, "أب": 2, "اسم": "ورقة"}
]

دالة اطبع_شجرة(عناصر, أب, مسافة):
    لكل عنصر في عناصر:
        لو عنصر["أب"] == أب:
            اطبع مسافة + عنصر["اسم"]
            اطبع_شجرة(عناصر, عنصر["م"], مسافة + "  ")

اطبع_شجرة(عناصر, 0, "")
