# مثال 220 — القائمة المترابطة المزدوجة
# Doubly linked list
# Demonstrates: عقد باتجاهين، جولة أمامية وخلفية
#
# Run:  python apl.py examples/220-doubly-linked.apl

صنف عقدة:
    دالة_إنشاء(ذات, قيمة):
        ذات.قيمة = قيمة
        ذات.التالي = لا_شيء
        ذات.السابق = لا_شيء

صنف قائمة_مزدوجة:
    دالة_إنشاء(ذات):
        ذات.رأس = لا_شيء
        ذات.ذيل = لا_شيء

    دالة أضف_نهاية(ذات, قيمة):
        المتغير جديدة = عقدة(قيمة)
        لو ذات.ذيل == لا_شيء:
            ذات.رأس = جديدة
            ذات.ذيل = جديدة
            ارجع
        ذات.ذيل.التالي = جديدة
        جديدة.السابق = ذات.ذيل
        ذات.ذيل = جديدة

    دالة أمامية(ذات):
        المتغير عناصر = []
        المتغير حالي = ذات.رأس
        طالما حالي != لا_شيء:
            عناصر.أضف(حالي.قيمة)
            حالي = حالي.التالي
        ارجع عناصر

    دالة خلفية(ذات):
        المتغير عناصر = []
        المتغير حالي = ذات.ذيل
        طالما حالي != لا_شيء:
            عناصر.أضف(حالي.قيمة)
            حالي = حالي.السابق
        ارجع عناصر

المتغير ق = قائمة_مزدوجة()
ق.أضف_نهاية(1)
ق.أضف_نهاية(2)
ق.أضف_نهاية(3)
اطبع "أمامية:", ق.أمامية()
اطبع "خلفية:", ق.خلفية()
