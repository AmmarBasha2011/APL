# مثال 4024 — قوة 22 بالحلقة
# Power of 22 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4024-nth-power-of-22-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 22
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 22, "حالة 2")
تأكد_يساوي(ف(3), 10648, "حالة 3")
تأكد_يساوي(ف(6), 113379904, "حالة 4")
تأكد_يساوي(ف(10), 26559922791424, "حالة 5")
