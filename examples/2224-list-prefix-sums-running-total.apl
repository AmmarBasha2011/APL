# مثال 2224 — المجاميع التراكمية
# Prefix sums
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2224-list-prefix-sums-running-total.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل ع في ق:
    م = م + ع
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [3, 4, 6], "حالة 1")
تأكد_يساوي(ف([5]), [5], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [1, 3, 6, 10, 15, 21], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-2, -2, 5, 12, 16], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [10, 30, 40, 70, 90, 100], "حالة 5")
