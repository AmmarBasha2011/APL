# مثال 2330 — مسافة هامينغ إلى abcde
# Hamming distance to abcde
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2330-hamming-distance-to-abcde.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ه = "abcde"
  ع = 0
  لكل ي في نطاق(5):
    لو ن[ي] != ه[ي]:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("abcde"), 0, "حالة 1")
تأكد_يساوي(ف("abcdx"), 1, "حالة 2")
تأكد_يساوي(ف("xxxxx"), 5, "حالة 3")
تأكد_يساوي(ف("aXcXe"), 2, "حالة 4")
