# مثال 2546 — ملء الأصفار لعرض 5
# Zero pad to width 5
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2546-pad-number-with-zeros-to-width-5.apl

# # ندخل القيمة
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع نص(ن).zfill(5)

تأكد_يساوي(ف(7), "00007", "حالة 1")
تأكد_يساوي(ف(42), "00042", "حالة 2")
تأكد_يساوي(ف(123), "00123", "حالة 3")
تأكد_يساوي(ف(99999), "99999", "حالة 4")
