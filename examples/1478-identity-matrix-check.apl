# مثال 1478 — هل المصفوفة وحدة
# Is it an identity matrix
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1478-identity-matrix-check.apl

# نفحص كل خانة
# نتوقف عند أول خانة مخالفة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة هي_وحدة(م):
  لكل ص في نطاق(طول(م)):
    لكل ع في نطاق(طول(م[ص])):
      متوقع = 0
      لو ص == ع:
        متوقع = 1
      لو م[ص][ع] != متوقع:
        ارجع خطأ
  ارجع صواب

تأكد_يساوي(هي_وحدة([[1, 0], [0, 1]]), صواب, "وحدة")
تأكد_يساوي(هي_وحدة([[1, 1], [0, 1]]), خطأ, "عنصر زائد")
تأكد_يساوي(هي_وحدة([[2, 0], [0, 2]]), خطأ, "ضعف الوحدة")
