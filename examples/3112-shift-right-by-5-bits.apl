# مثال 3112 — إزاحة يمين 5
# Shift right by 5
# Demonstrates: بتات
#
# Run:  python apl.py examples/3112-shift-right-by-5-bits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 5

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(16), 0, "حالة 2")
تأكد_يساوي(ف(255), 7, "حالة 3")
تأكد_يساوي(ف(1000), 31, "حالة 4")
تأكد_يساوي(ف(65535), 2047, "حالة 5")
