# مثال 1103 — طابور بمكدسين
# Queue using two stacks
# Demonstrates: نقل عند الحاجة
#
# Run:  python apl.py examples/1103-queue-two-stacks.apl

# الدفع في مكدس الإدخال
# وعند السحب نقلب مكدس الإدخال إلى مكدس الإخراج لو كان فارغاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف طابور_مكدسين:
    دالة_إنشاء(ذات):
        ذات.داخل = []
        ذات.خارج = []

    دالة ادفع(ذات, س):
        ذات.داخل.ألحق(س)

    دالة انقل(ذات):
        لو طول(ذات.خارج) == 0:
            طالما طول(ذات.داخل) > 0:
                ذات.خارج.ألحق(ذات.داخل.pop())

    دالة اسحب(ذات):
        ذات.انقل()
        ارجع ذات.خارج.pop()

    دالة اول(ذات):
        ذات.انقل()
        ارجع ذات.خارج[-1]

    دالة فارغ(ذات):
        ارجع (طول(ذات.داخل) + طول(ذات.خارج)) == 0

ط = طابور_مكدسين()
ط.ادفع(1)
ط.ادفع(2)
تأكد_يساوي(ط.اول(), 1, "الأول")
تأكد_يساوي(ط.اسحب(), 1, "سحب الأول")
ط.ادفع(3)
تأكد_يساوي(ط.فارغ(), خطأ, "ليس فارغاً")
تأكد_يساوي(ط.اسحب(), 2, "سحب الثاني")
تأكد_يساوي(ط.اسحب(), 3, "سحب الثالث")
تأكد_يساوي(ط.فارغ(), صواب, "فارغ")
