# مثال 62 — شجرة بناء الجملة (مكتبة devtools / ast)
# Syntax trees in Arabic
#
# Run:  python apl.py examples/62-devtools-ast.apl

المتغير المصدر = "def جمع(أ, ب):\n    return أ + ب\n"
المتغير الشجرة = حلّل_مصدر(المصدر)

اطبع "=== تحليل المصدر ==="
اطبع "نوع الشجرة:", نص(نوع(الشجرة))
اطبع "عدد العقد:", طول(قائمة(تجوّل_شجرة_البناء(الشجرة)))
اطبع "التفريغ:"
اطبع أفرغ_الشجرة(الشجرة)

اطبع ""
اطبع "=== أنواع العقد ==="
المتغير العقد = قائمة(تجوّل_شجرة_البناء(الشجرة))
لكل ع في العقد:
    اطبع "  ", نص(نوع(ع))

اطبع ""
اطبع "=== تقييم وآثار ==="
اطبع "قيّم_حرفي('[1, 2, 3]'):", قيّم_حرفي("[1, 2, 3]")
المتغير أولى = حلّل_مصدر("1 + 1")
المتغير ثانية = حلّل_مصدر("1 + 1")
اطبع "قارن_شجرتين(أ, ب):", قارن_شجرتين(أولى, ثانية)
اطبع "زائر_العقد صنف:", هو_صنف(زائر_العقد)
اطبع "محوّل_العقد صنف:", هو_صنف(محوّل_العقد)
