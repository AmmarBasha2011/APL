# مثال 4306 — الحد النوني بخطوة 61
# Nth term step 61
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4306-nth-term-arithmetic-sequence-step-61.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 61

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 64, "حالة 2")
تأكد_يساوي(ف(10), 552, "حالة 3")
تأكد_يساوي(ف(100), 6042, "حالة 4")
