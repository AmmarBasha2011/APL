# مثال 681 — لعبة الحياة
# Game of Life
# Demonstrates: أتمتة خلوية، قواعد B3/S23، مذبذبات
#
# Run:  python apl.py examples/681-game-of-life.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# لعبة الحياة لكونواي على شبكة محدودة
# Demonstrates: قواعد الولادة والبقاء B3/S23, عد الجيران, مذبذب ونمط ساكن
# الخلايا خارج الشبكة ميتة دائما

دالة شبكة_فارغة(صفوف, أعمدة):
  شبكة = []
  لكل ي في نطاق(صفوف):
    صف = []
    لكل ج في نطاق(أعمدة):
      صف.append(0)
    شبكة.append(صف)
  ارجع شبكة

دالة جيران_أحياء(شبكة, ص, ع, صفوف, أعمدة):
  عدد = 0
  لكل دص في نطاق(-1, 2):
    لكل دع في نطاق(-1, 2):
      لو دص == 0 و دع == 0:
        عدد = عدد + 0
      والا:
        ص2 = ص + دص
        ع2 = ع + دع
        لو ص2 >= 0 و ص2 < صفوف و ع2 >= 0 و ع2 < أعمدة:
          عدد = عدد + شبكة[ص2][ع2]
  ارجع عدد

دالة خطوة(شبكة, صفوف, أعمدة):
  جديدة = شبكة_فارغة(صفوف, أعمدة)
  لكل ص في نطاق(صفوف):
    لكل ع في نطاق(أعمدة):
      ج = جيران_أحياء(شبكة, ص, ع, صفوف, أعمدة)
      لو شبكة[ص][ع] == 1:
        لو ج == 2 أو ج == 3:
          جديدة[ص][ع] = 1
      والا:
        لو ج == 3:
          جديدة[ص][ع] = 1
  ارجع جديدة

دالة عدد_أحياء(شبكة, صفوف, أعمدة):
  عدد = 0
  لكل ص في نطاق(صفوف):
    لكل ع في نطاق(أعمدة):
      عدد = عدد + شبكة[ص][ع]
  ارجع عدد

# المومياء (مذبذب بدورية 2)
وميض = شبكة_فارغة(5, 5)
وميض[2][1] = 1
وميض[2][2] = 1
وميض[2][3] = 1
بعد1 = خطوة(وميض, 5, 5)
تأكد_يساوي(بعد1[1][2], 1, "الموميض يدور عموديا 1")
تأكد_يساوي(بعد1[2][2], 1, "الموميض يدور عموديا 2")
تأكد_يساوي(بعد1[3][2], 1, "الموميض يدور عموديا 3")
تأكد_يساوي(بعد1[2][1], 0, "الأفقي اختفى 1")
تأكد_يساوي(بعد1[2][3], 0, "الأفقي اختفى 2")
بعد2 = خطوة(بعد1, 5, 5)
تأكد_يساوي(بعد2[2][1] + بعد2[2][2] + بعد2[2][3], 3, "الموميض يعود أفقيا بعد خطوتين")

# الكتلة نمط ساكن
كتلة = شبكة_فارغة(4, 4)
كتلة[1][1] = 1
كتلة[1][2] = 1
كتلة[2][1] = 1
كتلة[2][2] = 1
كتلة2 = خطوة(كتلة, 4, 4)
تأكد_يساوي(عدد_أحياء(كتلة2, 4, 4), 4, "الكتلة ساكنة")
اطبع "أحياء الموميض:", عدد_أحياء(بعد1, 5, 5)
