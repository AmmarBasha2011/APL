# مثال 293 — من أرقام رومانية إلى عشرية
# Roman to integer
# Demonstrates: قاموس قيم وقاعدة الطرح
#
# Run:  python apl.py examples/293-roman-to-int.apl

المتغير قيم = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}

دالة من_روماني(نص_الدخل):
    المتغير مجموع = 0
    لكل ي في نطاق(طول(نص_الدخل)):
        المتغير حالي = قيم[نص_الدخل[ي]]
        لو ي + 1 < طول(نص_الدخل) و قيم[نص_الدخل[ي + 1]] > حالي:
            مجموع = مجموع - حالي
        الا:
            مجموع = مجموع + حالي
    ارجع مجموع

اطبع "III =", من_روماني("III")
اطبع "IV =", من_روماني("IV")
اطبع "IX =", من_روماني("IX")
اطبع "MCMXCIV =", من_روماني("MCMXCIV")
