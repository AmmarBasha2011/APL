# مثال 3785 — مجموع ord مع إزاحة 16
# Sum of ord values plus 16 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3785-sum-of-ord-values-offset-16.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 16
  ارجع م

تأكد_يساوي(ف("a"), 113, "حالة 1")
تأكد_يساوي(ف("abc"), 342, "حالة 2")
تأكد_يساوي(ف("xyz"), 411, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
