# مثال 2704 — ضرب كل عنصر في 18
# Multiply each item by 18
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2704-list-multiply-each-by-18.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 18]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [54, 18, 36], "حالة 1")
تأكد_يساوي(ف([5]), [90], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [18, 36, 54, 72, 90, 108], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-36, 0, 126, 126, 72], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [180, 360, 180, 540, 360, 180], "حالة 5")
