# مثال 2041 — عدد متماثل بعكس النصف
# Palindrome number half reverse
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2041-palindrome-number-reverse-half.apl

# # نتوقف حين يصبح المعكوس أكبر من الباقي
# # العدد السالب أو المنتهي بصفر لا يكون متماثلا

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متماثل(ن):
  لو ن < 0 أو (ن % 10 == 0 و ن != 0):
    ارجع خطأ
  م = 0
  طالما ن > م:
    م = م * 10 + ن % 10
    ن = ن // 10
  ارجع ن == م أو ن == م // 10

تأكد_يساوي(متماثل(121), صواب, "١٢١")
تأكد_يساوي(متماثل(-121), خطأ, "سالب")
تأكد_يساوي(متماثل(10), خطأ, "١٠")
تأكد_يساوي(متماثل(12321), صواب, "فردي")
تأكد_يساوي(متماثل(0), صواب, "صفر")
