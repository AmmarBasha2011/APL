# مثال 41 — أكثر الكلمات تكراراً
# Top Word Frequency
# Demonstrates: dictionaries, manual counting, finding the maximum
#
# Run:  python apl.py examples/41-word-frequency-top.apl

المتغير النص = "the quick brown fox jumps over the lazy dog the fox runs and the dog barks the fox"

دالة_عد(النص):
    الكلمات = دالة_تقسيم(النص, " ")
    العد = {}
    لكل كلمة في الكلمات:
        إذا طول(كلمة) == 0:
           تخطي = 0
        والا:
            كلمة = كلمة.سفلي()
            إذا كلمة في العد:
                العد[كلمة] = العد[كلمة] + 1
            والا:
                العد[كلمة] = 1
    ارجع العد

المتغير التكرار = دالة_عد(النص)

اطبع "=== أكثر الكلمات تكراراً ==="
اطبع ""
اطبع "عدد الكلمات: " + نص(طول(دالة_تقسيم(النص, " ")))
اطبع "عدد الكلمات الفريدة: " + نص(طول(التكرار))
اطبع ""
اطبع "--- كل الكلمات مع العد ---"
لكل كلمة في التكرار:
    اطبع "  " + كلمة + ": " + نص(التكرار[كلمة])
اطبع ""
اطبع "--- الأعلى تكراراً ---"
الأعلى = ""
أعلى_عدد = 0
لكل كلمة في التكرار:
    لو التكرار[كلمة] > أعلى_عدد:
        أعلى_عدد = التكرار[كلمة]
        الأعلى = كلمة
اطبع "  " + الأعلى + " (" + نص(أعلى_عدد) + " مرات)"
