# مثال 2752 — مجموع قوى 16
# Sum of powers of 16
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2752-sum-of-powers-of-16-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 16 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 17, "حالة 2")
تأكد_يساوي(ف(3), 4369, "حالة 3")
تأكد_يساوي(ف(6), 17895697, "حالة 4")
تأكد_يساوي(ف(10), 1172812402961, "حالة 5")
