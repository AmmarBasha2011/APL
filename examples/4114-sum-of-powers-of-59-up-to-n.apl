# مثال 4114 — مجموع قوى 59
# Sum of powers of 59
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4114-sum-of-powers-of-59-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 59 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 60, "حالة 2")
تأكد_يساوي(ف(3), 208920, "حالة 3")
تأكد_يساوي(ف(6), 42907784221, "حالة 4")
تأكد_يساوي(ف(10), 519929111116169701, "حالة 5")
