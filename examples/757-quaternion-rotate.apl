# مثال 757 — دوران كواترنيوني
# Quaternion rotation
# Demonstrates: ضرب كواترنيوني، مرافق، محور وزاوية
#
# Run:  python apl.py examples/757-quaternion-rotate.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تدوير المتجهات بالكواترنيونات (بلا مصفوفات)
# Demonstrates: ضرب كواترنيوني, مرافق, q·p·q*, محور وزاوية
# الكواترنيون قائمة [w, x, y, z] والمتجه كواترنيون تخيلي خالص

دالة ضرب_ك(أ, ب):
  ارجع [أ[0]*ب[0] - أ[1]*ب[1] - أ[2]*ب[2] - أ[3]*ب[3],
        أ[0]*ب[1] + أ[1]*ب[0] + أ[2]*ب[3] - أ[3]*ب[2],
        أ[0]*ب[2] - أ[1]*ب[3] + أ[2]*ب[0] + أ[3]*ب[1],
        أ[0]*ب[3] + أ[1]*ب[2] - أ[2]*ب[1] + أ[3]*ب[0]]

دالة مرافق(ق):
  ارجع [ق[0], -ق[1], -ق[2], -ق[3]]

دالة كواترنيون_دوران(محور, درجات):
  نصف = درجات * 3.14159265358979 / 360
  جيب_نصف = جب(نصف)
  ارجع [جتا(نصف), محور[0] * جيب_نصف, محور[1] * جيب_نصف, محور[2] * جيب_نصف]

دالة دوّر(متجه, محور, درجات):
  ق = كواترنيون_دوران(محور, درجات)
  ناتج = ضرب_ك(ضرب_ك(ق, [0, متجه[0], متجه[1], متجه[2]]), مرافق(ق))
  ارجع [مقرب(ناتج[1], 4), مقرب(ناتج[2], 4), مقرب(ناتج[3], 4)]

تأكد_يساوي(دوّر([1, 0, 0], [0, 0, 1], 90), [0.0, 1.0, 0.0], "تسعون حول z")
تأكد_يساوي(دوّر([1, 0, 0], [0, 1, 0], 90), [0.0, 0.0, -1.0], "تسعون حول y")
تأكد_يساوي(دوّر([1, 2, 3], [0, 0, 1], 180), [-1.0, -2.0, 3.0], "مئة وثمانون حول z")
تأكد_يساوي(دوّر([5, 7, 9], [1, 0, 0], 0), [5.0, 7.0, 9.0], "بلا دوران")
تأكد_يساوي(دوّر(دوّر([1, 0, 0], [0, 0, 1], 90), [0, 0, 1], 270), [1.0, 0.0, 0.0], "360 تعود")

اطبع "النتيجة:", دوّر([1, 0, 0], [0, 0, 1], 90)
