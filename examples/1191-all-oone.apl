# مثال 1191 — أكبر وأصغر عدّاد
# All O(1) data structure
# Demonstrates: قاموس عدّادات
#
# Run:  python apl.py examples/1191-all-oone.apl

# نخزن عدّاد كل مفتاح
# ونحسب الأكبر والأصغر عند الطلب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف عدادات:
  دالة_إنشاء(ذات):
    ذات.ع = {}

  دالة زد(ذات, م):
    ذات.ع[م] = ذات.ع.get(م, 0) + 1

  دالة انقص(ذات, م):
    لو م في ذات.ع:
      ذات.ع[م] = ذات.ع[م] - 1
      لو ذات.ع[م] == 0:
        ذات.ع.pop(م)

  دالة مفتاح_اكبر(ذات):
    افضل = ""
    قيمة = -1
    لكل م في ذات.ع:
      لو ذات.ع[م] > قيمة:
        قيمة = ذات.ع[م]
        افضل = م
    ارجع افضل

  دالة مفتاح_اصغر(ذات):
    افضل = ""
    قيمة = 10 ** 9
    لكل م في ذات.ع:
      لو ذات.ع[م] < قيمة:
        قيمة = ذات.ع[م]
        افضل = م
    ارجع افضل

ع = عدادات()
ع.زد("a")
ع.زد("b")
ع.زد("b")
تأكد_يساوي(ع.مفتاح_اكبر(), "b", "الأكبر")
تأكد_يساوي(ع.مفتاح_اصغر(), "a", "الأصغر")
ع.انقص("b")
ع.انقص("b")
تأكد_يساوي(ع.مفتاح_اكبر(), "a", "بعد الحذف")
ع.انقص("a")
تأكد_يساوي(ع.مفتاح_اكبر(), "", "فارغ")
