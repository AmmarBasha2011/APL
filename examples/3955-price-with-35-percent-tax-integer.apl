# مثال 3955 — السعر مع ضريبة 35 بالمئة
# Price with 35 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3955-price-with-35-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 35 // 100

تأكد_يساوي(ف(100), 135, "حالة 1")
تأكد_يساوي(ف(250), 337, "حالة 2")
تأكد_يساوي(ف(999), 1348, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
