# مثال 147 — العداد المتقدم
# Advanced Counter usage
# Demonstrates: عداد، عنصر_أكثر، العمليات على العدادات
#
# Run:  python apl.py examples/147-counter-advanced.apl

المتغير أ = عداد("abracadabra")
اطبع "تكرار الحروف:", قاموس_فاضي(أ)
اطبع "الأكثر تكراراً:", عنصر_أكثر(أ, 3)

المتغير مخزون1 = عداد({"تفاح": 5, "موز": 3})
المتغير مخزون2 = عداد({"تفاح": 2, "عنب": 4})
اطبع "الجمع:", قاموس_فاضي(مخزون1 + مخزون2)
اطبع "الطرح:", قاموس_فاضي(مخزون1 - مخزون2)
اطبع "إجمالي العناصر:", مجموع(مخزون1.values())
