# مثال 2527 — مجموع قوى 8
# Sum of powers of 8
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2527-sum-of-powers-of-8-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 8 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 9, "حالة 2")
تأكد_يساوي(ف(3), 585, "حالة 3")
تأكد_يساوي(ف(6), 299593, "حالة 4")
تأكد_يساوي(ف(10), 1227133513, "حالة 5")
