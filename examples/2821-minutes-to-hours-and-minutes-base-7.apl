# مثال 2821 — تحويل وحدة بأساس 7
# Split by base 7
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2821-minutes-to-hours-and-minutes-base-7.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 7, ن % 7]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [8, 3], "حالة 2")
تأكد_يساوي(ف(60), [8, 4], "حالة 3")
تأكد_يساوي(ف(125), [17, 6], "حالة 4")
تأكد_يساوي(ف(1000), [142, 6], "حالة 5")
