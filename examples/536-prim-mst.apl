# مثال 536 — شجرة بريم الممتدة الصغرى
# Prim minimum spanning tree
# Demonstrates: شجرة ممتدة صغرى، بريم، رسم موزون
#
# Run:  python apl.py examples/536-prim-mst.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# شجرة بريم الممتدة الصغرى
المتغير ج = قاموس()
ج["أ"] = {"ب": 4, "ج": 2}
ج["ب"] = {"أ": 4, "ج": 1, "د": 5}
ج["ج"] = {"أ": 2, "ب": 1, "د": 8, "هـ": 10}
ج["د"] = {"ب": 5, "ج": 8, "هـ": 2}
ج["هـ"] = {"ج": 10, "د": 2}

المتغير داخل = ["أ"]
المتغير حواف = قائمة()
طالما طول(داخل) < طول(ج):
    المتغير أفضل_وزن = 999999
    المتغير أفضل_من = ""
    المتغير أفضل_الى = ""
    لكل عقدة في داخل:
        لكل جار في ج[عقدة]:
            لو جار ليس في داخل و ج[عقدة][جار] < أفضل_وزن:
                أفضل_وزن = ج[عقدة][جار]
                أفضل_من = عقدة
                أفضل_الى = جار
    داخل.أضف(أفضل_الى)
    حواف.أضف([أفضل_من, أفضل_الى, أفضل_وزن])

المتغير كلفة = مجموع([ح[2] لكل ح في حواف])
اطبع "الحواف:", حواف
اطبع "الكلفة:", كلفة
تأكد_يساوي(كلفة, 10, "كلفة الشجرة الصغرى")
تأكد_يساوي(طول(حواف), 4, "عدد الحواف")
