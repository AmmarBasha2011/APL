# مثال 3583 — مجموع زوايا مضلع زائد 18
# Polygon angle sum plus 18
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3583-interior-angle-sum-of-polygon-plus-18.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 18

تأكد_يساوي(ف(3), 198, "حالة 1")
تأكد_يساوي(ف(4), 378, "حالة 2")
تأكد_يساوي(ف(5), 558, "حالة 3")
تأكد_يساوي(ف(6), 738, "حالة 4")
تأكد_يساوي(ف(12), 1818, "حالة 5")
