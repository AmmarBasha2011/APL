# مثال 200 — لوحة نتائج الطلاب
# Student scoreboard (grand finale)
# Demonstrates: قواميس، مفرز بمفتاح، حالة، توليدات، فلترة_قائمة
#
# Run:  python apl.py examples/200-final-showcase-2.apl

المتغير طلاب = [
    {"اسم": "علي", "درجات": [85, 90, 78]},
    {"اسم": "سارة", "درجات": [92, 88, 95]},
    {"اسم": "خالد", "درجات": [70, 65, 72]},
    {"اسم": "منى", "درجات": [88, 91, 84]}
]

دالة متوسط(قائمة):
    المتغير م = 0
    لكل ع في قائمة:
        م = م + ع
    ارجع م / طول(قائمة)

دالة تقدير(درجة):
    حالة صحيح(درجة / 10):
        قيمة 10:
            ارجع "ممتاز"
        قيمة 9:
            ارجع "ممتاز"
        قيمة 8:
            ارجع "جيد جدا"
        قيمة 7:
            ارجع "جيد"
        افتراضي:
            ارجع "مقبول"

المتغير ملخص = []
لكل ط في طلاب:
    المتغير م = متوسط(ط["درجات"])
    ملخص.أضف({"اسم": ط["اسم"], "متوسط": م, "تقدير": تقدير(م)})

المتغير مرتبون = مفرز(ملخص, key=(س) => س["متوسط"], reverse=True)

اطبع "=== لوحة النتائج ==="
لكل ي في نطاق(طول(مرتبون)):
    المتغير س = مرتبون[ي]
    اطبع ي + 1, "-", س["اسم"], ":", س["متوسط"], "(", س["تقدير"], ")"

المتغير متفوقون = قائمة(فلترة_قائمة((س) => س["متوسط"] >= 85, مرتبون))
اطبع "المتفوقون:", [س["اسم"] لكل س في متفوقون]
