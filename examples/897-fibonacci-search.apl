# مثال 897 — بحث فيبوناتشي
# Fibonacci search
# Demonstrates: تقسيم عند أعداد فيبوناتشي
#
# Run:  python apl.py examples/897-fibonacci-search.apl

# بحث فيبوناتشي: يقسم المصفوفة عند أعداد فيبوناتشي بدل النصف
# يفيد حين الوصول للعناصر غير متجانس الكلفة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بحث_فيبوناتشي(مصفوفة, هدف):
  ن = طول(مصفوفة)
  فيب2 = 0
  فيب1 = 1
  فيب = 1
  طالما فيب < ن:
    فيب2 = فيب1
    فيب1 = فيب
    فيب = فيب1 + فيب2
  إزاحة = -1
  طالما فيب > 1:
    i = إزاحة + فيب2
    لو i > ن - 1:
      i = ن - 1
    لو مصفوفة[i] < هدف:
      فيب = فيب1
      فيب1 = فيب2
      فيب2 = فيب - فيب1
      إزاحة = i
    والا_لو مصفوفة[i] > هدف:
      فيب = فيب2
      فيب1 = فيب1 - فيب2
      فيب2 = فيب - فيب1
    والا:
      ارجع i
  لو (فيب1 == 1) و (إزاحة + 1 < ن) و (مصفوفة[إزاحة + 1] == هدف):
    ارجع إزاحة + 1
  ارجع -1

مصفوفة = [1, 3, 4, 6, 7, 8, 10, 13, 14]
اطبع "موضع 10:", بحث_فيبوناتشي(مصفوفة, 10)
اطبع "موضع 14:", بحث_فيبوناتشي(مصفوفة, 14)

تأكد_يساوي(بحث_فيبوناتشي(مصفوفة, 10), 6, "الهدف الأوسط")
تأكد_يساوي(بحث_فيبوناتشي(مصفوفة, 14), 8, "الأخير")
تأكد_يساوي(بحث_فيبوناتشي(مصفوفة, 1), 0, "الأول")
تأكد_يساوي(بحث_فيبوناتشي(مصفوفة, 5), -1, "غير موجود")
تأكد_يساوي(بحث_فيبوناتشي(مصفوفة, 100), -1, "أكبر من الكل")

# يطابق البحث الخطي على كل القيم الموجودة
لكل i في نطاق(طول(مصفوفة)):
  تأكد_يساوي(بحث_فيبوناتشي(مصفوفة, مصفوفة[i]), i, "موضع " + نص(مصفوفة[i]))
