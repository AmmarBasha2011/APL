# مثال 755 — مجزئ عربي
# Arabic tokenizer
# Demonstrates: آلة حالات، مدى يونيكود، ترقيم
#
# Run:  python apl.py examples/755-tokenizer-ar-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مجزئ نصوص عربية: كلمات وأرقام وعلامات ترقيم
# Demonstrates: آلة حالات, مدى الحروف العربية في يونيكود, أرقام عشرية
# الحروف العربية U+0621..U+064A، وعلامات الترقيم تنفصل كوحدات

دالة صنف_حرف(حرف):
  نقطة = ترميز_حرف(حرف)
  لو نقطة >= 1569 و نقطة <= 1618:
    ارجع "كلمة"
  لو حرف >= "0" و حرف <= "9":
    ارجع "رقم"
  لو نقطة >= 1632 و نقطة <= 1641:
    ارجع "رقم"
  ارجع "أخرى"

دالة مجزئ(نص):
  وحدات = []
  حالي = ""
  صنف = ""
  لكل ي في نطاق(طول(نص)):
    حرف = نص[ي]
    ج = صنف_حرف(حرف)
    لو ج == "أخرى":
      لو حالي != "":
        وحدات.append([صنف, حالي])
        حالي = ""
        صنف = ""
      لو حرف != " ":
        وحدات.append(["ترقيم", حرف])
    والا_لو ج == صنف:
      حالي = حالي + حرف
    والا:
      لو حالي != "":
        وحدات.append([صنف, حالي])
      حالي = حرف
      صنف = ج
  لو حالي != "":
    وحدات.append([صنف, حالي])
  ارجع وحدات

دالة كلمات_فقط(نص):
  ناتج = []
  لكل وحدة في مجزئ(نص):
    لو وحدة[0] == "كلمة":
      ناتج.append(وحدة[1])
  ارجع ناتج

وحدات = مجزئ("مرحباً بالعالم! رقم 42.")
تأكد_يساوي(وحدات[0], ["كلمة", "مرحباً"], "أول كلمة")
تأكد_يساوي(وحدات[1], ["كلمة", "بالعالم"], "ثاني كلمة")
تأكد_يساوي(وحدات[2], ["ترقيم", "!"], "علامة تعجب")
تأكد_يساوي(وحدات[4], ["رقم", "42"], "رقم")
تأكد_يساوي(وحدات[5], ["ترقيم", "."], "نقطة")

تأكد_يساوي(كلمات_فقط("العلم نور والجهل ظلام"), ["العلم", "نور", "والجهل", "ظلام"], "جملة بلا ترقيم")
تأكد_يساوي(طول(مجزئ("")), 0, "نص فارغ")
تأكد_يساوي(مجزئ("٣٤٥"), [["رقم", "٣٤٥"]], "أرقام عربية مشرقية")

اطبع "الكلمات:", كلمات_فقط("مرحباً بالعالم! رقم 42.")
