# مثال 2815 — تقسيم الفاتورة على 6
# Split bill among 6
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2815-split-bill-among-6-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 6 - 1) // 6

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 2, "حالة 2")
تأكد_يساوي(ف(100), 17, "حالة 3")
تأكد_يساوي(ف(101), 17, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
