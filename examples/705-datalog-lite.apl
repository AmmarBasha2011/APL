# مثال 705 — داتالوج مصغر
# Datalog lite
# Demonstrates: حقائق، قاعدة عودية، نقطة ثابتة
#
# Run:  python apl.py examples/705-datalog-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# داتالوج مصغر: حقائق وقواعد وإغلاق
# Demonstrates: إغلاق متعدي, قاعدة عودية, نقطة ثابتة
# القاعدة: سلف(س, ص) :- والد(س, ص). سلف(س, ص) :- والد(س, ز)، سلف(ز, ص).

دالة أغلق(حقائق_والد):
  سلف = []
  لكل ح في حقائق_والد:
    سلف.append(ح)
  تغير = صواب
  طالما تغير:
    تغير = خطأ
    لكل ح1 في حقائق_والد:
      لكل ح2 في سلف:
        لو ح1[1] == ح2[0] و ([ح1[0], ح2[1]] في سلف) == خطأ:
          سلف.append([ح1[0], ح2[1]])
          تغير = صواب
  ارجع سلف

دالة عدد_أحفاد(سلف, شخص):
  نسل = []
  لكل ح في سلف:
    لو ح[0] == شخص و (ح[1] في نسل) == خطأ:
      نسل.append(ح[1])
  ارجع طول(نسل)

والد = [["آدم", "بكر"], ["بكر", "جاد"], ["جاد", "داني"], ["آدم", "هشام"], ["هشام", "وليد"]]
سلف = أغلق(والد)
تأكد_يساوي(["آدم", "داني"] في سلف, صواب, "آدم سلف داني")
تأكد_يساوي(["بكر", "داني"] في سلف, صواب, "بكر سلف داني")
تأكد_يساوي(["هشام", "جاد"] في سلف, خطأ, "هشام ليس سلف جاد")
تأكد_يساوي(عدد_أحفاد(سلف, "آدم"), 5, "لآدم خمسة أحفاد")
تأكد_يساوي(عدد_أحفاد(سلف, "بكر"), 2, "لبكر حفيدان")
تأكد_يساوي(عدد_أحفاد(سلف, "داني"), 0, "داني بلا أحفاد")
تأكد_يساوي(طول(سلف), 9, "الإغلاق أضاف أربع علاقات")
اطبع "علاقات السلف:", طول(سلف)
