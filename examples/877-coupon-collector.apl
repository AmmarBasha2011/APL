# مثال 877 — جامع الكوبونات
# Coupon collector
# Demonstrates: n ضرب العدد التوافقي
#
# Run:  python apl.py examples/877-coupon-collector.apl

# جامع الكوبونات: متوسط التجارب لجمع n نوعاً هو n * H(n)
# H(n) هو العدد التوافقي؛ لستة أنواع: 14.7 تجربة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة توافقي(ن):
  مجموع = 0.0
  لكل ك في نطاق(1, ن + 1):
    مجموع = مجموع + 1.0 / ك
  ارجع مجموع

دالة متوسط_جمع(أنواع):
  ارجع أنواع * توافقي(أنواع)

اطبع "متوسط جمع 6 أنواع:", متوسط_جمع(6)
اطبع "متوسط جمع 10 أنواع:", متوسط_جمع(10)

تأكد_يساوي(مقرب(متوسط_جمع(1), 6), 1.0, "نوع واحد = تجربة واحدة")
تأكد_يساوي(مقرب(متوسط_جمع(6), 1), 14.7, "6 أنواع = 14.7")
تأكد_يساوي(مقرب(متوسط_جمع(10), 2), 29.29, "10 أنواع = 29.29")

# التوافقي ينمو لوغاريتمياً: H(100) ≈ 5.19
تأكد_يساوي(مقرب(توافقي(100), 2), 5.19, "H(100) ≈ 5.19")
