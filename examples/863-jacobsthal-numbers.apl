# مثال 863 — أعداد جاكوبستال
# Jacobsthal numbers
# Demonstrates: J(n)=J(n-1)+2J(n-2)
#
# Run:  python apl.py examples/863-jacobsthal-numbers.apl

# أعداد جاكوبستال: J(n) = J(n-1) + 2*J(n-2) تبدأ 0, 1
# تظهر في تبليط الشبكات وعد تغطيات الدومينو

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جاكوبستال(ن):
  أ = 0
  ب = 1
  لكل _ في نطاق(ن):
    جديد = ب + 2 * أ
    أ = ب
    ب = جديد
  ارجع أ

اطبع "J0..J10:", [جاكوبستال(0), جاكوبستال(1), جاكوبستال(2), جاكوبستال(3), جاكوبستال(4), جاكوبستال(5), جاكوبستال(6), جاكوبستال(7), جاكوبستال(8), جاكوبستال(9), جاكوبستال(10)]

تأكد_يساوي(جاكوبستال(0), 0, "J0 = 0")
تأكد_يساوي(جاكوبستال(3), 3, "J3 = 3")
تأكد_يساوي(جاكوبستال(7), 43, "J7 = 43")
تأكد_يساوي(جاكوبستال(10), 341, "J10 = 341")

# صيغة مغلقة: J(n) = (2^n - (-1)^n) / 3
قوة2 = 1
إشارة = 1
لكل ن في نطاق(0, 10):
  مغلقة = (قوة2 - إشارة) // 3
  تأكد_يساوي(جاكوبستال(ن), مغلقة, "الصيغة المغلقة عند " + نص(ن))
  قوة2 = قوة2 * 2
  إشارة = -إشارة
