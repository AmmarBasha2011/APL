# مثال 1705 — هل نصل آخر المصفوفة بالقفزات
# Jump game reachability
# Demonstrates: جشع
#
# Run:  python apl.py examples/1705-jump-game-reachable.apl

# نتتبع أبعد مؤشر
# نفشل إن تجاوزنا الوصول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نصل(ق):
  أبعد = 0
  لكل ك في نطاق(طول(ق)):
    لو ك > أبعد:
      ارجع خطأ
    أبعد = أكبر(أبعد, ك + ق[ك])
  ارجع صواب

تأكد_يساوي(نصل([2, 3, 1, 1, 4]), صواب, "نصل")
تأكد_يساوي(نصل([3, 2, 1, 0, 4]), خطأ, "عالق")
تأكد_يساوي(نصل([0]), صواب, "واحد")
