# مثال 330 — المجموع التراكمي
# Running total
# Demonstrates: تراكم خطوة بخطوة
#
# Run:  python apl.py examples/330-running-total.apl

دالة تراكمي(قائمة):
    المتغير نتيجة = []
    المتغير مجموع = 0
    لكل عنصر في قائمة:
        مجموع = مجموع + عنصر
        نتيجة.أضف(مجموع)
    ارجع نتيجة

اطبع تراكمي([1, 2, 3, 4])
اطبع تراكمي([10, -5, 20, 5])

المتغير مبيعات = [100, 250, 175, 300]
المتغير تراكم = تراكمي(مبيعات)
اطبع "مبيعات:", مبيعات
اطبع "تراكمي:", تراكم
