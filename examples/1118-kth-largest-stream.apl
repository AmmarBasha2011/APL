# مثال 1118 — الأكبر ك في تدفق
# Kth largest element in a stream
# Demonstrates: قائمة مرتبة بحجم ثابت
#
# Run:  python apl.py examples/1118-kth-largest-stream.apl

# نحتفظ بأكبر ك أعداد فقط مرتبة تصاعدياً
# وأولها هو الأكبر ك

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف اكبر_ك:
    دالة_إنشاء(ذات, ك, بداية):
        ذات.ك = ك
        ذات.اكبر = []
        لكل س في بداية:
            ذات.اضف_رقم(س)

    دالة اضف_رقم(ذات, س):
        ذات.اكبر.ألحق(س)
        ذات.اكبر = مفرز(ذات.اكبر)
        لو طول(ذات.اكبر) > ذات.ك:
            ذات.اكبر = ذات.اكبر[1:]
        ارجع ذات.اكبر[0]

م = اكبر_ك(3, [4, 5, 8, 2])
تأكد_يساوي(م.اضف_رقم(3), 4, "بعد 3")
تأكد_يساوي(م.اضف_رقم(5), 5, "بعد 5")
تأكد_يساوي(م.اضف_رقم(10), 5, "بعد 10")
تأكد_يساوي(م.اضف_رقم(9), 8, "بعد 9")
تأكد_يساوي(م.اضف_رقم(4), 8, "بعد 4")
