# مثال 26 — طابور ومكدّس
# Queue and Stack
# Demonstrates: lists, append/pop, FIFO vs LIFO
#
# Run:  python apl.py examples/26-queue-stack.apl

دالة_انشاء_طابور():
    ارجع []

دالة_إضافة(طابور, عنصر):
    طابور.ألحق(عنصر)
    ارجع طابور

دالة_إزالة(طابور):
    إذا طول(طابور) == 0:
        ارجع لا_شيء
    أول = طابور[0]
    جديد = []
    رقم = 1
    طالما رقم < طول(طابور):
        جديد.ألحق(طابور[رقم])
        رقم = رقم + 1
    ارجع [أول, جديد]

دالة_دفع(مكدس, عنصر):
    مكدس.ألحق(عنصر)
    ارجع مكدس

دالة_سحب(مكدس):
    إذا طول(مكدس) == 0:
        ارجع لا_شيء
    أعلى = مكدس[طول(مكدس) - 1]
    جديد = []
    رقم = 0
    طالما رقم < طول(مكدس) - 1:
        جديد.ألحق(مكدس[رقم])
        رقم = رقم + 1
    ارجع [أعلى, جديد]

المتغير ط = انشاء_طابور()
المتغير طابور = ط
لكل قيمة في [1, 2, 3, 4]:
    دالة_إضافة(طابور, قيمة)

اطبع "=== طابور (FIFO) ==="
اطبع "الحالة: " + نص(طابور)
المتغير ناتج_ط = إزالة(طابور)
اطبع "أخرج أول عنصر: " + نص(ناتج_ط[0])
طابور = ناتج_ط[1]
اطبع "الباقي: " + نص(طابور)

المتغير مكدس = []
لكل قيمة في [1, 2, 3, 4]:
    دالة_دفع(مكدس, قيمة)

اطبع ""
اطبع "=== مكدّس (LIFO) ==="
اطبع "الحالة: " + نص(مكدس)
المتغير ناتج_م = سحب(مكدس)
اطبع "أخرج آخر عنصر: " + نص(ناتج_م[0])
مكدس = ناتج_م[1]
اطبع "الباقي: " + نص(مكدس)
