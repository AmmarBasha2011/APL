# مثال 2382 — هل العدد مثلثي
# Is triangular number
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2382-triangular-root-check-is-triangular.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  ي = 0
  طالما م < ن:
    ي = ي + 1
    م = م + ي
  ارجع م == ن

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(1), صواب, "حالة 2")
تأكد_يساوي(ف(3), صواب, "حالة 3")
تأكد_يساوي(ف(6), صواب, "حالة 4")
تأكد_يساوي(ف(10), صواب, "حالة 5")
تأكد_يساوي(ف(11), خطأ, "حالة 6")
تأكد_يساوي(ف(15), صواب, "حالة 7")
تأكد_يساوي(ف(28), صواب, "حالة 8")
تأكد_يساوي(ف(50), خطأ, "حالة 9")
