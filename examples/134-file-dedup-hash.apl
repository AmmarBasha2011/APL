# مثال 134 — كشف الملفات المكررة بالتجزئة
# Finding duplicate files by hash
# Demonstrates: تجزئة_sha256، اقرأ، قاموس
#
# Run:  python apl.py examples/134-file-dedup-hash.apl

المتغير جذر = "/tmp/apl_dedup_demo"
انشئ_مجلدات(جذر)
اكتب(جذر + "/أ.txt", "نفس المحتوى")
اكتب(جذر + "/ب.txt", "محتوى مختلف")
اكتب(جذر + "/ج.txt", "نفس المحتوى")

المتغير تجزئات = قاموس_فاضي()
لكل اسم في قائمة_ملفات(جذر):
    المتغير محتوى = اقرأ(جذر + "/" + اسم)
    المتغير ه = تجزئة_sha256(محتوى.encode()).hexdigest()
    تجزئات[اسم] = ه

اطبع "التجزئات:"
لكل اسم في تجزئات:
    اطبع "-", اسم, ":", تجزئات[اسم][:12]

لو تجزئات["أ.txt"] == تجزئات["ج.txt"]:
    اطبع "أ.txt و ج.txt مكررتان ✓"

احذف_شجرة(جذر)
