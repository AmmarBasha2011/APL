# مثال 77 — هياكل البيانات (مكتبة datafiles)
# Data structures (array / struct / heapq / bisect / queue / graphlib)
#
# Run:  python apl.py examples/77-df-structures.apl

اطبع "=== مصفوفة مُنوعة ==="
المتغير م = مصفوفة_نوع("i", [1, 2, 3])
اطبع "النوع:", م.رمز_النوع
اطبع "الحجم:", م.حجم_العنصر
اطبع "العناصر:", م.إلى_قائمة()
م.مصفوفة_نوع_من_قائمة([4, 5])
اطبع "بعد الإضافة:", م.إلى_قائمة()

اطبع ""
اطبع "=== بنية متراصة ==="
المتغير ب = بنية(">i")
المتغير مُحرَّف = ب.بنية_احزم(7)
اطبع "مُحرَّف:", مُحرَّف
اطبع "مفكوك:", ب.بنية_فكّ_الحزمة(مُحرَّف)

اطبع ""
اطبع "=== كومة ==="
المتغير ك = [5, 1, 9, 3]
حوّل_إلى_كومة(ك)
اطبع "الكومة:", ك
اطبع "أصغر عنصر:", اسحب_من_الكومة(ك)
ادفع_للكومة(ك, 0)
اطبع "بعد الدفع:", ك
اطبع "أكبر عنصرين:", أكبر_ن(2, ك)

اطبع ""
اطبع "=== إدراج مرتّب ==="
المتغير ق_م = [1, 3, 5]
أدرج_مرتّباً(ق_م, 4)
اطبع "بعد الإدراج:", ق_م
اطبع "موضع 6:", ابحث_موضع(ق_م, 6)

اطبع ""
اطبع "=== طابور ==="
المتغير ط = طابور_2()
ط.طابور_ضع("أول")
ط.طابور_ضع("ثانٍ")
اطبع "الحجم:", ط.طابور_حجم_الطابور()
اطبع "الأول:", ط.طابور_احصل()

اطبع ""
اطبع "=== ترتيب توبولوجي ==="
المتغير م_ت = مرتّب_توبولوجي()
م_ت.توبولوجي_مرتّب_أضف("ب", "أ")
م_ت.توبولوجي_مرتّب_أضف("ج", "ب")
م_ت.جهّز()
اطبع "الترتيب:", قائمة(م_ت.ثابت_ترتيب())
