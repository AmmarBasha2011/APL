# مثال 434 — تنسيق الأرقام الكبيرة
# Number formatting
# Demonstrates: فواصل الآلاف
#
# Run:  python apl.py examples/434-number-format.apl

دالة بفواصل(عدد):
    المتغير نص_عدد = نص(عدد)
    المتغير ناتج = ""
    المتغير عد = 0
    لكل ي في نطاق(1, طول(نص_عدد) + 1):
        المتغير حرف = نص_عدد[طول(نص_عدد) - ي]
        لو عد == 3:
            ناتج = "," + ناتج
            عد = 0
        ناتج = حرف + ناتج
        عد = عد + 1
    ارجع ناتج

اطبع بفواصل(1234567)
اطبع بفواصل(950)
اطبع بفواصل(1000000)
