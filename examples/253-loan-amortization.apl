# مثال 253 — جدول سداد قرض
# Loan amortization
# Demonstrates: قسط شهري وجدول
#
# Run:  python apl.py examples/253-loan-amortization.apl

دالة قسط_شهري(مبلغ, نسبة_سنوية, عدد_الشهور):
    المتغير ر = نسبة_سنوية / 100 / 12
    لو ر == 0:
        ارجع مبلغ / عدد_الشهور
    ارجع مبلغ * ر / (1 - (1 + ر) ** -عدد_الشهور)

المتغير قسط = قسط_شهري(10000, 6, 12)
اطبع "القسط الشهري:", مقرب(قسط, 2)

المتغير متبقي = 10000
المتغير ر = 0.5 / 100 * 12
لكل شهر في نطاق(1, 4):
    المتغير فائدة = متبقي * ر
    المتغير سداد_أصل = قسط - فائدة
    متبقي = متبقي - سداد_أصل
    اطبع "شهر", شهر, ": فائدة", مقرب(فائدة, 2), "| أصل", مقرب(سداد_أصل, 2), "| متبقي", مقرب(متبقي, 2)
