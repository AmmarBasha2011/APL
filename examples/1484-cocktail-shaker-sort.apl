# مثال 1484 — فرز الخلاط
# Cocktail shaker sort
# Demonstrates: فرز
#
# Run:  python apl.py examples/1484-cocktail-shaker-sort.apl

# مرور للأمام يدفع الأكبر للنهاية
# مرور للخلف يدفع الأصغر للبداية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فرز_الخلاط(أ):
  بداية = 0
  نهاية = طول(أ) - 1
  بدّل = صواب
  طالما بدّل:
    بدّل = خطأ
    لكل ع في نطاق(بداية, نهاية):
      لو أ[ع] > أ[ع + 1]:
        ت = أ[ع]
        أ[ع] = أ[ع + 1]
        أ[ع + 1] = ت
        بدّل = صواب
    نهاية = نهاية - 1
    لكل ع في نطاق(نهاية, بداية, -1):
      لو أ[ع] < أ[ع - 1]:
        ت = أ[ع]
        أ[ع] = أ[ع - 1]
        أ[ع - 1] = ت
        بدّل = صواب
    بداية = بداية + 1
  ارجع أ

تأكد_يساوي(فرز_الخلاط([4, 3, 2, 1]), [1, 2, 3, 4], "عكسي")
تأكد_يساوي(فرز_الخلاط([2, 1]), [1, 2], "اثنان")
تأكد_يساوي(فرز_الخلاط([1, 5, 2, 4, 3]), [1, 2, 3, 4, 5], "مختلط")
