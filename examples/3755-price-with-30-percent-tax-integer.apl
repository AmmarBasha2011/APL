# مثال 3755 — السعر مع ضريبة 30 بالمئة
# Price with 30 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3755-price-with-30-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 30 // 100

تأكد_يساوي(ف(100), 130, "حالة 1")
تأكد_يساوي(ف(250), 325, "حالة 2")
تأكد_يساوي(ف(999), 1298, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
