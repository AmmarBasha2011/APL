# مثال 2963 — مجموع المربعات من 2 إلى ن
# Sum of squares from 2
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2963-sum-of-squares-from-2-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(2, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(2), 4, "حالة 1")
تأكد_يساوي(ف(3), 13, "حالة 2")
تأكد_يساوي(ف(12), 649, "حالة 3")
تأكد_يساوي(ف(100), 338349, "حالة 4")
