# مثال 3052 — مجموع الأعداد من 12 إلى ن
# Sum from 12 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3052-sum-of-integers-from-12-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(12, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(12), 12, "حالة 1")
تأكد_يساوي(ف(13), 25, "حالة 2")
تأكد_يساوي(ف(22), 187, "حالة 3")
تأكد_يساوي(ف(100), 4984, "حالة 4")
