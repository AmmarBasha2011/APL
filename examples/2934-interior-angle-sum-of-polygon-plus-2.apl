# مثال 2934 — مجموع زوايا مضلع زائد 2
# Polygon angle sum plus 2
# Demonstrates: هندسة
#
# Run:  python apl.py examples/2934-interior-angle-sum-of-polygon-plus-2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 2

تأكد_يساوي(ف(3), 182, "حالة 1")
تأكد_يساوي(ف(4), 362, "حالة 2")
تأكد_يساوي(ف(5), 542, "حالة 3")
تأكد_يساوي(ف(6), 722, "حالة 4")
تأكد_يساوي(ف(12), 1802, "حالة 5")
