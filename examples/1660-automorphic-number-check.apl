# مثال 1660 — العدد الذاتي التربيع
# Automorphic number check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1660-automorphic-number-check.apl

# نحسب المربع
# نقارن آخر أرقامه بالعدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ذاتي(ن):
  مربع = ن * ن
  قاعدة = 1
  ك = ن
  طالما ك > 0:
    قاعدة = قاعدة * 10
    ك = ك // 10
  ارجع مربع % قاعدة == ن

تأكد_يساوي(ذاتي(5), صواب, "خمسة")
تأكد_يساوي(ذاتي(76), صواب, "ستة وسبعون")
تأكد_يساوي(ذاتي(7), خطأ, "سبعة")
تأكد_يساوي(ذاتي(625), صواب, "625")
