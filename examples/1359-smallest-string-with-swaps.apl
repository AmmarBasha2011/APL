# مثال 1359 — أصغر نص بالتبديل
# Smallest string with swaps
# Demonstrates: اتحاد ووجد
#
# Run:  python apl.py examples/1359-smallest-string-with-swaps.apl

# الأزواج المتصلة تكون مجموعة حرة الترتيب
# نرتب حروف كل مجموعة ونعيدها لمواضعها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اصغر_نص(نص_, ازواج):
  ن = طول(نص_)
  اب = []
  لكل ع في نطاق(ن):
    اب.ألحق(ع)
  دالة جذر(س):
    طالما اب[س] != س:
      اب[س] = اب[اب[س]]
      س = اب[س]
    ارجع س
  لكل ز في ازواج:
    أ = جذر(ز[0])
    ب = جذر(ز[1])
    لو أ != ب:
      اب[أ] = ب
  مجموعات = {}
  لكل ع في نطاق(ن):
    ج = جذر(ع)
    لو ج ليس في مجموعات:
      مجموعات[ج] = []
    مجموعات[ج].ألحق(ع)
  حروف = قائمة(نص_)
  لكل ج في مجموعات:
    مواضع = مجموعات[ج]
    اح = []
    لكل م في مواضع:
      اح.ألحق(نص_[م])
    اح = مفرز(اح)
    لكل ك في نطاق(طول(مواضع)):
      حروف[مواضع[ك]] = اح[ك]
  ناتج = ""
  لكل ح في حروف:
    ناتج = ناتج + ح
  ارجع ناتج

تأكد_يساوي(اصغر_نص("dcab", [[0,3],[1,2]]), "bacd", "مجموعتان")
تأكد_يساوي(اصغر_نص("dcab", [[0,3],[1,2],[0,2]]), "abcd", "مجموعة واحدة")
تأكد_يساوي(اصغر_نص("cba", [[0,1],[1,2]]), "abc", "سلسلة")
