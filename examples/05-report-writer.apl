# مثال 5 — كاتب التقارير
# Report Writer
# Demonstrates: textwrap, f-strings, list joining, string building
#
# Run:  python apl.py examples/05-report-writer.apl

المتغير الأسطر = [
    "المشروع: نظام إدارة المهام",
    "الحالة: قيد التنفيذ",
    "المسؤول: عمار الخطيب",
    "آخر تحديث: اليوم",
    "نسبة الإنجاز: 65 بالمئة",
    "ملاحظات: لا توجد عوائق حالية"
]

اطبع "╔══════════════════════════════════╗"
لكل سطر في الأسطر:
    اطبع "║ " + سطر + "    ║"
اطبع "╚══════════════════════════════════╝"
اطبع ""
اطبع "--- ملخص مُلَفَّن ---"
اطبع الالتفاف_نص(" ".ضم(الأسطر), 40)
