# مثال 543 — تحويل بوروز-ويلر
# Burrows-Wheeler transform
# Demonstrates: BWT، تحويل وعكس، فرز دورانات
#
# Run:  python apl.py examples/543-burrows-wheeler.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تحويل بوروز-ويلر وعكسه
دالة حوّل(نص):
    المتغير ممدد = نص + "$"
    المتغير دورانات = قائمة()
    لكل i في نطاق(طول(ممدد)):
        دورانات.أضف(ممدد[i:] + ممدد[:i])
    دورانات = مفرز(دورانات)
    المتغير أخير = ""
    لكل د في دورانات:
        أخير = أخير + د[طول(د) - 1]
    ارجع أخير

دالة اعكس(أخير):
    المتغير ن = طول(أخير)
    المتغير جدول = [""] * ن
    لكل جولة في نطاق(ن):
        لكل i في نطاق(ن):
            جدول[i] = أخير[i] + جدول[i]
        جدول = مفرز(جدول)
    لكل صف في جدول:
        لو صف[ن - 1] == "$":
            ارجع صف[:ن - 1]
    ارجع ""

المتغير نتيجة = حوّل("BANANA")
اطبع "التحويل:", نتيجة
تأكد_يساوي(نتيجة, "ANNB$AA", "BWT نص BANANA")
تأكد_يساوي(اعكس(نتيجة), "BANANA", "العكس يرجع الأصل")
