# مثال 3121 — مجموع المربعات من 6 إلى ن
# Sum of squares from 6
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3121-sum-of-squares-from-6-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(6, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(6), 36, "حالة 1")
تأكد_يساوي(ف(7), 85, "حالة 2")
تأكد_يساوي(ف(16), 1441, "حالة 3")
تأكد_يساوي(ف(100), 338295, "حالة 4")
