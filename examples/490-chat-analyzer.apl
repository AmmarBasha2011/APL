# مثال 490 — محلل سجل محادثة
# Chat log analyzer
# Demonstrates: نشاط المستخدمين
#
# Run:  python apl.py examples/490-chat-analyzer.apl

اكتب("/tmp/apl-490.log", "عمار: أهلا بالجميع\nسارة: أهلا عمار\nعمار: كيف الحال؟\nخالد: مساء الخير\nعمار: تمام")

المتغير نشاط = {}
المتغير سطور = اقرأ("/tmp/apl-490.log").تقليم().تقسيم("\n")
لكل سطر in سطور:
    المتغير موضع = سطر.find(":")
    المتغير اسم = سطر[0:موضع]
    المتغير قديم = نشاط.get(اسم, 0)
    نشاط[اسم] = قديم + 1

اطبع "عدد الرسائل:", طول(سطور)
لكل اسم في نشاط.keys():
    اطبع اسم, "أرسل", نشاط[اسم], "رسائل"

احذف_ملف("/tmp/apl-490.log")
