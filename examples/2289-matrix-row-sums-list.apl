# مثال 2289 — مجاميع الصفوف
# Row sums
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2289-matrix-row-sums-list.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ر = []
  لكل ص في م:
    ر = ر + [sum(ص)]
  ارجع ر

تأكد_يساوي(ف([[1, 2], [3, 4]]), [3, 7], "حالة 1")
تأكد_يساوي(ف([[5]]), [5], "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [6, 15, 24], "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), [1, 1], "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), [1, 4, 3], "حالة 5")
