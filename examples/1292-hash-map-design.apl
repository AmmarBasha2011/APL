# مثال 1292 — خريطة تجزئة يدوية
# Design a hash map from buckets
# Demonstrates: جداول تجزئة
#
# Run:  python apl.py examples/1292-hash-map-design.apl

# نوزع المفاتيح على سطول بباقي القسمة
# ولكل سطل قائمة أزواج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف خريطة:
  دالة_إنشاء(ذات):
    ذات.سطول = []
    لكل ع في نطاق(7):
      ذات.سطول.ألحق([])

  دالة ضع(ذات, م, ق):
    س = ذات.سطول[م % 7]
    لكل ز في س:
      لو ز[0] == م:
        ز[1] = ق
        ارجع 0
    س.ألحق([م, ق])
    ارجع 0

  دالة جلب(ذات, م):
    لكل ز في ذات.سطول[م % 7]:
      لو ز[0] == م:
        ارجع ز[1]
    ارجع -1

  دالة ازل(ذات, م):
    س = ذات.سطول[م % 7]
    لكل ع في نطاق(طول(س)):
      لو س[ع][0] == م:
        س.pop(ع)
        ارجع صواب
    ارجع خطأ

خ = خريطة()
خ.ضع(1, 10)
خ.ضع(8, 80)
خ.ضع(15, 150)
تأكد_يساوي(خ.جلب(8), 80, "نفس السطل")
خ.ضع(8, 88)
تأكد_يساوي(خ.جلب(8), 88, "تحديث")
تأكد_يساوي(خ.ازل(1), صواب, "إزالة")
تأكد_يساوي(خ.جلب(1), -1, "غير موجود")
تأكد_يساوي(خ.جلب(15), 150, "باقٍ")
