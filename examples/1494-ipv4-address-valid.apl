# مثال 1494 — عنوان IPv4 صحيح
# Validate IPv4 address
# Demonstrates: تحليل
#
# Run:  python apl.py examples/1494-ipv4-address-valid.apl

# نفصل على النقاط
# نرفض الجزء الفارغ والأصفار البادئة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عنوان_صحيح(نص_):
  أجزاء = نص_.split(".")
  لو طول(أجزاء) != 4:
    ارجع خطأ
  لكل ج في أجزاء:
    لو ج == "" أو ج.isdigit() == خطأ:
      ارجع خطأ
    لو طول(ج) > 1 و ج[0] == "0":
      ارجع خطأ
    لو صحيح(ج) > 255:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(عنوان_صحيح("192.168.1.1"), صواب, "صحيح")
تأكد_يساوي(عنوان_صحيح("256.1.1.1"), خطأ, "كبير")
تأكد_يساوي(عنوان_صحيح("1.2.3"), خطأ, "ناقص")
تأكد_يساوي(عنوان_صحيح("01.2.3.4"), خطأ, "صفر بادئ")
