# مثال 1919 — اجتياز المصفوفة حلزونيا
# Traverse matrix in spiral order
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1919-matrix-spiral-order-traverse.apl

# نمشي على الحافة العليا ثم اليمنى
# نضيق الحدود بعد كل ضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حلزوني(م):
  خرج = []
  أعلى = 0
  أسفل = طول(م) - 1
  يسار = 0
  يمين = طول(م[0]) - 1
  طالما أعلى <= أسفل و يسار <= يمين:
    لكل ج في نطاق(يسار, يمين + 1):
      خرج = خرج + [م[أعلى][ج]]
    أعلى = أعلى + 1
    لكل ص في نطاق(أعلى, أسفل + 1):
      خرج = خرج + [م[ص][يمين]]
    يمين = يمين - 1
    لو أعلى <= أسفل:
      لكل ج في نطاق(يمين, يسار - 1, -1):
        خرج = خرج + [م[أسفل][ج]]
      أسفل = أسفل - 1
    لو يسار <= يمين:
      لكل ص في نطاق(أسفل, أعلى - 1, -1):
        خرج = خرج + [م[ص][يسار]]
      يسار = يسار + 1
  ارجع خرج

تأكد_يساوي(حلزوني([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [1, 2, 3, 6, 9, 8, 7, 4, 5], "٣ في ٣")
تأكد_يساوي(حلزوني([[1, 2, 3, 4]]), [1, 2, 3, 4], "صف")
تأكد_يساوي(حلزوني([[1], [2], [3]]), [1, 2, 3], "عمود")
