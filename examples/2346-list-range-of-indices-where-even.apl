# مثال 2346 — مواضع القيم الزوجية
# Indices of even values
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2346-list-range-of-indices-where-even.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ي في نطاق(طول(ق)):
    لو ق[ي] % 2 == 0:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3, 4]), [1, 3], "حالة 1")
تأكد_يساوي(ف([1, 3]), [], "حالة 2")
تأكد_يساوي(ف([2]), [0], "حالة 3")
تأكد_يساوي(ف([0, 0, 1]), [0, 1], "حالة 4")
