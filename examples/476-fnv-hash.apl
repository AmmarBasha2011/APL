# مثال 476 — دالة تجزية يدوية
# Manual FNV hash
# Demonstrates: خوارزمية FNV-1a
#
# Run:  python apl.py examples/476-fnv-hash.apl

دالة تجزئة(نص_الدخل):
    المتغير ناتج = 2166136261
    لكل حرف في نص_الدخل:
        ناتج = ناتج ^ ترميز_حرف(حرف)
        ناتج = (ناتج * 16777619) % 4294967296
    ارجع ناتج

اطبع تجزئة("hello")
اطبع تجزئة("hello")
اطبع تجزئة("world")
