# مثال 838 — تحليل تشوليسكي
# Cholesky decomposition
# Demonstrates: A = L @ L^T، موجبة التعريف
#
# Run:  python apl.py examples/838-cholesky-decomposition.apl

# تحليل تشوليسكي: A = L @ L^T للمصفوفات المتماثلة الموجبة التعريف
# أسرع من LU بمرتين لهذه الفئة من المصفوفات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تحليل_تشوليسكي(مصفوفة):
  ن = طول(مصفوفة)
  ل = []
  لكل _ في نطاق(ن):
    صف = []
    لكل __ في نطاق(ن):
      صف.ألحق(0.0)
    ل.ألحق(صف)
  لكل i في نطاق(ن):
    لكل ج في نطاق(i + 1):
      مجموع = 0.0
      لكل ك في نطاق(ج):
        مجموع = مجموع + ل[i][ك] * ل[ج][ك]
      لو i == ج:
        ل[i][ج] = جذر(مصفوفة[i][i] - مجموع)
      والا:
        ل[i][ج] = (مصفوفة[i][ج] - مجموع) / ل[ج][ج]
  ارجع ل

أ = [
  [4.0, 2.0],
  [2.0, 3.0]
]
ل = تحليل_تشوليسكي(أ)
اطبع "L =", ل

تأكد_يساوي(ل[0][0], 2.0, "ل[0][0]")
تأكد_يساوي(ل[1][0], 1.0, "ل[1][0]")
تأكد_يساوي(مقرب(ل[1][1], 5), 1.41421, "ل[1][1] = جذر(2)")

# تحقق: L @ L^T = A
ناتج00 = ل[0][0]*ل[0][0] + ل[0][1]*ل[0][1]
ناتج01 = ل[0][0]*ل[1][0] + ل[0][1]*ل[1][1]
ناتج11 = ل[1][0]*ل[1][0] + ل[1][1]*ل[1][1]
تأكد_يساوي(ناتج00, 4.0, "L@L^T يعيد أ[0][0]")
تأكد_يساوي(ناتج01, 2.0, "L@L^T يعيد أ[0][1]")
تأكد_يساوي(مقرب(ناتج11, 9), 3.0, "L@L^T يعيد أ[1][1]")
