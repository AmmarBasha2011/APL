# مثال 1301 — حلقة في قائمة
# Linked list cycle using next array
# Demonstrates: فلويد
#
# Run:  python apl.py examples/1301-linked-list-cycle-array.apl

# كل عقدة لها فهرس التالي
# مؤشر سريع وبطيء يلتقيان لو وجدت حلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فيها_حلقة(تالي, بداية):
  بطيء = بداية
  سريع = بداية
  طالما (سريع != -1) و (تالي[سريع] != -1):
    بطيء = تالي[بطيء]
    سريع = تالي[تالي[سريع]]
    لو بطيء == سريع:
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(فيها_حلقة([1, 2, 3, 1], 0), صواب, "حلقة")
تأكد_يساوي(فيها_حلقة([1, 2, 3, -1], 0), خطأ, "بلا حلقة")
تأكد_يساوي(فيها_حلقة([0], 0), صواب, "حلقة ذاتية")
تأكد_يساوي(فيها_حلقة([-1], 0), خطأ, "عقدة وحيدة")
