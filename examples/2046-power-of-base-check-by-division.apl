# مثال 2046 — هل العدد قوة للأساس
# Power of base check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/2046-power-of-base-check-by-division.apl

# # القوة تنتهي إلى 1 بعد القسمة المتكررة
# # الأعداد غير الموجبة مرفوضة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة(ن, ا):
  لو ن < 1:
    ارجع خطأ
  طالما ن % ا == 0:
    ن = ن // ا
  ارجع ن == 1

تأكد_يساوي(قوة(27, 3), صواب, "٢٧")
تأكد_يساوي(قوة(45, 3), خطأ, "٤٥")
تأكد_يساوي(قوة(64, 4), صواب, "٦٤")
تأكد_يساوي(قوة(8, 4), خطأ, "٨")
تأكد_يساوي(قوة(1, 5), صواب, "١")
تأكد_يساوي(قوة(0, 2), خطأ, "صفر")
