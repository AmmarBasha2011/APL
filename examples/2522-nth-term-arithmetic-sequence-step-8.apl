# مثال 2522 — الحد النوني بخطوة 8
# Nth term step 8
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2522-nth-term-arithmetic-sequence-step-8.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 8

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 11, "حالة 2")
تأكد_يساوي(ف(10), 75, "حالة 3")
تأكد_يساوي(ف(100), 795, "حالة 4")
