# مثال 628 — مطابقة glob
# Glob matching
# Demonstrates: نجمة، استفهام، أنماط ملفات
#
# Run:  python apl.py examples/628-glob-match.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مطابقة أنماط glob: النجمة وعلامة الاستفهام
# Demonstrates: مطابقة عودية, نجمة متعددة الأحرف, استفهام أحادي
# نفس منطق أسماء الملفات في الأنظمة

دالة طابق(نمط, نص):
  لو نمط == "":
    ارجع نص == ""
  لو نمط[0] == "*":
    لكل ك في نطاق(طول(نص) + 1):
      لو طابق(نمط[1:], نص[ك:]):
        ارجع صواب
    ارجع خطأ
  لو نص == "":
    ارجع خطأ
  لو نمط[0] == "?" أو نمط[0] == نص[0]:
    ارجع طابق(نمط[1:], نص[1:])
  ارجع خطأ

تأكد_يساوي(طابق("*.apl", "test.apl"), صواب, "امتداد")
تأكد_يساوي(طابق("*.apl", "test.py"), خطأ, "امتداد مختلف")
تأكد_يساوي(طابق("م?رحبا", "مرحبا"), خطأ, "استفهام يتطلب حرفا")
تأكد_يساوي(طابق("م?رحبا", "مبرحبا"), صواب, "استفهام يطابق حرفا")
تأكد_يساوي(طابق("*", "أي شيء"), صواب, "نجمة وحدها")
تأكد_يساوي(طابق("abc*def", "abcdef"), صواب, "نجمة صفرية")
اطبع "*.apl مع test.apl:", طابق("*.apl", "test.apl")
