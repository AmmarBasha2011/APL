# مثال 60 — أدوات الشبكة بلا اتصال: عناوين IP، تغليف ثنائي، ترميزات، أنواع ملفات
# Offline network toolkit: IP math, struct packing, encodings, MIME types
# Demonstrates: عنوان_ip, شبكة_ip, عنوان_خاص, حدود_الشبكة, شبكات_فرعية,
#               حزمة_ثنائية, فك_حزمة_ثنائية, بايتات_إلى_قاعدة64,
#               بايتات_إلى_سدّس, ضغط_zlib, فك_zlib, نوع_الملف_من_الاسم,
#               منفذ_الخدمة, عنوان_إلى_بايتات, بيانات_الاسم
#
# Run:  python apl.py examples/60-net-tools.apl

# ---------- 1) حسابات العناوين ----------
اطبع "=== 1) عناوين IP ==="
المتغير عناوين = ["192.168.1.10", "10.0.0.5", "8.8.8.8", "127.0.0.1"]
لكل خام في عناوين:
    المتغير ع = عنوان_ip(خام)
    اطبع "  " + خام + " | خاص: " + نص(ع.عنوان_خاص) + " | عام: " + نص(ع.عنوان_عام)

المتغير شبكة = شبكة_ip("192.168.1.0/24")
اطبع "الشبكة: " + نص(شبكة)
اطبع "القناع: " + نص(شبكة.قناع_الشبكة)
اطبع "البث: " + نص(شبكة.بث_الشبكة)
اطبع "عدد الأجهزة: " + نص(طول(قائمة(شبكة.حدود_الشبكة())))

اطبع "التقسيم إلى /26:"
لكل جزء في شبكة.شبكات_فرعية(new_prefix = 26):
    اطبع "  " + نص(جزء)

اطبع "هل 192.168.1.10 داخل الشبكة؟ " + نص(شبكة.عنوان_ضمن_شبكة(عنوان_ip("192.168.1.10")))

# ---------- 2) تغليف ثنائي ----------
اطبع "=== 2) تغليف ثنائي (struct) ==="
المتغير حزمة = حزمة_ثنائية("!iih", 2026, 11, 20)
اطبع "الحجم: " + نص(طول(حزمة)) + " بايت (المتوقع " + نص(احسب_حجم_الصيغة("!iih")) + ")"
المتغير سنة, شهر, يوم = فك_حزمة_ثنائية("!iih", حزمة)
اطبع "التاريخ: " + نص(يوم) + "/" + نص(شهر) + "/" + نص(سنة)

# ---------- 3) الترميزات ----------
اطبع "=== 3) الترميزات ==="
المتغير خام_نص = "أهلاً بالشبكة العربية".encode()
اطبع "الطول الأصلي: " + نص(طول(خام_نص))
اطبع "base64: " + بايتات_إلى_قاعدة64(خام_نص).decode()
اطبع "سدّس: " + بايتات_إلى_سدّس(خام_نص).decode()

المتغير مضغوط = ضغط_zlib(خام_نص * 30)
اطبع "قبل الضغط: " + نص(طول(خام_نص * 30)) + " | بعد: " + نص(طول(مضغوط))
اطبع "فك الضغط سليم: " + نص(فك_zlib(مضغوط) == خام_نص * 30)
اطبع "crc32: " + نص(تحقق_دوري(خام_نص))

# ---------- 4) أنواع الملفات ----------
اطبع "=== 4) أنواع الملفات ==="
المتغير أسماء = ["تقرير.pdf", "صورة.png", "بيانات.csv", "صفحة.html", "ملف.غريب"]
لكل اسم في أسماء:
    اطبع "  " + اسم + " -> " + نص(نوع_الملف_من_الاسم(اسم)[0])

# ---------- 5) الخدمات والأسماء ----------
اطبع "=== 5) الخدمات المعروفة ==="
لكل خدمة في ["http", "https", "smtp", "imap", "ftp"]:
    اطبع "  " + خدمة + " -> منفذ " + نص(منفذ_الخدمة(خدمة))

اطبع "localhost -> " + عنوان_الاسم("localhost")
اطبع "بايتات 127.0.0.1: " + نص(بايتات_إلى_سدّس(عنوان_إلى_بايتات("127.0.0.1")).decode())
اطبع "عدد صيغ الاتصال لـ localhost:80: " + نص(طول(بيانات_العنوان("localhost", 80)))

# ---------- 6) أدوات نصية للشبكة ----------
اطبع "=== 6) أدوات إضافية ==="
اطبع "quoted-printable: " + شفّر_نص_قديم("سعر 50% فقط".encode()).decode()
اطبع "IPv6 مضغوط: " + عنوان_ip("2001:0db8:0000:0000:0000:0000:0000:0001").مضغوط_العنوان
اطبع "IPv4 داخل IPv6: " + نص(عنوان_ip("::ffff:192.168.0.1").عنوان_مضمن_ipv4)

اطبع "تم."
