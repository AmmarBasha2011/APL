# مثال 3708 — الحد النوني بخطوة 48
# Nth term step 48
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3708-nth-term-arithmetic-sequence-step-48.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 48

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 51, "حالة 2")
تأكد_يساوي(ف(10), 435, "حالة 3")
تأكد_يساوي(ف(100), 4755, "حالة 4")
