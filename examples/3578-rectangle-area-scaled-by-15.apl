# مثال 3578 — مساحة مستطيل مكبر 15 مرات
# Rectangle area scaled by 15
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3578-rectangle-area-scaled-by-15.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 15) * (ق[1] * 15)

تأكد_يساوي(ف([1, 2]), 450, "حالة 1")
تأكد_يساوي(ف([3, 4]), 2700, "حالة 2")
تأكد_يساوي(ف([5, 5]), 5625, "حالة 3")
تأكد_يساوي(ف([10, 1]), 2250, "حالة 4")
