# مثال 2940 — متتالية أ=3×السابق+1
# Recurrence times 3 plus one
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/2940-linear-recurrence-a-n-equals-3-times-previous-plus-one.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 1
  لكل ي في نطاق(ن):
    أ = أ * 3 + 1
  ارجع أ

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 4, "حالة 2")
تأكد_يساوي(ف(2), 13, "حالة 3")
تأكد_يساوي(ف(5), 364, "حالة 4")
تأكد_يساوي(ف(8), 9841, "حالة 5")
