# مثال 2107 — أعداد كابريكار بتقسيم المربع
# Kaprekar number split check
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2107-kaprekar-number-split-square-check.apl

# # الجزء الأيمن لا يكون صفرا
# # والعدد 1 حالة خاصة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كابريكار(ن):
  لو ن == 1:
    ارجع صواب
  م = نص(ن * ن)
  لكل ك في نطاق(1, طول(م)):
    ي = int(م[:ك])
    ل = int(م[ك:])
    لو ل > 0 و ي + ل == ن:
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(كابريكار(9), صواب, "٩")
تأكد_يساوي(كابريكار(45), صواب, "٤٥")
تأكد_يساوي(كابريكار(297), صواب, "٢٩٧")
تأكد_يساوي(كابريكار(10), خطأ, "١٠")
تأكد_يساوي(كابريكار(1), صواب, "١")
