# مثال 553 — اختبار ميلر-رابين
# Miller-Rabin primality
# Demonstrates: أولية، ميلر-رابين، أس نمطي
#
# Run:  python apl.py examples/553-miller-rabin.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# اختبار ميلر-رابين للأولية بقواعد حتمية للأعداد الصغيرة
دالة أولي_ميلر(ن):
    لو ن < 2:
        ارجع خطأ
    لكل أول في [2, 3, 5, 7, 11]:
        لو ن == أول:
            ارجع صواب
        لو (ن % أول) == 0:
            ارجع خطأ
    المتغير د = ن - 1
    المتغير ر = 0
    طالما (د % 2) == 0:
        د = د // 2
        ر = ر + 1
    لكل أساس في [2, 3, 5, 7, 11]:
        المتغير س = قوة(أساس, د, ن)
        لو س != 1 و س != ن - 1:
            المتغير مركب = صواب
            لكل i في نطاق(ر - 1):
                س = (س * س) % ن
                لو س == ن - 1:
                    مركب = خطأ
            لو مركب:
                ارجع خطأ
    ارجع صواب

تأكد_يساوي(أولي_ميلر(104729), صواب, "104729 أولي")
تأكد_يساوي(أولي_ميلر(561), خطأ, "561 عدد كارمايكل مركب")
تأكد_يساوي(أولي_ميلر(104730), خطأ, "104730 مركب")
تأكد_يساوي(أولي_ميلر(2), صواب, "2 أولي")
