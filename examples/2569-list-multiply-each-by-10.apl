# مثال 2569 — ضرب كل عنصر في 10
# Multiply each item by 10
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2569-list-multiply-each-by-10.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 10]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [30, 10, 20], "حالة 1")
تأكد_يساوي(ف([5]), [50], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [10, 20, 30, 40, 50, 60], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-20, 0, 70, 70, 40], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [100, 200, 100, 300, 200, 100], "حالة 5")
