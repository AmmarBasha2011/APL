# مثال 1176 — موعد مشترك
# Common meeting slot
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1176-meeting-scheduler-slot.apl

# نمشي على الجدولين المرتبين
# ونقارن تقاطع الفترتين بالمدة المطلوبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فترة_مشتركة(أ, ب, مدة):
  ي = 0
  ك = 0
  طالما (ي < طول(أ)) و (ك < طول(ب)):
    بداية = أكبر(أ[ي][0], ب[ك][0])
    نهاية = أصغر(أ[ي][1], ب[ك][1])
    لو نهاية - بداية >= مدة:
      ارجع [بداية, بداية + مدة]
    لو أ[ي][1] < ب[ك][1]:
      ي = ي + 1
    والا:
      ك = ك + 1
  ارجع []

أ = [[10,50],[60,120],[140,210]]
ب = [[0,15],[60,70]]
تأكد_يساوي(فترة_مشتركة(أ, ب, 8), [60, 68], "ثماني دقائق")
تأكد_يساوي(فترة_مشتركة(أ, ب, 12), [], "لا فترة")
تأكد_يساوي(فترة_مشتركة([[0,10]], [[0,10]], 10), [0, 10], "كاملة")
