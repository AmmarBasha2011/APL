# مثال 120 — توليد روابط صديقة من العناوين
# Slug generation from titles
# Demonstrates: دوال، دوال النصوص، حلقات
#
# Run:  python apl.py examples/120-text-slug.apl

دالة رابط_صديق(عنوان):
    المتغير نتيجة = عنوان.سفلي()
    نتيجة = نتيجة.تقليم()
    نتيجة = نتيجة.استبدال(" ", "-")
    المتغير نظيف = ""
    لكل حرف في نتيجة:
        لو حرف في حروف_انجليزية أو حرف في أرقام_ثابتة أو حرف == "-":
            نظيف = نظيف + حرف
    ارجع نظيف

المتغير عناوين = ["Hello World 2026", "New APL Release!", "  spaced out  "]
لكل عنوان في عناوين:
    اطبع عنوان, "->", رابط_صديق(عنوان)
