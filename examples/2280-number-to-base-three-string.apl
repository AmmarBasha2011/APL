# مثال 2280 — عدد إلى الأساس ثلاثة
# Number to base three
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2280-number-to-base-three-string.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع "0"
  خ = ""
  طالما ن > 0:
    خ = نص(ن % 3) + خ
    ن = ن // 3
  ارجع خ

تأكد_يساوي(ف(0), "0", "حالة 1")
تأكد_يساوي(ف(2), "2", "حالة 2")
تأكد_يساوي(ف(3), "10", "حالة 3")
تأكد_يساوي(ف(10), "101", "حالة 4")
تأكد_يساوي(ف(100), "10201", "حالة 5")
