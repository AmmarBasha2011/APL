# مثال 3832 — آخر رقم من ن×16
# Last digit of n times 16
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3832-last-digit-of-n-times-16.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 16) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 6, "حالة 2")
تأكد_يساوي(ف(7), 2, "حالة 3")
تأكد_يساوي(ف(12), 2, "حالة 4")
تأكد_يساوي(ف(99), 4, "حالة 5")
