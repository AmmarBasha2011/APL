# مثال 2043 — جمع عددين عشريين نصيين يدويا
# Add decimal strings
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2043-add-decimal-strings-manual-carry.apl

# # يصلح لأعداد أكبر من حدود الأنواع الثابتة
# # نجمع من اليمين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اجمع(ا, ب):
  ي = طول(ا) - 1
  ل = طول(ب) - 1
  حمل = 0
  خرج = ""
  طالما ي >= 0 أو ل >= 0 أو حمل > 0:
    م = حمل
    لو ي >= 0:
      م = م + int(ا[ي])
      ي = ي - 1
    لو ل >= 0:
      م = م + int(ب[ل])
      ل = ل - 1
    خرج = نص(م % 10) + خرج
    حمل = م // 10
  ارجع خرج

تأكد_يساوي(اجمع("999", "1"), "1000", "حمل متسلسل")
تأكد_يساوي(اجمع("123", "456"), "579", "بلا حمل")
تأكد_يساوي(اجمع("0", "0"), "0", "صفران")
تأكد_يساوي(اجمع("99999999999999999999", "1"), "100000000000000000000", "كبير")
