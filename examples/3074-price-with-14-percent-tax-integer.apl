# مثال 3074 — السعر مع ضريبة 14 بالمئة
# Price with 14 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3074-price-with-14-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 14 // 100

تأكد_يساوي(ف(100), 114, "حالة 1")
تأكد_يساوي(ف(250), 285, "حالة 2")
تأكد_يساوي(ف(999), 1138, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
