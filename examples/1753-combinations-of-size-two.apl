# مثال 1753 — كل أزواج القائمة
# All pairs from a list
# Demonstrates: توافيق
#
# Run:  python apl.py examples/1753-combinations-of-size-two.apl

# حلقتان متداخلتان
# الثانية تبدأ بعد الأولى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أزواج(ق):
  ناتج = []
  لكل ي في نطاق(طول(ق)):
    لكل ك في نطاق(ي + 1, طول(ق)):
      ناتج.append([ق[ي], ق[ك]])
  ارجع ناتج

تأكد_يساوي(أزواج([1, 2, 3]), [[1, 2], [1, 3], [2, 3]], "ثلاثة")
تأكد_يساوي(أزواج([1]), [], "عنصر")
تأكد_يساوي(طول(أزواج([1, 2, 3, 4, 5])), 10, "خمسة")
