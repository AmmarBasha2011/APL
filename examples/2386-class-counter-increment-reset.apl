# مثال 2386 — صنف عداد بزيادة وتصفير
# Counter class with reset
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2386-class-counter-increment-reset.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف عداد:
    دالة_إنشاء(ذات):
        ذات.ق = 0

    دالة زد(ذات):
        ذات.ق = ذات.ق + 1

    دالة صفر(ذات):
        ذات.ق = 0

ع = عداد()
ع.زد()
ع.زد()
تأكد_يساوي(ع.ق, 2, "بعد زيادتين")
ع.صفر()
تأكد_يساوي(ع.ق, 0, "بعد التصفير")
