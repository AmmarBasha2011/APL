# مثال 331 — العد التنازلي لعيد الميلاد
# Birthday countdown
# Demonstrates: تاريخ الميلاد القادم
#
# Run:  python apl.py examples/331-next-birthday.apl

المتغير اليوم = التاريخ_اليوم()
المتغير عيد_هذا_العام = تاريخ(اليوم.year, 9, 9)
لو عيد_هذا_العام < اليوم:
    عيد_هذا_العام = تاريخ(اليوم.year + 1, 9, 9)

المتغير باقي = عيد_هذا_العام - اليوم
اطبع "باقي على عيد الميلاد:", باقي.days, "يوما"
اطبع "تاريخه:", عيد_هذا_العام
