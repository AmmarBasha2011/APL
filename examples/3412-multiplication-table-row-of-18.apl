# مثال 3412 — صف جدول ضرب 18
# Multiplication row of 18
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3412-multiplication-table-row-of-18.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 18]
  ارجع ر

تأكد_يساوي(ف(1), [18], "حالة 1")
تأكد_يساوي(ف(5), [18, 36, 54, 72, 90], "حالة 2")
تأكد_يساوي(ف(10), [18, 36, 54, 72, 90, 108, 126, 144, 162, 180], "حالة 3")
