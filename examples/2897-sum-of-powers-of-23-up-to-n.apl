# مثال 2897 — مجموع قوى 23
# Sum of powers of 23
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2897-sum-of-powers-of-23-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 23 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 24, "حالة 2")
تأكد_يساوي(ف(3), 12720, "حالة 3")
تأكد_يساوي(ف(6), 154764793, "حالة 4")
تأكد_يساوي(ف(10), 43309534450633, "حالة 5")
