# مثال 2465 — عدد مضاعفات 6 حتى حد
# Count multiples of 6 up to limit
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2465-count-multiples-of-6-up-to-limit.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(1, ن + 1):
    لو ي % 6 == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(7), 1, "حالة 2")
تأكد_يساوي(ف(12), 2, "حالة 3")
تأكد_يساوي(ف(50), 8, "حالة 4")
تأكد_يساوي(ف(100), 16, "حالة 5")
