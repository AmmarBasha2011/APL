# مثال 717 — هاش مورمر مصغر
# MurmurHash lite
# Demonstrates: دوارات بتية، بذرة، خلط نهائي
#
# Run:  python apl.py examples/717-murmur-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مُرمُر3 المصغر: خلط الجسم والمُنهي fmix32
# Demonstrates: دوران 15, ثوابت مُرمُر, انهيار ثلجي
# توزيع ممتاز بثلاث ضربات في النهاية

دالة م32(س):
  ارجع س % 4294967296

دالة در32(س, ن):
  ارجع م32((س * قوة(2, ن)) + (س // قوة(2, 32 - ن)))

دالة fmix(ح):
  ح = ح ^ (ح // 65536)
  ح = م32(ح * 2246822507)
  ح = ح ^ (ح // 8192)
  ح = م32(ح * 3266489909)
  ح = ح ^ (ح // 65536)
  ارجع ح

دالة مرمر(نص, بذرة):
  ح = بذرة
  لكل ي في نطاق(طول(نص)):
    ك = م32(ترميز_حرف(نص[ي]) * 3432918353)
    ك = در32(ك, 15)
    ك = م32(ك * 461845907)
    ح = ح ^ ك
    ح = در32(ح, 13)
    ح = م32(ح * 5 + 3864292196)
  ح = ح ^ طول(نص)
  ارجع fmix(ح)

ح1 = مرمر("hello", 0)
تأكد_يساوي(ح1, مرمر("hello", 0), "حتمي")
تأكد_يساوي(ح1 != مرمر("hellp", 0), صواب, "حرف واحد يغير")
تأكد_يساوي(مرمر("hello", 1) != ح1, صواب, "البذرة تغير")
تأكد_يساوي(fmix(0), 0, "انهيار الصفر صفر")
بتات = []
لكل ب في نطاق(4):
  أحاد = 0
  لكل ي في نطاق(500):
    ح = مرمر("مفتاح" + نص(ي), 0)
    لو (ح // قوة(2, ب)) % 2 == 1:
      أحاد = أحاد + 1
  بتات.append(أحاد)
تأكد_يساوي(بتات[0] > 200 و بتات[0] < 300, صواب, "البت الأدنى متوازن")
تأكد_يساوي(بتات[3] > 200 و بتات[3] < 300, صواب, "بت عال متوازن")
اطبع "مرمر(hello):", ح1
