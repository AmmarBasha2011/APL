# مثال 109 — الكسور الدقيقة والعمليات عليها
# Exact fraction arithmetic
# Demonstrates: كسر، من_نص_كسر، بسط_كسر، مقام_كسر، حد_المقام، قيمة_كسر
#
# Run:  python apl.py examples/109-fractions-ops.apl

المتغير أ = كسر(1, 3)
المتغير ب = كسر(1, 6)
اطبع "ثلث + سدس =", أ + ب
اطبع "ثلث - سدس =", أ - ب
اطبع "ثلث × سدس =", أ * ب
اطبع "ثلث ÷ سدس =", أ / ب

اطبع ""
المتغير نص = كسر("3/4")
اطبع "من نص 3/4: بسط =", نص.بسط_كسر, "، مقام =", نص.مقام_كسر

اطبع ""
اطبع "22/7 =", قيمة_كسر(كسر(22, 7))
اطبع "ط مقربة لمقام صغير:", كسر(355, 113).حد_المقام(100)
اطبع "مقلوب 3/4 =", مقلوب_كسر(كسر(3, 4))
