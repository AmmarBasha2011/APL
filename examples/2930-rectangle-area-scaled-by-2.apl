# مثال 2930 — مساحة مستطيل مكبر 2 مرات
# Rectangle area scaled by 2
# Demonstrates: هندسة
#
# Run:  python apl.py examples/2930-rectangle-area-scaled-by-2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 2) * (ق[1] * 2)

تأكد_يساوي(ف([1, 2]), 8, "حالة 1")
تأكد_يساوي(ف([3, 4]), 48, "حالة 2")
تأكد_يساوي(ف([5, 5]), 100, "حالة 3")
تأكد_يساوي(ف([10, 1]), 40, "حالة 4")
