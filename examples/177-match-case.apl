# مثال 177 — التطابق بالحالات (match/case)
# Pattern matching with match/case
# Demonstrates: حالة، قيمة، افتراضي
#
# Run:  python apl.py examples/177-match-case.apl

دالة صف_درجة(درجة):
    حالة درجة:
        قيمة 10:
            ارجع "ممتاز"
        قيمة 9:
            ارجع "ممتاز"
        قيمة 8:
            ارجع "جيد جدا"
        قيمة 7:
            ارجع "جيد"
        افتراضي:
            ارجع "يحتاج تحسينا"

لكل د في [10, 8, 7, 4]:
    اطبع د, "->", صف_درجة(د)

دالة نوع_يوم(رقم):
    حالة رقم:
        قيمة 1:
            ارجع "بداية الأسبوع"
        قيمة 5:
            ارجع "نهاية الأسبوع"
        قيمة 6:
            ارجع "عطلة"
        قيمة 7:
            ارجع "عطلة"
        افتراضي:
            ارجع "يوم عادي"

اطبع نوع_يوم(6)
اطبع نوع_يوم(3)
