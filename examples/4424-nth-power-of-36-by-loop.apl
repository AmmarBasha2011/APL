# مثال 4424 — قوة 36 بالحلقة
# Power of 36 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4424-nth-power-of-36-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 36
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 36, "حالة 2")
تأكد_يساوي(ف(3), 46656, "حالة 3")
تأكد_يساوي(ف(6), 2176782336, "حالة 4")
تأكد_يساوي(ف(10), 3656158440062976, "حالة 5")
