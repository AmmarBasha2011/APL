# مثال 174 — إشارة بين خيطين
# Signalling between threads with Event
# Demonstrates: أنشئ_حدث، انتظر_حدث_خيوط، أطلق_حدث_خيوط
#
# Run:  python apl.py examples/174-threading-event.apl

المتغير حدث = أنشئ_حدث()

دالة منتظر():
    اطبع "المنتظر: بانتظار الإشارة..."
    حدث.wait()
    اطبع "المنتظر: وصلت الإشارة!"

دالة مرسل():
    نوم_خيوط(0.05)
    اطبع "المرسل: أرسل الإشارة"
    حدث.set()

المتغير أ = أنشئ_ثريد(target=منتظر)
المتغير ب = أنشئ_ثريد(target=مرسل)
أ.start()
ب.start()
أ.join()
ب.join()
اطبع "انتهى البرنامج."
