# مثال 4426 — قوة 38 بالحلقة
# Power of 38 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4426-nth-power-of-38-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 38
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 38, "حالة 2")
تأكد_يساوي(ف(3), 54872, "حالة 3")
تأكد_يساوي(ف(6), 3010936384, "حالة 4")
تأكد_يساوي(ف(10), 6278211847988224, "حالة 5")
