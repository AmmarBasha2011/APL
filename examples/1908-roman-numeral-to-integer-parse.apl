# مثال 1908 — تحويل الأرقام الرومانية لعدد
# Parse Roman numeral to integer
# Demonstrates: تحويل
#
# Run:  python apl.py examples/1908-roman-numeral-to-integer-parse.apl

# نقرأ الرموز من اليسار
# نطرح الرمز إن جاء بعده أكبر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قيمة(ح):
  لو ح == "I":
    ارجع 1
  لو ح == "V":
    ارجع 5
  لو ح == "X":
    ارجع 10
  لو ح == "L":
    ارجع 50
  لو ح == "C":
    ارجع 100
  لو ح == "D":
    ارجع 500
  ارجع 1000

دالة روماني(س):
  كلي = 0
  لكل ك في نطاق(طول(س)):
    ق = قيمة(س[ك])
    لو ك + 1 < طول(س) و قيمة(س[ك + 1]) > ق:
      كلي = كلي - ق
    والا:
      كلي = كلي + ق
  ارجع كلي

تأكد_يساوي(روماني("III"), 3, "ثلاثة")
تأكد_يساوي(روماني("IX"), 9, "تسعة")
تأكد_يساوي(روماني("MCMXCIV"), 1994, "١٩٩٤")
