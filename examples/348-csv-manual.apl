# مثال 348 — قراءة CSV يدويا
# Manual CSV parsing
# Demonstrates: تقسيم وتجميع بلا مكتبة
#
# Run:  python apl.py examples/348-csv-manual.apl

المتغير مسار = "/tmp/apl_csv_348.csv"
اكتب(مسار, "الاسم,العمر,المدينة\nأحمد,30,القاهرة\nسارة,25,الإسكندرية\nخالد,35,المنصورة\n")

المتغير سطور = اقرأ(مسار).تقليم().تقسيم("\n")
المتغير عناوين = سطور[0].تقسيم(",")
اطبع "الأعمدة:", عناوين

لكل ي في نطاق(1, طول(سطور)):
    المتغير خلايا = سطور[ي].تقسيم(",")
    اطبع خلايا[0], "-", خلايا[1], "سنة -", خلايا[2]

احذف_ملف(مسار)
