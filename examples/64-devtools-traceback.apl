# مثال 64 — تتبع الأخطاء واختبارات الوثائق (مكتبة devtools)
# Tracebacks (traceback) and documentation tests (doctest) in Arabic
#
# Run:  python apl.py examples/64-devtools-traceback.apl

اطبع "=== تتبع الخطأ (traceback) ==="
حاول:
    المتغير ص = 1 / 0
إمسك مثل الخطأ:
    اطبع "نسّق_الاستثناء_الحالي:"
    اطبع نسّق_الاستثناء_الحالي()
    اطبع "نوع استخرج_المكدس:", نص(نوع(استخرج_المكدس()))
    اطبع "نوع استخرج_التتبع:", نص(نوع(استخرج_التتبع(الخطأ.__traceback__)))

اطبع ""
اطبع "=== اختبارات الوثائق (doctest) ==="
اطبع "هو_دالة(اختبر_وحدة):", هو_دالة(اختبر_وحدة)
اطبع "هو_دالة(اختبر_مصدر):", هو_دالة(اختبر_مصدر)
اطبع "هو_دالة(اختبر_ملف):", هو_دالة(اختبر_ملف)
اطبع "هو_صنف(اختبار_توثيقي):", هو_صنف(اختبار_توثيقي)
اطبع "هو_صنف(مثال_توثيقي):", هو_صنف(مثال_توثيقي)
اطبع "خيار_الحذف:", خيار_الحذف
اطبع "علامة_الحذف:", علامة_الحذف
اطبع "نتيجة_اختبار صفرية:", نتائج_الاختبار(0, 0)
