# مثال 225 — ضغط طول التكرار
# Run-length encoding
# Demonstrates: عد متتاليات، ضغط وفك
#
# Run:  python apl.py examples/225-run-length.apl

دالة اضغط(نص_الدخل):
    لو طول(نص_الدخل) == 0:
        ارجع ""
    المتغير نتيجة = ""
    المتغير عدد = 1
    لكل ي في نطاق(1, طول(نص_الدخل)):
        لو نص_الدخل[ي] == نص_الدخل[ي - 1]:
            عدد = عدد + 1
        الا:
            نتيجة = نتيجة + نص_الدخل[ي - 1] + نص(عدد)
            عدد = 1
    نتيجة = نتيجة + نص_الدخل[-1] + نص(عدد)
    ارجع نتيجة

اطبع "aaabbc ->", اضغط("aaabbc")
اطبع "xxxxxy ->", اضغط("xxxxxy")
اطبع "a ->", اضغط("a")
