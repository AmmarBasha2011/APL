# مثال 61 — فحص الكائنات بالعربي (مكتبة devtools)
# Object introspection with the Arabic devtools library (inspect)
#
# Run:  python apl.py examples/61-devtools-inspect.apl

دالة ضرب(س, ص):
    ارجع س * ص

دالة ارفع(س, ن):
    ارجع س ** ن

اطبع "=== توقيع الدوال ==="
اطبع "توقيع_الدالة(ضرب):", توقيع_الدالة(ضرب)
المتغير توقيع = توقيع_الدالة(ضرب)
اطبع "المعاملات:", توقيع.المعاملات
اطبع "تعليق_الإرجاع_النوعي:", توقيع.تعليق_الإرجاع_النوعي
اطبع "توقيع_الدالة(ارفع):", توقيع_الدالة(ارفع)

اطبع ""
اطبع "=== فحص النوع ==="
اطبع "هو_دالة(ضرب):", هو_دالة(ضرب)
اطبع "هو_صنف(ضرب):", هو_صنف(ضرب)
اطبع "هو_إجراء(ضرب):", هو_إجراء(ضرب)
اطبع "هو_مجرد(ضرب):", هو_مجرد(ضرب)
اطبع "هو_مضمّنة(ضرب):", هو_مضمّنة(ضرب)

اطبع ""
اطبع "=== أعضاء الكائن ==="
المتغير أعضاء = أعضاء_الكائن(ضرب)
اطبع "عدد الأعضاء:", طول(أعضاء)
المتغير أول_عضو = أعضاء[0]
اطبع "أول عضو:", أول_عضو[0]

اطبع ""
اطبع "=== الأصناف ==="
صنف قاعدة_صنف:
    دالة_إنشاء(ذات, قيمة):
        ذات.قيمة = قيمة

    دالة استعرض(ذات):
        ارجع "القيمة=" + نص(ذات.قيمة)

اطبع "هو_صنف(قاعدة_صنف):", هو_صنف(قاعدة_صنف)
اطبع "ترتيب_حل_الدوال(قاعدة_صنف):", ترتيب_حل_الدوال(قاعدة_صنف)
اطبع "شجرة_الأصناف([قاعدة_صنف]):", شجرة_الأصناف([قاعدة_صنف])
اطبع "واصفات_الصنف(قاعدة_صنف):", طول(واصفات_الصنف(قاعدة_صنف))

اطبع ""
اطبع "=== حجج الدالة ==="
اطبع "مواصفات_الحجج(ضرب):", مواصفات_الحجج(ضرب)
اطبع "حجج_الاستدعاء(ضرب, 2, 3):", حجج_الاستدعاء(ضرب, 2, 3)
اطبع "قيم_الحجج(الإطار_الحالي()):", نوع(قيم_الحجج(الإطار_الحالي()))
