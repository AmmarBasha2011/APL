# مثال 132 — المسارات ككائنات
# Paths as objects with pathlib
# Demonstrates: مسار_جديد، ادمج، مسار_اسم، مسار_امتداد، موجود_له
#
# Run:  python apl.py examples/132-pathlib-ops.apl

المتغير م = مسار_جديد("/tmp/apl_demo/تقارير/شهرى.txt")
اطبع "الاسم:", م.مسار_اسم
اطبع "بدون امتداد:", م.مسار_بدون_امتداد
اطبع "الامتداد:", م.مسار_امتداد
اطبع "الأب:", م.مسار_أبوين

المتغير مجلد = مسار_جديد("/tmp").ادمج("apl_demo")
اطبع "مدمج:", مجلد
اطبع "موجود؟", مجلد.موجود_له()
اطبع "المسار الحالي:", المسار_الحالي()
