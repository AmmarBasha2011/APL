# مثال 2175 — مجموع المكعبات الأولى
# Sum of first n cubes
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2175-sum-of-cubes-first-n-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن + 1):
    م = م + ي ** 3
  ارجع م

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(3), 36, "حالة 3")
تأكد_يساوي(ف(5), 225, "حالة 5")
تأكد_يساوي(ف(10), 3025, "حالة 10")
