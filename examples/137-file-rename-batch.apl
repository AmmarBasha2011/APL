# مثال 137 — إعادة تسمية مجموعة ملفات
# Batch file renaming
# Demonstrates: اعد_تسمية، قائمة_ملفات، استبدال
#
# Run:  python apl.py examples/137-file-rename-batch.apl

المتغير جذر = "/tmp/apl_rename_demo"
انشئ_مجلدات(جذر)
اكتب(جذر + "/تقرير 1.txt", "أ")
اكتب(جذر + "/تقرير 2.txt", "ب")
اكتب(جذر + "/تقرير 3.txt", "ج")

لكل اسم في قائمة_ملفات(جذر):
    المتغير جديد = اسم.استبدال(" ", "_")
    اعد_تسمية(جذر + "/" + اسم, جذر + "/" + جديد)
    اطبع اسم, "->", جديد

اطبع "النتيجة:", مفرز(قائمة_ملفات(جذر))
احذف_شجرة(جذر)
