# مثال 1377 — مكدس بأقصى قيمة
# Max stack operations
# Demonstrates: هياكل بيانات
#
# Run:  python apl.py examples/1377-max-stack-ops.apl

# حذف الأقصى يزيل أقرب موضع من القمة فيه الأقصى
# نبحث من النهاية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نفذ_العمليات(عمليات):
  مكدس = []
  ناتج = []
  لكل عملية في عمليات:
    اسم = عملية[0]
    لو اسم == "push":
      مكدس.ألحق(عملية[1])
    والا_لو اسم == "top":
      ناتج.ألحق(مكدس[طول(مكدس) - 1])
    والا_لو اسم == "pop":
      ناتج.ألحق(مكدس.pop())
    والا_لو اسم == "peekMax":
      ناتج.ألحق(أكبر(مكدس))
    والا_لو اسم == "popMax":
      اكبر_قيمة = أكبر(مكدس)
      موضع = طول(مكدس) - 1
      طالما مكدس[موضع] != اكبر_قيمة:
        موضع = موضع - 1
      ناتج.ألحق(مكدس.pop(موضع))
  ارجع ناتج

ع = [["push",5],["push",1],["push",5],["top"],["popMax"],["top"],["peekMax"],["pop"],["top"]]
تأكد_يساوي(نفذ_العمليات(ع), [5,5,1,5,1,5], "مثال أول")
تأكد_يساوي(نفذ_العمليات([["push",2],["push",9],["popMax"],["top"]]), [9,2], "حذف الأقصى")
تأكد_يساوي(نفذ_العمليات([["push",4],["peekMax"]]), [4], "قمة واحدة")
