# مثال 3180 — الحد النوني بخطوة 33
# Nth term step 33
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3180-nth-term-arithmetic-sequence-step-33.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 33

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 36, "حالة 2")
تأكد_يساوي(ف(10), 300, "حالة 3")
تأكد_يساوي(ف(100), 3270, "حالة 4")
