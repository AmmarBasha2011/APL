# مثال 3405 — مجموع زوايا مضلع زائد 14
# Polygon angle sum plus 14
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3405-interior-angle-sum-of-polygon-plus-14.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 14

تأكد_يساوي(ف(3), 194, "حالة 1")
تأكد_يساوي(ف(4), 374, "حالة 2")
تأكد_يساوي(ف(5), 554, "حالة 3")
تأكد_يساوي(ف(6), 734, "حالة 4")
تأكد_يساوي(ف(12), 1814, "حالة 5")
