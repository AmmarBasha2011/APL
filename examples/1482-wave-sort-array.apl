# مثال 1482 — ترتيب موجي
# Wave sort array
# Demonstrates: فرز
#
# Run:  python apl.py examples/1482-wave-sort-array.apl

# نبدل كل جارين عند اللزوم
# العناصر في المواقع الزوجية تكون أكبر من جيرانها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رتب_موجياً(أ):
  لكل ع في نطاق(0, طول(أ), 2):
    لو ع > 0 و أ[ع - 1] > أ[ع]:
      ت = أ[ع]
      أ[ع] = أ[ع - 1]
      أ[ع - 1] = ت
    لو ع + 1 < طول(أ) و أ[ع] < أ[ع + 1]:
      ت = أ[ع]
      أ[ع] = أ[ع + 1]
      أ[ع + 1] = ت
  ارجع أ

دالة موجية(أ):
  لكل ع في نطاق(0, طول(أ), 2):
    لو ع > 0 و أ[ع] < أ[ع - 1]:
      ارجع خطأ
    لو ع + 1 < طول(أ) و أ[ع] < أ[ع + 1]:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(موجية(رتب_موجياً([1, 2, 3, 4, 5])), صواب, "خمسة")
تأكد_يساوي(موجية(رتب_موجياً([5, 4, 3, 2, 1, 0])), صواب, "تنازلي")
تأكد_يساوي(موجية(رتب_موجياً([7])), صواب, "وحيد")
