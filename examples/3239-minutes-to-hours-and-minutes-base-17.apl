# مثال 3239 — تحويل وحدة بأساس 17
# Split by base 17
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3239-minutes-to-hours-and-minutes-base-17.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 17, ن % 17]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [3, 8], "حالة 2")
تأكد_يساوي(ف(60), [3, 9], "حالة 3")
تأكد_يساوي(ف(125), [7, 6], "حالة 4")
تأكد_يساوي(ف(1000), [58, 14], "حالة 5")
