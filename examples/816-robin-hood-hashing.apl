# مثال 816 — تجزئة روبن هود
# Robin Hood hashing
# Demonstrates: معالجة مفتوحة، تبادل بالمسافة
#
# Run:  python apl.py examples/816-robin-hood-hashing.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تجزئة روبن هود: معالجة مفتوحة مع سرقة من الأغنياء للفقراء
# Demonstrates: مسافة من البيت الأصلي, تبادل عند تجاوز المسافة, بحث بإيقاف مبكر

حجم = 16

دالة جدول_جديد():
  جدول = []
  لكل ي في نطاق(حجم):
    جدول.append([0 - 1, 0])
  ارجع جدول

دالة أدخل(جدول, مفتاح):
  موضع = مفتاح % حجم
  حالي = مفتاح
  مسافة = 0
  طالما 1 == 1:
    لو جدول[موضع][0] == 0 - 1:
      جدول[موضع][0] = حالي
      جدول[موضع][1] = مسافة
      ارجع موضع
    لو جدول[موضع][1] < مسافة:
      مؤقت1 = جدول[موضع][0]
      مؤقت2 = جدول[موضع][1]
      جدول[موضع][0] = حالي
      جدول[موضع][1] = مسافة
      حالي = مؤقت1
      مسافة = مؤقت2
    موضع = (موضع + 1) % حجم
    مسافة = مسافة + 1

دالة ابحث(جدول, مفتاح):
  موضع = مفتاح % حجم
  مسافة = 0
  طالما جدول[موضع][0] != 0 - 1:
    لو جدول[موضع][0] == مفتاح:
      ارجع موضع
    لو جدول[موضع][1] < مسافة:
      ارجع 0 - 1
    موضع = (موضع + 1) % حجم
    مسافة = مسافة + 1
  ارجع 0 - 1

جدول = جدول_جديد()
أدخل(جدول, 5)
أدخل(جدول, 18)
أدخل(جدول, 20)
أدخل(جدول, 37)
تأكد_يساوي(جدول[5][0], 5, "خمسة في بيتها")
تأكد_يساوي(جدول[2][0], 18, "ثمانية عشر")
تأكد_يساوي(جدول[6][0], 37, "سبعة وثلاثون أزاحت")
تأكد_يساوي(جدول[6][1], 1, "مسافة واحدة")
تأكد_يساوي(ابحث(جدول, 20), 4, "بحث ناجح")
تأكد_يساوي(ابحث(جدول, 99), 0 - 1, "بحث فاشل بإيقاف مبكر")
