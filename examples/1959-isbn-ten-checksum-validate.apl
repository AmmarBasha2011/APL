# مثال 1959 — التحقق من رقم ISBN-10
# ISBN-10 validation
# Demonstrates: أرقام
#
# Run:  python apl.py examples/1959-isbn-ten-checksum-validate.apl

# # الرمز X في الآخر يساوي 10
# # نرفض أي طول غير عشرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صحيح_isbn(س):
  لو طول(س) != 10:
    ارجع خطأ
  مج = 0
  لكل ك في نطاق(10):
    ح = س[ك]
    لو ح == "X":
      ق = 10
    والا:
      ق = int(ح)
    مج = مج + ق * (10 - ك)
  ارجع مج % 11 == 0

تأكد_يساوي(صحيح_isbn("0306406152"), صواب, "صحيح")
تأكد_يساوي(صحيح_isbn("0306406153"), خطأ, "خاطئ")
تأكد_يساوي(صحيح_isbn("080442957X"), صواب, "X في الآخر")
تأكد_يساوي(صحيح_isbn("123"), خطأ, "قصير")
