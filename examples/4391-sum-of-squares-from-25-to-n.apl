# مثال 4391 — مجموع المربعات من 25 إلى ن
# Sum of squares from 25
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4391-sum-of-squares-from-25-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(25, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(25), 625, "حالة 1")
تأكد_يساوي(ف(26), 1301, "حالة 2")
تأكد_يساوي(ف(35), 10010, "حالة 3")
تأكد_يساوي(ف(100), 333450, "حالة 4")
