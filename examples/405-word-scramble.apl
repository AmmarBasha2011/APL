# مثال 405 — خلط الكلمات
# Word scramble
# Demonstrates: خلط حروف كلمة
#
# Run:  python apl.py examples/405-word-scramble.apl

بذرة(3)
دالة اخلط_كلمة(كلمة):
    المتغير حروف = []
    لكل ح in كلمة:
        حروف.append(ح)
    خلط(حروف)
    ارجع "".ضم(حروف)

المتغير كلمات = ["مدرسة", "برمجة", "حاسوب"]
لكل ك in كلمات:
    اطبع "خمن:", اخلط_كلمة(ك), "(الإجابة:", ك + ")"
