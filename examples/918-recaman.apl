# مثال 918 — متتابعة ريكامان
# Recaman sequence
# Demonstrates: تراجع مشروط وتقدم
#
# Run:  python apl.py examples/918-recaman.apl

# متتابعة ريكامان: تراجع n خطوات إن أمكن وإلا تقدم
# أ[ن] = أ[ن-1] - ن إن كان موجباً وجديداً، وإلا أ[ن-1] + ن

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ريكامان(عدد):
  أ = [0]
  لكل ن في نطاق(1, عدد):
    مرشح = أ[طول(أ) - 1] - ن
    موجود = 0
    لكل x في أ:
      لو x == مرشح:
        موجود = 1
    لو مرشح > 0 و موجود == 0:
      أ.ألحق(مرشح)
    والا:
      أ.ألحق(أ[طول(أ) - 1] + ن)
  ارجع أ

أ = ريكامان(15)
اطبع "أول 15 حداً:", أ

متوقع = [0, 1, 3, 6, 2, 7, 13, 20, 12, 21, 11, 22, 10, 23, 9]
تأكد_يساوي(طول(أ), 15, "الطول")
لكل i في نطاق(15):
  تأكد_يساوي(أ[i], متوقع[i], "حد " + نص(i))

# كل حد يبعد عن سابقه بموضعه
ب = ريكامان(20)
لكل i في نطاق(1, 20):
  فرق = ب[i] - ب[i - 1]
  لو فرق < 0:
    فرق = -فرق
  تأكد_يساوي(فرق, i, "قفزة " + نص(i))
