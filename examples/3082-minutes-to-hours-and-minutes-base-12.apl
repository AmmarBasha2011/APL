# مثال 3082 — تحويل وحدة بأساس 12
# Split by base 12
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3082-minutes-to-hours-and-minutes-base-12.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 12, ن % 12]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [4, 11], "حالة 2")
تأكد_يساوي(ف(60), [5, 0], "حالة 3")
تأكد_يساوي(ف(125), [10, 5], "حالة 4")
تأكد_يساوي(ف(1000), [83, 4], "حالة 5")
