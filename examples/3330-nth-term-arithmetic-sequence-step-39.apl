# مثال 3330 — الحد النوني بخطوة 39
# Nth term step 39
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3330-nth-term-arithmetic-sequence-step-39.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 39

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 42, "حالة 2")
تأكد_يساوي(ف(10), 354, "حالة 3")
تأكد_يساوي(ف(100), 3864, "حالة 4")
