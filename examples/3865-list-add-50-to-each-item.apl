# مثال 3865 — إضافة 50 لكل عنصر
# Add 50 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3865-list-add-50-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 50]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [53, 51, 52], "حالة 1")
تأكد_يساوي(ف([5]), [55], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [51, 52, 53, 54, 55, 56], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [48, 50, 57, 57, 54], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [60, 70, 60, 80, 70, 60], "حالة 5")
