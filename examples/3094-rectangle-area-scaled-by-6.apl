# مثال 3094 — مساحة مستطيل مكبر 6 مرات
# Rectangle area scaled by 6
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3094-rectangle-area-scaled-by-6.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 6) * (ق[1] * 6)

تأكد_يساوي(ف([1, 2]), 72, "حالة 1")
تأكد_يساوي(ف([3, 4]), 432, "حالة 2")
تأكد_يساوي(ف([5, 5]), 900, "حالة 3")
تأكد_يساوي(ف([10, 1]), 360, "حالة 4")
