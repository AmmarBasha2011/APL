# مثال 3967 — تحويل وحدة بأساس 37
# Split by base 37
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3967-minutes-to-hours-and-minutes-base-37.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 37, ن % 37]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 22], "حالة 2")
تأكد_يساوي(ف(60), [1, 23], "حالة 3")
تأكد_يساوي(ف(125), [3, 14], "حالة 4")
تأكد_يساوي(ف(1000), [27, 1], "حالة 5")
