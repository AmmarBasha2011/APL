# مثال 656 — التعمق التكراري
# Iterative deepening
# Demonstrates: تعمق تكراري، حد عمق، بحث
#
# Run:  python apl.py examples/656-iterative-deepening.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# التعمق التكراري: BFS بذاكرة DFS
# Demonstrates: حد عمق متزايد, بحث محدود العمق, أول حل أضحل
# يجد أقصر عمق بذاكرة شجرة البحث العميق

شجرة = {"أ": ["ب", "ج"], "ب": ["د", "ه"], "ج": ["و"], "د": [], "ه": ["ز"], "و": [], "ز": []}

دالة بحث_محدود(عقدة_حالية, هدف, حد, عمق):
  لو عقدة_حالية == هدف:
    ارجع عمق
  لو عمق == حد:
    ارجع 0 - 1
  لكل فرع في شجرة[عقدة_حالية]:
    ن = بحث_محدود(فرع, هدف, حد, عمق + 1)
    لو ن != 0 - 1:
      ارجع ن
  ارجع 0 - 1

دالة تعمق_تكراري(جذر, هدف, أقصى):
  لكل حد في نطاق(أقصى + 1):
    ن = بحث_محدود(جذر, هدف, حد, 0)
    لو ن != 0 - 1:
      ارجع [حد, ن]
  ارجع [0 - 1, 0 - 1]

تأكد_يساوي(تعمق_تكراري("أ", "ز", 5), [3, 3], "ز عند العمق الثالث")
تأكد_يساوي(تعمق_تكراري("أ", "و", 5), [2, 2], "و عند العمق الثاني")
تأكد_يساوي(تعمق_تكراري("أ", "أ", 5), [0, 0], "الجذر نفسه")
تأكد_يساوي(تعمق_تكراري("أ", "ز", 2), [0 - 1, 0 - 1], "أقصى قليل لا يكفي")
تأكد_يساوي(بحث_محدود("أ", "ز", 2, 0), 0 - 1, "حد اثنان لا يصل")
اطبع "انتهى التعمق"
