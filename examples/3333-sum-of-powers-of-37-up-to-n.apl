# مثال 3333 — مجموع قوى 37
# Sum of powers of 37
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3333-sum-of-powers-of-37-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 37 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 38, "حالة 2")
تأكد_يساوي(ف(3), 52060, "حالة 3")
تأكد_يساوي(ف(6), 2636996587, "حالة 4")
تأكد_يساوي(ف(10), 4942156160540567, "حالة 5")
