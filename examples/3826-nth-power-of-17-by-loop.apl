# مثال 3826 — قوة 17 بالحلقة
# Power of 17 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3826-nth-power-of-17-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 17
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 17, "حالة 2")
تأكد_يساوي(ف(3), 4913, "حالة 3")
تأكد_يساوي(ف(6), 24137569, "حالة 4")
تأكد_يساوي(ف(10), 2015993900449, "حالة 5")
