# مثال 3566 — تحويل وحدة بأساس 27
# Split by base 27
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3566-minutes-to-hours-and-minutes-base-27.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 27, ن % 27]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 5], "حالة 2")
تأكد_يساوي(ف(60), [2, 6], "حالة 3")
تأكد_يساوي(ف(125), [4, 17], "حالة 4")
تأكد_يساوي(ف(1000), [37, 1], "حالة 5")
