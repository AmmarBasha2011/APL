# مثال 3908 — الحد النوني بخطوة 53
# Nth term step 53
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3908-nth-term-arithmetic-sequence-step-53.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 53

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 56, "حالة 2")
تأكد_يساوي(ف(10), 480, "حالة 3")
تأكد_يساوي(ف(100), 5250, "حالة 4")
