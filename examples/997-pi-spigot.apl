# مثال 997 — صنبور أرقام ط
# Pi spigot algorithm
# Demonstrates: بقايا تنتج رقماً رقماً
#
# Run:  python apl.py examples/997-pi-spigot.apl

# صنبور باي: أرقام ط تنتج واحداً واحداً دون كسور عائمة طويلة
# خوارزمية رابينوفيتز-واغون بمصفوفة بقايا

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

ن = 11
صناديق = ((ن * 10) // 3) + 1
بقايا = []
لكل _ في نطاق(صناديق):
  بقايا.ألحق(2)
أرقام = []
محتجز = 0
سابق = 0
لكل _ في نطاق(ن):
  حمل = 0
  لكل j في نطاق(صناديق, 0, -1):
    س = (بقايا[j - 1] * 10) + (حمل * j)
    بقايا[j - 1] = س % ((2 * j) - 1)
    حمل = س // ((2 * j) - 1)
  بقايا[0] = حمل % 10
  رقم = حمل // 10
  لو رقم == 9:
    محتجز = محتجز + 1
  والا_لو رقم == 10:
    أرقام.ألحق(سابق + 1)
    لكل __ في نطاق(محتجز):
      أرقام.ألحق(0)
    سابق = 0
    محتجز = 0
  والا:
    أرقام.ألحق(سابق)
    سابق = رقم
    لكل __ في نطاق(محتجز):
      أرقام.ألحق(9)
    محتجز = 0
أرقام.ألحق(سابق)

تأكد_يساوي(أرقام[1], 3, "الرقم الصحيح")
تأكد_يساوي(أرقام[2], 1, "أول عشري")
تأكد_يساوي(أرقام[3], 4, "ثاني عشري")
تأكد_يساوي(أرقام[5], 5, "رابع عشري")
تأكد_يساوي(أرقام[11], 5, "عاشر عشري")
تأكد_يساوي(طول(أرقام), 12, "عدد الأرقام")
