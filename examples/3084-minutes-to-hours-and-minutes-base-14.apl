# مثال 3084 — تحويل وحدة بأساس 14
# Split by base 14
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3084-minutes-to-hours-and-minutes-base-14.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 14, ن % 14]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [4, 3], "حالة 2")
تأكد_يساوي(ف(60), [4, 4], "حالة 3")
تأكد_يساوي(ف(125), [8, 13], "حالة 4")
تأكد_يساوي(ف(1000), [71, 6], "حالة 5")
