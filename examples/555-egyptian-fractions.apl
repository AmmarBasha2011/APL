# مثال 555 — الكسور المصرية
# Egyptian fractions
# Demonstrates: كسور وحدة، جشع، مقامات
#
# Run:  python apl.py examples/555-egyptian-fractions.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# الكسور المصرية: تمثيل كسر بمجموع كسور وحدة
دالة كسور_مصرية(بسط, مقام):
    المتغير مقامات = قائمة()
    طالما بسط > 0:
        المتغير ق = (مقام + بسط - 1) // بسط
        مقامات.أضف(ق)
        بسط = بسط * ق - مقام
        مقام = مقام * ق
        المتغير م = قاسم_مشترك(بسط, مقام)
        بسط = بسط // م
        مقام = مقام // م
    ارجع مقامات

المتغير نتيجة = كسور_مصرية(4, 13)
اطبع "4/13 =", نتيجة
تأكد_يساوي(نتيجة, [4, 18, 468], "4/13 كسور مصرية")
تأكد_يساوي(كسور_مصرية(2, 3), [2, 6], "2/3")
تأكد_يساوي(كسور_مصرية(1, 7), [7], "كسر وحدة")
