# مثال 279 — مسافة التحرير
# Edit distance (Levenshtein)
# Demonstrates: جدول ديناميكي للتشابه
#
# Run:  python apl.py examples/279-edit-distance.apl

دالة مسافة(أ, ب):
    المتغير ن = طول(أ)
    المتغير م = طول(ب)
    المتغير جدول = []
    لكل ي في نطاق(ن + 1):
        جدول.أضف([0 لكل _ في نطاق(م + 1)])
        جدول[ي][0] = ي
    لكل ز في نطاق(م + 1):
        جدول[0][ز] = ز
    لكل ي في نطاق(1, ن + 1):
        لكل ز في نطاق(1, م + 1):
            لو أ[ي - 1] == ب[ز - 1]:
                جدول[ي][ز] = جدول[ي - 1][ز - 1]
            الا:
                المتغير أقل = جدول[ي - 1][ز - 1]
                لو جدول[ي - 1][ز] < أقل:
                    أقل = جدول[ي - 1][ز]
                لو جدول[ي][ز - 1] < أقل:
                    أقل = جدول[ي][ز - 1]
                جدول[ي][ز] = أقل + 1
    ارجع جدول[ن][م]

اطبع مسافة("horse", "ros")
اطبع مسافة("intention", "execution")
