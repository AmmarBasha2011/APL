# مثال 3177 — الحد النوني بخطوة 30
# Nth term step 30
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3177-nth-term-arithmetic-sequence-step-30.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 30

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 33, "حالة 2")
تأكد_يساوي(ف(10), 273, "حالة 3")
تأكد_يساوي(ف(100), 2973, "حالة 4")
