# مثال 308 — القوة السريعة
# Fast exponentiation
# Demonstrates: رفع بأسر لوغاريتمي
#
# Run:  python apl.py examples/308-fast-power.apl

دالة قوة_سريعة(أساس, أس):
    المتغير نتيجة = 1
    طالما أس > 0:
        لو أس % 2 == 1:
            نتيجة = نتيجة * أساس
        أساس = أساس * أساس
        أس = أس // 2
    ارجع نتيجة

اطبع "2^10 =", قوة_سريعة(2, 10)
اطبع "3^5 =", قوة_سريعة(3, 5)
اطبع "5^0 =", قوة_سريعة(5, 0)
اطبع "2^100 لها", طول(نص(قوة_سريعة(2, 100))), "خانة"
