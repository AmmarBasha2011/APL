# مثال 243 — حجر ورقة مقص
# Rock paper scissors (auto rounds)
# Demonstrates: عشوائي، حالة، نقاط
#
# Run:  python apl.py examples/243-rock-paper-scissors.apl

بذرة(3)
المتغير خيارات = ["حجر", "ورقة", "مقص"]
المتغير نقاط_أ = 0
المتغير نقاط_ب = 0

لكل جولة في نطاق(5):
    المتغير أ = عشوائي(خيارات)
    المتغير ب = عشوائي(خيارات)
    لو أ == ب:
        اطبع "جولة", جولة + 1, ": تعادل (", أ, ")"
    الا لو (أ == "حجر" و ب == "مقص") أو (أ == "ورقة" و ب == "حجر") أو (أ == "مقص" و ب == "ورقة"):
        نقاط_أ = نقاط_أ + 1
        اطبع "جولة", جولة + 1, ": أ فاز (", أ, "ضد", ب, ")"
    الا:
        نقاط_ب = نقاط_ب + 1
        اطبع "جولة", جولة + 1, ": ب فاز (", ب, "ضد", أ, ")"

اطبع "النتيجة النهائية: أ =", نقاط_أ, ", ب =", نقاط_ب
