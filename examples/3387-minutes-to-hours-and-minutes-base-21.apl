# مثال 3387 — تحويل وحدة بأساس 21
# Split by base 21
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3387-minutes-to-hours-and-minutes-base-21.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 21, ن % 21]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 17], "حالة 2")
تأكد_يساوي(ف(60), [2, 18], "حالة 3")
تأكد_يساوي(ف(125), [5, 20], "حالة 4")
تأكد_يساوي(ف(1000), [47, 13], "حالة 5")
