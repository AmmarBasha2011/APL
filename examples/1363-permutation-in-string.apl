# مثال 1363 — تبديل داخل نص
# Permutation in string
# Demonstrates: نافذة منزلقة
#
# Run:  python apl.py examples/1363-permutation-in-string.apl

# نقارن عدادات الحروف في نافذة بطول النص الأول
# ننزلق نافذة واحدة في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يحتوي_تبديل(أ, ب):
  لو طول(أ) > طول(ب):
    ارجع خطأ
  مطلوب_ = [0] * 26
  نافذة = [0] * 26
  لكل ع في نطاق(طول(أ)):
    مطلوب_[ord(أ[ع]) - 97] = مطلوب_[ord(أ[ع]) - 97] + 1
    نافذة[ord(ب[ع]) - 97] = نافذة[ord(ب[ع]) - 97] + 1
  لو نافذة == مطلوب_:
    ارجع صواب
  لكل ع في نطاق(طول(أ), طول(ب)):
    نافذة[ord(ب[ع]) - 97] = نافذة[ord(ب[ع]) - 97] + 1
    نافذة[ord(ب[ع - طول(أ)]) - 97] = نافذة[ord(ب[ع - طول(أ)]) - 97] - 1
    لو نافذة == مطلوب_:
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(يحتوي_تبديل("ab", "eidbaooo"), صواب, "موجود")
تأكد_يساوي(يحتوي_تبديل("ab", "eidboaoo"), خطأ, "غير موجود")
تأكد_يساوي(يحتوي_تبديل("a", "a"), صواب, "حرف")
