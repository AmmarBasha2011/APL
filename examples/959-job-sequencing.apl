# مثال 959 — ترتيب الأعمال بالمواعيد
# Job sequencing with deadlines
# Demonstrates: جشع على خانات الزمن
#
# Run:  python apl.py examples/959-job-sequencing.apl

# ترتيب الأعمال بالمواعيد النهائية: أقصى ربح بجدولة جشعة على خانات الزمن
# كل عمل يأخذ وحدة زمن واحدة ويوضع في آخر خانة حرة قبل موعده

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# [اسم، ربح، موعد نهائي]
أعمال = [["ا", 100, 2], ["ب", 19, 1], ["ج", 27, 2], ["د", 25, 1], ["ه", 15, 3]]

# ترتيب تنازلي بالربح (إدراج)
مرتبة = []
لكل عمل في أعمال:
  وضع = طول(مرتبة)
  لكل ف في نطاق(طول(مرتبة)):
    لو (عمل[1] > مرتبة[ف][1]) و (وضع == طول(مرتبة)):
      وضع = ف
  مرتبة.ألحق(عمل)
  لكل ج في نطاق(طول(مرتبة) - 1, وضع, -1):
    مرتبة[ج] = مرتبة[ج - 1]
  مرتبة[وضع] = عمل

خانات = ["", "", "", ""]
لكل عمل في مرتبة:
  موعد = عمل[2]
  خانة = موعد
  طالما (خانة >= 1) و (خانات[خانة] != ""):
    خانة = خانة - 1
  لو (خانة >= 1) و (خانات[خانة] == ""):
    خانات[خانة] = عمل[0]

تأكد_يساوي(خانات[1], "ج", "الخانة الأولى")
تأكد_يساوي(خانات[2], "ا", "الخانة الثانية")
تأكد_يساوي(خانات[3], "ه", "الخانة الثالثة")
تأكد_يساوي(100 + 27 + 15, 142, "الربح الكلي")
