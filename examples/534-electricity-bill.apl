# مثال 534 — فاتورة كهرباء بشرائح
# Electricity bill slabs
# Demonstrates: شرائح أسعار، فاتورة كهرباء
#
# Run:  python apl.py examples/534-electricity-bill.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# فاتورة كهرباء منزلية بشرائح تقريبية (جنيه/ك.و.س)
دالة فاتورة(استهلاك):
    المتغير شرائح = [[50, 0.68], [100, 0.78], [200, 0.95], [350, 1.55], [650, 1.55], [1000, 1.55]]
    المتغير متبقي = استهلاك
    المتغير سابق = 0
    المتغير إجمالي = 0
    لكل شريحة في شرائح:
        لو متبقي <= 0:
            توقف
        المتغير سعة = شريحة[0] - سابق
        المتغير كمية = أصغر(متبقي, سعة)
        إجمالي = إجمالي + كمية * شريحة[1]
        متبقي = متبقي - كمية
        سابق = شريحة[0]
    لو متبقي > 0:
        إجمالي = إجمالي + متبقي * 1.55
    ارجع مقرب(إجمالي, 2)

تأكد_يساوي(فاتورة(30), 20.4, "شريحة أولى فقط")
تأكد_يساوي(فاتورة(80), 57.4, "شريحتان")
تأكد_يساوي(فاتورة(0), 0, "بدون استهلاك")
