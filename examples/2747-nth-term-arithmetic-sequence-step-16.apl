# مثال 2747 — الحد النوني بخطوة 16
# Nth term step 16
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2747-nth-term-arithmetic-sequence-step-16.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 16

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 19, "حالة 2")
تأكد_يساوي(ف(10), 147, "حالة 3")
تأكد_يساوي(ف(100), 1587, "حالة 4")
