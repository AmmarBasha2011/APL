# مثال 453 — كلمة مرور قابلة للنطق
# Pronounceable password
# Demonstrates: تناوب حرف علة وساكن
#
# Run:  python apl.py examples/453-pronounceable-password.apl

بذرة(12)
المتغير ساكنة = "bcdfgklmnprst"
المتغير علة = "aeiou"

دالة كلمة_منطوقة(طول_مطلوب):
    المتغير ناتج = ""
    لكل ي في نطاق(طول_مطلوب):
        لو ي % 2 == 0:
            ناتج = ناتج + ساكنة[عشوائي_عدد(0, طول(ساكنة) - 1)]
        الا:
            ناتج = ناتج + علة[عشوائي_عدد(0, طول(علة) - 1)]
    ارجع ناتج + نص(عشوائي_عدد(10, 99))

لكل _ في نطاق(3):
    اطبع كلمة_منطوقة(8)
