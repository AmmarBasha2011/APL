# مثال 866 — المجموع الثلاثي
# 3Sum
# Demonstrates: فرز ومؤشران متقابلان
#
# Run:  python apl.py examples/866-three-sum.apl

# مجموع ثلاثي: كل ثلاثيات فريدة مجموعها صفر
# فرز + مؤشران متقابلان لكل عنصر أول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فرز(قائمة):
  م = []
  لكل ق في قائمة:
    م.ألحق(ق)
  ن = طول(م)
  لكل i في نطاق(ن):
    لكل ج في نطاق(ن - 1):
      لو م[ج] > م[ج + 1]:
        مؤقت = م[ج]
        م[ج] = م[ج + 1]
        م[ج + 1] = مؤقت
  ارجع م

دالة مجموع_ثلاثي(أرقام):
  م = فرز(أرقام)
  ن = طول(م)
  نتائج = []
  لكل i في نطاق(ن - 2):
    لو i == 0 أو م[i] != م[i - 1]:
      يسار = i + 1
      يمين = ن - 1
      طالما يسار < يمين:
        مجموع = م[i] + م[يسار] + م[يمين]
        لو مجموع < 0:
          يسار = يسار + 1
        والا_لو مجموع > 0:
          يمين = يمين - 1
        والا:
          نتائج.ألحق([م[i], م[يسار], م[يمين]])
          طالما يسار < يمين و م[يسار] == م[يسار + 1]:
            يسار = يسار + 1
          طالما يسار < يمين و م[يمين] == م[يمين - 1]:
            يمين = يمين - 1
          يسار = يسار + 1
          يمين = يمين - 1
  ارجع نتائج

نتائج = مجموع_ثلاثي([-1, 0, 1, 2, -1, -4])
اطبع "الثلاثيات:", نتائج

تأكد_يساوي(طول(نتائج), 2, "ثلاثيتان")
تأكد_يساوي(نتائج[0][0], -1, "الأولى تبدأ بـ -1")
تأكد_يساوي(نتائج[0][1], -1, "الأولى: -1,-1,2")
تأكد_يساوي(نتائج[1][2], 1, "الثانية: -1,0,1")

تأكد_يساوي(طول(مجموع_ثلاثي([1, 2, 3])), 0, "لا ثلاثية صفرية")
