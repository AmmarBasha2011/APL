# مثال 324 — تداخل قائمتين
# Interleave two lists
# Demonstrates: دمج بالتناوب
#
# Run:  python apl.py examples/324-interleave.apl

دالة داخل(أ, ب):
    المتغير نتيجة = []
    المتغير أطول = طول(أ)
    لو طول(ب) > أطول:
        أطول = طول(ب)
    لكل ي في نطاق(أطول):
        لو ي < طول(أ):
            نتيجة.أضف(أ[ي])
        لو ي < طول(ب):
            نتيجة.أضف(ب[ي])
    ارجع نتيجة

اطبع داخل([1, 2, 3], ["أ", "ب", "ج"])
اطبع داخل([1, 2], ["أ", "ب", "ج", "د"])
