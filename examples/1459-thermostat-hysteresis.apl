# مثال 1459 — منظم حرارة بفارق تشغيل
# Thermostat with hysteresis
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1459-thermostat-hysteresis.apl

# يعمل عند تجاوز الحد الأعلى
# يتوقف عند النزول تحت الحد الأدنى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حالات_المكيف(قراءات, أدنى, أعلى):
  يعمل = خطأ
  نتيجة = []
  لكل ق في قراءات:
    لو ق > أعلى:
      يعمل = صواب
    والا_لو ق < أدنى:
      يعمل = خطأ
    نتيجة.append(يعمل)
  ارجع نتيجة

تأكد_يساوي(حالات_المكيف([20, 26, 24, 21, 19, 22], 21, 25), [خطأ, صواب, صواب, صواب, خطأ, خطأ], "دورة كاملة")
تأكد_يساوي(حالات_المكيف([23, 23], 21, 25), [خطأ, خطأ], "داخل المجال")
