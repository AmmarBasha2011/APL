# مثال 3459 — ضرب كل عنصر في 40
# Multiply each item by 40
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3459-list-multiply-each-by-40.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 40]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [120, 40, 80], "حالة 1")
تأكد_يساوي(ف([5]), [200], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [40, 80, 120, 160, 200, 240], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-80, 0, 280, 280, 160], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [400, 800, 400, 1200, 800, 400], "حالة 5")
