# مثال 159 — التحقق من سلامة الملفات
# File integrity with hashes
# Demonstrates: تجزئة_sha256، تجزئة_md5، تجزئة_sha512
#
# Run:  python apl.py examples/159-hash-integrity.apl

دالة تجزئة_نص(نص):
    ارجع تجزئة_sha256(نص.encode()).hexdigest()

المتغير أصلي = "محتوى الملف الأصلي"
اطبع "sha256:", تجزئة_نص(أصلي)[:16], "..."
اطبع "md5:", تجزئة_md5(أصلي.encode()).hexdigest()[:16], "..."
اطبع "sha512:", تجزئة_sha512(أصلي.encode()).hexdigest()[:16], "..."

اطبع ""
اطبع "نفس المحتوى = نفس التجزئة؟", تجزئة_نص(أصلي) == تجزئة_نص("محتوى الملف الأصلي")
اطبع "تغيير حرف يغير التجزئة؟", تجزئة_نص(أصلي) != تجزئة_نص("محتوى الملف الأصل!")
