# مثال 1989 — التمثيل الثنائي السالب
# Negabinary representation
# Demonstrates: أنظمة العد
#
# Run:  python apl.py examples/1989-negabinary-digits-from-int.apl

# # نأخذ الباقي على 2 ثم نقسم على ناقص 2
# # الخانات تتكون من 0 و1 فقط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نيجا(ن):
  لو ن == 0:
    ارجع "0"
  خرج = ""
  طالما ن != 0:
    ر = ن % 2
    خرج = نص(ر) + خرج
    ن = (ن - ر) // (-2)
  ارجع خرج

تأكد_يساوي(نيجا(0), "0", "صفر")
تأكد_يساوي(نيجا(2), "110", "٢")
تأكد_يساوي(نيجا(3), "111", "٣")
تأكد_يساوي(نيجا(6), "11010", "٦")
تأكد_يساوي(نيجا(-1), "11", "سالب")
