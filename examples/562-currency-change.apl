# مثال 562 — فك فئات الجنيه
# Egyptian currency change
# Demonstrates: فئات نقدية، جشع، قروش
#
# Run:  python apl.py examples/562-currency-change.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# فك مبلغ إلى فئات الجنيه المصري (بالقروش لتفادي الكسور)
دالة فك_مبلغ(قروش):
    المتغير فئات = [20000, 10000, 5000, 2000, 1000, 500, 100, 50, 25]
    المتغير نتيجة = قاموس()
    المتغير متبقي = قروش
    لكل فئة في فئات:
        المتغير عد = متبقي // فئة
        لو عد > 0:
            نتيجة[فئة] = عد
            متبقي = متبقي - عد * فئة
    ارجع [نتيجة, متبقي]

المتغير نتيجة = فك_مبلغ(78675)
اطبع "786.75 جنيه =", نتيجة[0]
تأكد_يساوي(نتيجة[0][20000], 3, "ثلاث ورقات 200")
تأكد_يساوي(نتيجة[1], 0, "بلا باقي")
المتغير قطع = 0
لكل فئة في نتيجة[0]:
    قطع = قطع + نتيجة[0][فئة]
تأكد_يساوي(قطع, 11, "11 ورقة وعملة")
