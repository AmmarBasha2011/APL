# مثال 1443 — نقاط البومرانغ
# Valid boomerang three points
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1443-boomerang-points.apl

# لا تتطابق نقطتان
# والجداء التقاطعي غير صفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بومرانغ(ن):
  لو (ن[0] == ن[1]) أو (ن[1] == ن[2]) أو (ن[0] == ن[2]):
    ارجع خطأ
  ض = (ن[1][0] - ن[0][0]) * (ن[2][1] - ن[0][1]) - (ن[1][1] - ن[0][1]) * (ن[2][0] - ن[0][0])
  ارجع ض != 0

تأكد_يساوي(بومرانغ([[1,1],[2,3],[3,2]]), صواب, "صالحة")
تأكد_يساوي(بومرانغ([[1,1],[2,2],[3,3]]), خطأ, "مستقيمة")
تأكد_يساوي(بومرانغ([[0,0],[0,0],[1,2]]), خطأ, "متطابقتان")
