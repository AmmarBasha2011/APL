# مثال 1510 — فك ضغط التكرار
# Run length decode
# Demonstrates: ترميز
#
# Run:  python apl.py examples/1510-run-length-decode-string.apl

# نقرأ الرقم ثم الحرف
# نكرر الحرف بقدر الرقم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فك_الضغط(نص_):
  ناتج = ""
  رقم = ""
  لكل ح في نص_:
    لو ح.isdigit():
      رقم = رقم + ح
    والا:
      لو رقم == "":
        ناتج = ناتج + ح
      والا:
        ناتج = ناتج + ح * صحيح(رقم)
      رقم = ""
  ارجع ناتج

تأكد_يساوي(فك_الضغط("3a2b"), "aaabb", "بسيط")
تأكد_يساوي(فك_الضغط("a3b"), "abbb", "حرف مفرد")
تأكد_يساوي(فك_الضغط("10x"), "xxxxxxxxxx", "رقمان")
