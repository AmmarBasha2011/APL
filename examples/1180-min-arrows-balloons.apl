# مثال 1180 — أقل سهام
# Minimum arrows to burst balloons
# Demonstrates: جشع
#
# Run:  python apl.py examples/1180-min-arrows-balloons.apl

# نرتب بحسب النهاية
# وسهم واحد يفجر كل ما يبدأ قبل نهاية البالون الحالي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_سهام(نقاط):
  لو طول(نقاط) == 0:
    ارجع 0
  ازواج = []
  لكل ن في نقاط:
    ازواج.ألحق([ن[1], ن[0]])
  ازواج = مفرز(ازواج)
  سهام = 1
  نهاية = ازواج[0][0]
  لكل ع في نطاق(1, طول(ازواج)):
    لو ازواج[ع][1] > نهاية:
      سهام = سهام + 1
      نهاية = ازواج[ع][0]
  ارجع سهام

تأكد_يساوي(اقل_سهام([[10,16],[2,8],[1,6],[7,12]]), 2, "مثال أول")
تأكد_يساوي(اقل_سهام([[1,2],[3,4],[5,6],[7,8]]), 4, "منفصلة")
تأكد_يساوي(اقل_سهام([[1,2],[2,3],[3,4],[4,5]]), 2, "متلامسة")
تأكد_يساوي(اقل_سهام([]), 0, "فارغة")
