# مثال 785 — رسوم السلحفاة
# Turtle graphics
# Demonstrates: اتجاه مدوّر، شبكة نصية
#
# Run:  python apl.py examples/785-turtle-graphics.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# رسوم السلحفاة على شبكة نصية: F أمام، R يمين، L يسار
# Demonstrates: متجه اتجاه مدوّر, رسم على شبكة, إخراج أسطر

دالة سلحفاة(أوامر, عرض, ارتفاع):
  شبكة = []
  لكل ي في نطاق(ارتفاع):
    صف = []
    لكل ج في نطاق(عرض):
      صف.append(" ")
    شبكة.append(صف)
  س = 0
  ص = 0
  دس = 1
  دص = 0
  صف0 = شبكة[0]
  صف0[0] = "*"
  لكل أمر في أوامر:
    لو أمر == "F":
      س = س + دس
      ص = ص + دص
      لو س >= 0 و س < عرض و ص >= 0 و ص < ارتفاع:
        صف = شبكة[ص]
        صف[س] = "*"
    والا_لو أمر == "R":
      مؤقت = دس
      دس = 0 - دص
      دص = مؤقت
    والا_لو أمر == "L":
      مؤقت = دس
      دس = دص
      دص = 0 - مؤقت
  أسطر = []
  لكل ي في نطاق(ارتفاع):
    سطر = ""
    لكل خلية في شبكة[ي]:
      سطر = سطر + خلية
    أسطر.append(سطر)
  ارجع أسطر

ن = سلحفاة("FFRFFLFF", 5, 3)
تأكد_يساوي(ن[0], "***  ", "صف أول")
تأكد_يساوي(ن[1], "  *  ", "صف ثان")
تأكد_يساوي(ن[2], "  ***", "صف ثالث")
ن2 = سلحفاة("FRFRFRF", 2, 2)
تأكد_يساوي(ن2[0], "**", "مربع صف أول")
تأكد_يساوي(ن2[1], "**", "مربع صف ثان")
ن3 = سلحفاة("FFRFF", 3, 2)
تأكد_يساوي(ن3[0], "***", "زاوية أعلى")
تأكد_يساوي(ن3[1], "  *", "زاوية أسفل")
