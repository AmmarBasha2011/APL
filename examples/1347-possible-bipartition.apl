# مثال 1347 — تقسيم ممكن
# Possible bipartition of dislikes
# Demonstrates: رسوم بيانية
#
# Run:  python apl.py examples/1347-possible-bipartition.apl

# كل زوج متنافر حافة
# نلون الرسم بلونين بالبحث بالعرض

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تقسيم_ممكن(ن, تنافر):
  جيران = []
  لكل ع في نطاق(ن + 1):
    جيران.ألحق([])
  لكل ز في تنافر:
    جيران[ز[0]].ألحق(ز[1])
    جيران[ز[1]].ألحق(ز[0])
  لون = [0] * (ن + 1)
  لكل بداية في نطاق(1, ن + 1):
    لو لون[بداية] == 0:
      لون[بداية] = 1
      طابور = [بداية]
      ع = 0
      طالما ع < طول(طابور):
        ق = طابور[ع]
        ع = ع + 1
        لكل ج في جيران[ق]:
          لو لون[ج] == 0:
            لون[ج] = -لون[ق]
            طابور.ألحق(ج)
          والا_لو لون[ج] == لون[ق]:
            ارجع خطأ
  ارجع صواب

تأكد_يساوي(تقسيم_ممكن(4, [[1,2],[1,3],[2,4]]), صواب, "ممكن")
تأكد_يساوي(تقسيم_ممكن(3, [[1,2],[1,3],[2,3]]), خطأ, "مثلث")
تأكد_يساوي(تقسيم_ممكن(2, []), صواب, "بلا تنافر")
