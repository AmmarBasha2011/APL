# مثال 2347 — عدد القمم المحلية
# Count local peaks
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2347-list-count-local-peaks-strict.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع = 0
  لكل ي في نطاق(1, طول(ق) - 1):
    لو ق[ي] > ق[ي - 1] و ق[ي] > ق[ي + 1]:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([1, 3, 2, 4, 1]), 2, "حالة 1")
تأكد_يساوي(ف([1, 2, 3]), 0, "حالة 2")
تأكد_يساوي(ف([3, 1, 3]), 0, "حالة 3")
تأكد_يساوي(ف([1, 5, 1, 5, 1, 5, 1]), 3, "حالة 4")
