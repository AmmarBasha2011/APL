# مثال 2550 — اقتطاع أول 2 أحرف
# First 2 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2550-truncate-text-to-first-2-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:2]

تأكد_يساوي(ف("hello world"), "he", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "ab", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
