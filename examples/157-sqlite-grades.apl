# مثال 157 — تقرير درجات باستعلامات تجميعية
# Grades report with aggregate queries
# Demonstrates: نفذ_كثير، جلب_واحد، دوال SQL التجميعية
#
# Run:  python apl.py examples/157-sqlite-grades.apl

المتغير مسار = "/tmp/apl_grades.db"
لو موجود(مسار):
    احذف_ملف(مسار)

المتغير قاعدة = افتح_قاعدة(مسار)
المتغير م = قاعدة.مؤشر()
م.نفذ("CREATE TABLE درجات (الطالب TEXT, المادة TEXT, الدرجة INTEGER)")
م.نفذ_كثير("INSERT INTO درجات VALUES (?, ?, ?)", [
    ("عمار", "رياضيات", 90), ("عمار", "علوم", 85),
    ("سارة", "رياضيات", 95), ("سارة", "علوم", 92),
    ("خالد", "رياضيات", 70), ("خالد", "علوم", 78),
])
قاعدة.تأكد()

اطبع "المتوسط العام:", م.execute("SELECT AVG(الدرجة) FROM درجات").جلب_واحد()[0]
اطبع "أعلى درجة:", م.execute("SELECT MAX(الدرجة) FROM درجات").جلب_واحد()[0]
اطبع "عدد السجلات:", م.execute("SELECT COUNT(*) FROM درجات").جلب_واحد()[0]
اطبع "متوسط كل طالب:"
لكل صف في م.execute("SELECT الطالب, AVG(الدرجة) FROM درجات GROUP BY الطالب").جلب_الكل():
    اطبع "-", صف[0], ":", صف[1]

قاعدة.أغلق_قاعدة()
احذف_ملف(مسار)
