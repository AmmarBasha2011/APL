# مثال 2191 — رمز غراي لعدد
# Gray code of a number
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2191-gray-code-of-number.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (ن >> 1)

تأكد_يساوي(ف(0), 0, "حالة 0")
تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 3, "حالة 2")
تأكد_يساوي(ف(3), 2, "حالة 3")
تأكد_يساوي(ف(7), 4, "حالة 7")
تأكد_يساوي(ف(8), 12, "حالة 8")
