# مثال 4190 — صف جدول ضرب 31
# Multiplication row of 31
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4190-multiplication-table-row-of-31.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 31]
  ارجع ر

تأكد_يساوي(ف(1), [31], "حالة 1")
تأكد_يساوي(ف(5), [31, 62, 93, 124, 155], "حالة 2")
تأكد_يساوي(ف(10), [31, 62, 93, 124, 155, 186, 217, 248, 279, 310], "حالة 3")
