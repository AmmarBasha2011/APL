# مثال 3767 — تحويل وحدة بأساس 32
# Split by base 32
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3767-minutes-to-hours-and-minutes-base-32.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 32, ن % 32]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 27], "حالة 2")
تأكد_يساوي(ف(60), [1, 28], "حالة 3")
تأكد_يساوي(ف(125), [3, 29], "حالة 4")
تأكد_يساوي(ف(1000), [31, 8], "حالة 5")
