# مثال 1727 — فرز حسب التكرار
# Sort numbers by frequency
# Demonstrates: فرز
#
# Run:  python apl.py examples/1727-sort-by-frequency-then-value.apl

# نعد التكرار بقاموس
# نبني مفتاح فرز من الزوج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فرز_بالتكرار(ق):
  عد = {}
  لكل ع في ق:
    عد[نص(ع)] = عد.get(نص(ع), 0) + 1
  أزواج = []
  لكل ع في ق:
    أزواج.append([1000 - عد[نص(ع)], ع])
  أزواج.sort()
  ناتج = []
  لكل ز في أزواج:
    ناتج.append(ز[1])
  ارجع ناتج

تأكد_يساوي(فرز_بالتكرار([1, 1, 2, 2, 2, 3]), [2, 2, 2, 1, 1, 3], "ثلاثة")
تأكد_يساوي(فرز_بالتكرار([4, 5]), [4, 5], "تعادل")
