# مثال 606 — مينيماكس بتقليم ألفا-بيتا
# Minimax alpha-beta
# Demonstrates: مينيماكس، تقليم، إكس-أو
#
# Run:  python apl.py examples/606-minimax-ab.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مينيماكس مع تقليم ألفا-بيتا: لعب مثالي في إكس-أو
# Demonstrates: بحث شجرة اللعبة, تقليم, تقييم المواقف
# X يلعب ليفوز و O ليمنعه؛ القيمة من منظور X

دالة فائز(لوحة):
  خطوط = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]
  لكل خط في خطوط:
    أ = لوحة[خط[0]]
    لو أ != "" و أ == لوحة[خط[1]] و أ == لوحة[خط[2]]:
      ارجع أ
  لو "" في لوحة:
    ارجع ""
  ارجع "تعادل"

دالة مينيماكس(لوحة, دور_إكس, ألفا, بيتا):
  نتيجة = فائز(لوحة)
  لو نتيجة == "X":
    ارجع 1
  لو نتيجة == "O":
    ارجع -1
  لو نتيجة == "تعادل":
    ارجع 0
  لو دور_إكس:
    أفضل = -2
    لكل ي في نطاق(9):
      لو لوحة[ي] == "":
        لوحة[ي] = "X"
        أفضل = أكبر(أفضل, مينيماكس(لوحة, خطأ, ألفا, بيتا))
        لوحة[ي] = ""
        ألفا = أكبر(ألفا, أفضل)
        لو بيتا <= ألفا:
          ارجع أفضل
    ارجع أفضل
  أفضل = 2
  لكل ي في نطاق(9):
    لو لوحة[ي] == "":
      لوحة[ي] = "O"
      أفضل = أصغر(أفضل, مينيماكس(لوحة, صواب, ألفا, بيتا))
      لوحة[ي] = ""
      بيتا = أصغر(بيتا, أفضل)
      لو بيتا <= ألفا:
        ارجع أفضل
  ارجع أفضل

لوحة1 = ["X","X","","","","O","","O","",""]
تأكد_يساوي(مينيماكس(لوحة1, صواب, -2, 2), 1, "X يكمل الصف ويفوز")
لوحة2 = ["X","O","X","X","O","O","O","X",""]
تأكد_يساوي(مينيماكس(لوحة2, صواب, -2, 2), 0, "ملء الأخير تعادل")
لوحة3 = ["O","O","","X","X","","","",""]
تأكد_يساوي(مينيماكس(لوحة3, خطأ, -2, 2), -1, "O يكمل الصف ويفوز")
اطبع "تقييم الموقف الأول:", مينيماكس(لوحة1, صواب, -2, 2)
