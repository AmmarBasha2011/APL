# مثال 2889 — الحد النوني بخطوة 20
# Nth term step 20
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2889-nth-term-arithmetic-sequence-step-20.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 20

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 23, "حالة 2")
تأكد_يساوي(ف(10), 183, "حالة 3")
تأكد_يساوي(ف(100), 1983, "حالة 4")
