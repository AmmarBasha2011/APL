# مثال 3252 — مساحة مستطيل مكبر 10 مرات
# Rectangle area scaled by 10
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3252-rectangle-area-scaled-by-10.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 10) * (ق[1] * 10)

تأكد_يساوي(ف([1, 2]), 200, "حالة 1")
تأكد_يساوي(ف([3, 4]), 1200, "حالة 2")
تأكد_يساوي(ف([5, 5]), 2500, "حالة 3")
تأكد_يساوي(ف([10, 1]), 1000, "حالة 4")
