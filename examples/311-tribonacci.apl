# مثال 311 — متتالية تريبوناتشي
# Tribonacci sequence
# Demonstrates: مجموع ثلاثة حدود سابقة
#
# Run:  python apl.py examples/311-tribonacci.apl

دالة تريبوناتشي(ن):
    لو ن == 0:
        ارجع 0
    لو ن <= 2:
        ارجع 1
    المتغير أ = 0
    المتغير ب = 1
    المتغير ج = 1
    لكل _ في نطاق(3, ن + 1):
        المتغير تالي = أ + ب + ج
        أ = ب
        ب = ج
        ج = تالي
    ارجع ج

لكل ن في نطاق(10):
    اطبع ن, ":", تريبوناتشي(ن)
