# مثال 825 — متتالية هالتون
# Halton sequence
# Demonstrates: انعكاس جذري، أساسات أولية
#
# Run:  python apl.py examples/825-quasi-random-halton.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# متتالية هالتون شبه العشوائية: قلب الجذر بأساسات أولية لتغطية متجانسة
# Demonstrates: انعكاس جذري, أساسان مستقلان, تباين منخفض للتكامل العددي

دالة هالتون(فهرس, أساس):
  ك = 1.0
  نتيجة = 0.0
  ن = فهرس
  طالما ن > 0:
    ك = ك / أساس
    نتيجة = نتيجة + ك * (ن % أساس)
    ن = ن // أساس
  ارجع نتيجة

تأكد_يساوي(مقرب(هالتون(1, 2), 4), 0.5, "أولى أساس 2")
تأكد_يساوي(مقرب(هالتون(2, 2), 4), 0.25, "ثانية أساس 2")
تأكد_يساوي(مقرب(هالتون(3, 2), 4), 0.75, "ثالثة أساس 2")
تأكد_يساوي(مقرب(هالتون(4, 2), 4), 0.125, "رابعة أساس 2")
تأكد_يساوي(مقرب(هالتون(5, 2), 4), 0.625, "خامسة أساس 2")
تأكد_يساوي(مقرب(هالتون(3, 3), 4), 0.1111, "أساس 3")
تأكد_يساوي(مقرب(هالتون(10, 2), 4), 0.3125, "عاشرة أساس 2")
تأكد_يساوي(مقرب(هالتون(7, 5), 4), 0.44, "أساس 5")
نقطة = [مقرب(هالتون(6, 2), 4), مقرب(هالتون(6, 3), 4)]
تأكد_يساوي(نقطة, [0.375, 0.2222], "نقطة ثنائية الأبعاد")
