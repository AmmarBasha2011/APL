# مثال 3668 — إضافة 48 لكل عنصر
# Add 48 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3668-list-add-48-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 48]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [51, 49, 50], "حالة 1")
تأكد_يساوي(ف([5]), [53], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [49, 50, 51, 52, 53, 54], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [46, 48, 55, 55, 52], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [58, 68, 58, 78, 68, 58], "حالة 5")
