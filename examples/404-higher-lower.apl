# مثال 404 — أعلى أم أدنى
# Higher or lower cards
# Demonstrates: تخمين متسلسل
#
# Run:  python apl.py examples/404-higher-lower.apl

بذرة(8)
المتغير حالية = عشوائي_عدد(1, 13)
اطبع "البطاقة:", حالية

المتغير سلسلة = 0
طالما سلسلة < 5:
    المتغير تالية = عشوائي_عدد(1, 13)
    المتغير تخمين = "أعلى"
    لو تالية < حالية:
        تخمين = "أدنى"
    اطبع "التالية:", تالية, "التخمين:", تخمين
    لو (تخمين == "أعلى" و تالية > حالية) أو (تخمين == "أدنى" و تالية < حالية):
        سلسلة = سلسلة + 1
        حالية = تالية
    الا لو تالية == حالية:
        حالية = تالية
    الا:
        توقف

اطبع "السلسلة النهائية:", سلسلة
