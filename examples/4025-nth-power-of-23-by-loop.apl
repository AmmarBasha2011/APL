# مثال 4025 — قوة 23 بالحلقة
# Power of 23 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4025-nth-power-of-23-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 23
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 23, "حالة 2")
تأكد_يساوي(ف(3), 12167, "حالة 3")
تأكد_يساوي(ف(6), 148035889, "حالة 4")
تأكد_يساوي(ف(10), 41426511213649, "حالة 5")
