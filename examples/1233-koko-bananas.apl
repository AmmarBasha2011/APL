# مثال 1233 — كوكو والموز
# Koko eating bananas
# Demonstrates: بحث ثنائي على الجواب
#
# Run:  python apl.py examples/1233-koko-bananas.apl

# نبحث ثنائياً عن السرعة
# والساعات اللازمة مجموع سقف قسمة كل كومة على السرعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ساعات(اكوام, سرعة):
  مج = 0
  لكل ك في اكوام:
    مج = مج + (ك + سرعة - 1) // سرعة
  ارجع مج

دالة اقل_سرعة(اكوام, ساعات_):
  يسار = 1
  يمين = 1
  لكل ك في اكوام:
    لو ك > يمين:
      يمين = ك
  طالما يسار < يمين:
    وسط = (يسار + يمين) // 2
    لو ساعات(اكوام, وسط) <= ساعات_:
      يمين = وسط
    والا:
      يسار = وسط + 1
  ارجع يسار

تأكد_يساوي(اقل_سرعة([3,6,7,11], 8), 4, "مثال أول")
تأكد_يساوي(اقل_سرعة([30,11,23,4,20], 5), 30, "خمس ساعات")
تأكد_يساوي(اقل_سرعة([30,11,23,4,20], 6), 23, "ست ساعات")
