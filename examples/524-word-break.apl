# مثال 524 — تقطيع الكلمات
# Word break DP
# Demonstrates: برمجة ديناميكية، تقطيع كلمات
#
# Run:  python apl.py examples/524-word-break.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تقطيع جملة إلى كلمات قاموس (برمجة ديناميكية)
دالة قابل_للتقطيع(نص, قاموس_كلمات):
    المتغير ممكن = [صواب]
    لكل i في نطاق(1, طول(نص) + 1):
        ممكن.أضف(خطأ)
    لكل i في نطاق(1, طول(نص) + 1):
        لكل كلمة في قاموس_كلمات:
            المتغير ط = طول(كلمة)
            لو i >= ط و ممكن[i - ط] و نص[i - ط:i] == كلمة:
                ممكن[i] = صواب
    ارجع ممكن[طول(نص)]

المتغير قاموس_كلمات = ["cat", "cats", "and", "sand", "dog"]
تأكد_يساوي(قابل_للتقطيع("catsanddog", قاموس_كلمات), صواب, "قابل")
تأكد_يساوي(قابل_للتقطيع("catsandog", قاموس_كلمات), خطأ, "غير قابل")
