# مثال 1211 — قلب شجرة
# Invert binary tree
# Demonstrates: تكرار ذاتي
#
# Run:  python apl.py examples/1211-tree-invert.apl

# نقلب كل فرع أولاً
# ثم نبدل مكانيهما

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقلب(ش):
  لو طول(ش) == 0:
    ارجع []
  ارجع [ش[0], اقلب(ش[2]), اقلب(ش[1])]

شجرة = [4, [2, [1, [], []], [3, [], []]], [7, [6, [], []], [9, [], []]]]
مقلوبة = [4, [7, [9, [], []], [6, [], []]], [2, [3, [], []], [1, [], []]]]
تأكد_يساوي(اقلب(شجرة), مقلوبة, "مثال أول")
تأكد_يساوي(اقلب(اقلب(شجرة)), شجرة, "قلبان")
تأكد_يساوي(اقلب([]), [], "فارغة")
