# مثال 852 — الأعداد الوفيرة
# Abundant numbers
# Demonstrates: قواسم تفوق العدد
#
# Run:  python apl.py examples/852-abundant-numbers.apl

# الأعداد الوفيرة: مجموع قواسمها الذاتية أكبر منها
# 12 هو أولها: 1+2+3+4+6 = 16 > 12

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجموع_القواسم(ن):
  مجموع = 0
  لكل ق في نطاق(1, ن):
    لو ن % ق == 0:
      مجموع = مجموع + ق
  ارجع مجموع

وفيرة = []
لكل ن في نطاق(2, 31):
  لو مجموع_القواسم(ن) > ن:
    وفيرة.ألحق(ن)

اطبع "الوفيرة حتى 30:", وفيرة

تأكد_يساوي(طول(وفيرة), 5, "خمسة حتى 30")
تأكد_يساوي(وفيرة[0], 12, "الأول")
تأكد_يساوي(وفيرة[4], 30, "الخامس")

# كل الوفيرة تحت 100 زوجية: أول وفيرة فردية هي 945
أول_فردية = 0
لكل ن في نطاق(3, 946):
  لو ن % 2 == 1 و مجموع_القواسم(ن) > ن:
    لو أول_فردية == 0:
      أول_فردية = ن
تأكد_يساوي(أول_فردية, 945, "أول وفيرة فردية هي 945")
