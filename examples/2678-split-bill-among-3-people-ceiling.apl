# مثال 2678 — تقسيم الفاتورة على 3
# Split bill among 3
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2678-split-bill-among-3-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 3 - 1) // 3

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 4, "حالة 2")
تأكد_يساوي(ف(100), 34, "حالة 3")
تأكد_يساوي(ف(101), 34, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
