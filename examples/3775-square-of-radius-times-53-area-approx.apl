# مثال 3775 — مساحة دائرة بتقريب 53
# Circle area with pi approx 53/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3775-square-of-radius-times-53-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 53 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 7, "حالة 2")
تأكد_يساوي(ف(7), 371, "حالة 3")
تأكد_يساوي(ف(14), 1484, "حالة 4")
تأكد_يساوي(ف(21), 3339, "حالة 5")
