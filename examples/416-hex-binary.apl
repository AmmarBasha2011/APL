# مثال 416 — تحويلات عددية
# Number base conversions
# Demonstrates: ثنائي وسداسي وثماني يدويا
#
# Run:  python apl.py examples/416-hex-binary.apl

دالة إلى_أساس(عدد, أساس_التحويل):
    لو عدد == 0:
        ارجع "0"
    المتغير أرقام = "0123456789ABCDEF"
    المتغير ناتج = ""
    طالما عدد > 0:
        ناتج = أرقام[عدد % أساس_التحويل] + ناتج
        عدد = عدد // أساس_التحويل
    ارجع ناتج

اطبع "255 ثنائي:", إلى_أساس(255, 2)
اطبع "255 سداسي:", إلى_أساس(255, 16)
اطبع "255 ثماني:", إلى_أساس(255, 8)
