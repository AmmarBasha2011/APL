# مثال 1645 — العدد الناقص
# Deficient number check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1645-deficient-number-check.apl

# نجمع القواسم دون العدد نفسه
# نقارن المجموع بالعدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ناقص(ن):
  مجموع = 0
  لكل ك في نطاق(1, ن):
    لو ن % ك == 0:
      مجموع = مجموع + ك
  ارجع مجموع < ن

تأكد_يساوي(ناقص(8), صواب, "ثمانية")
تأكد_يساوي(ناقص(12), خطأ, "وافر")
تأكد_يساوي(ناقص(6), خطأ, "تام")
تأكد_يساوي(ناقص(7), صواب, "أولي")
