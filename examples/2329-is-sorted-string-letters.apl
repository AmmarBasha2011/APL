# مثال 2329 — هل حروف النص مرتبة
# Are letters sorted
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2329-is-sorted-string-letters.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لكل ي في نطاق(طول(ن) - 1):
    لو ن[ي] > ن[ي + 1]:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف("abc"), صواب, "حالة 1")
تأكد_يساوي(ف("acb"), خطأ, "حالة 2")
تأكد_يساوي(ف("aabbcc"), صواب, "حالة 3")
تأكد_يساوي(ف("a"), صواب, "حالة 4")
تأكد_يساوي(ف("zyx"), خطأ, "حالة 5")
