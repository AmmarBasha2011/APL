# مثال 2959 — صف جدول ضرب 3
# Multiplication row of 3
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2959-multiplication-table-row-of-3.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 3]
  ارجع ر

تأكد_يساوي(ف(1), [3], "حالة 1")
تأكد_يساوي(ف(5), [3, 6, 9, 12, 15], "حالة 2")
تأكد_يساوي(ف(10), [3, 6, 9, 12, 15, 18, 21, 24, 27, 30], "حالة 3")
