# مثال 2369 — عدد الثلاثيات الفيثاغورية
# Pythagorean triples count
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2369-pythagorean-triples-count-up-to.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل أ في نطاق(1, ن + 1):
    لكل ب في نطاق(أ + 1, ن + 1):
      لكل ج في نطاق(ب + 1, ن + 1):
        لو أ * أ + ب * ب == ج * ج:
          ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(5), 1, "حالة 1")
تأكد_يساوي(ف(13), 3, "حالة 2")
تأكد_يساوي(ف(20), 6, "حالة 3")
تأكد_يساوي(ف(30), 11, "حالة 4")
