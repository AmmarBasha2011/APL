# مثال 1466 — ترتيب النتائج مع التعادل
# Ranking scores with ties
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1466-score-ranking-ties.apl

# نرتب النتائج تنازلياً
# المركز التالي يقفز بعدد المتعادلين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة المراكز(نتائج):
  مرتبة = []
  لكل ن في نتائج:
    مرتبة.append(ن)
  مرتبة.sort()
  مرتبة.reverse()
  مركز = {}
  لكل ع في نطاق(طول(مرتبة)):
    موجود = مرتبة[ع] في مركز
    لو موجود == خطأ:
      مركز[مرتبة[ع]] = ع + 1
  ناتج = []
  لكل ن في نتائج:
    ناتج.append(مركز[ن])
  ارجع ناتج

تأكد_يساوي(المراكز([100, 90, 90, 80]), [1, 2, 2, 4], "تعادل")
تأكد_يساوي(المراكز([5, 5, 5]), [1, 1, 1], "الكل متعادل")
تأكد_يساوي(المراكز([1, 2, 3]), [3, 2, 1], "بلا تعادل")
