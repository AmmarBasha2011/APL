# مثال 182 — معالجة الأخطاء
# Error handling
# Demonstrates: حاول، إمسك مثل، أخيراً
#
# Run:  python apl.py examples/182-error-handling.apl

دالة اقسم(أ, ب):
    حاول:
        ارجع نص(أ / ب)
    إمسك مثل خطأ:
        ارجع "خطأ: القسمة على صفر"

اطبع "10 / 2 =", اقسم(10, 2)
اطبع "10 / 0 =", اقسم(10, 0)

دالة حول_رقم(س):
    حاول:
        ارجع صحيح(س)
    إمسك مثل خطأ:
        ارجع -1
    أخيراً:
        اطبع "انتهت محاولة التحويل:", س

اطبع حول_رقم("42")
اطبع حول_رقم("ليس رقما")
