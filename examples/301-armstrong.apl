# مثال 301 — أعداد أرمسترونج
# Armstrong numbers
# Demonstrates: مجموع قوى الأرقام
#
# Run:  python apl.py examples/301-armstrong.apl

دالة أرمسترونج(عدد):
    المتغير أرقام = نص(عدد)
    المتغير طول_الأرقام = طول(أرقام)
    المتغير مجموع = 0
    لكل رقم في أرقام:
        مجموع = مجموع + صحيح(رقم) ** طول_الأرقام
    ارجع مجموع == عدد

اطبع "153:", أرمسترونج(153)
اطبع "9474:", أرمسترونج(9474)
اطبع "100:", أرمسترونج(100)

المتغير قائمة = [ن لكل ن في نطاق(1, 1000) لو أرمسترونج(ن)]
اطبع "أرمسترونج حتى 1000:", قائمة
