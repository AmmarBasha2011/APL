# مثال 1579 — آلة مكدس صغيرة
# Tiny stack virtual machine
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1579-tiny-stack-vm.apl

# كل تعليمة إما دفع رقم أو عملية
# العملية تسحب رقمين وتدفع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نفّذ(برنامج):
  مكدس = []
  لكل ت في برنامج:
    أجزاء = ت.split(" ")
    لو أجزاء[0] == "push":
      مكدس.append(صحيح(أجزاء[1]))
    والا:
      ب = مكدس.pop()
      أ = مكدس.pop()
      لو أجزاء[0] == "add":
        مكدس.append(أ + ب)
      والا_لو أجزاء[0] == "mul":
        مكدس.append(أ * ب)
      والا_لو أجزاء[0] == "sub":
        مكدس.append(أ - ب)
  ارجع مكدس[طول(مكدس) - 1]

تأكد_يساوي(نفّذ(["push 2", "push 3", "add"]), 5, "جمع")
تأكد_يساوي(نفّذ(["push 2", "push 3", "push 4", "mul", "add"]), 14, "ضرب وجمع")
تأكد_يساوي(نفّذ(["push 10", "push 4", "sub"]), 6, "طرح")
