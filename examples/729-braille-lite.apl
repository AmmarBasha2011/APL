# مثال 729 — برايل مصغر
# Braille lite
# Demonstrates: نقاط، خريطة حروف، يونيكود
#
# Run:  python apl.py examples/729-braille-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# برايل للاتينية: نقاط إلى أنماط يونيكود
# Demonstrates: بتات النقاط الثماني, أساس U+2800, ترميز أحرف
# a نقطة واحدة، z خمس نقاط، الفراغ نمط فارغ

دالة نقاط_حرف(ح):
  خريطة = {
    "a": [1], "b": [1, 2], "c": [1, 4], "d": [1, 4, 5], "e": [1, 5],
    "f": [1, 2, 4], "g": [1, 2, 4, 5], "h": [1, 2, 5], "i": [2, 4], "j": [2, 4, 5],
    "k": [1, 3], "l": [1, 2, 3], "m": [1, 3, 4], "n": [1, 3, 4, 5], "o": [1, 3, 5],
    "p": [1, 2, 3, 4], "q": [1, 2, 3, 4, 5], "r": [1, 2, 3, 5], "s": [2, 3, 4], "t": [2, 3, 4, 5],
    "u": [1, 3, 6], "v": [1, 2, 3, 6], "w": [2, 4, 5, 6], "x": [1, 3, 4, 6],
    "y": [1, 3, 4, 5, 6], "z": [1, 3, 5, 6]
  }
  ارجع خريطة.get(ح, [])

دالة برايل_حرف(ح):
  لو ح == " ":
    ارجع فك_ترميز_حرف(10240)
  مجموع = 0
  لكل ن في نقاط_حرف(ح):
    لو ن == 1:
      مجموع = مجموع + 1
    والا_لو ن == 2:
      مجموع = مجموع + 2
    والا_لو ن == 3:
      مجموع = مجموع + 4
    والا_لو ن == 4:
      مجموع = مجموع + 8
    والا_لو ن == 5:
      مجموع = مجموع + 16
    والا:
      مجموع = مجموع + 32
  ارجع فك_ترميز_حرف(10240 + مجموع)

دالة برايل(نص):
  ناتج = ""
  لكل ي في نطاق(طول(نص)):
    ناتج = ناتج + برايل_حرف(نص[ي])
  ارجع ناتج

تأكد_يساوي(برايل_حرف("a"), "⠁", "a نقطة أولى")
تأكد_يساوي(برايل_حرف("b"), "⠃", "b نقطتان")
تأكد_يساوي(برايل_حرف("c"), "⠉", "c نقطتان متباعدتان")
تأكد_يساوي(برايل_حرف("z"), "⠵", "z خمس نقاط")
تأكد_يساوي(برايل_حرف(" "), "⠀", "فراغ فارغ")
تأكد_يساوي(برايل("abc"), "⠁⠃⠉", "كلمة قصيرة")
تأكد_يساوي(ترميز_حرف(برايل_حرف("a")), 10241, "الأساس زائد واحد")
اطبع برايل("hello")
