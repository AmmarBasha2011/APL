# مثال 3589 — صف جدول ضرب 21
# Multiplication row of 21
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3589-multiplication-table-row-of-21.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 21]
  ارجع ر

تأكد_يساوي(ف(1), [21], "حالة 1")
تأكد_يساوي(ف(5), [21, 42, 63, 84, 105], "حالة 2")
تأكد_يساوي(ف(10), [21, 42, 63, 84, 105, 126, 147, 168, 189, 210], "حالة 3")
