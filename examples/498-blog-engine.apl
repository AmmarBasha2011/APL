# مثال 498 — مولد مدونة ثابتة
# Static blog generator
# Demonstrates: منشورات JSON إلى HTML
#
# Run:  python apl.py examples/498-blog-engine.apl

المتغير منشورات = [
    {"عنوان": "مرحبا بالعالم", "نص": "أول منشور في المدونة"},
    {"عنوان": "تعلم APL", "نص": "لغة برمجة عربية جميلة"}
]
اكتب_ملف_جسون(منشورات, "/tmp/apl-498.json")

المتغير محملة = اقرأ_ملف_جسون("/tmp/apl-498.json")
المتغير صفحة = "<html><body>\n"
لكل منشور في محملة:
    صفحة = صفحة + "<h2>" + منشور["عنوان"] + "</h2>\n<p>" + منشور["نص"] + "</p>\n"
صفحة = صفحة + "</body></html>"

اكتب("/tmp/apl-498.html", صفحة)
اطبع "تم توليد المدونة:", طول(صفحة), "حرف"
احذف_ملف("/tmp/apl-498.json")
احذف_ملف("/tmp/apl-498.html")
