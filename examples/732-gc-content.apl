# مثال 732 — نسبة GC
# GC content
# Demonstrates: نوافذ منزلقة، نسب مئوية، أغنى نافذة
#
# Run:  python apl.py examples/732-gc-content.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# نسبة GC في تسلسل DNA ونوافذها المنزلقة
# Demonstrates: عد شرطي, نسبة مئوية, نافذة منزلقة
# الجينات تميل لمناطق غنية بـGC

دالة نسبة_gc(سلسلة):
  عدد = 0
  لكل ي في نطاق(طول(سلسلة)):
    لو سلسلة[ي] == "G" أو سلسلة[ي] == "C":
      عدد = عدد + 1
  ارجع عدد * 100.0 / طول(سلسلة)

دالة نوافذ(سلسلة, عرض):
  ناتج = []
  لكل بداية في نطاق(طول(سلسلة) - عرض + 1):
    ناتج.append(نسبة_gc(سلسلة[بداية:بداية + عرض]))
  ارجع ناتج

دالة أغنى_نافذة(سلسلة, عرض):
  قيم = نوافذ(سلسلة, عرض)
  أفضل = 0
  لكل ي في نطاق(1, طول(قيم)):
    لو قيم[ي] > قيم[أفضل]:
      أفضل = ي
  ارجع [أفضل, قيم[أفضل]]

تأكد_يساوي(نسبة_gc("ATGC"), 50.0, "نصف GC")
تأكد_يساوي(نسبة_gc("GGCC"), 100.0, "كامل GC")
تأكد_يساوي(نسبة_gc("ATAT"), 0.0, "بلا GC")
تأكد_يساوي(مقرب(نسبة_gc("ATGCCGTA"), 1), 50.0, "ثمانية قواعد")
ن = نوافذ("ATGGCCAT", 4)
تأكد_يساوي(طول(ن), 5, "خمس نوافذ")
تأكد_يساوي(ن[0], 50.0, "أول نافذة")
تأكد_يساوي(ن[2], 100.0, "نافذة GGCC كاملة")
غ = أغنى_نافذة("ATGGCCAT", 4)
تأكد_يساوي(غ, [2, 100.0], "الأغنى عند 2")
اطبع "نسبة ATGCCGTA:", نسبة_gc("ATGCCGTA")
