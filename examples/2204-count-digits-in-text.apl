# مثال 2204 — عدد الأرقام في النص
# Count digit characters
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2204-count-digits-in-text.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح.isdigit():
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("abc123"), 3, "حالة 1")
تأكد_يساوي(ف("2026"), 4, "حالة 2")
تأكد_يساوي(ف("none"), 0, "حالة 3")
تأكد_يساوي(ف("a1b2c3d4"), 4, "حالة 4")
