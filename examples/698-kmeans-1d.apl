# مثال 698 — تجميع k-means أحادي
# 1D k-means
# Demonstrates: مراكز، إسناد، تقارب
#
# Run:  python apl.py examples/698-kmeans-1d.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تجميع k-means على بيانات أحادية البعد
# Demonstrates: إسناد لأقرب مركز, إعادة حساب المتوسطات, تقارب
# البذرة: أول وآخر قيمة، فتكون النتيجة حتمية

دالة ك_متوسطات(بيانات, ك):
  مراكز = [بيانات[0] * 1.0, بيانات[طول(بيانات) - 1] * 1.0]
  إسناد = []
  لكل ي في نطاق(طول(بيانات)):
    إسناد.append(0)
  دورات = 0
  لكل دورة في نطاق(20):
    تغير = خطأ
    لكل ي في نطاق(طول(بيانات)):
      ق = بيانات[ي]
      د0 = ق - مراكز[0]
      لو د0 < 0:
        د0 = -د0
      د1 = ق - مراكز[1]
      لو د1 < 0:
        د1 = -د1
      جديد = 0
      لو د1 < د0:
        جديد = 1
      لو جديد != إسناد[ي]:
        إسناد[ي] = جديد
        تغير = صواب
    جديدان = [0.0, 0.0]
    أعداد = [0, 0]
    لكل ي في نطاق(طول(بيانات)):
      جديدان[إسناد[ي]] = جديدان[إسناد[ي]] + بيانات[ي]
      أعداد[إسناد[ي]] = أعداد[إسناد[ي]] + 1
    لكل ج في نطاق(2):
      لو أعداد[ج] > 0:
        جديدان[ج] = جديدان[ج] / أعداد[ج]
      والا:
        جديدان[ج] = مراكز[ج]
    مراكز = جديدان
    دورات = دورات + 1
    لو تغير == خطأ:
      ارجع [مراكز, إسناد, دورات]
  ارجع [مراكز, إسناد, دورات]

ناتج = ك_متوسطات([1, 2, 3, 10, 11, 12], 2)
تأكد_يساوي(ناتج[0], [2.0, 11.0], "مركزا العنقودين")
تأكد_يساوي(ناتج[1], [0, 0, 0, 1, 1, 1], "الإسنادات")
تأكد_يساوي(ناتج[2], 2, "تقارب بعد دورتين")
ناتج2 = ك_متوسطات([5, 1, 9, 2, 8, 1], 2)
تأكد_يساوي(ناتج2[1][0], ناتج2[1][2], "الكبار معا")
تأكد_يساوي(ناتج2[1][1], ناتج2[1][3], "الصغار معا")
اطبع "المراكز:", ناتج[0]
