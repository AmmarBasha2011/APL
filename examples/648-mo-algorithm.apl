# مثال 648 — خوارزمية مو
# Mo's algorithm
# Demonstrates: استعلامات مدى، ترتيب كتل، مؤشرات
#
# Run:  python apl.py examples/648-mo-algorithm.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# خوارزمية مو: استعلامات المدى بإعادة ترتيب
# Demonstrates: ترتيب بالكتل, تحريك المؤشرات, عدادات متزايدة
# يجيب استعلامات كثيرة بنقل كل مؤشر بضع مرات فقط

بيانات = [1, 2, 1, 3, 2, 1, 4, 5, 4, 2, 3, 1]
ن = 12
كتلة = 3

استعلامات = [[0, 3], [2, 5], [4, 8], [6, 11], [0, 11]]
مرقمة = []
لكل ي في نطاق(طول(استعلامات)):
  مرقمة.append([استعلامات[ي][0] // كتلة, استعلامات[ي][1], استعلامات[ي][0], ي])
مرقمة.sort()

عدادات = [0, 0, 0, 0, 0, 0]
مميزة = [0]
دالة وسع(موضع):
  ق = بيانات[موضع]
  لو عدادات[ق] == 0:
    مميزة[0] = مميزة[0] + 1
  عدادات[ق] = عدادات[ق] + 1
دالة ضيق(موضع):
  ق = بيانات[موضع]
  عدادات[ق] = عدادات[ق] - 1
  لو عدادات[ق] == 0:
    مميزة[0] = مميزة[0] - 1

يسار = 0
يمين = -1
إجابات = [0, 0, 0, 0, 0]
لكل س في مرقمة:
  طالما يمين < س[1]:
    يمين = يمين + 1
    وسع(يمين)
  طالما يمين > س[1]:
    ضيق(يمين)
    يمين = يمين - 1
  طالما يسار < س[2]:
    ضيق(يسار)
    يسار = يسار + 1
  طالما يسار > س[2]:
    يسار = يسار - 1
    وسع(يسار)
  إجابات[س[3]] = مميزة[0]

مرجع = []
لكل س في استعلامات:
  مرجع.append(طول(مجموعة_فريدة(بيانات[س[0]:س[1] + 1])))
تأكد_يساوي(إجابات, مرجع, "مو يطابق المرجع المباشر")
تأكد_يساوي(إجابات[4], 5, "المميزة في المدى الكامل")
اطبع "إجابات:", إجابات
