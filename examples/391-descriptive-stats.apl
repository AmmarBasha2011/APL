# مثال 391 — إحصاءات وصفية
# Descriptive statistics
# Demonstrates: المتوسط، الوسيط، المنوال يدويا
#
# Run:  python apl.py examples/391-descriptive-stats.apl

دالة متوسط(قائمة):
    المتغير مجموع = 0
    لكل ق in قائمة:
        مجموع = مجموع + ق
    ارجع مجموع / طول(قائمة)

دالة وسيط_قائمة(قائمة):
    المتغير م = مفرز(قائمة)
    المتغير ن = طول(م)
    لو ن % 2 == 1:
        ارجع م[ن // 2]
    ارجع (م[ن // 2 - 1] + م[ن // 2]) / 2

دالة منوال(قائمة):
    المتغير تكرار = {}
    لكل ق in قائمة:
        المتغير قديم = تكرار.get(ق, 0)
        تكرار[ق] = قديم + 1
    المتغير أفضل = قائمة[0]
    لكل مفتاح in تكرار.keys():
        لو تكرار[مفتاح] > تكرار[أفضل]:
            أفضل = مفتاح
    ارجع أفضل

المتغير بيانات = [12, 15, 12, 18, 20, 15, 12, 22, 25]
اطبع "المتوسط:", متوسط(بيانات)
اطبع "الوسيط:", وسيط_قائمة(بيانات)
اطبع "المنوال:", منوال(بيانات)
