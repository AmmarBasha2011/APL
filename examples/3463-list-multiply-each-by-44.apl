# مثال 3463 — ضرب كل عنصر في 44
# Multiply each item by 44
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3463-list-multiply-each-by-44.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 44]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [132, 44, 88], "حالة 1")
تأكد_يساوي(ف([5]), [220], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [44, 88, 132, 176, 220, 264], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-88, 0, 308, 308, 176], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [440, 880, 440, 1320, 880, 440], "حالة 5")
