# مثال 4060 — ضرب كل عنصر في 55
# Multiply each item by 55
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4060-list-multiply-each-by-55.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 55]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [165, 55, 110], "حالة 1")
تأكد_يساوي(ف([5]), [275], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [55, 110, 165, 220, 275, 330], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-110, 0, 385, 385, 220], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [550, 1100, 550, 1650, 1100, 550], "حالة 5")
