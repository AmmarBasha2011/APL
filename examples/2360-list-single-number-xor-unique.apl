# مثال 2360 — العدد الوحيد بـ XOR
# Single number by XOR
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2360-list-single-number-xor-unique.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = 0
  لكل ع في ق:
    ن = ن ^ ع
  ارجع ن

تأكد_يساوي(ف([2, 2, 1]), 1, "حالة 1")
تأكد_يساوي(ف([4, 1, 2, 1, 2]), 4, "حالة 2")
تأكد_يساوي(ف([7]), 7, "حالة 3")
تأكد_يساوي(ف([3, 3, 3]), 3, "حالة 4")
