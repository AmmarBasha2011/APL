# مثال 2464 — عدد مضاعفات 3 حتى حد
# Count multiples of 3 up to limit
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2464-count-multiples-of-3-up-to-limit.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(1, ن + 1):
    لو ي % 3 == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(7), 2, "حالة 2")
تأكد_يساوي(ف(12), 4, "حالة 3")
تأكد_يساوي(ف(50), 16, "حالة 4")
تأكد_يساوي(ف(100), 33, "حالة 5")
