# مثال 487 — محلل استبيان
# Survey analyzer
# Demonstrates: نسب إجابات
#
# Run:  python apl.py examples/487-survey-analyzer.apl

المتغير إجابات = ["ممتاز", "جيد", "ممتاز", "مقبول", "جيد", "ممتاز", "جيد"]
المتغير خيارات = ["ممتاز", "جيد", "مقبول"]

اطبع "نتائج الاستبيان:"
لكل خيار في خيارات:
    المتغير عد = إجابات.count(خيار)
    المتغير نسبة = صحيح(عد / طول(إجابات) * 100)
    اطبع خيار, ":", عد, "(" + نص(نسبة) + "%)"
