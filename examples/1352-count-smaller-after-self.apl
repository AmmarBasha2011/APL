# مثال 1352 — الأصغر بعد العنصر
# Count smaller numbers after self
# Demonstrates: شجرة فينويك
#
# Run:  python apl.py examples/1352-count-smaller-after-self.apl

# نمر من اليمين إلى اليسار
# ونستخدم شجرة فينويك على رتب القيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اصغر_بعدي(أرقام):
  قيم = مفرز(أرقام)
  رتبة = {}
  ر = 1
  لكل ق في قيم:
    لو ق ليس في رتبة:
      رتبة[ق] = ر
      ر = ر + 1
  ن = ر
  شجرة = [0] * (ن + 1)
  ناتج = [0] * طول(أرقام)
  لكل ع في نطاق(طول(أرقام) - 1, -1, -1):
    ك = رتبة[أرقام[ع]] - 1
    مجموع = 0
    طالما ك > 0:
      مجموع = مجموع + شجرة[ك]
      ك = ك - (ك & (-ك))
    ناتج[ع] = مجموع
    ك = رتبة[أرقام[ع]]
    طالما ك <= ن:
      شجرة[ك] = شجرة[ك] + 1
      ك = ك + (ك & (-ك))
  ارجع ناتج

تأكد_يساوي(اصغر_بعدي([5,2,6,1]), [2,1,1,0], "مثال أول")
تأكد_يساوي(اصغر_بعدي([-1]), [0], "عنصر")
تأكد_يساوي(اصغر_بعدي([-1,-1]), [0,0], "متساويان")
