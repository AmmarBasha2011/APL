# مثال 1316 — تقسيم إلى k مجموعات
# Partition to k equal sum subsets
# Demonstrates: رجوع
#
# Run:  python apl.py examples/1316-partition-k-subsets.apl

# الهدف مجموع الكل على k
# نملأ كل مجموعة بالعناصر الأكبر أولاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة املأ(أ, ع, مجاميع, هدف):
  لو ع == طول(أ):
    ارجع صواب
  جرب = []
  لكل ك في نطاق(طول(مجاميع)):
    لو (مجاميع[ك] + أ[ع] <= هدف) و (مجاميع[ك] ليس في جرب):
      جرب.ألحق(مجاميع[ك])
      مجاميع[ك] = مجاميع[ك] + أ[ع]
      ن = املأ(أ, ع + 1, مجاميع, هدف)
      مجاميع[ك] = مجاميع[ك] - أ[ع]
      لو ن:
        ارجع صواب
  ارجع خطأ

دالة يقسم_ك(أ, ك):
  مج = 0
  لكل س في أ:
    مج = مج + س
  لو مج % ك != 0:
    ارجع خطأ
  ق = مفرز(أ)
  ق.reverse()
  لو ق[0] > مج // ك:
    ارجع خطأ
  ارجع املأ(ق, 0, [0] * ك, مج // ك)

تأكد_يساوي(يقسم_ك([4,3,2,3,5,2,1], 4), صواب, "أربع مجموعات")
تأكد_يساوي(يقسم_ك([1,2,3,4], 3), خطأ, "لا يقسم")
تأكد_يساوي(يقسم_ك([2,2,2,2,3,4,5], 4), خطأ, "سبعة عناصر")
تأكد_يساوي(يقسم_ك([1,1,1,1], 2), صواب, "اثنتان")
