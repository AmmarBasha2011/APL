# مثال 836 — شجرة سبلاي
# Splay tree
# Demonstrates: زج-زج وزج-زاج، رفع للجذر
#
# Run:  python apl.py examples/836-splay-tree.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شجرة سبلاي: كل وصول يرفع العقدة للجذر بمناورات زج-زج وزج-زاج
# Demonstrates: دورانات, رفع عودي, إدخال بعد الرفع, شجرة [مفتاح, يسار, يمين]

فارغ = 0

دالة دوران_يمين(عقدة):
  فرع = عقدة[1]
  عقدة[1] = فرع[2]
  فرع[2] = عقدة
  ارجع فرع

دالة دوران_يسار(عقدة):
  فرع = عقدة[2]
  عقدة[2] = فرع[1]
  فرع[1] = عقدة
  ارجع فرع

دالة ارفع(جذر, مفتاح):
  لو جذر == فارغ أو جذر[0] == مفتاح:
    ارجع جذر
  لو مفتاح < جذر[0]:
    لو جذر[1] == فارغ:
      ارجع جذر
    لو مفتاح < جذر[1][0]:
      جذر[1][1] = ارفع(جذر[1][1], مفتاح)
      جذر = دوران_يمين(جذر)
    والا_لو مفتاح > جذر[1][0]:
      جذر[1][2] = ارفع(جذر[1][2], مفتاح)
      لو جذر[1][2] != فارغ:
        جذر[1] = دوران_يسار(جذر[1])
    لو جذر[1] == فارغ:
      ارجع جذر
    ارجع دوران_يمين(جذر)
  والا:
    لو جذر[2] == فارغ:
      ارجع جذر
    لو مفتاح > جذر[2][0]:
      جذر[2][2] = ارفع(جذر[2][2], مفتاح)
      جذر = دوران_يسار(جذر)
    والا_لو مفتاح < جذر[2][0]:
      جذر[2][1] = ارفع(جذر[2][1], مفتاح)
      لو جذر[2][1] != فارغ:
        جذر[2] = دوران_يمين(جذر[2])
    لو جذر[2] == فارغ:
      ارجع جذر
    ارجع دوران_يسار(جذر)

دالة أدخل(جذر, مفتاح):
  لو جذر == فارغ:
    ارجع [مفتاح, فارغ, فارغ]
  جذر = ارفع(جذر, مفتاح)
  لو جذر[0] == مفتاح:
    ارجع جذر
  عقدة = [مفتاح, فارغ, فارغ]
  لو مفتاح < جذر[0]:
    عقدة[2] = جذر
    عقدة[1] = جذر[1]
    جذر[1] = فارغ
  والا:
    عقدة[1] = جذر
    عقدة[2] = جذر[2]
    جذر[2] = فارغ
  ارجع عقدة

شجرة = فارغ
لكل مفتاح في [10, 20, 30, 40, 50, 25]:
  شجرة = أدخل(شجرة, مفتاح)
تأكد_يساوي(شجرة[0], 25, "آخر مدرج في الجذر")
تأكد_يساوي(شجرة[1][0], 20, "يسار الجذر")
شجرة = ارفع(شجرة, 10)
تأكد_يساوي(شجرة[0], 10, "رفع عشرة للجذر")
تأكد_يساوي(شجرة[1], فارغ, "لا يسار لعشرة")
تأكد_يساوي(شجرة[2][0], 20, "يمين الجذر")
