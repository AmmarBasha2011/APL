# مثال 3556 — السعر مع ضريبة 27 بالمئة
# Price with 27 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3556-price-with-27-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 27 // 100

تأكد_يساوي(ف(100), 127, "حالة 1")
تأكد_يساوي(ف(250), 317, "حالة 2")
تأكد_يساوي(ف(999), 1268, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
