# مثال 328 — دمج قائمتين يدويا (zip)
# Manual zip
# Demonstrates: أزواج من قائمتين
#
# Run:  python apl.py examples/328-zip-manual.apl

دالة ازدوج(أ, ب):
    المتغير نتيجة = []
    المتغير أقل = طول(أ)
    لو طول(ب) < أقل:
        أقل = طول(ب)
    لكل ي في نطاق(أقل):
        نتيجة.أضف([أ[ي], ب[ي]])
    ارجع نتيجة

اطبع ازدوج(["أحمد", "سارة"], [25, 30])

المتغير قاموس = {}
لكل زوج في ازدوج(["مفتاح1", "مفتاح2"], ["قيمة1", "قيمة2"]):
    قاموس[زوج[0]] = زوج[1]
اطبع قاموس
