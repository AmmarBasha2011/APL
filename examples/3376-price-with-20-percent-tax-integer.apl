# مثال 3376 — السعر مع ضريبة 20 بالمئة
# Price with 20 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3376-price-with-20-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 20 // 100

تأكد_يساوي(ف(100), 120, "حالة 1")
تأكد_يساوي(ف(250), 300, "حالة 2")
تأكد_يساوي(ف(999), 1198, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
