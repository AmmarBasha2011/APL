# مثال 685 — تقييم يد بوكر
# Poker hand evaluator lite
# Demonstrates: فئات، متوالي، عجلة
#
# Run:  python apl.py examples/685-poker-hand-eval-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تقييم يد بوكر من خمس ورقات (فئة فقط)
# Demonstrates: عد التكرارات, كشف المتوالي والملون, العجلة A2345
# 8=ستريت فلش 7=أربعة 6=فول هاوس 5=فلش 4=ستريت 3=ثلاثية 2=زوجان 1=زوج 0=ورقة عالية

دالة قيمة_رتبة(ح):
  حروف = "23456789TJQKA"
  لكل ي في نطاق(طول(حروف)):
    لو حروف[ي] == ح:
      ارجع ي + 2
  ارجع 0

دالة فئة(يد):
  قيم = []
  لكل ورقة في يد:
    قيم.append(قيمة_رتبة(ورقة[0]))
  عداد = []
  لكل ي في نطاق(15):
    عداد.append(0)
  لكل ق في قيم:
    عداد[ق] = عداد[ق] + 1
  ملون = صواب
  لكل ي في نطاق(1, 5):
    لو يد[ي][1] != يد[0][1]:
      ملون = خطأ
  أصغر = 99
  أكبر = 0
  مميزة = []
  لكل ق في قيم:
    لو ق < أصغر:
      أصغر = ق
    لو ق > أكبر:
      أكبر = ق
    لو (ق في مميزة) == خطأ:
      مميزة.append(ق)
  متوالي = خطأ
  لو طول(مميزة) == 5 و أكبر - أصغر == 4:
    متوالي = صواب
  عجلة = صواب
  لكل ق في [14, 2, 3, 4, 5]:
    لو (ق في قيم) == خطأ:
      عجلة = خطأ
  لو متوالي == خطأ و عجلة:
    متوالي = صواب
  لو ملون و متوالي:
    ارجع 8
  لو 4 في عداد:
    ارجع 7
  لو 3 في عداد و 2 في عداد:
    ارجع 6
  لو ملون:
    ارجع 5
  لو متوالي:
    ارجع 4
  لو 3 في عداد:
    ارجع 3
  أزواج = 0
  لكل ي في نطاق(15):
    لو عداد[ي] == 2:
      أزواج = أزواج + 1
  لو أزواج == 2:
    ارجع 2
  لو أزواج == 1:
    ارجع 1
  ارجع 0

تأكد_يساوي(فئة(["TH", "JH", "QH", "KH", "AH"]), 8, "ستريت فلش ملكي")
تأكد_يساوي(فئة(["9C", "9D", "9H", "9S", "2C"]), 7, "أربعة من نوع")
تأكد_يساوي(فئة(["3S", "3H", "3D", "7C", "7S"]), 6, "فول هاوس")
تأكد_يساوي(فئة(["2H", "5H", "8H", "JH", "KH"]), 5, "فلش")
تأكد_يساوي(فئة(["AS", "2D", "3H", "4C", "5S"]), 4, "عجلة متوالية")
تأكد_يساوي(فئة(["5S", "6D", "7H", "8C", "9S"]), 4, "ستريت عادي")
تأكد_يساوي(فئة(["QS", "QD", "QH", "4C", "9S"]), 3, "ثلاثية")
تأكد_يساوي(فئة(["JS", "JD", "8H", "8C", "3S"]), 2, "زوجان")
تأكد_يساوي(فئة(["7S", "7D", "KH", "2C", "9S"]), 1, "زوج واحد")
تأكد_يساوي(فئة(["2S", "5D", "9H", "JC", "KS"]), 0, "ورقة عالية")
اطبع "فئة الفول هاوس:", فئة(["3S", "3H", "3D", "7C", "7S"])
