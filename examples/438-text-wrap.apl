# مثال 438 — التفاف النص
# Text wrapping
# Demonstrates: قص الأسطر بعرض ثابت
#
# Run:  python apl.py examples/438-text-wrap.apl

دالة التف(نص_الدخل, عرض_مطلوب):
    المتغير كلمات = نص_الدخل.تقسيم(" ")
    المتغير سطر = ""
    لكل كلمة في كلمات:
        لو طول(سطر) + طول(كلمة) + 1 > عرض_مطلوب:
            اطبع سطر
            سطر = كلمة
        الا لو سطر == "":
            سطر = كلمة
        الا:
            سطر = سطر + " " + كلمة
    لو سطر != "":
        اطبع سطر

التف("البرمجة بلغة APL سهلة وممتعة وتدعم العربية بالكامل في كل شيء", 30)
