# مثال 4384 — مجموع زوايا مضلع زائد 34
# Polygon angle sum plus 34
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4384-interior-angle-sum-of-polygon-plus-34.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 34

تأكد_يساوي(ف(3), 214, "حالة 1")
تأكد_يساوي(ف(4), 394, "حالة 2")
تأكد_يساوي(ف(5), 574, "حالة 3")
تأكد_يساوي(ف(6), 754, "حالة 4")
تأكد_يساوي(ف(12), 1834, "حالة 5")
