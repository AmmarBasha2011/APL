# مثال 1718 — فك ضغط التكرار المتتالي
# Run length decoding
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1718-string-run-length-decode.apl

# الأرقام تسبق الحرف
# نكرر الحرف بقدر العدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فك_الضغط(س):
  ناتج = ""
  عدد = 0
  لكل ح في س:
    لو ح.isdigit():
      عدد = عدد * 10 + صحيح(ح)
    والا:
      ناتج = ناتج + ح * عدد
      عدد = 0
  ارجع ناتج

تأكد_يساوي(فك_الضغط("3a2b1c"), "aaabbc", "قصير")
تأكد_يساوي(فك_الضغط("10x"), "xxxxxxxxxx", "عشرة")
تأكد_يساوي(فك_الضغط(""), "", "فارغ")
