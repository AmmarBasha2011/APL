# مثال 213 — القائمة المترابطة
# Singly linked list
# Demonstrates: عقد مترابطة، إضافة وطباعة
#
# Run:  python apl.py examples/213-linked-list.apl

صنف عقدة:
    دالة_إنشاء(ذات, قيمة):
        ذات.قيمة = قيمة
        ذات.التالي = لا_شيء

صنف قائمة_مترابطة:
    دالة_إنشاء(ذات):
        ذات.رأس = لا_شيء

    دالة ألحق(ذات, قيمة):
        المتغير جديدة = عقدة(قيمة)
        لو ذات.رأس == لا_شيء:
            ذات.رأس = جديدة
            ارجع
        المتغير حالي = ذات.رأس
        طالما حالي.التالي != لا_شيء:
            حالي = حالي.التالي
        حالي.التالي = جديدة

    دالة اطبع_الكل(ذات):
        المتغير حالي = ذات.رأس
        المتغير عناصر = []
        طالما حالي != لا_شيء:
            عناصر.أضف(حالي.قيمة)
            حالي = حالي.التالي
        اطبع عناصر

    دالة طول_القائمة(ذات):
        المتغير عدد = 0
        المتغير حالي = ذات.رأس
        طالما حالي != لا_شيء:
            عدد = عدد + 1
            حالي = حالي.التالي
        ارجع عدد

المتغير ق = قائمة_مترابطة()
ق.ألحق(1)
ق.ألحق(2)
ق.ألحق(3)
ق.اطبع_الكل()
اطبع "الطول:", ق.طول_القائمة()
