# مثال 460 — مولد متناقضات لفظية
# Palindrome maker
# Demonstrates: بناء أطول متناقض من حروف
#
# Run:  python apl.py examples/460-palindrome-maker.apl

دالة اصنع_متناقض(حروف):
    المتغير تكرار = {}
    لكل حرف في حروف:
        المتغير قديم = تكرار.get(حرف, 0)
        تكرار[حرف] = قديم + 1
    المتغير يسار = ""
    المتغير منتصف = ""
    المتغير حروف_مرتبة = مفرز(تكرار.keys())
    لكل مفتاح في حروف_مرتبة:
        المتغير أزواج = تكرار[مفتاح] // 2
        لكل _ في نطاق(أزواج):
            يسار = يسار + مفتاح
        لو تكرار[مفتاح] % 2 == 1 و منتصف == "":
            منتصف = مفتاح
    المتغير يمين = ""
    لكل ي في نطاق(1, طول(يسار) + 1):
        يمين = يمين + يسار[طول(يسار) - ي]
    ارجع يسار + منتصف + يمين

اطبع اصنع_متناقض("aabbc")
اطبع اصنع_متناقض("aabbbcc")
