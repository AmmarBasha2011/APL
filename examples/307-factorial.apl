# مثال 307 — العاملي (مضروب العدد)
# Factorial
# Demonstrates: تكراري وعودي
#
# Run:  python apl.py examples/307-factorial.apl

دالة عاملي_تكراري(ن):
    المتغير نتيجة = 1
    لكل ي في نطاق(2, ن + 1):
        نتيجة = نتيجة * ي
    ارجع نتيجة

دالة عاملي_عودي(ن):
    لو ن <= 1:
        ارجع 1
    ارجع ن * عاملي_عودي(ن - 1)

اطبع "5! =", عاملي_تكراري(5)
اطبع "10! =", عاملي_عودي(10)
اطبع "20! =", عاملي_تكراري(20)
