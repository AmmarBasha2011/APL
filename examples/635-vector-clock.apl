# مثال 635 — الساعات المتجهة
# Vector clocks
# Demonstrates: ساعة متجهة، تزامن، موزع
#
# Run:  python apl.py examples/635-vector-clock.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الساعات المتجهة: ترتيب الأحداث في نظام موزع
# Demonstrates: عداد لكل عقدة, دمج بالأقصى, كشف التزامن
# حدثان متزامنان لا يسبق أحدهما الآخر

دالة ساعة_جديدة(عقد):
  س = {}
  لكل ع في عقد:
    س[ع] = 0
  ارجع س

دالة حدث_محلي(س, عقدة):
  س[عقدة] = س[عقدة] + 1

دالة ادمج(س1, س2):
  لكل ع في س2:
    لو س2[ع] > س1[ع]:
      س1[ع] = س2[ع]

دالة يسبق(س1, س2):
  أصغر_أو_يساوي = صواب
  أقل_مرة = خطأ
  لكل ع في س1:
    لو س1[ع] > س2[ع]:
      أصغر_أو_يساوي = خطأ
    لو س1[ع] < س2[ع]:
      أقل_مرة = صواب
  ارجع أصغر_أو_يساوي و أقل_مرة

عقد = ["أ", "ب"]
سأ = ساعة_جديدة(عقد)
سب = ساعة_جديدة(عقد)
حدث_محلي(سأ, "أ")
حدث_محلي(سب, "ب")
تأكد_يساوي(يسبق(سأ, سب), خطأ, "حدثان مستقلان متزامنان")
تأكد_يساوي(يسبق(سب, سأ), خطأ, "لا أسبقية عكسية")
ادمج(سب, سأ)
حدث_محلي(سب, "ب")
تأكد_يساوي(يسبق(سأ, سب), صواب, "بعد الدمج أ يسبق ب")
اطبع "ساعة ب:", سب
