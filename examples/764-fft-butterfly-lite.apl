# مثال 764 — فورييه بفراشة
# Radix-2 FFT
# Demonstrates: زوجي/فردي، مركبات كأزواج، جذور وحدة
#
# Run:  python apl.py examples/764-fft-butterfly-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحويل فورييه السريع بفراشة radix-2
# Demonstrates: تقسيم زوجي/فردي, أرقام مركبة كأزواج, جذور الوحدة
# كل مركب = [حقيقي, تخيلي] والتقارب من N² إلى N·log N

ط = 3.14159265358979

دالة جمع_م(أ, ب):
  ارجع [أ[0] + ب[0], أ[1] + ب[1]]

دالة طرح_م(أ, ب):
  ارجع [أ[0] - ب[0], أ[1] - ب[1]]

دالة ضرب_م(أ, ب):
  ارجع [أ[0] * ب[0] - أ[1] * ب[1], أ[0] * ب[1] + أ[1] * ب[0]]

دالة جذر_وحدة(ك, ن):
  زاوية = -2 * ط * ك / ن
  ارجع [جتا(زاوية), جب(زاوية)]

دالة فف(قائمة):
  ن = طول(قائمة)
  لو ن == 1:
    ارجع [قائمة[0]]
  زوجي = []
  فردي = []
  لكل ي في نطاق(ن // 2):
    زوجي.append(قائمة[ي * 2])
    فردي.append(قائمة[ي * 2 + 1])
  ز = فف(زوجي)
  ف = فف(فردي)
  ناتج = []
  لكل ي في نطاق(ن):
    ناتج.append([0, 0])
  لكل ك في نطاق(ن // 2):
    م = ضرب_م(جذر_وحدة(ك, ن), ف[ك])
    ناتج[ك] = جمع_م(ز[ك], م)
    ناتج[ك + ن // 2] = طرح_م(ز[ك], م)
  ارجع ناتج

دالة من_حقيقية(أرقام):
  ناتج = []
  لكل ر في أرقام:
    ناتج.append([ر, 0])
  ارجع ناتج

دالة قرّب_كل(قائمة):
  ناتج = []
  لكل م في قائمة:
    ناتج.append([مقرب(م[0], 4), مقرب(م[1], 4)])
  ارجع ناتج

ناتج = قرّب_كل(فف(من_حقيقية([1, 1, 1, 1, 0, 0, 0, 0])))

تأكد_يساوي(ناتج[0], [4.0, 0.0], "المجموع الكلي")
تأكد_يساوي(ناتج[1], [1.0, -2.4142], "التردد الأول")
تأكد_يساوي(ناتج[3], [1.0, -0.4142], "التردد الثالث")
تأكد_يساوي(ناتج[7], [1.0, 2.4142], "تناظر مرافق")
تأكد_يساوي(ناتج[4], [0.0, 0.0], "تردد نايكوست صفر")

ناتج2 = قرّب_كل(فف(من_حقيقية([0, 1, 0, 0])))
تأكد_يساوي(ناتج2[0], [1.0, 0.0], "نبضة: تيار مستمر")
تأكد_يساوي(ناتج2[1], [0.0, -1.0], "نبضة: تردد أول")
تأكد_يساوي(ناتج2[2], [-1.0, 0.0], "نبضة: تردد ثان")

اطبع "أول معامل:", ناتج[0]
