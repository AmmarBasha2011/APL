# مثال 2688 — عدد الحرف i في النص
# Count letter i
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2688-count-letter-i-in-text-v2.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن.count("i")

تأكد_يساوي(ف("elephant"), 0, "حالة 1")
تأكد_يساوي(ف("aaa"), 0, "حالة 2")
تأكد_يساوي(ف("status quo"), 0, "حالة 3")
تأكد_يساوي(ف("mississippi"), 4, "حالة 4")
