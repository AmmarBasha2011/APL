# مثال 3093 — مساحة مستطيل مكبر 5 مرات
# Rectangle area scaled by 5
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3093-rectangle-area-scaled-by-5.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 5) * (ق[1] * 5)

تأكد_يساوي(ف([1, 2]), 50, "حالة 1")
تأكد_يساوي(ف([3, 4]), 300, "حالة 2")
تأكد_يساوي(ف([5, 5]), 625, "حالة 3")
تأكد_يساوي(ف([10, 1]), 250, "حالة 4")
