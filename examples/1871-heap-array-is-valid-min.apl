# مثال 1871 — هل المصفوفة كومة صغرى
# Check array is a min heap
# Demonstrates: هياكل بيانات
#
# Run:  python apl.py examples/1871-heap-array-is-valid-min.apl

# الابنان عند 2ك+1 و2ك+2
# نفحص كل أب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كومة_صغرى(ق):
  لكل ك في نطاق(طول(ق)):
    يسار = 2 * ك + 1
    يمين = 2 * ك + 2
    لو يسار < طول(ق) و ق[ك] > ق[يسار]:
      ارجع خطأ
    لو يمين < طول(ق) و ق[ك] > ق[يمين]:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(كومة_صغرى([1, 3, 2, 4, 5]), صواب, "صحيحة")
تأكد_يساوي(كومة_صغرى([3, 1, 2]), خطأ, "خاطئة")
تأكد_يساوي(كومة_صغرى([]), صواب, "فارغة")
