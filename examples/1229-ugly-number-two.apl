# مثال 1229 — عدد قبيح
# Nth ugly number
# Demonstrates: ثلاثة مؤشرات
#
# Run:  python apl.py examples/1229-ugly-number-two.apl

# الأعداد القبيحة عواملها 2 و3 و5 فقط
# ننتجها بالترتيب بثلاثة مؤشرات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قبيح(ن):
  أ = [1]
  ي2 = 0
  ي3 = 0
  ي5 = 0
  طالما طول(أ) < ن:
    ب2 = أ[ي2] * 2
    ب3 = أ[ي3] * 3
    ب5 = أ[ي5] * 5
    ت = أصغر(ب2, أصغر(ب3, ب5))
    أ.ألحق(ت)
    لو ت == ب2:
      ي2 = ي2 + 1
    لو ت == ب3:
      ي3 = ي3 + 1
    لو ت == ب5:
      ي5 = ي5 + 1
  ارجع أ[ن - 1]

تأكد_يساوي(قبيح(1), 1, "الأول")
تأكد_يساوي(قبيح(10), 12, "العاشر")
تأكد_يساوي(قبيح(15), 24, "الخامس عشر")
تأكد_يساوي(قبيح(100), 1536, "المئة")
