# مثال 377 — مجمع خيوط يدوي
# Manual thread pool
# Demonstrates: توزيع مهام على عمال ثابتين
#
# Run:  python apl.py examples/377-thread-pool-manual.apl

المتغير مهام = []
لكل ي في نطاق(8):
    مهام.أضف(ي)
المتغير قفل = أنشئ_قفل()
المتغير نتائج = []

دالة عامل():
    أبدا:
        قفل.acquire()
        لو طول(مهام) == 0:
            قفل.release()
            توقف
        المتغير م = مهام.pop(0)
        قفل.release()
        المتغير مربع = م * م
        قفل.acquire()
        نتائج.أضف(مربع)
        قفل.release()

المتغير خيوط = []
لكل _ في نطاق(3):
    المتغير ت = أنشئ_ثريد(target=عامل)
    خيوط.أضف(ت)
    ت.start()
لكل ت في خيوط:
    ت.join()

اطبع "المربعات:", مفرز(نتائج)
