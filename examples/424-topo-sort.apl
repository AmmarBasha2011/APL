# مثال 424 — الترتيب الطوبولوجي
# Topological sort
# Demonstrates: خوارزمية كان
#
# Run:  python apl.py examples/424-topo-sort.apl

المتغير جيران = {
    "ملابس داخلية": ["بنطلون"],
    "قميص": ["جاكيت"],
    "بنطلون": ["حذاء", "جاكيت"],
    "حذاء": [],
    "جاكيت": []
}

المتغير درجة = {}
لكل عقدة في جيران.keys():
    درجة[عقدة] = 0
لكل عقدة في جيران.keys():
    لكل جار in جيران[عقدة]:
        درجة[جار] = درجة[جار] + 1

المتغير جاهزة = []
لكل عقدة في جيران.keys():
    لو درجة[عقدة] == 0:
        جاهزة.append(عقدة)

المتغير ترتيب = []
طالما طول(جاهزة) > 0:
    المتغير عقدة = جاهزة.pop()
    ترتيب.append(عقدة)
    لكل جار in جيران[عقدة]:
        درجة[جار] = درجة[جار] - 1
        لو درجة[جار] == 0:
            جاهزة.append(جار)

اطبع "ترتيب اللبس:", ترتيب
