# مثال 276 — حاصل ضرب ما عدا الذات
# Product of array except self
# Demonstrates: جداول بادئة ولاحقة
#
# Run:  python apl.py examples/276-product-except-self.apl

دالة حاصل_عدا_الذات(قائمة):
    المتغير ن = طول(قائمة)
    المتغير نتيجة = [1 لكل _ في نطاق(ن)]
    المتغير بادئة = 1
    لكل ي في نطاق(ن):
        نتيجة[ي] = بادئة
        بادئة = بادئة * قائمة[ي]
    المتغير لاحقة = 1
    لكل ي في نطاق(ن):
        المتغير ز = ن - 1 - ي
        نتيجة[ز] = نتيجة[ز] * لاحقة
        لاحقة = لاحقة * قائمة[ز]
    ارجع نتيجة

اطبع حاصل_عدا_الذات([1, 2, 3, 4])
اطبع حاصل_عدا_الذات([2, 3, 4, 5])
