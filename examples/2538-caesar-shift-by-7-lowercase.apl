# مثال 2538 — قيصر بإزاحة 7
# Caesar shift 7
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2538-caesar-shift-by-7-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 7) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "hij", "حالة 1")
تأكد_يساوي(ف("xyz"), "efg", "حالة 2")
تأكد_يساوي(ف("hello world"), "olssv dvysk", "حالة 3")
تأكد_يساوي(ف("a1"), "h1", "حالة 4")
