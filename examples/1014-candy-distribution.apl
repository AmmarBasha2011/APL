# مثال 1014 — توزيع الحلوى
# Candy distribution
# Demonstrates: مرورتان
#
# Run:  python apl.py examples/1014-candy-distribution.apl

# لكل طفل تقييم ومن تقييمه أعلى من جاره يأخذ حلوى أكثر
# مرور من اليسار ثم من اليمين يحقق الشرطين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_حلوى(تقييم):
  ن = طول(تقييم)
  حلوى = [1] * ن
  لكل ع في نطاق(1, ن):
    لو تقييم[ع] > تقييم[ع - 1]:
      حلوى[ع] = حلوى[ع - 1] + 1
  لكل ع في نطاق(ن - 2, -1, -1):
    لو (تقييم[ع] > تقييم[ع + 1]) و (حلوى[ع] <= حلوى[ع + 1]):
      حلوى[ع] = حلوى[ع + 1] + 1
  مجموع = 0
  لكل ح في حلوى:
    مجموع = مجموع + ح
  ارجع مجموع

تأكد_يساوي(اقل_حلوى([1, 0, 2]), 5, "ثلاثة أطفال")
تأكد_يساوي(اقل_حلوى([1, 2, 2]), 4, "تساوٍ")
تأكد_يساوي(اقل_حلوى([1, 2, 3, 4]), 10, "تصاعد")
