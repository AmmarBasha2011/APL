# مثال 3442 — عدد ظهور الرقم 5 حتى ن
# Occurrences of digit 5 up to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3442-count-digit-5-occurrences-up-to-n-v5.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(1, ن + 1):
    ع = ع + نص(ي).count("5")
  ارجع ع

تأكد_يساوي(ف(9), 1, "حالة 1")
تأكد_يساوي(ف(10), 1, "حالة 2")
تأكد_يساوي(ف(50), 6, "حالة 3")
تأكد_يساوي(ف(100), 20, "حالة 4")
تأكد_يساوي(ف(200), 40, "حالة 5")
