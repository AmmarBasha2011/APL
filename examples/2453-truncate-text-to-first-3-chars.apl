# مثال 2453 — اقتطاع أول 3 أحرف
# First 3 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2453-truncate-text-to-first-3-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:3]

تأكد_يساوي(ف("hello world"), "hel", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abc", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
