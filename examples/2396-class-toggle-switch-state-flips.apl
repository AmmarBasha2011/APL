# مثال 2396 — صنف مفتاح تشغيل
# Toggle switch class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2396-class-toggle-switch-state-flips.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مفتاح:
    دالة_إنشاء(ذات):
        ذات.شغال = خطأ

    دالة بدل(ذات):
        لو ذات.شغال:
            ذات.شغال = خطأ
        والا:
            ذات.شغال = صواب

م = مفتاح()
تأكد_يساوي(م.شغال, خطأ, "البداية")
م.بدل()
تأكد_يساوي(م.شغال, صواب, "بعد مرة")
م.بدل()
تأكد_يساوي(م.شغال, خطأ, "بعد مرتين")
