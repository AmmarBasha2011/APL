# مثال 1332 — لعبة الحجارة
# Stone game optimal play
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1332-stone-game.apl

# كل لاعب يأخذ من أحد طرفي الصف
# نخزن أفضل فارق لكل مجال

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فارق_الأول(أكوام):
  ن = طول(أكوام)
  فارق = []
  لكل ع في نطاق(ن):
    فارق.ألحق([0] * ن)
  لكل ع في نطاق(ن):
    فارق[ع][ع] = أكوام[ع]
  لكل ط في نطاق(2, ن + 1):
    لكل ي في نطاق(0, ن - ط + 1):
      ك = ي + ط - 1
      فارق[ي][ك] = أكبر(أكوام[ي] - فارق[ي + 1][ك], أكوام[ك] - فارق[ي][ك - 1])
  ارجع فارق[0][ن - 1]

تأكد_يساوي(فارق_الأول([5,3,4,5]), 1, "فارق واحد")
تأكد_يساوي(فارق_الأول([3,7,2,3]), 5, "فارق خمسة")
تأكد_يساوي(فارق_الأول([4]), 4, "كومة")
