# مثال 42 — أشكال هندسية
# Geometry Shapes (inheritance)
# Demonstrates: classes, inheritance, method overriding, math library
#
# Run:  python apl.py examples/42-geometry-shapes.apl

صنف شكل:
    دالة_إنشاء(ذات, اسم):
        ذات.اسم = اسم

    دالة مساحة(ذات):
        ارجع 0

    دالة محيط(ذات):
        ارجع 0

    دالة وصف(ذات):
        ارجع ذات.اسم + ": مساحة=" + نص(مقرب(ذات.مساحة(), 2)) + " محيط=" + نص(مقرب(ذات.محيط(), 2))

صنف مستطيل(شكل):
    دالة_إنشاء(ذات, طول, عرض):
        استدعاء_الأب(شكل, ذات, "مستطيل")
        ذات.طول = طول
        ذات.عرض = عرض

    دالة مساحة(ذات):
        ارجع ذات.طول * ذات.عرض

    دالة محيط(ذات):
        ارجع 2 * (ذات.طول + ذات.عرض)

صنف دائرة(شكل):
    دالة_إنشاء(ذات, نصف_قطر):
        استدعاء_الأب(شكل, ذات, "دائرة")
        ذات.نصف_قطر = نصف_قطر

    دالة مساحة(ذات):
        ارجع طا * ذات.نصف_قطر ** 2

    دالة محيط(ذات):
        ارجع 2 * طا * ذات.نصف_قطر

صنف مثلث(شكل):
    دالة_إنشاء(ذات, أ, ب, ج):
        استدعاء_الأب(شكل, ذات, "مثلث")
        ذات.أ = أ
        ذات.ب = ب
        ذات.ج = ج

    دالة مساحة(ذات):
        ارجع (ذات.أ + ذات.ب + ذات.ج) / 2

    دالة محيط(ذات):
        ارجع ذات.أ + ذات.ب + ذات.ج

اطبع "=== أشكال هندسية ==="
اطبع ""
المتغير الأشكال = [مستطيل(4, 5), دائرة(3), مثلث(3, 4, 5)]
لكل عنصر في الأشكال:
    اطبع "  " + عنصر.وصف()
