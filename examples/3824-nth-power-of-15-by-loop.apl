# مثال 3824 — قوة 15 بالحلقة
# Power of 15 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3824-nth-power-of-15-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 15
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 15, "حالة 2")
تأكد_يساوي(ف(3), 3375, "حالة 3")
تأكد_يساوي(ف(6), 11390625, "حالة 4")
تأكد_يساوي(ف(10), 576650390625, "حالة 5")
