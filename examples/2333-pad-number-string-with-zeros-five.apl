# مثال 2333 — ملء الأصفار لخمس خانات
# Zero pad to five
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2333-pad-number-string-with-zeros-five.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن.zfill(5)

تأكد_يساوي(ف("7"), "00007", "حالة 1")
تأكد_يساوي(ف("123"), "00123", "حالة 2")
تأكد_يساوي(ف("12345"), "12345", "حالة 3")
تأكد_يساوي(ف("42"), "00042", "حالة 4")
