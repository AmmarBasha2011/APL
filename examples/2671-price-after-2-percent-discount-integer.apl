# مثال 2671 — السعر بعد خصم 2 بالمئة
# Price after 2 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2671-price-after-2-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 2 // 100

تأكد_يساوي(ف(100), 98, "حالة 1")
تأكد_يساوي(ف(250), 245, "حالة 2")
تأكد_يساوي(ف(999), 980, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
