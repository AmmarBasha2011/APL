# مثال 2 — تقرير مبيعات وتقدير الإجمالي
# Sales Report & Total Estimate
# Demonstrates: lists, for-loop, accumulate, f-strings, math library
#
# Run:  python apl.py examples/02-sales-report.apl

بذرة(11)

المتغير المنتجات = ["قلم", "دفتر", "مسطرة", "ممحاة", "حقيبة"]
المتغير الأسعار = [15, 40, 25, 10, 120]
المتغير الخصم = عشوائي_عدد(5, 20)

اطبع "=== تقرير المبيعات ==="
اطبع "عدد المنتجات: " + نص(طول(المنتجات))
اطبع "نسبة الخصم: " + نص(الخصم) + "%"
اطبع ""

المتغير الإجمالي = 0
لكل رقم في نطاق(طول(المنتجات)):
    السعر = الأسعار[رقم]
    الكمية = عشوائي_عدد(1, 5)
    الفرعي = السعر * الكمية
    الإجمالي = الإجمالي + الفرعي
    اطبع f"{المنتجات[رقم]}: {السعر} x {الكمية} = {الفرعي}"

اطبع ""
اطبع "الإجمالي قبل الخصم: " + نص(الإجمالي)
المتغير بعد_الخصم = الإجمالي * (100 - الخصم) / 100
اطبع f"الإجمالي بعد خصم {الخصم}%: {بعد_الخصم:.2f}"
اطبع "متوسط الفاتورة: " + نص(مقرب(بعد_الخصم / طول(المنتجات), 2))
