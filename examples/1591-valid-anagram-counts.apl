# مثال 1591 — هل الكلمتان تبديل
# Valid anagram by counts
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1591-valid-anagram-counts.apl

# نعد حروف الأولى
# ننقص بحروف الثانية وننظر إن بقي شيء

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تبديل(أ, ب):
  لو طول(أ) != طول(ب):
    ارجع خطأ
  عد = {}
  لكل ح في أ:
    عد[ح] = عد.get(ح, 0) + 1
  لكل ح في ب:
    عد[ح] = عد.get(ح, 0) - 1
    لو عد[ح] < 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(تبديل("listen", "silent"), صواب, "تبديل")
تأكد_يساوي(تبديل("rat", "car"), خطأ, "ليس تبديلاً")
تأكد_يساوي(تبديل("aab", "abb"), خطأ, "تكرار مختلف")
