# مثال 564 — تحقق IBAN
# IBAN validation
# Demonstrates: IBAN، mod 97، رقم تحقق
#
# Run:  python apl.py examples/564-iban-check.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تحقق IBAN بمعيار mod-97 وتوليد رقم تحقق سليم
دالة رقم_تحويل(iban):
    المتغير م = ""
    لكل حرف في iban:
        لو حرف >= "0" و حرف <= "9":
            م = م + حرف
        الا:
            م = م + نص(ترميز_حرف(حرف) - 55)
    ارجع م

دالة باقي97(iban):
    المتغير ب = 0
    لكل حرف في رقم_تحويل(iban):
        ب = (ب * 10 + صحيح(حرف)) % 97
    ارجع ب

دالة iban_صالح(iban):
    لو طول(iban) != 29:
        ارجع خطأ
    ارجع باقي97(iban[4:] + iban[:4]) == 1

المتغير جسم = "0001900500000000263180002"
المتغير سليم = ""
لكل تحقق في نطاق(2, 99):
    المتغير رقم = نص(تحقق)
    لو تحقق < 10:
        رقم = "0" + رقم
    المتغير مرشح = "EG" + رقم + جسم
    لو iban_صالح(مرشح):
        سليم = مرشح
اطبع "IBAN سليم:", سليم
تأكد_يساوي(iban_صالح(سليم), صواب, "المولد يمر")
تأكد_يساوي(iban_صالح(سليم[:6] + "9" + سليم[7:]), خطأ, "المعدل يفشل")
تأكد_يساوي(iban_صالح("EG38"), خطأ, "القصير يرفض")
