# مثال 3910 — مجموع قوى 50
# Sum of powers of 50
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3910-sum-of-powers-of-50-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 50 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 51, "حالة 2")
تأكد_يساوي(ف(3), 127551, "حالة 3")
تأكد_يساوي(ف(6), 15943877551, "حالة 4")
تأكد_يساوي(ف(10), 99649234693877551, "حالة 5")
