# مثال 2964 — مجموع المربعات من 5 إلى ن
# Sum of squares from 5
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2964-sum-of-squares-from-5-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(5, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(5), 25, "حالة 1")
تأكد_يساوي(ف(6), 61, "حالة 2")
تأكد_يساوي(ف(15), 1210, "حالة 3")
تأكد_يساوي(ف(100), 338320, "حالة 4")
