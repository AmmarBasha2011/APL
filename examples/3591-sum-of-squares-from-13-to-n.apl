# مثال 3591 — مجموع المربعات من 13 إلى ن
# Sum of squares from 13
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3591-sum-of-squares-from-13-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(13, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(13), 169, "حالة 1")
تأكد_يساوي(ف(14), 365, "حالة 2")
تأكد_يساوي(ف(23), 3674, "حالة 3")
تأكد_يساوي(ف(100), 337700, "حالة 4")
