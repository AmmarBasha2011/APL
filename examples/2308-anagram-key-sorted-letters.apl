# مثال 2308 — مفتاح الجناس
# Anagram key
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2308-anagram-key-sorted-letters.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("listen"), "eilnst", "حالة 1")
تأكد_يساوي(ف("silent"), "eilnst", "حالة 2")
تأكد_يساوي(ف("abc"), "abc", "حالة 3")
تأكد_يساوي(ف("zyx"), "xyz", "حالة 4")
