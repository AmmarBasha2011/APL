# مثال 620 — قائمة القفز
# Skip list
# Demonstrates: قائمة قفز، مستويات، بحث
#
# Run:  python apl.py examples/620-skip-list.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# قائمة القفز: بحث سريع في قائمة مرتبة بمستويات
# Demonstrates: مستويات احتمالية مثبتة البذرة, روابط أمامية, بحث بالقفز
# بديل عملي عن الأشجار المتزنة

دالة عشوائي_مثبت(بذرة):
  ارجع (بذرة * 1103515245 + 12345) % 2147483648

دالة مستوى_عقدة(قيمة):
  بذرة = عشوائي_مثبت(قيمة * 7919)
  مستوى = 1
  طالما بذرة % 2 == 0 و مستوى < 4:
    مستوى = مستوى + 1
    بذرة = بذرة // 2
  ارجع مستوى

دالة أنشئ_قائمة():
  ارجع {"رأس": {"قيمة": -1, "أمام": [لا_شيء, لا_شيء, لا_شيء, لا_شيء]}}

دالة ابحث(قائمة, قيمة):
  عقدة = قائمة["رأس"]
  لكل مستوى في نطاق(3, -1, -1):
    طالما عقدة["أمام"][مستوى] != لا_شيء و عقدة["أمام"][مستوى]["قيمة"] < قيمة:
      عقدة = عقدة["أمام"][مستوى]
  عقدة = عقدة["أمام"][0]
  لو عقدة != لا_شيء و عقدة["قيمة"] == قيمة:
    ارجع صواب
  ارجع خطأ

دالة أدرج(قائمة, قيمة):
  تحديث = [قائمة["رأس"], قائمة["رأس"], قائمة["رأس"], قائمة["رأس"]]
  عقدة = قائمة["رأس"]
  لكل مستوى في نطاق(3, -1, -1):
    طالما عقدة["أمام"][مستوى] != لا_شيء و عقدة["أمام"][مستوى]["قيمة"] < قيمة:
      عقدة = عقدة["أمام"][مستوى]
    تحديث[مستوى] = عقدة
  مستويات = مستوى_عقدة(قيمة)
  أمام = [لا_شيء, لا_شيء, لا_شيء, لا_شيء]
  لكل مستوى في نطاق(مستويات):
    أمام[مستوى] = تحديث[مستوى]["أمام"][مستوى]
    تحديث[مستوى]["أمام"][مستوى] = {"قيمة": قيمة, "أمام": أمام}

قائمة = أنشئ_قائمة()
لكل قيمة في [3, 6, 7, 9, 12, 19, 17, 26, 21, 25]:
  أدرج(قائمة, قيمة)
تأكد_يساوي(ابحث(قائمة, 19), صواب, "موجود")
تأكد_يساوي(ابحث(قائمة, 20), خطأ, "غير موجود")
تأكد_يساوي(ابحث(قائمة, 3), صواب, "الأول")
تأكد_يساوي(ابحث(قائمة, 25), صواب, "الأخير")
مستويات = []
لكل ق في [3, 6, 7]:
  مستويات.append(مستوى_عقدة(ق))
اطبع "مستويات العقد:", مستويات
