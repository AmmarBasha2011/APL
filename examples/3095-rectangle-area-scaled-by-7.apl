# مثال 3095 — مساحة مستطيل مكبر 7 مرات
# Rectangle area scaled by 7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3095-rectangle-area-scaled-by-7.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 7) * (ق[1] * 7)

تأكد_يساوي(ف([1, 2]), 98, "حالة 1")
تأكد_يساوي(ف([3, 4]), 588, "حالة 2")
تأكد_يساوي(ف([5, 5]), 1225, "حالة 3")
تأكد_يساوي(ف([10, 1]), 490, "حالة 4")
