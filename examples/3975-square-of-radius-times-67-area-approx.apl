# مثال 3975 — مساحة دائرة بتقريب 67
# Circle area with pi approx 67/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3975-square-of-radius-times-67-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 67 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 9, "حالة 2")
تأكد_يساوي(ف(7), 469, "حالة 3")
تأكد_يساوي(ف(14), 1876, "حالة 4")
تأكد_يساوي(ف(21), 4221, "حالة 5")
