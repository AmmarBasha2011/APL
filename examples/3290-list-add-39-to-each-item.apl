# مثال 3290 — إضافة 39 لكل عنصر
# Add 39 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3290-list-add-39-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 39]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [42, 40, 41], "حالة 1")
تأكد_يساوي(ف([5]), [44], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [40, 41, 42, 43, 44, 45], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [37, 39, 46, 46, 43], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [49, 59, 49, 69, 59, 49], "حالة 5")
