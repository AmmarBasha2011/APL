# مثال 73 — ملف الروبوتات وصناديق البريد (مكتبة web)
# robots.txt parsing and mailbox folders (urllib.robotparser / mailbox)
#
# Run:  python apl.py examples/73-web-robots-maildir.apl

اطبع "=== تحليل robots.txt ==="
المتغير محلل = محلل_ملف_الروبوتات()
المتغير قواعد = ["User-agent: *", "Disallow: /private", "Allow: /public"]
محلل.روبوت_ملف_محلل_حلل(قواعد)

اطبع "يستطيع الزحف /public:", محلل.يستطيع_اجلب("متصفحي", "https://example.com/public")
اطبع "يستطيع الزحف /private:", محلل.يستطيع_اجلب("متصفحي", "https://example.com/private")

اطبع ""
اطبع "=== صندوق مجلد (Maildir) ==="
المتغير مسار = "/tmp/apl-web-maildir"
المتغير صندوق = صندوق_مجلد(مسار)

المتغير رسالة = نص_بريد_2("رسالة في صندوق مجلد", "utf-8")
صندوق.بريد_مجلد_أضف(رسالة)
اطبع "عدد الرسائل:", طول(صندوق)

المتغير مفاتيح = صندوق.بريد_مجلد_مفاتيح()
لكل مفتاح في مفاتيح:
    المتغير ر = صندوق.بريد_مجلد_احصل_رسالة(مفتاح)
    اطبع "مفتاح:", مفتاح

صندوق.بريد_مجلد_أغلق()
