# مثال 909 — مسألة العلم الهولندي
# Dutch national flag
# Demonstrates: ثلاثة مؤشرات بتمريرة واحدة
#
# Run:  python apl.py examples/909-dutch-national-flag.apl

# مسألة العلم الهولندي: فرز ثلاث قيم بتمريرة واحدة
# ثلاثة مؤشرات: أدنى، وسط، أعلى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة علم_هولندي(قيم):
  م = []
  لكل x في قيم:
    م.ألحق(x)
  أدنى = 0
  وسط = 0
  أعلى = طول(م) - 1
  طالما وسط <= أعلى:
    لو م[وسط] == 0:
      مؤقت = م[أدنى]
      م[أدنى] = م[وسط]
      م[وسط] = مؤقت
      أدنى = أدنى + 1
      وسط = وسط + 1
    والا_لو م[وسط] == 1:
      وسط = وسط + 1
    والا:
      مؤقت = م[وسط]
      م[وسط] = م[أعلى]
      م[أعلى] = مؤقت
      أعلى = أعلى - 1
  ارجع م

نتيجة = علم_هولندي([2, 0, 2, 1, 1, 0])
اطبع "النتيجة:", نتيجة

تأكد_يساوي(طول(نتيجة), 6, "الطول")
تأكد_يساوي(نتيجة[0], 0, "صفر أولاً")
تأكد_يساوي(نتيجة[1], 0, "صفر ثانياً")
تأكد_يساوي(نتيجة[2], 1, "واحد")
تأكد_يساوي(نتيجة[5], 2, "اثنان أخيراً")

# حالات حدية
تأكد_يساوي(طول(علم_هولندي([])), 0, "فارغة")
تأكد_يساوي(علم_هولندي([1])[0], 1, "عنصر واحد")
مرتبة = علم_هولندي([2, 2, 2])
تأكد_يساوي(مرتبة[0], 2, "كلها متساوية")
تأكد_يساوي(طول(مرتبة), 3, "طول المتساوية")
