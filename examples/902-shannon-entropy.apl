# مثال 902 — إنتروبيا شانون
# Shannon entropy
# Demonstrates: تكرارات ولوغاريتم
#
# Run:  python apl.py examples/902-shannon-entropy.apl

# إنتروبيا شانون: متوسط المعلومة لكل رمز بالبت
# H = -مجموع p(x) * log2 p(x)

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة لوغ2(س):
  ارجع لوغاريتم(س) / لوغاريتم(2)

دالة إنتروبيا(سلسلة):
  ن = طول(سلسلة)
  # تكرارات كل حرف
  حروف = []
  تكرار = []
  لكل i في نطاق(ن):
    حرف = سلسلة[i]
    وجد = -1
    لكل ج في نطاق(طول(حروف)):
      لو حروف[ج] == حرف:
        وجد = ج
    لو وجد >= 0:
      تكرار[وجد] = تكرار[وجد] + 1
    والا:
      حروف.ألحق(حرف)
      تكرار.ألحق(1)
  اتش = 0
  لكل ج في نطاق(طول(حروف)):
    احتمال = تكرار[ج] / ن
    اتش = اتش - احتمال * لوغ2(احتمال)
  ارجع اتش

ه1 = إنتروبيا("aabbccab")
اطبع "H(aabbccab) =", ه1

# 3a,3b,2c من 8 -> تقريباً 1.5613 بت
تأكد_يساوي(مقرب(ه1, 4), 1.5613, "إنتروبيا aabbccab")

# رمز واحد: صفر إنتروبيا
تأكد_يساوي(إنتروبيا("aaaa"), 0, "رمز واحد")

# رمزان متساويان: بت واحد بالضبط
تأكد_يساوي(مقرب(إنتروبيا("abab"), 6), 1, "رمزان متساويان")
