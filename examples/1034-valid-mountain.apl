# مثال 1034 — مصفوفة جبل
# Valid mountain array
# Demonstrates: صعود ثم هبوط
#
# Run:  python apl.py examples/1034-valid-mountain.apl

# الجبل يصعد بدقة إلى قمة ثم يهبط بدقة
# والقمة ليست في الطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جبل(ق):
  ن = طول(ق)
  ع = 0
  طالما ((ع + 1) < ن) و (ق[ع] < ق[ع + 1]):
    ع = ع + 1
  لو (ع == 0) أو (ع == (ن - 1)):
    ارجع خطأ
  طالما ((ع + 1) < ن) و (ق[ع] > ق[ع + 1]):
    ع = ع + 1
  ارجع ع == (ن - 1)

تأكد_يساوي(جبل([0, 3, 2, 1]), صواب, "جبل")
تأكد_يساوي(جبل([2, 1]), خطأ, "قصيرة")
تأكد_يساوي(جبل([3, 5, 5]), خطأ, "هضبة")
تأكد_يساوي(جبل([0, 2, 3, 3, 5, 2, 1, 0]), خطأ, "قمتان")
