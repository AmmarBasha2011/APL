# مثال 4383 — مجموع زوايا مضلع زائد 33
# Polygon angle sum plus 33
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4383-interior-angle-sum-of-polygon-plus-33.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 33

تأكد_يساوي(ف(3), 213, "حالة 1")
تأكد_يساوي(ف(4), 393, "حالة 2")
تأكد_يساوي(ف(5), 573, "حالة 3")
تأكد_يساوي(ف(6), 753, "حالة 4")
تأكد_يساوي(ف(12), 1833, "حالة 5")
