# مثال 1836 — أقل سرعة أكل
# Minimum eating speed
# Demonstrates: بحث
#
# Run:  python apl.py examples/1836-koko-eating-bananas-speed.apl

# نختبر سرعة ممكنة
# نقلص المدى بحسب الساعات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ساعات(أكوام, سرعة):
  مجموع = 0
  لكل ع في أكوام:
    مجموع = مجموع + (ع + سرعة - 1) // سرعة
  ارجع مجموع

دالة أقل_سرعة(أكوام, حد):
  يسار = 1
  يمين = 1
  لكل ع في أكوام:
    يمين = أكبر(يمين, ع)
  طالما يسار < يمين:
    وسط = (يسار + يمين) // 2
    لو ساعات(أكوام, وسط) <= حد:
      يمين = وسط
    والا:
      يسار = وسط + 1
  ارجع يسار

تأكد_يساوي(أقل_سرعة([3, 6, 7, 11], 8), 4, "أربعة")
تأكد_يساوي(أقل_سرعة([30, 11, 23, 4, 20], 5), 30, "ثلاثون")
تأكد_يساوي(أقل_سرعة([30, 11, 23, 4, 20], 6), 23, "ثلاث وعشرون")
