# مثال 3790 — صف جدول ضرب 25
# Multiplication row of 25
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3790-multiplication-table-row-of-25.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 25]
  ارجع ر

تأكد_يساوي(ف(1), [25], "حالة 1")
تأكد_يساوي(ف(5), [25, 50, 75, 100, 125], "حالة 2")
تأكد_يساوي(ف(10), [25, 50, 75, 100, 125, 150, 175, 200, 225, 250], "حالة 3")
