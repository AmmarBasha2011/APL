# مثال 3389 — تحويل وحدة بأساس 23
# Split by base 23
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3389-minutes-to-hours-and-minutes-base-23.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 23, ن % 23]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 13], "حالة 2")
تأكد_يساوي(ف(60), [2, 14], "حالة 3")
تأكد_يساوي(ف(125), [5, 10], "حالة 4")
تأكد_يساوي(ف(1000), [43, 11], "حالة 5")
