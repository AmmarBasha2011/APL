# مثال 4067 — إضافة 57 لكل عنصر
# Add 57 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4067-list-add-57-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 57]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [60, 58, 59], "حالة 1")
تأكد_يساوي(ف([5]), [62], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [58, 59, 60, 61, 62, 63], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [55, 57, 64, 64, 61], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [67, 77, 67, 87, 77, 67], "حالة 5")
