# مثال 4356 — السعر مع ضريبة 46 بالمئة
# Price with 46 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4356-price-with-46-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 46 // 100

تأكد_يساوي(ف(100), 146, "حالة 1")
تأكد_يساوي(ف(250), 365, "حالة 2")
تأكد_يساوي(ف(999), 1458, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
