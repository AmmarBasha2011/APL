# مثال 3462 — ضرب كل عنصر في 43
# Multiply each item by 43
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3462-list-multiply-each-by-43.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 43]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [129, 43, 86], "حالة 1")
تأكد_يساوي(ف([5]), [215], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [43, 86, 129, 172, 215, 258], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-86, 0, 301, 301, 172], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [430, 860, 430, 1290, 860, 430], "حالة 5")
