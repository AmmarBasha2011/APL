# مثال 2812 — السعر مع ضريبة 8 بالمئة
# Price with 8 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2812-price-with-8-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 8 // 100

تأكد_يساوي(ف(100), 108, "حالة 1")
تأكد_يساوي(ف(250), 270, "حالة 2")
تأكد_يساوي(ف(999), 1078, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
