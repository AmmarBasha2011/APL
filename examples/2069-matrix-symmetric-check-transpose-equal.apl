# مثال 2069 — هل المصفوفة متناظرة
# Symmetric matrix check
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2069-matrix-symmetric-check-transpose-equal.apl

# # نقارن كل عنصر بنظيره
# # المصفوفة المستطيلة ليست متناظرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متناظرة(م):
  لكل ي في نطاق(طول(م)):
    لو طول(م[ي]) != طول(م):
      ارجع خطأ
    لكل ك في نطاق(طول(م)):
      لو م[ي][ك] != م[ك][ي]:
        ارجع خطأ
  ارجع صواب

تأكد_يساوي(متناظرة([[1, 2], [2, 1]]), صواب, "متناظرة")
تأكد_يساوي(متناظرة([[1, 2], [3, 1]]), خطأ, "غير متناظرة")
تأكد_يساوي(متناظرة([[1, 2, 3], [4, 5, 6]]), خطأ, "مستطيلة")
