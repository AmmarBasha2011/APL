# مثال 2979 — ضرب كل عنصر في 29
# Multiply each item by 29
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2979-list-multiply-each-by-29.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 29]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [87, 29, 58], "حالة 1")
تأكد_يساوي(ف([5]), [145], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [29, 58, 87, 116, 145, 174], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-58, 0, 203, 203, 116], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [290, 580, 290, 870, 580, 290], "حالة 5")
