# مثال 2226 — هل القائمة مرتبة تصاعديا
# Is list sorted ascending
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2226-list-is-sorted-ascending-check.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لكل ي في نطاق(طول(ق) - 1):
    لو ق[ي] > ق[ي + 1]:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف([3, 1, 2]), خطأ, "حالة 1")
تأكد_يساوي(ف([5]), صواب, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), صواب, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), خطأ, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), خطأ, "حالة 5")
تأكد_يساوي(ف([1, 1, 2]), صواب, "حالة 6")
