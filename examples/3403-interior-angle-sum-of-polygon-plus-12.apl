# مثال 3403 — مجموع زوايا مضلع زائد 12
# Polygon angle sum plus 12
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3403-interior-angle-sum-of-polygon-plus-12.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 12

تأكد_يساوي(ف(3), 192, "حالة 1")
تأكد_يساوي(ف(4), 372, "حالة 2")
تأكد_يساوي(ف(5), 552, "حالة 3")
تأكد_يساوي(ف(6), 732, "حالة 4")
تأكد_يساوي(ف(12), 1812, "حالة 5")
