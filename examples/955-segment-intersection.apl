# مثال 955 — تقاطع القطع المستقيمة
# Segment intersection
# Demonstrates: توجهات نسبية أربع
#
# Run:  python apl.py examples/955-segment-intersection.apl

# تقاطع القطع المستقيمة: فحص التوجهات النسبية للنقط الأربع
# تتقاطع إن تفرقت النهايات حول القطعة الأخرى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة توجه(أ, ب, ج):
  # إشارة الجداء التبادلي: موجب يمين وسالب يسار وصفر استقامة
  ارجع (ب[0] - أ[0]) * (ج[1] - أ[1]) - (ب[1] - أ[1]) * (ج[0] - أ[0])

دالة تتقاطع(ن1, ن2, ن3, ن4):
  ع1 = توجه(ن3, ن4, ن1)
  ع2 = توجه(ن3, ن4, ن2)
  ع3 = توجه(ن1, ن2, ن3)
  ع4 = توجه(ن1, ن2, ن4)
  لو (ع1 > 0 و ع2 < 0) أو (ع1 < 0 و ع2 > 0):
    لو (ع3 > 0 و ع4 < 0) أو (ع3 < 0 و ع4 > 0):
      ارجع 1 == 1
  ارجع خطأ

اطبع "متقاطعتان:", تتقاطع([0, 0], [4, 4], [0, 4], [4, 0])
اطبع "متوازيتان:", تتقاطع([0, 0], [1, 1], [2, 2], [3, 3])

تأكد_يساوي(تتقاطع([0, 0], [4, 4], [0, 4], [4, 0]), 1 == 1, "تقاطع X")
تأكد_يساوي(تتقاطع([0, 0], [1, 1], [2, 2], [3, 3]), خطأ, "مستقيمتان متوازيتان")
تأكد_يساوي(تتقاطع([0, 0], [2, 0], [1, -1], [1, 1]), 1 == 1, "تقاطع T")
تأكد_يساوي(تتقاطع([0, 0], [1, 0], [2, 1], [3, 1]), خطأ, "منفصلتان")
# إشارة التوجه
لو توجه([0, 0], [1, 0], [1, 1]) <= 0:
  اطبع "فشل: إشارة التوجه"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: إشارة التوجه"
