# مثال 235 — نمط البنّاء
# Builder pattern
# Demonstrates: بناء كائن خطوة بخطوة
#
# Run:  python apl.py examples/235-builder.apl

صنف بناي_بيتزا:
    دالة_إنشاء(ذات):
        ذات.مكونات = []
        ذات.مقاس = "وسط"

    دالة بمقاس(ذات, مقاس):
        ذات.مقاس = مقاس
        ارجع ذات

    دالة أضف_مكون(ذات, مكون):
        ذات.مكونات.append(مكون)
        ارجع ذات

    دالة ابن(ذات):
        ارجع "بيتزا " + ذات.مقاس + " بـ" + " و".ضم(ذات.مكونات)

المتغير بيتزا = بناي_بيتزا().بمقاس("كبير").أضف_مكون("جبنة").أضف_مكون("فطر").أضف_مكون("زيتون").ابن()
اطبع بيتزا
