# 85 · العمليات المتعددة — multiprocessing وconcurrent.futures
# CPU count, running children, and thread pools
#
# Run:  python apl.py examples/85-syslib-processes.apl

دالة مربع(س):
	ارجع س * س

اطبع "=== العمليات المتعددة ==="
اطبع "المعالجات:", معالج_عدّ()
اطبع "الأبناء النشطون:", طول(الأبناء_النشطون())
المتغير من = منفّذ_خيوط(2)
المتغير م1 = من.منفّذ_أرسل(مربع, 3)
المتغير م2 = من.منفّذ_أرسل(مربع, 7)
اطبع "النتائج:", م1.مستقبل_نتيجة(), م2.مستقبل_نتيجة()
من.منفّذ_أوقف()
