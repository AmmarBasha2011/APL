# مثال 3713 — مجموع قوى 48
# Sum of powers of 48
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3713-sum-of-powers-of-48-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 48 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 49, "حالة 2")
تأكد_يساوي(ف(3), 112945, "حالة 3")
تأكد_يساوي(ف(6), 12490815793, "حالة 4")
تأكد_يساوي(ف(10), 66306446408726833, "حالة 5")
