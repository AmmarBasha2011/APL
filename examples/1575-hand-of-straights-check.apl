# مثال 1575 — هل تقسم الأوراق إلى متتاليات
# Hand of straights check
# Demonstrates: جشع
#
# Run:  python apl.py examples/1575-hand-of-straights-check.apl

# نبدأ من أصغر رقم متبق
# نخصم متتالية كاملة منه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تقسيم_ممكن(أوراق, حجم):
  لو طول(أوراق) % حجم != 0:
    ارجع خطأ
  عد = {}
  لكل و في أوراق:
    عد[و] = عد.get(و, 0) + 1
  مفاتيح = []
  لكل ك في عد:
    مفاتيح.append(ك)
  مفاتيح.sort()
  لكل ك في مفاتيح:
    لو عد[ك] > 0:
      كمية = عد[ك]
      لكل ز في نطاق(حجم):
        لو عد.get(ك + ز, 0) < كمية:
          ارجع خطأ
        عد[ك + ز] = عد[ك + ز] - كمية
  ارجع صواب

تأكد_يساوي(تقسيم_ممكن([1, 2, 3, 6, 2, 3, 4, 7, 8], 3), صواب, "ممكن")
تأكد_يساوي(تقسيم_ممكن([1, 2, 3, 4, 5], 4), خطأ, "العدد لا يقبل")
تأكد_يساوي(تقسيم_ممكن([1, 2, 4, 5], 2), صواب, "زوجان")
