# مثال 711 — وزن TF-IDF
# TF-IDF weighting
# Demonstrates: تكرار نسبي، تردد عكسي، ترتيب
#
# Run:  python apl.py examples/711-tf-idf-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# وزن TF-IDF لكلمات مستندات صغيرة
# Demonstrates: تكرار نسبي, تردد مستندي عكسي, ترتيب كلمات
# الكلمة النادرة في مجموعة تتفوق على الشائعة

دالة عد_في(كلمة, مستند):
  عدد = 0
  لكل ك في مستند:
    لو ك == كلمة:
      عدد = عدد + 1
  ارجع عدد

دالة تردد_مستندي(كلمة, مستندات):
  عدد = 0
  لكل م في مستندات:
    لو كلمة في م:
      عدد = عدد + 1
  ارجع عدد

دالة وزن(كلمة, مستند, مستندات):
  تف = عد_في(كلمة, مستند) / طول(مستند)
  دف = تردد_مستندي(كلمة, مستندات)
  ارجع تف * لوغاريتم(طول(مستندات) / دف)

دالة أفضل(مستند, مستندات):
  أعلى = ""
  قيمة = -1.0
  لكل ك في مستند:
    و_ق = وزن(ك, مستند, مستندات)
    لو و_ق > قيمة:
      قيمة = و_ق
      أعلى = ك
  ارجع [أعلى, قيمة]

مستندات = [
  "القط يلعب في الحديقة".split(" "),
  "الكلب ينبح في الشارع".split(" "),
  "القط والكلب أصدقاء".split(" ")
]
تأكد_يساوي(تردد_مستندي("القط", مستندات), 2, "القط في مستندين")
تأكد_يساوي(تردد_مستندي("الحديقة", مستندات), 1, "الحديقة في واحد")
و_حديقة = وزن("الحديقة", مستندات[0], مستندات)
و_قط = وزن("القط", مستندات[0], مستندات)
تأكد_يساوي(و_حديقة > و_قط, صواب, "النادرة تتفوق")
تأكد_يساوي(مقرب(و_قط, 4), مقرب(لوغاريتم(3.0 / 2.0) / 4.0, 4), "وزن القط")
ت = أفضل(مستندات[0], مستندات)
تأكد_يساوي(ت[0] في ["يلعب", "الحديقة"], صواب, "الأفضل نادرة")
تأكد_يساوي(وزن("أصدقاء", مستندات[2], مستندات) > 0, صواب, "كلمة فريدة موجبة")
اطبع "أفضل كلمة:", ت
