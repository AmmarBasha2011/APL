# مثال 2808 — السعر بعد خصم 9 بالمئة
# Price after 9 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2808-price-after-9-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 9 // 100

تأكد_يساوي(ف(100), 91, "حالة 1")
تأكد_يساوي(ف(250), 228, "حالة 2")
تأكد_يساوي(ف(999), 910, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
