# مثال 2335 — مجموع مربعات الفردية
# Sum of odd squares
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2335-list-sum-of-squares-of-odd-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل ع في ق:
    لو ع % 2 != 0:
      م = م + ع * ع
  ارجع م

تأكد_يساوي(ف([1, 2, 3]), 10, "حالة 1")
تأكد_يساوي(ف([2, 4]), 0, "حالة 2")
تأكد_يساوي(ف([5]), 25, "حالة 3")
تأكد_يساوي(ف([-3, 3, 4]), 18, "حالة 4")
