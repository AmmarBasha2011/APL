# مثال 3185 — مجموع قوى 33
# Sum of powers of 33
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3185-sum-of-powers-of-33-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 33 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 34, "حالة 2")
تأكد_يساوي(ف(3), 37060, "حالة 3")
تأكد_يساوي(ف(6), 1331826343, "حالة 4")
تأكد_يساوي(ف(10), 1579440828553963, "حالة 5")
