# مثال 1847 — حذف عنصر والاحتفاظ بالعدد
# Remove element and return new length
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1847-remove-element-in-place-count.apl

# مؤشر كتابة ومؤشر قراءة
# نعيد الطول الجديد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة احذف(ق, قيمة):
  كتابة = 0
  لكل قراءة في نطاق(طول(ق)):
    لو ق[قراءة] != قيمة:
      ق[كتابة] = ق[قراءة]
      كتابة = كتابة + 1
  ارجع كتابة

أ = [3, 2, 2, 3]
ن = احذف(أ, 3)
تأكد_يساوي(ن, 2, "الطول")
تأكد_يساوي(أ[:ن], [2, 2], "المحتوى")
ب = [0, 1, 2, 2, 3, 0, 4, 2]
تأكد_يساوي(احذف(ب, 2), 5, "ثمانية")
