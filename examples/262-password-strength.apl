# مثال 262 — قياس قوة كلمة المرور
# Password strength checker
# Demonstrates: فحص شروط متعددة
#
# Run:  python apl.py examples/262-password-strength.apl

دالة قوة(كلمة):
    المتغير نقاط = 0
    لو طول(كلمة) >= 8:
        نقاط = نقاط + 1
    لو طول(كلمة) >= 12:
        نقاط = نقاط + 1
    المتغير فيها_رقم = خطأ
    المتغير فيها_كبير = خطأ
    المتغير فيها_رمز = خطأ
    لكل حرف في كلمة:
        لو حرف >= "0" و حرف <= "9":
            فيها_رقم = صواب
        لو حرف >= "A" و حرف <= "Z":
            فيها_كبير = صواب
        لو حرف في "!@#$%":
            فيها_رمز = صواب
    لو فيها_رقم:
        نقاط = نقاط + 1
    لو فيها_كبير:
        نقاط = نقاط + 1
    لو فيها_رمز:
        نقاط = نقاط + 1
    حالة نقاط:
        قيمة 5:
            ارجع "قوية جدا"
        قيمة 4:
            ارجع "قوية"
        قيمة 3:
            ارجع "متوسطة"
        افتراضي:
            ارجع "ضعيفة"

اطبع "abc:", قوة("abc")
اطبع "Password1:", قوة("Password1")
اطبع "Str0ng!Pass#:", قوة("Str0ng!Pass#")
