# مثال 4135 — مجموع الأعداد من 40 إلى ن
# Sum from 40 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4135-sum-of-integers-from-40-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(40, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(40), 40, "حالة 1")
تأكد_يساوي(ف(41), 81, "حالة 2")
تأكد_يساوي(ف(50), 495, "حالة 3")
تأكد_يساوي(ف(100), 4270, "حالة 4")
