# مثال 2395 — صنف مخزون
# Inventory class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2395-class-inventory-add-remove-count.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مخزن:
    دالة_إنشاء(ذات):
        ذات.ق = {}

    دالة اضف(ذات, ا, ك):
        ذات.ق[ا] = ذات.ق.get(ا, 0) + ك

    دالة ازل(ذات, ا, ك):
        ذات.ق[ا] = ذات.ق.get(ا, 0) - ك

    دالة كمية(ذات, ا):
        ارجع ذات.ق.get(ا, 0)

م = مخزن()
م.اضف("تفاح", 10)
م.اضف("تفاح", 5)
م.ازل("تفاح", 3)
تأكد_يساوي(م.كمية("تفاح"), 12, "تفاح")
تأكد_يساوي(م.كمية("موز"), 0, "غير موجود")
