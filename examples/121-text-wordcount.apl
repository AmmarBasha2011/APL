# مثال 121 — تكرار الكلمات في نص عربي
# Word frequency in Arabic text
# Demonstrates: عداد، عنصر_أكثر، تقسيم
#
# Run:  python apl.py examples/121-text-wordcount.apl

المتغير نص = "البرمجة متعة والبرمجة فن ومن يتقن البرمجة يتقن التفكير"
المتغير كلمات = نص.تقسيم()
المتغير عد = عداد(كلمات)

اطبع "عدد الكلمات:", طول(كلمات)
اطبع "الكلمات الفريدة:", طول(عد)
اطبع "تكرار كلمة البرمجة:", عد["البرمجة"]
اطبع "الأكثر تكراراً:", عنصر_أكثر(عد, 2)
