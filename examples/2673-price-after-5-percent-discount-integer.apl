# مثال 2673 — السعر بعد خصم 5 بالمئة
# Price after 5 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2673-price-after-5-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 5 // 100

تأكد_يساوي(ف(100), 95, "حالة 1")
تأكد_يساوي(ف(250), 238, "حالة 2")
تأكد_يساوي(ف(999), 950, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
