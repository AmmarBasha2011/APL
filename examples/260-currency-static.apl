# مثال 260 — محول عملات بأسعار ثابتة
# Currency converter (fixed rates)
# Demonstrates: جدول أسعار، تحويل متسلسل
#
# Run:  python apl.py examples/260-currency-static.apl

المتغير أسعار = {"USD": 1.0, "EGP": 48.5, "EUR": 0.92, "SAR": 3.75, "AED": 3.67}

دالة حول(مبلغ, من, إلى):
    المتغير بالدولار = مبلغ / أسعار[من]
    ارجع مقرب(بالدولار * أسعار[إلى], 2)

اطبع "100 دولار =", حول(100, "USD", "EGP"), "جنيه"
اطبع "1000 جنيه =", حول(1000, "EGP", "SAR"), "ريال"
اطبع "50 يورو =", حول(50, "EUR", "AED"), "درهم"
