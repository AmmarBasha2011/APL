# مثال 1095 — هل يعود الروبوت
# Robot return to origin
# Demonstrates: إحداثيات
#
# Run:  python apl.py examples/1095-route-circle.apl

# U وD تغيران المحور الرأسي وL وR الأفقي
# يعود الروبوت لو انتهى عند الصفر في المحورين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يعود(حركات):
  س = 0
  ص = 0
  لكل ح في حركات:
    لو ح == "U":
      ص = ص + 1
    والا_لو ح == "D":
      ص = ص - 1
    والا_لو ح == "L":
      س = س - 1
    والا_لو ح == "R":
      س = س + 1
  ارجع (س == 0) و (ص == 0)

تأكد_يساوي(يعود("UD"), صواب, "أعلى وأسفل")
تأكد_يساوي(يعود("LL"), خطأ, "يسار مرتين")
تأكد_يساوي(يعود("RRDDLUUL"), صواب, "مسار طويل")
تأكد_يساوي(يعود(""), صواب, "بلا حركات")
