# مثال 926 — الترميز المتغير الطول
# Varint encoding
# Demonstrates: سبع بتات لكل بايت
#
# Run:  python apl.py examples/926-varint.apl

# ترميز varint: أعداد صحيحة بطول متغير (7 بتات لكل بايت)
# بت الإشارة العليا تعني "يوجد بايت تالٍ" - يستخدم في بروتوكولات الشبكة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رمز_متغير(ن):
  بايتات = []
  م = ن
  طالما 1 == 1:
    بت = م & 127
    م = م >> 7
    لو م > 0:
      بايتات.ألحق(بت | 128)
    والا:
      بايتات.ألحق(بت)
      ارجع بايتات

دالة فك_متغير(بايتات):
  قيمة = 0
  إزاحة = 0
  لكل بايت في بايتات:
    قيمة = قيمة | ((بايت & 127) << إزاحة)
    لو بايت & 128 == 0:
      ارجع قيمة
    إزاحة = إزاحة + 7
  ارجع قيمة

اطبع "300 ->", رمز_متغير(300)
اطبع "1 ->", رمز_متغير(1)
اطبع "624485 ->", رمز_متغير(624485)

# 300 = 0b100101100 -> بايتان: [172, 2]
ر300 = رمز_متغير(300)
تأكد_يساوي(طول(ر300), 2, "300 ببايتين")
تأكد_يساوي(ر300[0], 172, "البايت الأول")
تأكد_يساوي(ر300[1], 2, "البايت الثاني")

# الصغار يأخذون بايتاً واحداً
تأكد_يساوي(طول(رمز_متغير(1)), 1, "واحد ببايت")
تأكد_يساوي(طول(رمز_متغير(127)), 1, "127 ببايت")
تأكد_يساوي(طول(رمز_متغير(128)), 2, "128 ببايتين")

# 624485 بثلاثة بايتات
تأكد_يساوي(طول(رمز_متغير(624485)), 3, "624485 بثلاثة")

# الفك يعيد الأصل
لكل ن في [0, 1, 127, 128, 300, 624485, 1000000]:
  تأكد_يساوي(فك_متغير(رمز_متغير(ن)), ن, "طي وفك " + نص(ن))
