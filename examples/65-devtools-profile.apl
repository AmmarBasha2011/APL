# مثال 65 — قياس الأداء والذاكرة (مكتبة devtools)
# Timing (timeit), profiling (profile), memory (tracemalloc) and gc
#
# Run:  python apl.py examples/65-devtools-profile.apl

اطبع "=== قياس الزمن (timeit) ==="
المتغير م = مؤقّت("sum(range(10000))")
اطبع "قِس_المحاولة:", م.قِس_المحاولة(1000)
اطبع "كرّر_المحاولة:", م.كرّر_المحاولة(3, 5)

اطبع ""
اطبع "=== تحليل الأداء (profile) ==="
المتغير محلل = محلّل_أداء()
محلل.شغّل_التحليل("sum(range(20000))")
اطبع "محلّل_سريع صنف:", هو_صنف(محلّل_سريع)
اطبع "شغّل_تحليلاً_سريعاً:", هو_دالة(شغّل_تحليلاً_سريعاً)

اطبع ""
اطبع "=== الذاكرة (tracemalloc) ==="
ابدأ_تتبع_الذاكرة()
المتغير لقطة = خذ_لقطة_الذاكرة()
المتغير إحصاءات = لقطة.إحصاءات_اللقطة("filename")
اطبع "عدد الإحصاءات:", طول(إحصاءات)
اطبع "عدد_التخصيصات:", إحصاءات[0].عدد_التخصيصات
اطبع "الحجم:", إحصاءات[0].الحجم

اطبع ""
اطبع "=== جمع القمامة (gc) ==="
اجمع_القمامة(0)
اطبع "عدد_الأجيال:", طول(عدد_الأجيال())
اطبع "عتبات_الجمع:", عتبات_الجمع()
اطبع "هو_مفعّل:", هو_مفعّل()
