# مثال 1694 — قراءة المصفوفة حلزونياً
# Spiral order of a matrix
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1694-matrix-spiral-order-list.apl

# نضيق الحدود الأربعة
# نقرأ كل ضلع بدوره

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حلزوني(م):
  ناتج = []
  أعلى = 0
  أسفل = طول(م) - 1
  يسار = 0
  يمين = طول(م[0]) - 1
  طالما أعلى <= أسفل و يسار <= يمين:
    لكل ك في نطاق(يسار, يمين + 1):
      ناتج.append(م[أعلى][ك])
    أعلى = أعلى + 1
    لكل ك في نطاق(أعلى, أسفل + 1):
      ناتج.append(م[ك][يمين])
    يمين = يمين - 1
    لو أعلى <= أسفل:
      لكل ك في نطاق(يمين, يسار - 1, -1):
        ناتج.append(م[أسفل][ك])
      أسفل = أسفل - 1
    لو يسار <= يمين:
      لكل ك في نطاق(أسفل, أعلى - 1, -1):
        ناتج.append(م[ك][يسار])
      يسار = يسار + 1
  ارجع ناتج

تأكد_يساوي(حلزوني([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [1, 2, 3, 6, 9, 8, 7, 4, 5], "ثلاثة")
تأكد_يساوي(حلزوني([[1, 2], [3, 4]]), [1, 2, 4, 3], "اثنان")
تأكد_يساوي(حلزوني([[1, 2, 3]]), [1, 2, 3], "صف")
