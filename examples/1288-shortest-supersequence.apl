# مثال 1288 — أقصر متتالية شاملة
# Shortest common supersequence length
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1288-shortest-supersequence.apl

# الطول هو مجموع الطولين ناقص أطول متتالية مشتركة
# نحسبها بجدول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اطول_مشتركة(أ, ب):
  د = []
  لكل ع في نطاق(طول(أ) + 1):
    د.ألحق([0] * (طول(ب) + 1))
  لكل ع في نطاق(1, طول(أ) + 1):
    لكل ج في نطاق(1, طول(ب) + 1):
      لو أ[ع - 1] == ب[ج - 1]:
        د[ع][ج] = د[ع - 1][ج - 1] + 1
      والا:
        د[ع][ج] = أكبر(د[ع - 1][ج], د[ع][ج - 1])
  ارجع د[طول(أ)][طول(ب)]

دالة اقصر_شاملة(أ, ب):
  ارجع طول(أ) + طول(ب) - اطول_مشتركة(أ, ب)

تأكد_يساوي(اقصر_شاملة("abac", "cab"), 5, "مثال أول")
تأكد_يساوي(اقصر_شاملة("geek", "eke"), 5, "مثال ثان")
تأكد_يساوي(اقصر_شاملة("abc", "abc"), 3, "متطابقان")
تأكد_يساوي(اقصر_شاملة("", "xyz"), 3, "فارغ")
