# مثال 1335 — مطابقة بدائل
# Wildcard matching ? and *
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1335-wildcard-matching.apl

# علامة ? تطابق حرفاً واحداً
# علامة * تطابق أي تسلسل حتى الفارغ

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تطابق_نمط(نص_, نمط):
  جدول = []
  لكل ع في نطاق(طول(نص_) + 1):
    جدول.ألحق([خطأ] * (طول(نمط) + 1))
  جدول[0][0] = صواب
  لكل ج في نطاق(1, طول(نمط) + 1):
    لو (نمط[ج - 1] == "*") و جدول[0][ج - 1]:
      جدول[0][ج] = صواب
  لكل ع في نطاق(1, طول(نص_) + 1):
    لكل ج في نطاق(1, طول(نمط) + 1):
      لو نمط[ج - 1] == "*":
        لو جدول[ع][ج - 1] أو جدول[ع - 1][ج]:
          جدول[ع][ج] = صواب
      والا_لو (نمط[ج - 1] == "?") أو (نمط[ج - 1] == نص_[ع - 1]):
        جدول[ع][ج] = جدول[ع - 1][ج - 1]
  ارجع جدول[طول(نص_)][طول(نمط)]

تأكد_يساوي(تطابق_نمط("aa", "a"), خطأ, "قصير")
تأكد_يساوي(تطابق_نمط("aa", "*"), صواب, "نجمة")
تأكد_يساوي(تطابق_نمط("cb", "?a"), خطأ, "علامة استفهام")
تأكد_يساوي(تطابق_نمط("adceb", "*a*b"), صواب, "نجمتان")
