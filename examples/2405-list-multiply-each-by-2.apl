# مثال 2405 — ضرب كل عنصر في 2
# Multiply each item by 2
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2405-list-multiply-each-by-2.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 2]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [6, 2, 4], "حالة 1")
تأكد_يساوي(ف([5]), [10], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [2, 4, 6, 8, 10, 12], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-4, 0, 14, 14, 8], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [20, 40, 20, 60, 40, 20], "حالة 5")
