# مثال 3705 — الحد النوني بخطوة 45
# Nth term step 45
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3705-nth-term-arithmetic-sequence-step-45.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 45

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 48, "حالة 2")
تأكد_يساوي(ف(10), 408, "حالة 3")
تأكد_يساوي(ف(100), 4458, "حالة 4")
