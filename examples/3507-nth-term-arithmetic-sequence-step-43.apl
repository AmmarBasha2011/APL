# مثال 3507 — الحد النوني بخطوة 43
# Nth term step 43
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3507-nth-term-arithmetic-sequence-step-43.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 43

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 46, "حالة 2")
تأكد_يساوي(ف(10), 390, "حالة 3")
تأكد_يساوي(ف(100), 4260, "حالة 4")
