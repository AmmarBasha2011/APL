# مثال 192 — متتالية كولاتز
# Collatz sequence
# Demonstrates: طالما، الشروط، حساب الخطوات
#
# Run:  python apl.py examples/192-collatz.apl

دالة كولاتز(ن):
    المتغير خطوات = 0
    المتغير قمة = ن
    طالما ن != 1:
        لو ن % 2 == 0:
            ن = ن // 2
        الا:
            ن = 3 * ن + 1
        لو ن > قمة:
            قمة = ن
        خطوات = خطوات + 1
    ارجع [خطوات, قمة]

لكل بداية في [6, 27, 97]:
    المتغير نتيجة = كولاتز(بداية)
    اطبع "بدءا من", بداية, ": خطوات =", نتيجة[0], ", أعلى قيمة =", نتيجة[1]
