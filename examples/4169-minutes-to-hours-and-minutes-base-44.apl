# مثال 4169 — تحويل وحدة بأساس 44
# Split by base 44
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4169-minutes-to-hours-and-minutes-base-44.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 44, ن % 44]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 15], "حالة 2")
تأكد_يساوي(ف(60), [1, 16], "حالة 3")
تأكد_يساوي(ف(125), [2, 37], "حالة 4")
تأكد_يساوي(ف(1000), [22, 32], "حالة 5")
