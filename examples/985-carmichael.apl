# مثال 985 — أعداد كارمايكل
# Carmichael numbers
# Demonstrates: فحص قواعد فيرما
#
# Run:  python apl.py examples/985-carmichael.apl

# أعداد كارمايكل: مركبة تخدع اختبار فيرما لكل قاعدة سليمة
# 561 أصغرها: تمر كل قاعدة غير مشتركة معها في القواسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قاسم(أ, ب):
  س = أ
  ص = ب
  طالما ص != 0:
    مؤقت = ص
    ص = س % ص
    س = مؤقت
  ارجع س

دالة قوة_مود(أ, هـ, م):
  ناتج = 1
  قاعدة = أ % م
  باقي = هـ
  طالما باقي > 0:
    لو (باقي % 2) == 1:
      ناتج = (ناتج * قاعدة) % م
    قاعدة = (قاعدة * قاعدة) % م
    باقي = باقي // 2
  ارجع ناتج

عدد_سليم = 0
نجح_الكل = 1
لكل أ في نطاق(2, 20):
  لو قاسم(أ, 561) == 1:
    عدد_سليم = عدد_سليم + 1
    لو قوة_مود(أ, 560, 561) != 1:
      نجح_الكل = 0

تأكد_يساوي(عدد_سليم, 10, "عشر قواعد سليمة")
تأكد_يساوي(نجح_الكل, 1, "كل القواعد تخدع فيرما")
تأكد_يساوي(3 * 11 * 17, 561, "مركب بثلاثة عوامل")
تأكد_يساوي(قاسم(12, 561), 3, "قاسم مشترك")
