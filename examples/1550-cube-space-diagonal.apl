# مثال 1550 — قطر المكعب
# Cube space diagonal
# Demonstrates: هندسة ثلاثية
#
# Run:  python apl.py examples/1550-cube-space-diagonal.apl

# القطر = الضلع × جذر ثلاثة
# نربع ونضرب بثلاثة ثم نجذر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قطر_المكعب(ضلع):
  ارجع (3 * ضلع * ضلع) ** 0.5

تأكد_يساوي(قطر_المكعب(0), 0.0, "صفر")
تأكد_يساوي(قطر_المكعب(2) > 3.46, صواب, "ضلع اثنان")
تأكد_يساوي(قطر_المكعب(10) > 17.3, صواب, "أكبر من 17.3")
تأكد_يساوي(قطر_المكعب(10) < 17.4, صواب, "أصغر من 17.4")
