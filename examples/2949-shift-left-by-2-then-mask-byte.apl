# مثال 2949 — إزاحة يسار 2 مع قناع بايت
# Shift left 2 and mask byte
# Demonstrates: بتات
#
# Run:  python apl.py examples/2949-shift-left-by-2-then-mask-byte.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن << 2) & 255

تأكد_يساوي(ف(1), 4, "حالة 1")
تأكد_يساوي(ف(3), 12, "حالة 2")
تأكد_يساوي(ف(85), 84, "حالة 3")
تأكد_يساوي(ف(170), 168, "حالة 4")
تأكد_يساوي(ف(255), 252, "حالة 5")
