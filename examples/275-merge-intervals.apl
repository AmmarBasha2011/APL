# مثال 275 — دمج الفترات المتداخلة
# Merge intervals
# Demonstrates: ترتيب ثم دمج
#
# Run:  python apl.py examples/275-merge-intervals.apl

دالة ادمج(فترات):
    المتغير مرتبة = مفرز(فترات, key=(ف) => ف[0])
    المتغير نتيجة = [مرتبة[0]]
    لكل ي في نطاق(1, طول(مرتبة)):
        المتغير أخيرة = نتيجة[-1]
        المتغير حالية = مرتبة[ي]
        لو حالية[0] <= أخيرة[1]:
            لو حالية[1] > أخيرة[1]:
                أخيرة[1] = حالية[1]
        الا:
            نتيجة.أضف(حالية)
    ارجع نتيجة

اطبع ادمج([[1, 3], [2, 6], [8, 10], [15, 18]])
اطبع ادمج([[1, 4], [4, 5]])
