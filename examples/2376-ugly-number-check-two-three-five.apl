# مثال 2376 — العدد القبيح
# Ugly number check
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2376-ugly-number-check-two-three-five.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لكل ق في [2, 3, 5]:
    طالما ن % ق == 0:
      ن = ن // ق
  ارجع ن == 1

تأكد_يساوي(ف(1), صواب, "حالة 1")
تأكد_يساوي(ف(6), صواب, "حالة 2")
تأكد_يساوي(ف(14), خطأ, "حالة 3")
تأكد_يساوي(ف(30), صواب, "حالة 4")
تأكد_يساوي(ف(49), خطأ, "حالة 5")
تأكد_يساوي(ف(64), صواب, "حالة 6")
