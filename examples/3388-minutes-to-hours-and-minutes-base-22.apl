# مثال 3388 — تحويل وحدة بأساس 22
# Split by base 22
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3388-minutes-to-hours-and-minutes-base-22.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 22, ن % 22]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 15], "حالة 2")
تأكد_يساوي(ف(60), [2, 16], "حالة 3")
تأكد_يساوي(ف(125), [5, 15], "حالة 4")
تأكد_يساوي(ف(1000), [45, 10], "حالة 5")
