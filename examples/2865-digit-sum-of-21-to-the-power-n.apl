# مثال 2865 — مجموع أرقام 21 أس ن
# Digit sum of 21 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2865-digit-sum-of-21-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 21 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(5), 18, "حالة 3")
تأكد_يساوي(ف(10), 72, "حالة 4")
تأكد_يساوي(ف(20), 126, "حالة 5")
