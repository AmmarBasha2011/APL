# مثال 4159 — السعر مع ضريبة 44 بالمئة
# Price with 44 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4159-price-with-44-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 44 // 100

تأكد_يساوي(ف(100), 144, "حالة 1")
تأكد_يساوي(ف(250), 360, "حالة 2")
تأكد_يساوي(ف(999), 1438, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
