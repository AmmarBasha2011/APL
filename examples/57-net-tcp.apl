# مثال 57 — مقابس TCP و UDP: خادم وعميل على نفس الجهاز
# TCP and UDP sockets end to end
# Demonstrates: مقبس_شبكة, ربط_المنفذ, استمع_للاتصالات, اقبل_اتصال,
#               اتصال_شبكة, أرسل_الكل, استقبل, عين_مهلة, عنوان_المقبس,
#               أغلق_المقبس, أرسل_إلى_عنوان, استقبل_من, انتظر_جاهزية
#
# Run:  python apl.py examples/57-net-tcp.apl

اطبع "=== 1) خادم TCP وعميله ==="

المتغير خادم = مقبس_شبكة(عائلة_ipv4, مقبس_تدفق)
خادم.عين_خيار(مستوى_المقبس, إعادة_استخدام_العنوان, 1)
خادم.ربط_المنفذ(("127.0.0.1", 0))
خادم.استمع_للاتصالات(1)
المتغير عنوان_الخدمة = خادم.عنوان_المقبس()
اطبع "الخادم يستمع على " + نص(عنوان_الخدمة)

المتغير عميل = اتصال_شبكة(عنوان_الخدمة, مهلة_اتصال = 5)
عميل.عين_مهلة(5)
المتغير اتصال, طرف = خادم.اقبل_اتصال()
اطبع "وصل اتصال من " + نص(طرف)

# ---------- 2) تبادل رسائل ----------
اطبع "=== 2) تبادل الرسائل ==="
المتغير رسائل = ["صباح الخير", "كيف الحال؟", "إلى اللقاء"]
لكل رسالة في رسائل:
    عميل.أرسل_الكل(رسالة.encode())
    المتغير مستلم = اتصال.استقبل(1024).decode()
    اطبع "  العميل أرسل: " + رسالة + " | الخادم استلم: " + مستلم

اتصال.أغلق_المقبس()
عميل.أغلق_المقبس()
خادم.أغلق_المقبس()
اطبع "أُغلقت مقابس TCP"

# ---------- 3) UDP ----------
اطبع "=== 3) رسائل UDP ==="
المتغير مستمع = مقبس_شبكة(عائلة_ipv4, مقبس_بيانات)
مستمع.ربط_المنفذ(("127.0.0.1", 0))
المتغير عنوان_الاستماع = مستمع.عنوان_المقبس()

المتغير مُرسل = مقبس_شبكة(عائلة_ipv4, مقبس_بيانات)
مُرسل.عين_مهلة(3)
مُرسل.أرسل_إلى_عنوان("رسالة بلا اتصال".encode(), عنوان_الاستماع)

المتغير بيانات, مرسل = مستمع.استقبل_من(1024)
اطبع "استُقبل من " + نص(مرسل) + ": " + بيانات.decode()

مُرسل.أغلق_المقبس()
مستمع.أغلق_المقبس()

# ---------- 4) الجاهزية ----------
اطبع "=== 4) اختبار الجاهزية ==="
المتغير ا1, ا2 = زوج_مقابس()
المتغير جاهز_قبل, _, _ = انتظر_جاهزية([ا1], [], [], 0.1)
اطبع "جاهز قبل الإرسال: " + نص(طول(جاهز_قبل))

ا2.أرسل_الكل("بيانات جاهزة".encode())
المتغير جاهز_بعد, _, _ = انتظر_جاهزية([ا1], [], [], 1)
اطبع "جاهز بعد الإرسال: " + نص(طول(جاهز_بعد))
اطبع "المحتوى: " + جاهز_بعد[0].استقبل(100).decode()

ا1.أغلق_المقبس()
ا2.أغلق_المقبس()

# ---------- 5) معلومات الشبكة ----------
اطبع "=== 5) معلومات الجهاز ==="
اطبع "اسم الجهاز: " + اسم_الجهاز()
اطبع "localhost -> " + عنوان_الاسم("localhost")
اطبع "منفذ http: " + نص(منفذ_الخدمة("http"))
اطبع "منفذ https: " + نص(منفذ_الخدمة("https"))
اطبع "عدد واجهات الشبكة: " + نص(طول(واجهات_الشبكة()))

اطبع "تم."
