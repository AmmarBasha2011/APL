# مثال 1044 — جمع ثنائي
# Add binary strings
# Demonstrates: حمل من اليمين
#
# Run:  python apl.py examples/1044-add-binary.apl

# نجمع الخانات من اليمين مع الحمل
# المجموع 0 أو 1 يبقى والحمل يمضي للخانة التالية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اجمع_ثنائي(أ, ب):
  ناتج = ""
  ي = طول(أ) - 1
  ك = طول(ب) - 1
  حمل = 0
  طالما (ي >= 0) أو (ك >= 0) أو (حمل > 0):
    مج = حمل
    لو ي >= 0:
      مج = مج + صحيح(أ[ي])
      ي = ي - 1
    لو ك >= 0:
      مج = مج + صحيح(ب[ك])
      ك = ك - 1
    ناتج = نص(مج % 2) + ناتج
    حمل = مج // 2
  ارجع ناتج

تأكد_يساوي(اجمع_ثنائي("11", "1"), "100", "حمل متسلسل")
تأكد_يساوي(اجمع_ثنائي("1010", "1011"), "10101", "أربع خانات")
تأكد_يساوي(اجمع_ثنائي("0", "0"), "0", "صفران")
