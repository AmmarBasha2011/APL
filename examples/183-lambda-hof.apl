# مثال 183 — الدوال المجردة ودوال الرتبة العليا
# Lambdas and higher-order functions
# Demonstrates: =>, تحويل_قائمة، فلترة_قائمة، مفتاح، الترتيب بمفتاح
#
# Run:  python apl.py examples/183-lambda-hof.apl

المتغير كلمات = ["تفاح", "موز", "كرز", "عنب", "بطيخ"]

المتغير بالطول = مفرز(كلمات, key=(ك) => طول(ك))
اطبع "مفرزة بالطول:", بالطول

المتغير بالطول_تنازلي = مفرز(كلمات, key=(ك) => طول(ك), reverse=True)
اطبع "تنازليا:", بالطول_تنازلي

المتغير أطوال = قائمة(تحويل_قائمة((ك) => طول(ك), كلمات))
اطبع "الأطوال:", أطوال

المتغير طويلة = قائمة(فلترة_قائمة((ك) => طول(ك) > 4, كلمات))
اطبع "كلمات أطول من 4:", طويلة

المتغير أشخاص = [{"اسم": "علي", "عمر": 30}, {"اسم": "سارة", "عمر": 25}, {"اسم": "خالد", "عمر": 35}]
المتغير بالعمر = مفرز(أشخاص, key=(ش) => ش["عمر"])
اطبع "الأصغر:", بالعمر[0]["اسم"]
اطبع "الأكبر:", بالعمر[-1]["اسم"]
