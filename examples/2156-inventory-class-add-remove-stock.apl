# مثال 2156 — صنف مخزن بإضافة وسحب
# Inventory class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2156-inventory-class-add-remove-stock.apl

# # الإضافة تزيد الكمية
# # والسحب يرجع نجاحا أو فشلا

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مخزن:
    دالة_إنشاء(ذات):
        ذات.كميات = {}

    دالة اضف(ذات, صنف_, كمية):
        ذات.كميات[صنف_] = ذات.كميات.get(صنف_, 0) + كمية

    دالة اسحب(ذات, صنف_, كمية):
        لو ذات.كميات.get(صنف_, 0) < كمية:
            ارجع خطأ
        ذات.كميات[صنف_] = ذات.كميات[صنف_] - كمية
        ارجع صواب

    دالة متاح(ذات, صنف_):
        ارجع ذات.كميات.get(صنف_, 0)

م = مخزن()
م.اضف("pen", 10)
تأكد_يساوي(م.اسحب("pen", 4), صواب, "سحب")
تأكد_يساوي(م.متاح("pen"), 6, "المتبقي")
تأكد_يساوي(م.اسحب("pen", 7), خطأ, "فشل")
تأكد_يساوي(م.متاح("cup"), 0, "غير موجود")
