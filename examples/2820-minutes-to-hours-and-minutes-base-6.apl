# مثال 2820 — تحويل وحدة بأساس 6
# Split by base 6
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2820-minutes-to-hours-and-minutes-base-6.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 6, ن % 6]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [9, 5], "حالة 2")
تأكد_يساوي(ف(60), [10, 0], "حالة 3")
تأكد_يساوي(ف(125), [20, 5], "حالة 4")
تأكد_يساوي(ف(1000), [166, 4], "حالة 5")
