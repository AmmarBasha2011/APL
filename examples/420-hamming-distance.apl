# مثال 420 — مسافة هامنج ورمز التصحيح
# Hamming distance
# Demonstrates: مقارنة تسلسلات
#
# Run:  python apl.py examples/420-hamming-distance.apl

دالة هامنج(أ, ب):
    لو طول(أ) != طول(ب):
        ارجع -1
    المتغير مسافة = 0
    لكل ي في نطاق(طول(أ)):
        لو أ[ي] != ب[ي]:
            مسافة = مسافة + 1
    ارجع مسافة

اطبع هامنج("karolin", "kathrin")
اطبع هامنج("1011101", "1001001")
اطبع هامنج("ABC", "AB")
