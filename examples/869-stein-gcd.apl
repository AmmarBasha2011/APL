# مثال 869 — قاسم شتاين الثنائي
# Binary GCD (Stein)
# Demonstrates: إزاحات وطرح بلا قسمة
#
# Run:  python apl.py examples/869-stein-gcd.apl

# خوارزمية شتاين (GCD الثنائي): قاسم مشترك أكبر بالإزاحات فقط
# بلا قسمة: طرح وإزاحة بتات، مناسب للعتاد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة شتاين(أ, ب):
  لو أ == 0:
    ارجع ب
  لو ب == 0:
    ارجع أ
  # عامل 2 مشترك
  ك = 0
  طالما أ % 2 == 0 و ب % 2 == 0:
    أ = أ // 2
    ب = ب // 2
    ك = ك + 1
  طالما أ % 2 == 0:
    أ = أ // 2
  طالما ب != 0:
    طالما ب % 2 == 0:
      ب = ب // 2
    لو أ > ب:
      مؤقت = أ
      أ = ب
      ب = مؤقت
    ب = ب - أ
  ارجع أ * (2 ** ك)

اطبع "شتاين(48, 18) =", شتاين(48, 18)
اطبع "شتاين(1071, 462) =", شتاين(1071, 462)

تأكد_يساوي(شتاين(48, 18), 6, "قاسم 48 و18")
تأكد_يساوي(شتاين(1071, 462), 21, "قاسم 1071 و462")
تأكد_يساوي(شتاين(17, 5), 1, "أوليان نسبياً")
تأكد_يساوي(شتاين(100, 0), 100, "مع صفر")
تأكد_يساوي(شتاين(2 ** 10, 2 ** 7), 128, "قوى اثنين")
