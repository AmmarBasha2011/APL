# مثال 1248 — وزن آخر حجر
# Last stone weight
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1248-last-stone-weight.apl

# نأخذ أثقل حجرين في كل مرة
# ونعيد الفرق لو لم يتساويا

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اخر_حجر(احجار):
  ق = قائمة(احجار)
  طالما طول(ق) > 1:
    ق = مفرز(ق)
    ا = ق.pop()
    ب = ق.pop()
    لو ا != ب:
      ق.ألحق(ا - ب)
  لو طول(ق) == 0:
    ارجع 0
  ارجع ق[0]

تأكد_يساوي(اخر_حجر([2,7,4,1,8,1]), 1, "مثال أول")
تأكد_يساوي(اخر_حجر([1]), 1, "حجر")
تأكد_يساوي(اخر_حجر([3,3]), 0, "متساويان")
