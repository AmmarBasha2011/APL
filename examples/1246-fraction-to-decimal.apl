# مثال 1246 — كسر إلى عشري
# Fraction to recurring decimal
# Demonstrates: باقي مكرر
#
# Run:  python apl.py examples/1246-fraction-to-decimal.apl

# نسجل موضع كل باقٍ ظهر
# وعند تكراره نضع القوس حول الدورة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عشري(ب, م):
  لو ب == 0:
    ارجع "0"
  اشارة = ""
  لو (ب < 0) != (م < 0):
    اشارة = "-"
  ب = ب if ب > 0 else -ب
  م = م if م > 0 else -م
  ناتج = اشارة + نص(ب // م)
  باق = ب % م
  لو باق == 0:
    ارجع ناتج
  ناتج = ناتج + "."
  مواضع = {}
  طالما باق != 0:
    لو باق في مواضع:
      ي = مواضع[باق]
      ارجع ناتج[:ي] + "(" + ناتج[ي:] + ")"
    مواضع[باق] = طول(ناتج)
    باق = باق * 10
    ناتج = ناتج + نص(باق // م)
    باق = باق % م
  ارجع ناتج

تأكد_يساوي(عشري(1, 2), "0.5", "نصف")
تأكد_يساوي(عشري(2, 1), "2", "صحيح")
تأكد_يساوي(عشري(4, 333), "0.(012)", "دورة")
تأكد_يساوي(عشري(1, 6), "0.1(6)", "دورة متأخرة")
تأكد_يساوي(عشري(-50, 8), "-6.25", "سالب")
