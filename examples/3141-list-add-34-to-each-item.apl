# مثال 3141 — إضافة 34 لكل عنصر
# Add 34 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3141-list-add-34-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 34]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [37, 35, 36], "حالة 1")
تأكد_يساوي(ف([5]), [39], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [35, 36, 37, 38, 39, 40], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [32, 34, 41, 41, 38], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [44, 54, 44, 64, 54, 44], "حالة 5")
