# مثال 346 — كاشف المحتوى المكرر
# Duplicate content finder
# Demonstrates: تجميع بالمحتوى
#
# Run:  python apl.py examples/346-duplicate-finder.apl

المتغير ملفات = {
    "أ.txt": "مرحبا بالعالم",
    "ب.txt": "نص مختلف",
    "ج.txt": "مرحبا بالعالم",
    "د.txt": "نص مختلف",
    "ه.txt": "فريد"
}

المتغير بالمحتوى = {}
لكل اسم in ملفات:
    المتغير محتوى = ملفات[اسم]
    لو محتوى في بالمحتوى:
        بالمحتوى[محتوى].أضف(اسم)
    الا:
        بالمحتوى[محتوى] = [اسم]

لكل محتوى في بالمحتوى:
    لو طول(بالمحتوى[محتوى]) > 1:
        اطبع "مكرر:", بالمحتوى[محتوى]
