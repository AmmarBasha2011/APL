# مثال 3786 — مجموع ord مع إزاحة 17
# Sum of ord values plus 17 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3786-sum-of-ord-values-offset-17.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 17
  ارجع م

تأكد_يساوي(ف("a"), 114, "حالة 1")
تأكد_يساوي(ف("abc"), 345, "حالة 2")
تأكد_يساوي(ف("xyz"), 414, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
