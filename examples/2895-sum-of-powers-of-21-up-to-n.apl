# مثال 2895 — مجموع قوى 21
# Sum of powers of 21
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2895-sum-of-powers-of-21-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 21 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 22, "حالة 2")
تأكد_يساوي(ف(3), 9724, "حالة 3")
تأكد_يساوي(ف(6), 90054427, "حالة 4")
تأكد_يساوي(ف(10), 17513875027111, "حالة 5")
