# مثال 657 — أوتومات اللواحق
# Suffix automaton
# Demonstrates: لواحق، حالات، روابط
#
# Run:  python apl.py examples/657-suffix-automaton.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# أوتومات اللواحق: بنية نصية مدمجة
# Demonstrates: حالات وروابط لاحقة, استنساخ, فحص وجود نص فرعي
# كل النصوص الفرعية في بنية خطية الحجم

دالة حالة_جديدة(طول_أقصى, رابط):
  ارجع {"طول": طول_أقصى, "رابط": رابط, "انتقالات": {}}

دالة ابن(نص):
  حالات = [حالة_جديدة(0, 0 - 1)]
  آخر = 0
  لكل حرف في نص:
    حالات.append(حالة_جديدة(حالات[آخر]["طول"] + 1, 0))
    جديد = طول(حالات) - 1
    ع = آخر
    طالما ع != 0 - 1 و حالات[ع]["انتقالات"].get(حرف, لا_شيء) == لا_شيء:
      حالات[ع]["انتقالات"][حرف] = جديد
      ع = حالات[ع]["رابط"]
    لو ع == 0 - 1:
      حالات[جديد]["رابط"] = 0
    والا:
      ت = حالات[ع]["انتقالات"][حرف]
      لو حالات[ع]["طول"] + 1 == حالات[ت]["طول"]:
        حالات[جديد]["رابط"] = ت
      والا:
        نسخة = {"طول": حالات[ع]["طول"] + 1, "رابط": حالات[ت]["رابط"], "انتقالات": حالات[ت]["انتقالات"].copy()}
        حالات.append(نسخة)
        رقم_نسخة = طول(حالات) - 1
        طالما ع != 0 - 1 و حالات[ع]["انتقالات"].get(حرف, لا_شيء) == ت:
          حالات[ع]["انتقالات"][حرف] = رقم_نسخة
          ع = حالات[ع]["رابط"]
        حالات[ت]["رابط"] = رقم_نسخة
        حالات[جديد]["رابط"] = رقم_نسخة
    آخر = جديد
  ارجع حالات

دالة موجود(حالات, نمط):
  ع = 0
  لكل حرف في نمط:
    تالي = حالات[ع]["انتقالات"].get(حرف, لا_شيء)
    لو تالي == لا_شيء:
      ارجع خطأ
    ع = تالي
  ارجع صواب

حالات = ابن("abbc")
تأكد_يساوي(موجود(حالات, "abb"), صواب, "abb موجود")
تأكد_يساوي(موجود(حالات, "bbc"), صواب, "bbc موجود")
تأكد_يساوي(موجود(حالات, "b"), صواب, "b موجود")
تأكد_يساوي(موجود(حالات, "acb"), خطأ, "acb مفقود")
تأكد_يساوي(موجود(حالات, "ba"), خطأ, "ba مفقود")
تأكد_يساوي(موجود(حالات, "abbc"), صواب, "النص كله موجود")
اطبع "عدد الحالات:", طول(حالات)
