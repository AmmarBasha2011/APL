# مثال 284 — مجموعات بمبلغ مستهدف
# Combination sum
# Demonstrates: تراجع مع إعادة الاستخدام
#
# Run:  python apl.py examples/284-combination-sum.apl

دالة ابحث(مرشحون, هدف, بداية, حالية, نتيجة):
    لو هدف == 0:
        نتيجة.أضف(حالية)
        ارجع
    لكل ي في نطاق(بداية, طول(مرشحون)):
        لو مرشحون[ي] <= هدف:
            ابحث(مرشحون, هدف - مرشحون[ي], ي, حالية + [مرشحون[ي]], نتيجة)

دالة مجموعات_مبلغ(مرشحون, هدف):
    المتغير نتيجة = []
    ابحث(مرشحون, هدف, 0, [], نتيجة)
    ارجع نتيجة

اطبع مجموعات_مبلغ([2, 3, 6, 7], 7)
اطبع مجموعات_مبلغ([2, 3, 5], 8)
