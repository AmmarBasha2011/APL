# مثال 3120 — مجموع المربعات من 4 إلى ن
# Sum of squares from 4
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3120-sum-of-squares-from-4-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(4, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(4), 16, "حالة 1")
تأكد_يساوي(ف(5), 41, "حالة 2")
تأكد_يساوي(ف(14), 1001, "حالة 3")
تأكد_يساوي(ف(100), 338336, "حالة 4")
