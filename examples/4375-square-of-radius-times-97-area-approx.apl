# مثال 4375 — مساحة دائرة بتقريب 97
# Circle area with pi approx 97/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4375-square-of-radius-times-97-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 97 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 13, "حالة 2")
تأكد_يساوي(ف(7), 679, "حالة 3")
تأكد_يساوي(ف(14), 2716, "حالة 4")
تأكد_يساوي(ف(21), 6111, "حالة 5")
