# مثال 3684 — مجموع أرقام 49 أس ن
# Digit sum of 49 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3684-digit-sum-of-49-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 49 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 13, "حالة 2")
تأكد_يساوي(ف(5), 43, "حالة 3")
تأكد_يساوي(ف(10), 76, "حالة 4")
تأكد_يساوي(ف(20), 142, "حالة 5")
