# مثال 3828 — قوة 19 بالحلقة
# Power of 19 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3828-nth-power-of-19-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 19
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 19, "حالة 2")
تأكد_يساوي(ف(3), 6859, "حالة 3")
تأكد_يساوي(ف(6), 47045881, "حالة 4")
تأكد_يساوي(ف(10), 6131066257801, "حالة 5")
