# مثال 1679 — المستطيل المحيط بالنقاط
# Bounding box of points
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1679-bounding-box-of-points.apl

# نمر على النقاط
# نحدث الحدود الأربعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مستطيل_محيط(نقاط):
  س_أصغر = نقاط[0][0]
  س_أكبر = نقاط[0][0]
  ص_أصغر = نقاط[0][1]
  ص_أكبر = نقاط[0][1]
  لكل ن في نقاط:
    س_أصغر = أصغر(س_أصغر, ن[0])
    س_أكبر = أكبر(س_أكبر, ن[0])
    ص_أصغر = أصغر(ص_أصغر, ن[1])
    ص_أكبر = أكبر(ص_أكبر, ن[1])
  ارجع [س_أصغر, ص_أصغر, س_أكبر, ص_أكبر]

تأكد_يساوي(مستطيل_محيط([[1, 5], [3, 2], [-1, 4]]), [-1, 2, 3, 5], "ثلاث نقاط")
تأكد_يساوي(مستطيل_محيط([[2, 2]]), [2, 2, 2, 2], "نقطة")
