# مثال 78 — صيغ البيانات XML (مكتبة datafiles)
# XML with ElementTree and minidom (xml.etree / xml.dom)
#
# Run:  python apl.py examples/78-df-xml.apl

اطبع "=== بناء شجرة عناصر ==="
المتغير ج = عنصر_3("كتاب")
ج.عنصر_عيّن("لون", "أحمر")
اطبع "الوسم:", ج.عنصر_وسم
اطبع "السمة:", ج.عنصر_احصل("لون")

اطبع ""
اطبع "=== تحويل إلى نص ==="
المتغير نص = إلى_نص_2(ج)
اطبع "XML:", نص

اطبع ""
اطبع "=== تحليل مستند ==="
المتغير مصدر = "<مكتبة><كتاب لون=\"أزرق\">عنوان</كتاب></مكتبة>"
المتغير م = حلل_نصاً(مصدر)
اطبع "نوع المستند:", نوع(م)
اطبع "اسم العقدة:", م.مستند_عُقدة_اسم

اطبع ""
اطبع "=== عناصر فرعية ==="
المتغير ع = م.مستند_احصل_عناصر_بواسطة_وسم_اسم("كتاب")
اطبع "عدد الكتب:", طول(ع)
لكل ك in ع:
    اطبع "  -", ك.احصل_سمة("لون"), "|", ك.عُقدة_أول_ابن.نص_بيانات
