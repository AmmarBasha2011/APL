# مثال 1872 — بناء كومة صغرى من قائمة
# Build min heap by sift down
# Demonstrates: هياكل بيانات
#
# Run:  python apl.py examples/1872-heapify-build-min-heap.apl

# نبدأ من آخر أب
# ننزل العنصر مع الأصغر من ابنيه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة انزل(ق, ك):
  ن = طول(ق)
  طالما صواب:
    صغير = ك
    يسار = 2 * ك + 1
    يمين = 2 * ك + 2
    لو يسار < ن و ق[يسار] < ق[صغير]:
      صغير = يسار
    لو يمين < ن و ق[يمين] < ق[صغير]:
      صغير = يمين
    لو صغير == ك:
      ارجع 0
    ت = ق[ك]
    ق[ك] = ق[صغير]
    ق[صغير] = ت
    ك = صغير

دالة ابن_كومة(ق):
  ق = ق + []
  لكل ك في نطاق(طول(ق) // 2 - 1, -1, -1):
    انزل(ق, ك)
  ارجع ق

ن = ابن_كومة([5, 3, 8, 1, 9, 2])
تأكد_يساوي(ن[0], 1, "الجذر الأصغر")
تأكد_يساوي(طول(ن), 6, "الطول")
لكل ك في نطاق(طول(ن)):
  لو 2 * ك + 1 < طول(ن):
    تأكد_يساوي(ن[ك] <= ن[2 * ك + 1], صواب, "خاصية الأب")
