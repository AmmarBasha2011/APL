# مثال 1340 — أطول مسار متزايد
# Longest increasing path in matrix
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1340-longest-increasing-path-matrix.apl

# نرتب الخلايا من الأصغر إلى الأكبر
# كل خلية تأخذ أفضل جار أصغر منها زائد واحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اطول_مسار(م):
  ر_ = طول(م)
  ك_ = طول(م[0])
  خلايا = []
  لكل ص في نطاق(ر_):
    لكل ج في نطاق(ك_):
      خلايا.ألحق([م[ص][ج], ص, ج])
  خلايا = مفرز(خلايا)
  بعد_ = []
  لكل ع في نطاق(ر_):
    بعد_.ألحق([1] * ك_)
  اقصى = 1
  لكل خلية في خلايا:
    ص = خلية[1]
    ج = خلية[2]
    لكل د في [[1,0],[-1,0],[0,1],[0,-1]]:
      ر = ص + د[0]
      ك = ج + د[1]
      لو (ر >= 0) و (ر < ر_) و (ك >= 0) و (ك < ك_):
        لو م[ر][ك] < م[ص][ج]:
          لو بعد_[ر][ك] + 1 > بعد_[ص][ج]:
            بعد_[ص][ج] = بعد_[ر][ك] + 1
    لو بعد_[ص][ج] > اقصى:
      اقصى = بعد_[ص][ج]
  ارجع اقصى

تأكد_يساوي(اطول_مسار([[9,9,4],[6,6,8],[2,1,1]]), 4, "أربعة")
تأكد_يساوي(اطول_مسار([[3,4,5],[3,2,6],[2,2,1]]), 4, "أربعة ثانية")
تأكد_يساوي(اطول_مسار([[1]]), 1, "خلية")
