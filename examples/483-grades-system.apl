# مثال 483 — نظام درجات مدرسي
# School grades system
# Demonstrates: طلاب ومواد ومعدلات
#
# Run:  python apl.py examples/483-grades-system.apl

المتغير طلاب = {
    "عمار": [90, 85, 95],
    "سارة": [88, 92, 79],
    "خالد": [70, 65, 80]
}

لكل اسم في طلاب.keys():
    المتغير درجات = طلاب[اسم]
    المتغير مجموع = 0
    لكل د في درجات:
        مجموع = مجموع + د
    المتغير معدل = مجموع / طول(درجات)
    المتغير تقدير = "ضعيف"
    لو معدل >= 90:
        تقدير = "ممتاز"
    الا لو معدل >= 75:
        تقدير = "جيد جدا"
    الا لو معدل >= 60:
        تقدير = "جيد"
    اطبع اسم, ":", معدل, "-", تقدير
