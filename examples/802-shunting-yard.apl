# مثال 802 — ساحة المناورة
# Shunting-yard
# Demonstrates: مكدس أولويات، RPN، أقواس
#
# Run:  python apl.py examples/802-shunting-yard.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# خوارزمية ساحة المناورة لدايكسترا: من infix إلى postfix ثم تقييم
# Demonstrates: مكدس عوامل بأولوية, أقواس, تقييم RPN بمكدس

دالة أولوية(ع):
  لو ع == "*" أو ع == "/":
    ارجع 2
  لو ع == "+" أو ع == "-":
    ارجع 1
  ارجع 0

دالة إلى_لاحق(رموز):
  ناتج = []
  مكدس = []
  لكل رمز في رموز:
    لو رمز == "(":
      مكدس.append(رمز)
    والا_لو رمز == ")":
      طالما مكدس[طول(مكدس) - 1] != "(":
        ناتج.append(مكدس.pop())
      مكدس.pop()
    والا_لو رمز == "+" أو رمز == "-" أو رمز == "*" أو رمز == "/":
      طالما طول(مكدس) > 0 و أولوية(مكدس[طول(مكدس) - 1]) >= أولوية(رمز):
        ناتج.append(مكدس.pop())
      مكدس.append(رمز)
    والا:
      ناتج.append(رمز)
  طالما طول(مكدس) > 0:
    ناتج.append(مكدس.pop())
  ارجع ناتج

دالة قيّم(لاحق):
  مكدس = []
  لكل رمز في لاحق:
    لو رمز == "+" أو رمز == "-" أو رمز == "*" أو رمز == "/":
      ب = مكدس.pop()
      أ = مكدس.pop()
      لو رمز == "+":
        مكدس.append(أ + ب)
      والا_لو رمز == "-":
        مكدس.append(أ - ب)
      والا_لو رمز == "*":
        مكدس.append(أ * ب)
      والا:
        مكدس.append(أ // ب)
    والا:
      مكدس.append(صحيح(رمز))
  ارجع مكدس[0]

تأكد_يساوي(إلى_لاحق("3 + 4 * 2 - ( 1 + 2 )".split(" ")), ["3", "4", "2", "*", "+", "1", "2", "+", "-"], "تحويل لاحق")
تأكد_يساوي(إلى_لاحق("2 * ( 3 + 4 )".split(" ")), ["2", "3", "4", "+", "*"], "أقواس")
تأكد_يساوي(قيّم(إلى_لاحق("3 + 4 * 2 - ( 1 + 2 )".split(" "))), 8, "تقييم الأول")
تأكد_يساوي(قيّم(إلى_لاحق("2 * ( 3 + 4 )".split(" "))), 14, "تقييم الثاني")
تأكد_يساوي(قيّم(إلى_لاحق("10 / 4 + 6 * 2".split(" "))), 14, "قسمة صحيحة")
