# مثال 2336 — عدد العناصر المساوية للأول
# Count equal to first
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2336-list-count-items-equal-to-first.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع ق.count(ق[0])

تأكد_يساوي(ف([1, 1, 2]), 2, "حالة 1")
تأكد_يساوي(ف([5]), 1, "حالة 2")
تأكد_يساوي(ف([3, 1, 3, 3]), 3, "حالة 3")
تأكد_يساوي(ف([7, 8, 9]), 1, "حالة 4")
