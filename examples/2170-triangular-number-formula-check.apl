# مثال 2170 — العدد المثلثي بالصيغة
# Triangular number by formula
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2170-triangular-number-formula-check.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * (ن + 1) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(4), 10, "حالة 4")
تأكد_يساوي(ف(10), 55, "حالة 10")
تأكد_يساوي(ف(100), 5050, "حالة 100")
