# مثال 1467 — جدول ترتيب الدوري
# League points table
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1467-league-points-table.apl

# نقرأ النتائج مباراة بمباراة
# ثم نرتب بالنقاط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جدول(مباريات):
  نقاط = {}
  لكل م في مباريات:
    أ = م[0]
    ب = م[1]
    نقاط[أ] = نقاط.get(أ, 0)
    نقاط[ب] = نقاط.get(ب, 0)
    لو م[2] > م[3]:
      نقاط[أ] = نقاط[أ] + 3
    والا_لو م[2] < م[3]:
      نقاط[ب] = نقاط[ب] + 3
    والا:
      نقاط[أ] = نقاط[أ] + 1
      نقاط[ب] = نقاط[ب] + 1
  ارجع نقاط

ن = جدول([["أ", "ب", 2, 1], ["ب", "ج", 0, 0], ["ج", "أ", 1, 3]])
تأكد_يساوي(ن["أ"], 6, "الفائز مرتين")
تأكد_يساوي(ن["ب"], 1, "تعادل")
تأكد_يساوي(ن["ج"], 1, "تعادل ثانٍ")
