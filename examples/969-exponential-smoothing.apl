# مثال 969 — التمهيد الأسي
# Exponential smoothing
# Demonstrates: وزن يتلاشى هندسياً
#
# Run:  python apl.py examples/969-exponential-smoothing.apl

# التمهيد الأسي: سلسلة زمنية ملساء بوزن يتلاشى هندسياً
# كل قيمة ممهدة مزيج من القراءة الجديدة والممهدة السابقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مهّد(قراءات, ألفا):
  ناتج = [قراءات[0]]
  لكل i في نطاق(1, طول(قراءات)):
    جديدة = (ألفا * قراءات[i]) + ((1 - ألفا) * ناتج[i - 1])
    ناتج.ألحق(جديدة)
  ارجع ناتج

ناتج = مهّد([10, 12, 13, 15, 14, 16], 0.5)
تأكد_يساوي(مقرب(ناتج[0], 4), 10, "البذرة الأولى")
تأكد_يساوي(مقرب(ناتج[1], 4), 11, "أول تمهيد")
تأكد_يساوي(مقرب(ناتج[3], 4), 13.5, "منتصف السلسلة")
تأكد_يساوي(مقرب(ناتج[5], 4), 14.875, "آخر السلسلة")
تأكد_يساوي(طول(ناتج), 6, "طول الناتج")
