# مثال 4365 — تحويل وحدة بأساس 45
# Split by base 45
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4365-minutes-to-hours-and-minutes-base-45.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 45, ن % 45]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 14], "حالة 2")
تأكد_يساوي(ف(60), [1, 15], "حالة 3")
تأكد_يساوي(ف(125), [2, 35], "حالة 4")
تأكد_يساوي(ف(1000), [22, 10], "حالة 5")
