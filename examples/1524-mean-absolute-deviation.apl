# مثال 1524 — متوسط الانحراف المطلق
# Mean absolute deviation
# Demonstrates: إحصاء
#
# Run:  python apl.py examples/1524-mean-absolute-deviation.apl

# الفرق المطلق لا يحتاج جذراً
# نجمعها ونقسم على العدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة انحراف_مطلق(أ):
  مجموع = 0
  لكل ع في أ:
    مجموع = مجموع + ع
  متوسط = مجموع / طول(أ)
  كل = 0
  لكل ع في أ:
    ف = ع - متوسط
    لو ف < 0:
      ف = -ف
    كل = كل + ف
  ارجع كل / طول(أ)

تأكد_يساوي(انحراف_مطلق([1, 2, 3, 4, 5]), 1.2, "خمسة")
تأكد_يساوي(انحراف_مطلق([6, 6]), 0.0, "متساويان")
