# مثال 1086 — مربع كامل
# Valid perfect square
# Demonstrates: بحث ثنائي
#
# Run:  python apl.py examples/1086-valid-perfect-square.apl

# نبحث عن جذر صحيح بين 1 والعدد
# لو وجدنا ج×ج يساوي العدد فهو مربع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مربع_كامل(ن):
  ي = 1
  ل = ن
  طالما ي <= ل:
    وسط = (ي + ل) // 2
    لو (وسط * وسط) == ن:
      ارجع صواب
    لو (وسط * وسط) < ن:
      ي = وسط + 1
    والا:
      ل = وسط - 1
  ارجع خطأ

تأكد_يساوي(مربع_كامل(16), صواب, "16")
تأكد_يساوي(مربع_كامل(14), خطأ, "14")
تأكد_يساوي(مربع_كامل(1), صواب, "1")
تأكد_يساوي(مربع_كامل(808201), صواب, "899 تربيع")
تأكد_يساوي(مربع_كامل(2147483647), خطأ, "أكبر عدد 32 بت")
