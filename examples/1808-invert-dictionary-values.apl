# مثال 1808 — عكس القاموس
# Invert a dictionary
# Demonstrates: قواميس
#
# Run:  python apl.py examples/1808-invert-dictionary-values.apl

# كل قيمة تجمع مفاتيحها
# نرتب القوائم للمقارنة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اعكس(ق):
  ناتج = {}
  لكل ك في ق:
    م = نص(ق[ك])
    لو (م في ناتج) == خطأ:
      ناتج[م] = []
    ناتج[م].append(ك)
  لكل م في ناتج:
    ناتج[م].sort()
  ارجع ناتج

ن = اعكس({"a": 1, "b": 2, "c": 1})
تأكد_يساوي(ن["1"], ["a", "c"], "قيمة مشتركة")
تأكد_يساوي(ن["2"], ["b"], "قيمة وحيدة")
