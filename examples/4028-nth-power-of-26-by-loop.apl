# مثال 4028 — قوة 26 بالحلقة
# Power of 26 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4028-nth-power-of-26-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 26
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 26, "حالة 2")
تأكد_يساوي(ف(3), 17576, "حالة 3")
تأكد_يساوي(ف(6), 308915776, "حالة 4")
تأكد_يساوي(ف(10), 141167095653376, "حالة 5")
