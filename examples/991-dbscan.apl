# مثال 991 — تجميع كثافي
# DBSCAN clustering
# Demonstrates: توسيع بذور الجوار
#
# Run:  python apl.py examples/991-dbscan.apl

# تجميع كثافي DBSCAN: عنقود حيث تتقارب النقاط وضجيج حيث تنفرد
# لا يحتاج عدد العناقيد مسبقاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

نقاط = [[0, 0], [0, 1], [1, 0], [10, 10], [10, 11], [11, 10], [50, 50]]
ن = 7
أبسيلون2 = 2.25
أدنى = 2

دالة جيران(i):
  ناتج = []
  لكل j في نطاق(ن):
    ف_س = نقاط[j][0] - نقاط[i][0]
    ف_ص = نقاط[j][1] - نقاط[i][1]
    لو ((ف_س * ف_س) + (ف_ص * ف_ص)) <= أبسيلون2:
      ناتج.ألحق(j)
  ارجع ناتج

وسوم = [-2, -2, -2, -2, -2, -2, -2]
عنقود = 0
لكل i في نطاق(ن):
  لو وسوم[i] == -2:
    جوار = جيران(i)
    لو طول(جوار) < أدنى:
      وسوم[i] = -1
    والا:
      وسوم[i] = عنقود
      بذور = []
      لكل j في جوار:
        لو j != i:
          بذور.ألحق(j)
      رأس = 0
      طالما رأس < طول(بذور):
        j = بذور[رأس]
        رأس = رأس + 1
        لو وسوم[j] == -1:
          وسوم[j] = عنقود
        لو وسوم[j] == -2:
          وسوم[j] = عنقود
          جوار2 = جيران(j)
          لو طول(جوار2) >= أدنى:
            لكل ك في جوار2:
              لو وسوم[ك] == -2:
                بذور.ألحق(ك)
      عنقود = عنقود + 1

تأكد_يساوي(عنقود, 2, "عنقودان")
تأكد_يساوي(وسوم[0], 0, "أول نقطة بالعنقود الأول")
تأكد_يساوي(وسوم[3], 1, "رابع نقطة بالعنقود الثاني")
تأكد_يساوي(وسوم[6], -1, "البعيدة ضجيج")
