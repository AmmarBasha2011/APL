# مثال 2701 — ضرب كل عنصر في 15
# Multiply each item by 15
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2701-list-multiply-each-by-15.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 15]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [45, 15, 30], "حالة 1")
تأكد_يساوي(ف([5]), [75], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [15, 30, 45, 60, 75, 90], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-30, 0, 105, 105, 60], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [150, 300, 150, 450, 300, 150], "حالة 5")
