# مثال 333 — رقم اليوم في السنة
# Day of year
# Demonstrates: فرق عن أول السنة
#
# Run:  python apl.py examples/333-day-of-year.apl

المتغير اليوم = التاريخ_اليوم()
المتغير أول_السنة = تاريخ(اليوم.year, 1, 1)
المتغير رقم = (اليوم - أول_السنة).days + 1
اطبع "اليوم رقم", رقم, "في السنة"

المتغير آخر_السنة = تاريخ(اليوم.year, 12, 31)
المتغير باقي = (آخر_السنة - اليوم).days
اطبع "وباقي على نهايتها:", باقي, "يوما"
