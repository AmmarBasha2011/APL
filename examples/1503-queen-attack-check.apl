# مثال 1503 — هجوم الوزير في الشطرنج
# Queen attack check
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1503-queen-attack-check.apl

# الهجوم على نفس الصف أو العمود
# أو على القطر حيث فرقا الصف والعمود متساويان

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يهاجم(وزير, هدف):
  فرق_ص = وزير[0] - هدف[0]
  فرق_ع = وزير[1] - هدف[1]
  لو فرق_ص < 0:
    فرق_ص = -فرق_ص
  لو فرق_ع < 0:
    فرق_ع = -فرق_ع
  لو فرق_ص == 0 و فرق_ع == 0:
    ارجع خطأ
  ارجع فرق_ص == 0 أو فرق_ع == 0 أو فرق_ص == فرق_ع

تأكد_يساوي(يهاجم([0, 0], [0, 5]), صواب, "صف")
تأكد_يساوي(يهاجم([2, 2], [5, 5]), صواب, "قطر")
تأكد_يساوي(يهاجم([0, 0], [1, 2]), خطأ, "حركة حصان")
تأكد_يساوي(يهاجم([3, 3], [3, 3]), خطأ, "نفس الخانة")
