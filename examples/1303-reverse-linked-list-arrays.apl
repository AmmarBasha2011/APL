# مثال 1303 — عكس قائمة مترابطة
# Reverse linked list with next array
# Demonstrates: مؤشرات
#
# Run:  python apl.py examples/1303-reverse-linked-list-arrays.apl

# نعكس اتجاه كل وصلة
# ونتتبع السابق والحالي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اعكس_وصلات(تالي, رأس):
  سابق = -1
  حالي = رأس
  جديد = قائمة(تالي)
  طالما حالي != -1:
    ت = تالي[حالي]
    جديد[حالي] = سابق
    سابق = حالي
    حالي = ت
  ارجع [جديد, سابق]

دالة امش(تالي, رأس):
  ناتج = []
  طالما رأس != -1:
    ناتج.ألحق(رأس)
    رأس = تالي[رأس]
  ارجع ناتج

تالي = [1, 2, 3, -1]
نتيجة = اعكس_وصلات(تالي, 0)
تأكد_يساوي(امش(تالي, 0), [0, 1, 2, 3], "الأصل")
تأكد_يساوي(امش(نتيجة[0], نتيجة[1]), [3, 2, 1, 0], "المعكوس")
