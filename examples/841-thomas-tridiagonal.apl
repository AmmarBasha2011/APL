# مثال 841 — خوارزمية توماس
# Thomas algorithm
# Demonstrates: مسح أمامي وخلفي
#
# Run:  python apl.py examples/841-thomas-tridiagonal.apl

# خوارزمية توماس: حل أنظمة ثلاثية القطر في زمن خطي O(n)
# حالة خاصة من الحذف الجاوسي للمصفوفات النطاقية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحت القطر: أ[1..ن-1]، القطر: ب، فوق القطر: ج[0..ن-2]، الطرف: د
دالة توماس(أ, ب, ج, د):
  ن = طول(ب)
  جـ = []
  دـ = []
  جـ.ألحق(ج[0] / ب[0])
  دـ.ألحق(د[0] / ب[0])
  لكل i في نطاق(1, ن):
    مقام = ب[i] - أ[i] * جـ[i - 1]
    لو i < ن - 1:
      جـ.ألحق(ج[i] / مقام)
    دـ.ألحق((د[i] - أ[i] * دـ[i - 1]) / مقام)
  حل = []
  لكل _ في نطاق(ن):
    حل.ألحق(0.0)
  حل[ن - 1] = دـ[ن - 1]
  لكل i في نطاق(1, ن):
    ت = ن - 1 - i
    حل[ت] = دـ[ت] - جـ[ت] * حل[ت + 1]
  ارجع حل

# النظام: 2x+ y=4 ، x+2y+ z=4 ، y+2z=4  =>  x=2 ، y=0 ، z=2
حل = توماس(
  [0.0, 1.0, 1.0],
  [2.0, 2.0, 2.0],
  [1.0, 1.0, 0.0],
  [4.0, 4.0, 4.0]
)
اطبع "الحل =", حل

تأكد_يساوي(مقرب(حل[0], 9), 2.0, "س = 2")
تأكد_يساوي(مقرب(حل[1], 9), 0.0, "ص = 0")
تأكد_يساوي(مقرب(حل[2], 9), 2.0, "ع = 2")

# تحقق بالتعويض المباشر في المعادلات الثلاث
تحقق1 = 2.0*حل[0] + 1.0*حل[1]
تحقق2 = 1.0*حل[0] + 2.0*حل[1] + 1.0*حل[2]
تحقق3 = 1.0*حل[1] + 2.0*حل[2]
تأكد_يساوي(مقرب(تحقق1, 9), 4.0, "المعادلة الأولى")
تأكد_يساوي(مقرب(تحقق2, 9), 4.0, "المعادلة الثانية")
تأكد_يساوي(مقرب(تحقق3, 9), 4.0, "المعادلة الثالثة")
