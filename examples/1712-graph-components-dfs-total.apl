# مثال 1712 — عدد المكونات المتصلة
# Count connected components
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1712-graph-components-dfs-total.apl

# نبدأ بحثاً جديداً لكل مكون
# نعد مرات البدء

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عد_المكونات(ن, حواف):
  جيران = []
  لكل ك في نطاق(ن):
    جيران.append([])
  لكل ح في حواف:
    جيران[ح[0]].append(ح[1])
    جيران[ح[1]].append(ح[0])
  زار = []
  لكل ك في نطاق(ن):
    زار.append(خطأ)
  عد = 0
  لكل بداية في نطاق(ن):
    لو زار[بداية] == خطأ:
      عد = عد + 1
      زار[بداية] = صواب
      مكدس = [بداية]
      طالما طول(مكدس) > 0:
        ع = مكدس.pop()
        لكل ج في جيران[ع]:
          لو زار[ج] == خطأ:
            زار[ج] = صواب
            مكدس.append(ج)
  ارجع عد

تأكد_يساوي(عد_المكونات(5, [[0, 1], [1, 2], [3, 4]]), 2, "اثنان")
تأكد_يساوي(عد_المكونات(3, []), 3, "منفصلة")
تأكد_يساوي(عد_المكونات(4, [[0, 1], [1, 2], [2, 3]]), 1, "سلسلة")
