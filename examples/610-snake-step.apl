# مثال 610 — خطوة الثعبان
# Snake game step
# Demonstrates: ثعبان، نمو، اصطدام
#
# Run:  python apl.py examples/610-snake-step.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# لعبة الثعبان: خطوة حركة ونمو واصطدام
# Demonstrates: جسم كقائمة مواضع, طعام ونمو, كشف الاصطدام بالجدران والذات
# منطق لعبة كامل دون رسوميات

عرض = 6
ارتفاع_الشبكة = 6
جسم = [[2, 2], [2, 1], [2, 0]]
اتجاه = [0, 1]
طعام = [2, 4]

دالة خطوة(جسم, اتجاه, طعام):
  رأس = جسم[0]
  جديد = [رأس[0] + اتجاه[0], رأس[1] + اتجاه[1]]
  لو جديد[0] < 0 أو جديد[0] >= ارتفاع_الشبكة أو جديد[1] < 0 أو جديد[1] >= عرض:
    ارجع "جدار"
  لو جديد في جسم و جديد != طعام:
    ارجع "ذات"
  جسم.insert(0, جديد)
  لو جديد == طعام:
    ارجع "أكل"
  جسم.pop()
  ارجع "تحرك"

تأكد_يساوي(خطوة(جسم, اتجاه, طعام), "تحرك", "خطوة عادية")
تأكد_يساوي(طول(جسم), 3, "الطول ثابت دون أكل")
تأكد_يساوي(خطوة(جسم, اتجاه, طعام), "أكل", "أكل الطعام")
تأكد_يساوي(طول(جسم), 4, "نمو بعد الأكل")
جسم2 = [[0, 0]]
تأكد_يساوي(خطوة(جسم2, [-1, 0], [5, 5]), "جدار", "اصطدام بالجدار")
اطبع "طول الثعبان الآن:", طول(جسم)
