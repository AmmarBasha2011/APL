# مثال 512 — خوارزمية ديكسترا لأقصر مسار
# Dijkstra shortest path
# Demonstrates: أقصر مسار، رسم بياني موزون، اختيار الحد الأدنى
#
# Run:  python apl.py examples/512-dijkstra.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# أقصر مسار بخوارزمية ديكسترا (رسم موزون)
المتغير ج = قاموس()
ج["أ"] = {"ب": 4, "ج": 2}
ج["ب"] = {"ج": 1, "د": 5}
ج["ج"] = {"د": 8, "هـ": 10}
ج["د"] = {"هـ": 2}
ج["هـ"] = قاموس()

المتغير مسافات = قاموس()
لكل عقدة في ج:
    مسافات[عقدة] = 999999
مسافات["أ"] = 0
المتغير مزارة = قائمة()

طالما طول(مزارة) < طول(ج):
    المتغير أقرب = ""
    المتغير أقل = 999999
    لكل عقدة في ج:
        لو عقدة ليس في مزارة و مسافات[عقدة] < أقل:
            أقل = مسافات[عقدة]
            أقرب = عقدة
    لو أقرب == "":
        توقف
    مزارة.أضف(أقرب)
    لكل جار في ج[أقرب]:
        المتغير بديل = مسافات[أقرب] + ج[أقرب][جار]
        لو بديل < مسافات[جار]:
            مسافات[جار] = بديل

اطبع "المسافات من أ:", مسافات
تأكد_يساوي(مسافات["هـ"], 11, "ديكسترا: أ إلى هـ")
تأكد_يساوي(مسافات["د"], 9, "ديكسترا: أ إلى د")
