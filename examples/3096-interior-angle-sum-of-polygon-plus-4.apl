# مثال 3096 — مجموع زوايا مضلع زائد 4
# Polygon angle sum plus 4
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3096-interior-angle-sum-of-polygon-plus-4.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 4

تأكد_يساوي(ف(3), 184, "حالة 1")
تأكد_يساوي(ف(4), 364, "حالة 2")
تأكد_يساوي(ف(5), 544, "حالة 3")
تأكد_يساوي(ف(6), 724, "حالة 4")
تأكد_يساوي(ف(12), 1804, "حالة 5")
