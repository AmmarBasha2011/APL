# مثال 347 — مولد أسماء نسخ احتياطية
# Backup name generator
# Demonstrates: ترقيم النسخ
#
# Run:  python apl.py examples/347-backup-names.apl

دالة اسم_نسخة(جذر_الاسم, رقم):
    ارجع جذر_الاسم + ".bak" + نص(رقم)

دالة أحدث_رقم(أسماء, جذر_الاسم):
    المتغير أعلى = 0
    لكل اسم in أسماء:
        لو اسم.بداية(جذر_الاسم + ".bak"):
            المتغير رقم = صحيح(اسم[طول(جذر_الاسم) + 4:])
            لو رقم > أعلى:
                أعلى = رقم
    ارجع أعلى

المتغير موجودة = ["data.bak1", "data.bak2", "data.bak3", "other.bak1"]
المتغير تالي = أحدث_رقم(موجودة, "data") + 1
اطبع "النسخة التالية:", اسم_نسخة("data", تالي)
