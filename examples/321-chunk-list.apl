# مثال 321 — تقسيم قائمة إلى قطع
# Chunk a list
# Demonstrates: تقطيع بحجم ثابت
#
# Run:  python apl.py examples/321-chunk-list.apl

دالة قطع(قائمة, حجم_القطعة):
    المتغير نتيجة = []
    المتغير ي = 0
    طالما ي < طول(قائمة):
        نتيجة.أضف(قائمة[ي:ي + حجم_القطعة])
        ي = ي + حجم_القطعة
    ارجع نتيجة

اطبع قطع([1, 2, 3, 4, 5, 6, 7], 3)
اطبع قطع(["أ", "ب", "ج", "د"], 2)
