# مثال 3117 — صف جدول ضرب 12
# Multiplication row of 12
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3117-multiplication-table-row-of-12.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 12]
  ارجع ر

تأكد_يساوي(ف(1), [12], "حالة 1")
تأكد_يساوي(ف(5), [12, 24, 36, 48, 60], "حالة 2")
تأكد_يساوي(ف(10), [12, 24, 36, 48, 60, 72, 84, 96, 108, 120], "حالة 3")
