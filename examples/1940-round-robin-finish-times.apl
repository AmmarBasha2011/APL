# مثال 1940 — أزمنة انتهاء الدور الدائري
# Round robin scheduler finish times
# Demonstrates: جدولة
#
# Run:  python apl.py examples/1940-round-robin-finish-times.apl

# نأخذ العملية الأولى من الطابور
# إن بقي لها عمل تعود للآخر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة دوري(ازمنة, حصة):
  باقي = ازمنة + []
  طابور = []
  نهاية = []
  لكل ك في نطاق(طول(ازمنة)):
    طابور = طابور + [ك]
    نهاية = نهاية + [0]
  ساعة = 0
  طالما طول(طابور) > 0:
    ك = طابور.pop(0)
    خذ = أصغر(حصة, باقي[ك])
    ساعة = ساعة + خذ
    باقي[ك] = باقي[ك] - خذ
    لو باقي[ك] > 0:
      طابور = طابور + [ك]
    والا:
      نهاية[ك] = ساعة
  ارجع نهاية

تأكد_يساوي(دوري([5, 3, 2], 2), [10, 9, 6], "ثلاث عمليات")
تأكد_يساوي(دوري([4], 3), [4], "عملية واحدة")
