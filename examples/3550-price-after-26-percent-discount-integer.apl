# مثال 3550 — السعر بعد خصم 26 بالمئة
# Price after 26 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3550-price-after-26-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 26 // 100

تأكد_يساوي(ف(100), 74, "حالة 1")
تأكد_يساوي(ف(250), 185, "حالة 2")
تأكد_يساوي(ف(999), 740, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
