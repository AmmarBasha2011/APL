# مثال 202 — ترتيب الاختيار
# Selection sort
# Demonstrates: إيجاد الأصغر في كل جولة
#
# Run:  python apl.py examples/202-selection-sort.apl

دالة اختيار(قائمة):
    لكل ي في نطاق(طول(قائمة)):
        المتغير أصغر = ي
        لكل ز في نطاق(ي + 1, طول(قائمة)):
            لو قائمة[ز] < قائمة[أصغر]:
                أصغر = ز
        المتغير مؤقت = قائمة[ي]
        قائمة[ي] = قائمة[أصغر]
        قائمة[أصغر] = مؤقت
    ارجع قائمة

المتغير أرقام = [64, 25, 12, 22, 11]
اطبع "قبل:", أرقام
اطبع "بعد:", اختيار(أرقام)
