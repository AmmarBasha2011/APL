# مثال 706 — توحيد برولوج
# Prolog unification
# Demonstrates: متغيرات، ربط، حدود مركبة
#
# Run:  python apl.py examples/706-prolog-unify-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# توحيد برولوج مصغر على الحدود
# Demonstrates: متغيرات, ربط, فحص occurrence مبسط
# الحد: ["ثابت", قيمة] أو ["متغير", اسم] أو ["مركب", رمز, وسائط]

دالة ثابت(ق):
  ارجع ["ثابت", ق]

دالة متغير(اسم):
  ارجع ["متغير", اسم]

دالة مركب(رمز, وسائط):
  ارجع ["مركب", رمز, وسائط]

دالة طبق(حد, ربط):
  لو حد[0] == "متغير":
    بديل = ربط.get(حد[1], لا_شيء)
    لو بديل != لا_شيء:
      ارجع طبق(بديل, ربط)
  ارجع حد

دالة وحد(أ, ب, ربط):
  أ2 = طبق(أ, ربط)
  ب2 = طبق(ب, ربط)
  لو أ2[0] == "متغير":
    ربط[أ2[1]] = ب2
    ارجع ربط
  لو ب2[0] == "متغير":
    ربط[ب2[1]] = أ2
    ارجع ربط
  لو أ2[0] != ب2[0]:
    ارجع لا_شيء
  لو أ2[0] == "ثابت":
    لو أ2[1] == ب2[1]:
      ارجع ربط
    ارجع لا_شيء
  لو أ2[1] != ب2[1] أو طول(أ2[2]) != طول(ب2[2]):
    ارجع لا_شيء
  لكل ي في نطاق(طول(أ2[2])):
    ربط = وحد(أ2[2][ي], ب2[2][ي], ربط)
    لو ربط == لا_شيء:
      ارجع لا_شيء
  ارجع ربط

# f(X, b) مع f(a, Y)
ر = وحد(مركب("f", [متغير("X"), ثابت("b")]), مركب("f", [ثابت("a"), متغير("Y")]), {})
تأكد_يساوي(ر["X"], ["ثابت", "a"], "X تربط بأ")
تأكد_يساوي(ر["Y"], ["ثابت", "b"], "Y تربط بب")
# f(X, X) مع f(a, b) يفشل
ر2 = وحد(مركب("f", [متغير("X"), متغير("X")]), مركب("f", [ثابت("a"), ثابت("b")]), {})
تأكد_يساوي(ر2, لا_شيء, "توحيد متناقض يفشل")
# g(X, X) مع g(a, a) ينجح
ر3 = وحد(مركب("g", [متغير("X"), متغير("X")]), مركب("g", [ثابت("a"), ثابت("a")]), {})
تأكد_يساوي(ر3["X"], ["ثابت", "a"], "توحيد متسق ينجح")
# رموز مختلفة تفشل
تأكد_يساوي(وحد(مركب("f", []), مركب("g", []), {}), لا_شيء, "رموز مختلفة")
# متغير مع متغير
ر4 = وحد(متغير("X"), متغير("Y"), {})
تأكد_يساوي(ر4["X"], ["متغير", "Y"], "متغير يربط بمتغير")
اطبع "ربط أول:", ر
