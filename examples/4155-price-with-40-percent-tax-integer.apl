# مثال 4155 — السعر مع ضريبة 40 بالمئة
# Price with 40 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4155-price-with-40-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 40 // 100

تأكد_يساوي(ف(100), 140, "حالة 1")
تأكد_يساوي(ف(250), 350, "حالة 2")
تأكد_يساوي(ف(999), 1398, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
