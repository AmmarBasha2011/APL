# مثال 2942 — أكبر 1 عناصر مرتبة
# Top 1 largest items
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2942-top-1-largest-items-sorted-desc.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = sorted(ق)
  ر.reverse()
  ارجع ر[:1]

تأكد_يساوي(ف([3, 1, 2]), [3], "حالة 1")
تأكد_يساوي(ف([5]), [5], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [6], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [7], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [30], "حالة 5")
