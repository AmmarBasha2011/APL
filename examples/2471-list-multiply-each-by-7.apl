# مثال 2471 — ضرب كل عنصر في 7
# Multiply each item by 7
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2471-list-multiply-each-by-7.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 7]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [21, 7, 14], "حالة 1")
تأكد_يساوي(ف([5]), [35], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [7, 14, 21, 28, 35, 42], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-14, 0, 49, 49, 28], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [70, 140, 70, 210, 140, 70], "حالة 5")
