# مثال 1914 — عدد المسارات الهاميلتونية بالبتات
# Count Hamiltonian paths with bit masks
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1914-bit-dp-count-hamiltonian-paths.apl

# حالة = قناع وآخر عقدة
# نمدد المسار بعقدة غير مزارة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مسارات(ن, حواف):
  كل = (1 << ن) - 1
  جدول = []
  لكل م في نطاق(كل + 1):
    صف = []
    لكل ع في نطاق(ن):
      صف = صف + [0]
    جدول = جدول + [صف]
  لكل ع في نطاق(ن):
    جدول[1 << ع][ع] = 1
  لكل م في نطاق(كل + 1):
    لكل ع في نطاق(ن):
      لو جدول[م][ع] > 0:
        لكل ت في نطاق(ن):
          لو (م & (1 << ت)) == 0 و حواف[ع][ت] == 1:
            جدول[م | (1 << ت)][ت] = جدول[م | (1 << ت)][ت] + جدول[م][ع]
  كلي = 0
  لكل ع في نطاق(ن):
    كلي = كلي + جدول[كل][ع]
  ارجع كلي

مثلث = [[0, 1, 1], [1, 0, 1], [1, 1, 0]]
خط = [[0, 1, 0], [1, 0, 1], [0, 1, 0]]
تأكد_يساوي(مسارات(3, مثلث), 6, "مثلث")
تأكد_يساوي(مسارات(3, خط), 2, "خط")
