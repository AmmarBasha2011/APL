# مثال 382 — استخراج الأرقام والعمليات
# Extract numbers
# Demonstrates: بحث_شامل وجمع
#
# Run:  python apl.py examples/382-extract-numbers.apl

المتغير نص = "اشترى 3 تفاحات بـ 15 جنيه و 2 كيلو أرز بـ 60 جنيه"
المتغير أرقام = بحث_شامل("[0-9]+", نص)
اطبع "الأرقام:", أرقام

المتغير مجموع = 0
لكل ر in أرقام:
    مجموع = مجموع + صحيح(ر)
اطبع "مجموعها:", مجموع
