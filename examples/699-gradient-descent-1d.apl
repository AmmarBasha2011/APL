# مثال 699 — النزول التدرجي الأحادي
# 1D gradient descent
# Demonstrates: مشتقة، معدل تعلم، تذبذب
#
# Run:  python apl.py examples/699-gradient-descent-1d.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# النزول التدرجي أحادي البعد
# Demonstrates: مشتقة, معدل تعلم, تقارب أسي
# الهدف: أصغر قيمة لـ (س-3)^2 + 1 عند س=3

دالة هدف(س):
  فرق = س - 3.0
  ارجع فرق * فرق + 1.0

دالة مشتقة(س):
  ارجع 2.0 * (س - 3.0)

دالة انزل(بداية, معدل, خطوات):
  س = بداية
  لكل ي في نطاق(خطوات):
    س = س - معدل * مشتقة(س)
  ارجع س

تأكد_يساوي(مقرب(انزل(0.0, 0.1, 60), 3), 3.0, "يتقارب إلى 3")
تأكد_يساوي(مقرب(هدف(انزل(0.0, 0.1, 60)), 3), 1.0, "القيمة الدنيا 1")
تأكد_يساوي(مشتقة(5.0), 4.0, "مشتقة عند 5")
تأكد_يساوي(مشتقة(3.0), 0.0, "مشتقة عند الحل صفر")
قفزة = انزل(0.0, 1.0, 3)
تأكد_يساوي(مقرب(قفزة, 4), 6.0, "خطوة كبيرة تتذبذب")
بطيء = انزل(0.0, 0.01, 10)
تأكد_يساوي(بطيء < 1.0, صواب, "معدل صغير يزحف")
اطبع "الحل:", انزل(0.0, 0.1, 60)
