# مثال 2151 — حساب بنكي بلا سحب على المكشوف
# Bank account class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2151-bank-account-class-no-overdraft.apl

# # الإيداع يزيد الرصيد
# # والسحب يرجع نجاحا أو فشلا

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف حساب:
    دالة_إنشاء(ذات, رصيد):
        ذات.رصيد = رصيد

    دالة ايداع(ذات, مبلغ):
        ذات.رصيد = ذات.رصيد + مبلغ

    دالة سحب(ذات, مبلغ):
        لو مبلغ > ذات.رصيد:
            ارجع خطأ
        ذات.رصيد = ذات.رصيد - مبلغ
        ارجع صواب

ح = حساب(100)
تأكد_يساوي(ح.سحب(30), صواب, "سحب ناجح")
تأكد_يساوي(ح.رصيد, 70, "الرصيد")
تأكد_يساوي(ح.سحب(100), خطأ, "سحب فاشل")
ح.ايداع(50)
تأكد_يساوي(ح.رصيد, 120, "بعد الإيداع")
