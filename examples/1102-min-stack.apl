# مثال 1102 — مكدس بأدنى قيمة
# Min stack
# Demonstrates: مكدس مساعد
#
# Run:  python apl.py examples/1102-min-stack.apl

# مكدس ثان يحفظ الأدنى عند كل مستوى
# فيبقى الأدنى متاحاً بعد كل دفع وسحب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مكدس_ادنى:
    دالة_إنشاء(ذات):
        ذات.عناصر = []
        ذات.ادنيات = []

    دالة ادفع(ذات, س):
        ذات.عناصر.ألحق(س)
        لو (طول(ذات.ادنيات) == 0) أو (س <= ذات.ادنيات[-1]):
            ذات.ادنيات.ألحق(س)

    دالة اسحب(ذات):
        س = ذات.عناصر.pop()
        لو س == ذات.ادنيات[-1]:
            ذات.ادنيات.pop()
        ارجع س

    دالة قمة(ذات):
        ارجع ذات.عناصر[-1]

    دالة ادنى(ذات):
        ارجع ذات.ادنيات[-1]

م = مكدس_ادنى()
م.ادفع(-2)
م.ادفع(0)
م.ادفع(-3)
تأكد_يساوي(م.ادنى(), -3, "الأدنى بعد ثلاثة دفعات")
م.اسحب()
تأكد_يساوي(م.قمة(), 0, "القمة بعد السحب")
تأكد_يساوي(م.ادنى(), -2, "الأدنى بعد السحب")
م.ادفع(-2)
م.اسحب()
تأكد_يساوي(م.ادنى(), -2, "الأدنى مع تكرار")
