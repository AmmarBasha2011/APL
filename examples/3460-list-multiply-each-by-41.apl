# مثال 3460 — ضرب كل عنصر في 41
# Multiply each item by 41
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3460-list-multiply-each-by-41.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 41]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [123, 41, 82], "حالة 1")
تأكد_يساوي(ف([5]), [205], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [41, 82, 123, 164, 205, 246], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-82, 0, 287, 287, 164], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [410, 820, 410, 1230, 820, 410], "حالة 5")
