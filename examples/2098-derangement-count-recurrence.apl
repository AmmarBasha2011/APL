# مثال 2098 — عدد الاضطرابات
# Derangements count
# Demonstrates: توافيق
#
# Run:  python apl.py examples/2098-derangement-count-recurrence.apl

# # D(n) = (n-1)(D(n-1)+D(n-2))
# # نحسب بالتتابع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اضطراب(ن):
  لو ن == 0:
    ارجع 1
  ا = 1
  ب = 0
  لكل ك في نطاق(2, ن + 1):
    ج = (ك - 1) * (ا + ب)
    ا = ب
    ب = ج
  ارجع ب

تأكد_يساوي(اضطراب(0), 1, "٠")
تأكد_يساوي(اضطراب(1), 0, "١")
تأكد_يساوي(اضطراب(4), 9, "٤")
تأكد_يساوي(اضطراب(6), 265, "٦")
