# مثال 479 — محاكي جدار ناري
# Firewall simulator
# Demonstrates: قواعد سماح ومنع
#
# Run:  python apl.py examples/479-firewall-sim.apl

المتغير ممنوعة = ["10.0.0.5", "192.168.1.99"]
المتغير منافذ_مفتوحة = [80, 443]

دالة افحص(عنوان, منفذ):
    لو ممنوعة.count(عنوان) > 0:
        ارجع "محظور: عنوان ممنوع"
    لو منافذ_مفتوحة.count(منفذ) == 0:
        ارجع "محظور: منفذ مغلق"
    ارجع "مسموح"

اطبع افحص("10.0.0.5", 80)
اطبع افحص("8.8.8.8", 22)
اطبع افحص("8.8.8.8", 443)
