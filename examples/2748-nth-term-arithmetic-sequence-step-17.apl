# مثال 2748 — الحد النوني بخطوة 17
# Nth term step 17
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2748-nth-term-arithmetic-sequence-step-17.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 17

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 20, "حالة 2")
تأكد_يساوي(ف(10), 156, "حالة 3")
تأكد_يساوي(ف(100), 1686, "حالة 4")
