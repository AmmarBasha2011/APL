# مثال 325 — النافذة المنزلقة
# Sliding window sums
# Demonstrates: مجموع كل نافذة بحجم ك
#
# Run:  python apl.py examples/325-sliding-window.apl

دالة نوافذ_مجاميع(قائمة, ك):
    المتغير نتيجة = []
    لكل ي في نطاق(طول(قائمة) - ك + 1):
        المتغير مجموع = 0
        لكل ز في نطاق(ي, ي + ك):
            مجموع = مجموع + قائمة[ز]
        نتيجة.أضف(مجموع)
    ارجع نتيجة

اطبع نوافذ_مجاميع([1, 2, 3, 4, 5], 3)
اطبع نوافذ_مجاميع([10, 20, 30, 40], 2)
