# مثال 862 — أعداد بيل
# Pell numbers
# Demonstrates: P(n)=2P(n-1)+P(n-2)
#
# Run:  python apl.py examples/862-pell-numbers.apl

# أعداد بيل: P(n) = 2*P(n-1) + P(n-2) تبدأ 0, 1
# نسبها المتتالية تقارب الجذر التربيعي لاثنين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بيل(ن):
  أ = 0
  ب = 1
  لكل _ في نطاق(ن):
    جديد = 2 * ب + أ
    أ = ب
    ب = جديد
  ارجع أ

اطبع "P0..P10:", [بيل(0), بيل(1), بيل(2), بيل(3), بيل(4), بيل(5), بيل(6), بيل(7), بيل(8), بيل(9), بيل(10)]

تأكد_يساوي(بيل(0), 0, "P0 = 0")
تأكد_يساوي(بيل(3), 5, "P3 = 5")
تأكد_يساوي(بيل(6), 70, "P6 = 70")
تأكد_يساوي(بيل(10), 2378, "P10 = 2378")

# P(n)/P(n-1) تقارب 1 + جذر(2) = النسبة الفضية
نسبة = بيل(10) / بيل(9)
فضية = 1 + جذر(2.0)
تأكد_يساوي(مقرب(نسبة, 4), مقرب(فضية, 4), "النسبة تقارب النسبة الفضية")
