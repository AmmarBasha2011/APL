# مثال 2823 — تحويل وحدة بأساس 9
# Split by base 9
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2823-minutes-to-hours-and-minutes-base-9.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 9, ن % 9]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [6, 5], "حالة 2")
تأكد_يساوي(ف(60), [6, 6], "حالة 3")
تأكد_يساوي(ف(125), [13, 8], "حالة 4")
تأكد_يساوي(ف(1000), [111, 1], "حالة 5")
