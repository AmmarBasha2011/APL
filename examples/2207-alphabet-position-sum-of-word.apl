# مثال 2207 — مجموع مواضع الحروف
# Alphabet position sum
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2207-alphabet-position-sum-of-word.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) - 96
  ارجع م

تأكد_يساوي(ف("a"), 1, "حالة 1")
تأكد_يساوي(ف("abc"), 6, "حالة 2")
تأكد_يساوي(ف("zebra"), 52, "حالة 3")
تأكد_يساوي(ف("hello"), 52, "حالة 4")
