# مثال 9 — تشفير وفك تشفير البيانات (base64 + hashlib)
# Data Encoding & Hashing
# Demonstrates: base64, hashlib, uuid, string encoding
#
# Run:  python apl.py examples/09-encoding-hashing.apl

المتغير الرسالة = "سرية APL: البيانات مشفرة"

اطبع "=== الترميز والتشفير ==="
اطبع ""

# 1) base64
المتغير مشفر = ترميز_قاعد64(الرسالة.encode("utf-8"))
اطبع "--- base64 ---"
اطبع "الأصلي:  " + الرسالة
اطبع "المشفر:  " + ثنائي_إلى_نص(مشفر)
اطبع "مفكوك:  " + فك_ترميز_قاعد64(مشفر).decode("utf-8")
اطبع "السلامة: " + نص(فك_ترميز_قاعد64(مشفر).decode("utf-8") == الرسالة)

# 2) base64 آمن للروابط
اطبع ""
اطبع "--- base64 للروابط ---"
المتغير للروابط = ترميز_آمن_للروابط(الرسالة.encode("utf-8"))
اطبع "الطول: " + نص(طول(للروابط))

# 3) hashlib
اطبع ""
اطبع "--- التجزئة ---"
اطبع "MD5:    " + تجزئة_md5(الرسالة.encode("utf-8")).hexdigest()
اطبع "SHA256: " + تجزئة_sha256(الرسالة.encode("utf-8")).hexdigest()
اطبع "طول SHA256: " + نص(طول(تجزئة_sha256(الرسالة.encode("utf-8")).hexdigest()))

# 4) uuid
اطبع ""
اطبع "--- المعرفات ---"
اطبع "معرّف عشوائي: " + معرف_نص(معرف_فريد())
اطبع "نسخة المعرّف: " + نص(معرف_فريد().نسخة_المعرف)
