# مثال 1733 — ضغط النص بالعدّ
# Run length encode a string
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1733-string-compress-char-counts.apl

# نتتبع الحرف الحالي
# نكتب العدد عند التغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اضغط(س):
  لو طول(س) == 0:
    ارجع ""
  ناتج = ""
  حالي = س[0]
  عد = 1
  لكل ك في نطاق(1, طول(س)):
    لو س[ك] == حالي:
      عد = عد + 1
    والا:
      ناتج = ناتج + حالي + نص(عد)
      حالي = س[ك]
      عد = 1
  ناتج = ناتج + حالي + نص(عد)
  ارجع ناتج

تأكد_يساوي(اضغط("aaabcc"), "a3b1c2", "ثلاثة")
تأكد_يساوي(اضغط(""), "", "فارغ")
تأكد_يساوي(اضغط("z"), "z1", "حرف")
