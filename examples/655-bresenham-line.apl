# مثال 655 — خط بريسنهام
# Bresenham line
# Demonstrates: تنقيط، خطأ متراكم، شبكة
#
# Run:  python apl.py examples/655-bresenham-line.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# خط بريسنهام: تنقيط مستقيم على شبكة
# Demonstrates: خطأ متراكم, جميع الأرباع, بلا فاصلة عائمة
# رسم الخطوط كما تفعل الشاشات والطابعات القديمة

دالة مطلق(س):
  لو س < 0:
    ارجع 0 - س
  ارجع س

دالة خط(س1, ص1, س2, ص2):
  نقاط = []
  فرق_س = مطلق(س2 - س1)
  فرق_ص = مطلق(ص2 - ص1)
  خطوة_س = 1
  لو س1 > س2:
    خطوة_س = 0 - 1
  خطوة_ص = 1
  لو ص1 > ص2:
    خطوة_ص = 0 - 1
  خطأ_تراكمي = فرق_س - فرق_ص
  طالما صواب:
    نقاط.append([س1, ص1])
    لو س1 == س2 و ص1 == ص2:
      ارجع نقاط
    مضاعف = 2 * خطأ_تراكمي
    لو مضاعف > 0 - فرق_ص:
      خطأ_تراكمي = خطأ_تراكمي - فرق_ص
      س1 = س1 + خطوة_س
    لو مضاعف < فرق_س:
      خطأ_تراكمي = خطأ_تراكمي + فرق_س
      ص1 = ص1 + خطوة_ص

ق = خط(0, 0, 5, 3)
تأكد_يساوي(طول(ق), 6, "عدد النقاط")
تأكد_يساوي(ق[0], [0, 0], "البداية")
تأكد_يساوي(ق[5], [5, 3], "النهاية")
تأكد_يساوي(ق, [[0, 0], [1, 1], [2, 1], [3, 2], [4, 2], [5, 3]], "مسار دقيق")
عمودي = خط(2, 2, 2, 7)
تأكد_يساوي(طول(عمودي), 6, "عمودي بطول 6")
تأكد_يساوي(عمودي[0], [2, 2], "بداية العمودي")
تأكد_يساوي(عمودي[5], [2, 7], "نهاية العمودي")
عكسي = خط(5, 3, 0, 0)
تأكد_يساوي(عكسي[0], [5, 3], "بداية المعكوس")
تأكد_يساوي(عكسي[5], [0, 0], "نهاية المعكوس")
اطبع "نقاط:", ق
