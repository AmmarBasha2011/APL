# مثال 1707 — أقصر مسار في شبكة بالعرض أولاً
# Shortest grid path steps by BFS
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1707-grid-shortest-path-bfs-steps.apl

# الطابور يحمل الموضع والمسافة
# الجدران قيمتها واحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أقصر_مسار(شبكة):
  ص = طول(شبكة)
  س = طول(شبكة[0])
  رأينا = {}
  طابور = [[0, 0, 0]]
  رأينا["0,0"] = 1
  اتجاهات = [[1, 0], [-1, 0], [0, 1], [0, -1]]
  طالما طول(طابور) > 0:
    ح = طابور.pop(0)
    لو ح[0] == ص - 1 و ح[1] == س - 1:
      ارجع ح[2]
    لكل ا في اتجاهات:
      ي = ح[0] + ا[0]
      ك = ح[1] + ا[1]
      لو ي >= 0 و ي < ص و ك >= 0 و ك < س:
        لو شبكة[ي][ك] == 0:
          مفتاح = نص(ي) + "," + نص(ك)
          لو (مفتاح في رأينا) == خطأ:
            رأينا[مفتاح] = 1
            طابور.append([ي, ك, ح[2] + 1])
  ارجع -1

تأكد_يساوي(أقصر_مسار([[0, 0, 0], [1, 1, 0], [0, 0, 0]]), 4, "التفاف")
تأكد_يساوي(أقصر_مسار([[0, 1], [1, 0]]), -1, "مسدود")
تأكد_يساوي(أقصر_مسار([[0]]), 0, "خلية")
