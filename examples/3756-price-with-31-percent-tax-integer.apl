# مثال 3756 — السعر مع ضريبة 31 بالمئة
# Price with 31 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3756-price-with-31-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 31 // 100

تأكد_يساوي(ف(100), 131, "حالة 1")
تأكد_يساوي(ف(250), 327, "حالة 2")
تأكد_يساوي(ف(999), 1308, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
