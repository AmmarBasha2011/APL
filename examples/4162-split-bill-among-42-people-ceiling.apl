# مثال 4162 — تقسيم الفاتورة على 42
# Split bill among 42
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4162-split-bill-among-42-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 42 - 1) // 42

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 1, "حالة 2")
تأكد_يساوي(ف(100), 3, "حالة 3")
تأكد_يساوي(ف(101), 3, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
