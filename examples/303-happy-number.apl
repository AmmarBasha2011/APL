# مثال 303 — الأعداد السعيدة
# Happy numbers
# Demonstrates: مجموع مربعات الأرقام حتى التقارب
#
# Run:  python apl.py examples/303-happy-number.apl

دالة سعيد(عدد):
    المتغير مرئية = {}
    طالما عدد != 1:
        لو عدد في مرئية:
            ارجع خطأ
        مرئية[عدد] = صواب
        المتغير مجموع = 0
        لكل رقم في نص(عدد):
            مجموع = مجموع + صحيح(رقم) ** 2
        عدد = مجموع
    ارجع صواب

اطبع "19:", سعيد(19)
اطبع "2:", سعيد(2)

المتغير قائمة = [ن لكل ن في نطاق(1, 50) لو سعيد(ن)]
اطبع "السعيدة حتى 50:", قائمة
