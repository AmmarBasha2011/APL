# مثال 835 — كولموغوروف-سميرنوف
# Kolmogorov-Smirnov
# Demonstrates: توزيع تراكمي تجريبي
#
# Run:  python apl.py examples/835-kolmogorov-smirnov.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# إحصاء كولموغوروف-سميرنوف: أقصى انحراف بين التوزيع التجريبي والنظري
# Demonstrates: دالة توزيع تراكمية تجريبية, مقارنة بالمنتظم, إحصاء D

دالة فرز(قائمة):
  نسخة = []
  لكل عنصر في قائمة:
    نسخة.append(عنصر)
  لكل ي في نطاق(طول(نسخة)):
    أدنى = ي
    لكل ج في نطاق(ي + 1, طول(نسخة)):
      لو نسخة[ج] < نسخة[أدنى]:
        أدنى = ج
    مؤقت = نسخة[ي]
    نسخة[ي] = نسخة[أدنى]
    نسخة[أدنى] = مؤقت
  ارجع نسخة

دالة إحصاء_كي_إس(بيانات):
  مرتبة = فرز(بيانات)
  ن = طول(مرتبة)
  أقصى = 0.0
  لكل ي في نطاق(ن):
    أعلى = (ي + 1) / ن - مرتبة[ي]
    لو أعلى < 0:
      أعلى = 0 - أعلى
    أدنى = مرتبة[ي] - ي / ن
    لو أدنى < 0:
      أدنى = 0 - أدنى
    لو أعلى > أقصى:
      أقصى = أعلى
    لو أدنى > أقصى:
      أقصى = أدنى
  ارجع أقصى

تأكد_يساوي(مقرب(إحصاء_كي_إس([0.05, 0.2, 0.35, 0.5, 0.62, 0.78, 0.9, 0.95]), 4), 0.155, "عينة قريبة من المنتظم")
تأكد_يساوي(مقرب(إحصاء_كي_إس([0.5, 0.5, 0.5, 0.5]), 4), 0.5, "عينة منحازة")
تأكد_يساوي(مقرب(إحصاء_كي_إس([0.125, 0.375, 0.625, 0.875]), 4), 0.125, "أدنى انحراف ممكن")
تأكد_يساوي(فرز([3, 1, 2]), [1, 2, 3], "الفرز")
