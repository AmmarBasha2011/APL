# مثال 12 — فحص الأعداد الأولية
# Prime Number Checker
# Demonstrates: sqrt, modulo, user functions, early exit
#
# Run:  python apl.py examples/12-prime-check.apl

دالة أولي(عدد):
    لو عدد < 2:
        ارجع خطأ
    لو عدد == 2:
        ارجع صواب
    لو عدد % 2 == 0:
        ارجع خطأ
    القاسم = 3
    طالما القاسم * القاسم <= عدد:
        لو عدد % القاسم == 0:
            ارجع خطأ
        القاسم = القاسم + 2
    ارجع صواب

دالة أوليات_حتى(الحد):
    النتيجة = []
    رقم = 2
    طالما رقم <= الحد:
        لو أولي(رقم):
            النتيجة.ألحق(رقم)
        رقم = رقم + 1
    ارجع النتيجة

اطبع "=== فحص الأعداد الأولية ==="
المتغير قائمة = أوليات_حتى(50)
اطبع "الأعداد الأولية حتى 50:"
اطبع "  " + نص(قائمة)
اطبع ""
اطبع "عددها: " + نص(طول(قائمة))
اطبع ""
اطبع "اختبار:"
لكل رقم في [1, 2, 7, 9, 13, 21, 97, 100]:
    اطبع f"  {رقم} أولي؟ {أولي(رقم)}"
