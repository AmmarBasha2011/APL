# مثال 872 — التكرار بالقوى
# Power iteration
# Demonstrates: ضرب متكرر وتطبيع
#
# Run:  python apl.py examples/872-power-iteration.apl

# التكرار بالقوى: أكبر قيمة ذاتية لمصفوفة بالضرب المتكرر
# أساس خوارزمية بيج-رانك الأصلية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ضرب_مصفوفة_متجه(م, متجه):
  ناتج = []
  لكل صف في م:
    مجموع = 0.0
    لكل ج في نطاق(طول(متجه)):
      مجموع = مجموع + صف[ج] * متجه[ج]
    ناتج.ألحق(مجموع)
  ارجع ناتج

دالة طبّع(متجه):
  مجموع = 0.0
  لكل ق في متجه:
    مجموع = مجموع + ق * ق
  مقياس = جذر(مجموع)
  ناتج = []
  لكل ق في متجه:
    ناتج.ألحق(ق / مقياس)
  ارجع ناتج

دالة أكبر_ذاتية(م, تكرارات):
  متجه = طبّع([1.0, 1.0])
  لكل _ في نطاق(تكرارات):
    متجه = طبّع(ضرب_مصفوفة_متجه(م, متجه))
  # حاصل رايلي: (v·Av) / (v·v)
  ضرب = ضرب_مصفوفة_متجه(م, متجه)
  بسط = 0.0
  مقام = 0.0
  لكل i في نطاق(طول(متجه)):
    بسط = بسط + متجه[i] * ضرب[i]
    مقام = مقام + متجه[i] * متجه[i]
  ارجع بسط / مقام

# القيم الذاتية لـ [[2,1],[1,2]] هي 3 و1
ذاتية = أكبر_ذاتية(
  [
    [2.0, 1.0],
    [1.0, 2.0]
  ],
  100
)
اطبع "أكبر قيمة ذاتية:", ذاتية

تأكد_يساوي(مقرب(ذاتية, 9), 3.0, "لامدا = 3")

# مصفوفة قطرية: الذاتية هي أكبر عنصر قطري
ذاتية2 = أكبر_ذاتية(
  [
    [5.0, 0.0],
    [0.0, 2.0]
  ],
  100
)
تأكد_يساوي(مقرب(ذاتية2, 9), 5.0, "قطرية: لامدا = 5")
