# مثال 3249 — مساحة دائرة بتقريب 23
# Circle area with pi approx 23/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3249-square-of-radius-times-23-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 23 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(7), 161, "حالة 3")
تأكد_يساوي(ف(14), 644, "حالة 4")
تأكد_يساوي(ف(21), 1449, "حالة 5")
