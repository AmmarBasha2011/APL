# مثال 3912 — مجموع قوى 52
# Sum of powers of 52
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3912-sum-of-powers-of-52-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 52 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 53, "حالة 2")
تأكد_يساوي(ف(3), 143365, "حالة 3")
تأكد_يساوي(ف(6), 20158268677, "حالة 4")
تأكد_يساوي(ف(10), 147389519791195397, "حالة 5")
