# مثال 142 — دمج وتحديث قواميس JSON
# Merging and updating JSON dicts
# Demonstrates: جسون، جسون_تحويل، تحديث القواميس
#
# Run:  python apl.py examples/142-json-merge.apl

المتغير أساسي = جسون('{"a": 1, "b": 2}')
المتغير إضافي = جسون('{"b": 20, "c": 3}')

أساسي.update(إضافي)
اطبع "بعد الدمج:", جسون_تحويل(أساسي)

المتغير ت = جسون('{"عداد": 5}')
ت["عداد"] = ت["عداد"] + 10
اطبع "عداد:", ت["عداد"]
اطبع "المفاتيح:", قائمة(ت.keys())
