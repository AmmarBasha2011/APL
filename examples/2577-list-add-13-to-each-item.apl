# مثال 2577 — إضافة 13 لكل عنصر
# Add 13 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2577-list-add-13-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 13]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [16, 14, 15], "حالة 1")
تأكد_يساوي(ف([5]), [18], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [14, 15, 16, 17, 18, 19], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [11, 13, 20, 20, 17], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [23, 33, 23, 43, 33, 23], "حالة 5")
