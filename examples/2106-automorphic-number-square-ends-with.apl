# مثال 2106 — العدد الذاتي التربيع
# Automorphic number check v2
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2106-automorphic-number-square-ends-with.apl

# # نقارن نهاية المربع بالعدد
# # مثل 5 و6 و76

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ذاتي(ن):
  ارجع نص(ن * ن).endswith(نص(ن))

تأكد_يساوي(ذاتي(5), صواب, "٥")
تأكد_يساوي(ذاتي(6), صواب, "٦")
تأكد_يساوي(ذاتي(76), صواب, "٧٦")
تأكد_يساوي(ذاتي(7), خطأ, "٧")
تأكد_يساوي(ذاتي(25), صواب, "٢٥")
