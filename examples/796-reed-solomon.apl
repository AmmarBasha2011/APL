# مثال 796 — ريد-سولومن
# Reed-Solomon
# Demonstrates: GF(256)، كثير مولد، متلازمات
#
# Run:  python apl.py examples/796-reed-solomon.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ترميز ريد-سولومن فوق حقل جالوا GF(256) بكثير الحدود 0x11D
# Demonstrates: جداول أس ولوغاريتم, ضرب الحقل, بناء كثير حدود المولد, متلازمات الفحص

دالة جداول_جالوا():
  أس = []
  لوغ = []
  لكل ي في نطاق(256):
    لوغ.append(0)
  س = 1
  لكل ي في نطاق(255):
    أس.append(س)
    لوغ[س] = ي
    س = س * 2
    لو س >= 256:
      س = س ^ 285
  لكل ي في نطاق(255):
    أس.append(أس[ي])
  ارجع [أس, لوغ]

ج = جداول_جالوا()
أس = ج[0]
لوغ = ج[1]

دالة ضرب_حقل(أ, ب):
  لو أ == 0 أو ب == 0:
    ارجع 0
  ارجع أس[لوغ[أ] + لوغ[ب]]

دالة مولد_ريد(عدد_فحص):
  # المعاملات بترتيب تنازلي: البداية 1 لحد أعلى درجة
  متعدد = [1]
  لكل ي في نطاق(عدد_فحص):
    جذر = أس[ي]
    جديد = []
    لكل ك في نطاق(طول(متعدد) + 1):
      جديد.append(0)
    لكل ك في نطاق(طول(متعدد)):
      جديد[ك] = جديد[ك] ^ متعدد[ك]
      جديد[ك + 1] = جديد[ك + 1] ^ ضرب_حقل(متعدد[ك], جذر)
    متعدد = جديد
  ارجع متعدد

دالة ترميز_ريد(بيانات, عدد_فحص):
  متعدد = مولد_ريد(عدد_فحص)
  رسالة = []
  لكل ب في بيانات:
    رسالة.append(ب)
  لكل ي في نطاق(عدد_فحص):
    رسالة.append(0)
  لكل ي في نطاق(طول(بيانات)):
    معامل = رسالة[ي]
    لو معامل != 0:
      لكل ك في نطاق(1, طول(متعدد)):
        رسالة[ي + ك] = رسالة[ي + ك] ^ ضرب_حقل(متعدد[ك], معامل)
  ناتج = []
  لكل ب في بيانات:
    ناتج.append(ب)
  لكل ي في نطاق(طول(رسالة) - عدد_فحص, طول(رسالة)):
    ناتج.append(رسالة[ي])
  ارجع ناتج

دالة متلازمة(كلمة, عدد_فحص):
  مت = []
  لكل ي في نطاق(عدد_فحص):
    قيمة = 0
    لكل رمز في كلمة:
      قيمة = ضرب_حقل(قيمة, أس[ي]) ^ رمز
    مت.append(قيمة)
  ارجع مت

تأكد_يساوي(أس[0], 1, "أس صفر")
تأكد_يساوي(ضرب_حقل(3, 7), 9, "ضرب 3 في 7")
تأكد_يساوي(مولد_ريد(2), [1, 3, 2], "مولد بفحصين")
مشفر = ترميز_ريد([1, 2, 3], 2)
تأكد_يساوي(مشفر, [1, 2, 3, 4, 4], "ترميز 1 2 3")
مشفر2 = ترميز_ريد([72, 101, 108, 108, 111], 4)
تأكد_يساوي(مشفر2, [72, 101, 108, 108, 111, 146, 152, 203, 131], "ترميز Hello")
تأكد_يساوي(متلازمة(مشفر2, 4), [0, 0, 0, 0], "متلازمات صفرية لكلمة سليمة")
تالف = [72, 101, 200, 108, 111, 146, 152, 203, 131]
تأكد_يساوي(متلازمة(تالف, 4), [164, 114, 209, 126], "خطأ يغير المتلازمات")
