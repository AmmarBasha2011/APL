# مثال 2497 — مجموع البواقي على 8
# Sum of remainders mod 8
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2497-sum-of-remainders-mod-8-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن + 1):
    م = م + ي % 8
  ارجع م

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(7), 28, "حالة 2")
تأكد_يساوي(ف(12), 38, "حالة 3")
تأكد_يساوي(ف(50), 171, "حالة 4")
تأكد_يساوي(ف(100), 346, "حالة 5")
