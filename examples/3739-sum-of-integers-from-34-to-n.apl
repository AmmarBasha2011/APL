# مثال 3739 — مجموع الأعداد من 34 إلى ن
# Sum from 34 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3739-sum-of-integers-from-34-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(34, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(34), 34, "حالة 1")
تأكد_يساوي(ف(35), 69, "حالة 2")
تأكد_يساوي(ف(44), 429, "حالة 3")
تأكد_يساوي(ف(100), 4489, "حالة 4")
