# مثال 23 — فحص الكلمات المتناظرة
# Palindrome Checker
# Demonstrates: string slicing, reverse, while loops
#
# Run:  python apl.py examples/23-palindrome-check.apl

دالة عكس(الجملة):
    النتيجة = ""
    رقم = طول(الجملة) - 1
    طالما رقم >= 0:
        النتيجة = النتيجة + الجملة[رقم]
        رقم = رقم - 1
    ارجع النتيجة

دالة تنظيف(الجملة):
    ارجع إزالة_التفافات(الجملة).استبدال(" ", "").سفلي()

دالة متناظرة(الجملة):
    نظيفة = تنظيف(الجملة)
    ارجع نظيفة == عكس(نظيفة)

اطبع "=== فحص المتناظرات ==="
المتغير الكلمات = ["level", "racecar", "hello", "madam", "python", "radar", "abc"]
لكل كلمة في الكلمات:
    إذا متناظرة(كلمة):
        اطبع "  " + كلمة + ": متناظرة"
    والا:
        اطبع "  " + كلمة + ": ليست متناظرة"
اطبع ""
اطبع "عكس كل كلمة:"
لكل كلمة في ["abc", "مرحبا", "12345"]:
    اطبع "  " + كلمة + " -> " + عكس(كلمة)
