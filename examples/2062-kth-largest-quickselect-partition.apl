# مثال 2062 — العنصر الأكبر رقم ك بالاختيار السريع
# Kth largest quickselect
# Demonstrates: فرز
#
# Run:  python apl.py examples/2062-kth-largest-quickselect-partition.apl

# # ثلاث قوائم أكبر ومساو وأصغر
# # نختار الجزء الذي يحوي الترتيب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كاي(ق, ك):
  محور = ق[0]
  اكبر_ق = []
  مساو = []
  اصغر_ق = []
  لكل ع في ق:
    لو ع > محور:
      اكبر_ق = اكبر_ق + [ع]
    والا_لو ع == محور:
      مساو = مساو + [ع]
    والا:
      اصغر_ق = اصغر_ق + [ع]
  لو ك <= طول(اكبر_ق):
    ارجع كاي(اكبر_ق, ك)
  لو ك <= طول(اكبر_ق) + طول(مساو):
    ارجع محور
  ارجع كاي(اصغر_ق, ك - طول(اكبر_ق) - طول(مساو))

تأكد_يساوي(كاي([3, 2, 1, 5, 6, 4], 2), 5, "الثاني")
تأكد_يساوي(كاي([3, 2, 3, 1, 2, 4, 5, 5, 6], 4), 4, "الرابع")
تأكد_يساوي(كاي([7], 1), 7, "واحد")
