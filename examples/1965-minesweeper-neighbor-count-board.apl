# مثال 1965 — أرقام لوحة كاسحة الألغام
# Minesweeper neighbor counts
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1965-minesweeper-neighbor-count-board.apl

# # نفحص الجيران ضمن حدود اللوحة
# # الخلية التي فيها لغم تبقى *

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة لوحة(الغام, ص, س):
  لغم = {}
  لكل ل في الغام:
    لغم[نص(ل[0]) + "," + نص(ل[1])] = 1
  خرج = []
  لكل ي في نطاق(ص):
    صف = ""
    لكل ك في نطاق(س):
      لو (نص(ي) + "," + نص(ك)) في لغم:
        صف = صف + "*"
      والا:
        عد = 0
        لكل د1 في [-1, 0, 1]:
          لكل د2 في [-1, 0, 1]:
            لو (د1 != 0 أو د2 != 0) و ((نص(ي + د1) + "," + نص(ك + د2)) في لغم):
              عد = عد + 1
        صف = صف + نص(عد)
    خرج = خرج + [صف]
  ارجع خرج

تأكد_يساوي(لوحة([[0, 0], [2, 2]], 3, 3), ["*1.".replace(".", "0"), "121", "01*"], "لغمان")
تأكد_يساوي(لوحة([], 2, 2), ["00", "00"], "بلا ألغام")
