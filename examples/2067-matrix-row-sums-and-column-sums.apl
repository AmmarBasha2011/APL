# مثال 2067 — مجاميع صفوف وأعمدة المصفوفة
# Row and column sums
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2067-matrix-row-sums-and-column-sums.apl

# # نجمع كل صف ثم كل عمود
# # في مرور واحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجاميع(م):
  صفوف = []
  اعمدة = [0] * طول(م[0])
  لكل صف في م:
    مج = 0
    لكل ك في نطاق(طول(صف)):
      مج = مج + صف[ك]
      اعمدة[ك] = اعمدة[ك] + صف[ك]
    صفوف = صفوف + [مج]
  ارجع [صفوف, اعمدة]

تأكد_يساوي(مجاميع([[1, 2], [3, 4], [5, 6]]), [[3, 7, 11], [9, 12]], "٣×٢")
تأكد_يساوي(مجاميع([[5]]), [[5], [5]], "واحد")
