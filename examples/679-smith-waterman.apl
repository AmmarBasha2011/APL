# مثال 679 — محاذاة سميث-ووترمان
# Smith-Waterman
# Demonstrates: محاذاة محلية، برمجة ديناميكية، تتبع خلفي
#
# Run:  python apl.py examples/679-smith-waterman.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# سميث-ووترمان: محاذاة محلية لتسلسلين
# Demonstrates: برمجة ديناميكية بصفر أرضي, تتبع خلفي, أفضل مقطع مشترك
# يجد أقوى تشابه جزئي بين تسلسلي DNA

دالة محاذاة_محلية(أ, ب):
  ن = طول(أ)
  م = طول(ب)
  جدول = []
  لكل ي في نطاق(ن + 1):
    صف = []
    لكل ج في نطاق(م + 1):
      صف.append(0)
    جدول.append(صف)
  أفضل = 0
  موضع = [0, 0]
  لكل ي في نطاق(1, ن + 1):
    لكل ج في نطاق(1, م + 1):
      تطابق = جدول[ي - 1][ج - 1]
      لو أ[ي - 1] == ب[ج - 1]:
        تطابق = تطابق + 2
      والا:
        تطابق = تطابق - 1
      حذف_ق = جدول[ي - 1][ج] - 1
      إدراج_ق = جدول[ي][ج - 1] - 1
      قيمة = تطابق
      لو حذف_ق > قيمة:
        قيمة = حذف_ق
      لو إدراج_ق > قيمة:
        قيمة = إدراج_ق
      لو قيمة < 0:
        قيمة = 0
      جدول[ي][ج] = قيمة
      لو قيمة > أفضل:
        أفضل = قيمة
        موضع = [ي, ج]
  تتبع_أ = ""
  ي = موضع[0]
  ج = موضع[1]
  طالما ي > 0 و ج > 0 و جدول[ي][ج] > 0:
    لو جدول[ي][ج] == جدول[ي - 1][ج - 1] + 2 و أ[ي - 1] == ب[ج - 1]:
      تتبع_أ = أ[ي - 1] + تتبع_أ
      ي = ي - 1
      ج = ج - 1
    والا_لو جدول[ي][ج] == جدول[ي - 1][ج] - 1:
      تتبع_أ = أ[ي - 1] + تتبع_أ
      ي = ي - 1
    والا:
      ج = ج - 1
  ارجع [أفضل, تتبع_أ]

ناتج = محاذاة_محلية("AGCACACA", "ACACACTA")
تأكد_يساوي(ناتج[0], 12, "أفضل درجة محلية")
تأكد_يساوي(ناتج[1], "AGCACACA", "المقطع المتحاذي")
ناتج2 = محاذاة_محلية("AAAA", "TTTT")
تأكد_يساوي(ناتج2[0], 0, "لا تشابه صفر")
اطبع "أفضل:", ناتج
