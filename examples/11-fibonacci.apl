دالة فيب(ن):
    لو ن < 2:
        ارجع ن
    ارجع فيب(ن - 1) + فيب(ن - 2)

دالة فيب_تكراري(عدد):
    لو عدد < 2:
        ارجع عدد
    السابق = 0
    الحالي = 1
    كرارة = 2
    طالما كرارة <= عدد:
        التالي = السابق + الحالي
        السابق = الحالي
        الحالي = التالي
        كرارة = كرارة + 1
    ارجع الحالي

اطبع "=== متتالية فيبوناتشي ==="
اطبع "أول 8 حدود:"
المتغير الحدود = 0
طالما الحدود < 8:
    اطبع f"  فيب({الحدود}) = {فيب(الحدود)}"
    الحدود = الحدود + 1
اطبع ""
اطبع "فيب(10) تكراري: " + نص(فيب_تكراري(10))
اطبع "فيب(20) تكراري: " + نص(فيب_تكراري(20))
اطبع "فيب(50) تكراري: " + نص(فيب_تكراري(50))
