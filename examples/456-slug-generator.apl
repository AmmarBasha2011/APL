# مثال 456 — مولد روابط Slug
# Slug generator
# Demonstrates: عنوان مقال إلى رابط
#
# Run:  python apl.py examples/456-slug-generator.apl

دالة رابط_لطيف(عنوان):
    المتغير ناتج = ""
    لكل حرف في عنوان.سفلي():
        لو (حرف >= "a" و حرف <= "z") أو (حرف >= "0" و حرف <= "9"):
            ناتج = ناتج + حرف
        الا لو حرف == " ":
            ناتج = ناتج + "-"
    ارجع ناتج

اطبع رابط_لطيف("Hello World 2026!")
اطبع رابط_لطيف("My First Blog Post")
