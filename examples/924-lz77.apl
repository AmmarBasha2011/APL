# مثال 924 — ضغط LZ77
# LZ77 compression
# Demonstrates: مراجع مسافة وطول
#
# Run:  python apl.py examples/924-lz77.apl

# ضغط LZ77: استبدال التكرارات بمراجع (مسافة، طول) للخلف
# أساس خوارزميات ZIP و gzip

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اضغط(سلسلة, نافذة, نظرة):
  رموز = []
  i = 0
  ن = طول(سلسلة)
  طالما i < ن:
    أفضل_مسافة = 0
    أفضل_طول = 0
    بداية = i - نافذة
    لو بداية < 0:
      بداية = 0
    لكل ج في نطاق(بداية, i):
      طول_مطابق = 0
      طالما طول_مطابق < نظرة و i + طول_مطابق < ن و سلسلة[ج + طول_مطابق] == سلسلة[i + طول_مطابق]:
        طول_مطابق = طول_مطابق + 1
      لو طول_مطابق > أفضل_طول:
        أفضل_مسافة = i - ج
        أفضل_طول = طول_مطابق
    لو أفضل_طول >= 2:
      تالي = ""
      لو i + أفضل_طول < ن:
        تالي = سلسلة[i + أفضل_طول]
      رموز.ألحق([أفضل_مسافة, أفضل_طول, تالي])
      i = i + أفضل_طول + 1
    والا:
      رموز.ألحق([0, 0, سلسلة[i]])
      i = i + 1
  ارجع رموز

دالة فك(رموز):
  خرج = ""
  لكل رمز في رموز:
    لو رمز[1] >= 2:
      بداية = طول(خرج) - رمز[0]
      لكل i في نطاق(رمز[1]):
        خرج = خرج + خرج[بداية + i]
    لو رمز[2] != "":
      خرج = خرج + رمز[2]
  ارجع خرج

رموز = اضغط("abracadabra", 8, 4)
اطبع "الرموز:", رموز
مفكوك = فك(رموز)
اطبع "المفكوك:", مفكوك

تأكد_يساوي(مفكوك, "abracadabra", "الفك يعيد الأصل")
# آخر رمز مرجع بطول 4 ومسافة 7 (abra الأخيرة)
آخر = رموز[طول(رموز) - 1]
تأكد_يساوي(آخر[0], 7, "المسافة 7")
تأكد_يساوي(آخر[1], 4, "الطول 4")

# نص متكرر يضغط جيداً
مكرر = "abcabcabcabc"
رموز2 = اضغط(مكرر, 8, 4)
تأكد_يساوي(فك(رموز2), مكرر, "فك المتكرر")
لو طول(رموز2) >= طول(مكرر):
  اطبع "فشل: لم يحدث ضغط"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: ضغط المتكرر إلى", طول(رموز2), "رموز"
