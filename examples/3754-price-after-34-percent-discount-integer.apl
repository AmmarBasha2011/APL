# مثال 3754 — السعر بعد خصم 34 بالمئة
# Price after 34 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3754-price-after-34-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 34 // 100

تأكد_يساوي(ف(100), 66, "حالة 1")
تأكد_يساوي(ف(250), 165, "حالة 2")
تأكد_يساوي(ف(999), 660, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
