# مثال 1269 — قراءة قطرية
# Diagonal traverse
# Demonstrates: شبكة
#
# Run:  python apl.py examples/1269-diagonal-traverse.apl

# كل قطر مجموع صفه وعموده ثابت
# نعكس الأقطار الزوجية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقطار(م):
  لو طول(م) == 0:
    ارجع []
  ر_ = طول(م)
  ك_ = طول(م[0])
  ناتج = []
  لكل مج في نطاق(ر_ + ك_ - 1):
    قطر = []
    لكل ص في نطاق(ر_):
      ج = مج - ص
      لو (ج >= 0) و (ج < ك_):
        قطر.ألحق(م[ص][ج])
    لو مج % 2 == 0:
      قطر.reverse()
    ناتج = ناتج + قطر
  ارجع ناتج

تأكد_يساوي(اقطار([[1,2,3],[4,5,6],[7,8,9]]), [1,2,4,7,5,3,6,8,9], "ثلاثة في ثلاثة")
تأكد_يساوي(اقطار([[1,2],[3,4]]), [1,2,3,4], "اثنان")
تأكد_يساوي(اقطار([]), [], "فارغة")
