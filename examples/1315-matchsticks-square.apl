# مثال 1315 — عيدان ثقاب مربع
# Matchsticks to square
# Demonstrates: رجوع
#
# Run:  python apl.py examples/1315-matchsticks-square.apl

# مجموع الأطوال يقبل القسمة على أربعة
# نوزع كل عود على ضلع من الأضلاع الأربعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نوزع(عيدان, ع, اضلاع, هدف):
  لو ع == طول(عيدان):
    ارجع (اضلاع[0] == هدف) و (اضلاع[1] == هدف) و (اضلاع[2] == هدف)
  لكل ض في نطاق(4):
    لو اضلاع[ض] + عيدان[ع] <= هدف:
      اضلاع[ض] = اضلاع[ض] + عيدان[ع]
      ن = نوزع(عيدان, ع + 1, اضلاع, هدف)
      اضلاع[ض] = اضلاع[ض] - عيدان[ع]
      لو ن:
        ارجع صواب
  ارجع خطأ

دالة مربع(عيدان):
  مج = 0
  لكل س في عيدان:
    مج = مج + س
  لو (طول(عيدان) < 4) أو (مج % 4 != 0):
    ارجع خطأ
  ق = مفرز(عيدان)
  ق.reverse()
  ارجع نوزع(ق, 0, [0, 0, 0, 0], مج // 4)

تأكد_يساوي(مربع([1,1,2,2,2]), صواب, "ممكن")
تأكد_يساوي(مربع([3,3,3,3,4]), خطأ, "غير ممكن")
تأكد_يساوي(مربع([5,5,5,5]), صواب, "متساوية")
تأكد_يساوي(مربع([1,2,3]), خطأ, "قليلة")
