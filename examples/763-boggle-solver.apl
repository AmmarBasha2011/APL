# مثال 763 — حلال بوغل
# Boggle solver
# Demonstrates: بحث عمقي، 8 اتجاهات، مجموعة زيارة
#
# Run:  python apl.py examples/763-boggle-solver.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# حلال بوغل: كلمات من حروف متجاورة في شبكة
# Demonstrates: بحث عمقي بثمانية اتجاهات, مجموعة زيارة, تفضيل الأطول
# لا يجوز إعادة استعمال الخلية في الكلمة الواحدة

لوحة = [["c", "a", "t"], ["d", "o", "g"], ["s", "u", "n"]]
قاموس = ["cat", "cats", "dog", "sun", "god", "act", "sat", "ton", "nut", "can", "do", "so"]

دالة في_القاموس(كلمة):
  لكل كلمة_قاموس في قاموس:
    لو كلمة_قاموس == كلمة:
      ارجع صواب
  ارجع خطأ

دالة ابحث(صف, عمود, كلمة, مزارة, موجودات):
  لو في_القاموس(كلمة):
    لو (كلمة في موجودات) == خطأ:
      موجودات.append(كلمة)
  لكل دصف في [-1, 0, 1]:
    لكل دعمود في [-1, 0, 1]:
      ص = صف + دصف
      ع = عمود + دعمود
      لو ص >= 0 و ص < 3 و ع >= 0 و ع < 3:
        لو ((ص * 10 + ع) في مزارة) == خطأ:
          ابحث(ص, ع, كلمة + لوحة[ص][ع], مزارة + [ص * 10 + ع], موجودات)

دالة كل_الكلمات():
  موجودات = []
  لكل صف في نطاق(3):
    لكل عمود في نطاق(3):
      ابحث(صف, عمود, لوحة[صف][عمود], [صف * 10 + عمود], موجودات)
  ارجع موجودات

دالة رتب(قائمة):
  نسخة = قائمة
  لكل ي في نطاق(طول(نسخة)):
    لكل ج في نطاق(ي + 1, طول(نسخة)):
      لو نسخة[ج] < نسخة[ي]:
        مؤقت = نسخة[ي]
        نسخة[ي] = نسخة[ج]
        نسخة[ج] = مؤقت
  ارجع نسخة

موجودات = رتب(كل_الكلمات())

تأكد_يساوي(موجودات, ["cat", "do", "dog", "god", "so", "sun", "ton"], "الكلمات السبع")
تأكد_يساوي(طول(موجودات), 7, "سبع كلمات")
تأكد_يساوي("cats" في موجودات, خطأ, "cats تحتاج s مجاورة لـt")
تأكد_يساوي("nut" في موجودات, خطأ, "nut غير متصلة")

اطبع "الكلمات:", موجودات
