# مثال 344 — محلل سجلات
# Log analyzer
# Demonstrates: عد مستويات السجل
#
# Run:  python apl.py examples/344-log-analyzer.apl

المتغير مسار = "/tmp/apl_log_344.txt"
اكتب(مسار, "INFO بدأ التشغيل\nERROR فشل الاتصال\nINFO طلب جديد\nWARNING ذاكرة مرتفعة\nERROR انتهت المهلة\nINFO توقف\n")

المتغير سطور = اقرأ(مسار).تقليم().تقسيم("\n")
المتغير عدد = {}
لكل سطر في سطور:
    المتغير مستوى = سطر.تقسيم(" ")[0]
    لو مستوى في عدد:
        عدد[مستوى] = عدد[مستوى] + 1
    الا:
        عدد[مستوى] = 1

لكل مستوى في عدد:
    اطبع مستوى, ":", عدد[مستوى]

احذف_ملف(مسار)
