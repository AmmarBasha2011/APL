# مثال 4334 — اقتطاع أول 64 أحرف
# First 64 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/4334-truncate-text-to-first-64-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:64]

تأكد_يساوي(ف("hello world"), "hello world", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abcdefghijkl", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
