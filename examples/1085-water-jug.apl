# مثال 1085 — لغز إبريقي الماء
# Water and jug problem
# Demonstrates: القاسم المشترك الأكبر
#
# Run:  python apl.py examples/1085-water-jug.apl

# الكميات الممكنة هي مضاعفات القاسم المشترك الأكبر للسعتين
# بشرط ألا تتجاوز مجموع السعتين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ق_م(أ, ب):
  طالما ب != 0:
    ت = أ % ب
    أ = ب
    ب = ت
  ارجع أ

دالة يمكن_قياس(س, ص, ز):
  لو ز > (س + ص):
    ارجع خطأ
  لو ز == 0:
    ارجع صواب
  ارجع (ز % ق_م(س, ص)) == 0

تأكد_يساوي(يمكن_قياس(3, 5, 4), صواب, "3 و5 إلى 4")
تأكد_يساوي(يمكن_قياس(2, 6, 5), خطأ, "2 و6 إلى 5")
تأكد_يساوي(يمكن_قياس(1, 2, 3), صواب, "1 و2 إلى 3")
تأكد_يساوي(يمكن_قياس(2, 6, 9), خطأ, "أكبر من المجموع")
