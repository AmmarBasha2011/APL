# مثال 3592 — مجموع المربعات من 14 إلى ن
# Sum of squares from 14
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3592-sum-of-squares-from-14-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(14, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(14), 196, "حالة 1")
تأكد_يساوي(ف(15), 421, "حالة 2")
تأكد_يساوي(ف(24), 4081, "حالة 3")
تأكد_يساوي(ف(100), 337531, "حالة 4")
