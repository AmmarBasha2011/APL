# مثال 351 — متجه ثنائي الأبعاد
# 2D vector class
# Demonstrates: جمع وطول متجهات
#
# Run:  python apl.py examples/351-vector2d.apl

صنف متجه:
    دالة_إنشاء(ذات, س, ص):
        ذات.س = س
        ذات.ص = ص

    دالة اجمع(ذات, آخر):
        ارجع متجه(ذات.س + آخر.س, ذات.ص + آخر.ص)

    دالة اضرب_في(ذات, عدد):
        ارجع متجه(ذات.س * عدد, ذات.ص * عدد)

    دالة طول_المتجه(ذات):
        ارجع (ذات.س ** 2 + ذات.ص ** 2) ** 0.5

    دالة كنص(ذات):
        ارجع "(" + نص(ذات.س) + ", " + نص(ذات.ص) + ")"

المتغير أ = متجه(3, 4)
المتغير ب = متجه(1, 2)
المتغير ج = أ.اجمع(ب)
اطبع "أ + ب =", ج.كنص()
اطبع "طول أ:", أ.طول_المتجه()
اطبع "أ × 2 =", أ.اضرب_في(2).كنص()
