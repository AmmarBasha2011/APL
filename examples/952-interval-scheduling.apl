# مثال 952 — جدولة الفترات
# Interval scheduling
# Demonstrates: جشع بالأبكر انتهاءً
#
# Run:  python apl.py examples/952-interval-scheduling.apl

# جدولة الفترات: أكبر عدد مهام غير متداخلة
# الجشع الأمثل: اختر دائماً الأ earliest انتهاءً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جدول(مهام):
  # فرز بالنهاية (فقاعي)
  م = []
  لكل مهمة في مهام:
    م.ألحق(مهمة)
  ن = طول(م)
  لكل i في نطاق(ن):
    لكل ج في نطاق(i + 1, ن):
      لو م[ج][1] < م[i][1]:
        مؤقت = م[i]
        م[i] = م[ج]
        م[ج] = مؤقت
  مختارة = []
  آخر_نهاية = -1
  لكل مهمة في م:
    لو مهمة[0] >= آخر_نهاية:
      مختارة.ألحق(مهمة)
      آخر_نهاية = مهمة[1]
  ارجع مختارة

مهام = [[1, 4], [3, 5], [0, 6], [5, 7], [3, 9], [5, 9], [6, 10], [8, 11]]
مختارة = جدول(مهام)
اطبع "المختارة:", مختارة

تأكد_يساوي(طول(مختارة), 3, "ثلاث مهام")
تأكد_يساوي(مختارة[0][0], 1, "أولى تبدأ 1")
تأكد_يساوي(مختارة[0][1], 4, "أولى تنتهي 4")
تأكد_يساوي(مختارة[1][0], 5, "ثانية تبدأ 5")
تأكد_يساوي(مختارة[2][0], 8, "ثالثة تبدأ 8")

# لا تداخل
لكل i في نطاق(طول(مختارة) - 1):
  لو مختارة[i][1] > مختارة[i + 1][0]:
    اطبع "فشل: تداخل"
    قياسي_نظام_اخرج(1)
اطبع "ناجح: لا تداخل"

# مهام متطابقة البداية: الأقصر أولاً
تأكد_يساوي(طول(جدول([[1, 3], [1, 2], [2, 5]])), 2, "أقصر أولاً")
