# مثال 1402 — تخمين غولدباخ الآخر
# Goldbach's other conjecture
# Demonstrates: رياضيات
#
# Run:  python apl.py examples/1402-goldbach-other-conjecture.apl

# نجرب كل مربع ممكن لكل عدد فردي مركب
# ونبحث عن أول عدد يفشل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  ع = 2
  طالما ع * ع <= ن:
    لو ن % ع == 0:
      ارجع خطأ
    ع = ع + 1
  ارجع صواب

دالة يمكن_كتابته(ن):
  ك = 1
  طالما 2 * ك * ك < ن:
    لو اولي(ن - 2 * ك * ك):
      ارجع صواب
    ك = ك + 1
  ارجع خطأ

دالة اول_مخالف():
  ن = 9
  طالما صواب:
    لو (ليس اولي(ن)) و (ليس يمكن_كتابته(ن)):
      ارجع ن
    ن = ن + 2

تأكد_يساوي(يمكن_كتابته(9), صواب, "تسعة")
تأكد_يساوي(يمكن_كتابته(15), صواب, "خمسة عشر")
تأكد_يساوي(اول_مخالف(), 5777, "المخالف الأول")
