# مثال 4043 — ربط أول 20 أحرف بنقاط
# Join first 20 chars with dots
# Demonstrates: نصوص
#
# Run:  python apl.py examples/4043-join-first-20-chars-with-dots.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ".".join(ن[:20])

تأكد_يساوي(ف("hello"), "h.e.l.l.o", "حالة 1")
تأكد_يساوي(ف("ab"), "a.b", "حالة 2")
تأكد_يساوي(ف("abcdefghijklmn"), "a.b.c.d.e.f.g.h.i.j.k.l.m.n", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
