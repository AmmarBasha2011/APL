# مثال 4224 — قوة 29 بالحلقة
# Power of 29 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4224-nth-power-of-29-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 29
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 29, "حالة 2")
تأكد_يساوي(ف(3), 24389, "حالة 3")
تأكد_يساوي(ف(6), 594823321, "حالة 4")
تأكد_يساوي(ف(10), 420707233300201, "حالة 5")
