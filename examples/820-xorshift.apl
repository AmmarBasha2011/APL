# مثال 820 — مولد xorshift
# xorshift PRNG
# Demonstrates: ثلاث إزاحات XOR، دورة قصوى
#
# Run:  python apl.py examples/820-xorshift.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مولد xorshift32: ثلاث إزاحات مع حصر ثنائي فقط
# Demonstrates: إزاحة وXOR, دورة 2^32-1, سرعة بدون ضرب

قناع = 4294967295

دالة خطوة_شيفت(س):
  س = س ^ ((س << 13) & قناع)
  س = س ^ (س >> 17)
  س = س ^ ((س << 5) & قناع)
  ارجع س

س = 1
تأكد_يساوي(خطوة_شيفت(س), 270369, "أول قيمة")
سلسلة = []
لكل ي في نطاق(3):
  س = خطوة_شيفت(س)
  سلسلة.append(س)
تأكد_يساوي(سلسلة, [270369, 67634689, 2647435461], "ثلاث قيم")
تأكد_يساوي(خطوة_شيفت(0), 0, "الصفر حالة ميتة")
بايتات = []
س = 2463534242
لكل ي في نطاق(4):
  س = خطوة_شيفت(س)
  بايتات.append(س % 256)
تأكد_يساوي(بايتات, [99, 122, 160, 126], "بايتات من بذرة أخرى")
