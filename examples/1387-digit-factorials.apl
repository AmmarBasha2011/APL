# مثال 1387 — مضروبات الأرقام
# Digit factorial numbers
# Demonstrates: رياضيات
#
# Run:  python apl.py examples/1387-digit-factorials.apl

# 145 يساوي 1 زائد 24 زائد 120
# نحسب المضروبات مرة واحدة لكل رقم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مضروبات_الأرقام():
  م = [1]
  لكل ع في نطاق(1, 10):
    م.ألحق(م[ع - 1] * ع)
  ارجع م

دالة مميز(ن):
  م = مضروبات_الأرقام()
  مجموع = 0
  لكل ح في نص(ن):
    مجموع = مجموع + م[صحيح(ح)]
  ارجع مجموع == ن

دالة ابحث(حد):
  ناتج = []
  لكل ن في نطاق(10, حد):
    لو مميز(ن):
      ناتج.ألحق(ن)
  ارجع ناتج

تأكد_يساوي(مميز(145), صواب, "مئة وخمسة وأربعون")
تأكد_يساوي(مميز(40585), صواب, "أربعون ألفاً")
تأكد_يساوي(مميز(144), خطأ, "ليس مميزاً")
تأكد_يساوي(ابحث(2000), [145], "أقل من ألفين")
