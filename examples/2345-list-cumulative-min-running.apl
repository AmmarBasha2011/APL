# مثال 2345 — الأصغر التراكمي
# Running minimum
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2345-list-cumulative-min-running.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  ك = ق[0]
  لكل ع في ق:
    لو ع < ك:
      ك = ع
    ر = ر + [ك]
  ارجع ر

تأكد_يساوي(ف([5, 3, 4, 1, 2]), [5, 3, 3, 1, 1], "حالة 1")
تأكد_يساوي(ف([5]), [5], "حالة 2")
تأكد_يساوي(ف([1, 2, 3]), [1, 1, 1], "حالة 3")
تأكد_يساوي(ف([3, 2, 1]), [3, 2, 1], "حالة 4")
