# مثال 317 — قواسم العدد
# Divisors of a number
# Demonstrates: إيجاد كل القواسم بكفاءة
#
# Run:  python apl.py examples/317-divisors.apl

دالة قواسم(عدد):
    المتغير صغار = []
    المتغير كبار = []
    المتغير ق = 1
    طالما ق * ق <= عدد:
        لو عدد % ق == 0:
            صغار.أضف(ق)
            لو ق * ق != عدد:
                كبار.أضف(عدد // ق)
        ق = ق + 1
    المتغير نتيجة = صغار
    لكل ي في نطاق(طول(كبار)):
        نتيجة.أضف(كبار[طول(كبار) - 1 - ي])
    ارجع نتيجة

اطبع "قواسم 28:", قواسم(28)
اطبع "قواسم 36:", قواسم(36)
اطبع "عدد قواسم 100:", طول(قواسم(100))
