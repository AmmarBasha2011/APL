# مثال 3505 — الحد النوني بخطوة 41
# Nth term step 41
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3505-nth-term-arithmetic-sequence-step-41.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 41

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 44, "حالة 2")
تأكد_يساوي(ف(10), 372, "حالة 3")
تأكد_يساوي(ف(100), 4062, "حالة 4")
