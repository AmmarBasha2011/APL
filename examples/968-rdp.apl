# مثال 968 — تبسيط المسارات
# Ramer-Douglas-Peucker
# Demonstrates: أبعد نقطة تقسم المسار
#
# Run:  python apl.py examples/968-rdp.apl

# تبسيط المسار (رامر-دوغلاس-بيكر): حذف النقاط القريبة من الخط
# أبعد نقطة تقسم المسار إن تجاوزت الهامش

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مسافة_عمودية(ن, أ, ب):
  فرق_س = ب[0] - أ[0]
  فرق_ص = ب[1] - أ[1]
  بسط = ((فرق_ص * ن[0]) - (فرق_س * ن[1])) + (ب[0] * أ[1]) - (ب[1] * أ[0])
  لو بسط < 0:
    بسط = 0 - بسط
  ارجع بسط / جذر((فرق_ص * فرق_ص) + (فرق_س * فرق_س))

دالة بسط_مسار(نقاط, هامش):
  لو طول(نقاط) < 3:
    ارجع نقاط
  أ = نقاط[0]
  ب = نقاط[طول(نقاط) - 1]
  أقصى = -1
  عند = 0
  لكل i في نطاق(1, طول(نقاط) - 1):
    مس = مسافة_عمودية(نقاط[i], أ, ب)
    لو مس > أقصى:
      أقصى = مس
      عند = i
  لو أقصى > هامش:
    يسار = بسط_مسار(نقاط[:عند + 1], هامش)
    يمين = بسط_مسار(نقاط[عند:], هامش)
    ارجع يسار[:طول(يسار) - 1] + يمين
  ارجع [أ, ب]

نقاط = [[0, 0], [1, 0.1], [2, -0.1], [3, 5], [4, 6], [5, 7], [6, 8.1], [7, 9]]
نتيجة = بسط_مسار(نقاط, 1.0)
تأكد_يساوي(طول(نتيجة), 4, "عدد النقاط المتبقية")
تأكد_يساوي(نتيجة[0][0], 0, "البداية س")
تأكد_يساوي(نتيجة[1][0], 2, "النقطة الثانية س")
تأكد_يساوي(مقرب(نتيجة[1][1], 1), -0.1, "النقطة الثانية ص")
تأكد_يساوي(نتيجة[2][0], 3, "النقطة الثالثة س")
تأكد_يساوي(نتيجة[2][1], 5, "النقطة الثالثة ص")
تأكد_يساوي(نتيجة[3][0], 7, "النهاية س")
