# مثال 546 — أقصى نافذة منزلقة
# Sliding window maximum
# Demonstrates: نافذة منزلقة، قائمة رتيبة
#
# Run:  python apl.py examples/546-sliding-window-max.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# أقصى نافذة منزلقة بقائمة رتيبة
دالة أقصى_نوافذ(ق, ك):
    المتغير نتائج = قائمة()
    المتغير فهارس = قائمة()
    لكل i في نطاق(طول(ق)):
        طالما طول(فهارس) > 0 و فهارس[0] <= i - ك:
            فهارس.pop(0)
        طالما طول(فهارس) > 0 و ق[فهارس[طول(فهارس) - 1]] <= ق[i]:
            فهارس.pop()
        فهارس.أضف(i)
        لو i >= ك - 1:
            نتائج.أضف(ق[فهارس[0]])
    ارجع نتائج

تأكد_يساوي(أقصى_نوافذ([1, 3, -1, -3, 5, 3, 6, 7], 3), [3, 3, 5, 5, 6, 7], "النوافذ")
تأكد_يساوي(أقصى_نوافذ([9, 8, 7], 1), [9, 8, 7], "نافذة واحد")
