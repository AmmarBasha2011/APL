# مثال 1709 — عدد الجزر في الشبكة
# Count islands in a grid
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1709-count-islands-grid.apl

# نمر على الخلايا
# نغمر كل جزيرة بعد عدها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اغمر(شبكة, ص0, س0):
  مكدس = [[ص0, س0]]
  شبكة[ص0][س0] = 0
  اتجاهات = [[1, 0], [-1, 0], [0, 1], [0, -1]]
  طالما طول(مكدس) > 0:
    ح = مكدس.pop()
    لكل ا في اتجاهات:
      ي = ح[0] + ا[0]
      ك = ح[1] + ا[1]
      لو ي >= 0 و ي < طول(شبكة) و ك >= 0 و ك < طول(شبكة[0]):
        لو شبكة[ي][ك] == 1:
          شبكة[ي][ك] = 0
          مكدس.append([ي, ك])

دالة عد_الجزر(شبكة):
  عد = 0
  لكل ي في نطاق(طول(شبكة)):
    لكل ك في نطاق(طول(شبكة[0])):
      لو شبكة[ي][ك] == 1:
        عد = عد + 1
        اغمر(شبكة, ي, ك)
  ارجع عد

تأكد_يساوي(عد_الجزر([[1, 1, 0], [0, 0, 1], [1, 0, 1]]), 3, "ثلاث")
تأكد_يساوي(عد_الجزر([[0, 0], [0, 0]]), 0, "بحر")
تأكد_يساوي(عد_الجزر([[1, 1], [1, 1]]), 1, "واحدة")
