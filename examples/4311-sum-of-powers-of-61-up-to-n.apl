# مثال 4311 — مجموع قوى 61
# Sum of powers of 61
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4311-sum-of-powers-of-61-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 61 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 62, "حالة 2")
تأكد_يساوي(ف(3), 230764, "حالة 3")
تأكد_يساوي(ف(6), 52379047267, "حالة 4")
تأكد_يساوي(ف(10), 725231960190597311, "حالة 5")
