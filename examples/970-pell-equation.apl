# مثال 970 — معادلة بل
# Pell equation
# Demonstrates: بحث بجذر صحيح متزايد
#
# Run:  python apl.py examples/970-pell-equation.apl

# معادلة بل: س^2 - د ص^2 = 1 لأصغر الحلول الصحيحة
# بحث مباشر مع جذر صحيح بالتزايد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جذر_صحيح(ن):
  ك = 0
  طالما ((ك + 1) * (ك + 1)) <= ن:
    ك = ك + 1
  ارجع ك

دالة بل(د, حد):
  حلول = []
  ص = 1
  طالما (ص <= حد) و (طول(حلول) < 3):
    مربع = 1 + (د * ص * ص)
    س = جذر_صحيح(مربع)
    لو (س * س) == مربع:
      حلول.ألحق([س, ص])
    ص = ص + 1
  ارجع حلول

حلول = بل(2, 100)
تأكد_يساوي(طول(حلول), 3, "ثلاثة حلول")
تأكد_يساوي(حلول[0][0], 3, "س الأول")
تأكد_يساوي(حلول[0][1], 2, "ص الأول")
تأكد_يساوي(حلول[1][0], 17, "س الثاني")
تأكد_يساوي(حلول[2][0], 99, "س الثالث")
تأكد_يساوي((3 * 3) - (2 * 2 * 2), 1, "تحقق المعادلة")
