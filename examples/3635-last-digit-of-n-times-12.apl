# مثال 3635 — آخر رقم من ن×12
# Last digit of n times 12
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3635-last-digit-of-n-times-12.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 12) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(7), 4, "حالة 3")
تأكد_يساوي(ف(12), 4, "حالة 4")
تأكد_يساوي(ف(99), 8, "حالة 5")
