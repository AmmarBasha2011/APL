# مثال 2132 — عدد أحرف العلة في كل كلمة
# Vowel count per word
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2132-vowel-count-for-each-word.apl

# # نعد a وe وi وo وu
# # كل كلمة على حدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة علل(س):
  خرج = []
  لكل ك في س.split():
    عدد = 0
    لكل ح في ك:
      لو ح في "aeiou":
        عدد = عدد + 1
    خرج = خرج + [عدد]
  ارجع خرج

تأكد_يساوي(علل("hello big world"), [2, 1, 1], "ثلاث كلمات")
تأكد_يساوي(علل(""), [], "فارغ")
تأكد_يساوي(علل("sky"), [0], "بلا علل")
