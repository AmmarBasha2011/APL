# مثال 2361 — مجموع أول ن فيبوناتشي
# Sum of first n Fibonacci
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2361-sum-of-first-n-fibonacci-numbers.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 0
  ب = 1
  م = 0
  لكل ي في نطاق(ن):
    م = م + أ
    أ, ب = ب, أ + ب
  ارجع م

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(2), 1, "حالة 2")
تأكد_يساوي(ف(5), 7, "حالة 3")
تأكد_يساوي(ف(10), 88, "حالة 4")
تأكد_يساوي(ف(20), 10945, "حالة 5")
