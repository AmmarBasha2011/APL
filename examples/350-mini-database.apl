# مثال 350 — قاعدة بيانات JSON مصغرة
# Mini JSON database
# Demonstrates: إدراج واستعلام وحذف
#
# Run:  python apl.py examples/350-mini-database.apl

المتغير مسار = "/tmp/apl_db_350.json"

دالة أدرج_سجل(جدول, سجل):
    اكتب_ملف_جسون(جدول + [سجل], مسار)

دالة استعلم(شرط):
    المتغير جدول = اقرأ_ملف_جسون(مسار)
    ارجع قائمة(فلترة_قائمة(شرط, جدول))

اكتب_ملف_جسون([], مسار)
أدرج_سجل([], {"معرف": 1, "اسم": "أحمد", "رصيد": 100})
المتغير حالي = اقرأ_ملف_جسون(مسار)
أدرج_سجل(حالي, {"معرف": 2, "اسم": "سارة", "رصيد": 250})
حالي = اقرأ_ملف_جسون(مسار)
أدرج_سجل(حالي, {"معرف": 3, "اسم": "خالد", "رصيد": 50})

اطبع "من رصيده فوق 80:"
لكل ع في استعلم((ع) => ع["رصيد"] > 80):
    اطبع " ", ع["اسم"], ":", ع["رصيد"]

احذف_ملف(مسار)
