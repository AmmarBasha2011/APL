# مثال 721 — CRC-16 مودباس
# CRC-16 Modbus
# Demonstrates: بتات LSB أولاً، متعددة حدود، انزياح
#
# Run:  python apl.py examples/721-crc16-modbus.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# CRC-16/MODBUS: كشف أخطاء في الشبكات الصناعية
# Demonstrates: كثيرة حدود منعكسة A001, إزاحة بتية, قيمة ابتدائية FFFF
# فحص معياري: "123456789" يعطي 0x4B37

دالة بايتات(نص):
  ناتج = []
  لكل ي في نطاق(طول(نص)):
    ناتج.append(ترميز_حرف(نص[ي]) % 256)
  ارجع ناتج

دالة crc16(بايتات):
  crc = 65535
  لكل بايت في بايتات:
    crc = crc ^ بايت
    لكل بت في نطاق(8):
      لو crc % 2 == 1:
        crc = (crc // 2) ^ 40961
      والا:
        crc = crc // 2
  ارجع crc

تأكد_يساوي(crc16(بايتات("123456789")), 19255, "فحص 4B37 القياسي")
تأكد_يساوي(crc16(بايتات("")), 65535, "الفارغ يبقى FFFF")
تأكد_يساوي(crc16(بايتات("A")), 28799, "حرف واحد")
تأكد_يساوي(crc16(بايتات("abc")) != crc16(بايتات("abd")), صواب, "حرف يغير")
تأكد_يساوي(crc16(بايتات("abc")) != crc16(بايتات("acb")), صواب, "الترتيب يهم")
# إعادة الإرسال: إلحاق CRC ثم الحساب يعطي صفرا
بيانات = بايتات("test")
crc = crc16(بيانات)
مع_تحقق = بيانات + [crc % 256, crc // 256]
تأكد_يساوي(crc16(مع_تحقق), 0, "البيانات مع CRC تصفر")
اطبع "crc(123456789):", crc16(بايتات("123456789"))
