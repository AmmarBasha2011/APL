# مثال 48 — تحليل نص متقدم
# Advanced Text Analysis
# Demonstrates: regex, textwrap, statistics, string methods
#
# Run:  python apl.py examples/48-text-analyzer-advanced.apl

المتغير النص = "Python is powerful. Python is simple. Python is everywhere! Is Python easy? Yes."

دالة_كلمات(نص):
    ارجع دالة_تقسيم(إزالة_التفافات(نص), " ")

دالة_عدد_يحتوي(نص, كلمة):
    العد = 0
    لكل جزء in دالة_كلمات(نص):
        إذا جزء == كلمة:
            العد = العد + 1
    ارجع العد

دالة_جمل(نص):
    جديد = نص.استبدال(".", "|").استبدال("!", "|").استبدال("?", "|")
    ارجع دالة_تقسيم(جديد, "|")

اطبع "=== تحليل نص متقدم ==="
اطبع ""
اطبع "النص: " + النص
اطبع ""
اطبع "عدد الكلمات: " + نص(طول(دالة_كلمات(النص)))
اطبع "عدد الجمل:  " + نص(طول(دالة_جمل(النص)))
اطبع ""
اطبع "--- تكرار الكلمات ---"
اطبع "  Python: " + نص(دالة_عدد_يحتوي(النص, "Python"))
اطبع "  is:     " + نص(دالة_عدد_يحتوي(النص, "is"))
اطبع ""
اطبع "--- ملخص ملتف ---"
اطبع الالتفاف_نص(إزالة_التفافات(النص), 40)
