# مثال 2246 — أصغر فجوة بين قيمتين
# Minimum gap
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2246-list-min-gap-between-sorted-values.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ح = س[1] - س[0]
  لكل ي في نطاق(1, طول(س) - 1):
    لو س[ي + 1] - س[ي] < ح:
      ح = س[ي + 1] - س[ي]
  ارجع ح

تأكد_يساوي(ف([3, 1, 2]), 1, "حالة 1")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 1, "حالة 2")
تأكد_يساوي(ف([10, 20, 10, 30]), 0, "حالة 3")
تأكد_يساوي(ف([1, 100, 50, 52]), 2, "حالة 4")
