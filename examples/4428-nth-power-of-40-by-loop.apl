# مثال 4428 — قوة 40 بالحلقة
# Power of 40 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4428-nth-power-of-40-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 40
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 40, "حالة 2")
تأكد_يساوي(ف(3), 64000, "حالة 3")
تأكد_يساوي(ف(6), 4096000000, "حالة 4")
تأكد_يساوي(ف(10), 10485760000000000, "حالة 5")
