# مثال 2676 — السعر مع ضريبة 5 بالمئة
# Price with 5 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2676-price-with-5-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 5 // 100

تأكد_يساوي(ف(100), 105, "حالة 1")
تأكد_يساوي(ف(250), 262, "حالة 2")
تأكد_يساوي(ف(999), 1048, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
