# مثال 4068 — إضافة 58 لكل عنصر
# Add 58 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4068-list-add-58-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 58]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [61, 59, 60], "حالة 1")
تأكد_يساوي(ف([5]), [63], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [59, 60, 61, 62, 63, 64], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [56, 58, 65, 65, 62], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [68, 78, 68, 88, 78, 68], "حالة 5")
