# مثال 1336 — قفزات ثلاثة
# Jump game III reach zero
# Demonstrates: بحث بالعرض
#
# Run:  python apl.py examples/1336-jump-game-three.apl

# من الموضع i نقفز إلى i زائد أو ناقص القيمة
# نستخدم البحث بالعرض مع الزيارات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يصل_صفر(مصفوفة, بداية):
  ن = طول(مصفوفة)
  مرئي = [خطأ] * ن
  طابور = [بداية]
  مرئي[بداية] = صواب
  ع = 0
  طالما ع < طول(طابور):
    ق = طابور[ع]
    ع = ع + 1
    لو مصفوفة[ق] == 0:
      ارجع صواب
    لكل ن_ في [ق + مصفوفة[ق], ق - مصفوفة[ق]]:
      لو (ن_ >= 0) و (ن_ < ن):
        لو ليس مرئي[ن_]:
          مرئي[ن_] = صواب
          طابور.ألحق(ن_)
  ارجع خطأ

تأكد_يساوي(يصل_صفر([4,2,3,0,3,1,2], 5), صواب, "ممكن")
تأكد_يساوي(يصل_صفر([3,0,2,1,2], 2), خطأ, "غير ممكن")
تأكد_يساوي(يصل_صفر([0], 0), صواب, "في البداية")
