# مثال 3950 — السعر بعد خصم 35 بالمئة
# Price after 35 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3950-price-after-35-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 35 // 100

تأكد_يساوي(ف(100), 65, "حالة 1")
تأكد_يساوي(ف(250), 163, "حالة 2")
تأكد_يساوي(ف(999), 650, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
