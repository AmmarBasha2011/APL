# مثال 1755 — توليد الأقواس المتوازنة
# Generate balanced parentheses
# Demonstrates: توافيق
#
# Run:  python apl.py examples/1755-generate-parentheses-all.apl

# لا نغلق أكثر مما فتحنا
# نتوقف عند الطول الكامل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ولّد(ن):
  ناتج = []
  دالة_تراجع = 0
  مكدس = [["", 0, 0]]
  طالما طول(مكدس) > 0:
    ح = مكدس.pop()
    لو طول(ح[0]) == 2 * ن:
      ناتج.append(ح[0])
    والا:
      لو ح[2] < ح[1]:
        مكدس.append([ح[0] + ")", ح[1], ح[2] + 1])
      لو ح[1] < ن:
        مكدس.append([ح[0] + "(", ح[1] + 1, ح[2]])
  ناتج.sort()
  ارجع ناتج

تأكد_يساوي(ولّد(1), ["()"], "واحد")
تأكد_يساوي(ولّد(2), ["(())", "()()"], "اثنان")
تأكد_يساوي(طول(ولّد(4)), 14, "أربعة")
