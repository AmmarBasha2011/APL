# مثال 374 — خط إنتاج واستهلاك مبسط
# Simple async producer/consumer
# Demonstrates: قائمة مشتركة بين مهام
#
# Run:  python apl.py examples/374-async-pipeline.apl

async def منتج(عناصر):
    لكل ي في نطاق(5):
        عناصر.أضف(ي * ي)
        await نوم(0.001)

async def مستهلك(عناصر, مجموع):
    طالما طول(عناصر) > 0:
        مجموع["قيمة"] = مجموع["قيمة"] + عناصر.pop(0)
        await نوم(0)

async def الرئيسية():
    المتغير عناصر = []
    المتغير مجموع = {"قيمة": 0}
    await منتج(عناصر)
    await مستهلك(عناصر, مجموع)
    اطبع "مجموع المربعات:", مجموع["قيمة"]

شغل_تزامن(الرئيسية())
