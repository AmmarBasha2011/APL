# مثال 4267 — إضافة 62 لكل عنصر
# Add 62 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4267-list-add-62-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 62]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [65, 63, 64], "حالة 1")
تأكد_يساوي(ف([5]), [67], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [63, 64, 65, 66, 67, 68], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [60, 62, 69, 69, 66], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [72, 82, 72, 92, 82, 72], "حالة 5")
