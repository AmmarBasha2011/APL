# مثال 526 — مقارنة نصين سطرياً
# Line diff via LCS
# Demonstrates: أطول تتابع مشترك، فرق سطور
#
# Run:  python apl.py examples/526-line-diff.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# مقارنة نصين سطرياً بأطول تتابع مشترك
دالة فرق_سطور(قديم, جديد):
    المتغير ن = طول(قديم)
    المتغير م = طول(جديد)
    المتغير جدول = قائمة()
    لكل i في نطاق(ن + 1):
        المتغير صف = [0]
        لكل j في نطاق(م):
            صف.أضف(0)
        جدول.أضف(صف)
    لكل i في نطاق(1, ن + 1):
        لكل j في نطاق(1, م + 1):
            لو قديم[i - 1] == جديد[j - 1]:
                جدول[i][j] = جدول[i - 1][j - 1] + 1
            الا:
                جدول[i][j] = أكبر(جدول[i - 1][j], جدول[i][j - 1])
    المتغير تغييرات = قائمة()
    المتغير i = ن
    المتغير j = م
    طالما i > 0 أو j > 0:
        لو i > 0 و j > 0 و قديم[i - 1] == جديد[j - 1]:
            تغييرات.أضف("  " + قديم[i - 1])
            i = i - 1
            j = j - 1
        الا لو j > 0 و (i == 0 أو جدول[i][j - 1] >= جدول[i - 1][j]):
            تغييرات.أضف("+ " + جديد[j - 1])
            j = j - 1
        الا:
            تغييرات.أضف("- " + قديم[i - 1])
            i = i - 1
    ارجع تغييرات[::-1]

المتغير نتيجة = فرق_سطور(["أ", "ب", "ج"], ["أ", "ج", "د"])
لكل سطر في نتيجة:
    اطبع سطر
تأكد_يساوي(نتيجة, ["  أ", "- ب", "  ج", "+ د"], "فرق سطور")
