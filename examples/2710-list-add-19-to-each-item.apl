# مثال 2710 — إضافة 19 لكل عنصر
# Add 19 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2710-list-add-19-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 19]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [22, 20, 21], "حالة 1")
تأكد_يساوي(ف([5]), [24], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [20, 21, 22, 23, 24, 25], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [17, 19, 26, 26, 23], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [29, 39, 29, 49, 39, 29], "حالة 5")
