# مثال 3977 — مساحة دائرة بتقريب 73
# Circle area with pi approx 73/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3977-square-of-radius-times-73-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 73 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 10, "حالة 2")
تأكد_يساوي(ف(7), 511, "حالة 3")
تأكد_يساوي(ف(14), 2044, "حالة 4")
تأكد_يساوي(ف(21), 4599, "حالة 5")
