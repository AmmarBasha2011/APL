# مثال 3409 — متتالية أ=11×السابق+1
# Recurrence times 11 plus one
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/3409-linear-recurrence-a-n-equals-11-times-previous-plus-one.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 1
  لكل ي في نطاق(ن):
    أ = أ * 11 + 1
  ارجع أ

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 12, "حالة 2")
تأكد_يساوي(ف(2), 133, "حالة 3")
تأكد_يساوي(ف(5), 177156, "حالة 4")
تأكد_يساوي(ف(8), 235794769, "حالة 5")
