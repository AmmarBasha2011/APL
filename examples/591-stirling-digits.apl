# مثال 591 — أرقام المضروب
# Factorial digit count
# Demonstrates: لوغاريتمات، مضروب، ستيرلنغ
#
# Run:  python apl.py examples/591-stirling-digits.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# عدد أرقام المضروب دون حسابه (ستيرلنغ/لوغاريتمات)
# Demonstrates: لوغاريتم_10, جمع اللوغاريتمات بدل الضرب, تجنب الأعداد الهائلة
# 100! عدد من 158 رقما لا يمكن حسابه مباشرة بسهولة

دالة عدد_الأرقام(ن):
  مجموع = 0
  لكل ي في نطاق(1, ن + 1):
    مجموع = مجموع + لوغاريتم_10(ي)
  ارجع صحيح(مجموع) + 1

تأكد_يساوي(عدد_الأرقام(5), 3, "120 فيه 3 أرقام")
تأكد_يساوي(عدد_الأرقام(10), 7, "3628800 فيه 7 أرقام")
تأكد_يساوي(عدد_الأرقام(100), 158, "100 مضروب 158 رقما")
اطبع "عدد أرقام 100!:", عدد_الأرقام(100)
