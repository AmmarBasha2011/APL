# مثال 3378 — السعر مع ضريبة 22 بالمئة
# Price with 22 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3378-price-with-22-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 22 // 100

تأكد_يساوي(ف(100), 122, "حالة 1")
تأكد_يساوي(ف(250), 305, "حالة 2")
تأكد_يساوي(ف(999), 1218, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
