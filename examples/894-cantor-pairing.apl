# مثال 894 — إقران كانتور
# Cantor pairing
# Demonstrates: تشفير زوج في عدد واحد
#
# Run:  python apl.py examples/894-cantor-pairing.apl

# دالة كانتور للإقران: تشفير زوج أعداد طبيعية في عدد واحد
# π(a,b) = (a+b)(a+b+1)/2 + b قابلة للعكس حسابياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أقرن(أ, ب):
  مجموع = أ + ب
  ارجع مجموع * (مجموع + 1) // 2 + ب

دالة فك_إقران(ز):
  # أكبر مثلثي لا يتجاوز ز بالبحث الثنائي
  أدنى = 0
  أعلى = 1
  طالما أعلى * (أعلى + 1) // 2 <= ز:
    أعلى = أعلى * 2
  طالما أدنى + 1 < أعلى:
    وسط = (أدنى + أعلى) // 2
    لو وسط * (وسط + 1) // 2 <= ز:
      أدنى = وسط
    والا:
      أعلى = وسط
  مثلثي = أدنى * (أدنى + 1) // 2
  ب = ز - مثلثي
  أ = أدنى - ب
  ارجع [أ, ب]

اطبع "π(3,5) =", أقرن(3, 5)
اطبع "π(0,0) =", أقرن(0, 0)
اطبع "π(4,1) =", أقرن(4, 1)

تأكد_يساوي(أقرن(3, 5), 41, "π(3,5) = 41")
تأكد_يساوي(أقرن(0, 0), 0, "π(0,0) = 0")
تأكد_يساوي(أقرن(4, 1), 16, "π(4,1) = 16")

# الفك يعيد الزوج
زوج = فك_إقران(41)
تأكد_يساوي(زوج[0], 3, "فك 41: الأول")
تأكد_يساوي(زوج[1], 5, "فك 41: الثاني")

# طي وفك لشبكة 10x10
لكل أ في نطاق(10):
  لكل ب في نطاق(10):
    مفكوك = فك_إقران(أقرن(أ, ب))
    تأكد_يساوي(مفكوك[0], أ, "فك أ عند " + نص(أ) + "," + نص(ب))
    تأكد_يساوي(مفكوك[1], ب, "فك ب عند " + نص(أ) + "," + نص(ب))
