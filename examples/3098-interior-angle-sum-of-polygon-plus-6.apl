# مثال 3098 — مجموع زوايا مضلع زائد 6
# Polygon angle sum plus 6
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3098-interior-angle-sum-of-polygon-plus-6.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 6

تأكد_يساوي(ف(3), 186, "حالة 1")
تأكد_يساوي(ف(4), 366, "حالة 2")
تأكد_يساوي(ف(5), 546, "حالة 3")
تأكد_يساوي(ف(6), 726, "حالة 4")
تأكد_يساوي(ف(12), 1806, "حالة 5")
