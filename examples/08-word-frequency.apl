# مثال 8 — عدّاد الكلمات الم unique مع itertools
# Word Frequency Counter
# Demonstrates: itertools, collections.Counter, dictionaries, sorting
#
# Run:  python apl.py examples/08-word-frequency.apl

المتغير النص = "APL لغة برمجة عربية. APL تترجم الكود إلى Python. لغة APL بسيطة وسريعة"

المتغير الكلمات = تقسيم(إزالة_التفافات(النص), " ")

التكرار = {}
لكل كلمة في الكلمات:
    نظيفة = تقليم(كلمة, ".,")
    إذا طول(نظيفة) > 0:
        إذا نظيفة في التكرار:
            التكرار[نظيفة] = التكرار[نظيفة] + 1
        والا:
            التكرار[نظيفة] = 1

اطبع "=== عدّاد تكرار الكلمات ==="
اطبع "عدد الكلمات الكلي: " + نص(طول(الكلمات))
اطبع "عدد الكلمات الفريدة: " + نص(طول(التكرار))
اطبع ""

اطبع "--- الكلمات المتكررة ---"
مفتاح_الأكثر = ""
أعلى_عدد = 0
لكل كلمة في التكرار:
    إذا التكرار[كلمة] > أعلى_عدد:
        أعلى_عدد = التكرار[كلمة]
        مفتاح_الأكثر = كلمة

اطبع "الأكثر تكراراً: " + مفتاح_الأكثر + " (" + نص(أعلى_عدد) + " مرات)"
