# مثال 4269 — إضافة 64 لكل عنصر
# Add 64 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4269-list-add-64-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 64]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [67, 65, 66], "حالة 1")
تأكد_يساوي(ف([5]), [69], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [65, 66, 67, 68, 69, 70], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [62, 64, 71, 71, 68], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [74, 84, 74, 94, 84, 74], "حالة 5")
