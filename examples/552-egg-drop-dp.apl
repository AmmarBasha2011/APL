# مثال 552 — لغز إسقاط البيض
# Egg drop DP
# Demonstrates: برمجة ديناميكية، لغز البيض، أسوأ حالة
#
# Run:  python apl.py examples/552-egg-drop-dp.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# لغز البيض: أقل محاولات مضمونة (برمجة ديناميكية)
دالة أقل_محاولات(بيض, طوابق):
    المتغير جدول = قائمة()
    لكل i في نطاق(بيض + 1):
        جدول.أضف([0] * (طوابق + 1))
    لكل طابق في نطاق(1, طوابق + 1):
        جدول[1][طابق] = طابق
    لكل ب في نطاق(2, بيض + 1):
        لكل طابق في نطاق(1, طوابق + 1):
            المتغير أدنى = 999999
            لكل محاولة في نطاق(1, طابق + 1):
                المتغير أسوأ = 1 + أكبر(جدول[ب - 1][محاولة - 1], جدول[ب][طابق - محاولة])
                لو أسوأ < أدنى:
                    أدنى = أسوأ
            جدول[ب][طابق] = أدنى
    ارجع جدول[بيض][طوابق]

تأكد_يساوي(أقل_محاولات(2, 10), 4, "بيضتان و10 طوابق")
تأكد_يساوي(أقل_محاولات(1, 5), 5, "بيضة واحدة")
تأكد_يساوي(أقل_محاولات(2, 100), 14, "بيضتان و100 طابق")
