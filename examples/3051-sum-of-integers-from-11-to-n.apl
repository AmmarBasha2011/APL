# مثال 3051 — مجموع الأعداد من 11 إلى ن
# Sum from 11 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3051-sum-of-integers-from-11-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(11, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(11), 11, "حالة 1")
تأكد_يساوي(ف(12), 23, "حالة 2")
تأكد_يساوي(ف(21), 176, "حالة 3")
تأكد_يساوي(ف(100), 4995, "حالة 4")
