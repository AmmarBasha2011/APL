# مثال 151 — الاختزال بدوال العوامل
# Reduce with operator functions
# Demonstrates: اختصر_دالة، عامل_جمع، عامل_ضرب
#
# Run:  python apl.py examples/151-functools-reduce.apl

المتغير أرقام = [1, 2, 3, 4, 5]
اطبع "المجموع:", اختصر_دالة((أ, ب) => أ + ب, أرقام)
اطبع "الجداء:", اختصر_دالة((أ, ب) => أ * ب, أرقام)
اطبع "مع بداية 100:", اختصر_دالة((أ, ب) => أ + ب, أرقام, 100)

المتغير كلمات = ["APL", "لغة", "عربية"]
اطبع "دمج:", اختصر_دالة((أ, ب) => أ + " " + ب, كلمات)
