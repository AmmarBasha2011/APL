# مثال 1648 — العدد المثلثي
# Triangular number check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1648-triangular-number-check.apl

# نضيف ك تباعاً
# نتوقف حين يبلغ المجموع العدد أو يتجاوزه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مثلثي(ن):
  مجموع = 0
  ك = 0
  طالما مجموع < ن:
    ك = ك + 1
    مجموع = مجموع + ك
  ارجع مجموع == ن

تأكد_يساوي(مثلثي(6), صواب, "ستة")
تأكد_يساوي(مثلثي(10), صواب, "عشرة")
تأكد_يساوي(مثلثي(8), خطأ, "ثمانية")
تأكد_يساوي(مثلثي(1), صواب, "واحد")
