# مثال 1100 — الجملة الشاملة
# Check if a sentence is a pangram
# Demonstrates: جرد الحروف
#
# Run:  python apl.py examples/1100-check-pangram.apl

# نمر على حروف الأبجدية اللاتينية
# ونتحقق أن كل حرف يظهر في الجملة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة شاملة(جملة):
  لكل ح في "abcdefghijklmnopqrstuvwxyz":
    لو ح ليس في جملة:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(شاملة("thequickbrownfoxjumpsoverthelazydog"), صواب, "الجملة الشهيرة")
تأكد_يساوي(شاملة("leetcode"), خطأ, "ناقصة")
تأكد_يساوي(شاملة(""), خطأ, "فارغة")
