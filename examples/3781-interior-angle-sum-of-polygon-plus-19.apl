# مثال 3781 — مجموع زوايا مضلع زائد 19
# Polygon angle sum plus 19
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3781-interior-angle-sum-of-polygon-plus-19.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 19

تأكد_يساوي(ف(3), 199, "حالة 1")
تأكد_يساوي(ف(4), 379, "حالة 2")
تأكد_يساوي(ف(5), 559, "حالة 3")
تأكد_يساوي(ف(6), 739, "حالة 4")
تأكد_يساوي(ف(12), 1819, "حالة 5")
