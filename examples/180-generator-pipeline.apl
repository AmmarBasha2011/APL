# مثال 180 — خط معالجة متسلسل
# A chained processing pipeline
# Demonstrates: دوال الترتيب العليا المتسلسلة، دالة_مجردة
#
# Run:  python apl.py examples/180-generator-pipeline.apl

دالة نطاق_أعداد(ن):
    المتغير نتيجة = []
    لكل س في نطاق(1, ن + 1):
        نتيجة.أضف(س)
    ارجع نتيجة

المتغير أعداد = نطاق_أعداد(10)
اطبع "الأعداد:", أعداد

المتغير زوجية = قائمة(فلترة_قائمة((س) => س % 2 == 0, أعداد))
اطبع "الزوجية:", زوجية

المتغير مربعات = قائمة(تحويل_قائمة((س) => س * س, زوجية))
اطبع "مربعاتها:", مربعات

المتغير مجموع = 0
لكل م في مربعات:
    مجموع = مجموع + م
اطبع "المجموع:", مجموع

المتغير أول_ثلاثة = مربعات[0:3]
اطبع "أول ثلاثة مربعات:", أول_ثلاثة
