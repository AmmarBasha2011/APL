# مثال 544 — سلم الكلمات
# Word ladder BFS
# Demonstrates: BFS، تحويل كلمات، أقصر مسار
#
# Run:  python apl.py examples/544-word-ladder.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# سلم الكلمات: أقصر تحويل بحرف واحد (BFS)
دالة سلم(بداية, نهاية, قاموس_كلمات):
    المتغير طابور = [[بداية, 1]]
    المتغير مزارة = [بداية]
    طالما طول(طابور) > 0:
        المتغير عنصر = طابور.pop(0)
        المتغير كلمة = عنصر[0]
        المتغير عمق = عنصر[1]
        لو كلمة == نهاية:
            ارجع عمق
        لكل مرشحة في قاموس_كلمات:
            لو مرشحة ليس في مزارة:
                المتغير اختلاف = 0
                لكل i في نطاق(طول(كلمة)):
                    لو كلمة[i] != مرشحة[i]:
                        اختلاف = اختلاف + 1
                لو اختلاف == 1:
                    مزارة.أضف(مرشحة)
                    طابور.أضف([مرشحة, عمق + 1])
    ارجع 0

المتغير قاموس_كلمات = ["hot", "dot", "dog", "lot", "log", "cog"]
تأكد_يساوي(سلم("hit", "cog", قاموس_كلمات), 5, "hit إلى cog في 5")
تأكد_يساوي(سلم("hit", "zzz", ["hot"]), 0, "لا مسار")
