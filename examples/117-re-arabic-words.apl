# مثال 117 — البحث عن الكلمات العربية في نص
# Finding Arabic words with regex
# Demonstrates: بحث_شامل، بحث_نمطي، طول
#
# Run:  python apl.py examples/117-re-arabic-words.apl

المتغير نص = "تعلم APL سهل لأنها لغة برمجة بالعربية وتدعم Python بالكامل"

المتغير عربي = بحث_شامل("[ء-ي]+", نص)
اطبع "الكلمات العربية:", عربي
اطبع "عددها:", طول(عربي)

المتغير إنجليزي = بحث_شامل("[A-Za-z]+", نص)
اطبع "الكلمات الإنجليزية:", إنجليزي

المتغير م = بحث_نمطي("برمجة", نص)
اطبع "كلمة برمجة موجودة؟", م != لا_شيء
