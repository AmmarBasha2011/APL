# مثال 1787 — أطول متتالية كولاتز
# Longest Collatz chain under limit
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1787-collatz-longest-under-limit.apl

# نحسب طول كل متتالية
# نحتفظ بالأطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة طول_كولاتز(ن):
  عد = 1
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    عد = عد + 1
  ارجع عد

دالة أطول_بداية(حد):
  أفضل = 1
  طول_أفضل = 1
  لكل ك في نطاق(1, حد):
    ط = طول_كولاتز(ك)
    لو ط > طول_أفضل:
      طول_أفضل = ط
      أفضل = ك
  ارجع أفضل

تأكد_يساوي(طول_كولاتز(27), 112, "سبعة وعشرون")
تأكد_يساوي(أطول_بداية(10), 9, "تحت عشرة")
تأكد_يساوي(أطول_بداية(30), 27, "تحت ثلاثين")
