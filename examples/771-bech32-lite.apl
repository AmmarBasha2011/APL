# مثال 771 — ترميز bech32
# bech32 encoding
# Demonstrates: polymod، GF(32)، توسيع hrp
#
# Run:  python apl.py examples/771-bech32-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ترميز bech32 (BIP 173): مجموع تحقق polymod فوق GF(32)
# Demonstrates: متعددة حدود مودولو, توسيع hrp, محارف qpzry9x8

محارف = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"

دالة سداسي_عدد(س):
  سداسي = "0123456789abcdef"
  قيمة = 0
  لكل حرف في س:
    قيمة = قيمة * 16 + سداسي.index(حرف)
  ارجع قيمة

دالة قوة_اثنان(ي):
  ق = 1
  لكل ج في نطاق(ي):
    ق = ق * 2
  ارجع ق

دالة بوليمود(قيم):
  معاملات = [سداسي_عدد("3b6a57b2"), سداسي_عدد("26508e6d"), سداسي_عدد("1ea119fa"), سداسي_عدد("3d4233dd"), سداسي_عدد("2a1462b3")]
  تحقق = 1
  لكل ق في قيم:
    اعلى = تحقق // 33554432
    تحقق = (تحقق % 33554432) * 32 ^ ق
    لكل ي في نطاق(5):
      لو (اعلى // قوة_اثنان(ي)) % 2 == 1:
        تحقق = تحقق ^ معاملات[ي]
  ارجع تحقق

دالة توسيع(hrp):
  ناتج = []
  لكل حرف في hrp:
    ناتج.append(ترميز_حرف(حرف) // 32)
  ناتج.append(0)
  لكل حرف في hrp:
    ناتج.append(ترميز_حرف(حرف) % 32)
  ارجع ناتج

دالة بيك32_ترميز(hrp, بيانات):
  قيم = توسيع(hrp) + بيانات + [0, 0, 0, 0, 0, 0]
  بم = بوليمود(قيم) ^ 1
  ناتج = hrp + "1"
  لكل د في بيانات:
    ناتج = ناتج + محارف[د]
  لكل ي في نطاق(6):
    ناتج = ناتج + محارف[(بم // قوة_اثنان(5 * (5 - ي))) % 32]
  ارجع ناتج

دالة بيك32_تحقق(شفرة):
  موضع = 0 - 1
  لكل ي في نطاق(طول(شفرة)):
    لو شفرة[ي] == "1":
      موضع = ي
  لو موضع < 1:
    ارجع خطأ
  hrp = شفرة[0:موضع]
  بيانات = []
  لكل ي في نطاق(موضع + 1, طول(شفرة)):
    لو (شفرة[ي] في محارف) == خطأ:
      ارجع خطأ
    بيانات.append(محارف.index(شفرة[ي]))
  ارجع بوليمود(توسيع(hrp) + بيانات) == 1

تأكد_يساوي(بيك32_ترميز("a", []), "a12uel5l", "متجه BIP173: a")
تأكد_يساوي(بيك32_ترميز("test", []), "test12hrzfj", "ترميز test")
تأكد_يساوي(بيك32_تحقق("a12uel5l"), صواب, "تحقق صالح")
تأكد_يساوي(بيك32_تحقق("a12uel5m"), خطأ, "تحقق فاسد")
تأكد_يساوي(بيك32_تحقق(بيك32_ترميز("bc", [0, 31, 7, 15])), صواب, "ذهاب وإياب ببيانات")
