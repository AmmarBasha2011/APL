# مثال 1298 — اختيار موزون
# Weighted random pick index
# Demonstrates: مجاميع تراكمية
#
# Run:  python apl.py examples/1298-random-pick-weight.apl

# نبني مجاميع تراكمية للأوزان
# وعدد عشوائي يقع في مجال فهرس معين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف موزون:
  دالة_إنشاء(ذات, اوزان):
    ذات.تراكمي = []
    مج = 0
    لكل و في اوزان:
      مج = مج + و
      ذات.تراكمي.ألحق(مج)
    ذات.كل = مج

  دالة اختر(ذات, عدد_):
    ع = عدد_ % ذات.كل
    ي = 0
    ن = طول(ذات.تراكمي) - 1
    طالما ي < ن:
      م = (ي + ن) // 2
      لو ذات.تراكمي[م] > ع:
        ن = م
      والا:
        ي = م + 1
    ارجع ي

م = موزون([1, 3])
نتائج = []
لكل ع في نطاق(4):
  نتائج.ألحق(م.اختر(ع))
تأكد_يساوي(نتائج, [0, 1, 1, 1], "توزيع")
تأكد_يساوي(م.اختر(4), 0, "التفاف")
