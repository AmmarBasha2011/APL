# مثال 4305 — الحد النوني بخطوة 60
# Nth term step 60
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4305-nth-term-arithmetic-sequence-step-60.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 60

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 63, "حالة 2")
تأكد_يساوي(ف(10), 543, "حالة 3")
تأكد_يساوي(ف(100), 5943, "حالة 4")
