# مثال 2267 — عدد توأم الأولية
# Twin prime pairs count
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2267-twin-prime-pairs-count-below.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  د = 2
  طالما د * د <= ن:
    لو ن % د == 0:
      ارجع خطأ
    د = د + 1
  ارجع صواب

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(2, ن - 1):
    لو اولي(ي) و اولي(ي + 2):
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(10), 2, "حالة 1")
تأكد_يساوي(ف(20), 4, "حالة 2")
تأكد_يساوي(ف(50), 6, "حالة 3")
تأكد_يساوي(ف(100), 8, "حالة 4")
