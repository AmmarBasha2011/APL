# مثال 977 — مرشح الوسيط
# Median filter
# Demonstrates: وسيط نافذة محلية
#
# Run:  python apl.py examples/977-median-filter.apl

# مرشح الوسيط: إزالة الارتفاعات المفاجئة من إشارة
# كل قيمة تُستبدل بوسيط نافذتها المحلية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رتب(عناصر):
  مرتبة = []
  لكل س في عناصر:
    وضع = طول(مرتبة)
    لكل ف في نطاق(طول(مرتبة)):
      لو (س < مرتبة[ف]) و (وضع == طول(مرتبة)):
        وضع = ف
    مرتبة.ألحق(س)
    لكل ج في نطاق(طول(مرتبة) - 1, وضع, -1):
      مرتبة[ج] = مرتبة[ج - 1]
    مرتبة[وضع] = س
  ارجع مرتبة

دالة مرشح_وسيط(إشارة):
  ناتج = []
  لكل i في نطاق(طول(إشارة)):
    بداية = i - 1
    لو بداية < 0:
      بداية = 0
    نهاية = i + 2
    لو نهاية > طول(إشارة):
      نهاية = طول(إشارة)
    نافذة = رتب(إشارة[بداية:نهاية])
    ناتج.ألحق(نافذة[طول(نافذة) // 2])
  ارجع ناتج

ناتج = مرشح_وسيط([2, 80, 6, 3, 1])
تأكد_يساوي(طول(ناتج), 5, "طول الناتج")
تأكد_يساوي(ناتج[1], 6, "إزالة الارتفاع المفاجئ")
تأكد_يساوي(ناتج[2], 6, "الوسيط الأوسط")
تأكد_يساوي(ناتج[3], 3, "الوسيط الرابع")
تأكد_يساوي(ناتج[4], 3, "حافة النهاية")
