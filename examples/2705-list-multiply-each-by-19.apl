# مثال 2705 — ضرب كل عنصر في 19
# Multiply each item by 19
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2705-list-multiply-each-by-19.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 19]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [57, 19, 38], "حالة 1")
تأكد_يساوي(ف([5]), [95], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [19, 38, 57, 76, 95, 114], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-38, 0, 133, 133, 76], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [190, 380, 190, 570, 380, 190], "حالة 5")
