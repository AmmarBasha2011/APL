# مثال 3792 — مجموع المربعات من 17 إلى ن
# Sum of squares from 17
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3792-sum-of-squares-from-17-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(17, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(17), 289, "حالة 1")
تأكد_يساوي(ف(18), 613, "حالة 2")
تأكد_يساوي(ف(27), 5434, "حالة 3")
تأكد_يساوي(ف(100), 336854, "حالة 4")
