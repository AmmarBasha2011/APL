# مثال 4268 — إضافة 63 لكل عنصر
# Add 63 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4268-list-add-63-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 63]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [66, 64, 65], "حالة 1")
تأكد_يساوي(ف([5]), [68], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [64, 65, 66, 67, 68, 69], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [61, 63, 70, 70, 67], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [73, 83, 73, 93, 83, 73], "حالة 5")
