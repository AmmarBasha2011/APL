# مثال 783 — منحنى التنين
# Dragon curve
# Demonstrates: طي ورقة، عكس وقلب
#
# Run:  python apl.py examples/783-dragon-curve.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# منحنى التنين: متتالية طي الورقة يمين/يسار
# Demonstrates: s(n+1) = s(n) + R + عكس(قلب(s(n))), طول 2^n - 1

دالة قلب(س):
  ناتج = ""
  لكل حرف في س:
    لو حرف == "R":
      ناتج = ناتج + "L"
    والا:
      ناتج = ناتج + "R"
  ارجع ناتج

دالة عكس(س):
  ناتج = ""
  لكل ي في نطاق(طول(س)):
    ناتج = ناتج + س[طول(س) - 1 - ي]
  ارجع ناتج

دالة تنين(ن):
  س = ""
  لكل ي في نطاق(ن):
    س = س + "R" + عكس(قلب(س))
  ارجع س

تأكد_يساوي(تنين(1), "R", "طية 1")
تأكد_يساوي(تنين(2), "RRL", "طية 2")
تأكد_يساوي(تنين(3), "RRLRRLL", "طية 3")
تأكد_يساوي(تنين(4), "RRLRRLLRRRLLRLL", "طية 4")
تأكد_يساوي(طول(تنين(10)), 1023, "طول 2^10 - 1")
تأكد_يساوي(عكس("RRL"), "LRR", "عكس")
تأكد_يساوي(قلب("RRL"), "LLR", "قلب")
