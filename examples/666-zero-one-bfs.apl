# مثال 666 — بحث 0-1
# 0-1 BFS
# Demonstrates: أوزان صفرية، طابور بطرفين، تكلفة
#
# Run:  python apl.py examples/666-zero-one-bfs.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# بحث 0-1: دايكسترا بتكاليف صفر وواحد
# Demonstrates: طابور بطرفين, دفع أمامي وخلفي, أقصر تكلفة
# أسرع من دايكسترا العام عندما الأوزان صفرية أو واحدة

حواف = {"أ": [["ب", 0], ["ج", 1]], "ب": [["د", 1], ["ه", 0]], "ج": [["و", 0]], "د": [["ز", 0]], "ه": [["ز", 1]], "و": [["ز", 1]], "ز": []}
عقد = ["أ", "ب", "ج", "د", "ه", "و", "ز"]

دالة أقصر_صفر_واحد(بداية):
  تكلفة = {}
  لكل ع في عقد:
    تكلفة[ع] = 99
  تكلفة[بداية] = 0
  طابور = [بداية]
  طالما طول(طابور) > 0:
    حالي = طابور[0]
    طابور = طابور[1:]
    لكل ح في حواف[حالي]:
      جديدة = تكلفة[حالي] + ح[1]
      لو جديدة < تكلفة[ح[0]]:
        تكلفة[ح[0]] = جديدة
        لو ح[1] == 0:
          طابور.insert(0, ح[0])
        والا:
          طابور.append(ح[0])
  ارجع تكلفة

دالة أقصر_دايكسترا(بداية):
  تكلفة = {}
  محسومة = {}
  لكل ع في عقد:
    تكلفة[ع] = 99
  تكلفة[بداية] = 0
  طالما طول(محسومة) < طول(عقد):
    أدنى = 99
    عقدة_أدنى = ""
    لكل ع في عقد:
      لو (ع في محسومة) == خطأ و تكلفة[ع] < أدنى:
        أدنى = تكلفة[ع]
        عقدة_أدنى = ع
    لو عقدة_أدنى == "":
      ارجع تكلفة
    محسومة[عقدة_أدنى] = صواب
    لكل ح في حواف[عقدة_أدنى]:
      لو تكلفة[عقدة_أدنى] + ح[1] < تكلفة[ح[0]]:
        تكلفة[ح[0]] = تكلفة[عقدة_أدنى] + ح[1]
  ارجع تكلفة

أ = أقصر_صفر_واحد("أ")
ب = أقصر_دايكسترا("أ")
لكل ع في عقد:
  تأكد_يساوي(أ[ع], ب[ع], "تطابق مع دايكسترا")
تأكد_يساوي(أ["ز"], 1, "تكلفة الوصول إلى ز")
اطبع "تكاليف من أ:", أ
