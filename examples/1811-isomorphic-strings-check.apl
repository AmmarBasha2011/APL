# مثال 1811 — نصان متماثلان في النمط
# Isomorphic strings
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1811-isomorphic-strings-check.apl

# نربط الحرف بمقابله
# نتحقق من الاتجاهين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متماثلان(أ, ب):
  لو طول(أ) != طول(ب):
    ارجع خطأ
  خريطة1 = {}
  خريطة2 = {}
  لكل ك في نطاق(طول(أ)):
    لو أ[ك] في خريطة1:
      لو خريطة1[أ[ك]] != ب[ك]:
        ارجع خطأ
    والا:
      خريطة1[أ[ك]] = ب[ك]
    لو ب[ك] في خريطة2:
      لو خريطة2[ب[ك]] != أ[ك]:
        ارجع خطأ
    والا:
      خريطة2[ب[ك]] = أ[ك]
  ارجع صواب

تأكد_يساوي(متماثلان("egg", "add"), صواب, "نمط")
تأكد_يساوي(متماثلان("foo", "bar"), خطأ, "مختلفان")
تأكد_يساوي(متماثلان("ab", "aa"), خطأ, "اتجاه")
