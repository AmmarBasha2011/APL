# مثال 3622 — قوة 2 بالحلقة
# Power of 2 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3622-nth-power-of-2-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 2
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(3), 8, "حالة 3")
تأكد_يساوي(ف(6), 64, "حالة 4")
تأكد_يساوي(ف(10), 1024, "حالة 5")
