# مثال 406 — اختبار سرعة الكتابة
# Typing speed test
# Demonstrates: حساب الكلمات في الدقيقة
#
# Run:  python apl.py examples/406-typing-test.apl

دالة سرعة_كتابة(نص_الأصل, نص_المكتوب, ثواني):
    المتغير كلمات_صحيحة = 0
    المتغير أصل = نص_الأصل.تقسيم(" ")
    المتغير مكتوب = نص_المكتوب.تقسيم(" ")
    المتغير أقصر = طول(أصل)
    لو طول(مكتوب) < أقصر:
        أقصر = طول(مكتوب)
    لكل ي في نطاق(أقصر):
        لو أصل[ي] == مكتوب[ي]:
            كلمات_صحيحة = كلمات_صحيحة + 1
    ارجع [كلمات_صحيحة * 60 / ثواني, كلمات_صحيحة * 100 / طول(أصل)]

المتغير نتيجة = سرعة_كتابة("البرمجة مهارة جميلة ومفيدة جدا", "البرمجة مهارة جميلة ومفيدة جدا", 20)
اطبع "كلمة في الدقيقة:", نتيجة[0]
اطبع "الدقة:", نص(نتيجة[1]) + "%"
