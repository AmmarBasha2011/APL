# مثال 295 — أطول مقدمة مشتركة
# Longest common prefix
# Demonstrates: مقارنة عمودية
#
# Run:  python apl.py examples/295-longest-common-prefix.apl

دالة مقدمة_مشتركة(نصوص):
    المتغير مقدمة = نصوص[0]
    لكل كلمة في نصوص:
        طالما كلمة[0:طول(مقدمة)] != مقدمة:
            مقدمة = مقدمة[0:طول(مقدمة) - 1]
            لو مقدمة == "":
                ارجع ""
    ارجع مقدمة

اطبع مقدمة_مشتركة(["flower", "flow", "flight"])
اطبع مقدمة_مشتركة(["dog", "racecar", "car"])
اطبع مقدمة_مشتركة(["برمجة", "برنامج", "برمائي"])
