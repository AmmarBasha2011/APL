# مثال 4168 — تحويل وحدة بأساس 43
# Split by base 43
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4168-minutes-to-hours-and-minutes-base-43.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 43, ن % 43]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 16], "حالة 2")
تأكد_يساوي(ف(60), [1, 17], "حالة 3")
تأكد_يساوي(ف(125), [2, 39], "حالة 4")
تأكد_يساوي(ف(1000), [23, 11], "حالة 5")
