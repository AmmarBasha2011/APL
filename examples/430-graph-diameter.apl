# مثال 430 — قطر الشجرة
# Tree diameter
# Demonstrates: مسحان متتاليان
#
# Run:  python apl.py examples/430-graph-diameter.apl

دالة أبعد(جيران, بداية):
    المتغير مسافات = {بداية: 0}
    المتغير قائمة = [بداية]
    المتغير أبعد_عقدة = بداية
    طالما طول(قائمة) > 0:
        المتغير عقدة = قائمة.pop(0)
        لكل جار in جيران[عقدة]:
            لو مسافات.get(جار) == لا_شيء:
                مسافات[جار] = مسافات[عقدة] + 1
                قائمة.append(جار)
                لو مسافات[جار] > مسافات[أبعد_عقدة]:
                    أبعد_عقدة = جار
    ارجع [أبعد_عقدة, مسافات[أبعد_عقدة]]

المتغير جيران = {0: [1], 1: [0, 2, 3], 2: [1, 4], 3: [1], 4: [2]}
المتغير أول = أبعد(جيران, 0)
المتغير ثان = أبعد(جيران, أول[0])
اطبع "القطر:", ثان[1]
