# مثال 1487 — هل القائمة مرتبة
# Is the list sorted
# Demonstrates: فرز
#
# Run:  python apl.py examples/1487-is-sorted-check.apl

# نقارن كل جارين
# نتتبع هل رأينا صعوداً وهبوطاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نوع_الترتيب(أ):
  صعود = خطأ
  هبوط = خطأ
  لكل ع في نطاق(1, طول(أ)):
    لو أ[ع] > أ[ع - 1]:
      صعود = صواب
    لو أ[ع] < أ[ع - 1]:
      هبوط = صواب
  لو صعود و هبوط:
    ارجع "غير مرتبة"
  لو هبوط:
    ارجع "تنازلية"
  ارجع "تصاعدية"

تأكد_يساوي(نوع_الترتيب([1, 2, 2, 5]), "تصاعدية", "صاعدة")
تأكد_يساوي(نوع_الترتيب([9, 4, 4, 1]), "تنازلية", "هابطة")
تأكد_يساوي(نوع_الترتيب([1, 3, 2]), "غير مرتبة", "مختلطة")
