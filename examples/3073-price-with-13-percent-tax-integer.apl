# مثال 3073 — السعر مع ضريبة 13 بالمئة
# Price with 13 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3073-price-with-13-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 13 // 100

تأكد_يساوي(ف(100), 113, "حالة 1")
تأكد_يساوي(ف(250), 282, "حالة 2")
تأكد_يساوي(ف(999), 1128, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
