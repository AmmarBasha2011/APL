# مثال 914 — تقدير المميزة الاحتمالي
# HyperLogLog
# Demonstrates: بادئات أصفار التجزئة
#
# Run:  python apl.py examples/914-hyperloglog.apl

# HyperLogLog: تقدير عدد العناصر المميزة بذاكرة صغيرة ثابتة
# يعتمد على أطوال بادئات الأصفار في التجزئة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

ماسك = 4294967295

# تجزئة 32-بت حتمية (تضاعيف ونشر)
دالة تجزئة(س):
  س = (س * 2654435761) % 4294967296
  س = (س ^ (س >> 16)) % 4294967296
  س = (س * 2246822519) % 4294967296
  س = (س ^ (س >> 13)) % 4294967296
  ارجع س

دالة تقدير_مميزة(قيم, بت):
  عدد_سجلات = 2 ** بت
  سجلات = []
  لكل _ في نطاق(عدد_سجلات):
    سجلات.ألحق(0)
  لكل v في قيم:
    س = تجزئة(v)
    مؤشر = س >> (32 - بت)
    باقي = (س * (2 ** بت)) % 4294967296
    رو = 1
    طالما (باقي & (2 ** 31)) == 0 و رو <= 32 - بت:
      رو = رو + 1
      باقي = (باقي * 2) % 4294967296
    لو رو > سجلات[مؤشر]:
      سجلات[مؤشر] = رو
  مجموع = 0
  لكل r في سجلات:
    مجموع = مجموع + 0.5 ** r
  ارجع صحيح(0.673 * عدد_سجلات * عدد_سجلات / مجموع)

قيم = []
لكل i في نطاق(100):
  قيم.ألحق(i)
تقدير = تقدير_مميزة(قيم, 4)
اطبع "التقدير لـ 100 عنصر:", تقدير

# التقدير قريب من المئة (خوارزمية احتمالية: نتسامح بهامش)
لو تقدير < 85:
  اطبع "فشل: التقدير منخفض جداً", تقدير
  قياسي_نظام_اخرج(1)
لو تقدير > 120:
  اطبع "فشل: التقدير مرتفع جداً", تقدير
  قياسي_نظام_اخرج(1)
اطبع "ناجح: التقدير ضمن الهامش"

# التكرارات لا تغيّر التقدير
مكررة = []
لكل i في نطاق(50):
  مكررة.ألحق(i)
  مكررة.ألحق(i)
  مكررة.ألحق(i)
تقدير2 = تقدير_مميزة(مكررة, 4)
اطبع "التقدير لـ 50 مميزاً مكررة:", تقدير2
لو تقدير2 < 40:
  اطبع "فشل: تقدير المكررة منخفض", تقدير2
  قياسي_نظام_اخرج(1)
لو تقدير2 > 80:
  اطبع "فشل: تقدير المكررة مرتفع", تقدير2
  قياسي_نظام_اخرج(1)
اطبع "ناجح: التكرار لا يؤثر"
# حتمية: نفس الدخل يعطي نفس التقدير تماماً
تأكد_يساوي(تقدير_مميزة(مكررة, 4), تقدير2, "حتمية التقدير")
