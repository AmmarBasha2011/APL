# مثال 2438 — مجموع قوى 2
# Sum of powers of 2
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2438-sum-of-powers-of-2-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 2 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(3), 15, "حالة 3")
تأكد_يساوي(ف(6), 127, "حالة 4")
تأكد_يساوي(ف(10), 2047, "حالة 5")
