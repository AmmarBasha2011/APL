# مثال 3266 — صف جدول ضرب 15
# Multiplication row of 15
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3266-multiplication-table-row-of-15.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 15]
  ارجع ر

تأكد_يساوي(ف(1), [15], "حالة 1")
تأكد_يساوي(ف(5), [15, 30, 45, 60, 75], "حالة 2")
تأكد_يساوي(ف(10), [15, 30, 45, 60, 75, 90, 105, 120, 135, 150], "حالة 3")
