# مثال 4355 — السعر مع ضريبة 45 بالمئة
# Price with 45 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4355-price-with-45-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 45 // 100

تأكد_يساوي(ف(100), 145, "حالة 1")
تأكد_يساوي(ف(250), 362, "حالة 2")
تأكد_يساوي(ف(999), 1448, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
