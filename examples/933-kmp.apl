# مثال 933 — نوث-موريس-برات
# KMP string search
# Demonstrates: جدول فشل بادئة-لاحقة
#
# Run:  python apl.py examples/933-kmp.apl

# كارثة السلاسل: نوث-موريس-برات يبحث بلا رجوع في النص
# جدول أطول بادئة-لاحقة يحدد مقدار القفز عند الفشل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جدول_فشل(نمط):
  م = طول(نمط)
  جدول = []
  لكل _ في نطاق(م):
    جدول.ألحق(0)
  ك = 0
  لكل i في نطاق(1, م):
    طالما ك > 0 و نمط[i] != نمط[ك]:
      ك = جدول[ك - 1]
    لو نمط[i] == نمط[ك]:
      ك = ك + 1
    جدول[i] = ك
  ارجع جدول

دالة ابحث(نص, نمط):
  جدول = جدول_فشل(نمط)
  مواضع = []
  ق = 0
  لكل i في نطاق(طول(نص)):
    طالما ق > 0 و نص[i] != نمط[ق]:
      ق = جدول[ق - 1]
    لو نص[i] == نمط[ق]:
      ق = ق + 1
    لو ق == طول(نمط):
      مواضع.ألحق(i - طول(نمط) + 1)
      ق = جدول[ق - 1]
  ارجع مواضع

جدول = جدول_فشل("ababd")
اطبع "جدول ababd:", جدول
مواضع = ابحث("ababcabcabababd", "ababd")
اطبع "المواضع:", مواضع

تأكد_يساوي(طول(جدول), 5, "طول الجدول")
تأكد_يساوي(جدول[0], 0, "جدول[0]")
تأكد_يساوي(جدول[1], 0, "جدول[1]")
تأكد_يساوي(جدول[2], 1, "جدول[2]")
تأكد_يساوي(جدول[3], 2, "جدول[3]")
تأكد_يساوي(جدول[4], 0, "جدول[4]")
تأكد_يساوي(طول(مواضع), 1, "مطابقة واحدة")
تأكد_يساوي(مواضع[0], 10, "عند الموضع 10")

# مطابقات متعددة
متعدد = ابحث("aaaa", "aa")
تأكد_يساوي(طول(متعدد), 3, "ثلاث مطابقات متداخلة")
# لا مطابقة
تأكد_يساوي(طول(ابحث("abc", "xyz")), 0, "لا مطابقة")
