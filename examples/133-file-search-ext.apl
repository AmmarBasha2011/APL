# مثال 133 — البحث عن ملفات بامتداد معين
# Searching files by extension
# Demonstrates: مسار_جديد، glob، طول
#
# Run:  python apl.py examples/133-file-search-ext.apl

المتغير جذر = "/tmp/apl_search_demo"
انشئ_مجلدات(جذر + "/فرعي/عميق")
اكتب(جذر + "/أول.txt", "أ")
اكتب(جذر + "/ثاني.md", "ب")
اكتب(جذر + "/فرعي/ثالث.txt", "ج")
اكتب(جذر + "/فرعي/عميق/رابع.txt", "د")

المتغير م = مسار_جديد(جذر)
المتغير نصوص = قائمة(م.glob("**/*.txt"))
اطبع "ملفات txt الموجودة:", طول(نصوص)
لكل ملف في مفرز(نصوص):
    اطبع "-", ملف.مسار_اسم

احذف_شجرة(جذر)
اطبع "تم التنظيف."
