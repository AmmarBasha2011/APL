# مثال 3226 — السعر بعد خصم 19 بالمئة
# Price after 19 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3226-price-after-19-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 19 // 100

تأكد_يساوي(ف(100), 81, "حالة 1")
تأكد_يساوي(ف(250), 203, "حالة 2")
تأكد_يساوي(ف(999), 810, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
