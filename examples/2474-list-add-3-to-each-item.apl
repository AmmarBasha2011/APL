# مثال 2474 — إضافة 3 لكل عنصر
# Add 3 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2474-list-add-3-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 3]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [6, 4, 5], "حالة 1")
تأكد_يساوي(ف([5]), [8], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [4, 5, 6, 7, 8, 9], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [1, 3, 10, 10, 7], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [13, 23, 13, 33, 23, 13], "حالة 5")
