# مثال 1639 — أقل أيام لصنع باقات
# Minimum days to make bouquets
# Demonstrates: بحث ثنائي
#
# Run:  python apl.py examples/1639-minimum-days-for-bouquets.apl

# الباقة من أزهار متجاورة متفتحة
# نجرب يوماً ونعد الباقات الممكنة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة باقات_في_يوم(تفتح, يوم, حجم):
  عد = 0
  متتالية = 0
  لكل ت في تفتح:
    لو ت <= يوم:
      متتالية = متتالية + 1
      لو متتالية == حجم:
        عد = عد + 1
        متتالية = 0
    والا:
      متتالية = 0
  ارجع عد

دالة أقل_أيام(تفتح, باقات, حجم):
  لو باقات * حجم > طول(تفتح):
    ارجع -1
  ي = 1
  ج = 1
  لكل ت في تفتح:
    لو ت > ج:
      ج = ت
  طالما ي < ج:
    م = (ي + ج) // 2
    لو باقات_في_يوم(تفتح, م, حجم) >= باقات:
      ج = م
    والا:
      ي = م + 1
  ارجع ي

تأكد_يساوي(أقل_أيام([1, 10, 3, 10, 2], 3, 1), 3, "ثلاث باقات")
تأكد_يساوي(أقل_أيام([1, 10, 3, 10, 2], 3, 2), -1, "مستحيل")
تأكد_يساوي(أقل_أيام([7, 7, 7, 7, 12, 7, 7], 2, 3), 12, "اثنا عشر")
