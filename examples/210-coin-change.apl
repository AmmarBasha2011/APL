# مثال 210 — أقل عدد عملات (برمجة ديناميكية)
# Coin change (minimum coins)
# Demonstrates: جدول ديناميكي، قيمة لا نهائية
#
# Run:  python apl.py examples/210-coin-change.apl

دالة أقل_عملات(عملات, مبلغ):
    المتغير لانهائي = مبلغ + 1
    المتغير جدول = [لانهائي لكل _ في نطاق(مبلغ + 1)]
    جدول[0] = 0
    لكل م في نطاق(1, مبلغ + 1):
        لكل عملة في عملات:
            لو عملة <= م:
                لو جدول[م - عملة] + 1 < جدول[م]:
                    جدول[م] = جدول[م - عملة] + 1
    لو جدول[مبلغ] > مبلغ:
        ارجع -1
    ارجع جدول[مبلغ]

اطبع "مبلغ 11 بعملات [1,2,5]:", أقل_عملات([1, 2, 5], 11)
اطبع "مبلغ 3 بعملات [2]:", أقل_عملات([2], 3)
اطبع "مبلغ 41 بعملات [1,5,10,25]:", أقل_عملات([1, 5, 10, 25], 41)
