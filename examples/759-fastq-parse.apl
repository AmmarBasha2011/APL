# مثال 759 — تحليل FASTQ
# FASTQ parsing
# Demonstrates: سجلات رباعية، Phred+33، دقة
#
# Run:  python apl.py examples/759-fastq-parse.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحليل ملفات FASTQ: تسلسلات مع درجات جودة Phred+33
# Demonstrates: سجلات رباعية السطور, درجة الجودة Q, احتمال الخطأ
# Q = رمز الحرف - 33، والدقة = 1 - 10^(-Q/10)

دالة جودة_حرف(حرف):
  ارجع ترميز_حرف(حرف) - 33

دالة دقة(جودة):
  ارجع (1 - أس(-جودة * لوغاريتم(10) / 10)) * 100

دالة متوسط_جودة(سلسلة_جودة):
  مجموع = 0
  لكل ي في نطاق(طول(سلسلة_جودة)):
    مجموع = مجموع + جودة_حرف(سلسلة_جودة[ي])
  ارجع مجموع / طول(سلسلة_جودة)

دالة حلل_fastq(سطور):
  سجلات = []
  ي = 0
  طالما ي < طول(سطور):
    سجلات.append({
      "معرف": سطور[ي][1:طول(سطور[ي])],
      "تسلسل": سطور[ي + 1],
      "جودة": سطور[ي + 3]
    })
    ي = ي + 4
  ارجع سجلات

سطور = ["@قراءة1", "ATGC", "+", "IIII", "@قراءة2", "GGCC", "+", "5555"]
سجلات = حلل_fastq(سطور)

تأكد_يساوي(طول(سجلات), 2, "سجلان")
تأكد_يساوي(سجلات[0]["معرف"], "قراءة1", "معرف الأول")
تأكد_يساوي(سجلات[1]["تسلسل"], "GGCC", "تسلسل الثاني")

تأكد_يساوي(جودة_حرف("I"), 40, "I تعني 40")
تأكد_يساوي(جودة_حرف("J"), 41, "J تعني 41")
تأكد_يساوي(جودة_حرف("5"), 20, "5 تعني 20")

تأكد_يساوي(متوسط_جودة("IIII"), 40.0, "متوسط مثالي")
تأكد_يساوي(متوسط_جودة("I5"), 30.0, "متوسط مختلط")

تأكد_يساوي(مقرب(دقة(40), 2), 99.99, "دقة Q40")
تأكد_يساوي(مقرب(دقة(20), 2), 99.0, "دقة Q20")

اطبع "متوسط جودة السجل الأول:", متوسط_جودة(سجلات[0]["جودة"])
