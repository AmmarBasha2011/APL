# مثال 3827 — قوة 18 بالحلقة
# Power of 18 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3827-nth-power-of-18-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 18
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 18, "حالة 2")
تأكد_يساوي(ف(3), 5832, "حالة 3")
تأكد_يساوي(ف(6), 34012224, "حالة 4")
تأكد_يساوي(ف(10), 3570467226624, "حالة 5")
