# مثال 3976 — مساحة دائرة بتقريب 71
# Circle area with pi approx 71/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3976-square-of-radius-times-71-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 71 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 10, "حالة 2")
تأكد_يساوي(ف(7), 497, "حالة 3")
تأكد_يساوي(ف(14), 1988, "حالة 4")
تأكد_يساوي(ف(21), 4473, "حالة 5")
