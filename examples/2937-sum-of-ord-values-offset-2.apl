# مثال 2937 — مجموع ord مع إزاحة 2
# Sum of ord values plus 2 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2937-sum-of-ord-values-offset-2.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 2
  ارجع م

تأكد_يساوي(ف("a"), 99, "حالة 1")
تأكد_يساوي(ف("abc"), 300, "حالة 2")
تأكد_يساوي(ف("xyz"), 369, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
