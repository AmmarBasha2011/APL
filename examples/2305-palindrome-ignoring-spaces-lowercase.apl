# مثال 2305 — متناظر مع تجاهل المسافات
# Palindrome ignoring spaces
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2305-palindrome-ignoring-spaces-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = ن.lower().replace(" ", "")
  ارجع ق == ق[::-1]

تأكد_يساوي(ف("a man a plan a canal panama"), صواب, "حالة 1")
تأكد_يساوي(ف("hello"), خطأ, "حالة 2")
تأكد_يساوي(ف("Was it a car"), خطأ, "حالة 3")
تأكد_يساوي(ف("abc cba"), صواب, "حالة 4")
