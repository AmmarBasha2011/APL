# مثال 3238 — تحويل وحدة بأساس 16
# Split by base 16
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3238-minutes-to-hours-and-minutes-base-16.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 16, ن % 16]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [3, 11], "حالة 2")
تأكد_يساوي(ف(60), [3, 12], "حالة 3")
تأكد_يساوي(ف(125), [7, 13], "حالة 4")
تأكد_يساوي(ف(1000), [62, 8], "حالة 5")
