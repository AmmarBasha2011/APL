# مثال 417 — كيانات HTML
# HTML entities
# Demonstrates: تهريب وفك تهريب
#
# Run:  python apl.py examples/417-html-entities.apl

دالة اهرب_اتش(نص_الدخل):
    المتغير ناتج = نص_الدخل.استبدال("&", "&amp;")
    ناتج = ناتج.استبدال("<", "&lt;")
    ناتج = ناتج.استبدال(">", "&gt;")
    ناتج = ناتج.استبدال('"', "&quot;")
    ارجع ناتج

دالة افكك_اتش(نص_الدخل):
    المتغير ناتج = نص_الدخل.استبدال("&lt;", "<")
    ناتج = ناتج.استبدال("&gt;", ">")
    ناتج = ناتج.استبدال("&quot;", '"')
    ناتج = ناتج.استبدال("&amp;", "&")
    ارجع ناتج

المتغير مهرب = اهرب_اتش('<div class="x">أ & ب</div>')
اطبع "مهرب:", مهرب
اطبع "مفكوك:", افكك_اتش(مهرب)
