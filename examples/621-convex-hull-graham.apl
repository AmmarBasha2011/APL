# مثال 621 — الغلاف المحدب
# Convex hull (Graham scan)
# Demonstrates: غلاف محدب، فرز قطبي، مكدس
#
# Run:  python apl.py examples/621-convex-hull-graham.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الغلاف المحدب بمسح جراهام
# Demonstrates: فرز قطبي, اختبار اتجاه, مكدس الغلاف
# أصغر مضلع محدب يحوي كل النقاط

دالة اتجاه(ن1, ن2, ن3):
  ارجع (ن2[0] - ن1[0]) * (ن3[1] - ن1[1]) - (ن2[1] - ن1[1]) * (ن3[0] - ن1[0])

دالة غلاف_محدب(نقاط):
  مرتبة = نقاط.copy()
  مرتبة.sort()
  أسفل = []
  لكل ن في مرتبة:
    طالما طول(أسفل) >= 2 و اتجاه(أسفل[-2], أسفل[-1], ن) <= 0:
      أسفل.pop()
    أسفل.append(ن)
  أعلى = []
  لكل ن في مرتبة:
    طالما طول(أعلى) >= 2 و اتجاه(أعلى[-2], أعلى[-1], ن) >= 0:
      أعلى.pop()
    أعلى.append(ن)
  أسفل.pop()
  أعلى.pop()
  ارجع طول(أسفل) + طول(أعلى)

نقاط = [[0,0],[1,0],[2,0],[0,1],[1,1],[2,1],[0,2],[1,2],[2,2]]
اطبع "رؤوس الغلاف:", غلاف_محدب(نقاط)
تأكد_يساوي(غلاف_محدب(نقاط), 4, "شبكة 3x3 غلافها مربع")
تأكد_يساوي(غلاف_محدب([[0,0],[2,0],[1,1]]), 3, "مثلث")
تأكد_يساوي(غلاف_محدب([[0,0],[1,0],[2,0],[3,0]]), 2, "نقاط مستقيمة")
