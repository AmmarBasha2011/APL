# مثال 1585 — مجموع زوج بمؤشرين
# Pair sum with two pointers
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1585-pair-sum-two-pointers.apl

# مؤشر من البداية وآخر من النهاية
# نحرك المناسب بحسب المجموع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يوجد_زوج(أ, هدف):
  ي = 0
  ن = طول(أ) - 1
  طالما ي < ن:
    م = أ[ي] + أ[ن]
    لو م == هدف:
      ارجع صواب
    والا_لو م < هدف:
      ي = ي + 1
    والا:
      ن = ن - 1
  ارجع خطأ

تأكد_يساوي(يوجد_زوج([1, 2, 4, 7, 11], 9), صواب, "زوج")
تأكد_يساوي(يوجد_زوج([1, 2, 4, 7, 11], 10), خطأ, "لا يوجد")
تأكد_يساوي(يوجد_زوج([5], 10), خطأ, "عنصر واحد")
