# مثال 3978 — مساحة مستطيل مكبر 20 مرات
# Rectangle area scaled by 20
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3978-rectangle-area-scaled-by-20.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 20) * (ق[1] * 20)

تأكد_يساوي(ف([1, 2]), 800, "حالة 1")
تأكد_يساوي(ف([3, 4]), 4800, "حالة 2")
تأكد_يساوي(ف([5, 5]), 10000, "حالة 3")
تأكد_يساوي(ف([10, 1]), 4000, "حالة 4")
