# مثال 943 — مويجة هار
# Haar wavelet
# Demonstrates: متوسطات وفروق متدرجة
#
# Run:  python apl.py examples/943-haar-wavelet.apl

# تحويل هار المويجي: متوسطات وفروق متدرجة المستويات
# أبسط مويجة: ضغط وكشف حواف الإشارات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة هار(إشارة):
  جارية = []
  لكل x في إشارة:
    جارية.ألحق(x)
  فروق = []
  طالما طول(جارية) > 1:
    متوسطات = []
    فروق_مستوى = []
    لكل i في نطاق(0, طول(جارية), 2):
      متوسطات.ألحق((جارية[i] + جارية[i + 1]) / 2)
      فروق_مستوى.ألحق((جارية[i] - جارية[i + 1]) / 2)
    # أحدث الفروق في المقدمة
    فروق = فروق_مستوى + فروق
    جارية = متوسطات
  ارجع جارية + فروق

نتيجة = هار([4, 6, 10, 12, 8, 6, 5, 5])
اطبع "المعاملات:", نتيجة

متوقع = [7, 1, -3, 1, -1, -1, 1, 0]
تأكد_يساوي(طول(نتيجة), 8, "الطول محفوظ")
لكل i في نطاق(8):
  تأكد_يساوي(مقرب(نتيجة[i], 6), متوقع[i], "معامل " + نص(i))

# المعامل الأول هو متوسط الإشارة الكلي
تأكد_يساوي(مقرب(نتيجة[0], 6), 7, "المتوسط الكلي")

# إشارة ثابتة: كل الفروق صفر
ثابتة = هار([3, 3, 3, 3])
تأكد_يساوي(مقرب(ثابتة[0], 6), 3, "متوسط ثابتة")
تأكد_يساوي(مقرب(ثابتة[1], 6), 0, "فرق صفري 1")
تأكد_يساوي(مقرب(ثابتة[3], 6), 0, "فرق صفري 3")
