# مثال 4422 — قوة 34 بالحلقة
# Power of 34 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4422-nth-power-of-34-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 34
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 34, "حالة 2")
تأكد_يساوي(ف(3), 39304, "حالة 3")
تأكد_يساوي(ف(6), 1544804416, "حالة 4")
تأكد_يساوي(ف(10), 2064377754059776, "حالة 5")
