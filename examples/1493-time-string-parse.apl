# مثال 1493 — تحليل نص الوقت
# Parse HH:MM time string
# Demonstrates: تحليل
#
# Run:  python apl.py examples/1493-time-string-parse.apl

# نفصل على النقطتين
# الساعة من 0 إلى 23 والدقيقة من 0 إلى 59

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة دقائق_اليوم(نص_):
  أجزاء = نص_.split(":")
  لو طول(أجزاء) != 2:
    ارجع -1
  لو أجزاء[0].isdigit() == خطأ أو أجزاء[1].isdigit() == خطأ:
    ارجع -1
  س = صحيح(أجزاء[0])
  د = صحيح(أجزاء[1])
  لو س > 23 أو د > 59:
    ارجع -1
  ارجع س * 60 + د

تأكد_يساوي(دقائق_اليوم("14:30"), 870, "ظهراً")
تأكد_يساوي(دقائق_اليوم("00:00"), 0, "منتصف الليل")
تأكد_يساوي(دقائق_اليوم("24:00"), -1, "ساعة خاطئة")
تأكد_يساوي(دقائق_اليوم("12-30"), -1, "صيغة خاطئة")
