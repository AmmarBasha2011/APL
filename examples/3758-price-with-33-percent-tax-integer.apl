# مثال 3758 — السعر مع ضريبة 33 بالمئة
# Price with 33 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3758-price-with-33-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 33 // 100

تأكد_يساوي(ف(100), 133, "حالة 1")
تأكد_يساوي(ف(250), 332, "حالة 2")
تأكد_يساوي(ف(999), 1328, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
