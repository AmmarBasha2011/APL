# مثال 6 — خوارزميات البحث والترتيب
# Searching & Sorting Algorithms
# Demonstrates: custom functions, nested while-loops, list copy, mutation
#
# Run:  python apl.py examples/06-search-sort.apl

دالة فقاعة(المدخل):
    الناتج = المدخل.نسخ()
    n = طول(الناتج)
    i = 0
    طالما i < n:
        j = 0
        طالما j < n - 1 - i:
            إذا الناتج[j] > الناتج[j + 1]:
                مؤقت = الناتج[j]
                الناتج[j] = الناتج[j + 1]
                الناتج[j + 1] = مؤقت
            j = j + 1
        i = i + 1
    ارجع الناتج

دالة بحث(القائمة, الهدف):
    رقم = 0
    طالما رقم < طول(القائمة):
        إذا القائمة[رقم] == الهدف:
            ارجع رقم
        رقم = رقم + 1
    ارجع -1

المتغير البيانات = [64, 25, 12, 22, 11, 90, 33]

اطبع "=== البحث والترتيب ==="
اطبع "الأصل: " + نص(البيانات)
المتغير المرتب = فقاعة(البيانات)
اطبع "مرتب: " + نص(المرتب)
اطبع ""
اطبع "بحث عن 22: الفهرس " + نص(بحث(البيانات, 22))
اطبع "بحث عن 99: الفهرس " + نص(بحث(البيانات, 99))
اطبع "أكبر عنصر: " + نص(المرتب[طول(المرتب) - 1])
اطبع "أصغر عنصر: " + نص(المرتب[0])
