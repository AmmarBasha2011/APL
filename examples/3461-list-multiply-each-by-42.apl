# مثال 3461 — ضرب كل عنصر في 42
# Multiply each item by 42
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3461-list-multiply-each-by-42.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 42]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [126, 42, 84], "حالة 1")
تأكد_يساوي(ف([5]), [210], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [42, 84, 126, 168, 210, 252], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-84, 0, 294, 294, 168], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [420, 840, 420, 1260, 840, 420], "حالة 5")
