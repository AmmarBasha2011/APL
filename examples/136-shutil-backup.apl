# مثال 136 — نسخ احتياطي لمجلد كامل
# Full folder backup with shutil
# Demonstrates: انسخ_شجرة، انسخ_ملف، انقل_ملف، احذف_شجرة
#
# Run:  python apl.py examples/136-shutil-backup.apl

المتغير أصل = "/tmp/apl_backup_src"
المتغير نسخة = "/tmp/apl_backup_dst"
انشئ_مجلدات(أصل)
اكتب(أصل + "/مهم.txt", "بيانات مهمة")

انسخ_شجرة(أصل, نسخة)
اطبع "النسخة موجودة؟", موجود(نسخة + "/مهم.txt")

انسخ_ملف(أصل + "/مهم.txt", أصل + "/مهم2.txt")
اطبع "نسخة الملف موجودة؟", موجود(أصل + "/مهم2.txt")

انقل_ملف(أصل + "/مهم2.txt", أصل + "/منقول.txt")
اطبع "بعد النقل:", موجود(أصل + "/منقول.txt"), "والأصل اختفى؟", ليس موجود(أصل + "/مهم2.txt")

احذف_شجرة(أصل)
احذف_شجرة(نسخة)
اطبع "تم التنظيف."
