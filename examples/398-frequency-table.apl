# مثال 398 — جدول التكرار
# Frequency table
# Demonstrates: تكرار النسب المئوية
#
# Run:  python apl.py examples/398-frequency-table.apl

المتغير بيانات = ["أ", "ب", "أ", "ج", "أ", "ب", "أ", "ب", "ج"]
المتغير تكرار = {}
لكل ق in بيانات:
    المتغير قديم = تكرار.get(ق, 0)
    تكرار[ق] = قديم + 1

المتغير مفاتيح = مفرز(تكرار.keys())
لكل مفتاح in مفاتيح:
    المتغير نسبة = تكرار[مفتاح] / طول(بيانات) * 100
    اطبع مفتاح + ":", تكرار[مفتاح], "مرة", "(" + نص(نسبة) + "%)"
