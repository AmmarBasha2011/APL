# مثال 218 — المسح بالعمق وإيجاد مسار
# Graph DFS and path finding
# Demonstrates: عودية مع مجموعة زيارات
#
# Run:  python apl.py examples/218-graph-dfs.apl

دالة مسح_عمق(رسم, عقدة, مزارة, نتيجة):
    مزارة[عقدة] = صواب
    نتيجة.أضف(عقدة)
    لكل جار في رسم[عقدة]:
        لو جار ليس في مزارة:
            مسح_عمق(رسم, جار, مزارة, نتيجة)

دالة جد_مسار(رسم, من, إلى, مزارة, مسار):
    مزارة[من] = صواب
    مسار.أضف(من)
    لو من == إلى:
        ارجع صواب
    لكل جار في رسم[من]:
        لو جار ليس في مزارة:
            لو جد_مسار(رسم, جار, إلى, مزارة, مسار):
                ارجع صواب
    مسار.pop()
    ارجع خطأ

المتغير رسم = {
    "أ": ["ب", "ج"],
    "ب": ["أ", "د"],
    "ج": ["أ", "د"],
    "د": ["ب", "ج", "ه"],
    "ه": ["د"]
}
المتغير نتيجة = []
مسح_عمق(رسم, "أ", {}, نتيجة)
اطبع "المسح بالعمق:", نتيجة

المتغير مسار = []
جد_مسار(رسم, "أ", "ه", {}, مسار)
اطبع "مسار من أ إلى ه:", مسار
