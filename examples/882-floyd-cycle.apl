# مثال 882 — كشف الدورة بفلويد
# Floyd cycle detection
# Demonstrates: سلحفاة وأرنب
#
# Run:  python apl.py examples/882-floyd-cycle.apl

# كشف الدورة بفلويد (السلحفاة والأرنب): مؤشران بسرعتين
# يجد دورة القائمة بذاكرة O(1) ثم يحدد بدايتها وطولها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# نمذجة قائمة مترابطة بدالة تالي على الفهارس
دالة تالي(س):
  ارجع (2 * س + 1) % 7

دالة فلويد(بداية):
  سلحفاة = تالي(بداية)
  أرنب = تالي(تالي(بداية))
  طالما سلحفاة != أرنب:
    سلحفاة = تالي(سلحفاة)
    أرنب = تالي(تالي(أرنب))
  # المرحلة الثانية: بداية الدورة
  ميو = 0
  سلحفاة = بداية
  طالما سلحفاة != أرنب:
    سلحفاة = تالي(سلحفاة)
    أرنب = تالي(أرنب)
    ميو = ميو + 1
  # طول الدورة
  لامدا = 1
  أرنب = تالي(سلحفاة)
  طالما سلحفاة != أرنب:
    أرنب = تالي(أرنب)
    لامدا = لامدا + 1
  ارجع [ميو, لامدا]

نتيجة = فلويد(0)
اطبع "ميو ولامدا:", نتيجة

تأكد_يساوي(نتيجة[0], 0, "الدورة تبدأ فوراً")
تأكد_يساوي(نتيجة[1], 3, "طول الدورة 3")

# تحقق مباشر: 0 -> 1 -> 3 -> 0
تأكد_يساوي(تالي(0), 1, "0 إلى 1")
تأكد_يساوي(تالي(1), 3, "1 إلى 3")
تأكد_يساوي(تالي(3), 0, "3 إلى 0")

# ذيل أطول: تالي2 = س+1 لـ س<4 ثم دورة
دالة تالي2(س):
  لو س < 4:
    ارجع س + 1
  ارجع 4 + (س - 3) % 3

دالة فلويد2(بداية):
  سلحفاة = تالي2(بداية)
  أرنب = تالي2(تالي2(بداية))
  طالما سلحفاة != أرنب:
    سلحفاة = تالي2(سلحفاة)
    أرنب = تالي2(تالي2(أرنب))
  ميو = 0
  سلحفاة = بداية
  طالما سلحفاة != أرنب:
    سلحفاة = تالي2(سلحفاة)
    أرنب = تالي2(أرنب)
    ميو = ميو + 1
  لامدا = 1
  أرنب = تالي2(سلحفاة)
  طالما سلحفاة != أرنب:
    أرنب = تالي2(أرنب)
    لامدا = لامدا + 1
  ارجع [ميو, لامدا]

نتيجة2 = فلويد2(0)
اطبع "مع ذيل:", نتيجة2
تأكد_يساوي(نتيجة2[0], 4, "الدورة تبدأ بعد ذيل 4")
تأكد_يساوي(نتيجة2[1], 3, "طول الدورة 3")
