# مثال 3984 — مجموع زوايا مضلع زائد 26
# Polygon angle sum plus 26
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3984-interior-angle-sum-of-polygon-plus-26.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 26

تأكد_يساوي(ف(3), 206, "حالة 1")
تأكد_يساوي(ف(4), 386, "حالة 2")
تأكد_يساوي(ف(5), 566, "حالة 3")
تأكد_يساوي(ف(6), 746, "حالة 4")
تأكد_يساوي(ف(12), 1826, "حالة 5")
