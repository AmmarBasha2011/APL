# مثال 4350 — السعر بعد خصم 45 بالمئة
# Price after 45 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4350-price-after-45-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 45 // 100

تأكد_يساوي(ف(100), 55, "حالة 1")
تأكد_يساوي(ف(250), 138, "حالة 2")
تأكد_يساوي(ف(999), 550, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
