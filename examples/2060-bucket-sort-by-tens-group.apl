# مثال 2060 — الفرز بالسلال حسب خانة العشرات
# Bucket sort by tens
# Demonstrates: فرز
#
# Run:  python apl.py examples/2060-bucket-sort-by-tens-group.apl

# # كل سلة تفرز على حدة
# # ثم تجمع السلال بالترتيب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة سلال(ق):
  س = []
  لكل ك في نطاق(10):
    س = س + [[]]
  لكل ع في ق:
    س[ع // 10].append(ع)
  خرج = []
  لكل سلة في س:
    خرج = خرج + sorted(سلة)
  ارجع خرج

تأكد_يساوي(سلال([29, 25, 3, 49, 9, 37, 21, 43]), [3, 9, 21, 25, 29, 37, 43, 49], "ثمانية")
تأكد_يساوي(سلال([99, 0]), [0, 99], "حدان")
