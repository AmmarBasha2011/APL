# مثال 1540 — عكس القاموس
# Invert a dictionary
# Demonstrates: قواميس
#
# Run:  python apl.py examples/1540-invert-dictionary.apl

# القيم المتكررة تتجمع في قائمة
# نبني قائمة لكل قيمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اعكس_القاموس(ق):
  ناتج = {}
  لكل ك في ق:
    ف = ق[ك]
    لو ف في ناتج:
      ناتج[ف].append(ك)
    والا:
      ناتج[ف] = [ك]
  ارجع ناتج

تأكد_يساوي(اعكس_القاموس({"a": 1, "b": 2}), {1: ["a"], 2: ["b"]}, "مختلفة")
تأكد_يساوي(اعكس_القاموس({"a": 1, "b": 1}), {1: ["a", "b"]}, "مكررة")
تأكد_يساوي(اعكس_القاموس({}), {}, "فارغ")
