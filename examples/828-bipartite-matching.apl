# مثال 828 — التطابق الثنائي
# Bipartite matching
# Demonstrates: مسارات تحسينية بDFS
#
# Run:  python apl.py examples/828-bipartite-matching.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تطابق أقصى في مخطط ثنائي بمسارات تحسينية (خوارزمية كون)
# Demonstrates: مسار متناوب بDFS, إعادة إسناد, تطابق أقصى

جوار = [[1, 2], [1], [2, 3]]
عدد_يسار = 3

دالة تطابق_أقصى():
  تطابق = [0 - 1, 0 - 1, 0 - 1, 0 - 1]
  دالة حاول(عقدة, مزار):
    لكل يمين في جوار[عقدة]:
      لو (يمين في مزار) == خطأ:
        مزار.append(يمين)
        لو تطابق[يمين] == 0 - 1 أو حاول(تطابق[يمين], مزار):
          تطابق[يمين] = عقدة
          ارجع 1
    ارجع 0
  عدد = 0
  لكل عقدة في نطاق(عدد_يسار):
    لو حاول(عقدة, []) == 1:
      عدد = عدد + 1
  ارجع [عدد, تطابق]

نتيجة = تطابق_أقصى()
تأكد_يساوي(نتيجة[0], 3, "تطابق كامل")
تأكد_يساوي(نتيجة[1], [0 - 1, 1, 0, 2], "الإسناد النهائي")
جوار2 = [[1], [1], [2]]
جوار = جوار2
نتيجة2 = تطابق_أقصى()
تأكد_يساوي(نتيجة2[0], 2, "تطابق جزئي")
