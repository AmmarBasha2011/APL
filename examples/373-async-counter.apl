# مثال 373 — عداد متزامن مشترك
# Shared async counter
# Demonstrates: تناوب التنفيذ بلا قفل
#
# Run:  python apl.py examples/373-async-counter.apl

async def زد(عداد, مرات):
    لكل _ في نطاق(مرات):
        عداد["قيمة"] = عداد["قيمة"] + 1
        await نوم(0)

async def الرئيسية():
    المتغير عداد = {"قيمة": 0}
    await اجمع(زد(عداد, 100), زد(عداد, 100), زد(عداد, 100))
    اطبع "القيمة:", عداد["قيمة"]

شغل_تزامن(الرئيسية())
