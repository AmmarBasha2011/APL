# مثال 1571 — قوارب الإنقاذ
# Boats to save people
# Demonstrates: جشع
#
# Run:  python apl.py examples/1571-boats-to-save-people.apl

# نرتب الأوزان
# نزاوج الأخف مع الأثقل إن اتسع القارب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عدد_القوارب(أوزان, حد):
  ق = []
  لكل و في أوزان:
    ق.append(و)
  ق.sort()
  يسار = 0
  يمين = طول(ق) - 1
  قوارب = 0
  طالما يسار <= يمين:
    لو ق[يسار] + ق[يمين] <= حد:
      يسار = يسار + 1
    يمين = يمين - 1
    قوارب = قوارب + 1
  ارجع قوارب

تأكد_يساوي(عدد_القوارب([1, 2], 3), 1, "قارب")
تأكد_يساوي(عدد_القوارب([3, 2, 2, 1], 3), 3, "ثلاثة")
تأكد_يساوي(عدد_القوارب([3, 5, 3, 4], 5), 4, "كل شخص منفرداً")
