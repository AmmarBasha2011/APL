# مثال 2477 — إضافة 8 لكل عنصر
# Add 8 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2477-list-add-8-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 8]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [11, 9, 10], "حالة 1")
تأكد_يساوي(ف([5]), [13], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [9, 10, 11, 12, 13, 14], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [6, 8, 15, 15, 12], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [18, 28, 18, 38, 28, 18], "حالة 5")
