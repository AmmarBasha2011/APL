# مثال 4388 — صف جدول ضرب 32
# Multiplication row of 32
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4388-multiplication-table-row-of-32.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 32]
  ارجع ر

تأكد_يساوي(ف(1), [32], "حالة 1")
تأكد_يساوي(ف(5), [32, 64, 96, 128, 160], "حالة 2")
تأكد_يساوي(ف(10), [32, 64, 96, 128, 160, 192, 224, 256, 288, 320], "حالة 3")
