# مثال 688 — مفسر براين فك
# Brainfuck interpreter
# Demonstrates: شريط ذاكرة، أقواس، مكدس
#
# Run:  python apl.py examples/688-brainfuck-interp.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مفسر براين فك المصغر (بدون إدخال)
# Demonstrates: شريط ذاكرة, مطابقة الأقواس بمكدس, حلقات []
# البرنامج: 6*11-1 = 65 يطبع A ثم +. يطبع B

دالة طابق_أقواس(برنامج):
  أزواج = {}
  مكدس = []
  لكل ي في نطاق(طول(برنامج)):
    لو برنامج[ي] == "[":
      مكدس.append(ي)
    والا_لو برنامج[ي] == "]":
      فتح = مكدس.pop()
      أزواج[فتح] = ي
      أزواج[ي] = فتح
  ارجع أزواج

دالة نفذ(برنامج):
  أزواج = طابق_أقواس(برنامج)
  شريط = [0] * 64
  مؤشر = 0
  عداد = 0
  ناتج = ""
  طالما عداد < طول(برنامج):
    أمر = برنامج[عداد]
    لو أمر == ">":
      مؤشر = مؤشر + 1
    والا_لو أمر == "<":
      مؤشر = مؤشر - 1
    والا_لو أمر == "+":
      شريط[مؤشر] = (شريط[مؤشر] + 1) % 256
    والا_لو أمر == "-":
      شريط[مؤشر] = (شريط[مؤشر] + 255) % 256
    والا_لو أمر == ".":
      ناتج = ناتج + فك_ترميز_حرف(شريط[مؤشر])
    والا_لو أمر == "[":
      لو شريط[مؤشر] == 0:
        عداد = أزواج[عداد]
    والا_لو أمر == "]":
      لو شريط[مؤشر] != 0:
        عداد = أزواج[عداد]
    عداد = عداد + 1
  ارجع ناتج

ناتج = نفذ("++++++[>+++++++++++<-]>-.+.")
تأكد_يساوي(ناتج, "AB", "البرنامج يطبع AB")
ناتج2 = نفذ("+++[>+++[>++<-]<-]>>.")
تأكد_يساوي(ناتج2, فك_ترميز_حرف(18), "حلقتان متداخلتان 3*3*2=18")
ناتج3 = نفذ("++++++++++.")
تأكد_يساوي(ناتج3, فك_ترميز_حرف(10), "سطر جديد من عشرة")
اطبع "الناتج:", ناتج
