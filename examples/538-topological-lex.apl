# مثال 538 — ترتيب طوبولوجي معجمي
# Lexicographic topological sort
# Demonstrates: ترتيب طوبولوجي، خوارزمية كان، أصغر أولاً
#
# Run:  python apl.py examples/538-topological-lex.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# ترتيب طوبولوجي بأصغر تسمية أولاً (خوارزمية كان)
المتغير جيران = {"أ": ["ج"], "ب": ["ج", "د"], "ج": ["هـ"], "د": ["هـ"], "هـ": []}
المتغير درجات = قاموس()
لكل عقدة في جيران:
    درجات[عقدة] = 0
لكل عقدة في جيران:
    لكل جار في جيران[عقدة]:
        درجات[جار] = درجات[جار] + 1

المتغير جاهز = قائمة()
لكل عقدة في جيران:
    لو درجات[عقدة] == 0:
        جاهز.أضف(عقدة)

المتغير ترتيب = قائمة()
طالما طول(جاهز) > 0:
    جاهز = مفرز(جاهز)
    المتغير عقدة = جاهز.pop(0)
    ترتيب.أضف(عقدة)
    لكل جار في جيران[عقدة]:
        درجات[جار] = درجات[جار] - 1
        لو درجات[جار] == 0:
            جاهز.أضف(جار)

اطبع "الترتيب:", ترتيب
تأكد_يساوي(ترتيب, ["أ", "ب", "ج", "د", "هـ"], "ترتيب طوبولوجي معجمي")
