# مثال 1337 — لعبة الزنزانة
# Dungeon game minimum health
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1337-dungeon-game.apl

# نحسب من النهاية إلى البداية
# الصحة يجب ألا تقل عن واحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صحة_دنيا(م):
  ر_ = طول(م)
  ك_ = طول(م[0])
  د = []
  لكل ع في نطاق(ر_):
    د.ألحق([0] * ك_)
  لكل ع في نطاق(ر_ - 1, -1, -1):
    لكل ج في نطاق(ك_ - 1, -1, -1):
      لو (ع == ر_ - 1) و (ج == ك_ - 1):
        د[ع][ج] = أكبر(1, 1 - م[ع][ج])
      والا_لو ع == ر_ - 1:
        د[ع][ج] = أكبر(1, د[ع][ج + 1] - م[ع][ج])
      والا_لو ج == ك_ - 1:
        د[ع][ج] = أكبر(1, د[ع + 1][ج] - م[ع][ج])
      والا:
        د[ع][ج] = أكبر(1, أصغر(د[ع + 1][ج], د[ع][ج + 1]) - م[ع][ج])
  ارجع د[0][0]

تأكد_يساوي(صحة_دنيا([[-2,-3,3],[-5,-10,1],[10,30,-5]]), 7, "مثال أول")
تأكد_يساوي(صحة_دنيا([[0]]), 1, "خلية")
تأكد_يساوي(صحة_دنيا([[100]]), 1, "موجبة")
