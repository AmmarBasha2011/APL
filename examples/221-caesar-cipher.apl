# مثال 221 — شيفرة قيصر
# Caesar cipher
# Demonstrates: ترميز_حرف، فك_ترميز_حرف، الإزاحة الدائرية
#
# Run:  python apl.py examples/221-caesar-cipher.apl

دالة قيصر(نص_الدخل, إزاحة):
    المتغير نتيجة = ""
    لكل حرف في نص_الدخل:
        لو حرف >= "a" و حرف <= "z":
            نتيجة = نتيجة + فك_ترميز_حرف((ترميز_حرف(حرف) - 97 + إزاحة) % 26 + 97)
        الا لو حرف >= "A" و حرف <= "Z":
            نتيجة = نتيجة + فك_ترميز_حرف((ترميز_حرف(حرف) - 65 + إزاحة) % 26 + 65)
        الا:
            نتيجة = نتيجة + حرف
    ارجع نتيجة

المتغير رسالة = "Hello World"
المتغير مشفرة = قيصر(رسالة, 3)
اطبع "الأصل:", رسالة
اطبع "المشفرة:", مشفرة
اطبع "فك التشفير:", قيصر(مشفرة, 26 - 3)
