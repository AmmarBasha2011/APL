# مثال 271 — أكبر مجموع متتالي (كادان)
# Kadane's algorithm
# Demonstrates: أقصى مجموع لمصفوفة فرعية متصلة
#
# Run:  python apl.py examples/271-kadane.apl

دالة كادان(قائمة):
    المتغير أفضل = قائمة[0]
    المتغير حالي = قائمة[0]
    لكل ي في نطاق(1, طول(قائمة)):
        لو حالي + قائمة[ي] > قائمة[ي]:
            حالي = حالي + قائمة[ي]
        الا:
            حالي = قائمة[ي]
        لو حالي > أفضل:
            أفضل = حالي
    ارجع أفضل

اطبع كادان([-2, 1, -3, 4, -1, 2, 1, -5, 4])
اطبع كادان([1, 2, 3, 4])
اطبع كادان([-5, -1, -3])
