# مثال 442 — مساحة مضلع
# Polygon area (shoelace)
# Demonstrates: صيغة شوليس
#
# Run:  python apl.py examples/442-polygon-area.apl

دالة مساحة_مضلع(نقاط):
    المتغير ن = طول(نقاط)
    المتغير مجموع = 0
    لكل ي في نطاق(ن):
        المتغير ز = (ي + 1) % ن
        مجموع = مجموع + نقاط[ي][0] * نقاط[ز][1] - نقاط[ز][0] * نقاط[ي][1]
    ارجع مطلق(مجموع) / 2

اطبع "مربع 4x4:", مساحة_مضلع([[0, 0], [4, 0], [4, 4], [0, 4]])
اطبع "مثلث:", مساحة_مضلع([[0, 0], [4, 0], [2, 3]])
