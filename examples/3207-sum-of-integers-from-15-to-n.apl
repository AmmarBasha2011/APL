# مثال 3207 — مجموع الأعداد من 15 إلى ن
# Sum from 15 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3207-sum-of-integers-from-15-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(15, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(15), 15, "حالة 1")
تأكد_يساوي(ف(16), 31, "حالة 2")
تأكد_يساوي(ف(25), 220, "حالة 3")
تأكد_يساوي(ف(100), 4945, "حالة 4")
