# مثال 571 — تقييم ماسترمايند
# Mastermind scoring
# Demonstrates: ماسترمايند، دقيق ولوني، تكرارات
#
# Run:  python apl.py examples/571-mastermind-score.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تقييم ماسترمايند: دقيق ولون فقط
دالة قيّم(سر, تخمين):
    المتغير دقيق = 0
    المتغير بقايا_سر = قائمة()
    المتغير بقايا_تخمين = قائمة()
    لكل i في نطاق(طول(سر)):
        لو سر[i] == تخمين[i]:
            دقيق = دقيق + 1
        الا:
            بقايا_سر.أضف(سر[i])
            بقايا_تخمين.أضف(تخمين[i])
    المتغير لوني = 0
    لكل عنصر في بقايا_تخمين:
        لو عنصر في بقايا_سر:
            لوني = لوني + 1
            بقايا_سر.remove(عنصر)
    ارجع [دقيق, لوني]

تأكد_يساوي(قيّم([1, 2, 3, 4], [1, 3, 2, 4]), [2, 2], "اثنان دقيق واثنان لوني")
تأكد_يساوي(قيّم([1, 1, 2, 2], [1, 2, 3, 4]), [1, 1], "مع تكرار")
تأكد_يساوي(قيّم([5, 6, 7, 8], [5, 6, 7, 8]), [4, 0], "مطابقة تامة")
