# مثال 1661 — أولي متناظر
# Palindromic prime check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1661-palindromic-prime-check.apl

# نختبر التناظر بقلب النص
# ثم نختبر الأولية بالقسمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أولي_متناظر(ن):
  لو ن < 2:
    ارجع خطأ
  ن_نص = نص(ن)
  معكوس_نص = ""
  لكل ح في ن_نص:
    معكوس_نص = ح + معكوس_نص
  لو معكوس_نص != ن_نص:
    ارجع خطأ
  ك = 2
  طالما ك * ك <= ن:
    لو ن % ك == 0:
      ارجع خطأ
    ك = ك + 1
  ارجع صواب

تأكد_يساوي(أولي_متناظر(131), صواب, "131")
تأكد_يساوي(أولي_متناظر(121), خطأ, "121 ليس أولياً")
تأكد_يساوي(أولي_متناظر(13), خطأ, "ليس متناظراً")
تأكد_يساوي(أولي_متناظر(2), صواب, "اثنان")
