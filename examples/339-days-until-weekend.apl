# مثال 339 — كم باقي على العطلة
# Days until weekend
# Demonstrates: حساب المسافة للجمعة
#
# Run:  python apl.py examples/339-days-until-weekend.apl

المتغير اليوم = التاريخ_اليوم()
المتغير باقي = (4 - اليوم.weekday()) % 7
لو باقي == 0:
    اطبع "اليوم جمعة، العطلة بدأت!"
الا لو باقي == 1:
    اطبع "باقي يوم واحد على الجمعة"
الا:
    اطبع "باقي", باقي, "أيام على الجمعة"
