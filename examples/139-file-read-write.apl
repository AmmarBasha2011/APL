# مثال 139 — القراءة والكتابة الأساسية للملفات
# Basic file read and write
# Demonstrates: اكتب، اقرأ، موجود، احذف_ملف
#
# Run:  python apl.py examples/139-file-read-write.apl

المتغير مسار = "/tmp/apl_rw_demo.txt"
اكتب(مسار, "السطر الأول\nالسطر الثاني\n")
اطبع "موجود بعد الكتابة؟", موجود(مسار)

المتغير محتوى = اقرأ(مسار)
اطبع "المحتوى:", محتوى.تقليم()
اطبع "عدد الأسطر:", طول(محتوى.تقليم().تقسيم("\n"))

اكتب(مسار, محتوى + "السطر الثالث\n")
اطبع "بعد الإضافة:", طول(اقرأ(مسار).تقليم().تقسيم("\n")), "أسطر"

احذف_ملف(مسار)
اطبع "حُذف؟", ليس موجود(مسار)
