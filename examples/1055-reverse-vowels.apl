# مثال 1055 — عكس الحروف المتحركة
# Reverse vowels of a string
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1055-reverse-vowels.apl

# مؤشر من كل طرف يتخطى الحروف غير العلة
# ونبدل حرفي العلة عند التقائهما

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة علة(ح):
  ارجع ح في "aeiouAEIOU"

دالة اعكس_علة(نص_):
  ق = قائمة(نص_)
  ي = 0
  ل = طول(ق) - 1
  طالما ي < ل:
    لو ليس علة(ق[ي]):
      ي = ي + 1
    والا_لو ليس علة(ق[ل]):
      ل = ل - 1
    والا:
      مؤقت = ق[ي]
      ق[ي] = ق[ل]
      ق[ل] = مؤقت
      ي = ي + 1
      ل = ل - 1
  ارجع "".ضم(ق)

تأكد_يساوي(اعكس_علة("hello"), "holle", "hello")
تأكد_يساوي(اعكس_علة("leetcode"), "leotcede", "leetcode")
تأكد_يساوي(اعكس_علة("xyz"), "xyz", "بلا علة")
