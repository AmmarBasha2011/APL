# مثال 2268 — أصغر أولي في ثنائية غولدباخ
# Goldbach smallest prime
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2268-goldbach-first-pair-smaller-prime.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  د = 2
  طالما د * د <= ن:
    لو ن % د == 0:
      ارجع خطأ
    د = د + 1
  ارجع صواب

دالة ف(ن):
  لكل ي في نطاق(2, ن):
    لو اولي(ي) و اولي(ن - ي):
      ارجع ي
  ارجع -1

تأكد_يساوي(ف(4), 2, "حالة 1")
تأكد_يساوي(ف(10), 3, "حالة 2")
تأكد_يساوي(ف(28), 5, "حالة 3")
تأكد_يساوي(ف(100), 3, "حالة 4")
