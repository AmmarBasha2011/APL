# مثال 2357 — المضاعف المشترك الأصغر للقائمة
# LCM of list
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2357-list-lcm-of-all-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ق2(أ, ب):
  أ0 = أ
  ب0 = ب
  طالما ب != 0:
    أ, ب = ب, أ % ب
  ارجع أ0 * ب0 // أ

دالة ف(ق):
  م = ق[0]
  لكل ع في ق:
    م = ق2(م, ع)
  ارجع م

تأكد_يساوي(ف([4, 6]), 12, "حالة 1")
تأكد_يساوي(ف([5]), 5, "حالة 2")
تأكد_يساوي(ف([2, 3, 4]), 12, "حالة 3")
تأكد_يساوي(ف([3, 5, 7]), 105, "حالة 4")
