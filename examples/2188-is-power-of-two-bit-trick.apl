# مثال 2188 — هل هو قوة اثنين
# Is power of two bit trick
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2188-is-power-of-two-bit-trick.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن > 0 و (ن & (ن - 1)) == 0

تأكد_يساوي(ف(1), صواب, "حالة 1")
تأكد_يساوي(ف(2), صواب, "حالة 2")
تأكد_يساوي(ف(3), خطأ, "حالة 3")
تأكد_يساوي(ف(64), صواب, "حالة 64")
تأكد_يساوي(ف(100), خطأ, "حالة 100")
تأكد_يساوي(ف(1024), صواب, "حالة 1024")
