# مثال 834 — طريقة التنصيف
# Bisection method
# Demonstrates: قيمة وسيطة، تقارب مضمون
#
# Run:  python apl.py examples/834-bisection-method.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# طريقة التنصيف لإيجاد الجذور: تقييد الجذر بين علامتين متعاكستين
# Demonstrates: نظرية القيمة الوسيطة, تنصيف متكرر, تقارب مضمون

دالة كثيرة(س):
  ارجع س * س * س - س - 2

دالة تنصيف(أدنى, أعلى, خطوات):
  أ = أدنى * 1.0
  ب = أعلى * 1.0
  لكل ي في نطاق(خطوات):
    منتصف = (أ + ب) / 2
    لو كثيرة(أ) * كثيرة(منتصف) <= 0:
      ب = منتصف
    والا:
      أ = منتصف
  ارجع (أ + ب) / 2

تأكد_يساوي(مقرب(تنصيف(1, 2, 30), 6), 1.52138, "جذر كثيرة الحدود")
تأكد_يساوي(مقرب(كثيرة(1.5213797), 4), 0.0, "التحقق من الجذر")
تأكد_يساوي(مقرب(تنصيف(1, 2, 10), 4), 1.521, "عشر خطوات")
تأكد_يساوي(مقرب(تنصيف(1, 2, 40), 8), 1.52137971, "أربعون خطوة")
