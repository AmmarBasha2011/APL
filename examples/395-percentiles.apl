# مثال 395 — المئينيات
# Percentiles
# Demonstrates: الربعية والمئين
#
# Run:  python apl.py examples/395-percentiles.apl

دالة مئين(قائمة, نسبة):
    المتغير م = مفرز(قائمة)
    المتغير فهرس = (طول(م) - 1) * نسبة / 100
    المتغير أدنى = صحيح(فهرس)
    المتغير أعلى = أدنى + 1
    لو أعلى >= طول(م):
        ارجع م[أدنى]
    المتغير كسر = فهرس - أدنى
    ارجع م[أدنى] + (م[أعلى] - م[أدنى]) * كسر

المتغير درجات = [55, 60, 65, 70, 75, 80, 85, 90, 95, 100]
اطبع "المئين 25:", مئين(درجات, 25)
اطبع "المئين 50:", مئين(درجات, 50)
اطبع "المئين 90:", مئين(درجات, 90)
