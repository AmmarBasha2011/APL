# مثال 2998 — مجموع أرقام 28 أس ن
# Digit sum of 28 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2998-digit-sum-of-28-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 28 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 10, "حالة 2")
تأكد_يساوي(ف(5), 28, "حالة 3")
تأكد_يساوي(ف(10), 82, "حالة 4")
تأكد_يساوي(ف(20), 127, "حالة 5")
