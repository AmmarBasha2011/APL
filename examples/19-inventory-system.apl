# مثال 19 — نظام إدارة مخزون
# Inventory Management System
# Demonstrates: dictionaries, dataclasses-like, search, reports
#
# Run:  python apl.py examples/19-inventory-system.apl

المتغير المخزون = {
    "قلم": {"الكمية": 150, "السعر": 2, "الحد_الأدنى": 50},
    "دفتر": {"الكمية": 30, "السعر": 15, "الحد_الأدنى": 20},
    "ممحاة": {"الكمية": 10, "السعر": 5, "الحد_الأدنى": 25},
    "مسطرة": {"الكمية": 80, "السعر": 8, "الحد_الأدنى": 30}
}

دالة قيمة_المخزون():
    الإجمالي = 0
    لكل صنف في المخزون:
        الإجمالي = الإجمالي + المخزون[صنف]["الكمية"] * المخزون[صنف]["السعر"]
    ارجع الإجمالي

دالة أصناف_منخفضة():
    النتيجة = []
    لكل صنف في المخزون:
        لو المخزون[صنف]["الكمية"] < المخزون[صنف]["الحد_الأدنى"]:
            النتيجة.ألحق(صنف)
    ارجع النتيجة

دالة إعادة_تعبئة(صنف, كمية):
    المخزون[صنف]["الكمية"] = المخزون[صنف]["الكمية"] + كمية

اطبع "=== إدارة المخزون ==="
اطبع ""
اطبع "--- تقرير الأصناف ---"
لكل صنف في المخزون:
    ع = المخزون[صنف]
    اطبع "  " + صنف + ": كمية " + نص(ع["الكمية"]) + " × " + نص(ع["السعر"]) + " = " + نص(ع["الكمية"] * ع["السعر"])
اطبع ""
اطبع "قيمة المخزون الكلية: " + نص(قيمة_المخزون())
اطبع ""
اطبع "--- أصناف تحتاج إعادة تعبئة ---"
لكل صنف في أصناف_منخفضة():
    اطبع "  " + صنف + " (" + نص(المخزون[صنف]["الكمية"]) + " < " + نص(المخزون[صنف]["الحد_الأدنى"]) + ")"
اطبع ""
إعادة_تعبئة("ممحاة", 40)
إعادة_تعبئة("دفتر", 10)
اطبع "--- بعد إعادة التعبئة ---"
اطبع "  ممحاة: " + نص(المخزون["ممحاة"]["الكمية"])
اطبع "  دفتر:  " + نص(المخزون["دفتر"]["الكمية"])
اطبع "  ما زال منخفضاً: " + نص(أصناف_منخفضة())
