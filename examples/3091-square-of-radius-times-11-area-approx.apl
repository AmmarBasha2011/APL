# مثال 3091 — مساحة دائرة بتقريب 11
# Circle area with pi approx 11/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3091-square-of-radius-times-11-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 11 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(7), 77, "حالة 3")
تأكد_يساوي(ف(14), 308, "حالة 4")
تأكد_يساوي(ف(21), 693, "حالة 5")
