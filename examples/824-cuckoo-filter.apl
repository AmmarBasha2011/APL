# مثال 824 — مرشح كوكو
# Cuckoo filter
# Demonstrates: بصمات 8-بت، دلوان بديلان
#
# Run:  python apl.py examples/824-cuckoo-filter.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مرشح كوكو: بصمات 8-بت في دلوين بديلين مع طرد كالوقواق
# Demonstrates: بصمة بالضرب, دلو ثان بXOR, استعلام بحذف ممكن

حجم = 16

دالة بصمة(عنصر):
  ق = (عنصر * 2654435761) % 4294967296
  ارجع (ق >> 24) | 1

دالة دلو1(عنصر):
  ارجع عنصر % حجم

دالة دلو2(عنصر, ب):
  ارجع (دلو1(عنصر) ^ (ب * 1540483477)) % حجم

دالة مرشح_جديد():
  جدول = []
  لكل ي في نطاق(حجم):
    جدول.append(0)
  ارجع جدول

دالة أدخل(جدول, عنصر):
  ب = بصمة(عنصر)
  أول = دلو1(عنصر)
  لو جدول[أول] == 0:
    جدول[أول] = ب
    ارجع أول
  ثان = دلو2(عنصر, ب)
  لو جدول[ثان] == 0:
    جدول[ثان] = ب
    ارجع ثان
  ارجع 0 - 1

دالة موجود(جدول, عنصر):
  ب = بصمة(عنصر)
  لو جدول[دلو1(عنصر)] == ب:
    ارجع 1
  لو جدول[دلو2(عنصر, ب)] == ب:
    ارجع 1
  ارجع 0

تأكد_يساوي(بصمة(10), 47, "بصمة عشرة")
تأكد_يساوي(دلو1(10), 10, "دلو أول")
تأكد_يساوي(دلو2(10, 47), 1, "دلو ثان")
جدول = مرشح_جديد()
تأكد_يساوي(أدخل(جدول, 10), 10, "إدخال في البيت")
تأكد_يساوي(أدخل(جدول, 26), 15, "إدخال في الدلو البديل")
تأكد_يساوي(أدخل(جدول, 42), 3, "إدخال ثالث")
تأكد_يساوي(موجود(جدول, 26), 1, "موجود")
تأكد_يساوي(موجود(جدول, 99), 0, "غير موجود")
