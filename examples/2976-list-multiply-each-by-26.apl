# مثال 2976 — ضرب كل عنصر في 26
# Multiply each item by 26
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2976-list-multiply-each-by-26.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 26]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [78, 26, 52], "حالة 1")
تأكد_يساوي(ف([5]), [130], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [26, 52, 78, 104, 130, 156], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-52, 0, 182, 182, 104], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [260, 520, 260, 780, 520, 260], "حالة 5")
