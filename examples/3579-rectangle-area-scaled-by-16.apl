# مثال 3579 — مساحة مستطيل مكبر 16 مرات
# Rectangle area scaled by 16
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3579-rectangle-area-scaled-by-16.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 16) * (ق[1] * 16)

تأكد_يساوي(ف([1, 2]), 512, "حالة 1")
تأكد_يساوي(ف([3, 4]), 3072, "حالة 2")
تأكد_يساوي(ف([5, 5]), 6400, "حالة 3")
تأكد_يساوي(ف([10, 1]), 2560, "حالة 4")
