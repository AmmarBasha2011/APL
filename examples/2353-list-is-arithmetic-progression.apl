# مثال 2353 — هل هي متوالية حسابية
# Is arithmetic progression
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2353-list-is-arithmetic-progression.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لكل ي في نطاق(2, طول(ق)):
    لو ق[ي] - ق[ي - 1] != ق[1] - ق[0]:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف([1, 3, 5]), صواب, "حالة 1")
تأكد_يساوي(ف([1, 2, 4]), خطأ, "حالة 2")
تأكد_يساوي(ف([5, 5, 5]), صواب, "حالة 3")
تأكد_يساوي(ف([10, 7, 4, 1]), صواب, "حالة 4")
تأكد_يساوي(ف([1, 2]), صواب, "حالة 5")
