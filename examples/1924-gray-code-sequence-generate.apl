# مثال 1924 — متتالية جراي
# Generate Gray code sequence
# Demonstrates: بتات
#
# Run:  python apl.py examples/1924-gray-code-sequence-generate.apl

# الصيغة ك xor (ك >> 1)
# نولد كل العناصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جراي(ب):
  خرج = []
  لكل ك في نطاق(1 << ب):
    خرج = خرج + [ك ^ (ك >> 1)]
  ارجع خرج

دالة بتات_مختلفة(أ, ب):
  س = أ ^ ب
  عد = 0
  طالما س > 0:
    عد = عد + (س & 1)
    س = س >> 1
  ارجع عد

ج = جراي(3)
تأكد_يساوي(ج, [0, 1, 3, 2, 6, 7, 5, 4], "٣ بتات")
تأكد_يساوي(بتات_مختلفة(ج[3], ج[4]), 1, "فرق بت")
تأكد_يساوي(بتات_مختلفة(ج[7], ج[0]), 1, "دائرية")
