# مثال 1312 — تركيبات k
# Combinations n choose k
# Demonstrates: بناء تراكمي
#
# Run:  python apl.py examples/1312-combinations-k.apl

# نبني الاختيارات بترتيب تصاعدي
# فلا يتكرر اختيار بترتيب مختلف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تركيبات_ك(ن, ك):
  ناتج = [[]]
  لكل ر في نطاق(ك):
    جديد = []
    لكل ق في ناتج:
      بداية = 1
      لو طول(ق) > 0:
        بداية = ق[-1] + 1
      لكل س في نطاق(بداية, ن + 1):
        جديد.ألحق(ق + [س])
    ناتج = جديد
  ارجع ناتج

تأكد_يساوي(تركيبات_ك(4, 2), [[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]], "أربعة واثنان")
تأكد_يساوي(تركيبات_ك(1, 1), [[1]], "واحد")
تأكد_يساوي(طول(تركيبات_ك(6, 3)), 20, "ستة وثلاثة")
تأكد_يساوي(تركيبات_ك(3, 0), [[]], "صفر")
