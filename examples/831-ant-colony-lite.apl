# مثال 831 — مستعمرة النمل
# Ant colony
# Demonstrates: فرمون وتبخير، اختيار احتمالي
#
# Run:  python apl.py examples/831-ant-colony-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مستعمرة نمل لأقصر جولة: فرمون يتبخر ويتراكم على الجولات الجيدة
# Demonstrates: اختيار احتمالي بفرمون ومرشد, تبخير وترسيب, LCG حتمي

مسافات = [[0, 2, 9, 10], [1, 0, 6, 4], [15, 7, 0, 8], [6, 3, 12, 0]]

دالة مستعمرة(دورات):
  فرمون = []
  لكل ي في نطاق(4):
    صف = []
    لكل ج في نطاق(4):
      صف.append(1.0)
    فرمون.append(صف)
  بذرة = 12345
  أفضل = []
  أقصر = 1000000.0
  لكل دورة في نطاق(دورات):
    لكل نملة في نطاق(4):
      مزار = [نملة % 4]
      طالما طول(مزار) < 4:
        حالي = مزار[طول(مزار) - 1]
        احتمالات = []
        لكل ج في نطاق(4):
          لو ج في مزار:
            احتمالات.append(0.0)
          والا:
            احتمالات.append(فرمون[حالي][ج] / مسافات[حالي][ج])
        مجموع = 0.0
        لكل ح في احتمالات:
          مجموع = مجموع + ح
        بذرة = (بذرة * 1103515245 + 12345) % 2147483648
        قرعة = بذرة / 2147483648.0 * مجموع
        تراكم = 0.0
        اختير = 0 - 1
        لكل ج في نطاق(4):
          لو اختير == 0 - 1:
            تراكم = تراكم + احتمالات[ج]
            لو قرعة <= تراكم:
              اختير = ج
        لو اختير == 0 - 1:
          اختير = 0
          لكل ج في نطاق(1, 4):
            لو احتمالات[ج] > احتمالات[اختير]:
              اختير = ج
        مزار.append(اختير)
      طول_جولة = 0
      لكل ي في نطاق(4):
        طول_جولة = طول_جولة + مسافات[مزار[ي]][مزار[(ي + 1) % 4]]
      لو طول_جولة < أقصر:
        أقصر = طول_جولة * 1.0
        أفضل = []
        لكل عقدة في مزار:
          أفضل.append(عقدة)
    لكل ي في نطاق(4):
      لكل ج في نطاق(4):
        فرمون[ي][ج] = فرمون[ي][ج] * 0.5
    لكل ي في نطاق(4):
      فرمون[أفضل[ي]][أفضل[(ي + 1) % 4]] = فرمون[أفضل[ي]][أفضل[(ي + 1) % 4]] + 1.0 / أقصر
  ارجع [أفضل, أقصر]

نتيجة = مستعمرة(20)
تأكد_يساوي(نتيجة[0], [1, 0, 2, 3], "أفضل جولة")
تأكد_يساوي(نتيجة[1], 21.0, "أقصر طول")
نتيجة2 = مستعمرة(5)
تأكد_يساوي(نتيجة2[1] <= 27.0 == خطأ, خطأ, "خمس دورات تتعلم أيضاً")
