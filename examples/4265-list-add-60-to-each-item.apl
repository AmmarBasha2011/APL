# مثال 4265 — إضافة 60 لكل عنصر
# Add 60 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4265-list-add-60-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 60]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [63, 61, 62], "حالة 1")
تأكد_يساوي(ف([5]), [65], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [61, 62, 63, 64, 65, 66], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [58, 60, 67, 67, 64], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [70, 80, 70, 90, 80, 70], "حالة 5")
