# مثال 298 — تحويل متعرج
# Zigzag conversion
# Demonstrates: توزيع على صفوف ثم قراءة
#
# Run:  python apl.py examples/298-zigzag.apl

دالة متعرج(نص_الدخل, صفوف):
    لو صفوف == 1:
        ارجع نص_الدخل
    المتغير أسطر = []
    لكل _ في نطاق(صفوف):
        أسطر.أضف("")
    المتغير سطر = 0
    المتغير اتجاه = 1
    لكل حرف في نص_الدخل:
        أسطر[سطر] = أسطر[سطر] + حرف
        لو سطر == 0:
            اتجاه = 1
        الا لو سطر == صفوف - 1:
            اتجاه = -1
        سطر = سطر + اتجاه
    ارجع "".ضم(أسطر)

اطبع متعرج("PAYPALISHIRING", 3)
اطبع متعرج("AB", 1)
