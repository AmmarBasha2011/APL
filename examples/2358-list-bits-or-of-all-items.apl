# مثال 2358 — OR لكل العناصر
# Bitwise OR of all
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2358-list-bits-or-of-all-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = 0
  لكل ع في ق:
    ن = ن | ع
  ارجع ن

تأكد_يساوي(ف([1, 2, 4]), 7, "حالة 1")
تأكد_يساوي(ف([5]), 5, "حالة 2")
تأكد_يساوي(ف([3, 5]), 7, "حالة 3")
تأكد_يساوي(ف([8, 8]), 8, "حالة 4")
