# مثال 38 — التحقق من سلامة البيانات
# File Integrity Verification
# Demonstrates: hashlib digests, comparing hashes
#
# Run:  python apl.py examples/38-hashlib-integrity.apl

دالة_بصمة(المحتوى):
    الترميز = المحتوى.encode("utf-8")
    ارجع [تجزئة_sha256(الترميز).hexdigest(), تجزئة_md5(الترميز).hexdigest()]

المتغير النصوص = ["مرحباً بالعالم", "Hello World", "تغيير طفيف"]

اطبع "=== التحقق من السلامة ==="
لكل نص في النصوص:
    البصمة = دالة_بصمة(نص)
    اطبع ""
    اطبع "النص   : " + نص
    اطبع "  SHA256: " + البصمة[0]
    اطبع "  MD5   : " + البصمة[1]
    اطبع "  الطول : " + نص(طول(نص))

اطبع ""
اطبع "--- هل نصان مختلفان لهما نفس البصمة؟ ---"
الأولى = دالة_بصمة("مرحباً بالعالم")[1]
الثانية = دالة_بصمة("مرحبا بالعالم")[1]
اطبع "  الأولى : " + الأولى
اطبع "  الثانية: " + الثانية
اطبع "  متساويان: " + نص(الأولى == الثانية)
