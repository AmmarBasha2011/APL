# مثال 13 — عمليات المصفوفات
# Matrix Operations
# Demonstrates: nested lists, indexing, nested while-loops
#
# Run:  python apl.py examples/13-matrix-ops.apl

دالة اطبع_مصفوفة(مصفوفة):
    لكل صف في مصفوفة:
        اطبع "  " + نص(صف)

دالة جمع_مصفوفتين(أ, ب):
    النتيجة = []
    صف = 0
    طالما صف < طول(أ):
        صف_جديد = []
        عمود = 0
        طالما عمود < طول(أ[صف]):
            صف_جديد.ألحق(أ[صف][عمود] + ب[صف][عمود])
            عمود = عمود + 1
        النتيجة.ألحق(صف_جديد)
        صف = صف + 1
    ارجع النتيجة

دالة ضرب_مصفوفتين(أ, ب):
    النتيجة = []
    صف = 0
    طالما صف < طول(أ):
        صف_جديد = []
        عمود = 0
        طالما عمود < طول(ب[0]):
            مجموع = 0
            ك = 0
            طالما ك < طول(أ[0]):
                مجموع = مجموع + أ[صف][ك] * ب[ك][عمود]
                ك = ك + 1
            صف_جديد.ألحق(مجموع)
            عمود = عمود + 1
        النتيجة.ألحق(صف_جديد)
        صف = صف + 1
    ارجع النتيجة

المتغير الأولى = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
المتغير الثانية = [[9, 8, 7], [6, 5, 4], [3, 2, 1]]

اطبع "=== عمليات المصفوفات ==="
اطبع "المصفوفة الأولى:"
اطبع_مصفوفة(الأولى)
اطبع ""
اطبع "المصفوفة الثانية:"
اطبع_مصفوفة(الثانية)
اطبع ""
اطبع "مجموعهما:"
اطبع_مصفوفة(جمع_مصفوفتين(الأولى, الثانية))
اطبع ""
اطبع "حاصل ضربهما:"
اطبع_مصفوفة(ضرب_مصفوفتين(الأولى, الثانية))
