# مثال 194 — غربال إراتوستينس
# Sieve of Eratosthenes
# Demonstrates: قوائم منطقية، حلقات متداخلة
#
# Run:  python apl.py examples/194-sieve-primes.apl

دالة غربال(حد):
    المتغير أولي = [صواب لكل _ في نطاق(حد + 1)]
    أولي[0] = خطأ
    أولي[1] = خطأ
    لكل س في نطاق(2, حد + 1):
        لو أولي[س]:
            المتغير م = س * س
            طالما م <= حد:
                أولي[م] = خطأ
                م = م + س
    ارجع [س لكل س في نطاق(حد + 1) لو أولي[س]]

المتغير أولية = غربال(50)
اطبع "الأعداد الأولية حتى 50:", أولية
اطبع "عددها:", طول(أولية)
