# مثال 2424 — عدد إلى الأساس 4
# Number to base 4
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2424-number-to-base-4-string-v2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع "0"
  خ = ""
  طالما ن > 0:
    خ = نص(ن % 4) + خ
    ن = ن // 4
  ارجع خ

تأكد_يساوي(ف(0), "0", "حالة 1")
تأكد_يساوي(ف(1), "1", "حالة 2")
تأكد_يساوي(ف(4), "10", "حالة 3")
تأكد_يساوي(ف(50), "302", "حالة 4")
تأكد_يساوي(ف(255), "3333", "حالة 5")
