# مثال 3099 — مجموع ord مع إزاحة 4
# Sum of ord values plus 4 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3099-sum-of-ord-values-offset-4.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 4
  ارجع م

تأكد_يساوي(ف("a"), 101, "حالة 1")
تأكد_يساوي(ف("abc"), 306, "حالة 2")
تأكد_يساوي(ف("xyz"), 375, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
