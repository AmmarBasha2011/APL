# مثال 236 — نمط المحوّل
# Adapter pattern
# Demonstrates: توحيد واجهتين مختلفتين
#
# Run:  python apl.py examples/236-adapter.apl

صنف طابعة_قديمة:
    دالة اطبع_نص(ذات, نص_الدخل):
        اطبع "[طابعة قديمة]", نص_الدخل

صنف محول_طابعة:
    دالة_إنشاء(ذات, قديمة):
        ذات.قديمة = قديمة

    دالة طباعة_موحدة(ذات, محتوى):
        ذات.قديمة.اطبع_نص("محتوى: " + محتوى)

دالة أرسل_للطباعة(هدف, محتوى):
    هدف.طباعة_موحدة(محتوى)

المتغير محول = محول_طابعة(طابعة_قديمة())
أرسل_للطباعة(محول, "تقرير المبيعات")
