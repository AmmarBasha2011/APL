# مثال 2392 — صنف نقطة بمربع المسافة
# Point class with squared distance
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2392-class-point-distance-squared-and-move.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف نقطة:
    دالة_إنشاء(ذات, س, ص):
        ذات.س = س
        ذات.ص = ص

    دالة حرك(ذات, ا, ب):
        ذات.س = ذات.س + ا
        ذات.ص = ذات.ص + ب

    دالة مربع_البعد(ذات, ق):
        ارجع (ذات.س - ق.س) ** 2 + (ذات.ص - ق.ص) ** 2

أ = نقطة(0, 0)
ب = نقطة(3, 4)
تأكد_يساوي(أ.مربع_البعد(ب), 25, "٣-٤-٥")
أ.حرك(3, 4)
تأكد_يساوي(أ.مربع_البعد(ب), 0, "نفس المكان")
