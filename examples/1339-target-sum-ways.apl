# مثال 1339 — طرق المجموع الهدف
# Target sum ways
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1339-target-sum-ways.apl

# نحول المسألة إلى مجموع جزئي
# مجموع الموجبة يساوي نصف المجموع زائد الهدف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة طرق_هدف(أرقام, هدف):
  كل = 0
  لكل ر في أرقام:
    كل = كل + ر
  لو (كل + هدف) % 2 != 0:
    ارجع 0
  لو كل + هدف < 0:
    ارجع 0
  موجب = (كل + هدف) // 2
  طرق = [0] * (موجب + 1)
  طرق[0] = 1
  لكل ر في أرقام:
    لكل ع في نطاق(موجب, ر - 1, -1):
      طرق[ع] = طرق[ع] + طرق[ع - ر]
  ارجع طرق[موجب]

تأكد_يساوي(طرق_هدف([1,1,1,1,1], 3), 5, "خمس طرق")
تأكد_يساوي(طرق_هدف([1], 1), 1, "طريقة")
تأكد_يساوي(طرق_هدف([1,2], 10), 0, "مستحيل")
