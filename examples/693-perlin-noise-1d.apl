# مثال 693 — ضوضاء بيرلين أحادية
# 1D Perlin-style value noise
# Demonstrates: هاش حتمي، smoothstep، أوكتافات
#
# Run:  python apl.py examples/693-perlin-noise-1d.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ضوضاء قيم أحادية البعد بأسلوب بيرلين
# Demonstrates: هاش حتمي, تلطيف smoothstep, أوكتافات متراكبة
# لا مولد عشوائي: التجزئة تعطي نفس القيمة دائما

دالة هاش(ي):
  ح = (ي * 374761393 + 668265263) % 4294967296
  ح = (ح * 2246822519) % 4294967296
  ارجع (ح % 2000) / 1000.0 - 1.0

دالة تلطيف(ت):
  ارجع ت * ت * (3.0 - 2.0 * ت)

دالة ضوضاء(س):
  ي = صحيح(س)
  ف = س - ي
  أ = هاش(ي)
  ب = هاش(ي + 1)
  ارجع أ + (ب - أ) * تلطيف(ف)

دالة أوكتاف(س):
  ارجع ضوضاء(س) * 0.75 + ضوضاء(س * 2.0) * 0.25

تأكد_يساوي(مقرب(هاش(0), 3), -0.495, "هاش الصفر")
تأكد_يساوي(هاش(7), هاش(7), "الهاش حتمي")
تأكد_يساوي(تلطيف(0.5), 0.5, "منتصف التلطيف")
تأكد_يساوي(مقرب(ضوضاء(2.5), 4), مقرب(هاش(2) * 0.5 + هاش(3) * 0.5, 4), "استيفاء المنتصف")
عينة = أوكتاف(3.25)
تأكد_يساوي(عينة > -1.0 و عينة < 1.0, صواب, "الناتج ضمن المدى")
تأكد_يساوي(مقرب(أوكتاف(3.25), 6), مقرب(عينة, 6), "أوكتاف حتمي")
اطبع "أوكتاف(3.25):", مقرب(عينة, 4)
