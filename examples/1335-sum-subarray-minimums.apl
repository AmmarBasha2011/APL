# مثال 1335 — مجموع أصغر المصفوفات الجزئية
# Sum of subarray minimums
# Demonstrates: مكدس أحادي
#
# Run:  python apl.py examples/1335-sum-subarray-minimums.apl

# نحسب لكل عنصر عدد المصفوفات التي هو أصغرها
# نستخدم مكدساً متزايداً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجموع_اصغر(أرقام):
  ن = طول(أرقام)
  يسار = [0] * ن
  يمين = [0] * ن
  مكدس = []
  لكل ع في نطاق(ن):
    طالما (طول(مكدس) > 0) و (أرقام[مكدس[طول(مكدس) - 1]] > أرقام[ع]):
      مكدس.pop()
    لو طول(مكدس) == 0:
      يسار[ع] = ع + 1
    والا:
      يسار[ع] = ع - مكدس[طول(مكدس) - 1]
    مكدس.ألحق(ع)
  مكدس = []
  لكل ع في نطاق(ن - 1, -1, -1):
    طالما (طول(مكدس) > 0) و (أرقام[مكدس[طول(مكدس) - 1]] >= أرقام[ع]):
      مكدس.pop()
    لو طول(مكدس) == 0:
      يمين[ع] = ن - ع
    والا:
      يمين[ع] = مكدس[طول(مكدس) - 1] - ع
    مكدس.ألحق(ع)
  مجموع = 0
  لكل ع في نطاق(ن):
    مجموع = مجموع + أرقام[ع] * يسار[ع] * يمين[ع]
  ارجع مجموع

تأكد_يساوي(مجموع_اصغر([3,1,2,4]), 17, "أربعة")
تأكد_يساوي(مجموع_اصغر([11,81,94,43,3]), 444, "خمسة")
تأكد_يساوي(مجموع_اصغر([5]), 5, "عنصر")
