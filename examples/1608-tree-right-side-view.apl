# مثال 1608 — المنظر من اليمين لشجرة
# Binary tree right side view
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1608-tree-right-side-view.apl

# نمر على المستويات
# نأخذ آخر قيمة من كل مستوى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة منظر_أيمن(ش):
  لو ش == []:
    ارجع []
  ناتج = []
  حالي = [ش]
  طالما طول(حالي) > 0:
    ناتج.append(حالي[طول(حالي) - 1][0])
    تالي = []
    لكل ع في حالي:
      لو ع[1] != []:
        تالي.append(ع[1])
      لو ع[2] != []:
        تالي.append(ع[2])
    حالي = تالي
  ارجع ناتج

تأكد_يساوي(منظر_أيمن([1, [2, [], [5, [], []]], [3, [], [4, [], []]]]), [1, 3, 4], "ثلاثة")
تأكد_يساوي(منظر_أيمن([1, [2, [], []], []]), [1, 2], "يسار فقط")
تأكد_يساوي(منظر_أيمن([]), [], "فارغة")
