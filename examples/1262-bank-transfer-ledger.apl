# مثال 1262 — دفتر تحويلات
# Transfer ledger with rollback
# Demonstrates: معاملات
#
# Run:  python apl.py examples/1262-bank-transfer-ledger.apl

# التحويل ينجح فقط لو كفى الرصيد
# وندون كل عملية في دفتر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف دفتر:
  دالة_إنشاء(ذات):
    ذات.ارصدة = {}
    ذات.سجل = []

  دالة افتح(ذات, اسم, مبلغ):
    ذات.ارصدة[اسم] = مبلغ

  دالة حول(ذات, من, الى, مبلغ):
    لو ذات.ارصدة[من] < مبلغ:
      ذات.سجل.ألحق(["رفض", من, الى, مبلغ])
      ارجع خطأ
    ذات.ارصدة[من] = ذات.ارصدة[من] - مبلغ
    ذات.ارصدة[الى] = ذات.ارصدة[الى] + مبلغ
    ذات.سجل.ألحق(["نجح", من, الى, مبلغ])
    ارجع صواب

  دالة تراجع(ذات):
    لو طول(ذات.سجل) == 0:
      ارجع خطأ
    ع = ذات.سجل.pop()
    لو ع[0] == "نجح":
      ذات.ارصدة[ع[1]] = ذات.ارصدة[ع[1]] + ع[3]
      ذات.ارصدة[ع[2]] = ذات.ارصدة[ع[2]] - ع[3]
    ارجع صواب

د = دفتر()
د.افتح("a", 100)
د.افتح("b", 50)
تأكد_يساوي(د.حول("a", "b", 30), صواب, "نجح")
تأكد_يساوي(د.ارصدة["b"], 80, "رصيد b")
تأكد_يساوي(د.حول("b", "a", 500), خطأ, "رُفض")
د.تراجع()
تأكد_يساوي(د.ارصدة["a"], 70, "الرفض لا يغير")
د.تراجع()
تأكد_يساوي(د.ارصدة["a"], 100, "تراجع عن التحويل")
تأكد_يساوي(د.ارصدة["b"], 50, "رصيد b أصلي")
