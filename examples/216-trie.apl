# مثال 216 — شجرة البادئات (Trie)
# Prefix tree
# Demonstrates: قواميس متداخلة، إدراج كلمات وبحث بالبادئة
#
# Run:  python apl.py examples/216-trie.apl

دالة أدرج(جذر, كلمة):
    المتغير حالي = جذر
    لكل حرف في كلمة:
        لو حرف ليس في حالي:
            حالي[حرف] = {}
        حالي = حالي[حرف]
    حالي["#"] = صواب

دالة ابحث(جذر, كلمة):
    المتغير حالي = جذر
    لكل حرف في كلمة:
        لو حرف ليس في حالي:
            ارجع خطأ
        حالي = حالي[حرف]
    ارجع "#" في حالي

دالة يبدأ_بـ(جذر, بادئة):
    المتغير حالي = جذر
    لكل حرف في بادئة:
        لو حرف ليس في حالي:
            ارجع خطأ
        حالي = حالي[حرف]
    ارجع صواب

المتغير جذر = {}
لكل ك in ["car", "card", "care", "dog"]:
    أدرج(جذر, ك)

اطبع "care:", ابحث(جذر, "care")
اطبع "ca:", ابحث(جذر, "ca")
اطبع "بادئة ca:", يبدأ_بـ(جذر, "ca")
اطبع "بادئة da:", يبدأ_بـ(جذر, "da")
