# مثال 431 — منسق جداول نصية
# Text table formatter
# Demonstrates: عرض الأعمدة والحدود
#
# Run:  python apl.py examples/431-table-formatter.apl

دالة وسع_نص(نص_الدخل, عرض_مطلوب):
    المتغير ناتج = نص_الدخل
    طالما طول(ناتج) < عرض_مطلوب:
        ناتج = ناتج + " "
    ارجع ناتج

المتغير صفوف = [
    ["الاسم", "العمر", "المدينة"],
    ["عمار", "26", "المنصورة"],
    ["سارة", "24", "القاهرة"]
]

لكل صف_جدول في صفوف:
    اطبع "| " + وسع_نص(صف_جدول[0], 12) + "| " + وسع_نص(صف_جدول[1], 6) + "| " + وسع_نص(صف_جدول[2], 12) + "|"
