# مثال 408 — حرب السفن المصغرة
# Mini battleship
# Demonstrates: شبكة 5x5 ومحاولات
#
# Run:  python apl.py examples/408-battleship-mini.apl

بذرة(2)
المتغير سفينة_س = عشوائي_عدد(0, 4)
المتغير سفينة_ص = عشوائي_عدد(0, 4)
المتغير محاولات = [[1, 2], [3, 3], [سفينة_س, سفينة_ص]]

لكل محاولة in محاولات:
    لو محاولة[0] == سفينة_س و محاولة[1] == سفينة_ص:
        اطبع "إصابة في", محاولة[0], محاولة[1]
    الا:
        اطبع "خطأ في", محاولة[0], محاولة[1]
