# مثال 1317 — حلال سودوكو
# Sudoku solver backtracking small
# Demonstrates: رجوع
#
# Run:  python apl.py examples/1317-sudoku-solver-mini.apl

# نجرب كل رقم في أول خانة فارغة
# ونتراجع عند التعارض

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يصلح(ل, ص, ج, ق):
  لكل ك في نطاق(4):
    لو (ل[ص][ك] == ق) أو (ل[ك][ج] == ق):
      ارجع خطأ
  ر0 = (ص // 2) * 2
  ك0 = (ج // 2) * 2
  لكل ر في نطاق(2):
    لكل ك في نطاق(2):
      لو ل[ر0 + ر][ك0 + ك] == ق:
        ارجع خطأ
  ارجع صواب

دالة حل(ل):
  لكل ص في نطاق(4):
    لكل ج في نطاق(4):
      لو ل[ص][ج] == 0:
        لكل ق في [1, 2, 3, 4]:
          لو يصلح(ل, ص, ج, ق):
            ل[ص][ج] = ق
            لو حل(ل):
              ارجع صواب
            ل[ص][ج] = 0
        ارجع خطأ
  ارجع صواب

ل = [[1,0,0,0],[0,0,3,0],[0,4,0,0],[0,0,0,2]]
تأكد_يساوي(حل(ل), صواب, "حُلت")
لكل صف في ل:
  تأكد_يساوي(مفرز(صف), [1,2,3,4], "صف سليم")
