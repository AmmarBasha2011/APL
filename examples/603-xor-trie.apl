# مثال 603 — شجرة XOR
# XOR trie
# Demonstrates: شجرة بتات، أو-حصري، أقصى زوج
#
# Run:  python apl.py examples/603-xor-trie.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شجرة XOR: أكبر حصيلة أو-حصري بين زوج
# Demonstrates: شجرة ثنائية على البتات, بحث جشع عن المكمل
# أسرع من فحص كل الأزواج للمصفوفات الكبيرة

دالة أقصى_أو(أرقام):
  أعلى_بت = 5
  شجرة = {}
  لكل عدد في أرقام:
    عقدة = شجرة
    لكل بت في نطاق(أعلى_بت, -1, -1):
      ب = (عدد // (2 ** بت)) % 2
      لو ب في عقدة:
        عقدة = عقدة[ب]
      والا:
        عقدة[ب] = {}
        عقدة = عقدة[ب]
  أقصى = 0
  لكل عدد في أرقام:
    عقدة = شجرة
    مرشح = 0
    لكل بت في نطاق(أعلى_بت, -1, -1):
      ب = (عدد // (2 ** بت)) % 2
      مكمل = 1 - ب
      لو مكمل في عقدة:
        مرشح = مرشح + 2 ** بت
        عقدة = عقدة[مكمل]
      والا:
        عقدة = عقدة[ب]
    لو مرشح > أقصى:
      أقصى = مرشح
  ارجع أقصى

نتيجة = أقصى_أو([3, 10, 5, 25, 2, 8])
اطبع "أقصى أو-حصري:", نتيجة
تأكد_يساوي(نتيجة, 28, "خمسة XOR خمسة وعشرون")
تأكد_يساوي(5 ^ 25, 28, "تحقق مباشر")
