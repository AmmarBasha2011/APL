# مثال 535 — فاتورة بضريبة القيمة المضافة
# VAT invoice
# Demonstrates: ضريبة قيمة مضافة، فاتورة بنود
#
# Run:  python apl.py examples/535-vat-invoice.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# فاتورة بضريبة قيمة مضافة 14%
المتغير بنود = [["طابعة", 1200, 1], ["حبر", 350, 2], ["ورق", 90, 5]]
المتغير إجمالي_قبل = 0
لكل بند في بنود:
    إجمالي_قبل = إجمالي_قبل + بند[1] * بند[2]
    اطبع بند[0], "×", بند[2], "=", بند[1] * بند[2]
المتغير ضريبة = إجمالي_قبل * 14 / 100
المتغير إجمالي = إجمالي_قبل + ضريبة
اطبع "قبل الضريبة:", إجمالي_قبل
اطبع "الضريبة:", ضريبة
اطبع "الإجمالي:", إجمالي
تأكد_يساوي(إجمالي_قبل, 2350, "الإجمالي قبل الضريبة")
تأكد_يساوي(ضريبة, 329, "ضريبة 14%")
تأكد_يساوي(إجمالي, 2679, "الإجمالي النهائي")
