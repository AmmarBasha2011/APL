# مثال 110 — تقرير إحصائي لدرجات طلاب
# Statistics report for student grades
# Demonstrates: متوسط، وسيط، منوال، تباين، انحراف_معياري، متوسط_هندسي
#
# Run:  python apl.py examples/110-statistics-data.apl

المتغير درجات = [85, 92, 78, 90, 88, 76, 95, 89, 84, 91]
اطبع "الدرجات:", درجات
اطبع "العدد:", طول(درجات)
اطبع "المتوسط الحسابي:", متوسط(درجات)
اطبع "الوسيط:", وسيط(درجات)
اطبع "المنوال:", منوال([1, 2, 2, 3, 3, 3, 4])
اطبع "التباين:", مقرب(تباين(درجات), 3)
اطبع "الانحراف المعياري:", مقرب(انحراف_معياري(درجات), 3)
اطبع "المتوسط الهندسي:", مقرب(متوسط_هندسي(درجات), 3)
اطبع "أعلى درجة:", أكبر(درجات)
اطبع "أقل درجة:", أصغر(درجات)
