# مثال 1615 — عدد الجزر في شبكة
# Count islands in a grid
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1615-island-count-grid.apl

# نبدأ من كل واحد لم نزره
# نلون كل الجيران بالبحث

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عدد_الجزر(شبكة):
  صفوف = طول(شبكة)
  لو صفوف == 0:
    ارجع 0
  أعمدة = طول(شبكة[0])
  زرنا = {}
  جزر = 0
  اتجاهات = [[1, 0], [-1, 0], [0, 1], [0, -1]]
  لكل ص في نطاق(صفوف):
    لكل ع في نطاق(أعمدة):
      مفتاح = نص(ص) + "," + نص(ع)
      لو شبكة[ص][ع] == 1 و (مفتاح في زرنا) == خطأ:
        جزر = جزر + 1
        مكدس = [[ص, ع]]
        زرنا[مفتاح] = صواب
        طالما طول(مكدس) > 0:
          ح = مكدس.pop()
          لكل ات في اتجاهات:
            ن_ص = ح[0] + ات[0]
            ن_ع = ح[1] + ات[1]
            لو ن_ص >= 0 و ن_ص < صفوف و ن_ع >= 0 و ن_ع < أعمدة:
              مفتاح2 = نص(ن_ص) + "," + نص(ن_ع)
              لو شبكة[ن_ص][ن_ع] == 1 و (مفتاح2 في زرنا) == خطأ:
                زرنا[مفتاح2] = صواب
                مكدس.append([ن_ص, ن_ع])
  ارجع جزر

تأكد_يساوي(عدد_الجزر([[1, 1, 0], [0, 1, 0], [0, 0, 1]]), 2, "جزيرتان")
تأكد_يساوي(عدد_الجزر([[0, 0], [0, 0]]), 0, "بحر")
تأكد_يساوي(عدد_الجزر([[1, 0, 1], [0, 1, 0], [1, 0, 1]]), 5, "خمس")
