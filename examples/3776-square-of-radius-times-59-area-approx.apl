# مثال 3776 — مساحة دائرة بتقريب 59
# Circle area with pi approx 59/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3776-square-of-radius-times-59-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 59 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 8, "حالة 2")
تأكد_يساوي(ف(7), 413, "حالة 3")
تأكد_يساوي(ف(14), 1652, "حالة 4")
تأكد_يساوي(ف(21), 3717, "حالة 5")
