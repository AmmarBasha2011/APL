# مثال 3109 — إزاحة يسار 5 مع قناع بايت
# Shift left 5 and mask byte
# Demonstrates: بتات
#
# Run:  python apl.py examples/3109-shift-left-by-5-then-mask-byte.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن << 5) & 255

تأكد_يساوي(ف(1), 32, "حالة 1")
تأكد_يساوي(ف(3), 96, "حالة 2")
تأكد_يساوي(ف(85), 160, "حالة 3")
تأكد_يساوي(ف(170), 64, "حالة 4")
تأكد_يساوي(ف(255), 224, "حالة 5")
