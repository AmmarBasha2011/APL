# مثال 2394 — صنف طالب بالدرجات
# Student grades class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2394-class-student-grades-average-best.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف طالب:
    دالة_إنشاء(ذات, ا):
        ذات.ا = ا
        ذات.د = []

    دالة اضف(ذات, ق):
        ذات.د = ذات.د + [ق]

    دالة متوسط(ذات):
        ارجع sum(ذات.د) / طول(ذات.د)

    دالة اعلى(ذات):
        ارجع max(ذات.د)

ط = طالب("سلمى")
ط.اضف(80)
ط.اضف(90)
ط.اضف(100)
تأكد_يساوي(ط.متوسط(), 90, "المتوسط")
تأكد_يساوي(ط.اعلى(), 100, "الأعلى")
تأكد_يساوي(ط.ا, "سلمى", "الاسم")
