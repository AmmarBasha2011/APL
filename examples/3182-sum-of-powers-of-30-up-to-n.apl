# مثال 3182 — مجموع قوى 30
# Sum of powers of 30
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3182-sum-of-powers-of-30-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 30 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 31, "حالة 2")
تأكد_يساوي(ف(3), 27931, "حالة 3")
تأكد_يساوي(ف(6), 754137931, "حالة 4")
تأكد_يساوي(ف(10), 610851724137931, "حالة 5")
