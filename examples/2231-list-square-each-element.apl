# مثال 2231 — تربيع كل عنصر
# Square each element
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2231-list-square-each-element.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * ع]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [9, 1, 4], "حالة 1")
تأكد_يساوي(ف([5]), [25], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [1, 4, 9, 16, 25, 36], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [4, 0, 49, 49, 16], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [100, 400, 100, 900, 400, 100], "حالة 5")
