# مثال 2319 — فهرس أول حرف فريد
# First unique character index
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2319-first-once-only-letter-position.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لكل ي في نطاق(طول(ن)):
    لو ن.count(ن[ي]) == 1:
      ارجع ي
  ارجع -1

تأكد_يساوي(ف("leetcode"), 0, "حالة 1")
تأكد_يساوي(ف("aabb"), -1, "حالة 2")
تأكد_يساوي(ف("abc"), 0, "حالة 3")
تأكد_يساوي(ف("loveleetcode"), 2, "حالة 4")
