# مثال 1610 — عدد العقد الجيدة
# Count good nodes in a binary tree
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1610-count-good-nodes-tree.apl

# نمرر أكبر قيمة رأيناها
# العقدة جيدة إذا لم تقل عنها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جيدة(ش, أكبر_سابق):
  لو ش == []:
    ارجع 0
  عد = 0
  لو ش[0] >= أكبر_سابق:
    عد = 1
  جديد = أكبر(أكبر_سابق, ش[0])
  ارجع عد + جيدة(ش[1], جديد) + جيدة(ش[2], جديد)

تأكد_يساوي(جيدة([3, [1, [3, [], []], []], [4, [1, [], []], [5, [], []]]], -1000), 4, "أربع")
تأكد_يساوي(جيدة([1, [], []], -1000), 1, "جذر")
تأكد_يساوي(جيدة([], -1000), 0, "فارغة")
