# مثال 930 — بحث المقطع الذهبي
# Golden-section search
# Demonstrates: نقطتان داخليتان بالنسبة
#
# Run:  python apl.py examples/930-golden-section.apl

# بحث المقطع الذهبي: تقليل أحادي البعد بلا مشتقات
# يعيد استخدام إحدى النقطتين الداخليتين كل تكرار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# نصغر الدالة (س-3)^2+1 على [0,10]
دالة هدف(س):
  ارجع (س - 3) ** 2 + 1

أ = 0
ب = 10
نسبة = (جذر(5) - 1) / 2
ج = ب - نسبة * (ب - أ)
د = أ + نسبة * (ب - أ)
تكرارات = 0
طالما (ب - أ) > 0.000001 و تكرارات < 200:
  لو هدف(ج) < هدف(د):
    ب = د
  والا:
    أ = ج
  ج = ب - نسبة * (ب - أ)
  د = أ + نسبة * (ب - أ)
  تكرارات = تكرارات + 1

أدنى = (أ + ب) / 2
اطبع "موضع الأدنى:", أدنى
اطبع "التكرارات:", تكرارات

تأكد_يساوي(مقرب(أدنى, 4), 3, "الأدنى عند 3")
لو تكرارات >= 200:
  اطبع "فشل: لم يتقارب"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: تقارب خلال", تكرارات, "تكراراً"

# القيمة الدنيا هي 1
تأكد_يساوي(مقرب(هدف(أدنى), 6), 1, "قيمة الدالة الدنيا")
