# مثال 3374 — السعر بعد خصم 23 بالمئة
# Price after 23 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3374-price-after-23-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 23 // 100

تأكد_يساوي(ف(100), 77, "حالة 1")
تأكد_يساوي(ف(250), 193, "حالة 2")
تأكد_يساوي(ف(999), 770, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
