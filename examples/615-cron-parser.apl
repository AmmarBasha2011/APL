# مثال 615 — محلل كرون
# Cron parser
# Demonstrates: كرون، جدولة، حقول
#
# Run:  python apl.py examples/615-cron-parser.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# محلل كرون: متى يرن الجدول التالي؟
# Demonstrates: حقول كرون الخمسة, نجمة وخطوة وقائمة, بحث تصاعدي
# يحسب الدقائق المطابقة خلال يوم كامل

دالة يطابق_دقيقة(حقل, قيمة):
  لو حقل == "*":
    ارجع صواب
  لو حقل.startswith("*/"):
    خطوة = صحيح(حقل[2:])
    ارجع قيمة % خطوة == 0
  لكل جزء في حقل.split(","):
    لو صحيح(جزء) == قيمة:
      ارجع صواب
  ارجع خطأ

دالة يطابق(مواصفة, ساعة, دقيقة):
  حقول = مواصفة.split(" ")
  ارجع يطابق_دقيقة(حقول[0], دقيقة) و يطابق_دقيقة(حقول[1], ساعة)

دالة التالي(مواصفة, ساعة, دقيقة):
  لكل إزاحة في نطاق(1, 1441):
    كلي = ساعة * 60 + دقيقة + إزاحة
    س = (كلي // 60) % 24
    د = كلي % 60
    لو يطابق(مواصفة, س, د):
      ارجع [س, د]
  ارجع [-1, -1]

تأكد_يساوي(التالي("*/15 * * * *", 10, 7), [10, 15], "ربع ساعة")
تأكد_يساوي(التالي("0 9 * * *", 10, 30), [9, 0], "التاسعة صباحا غدا")
تأكد_يساوي(التالي("30 14 * * *", 10, 0), [14, 30], "اليوم نفسه")
تأكد_يساوي(يطابق("5,10 3 * * *", 3, 10), صواب, "قائمة دقائق")
اطبع "التالي بعد 10:07 لجدول */15:", التالي("*/15 * * * *", 10, 7)
