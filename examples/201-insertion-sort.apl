# مثال 201 — الترتيب بالإدراج
# Insertion sort
# Demonstrates: طالما المتداخلة، الإدراج في الموضع الصحيح
#
# Run:  python apl.py examples/201-insertion-sort.apl

دالة إدراج(قائمة):
    لكل ي في نطاق(1, طول(قائمة)):
        المتغير مفتاح = قائمة[ي]
        المتغير ز = ي - 1
        طالما ز >= 0 و قائمة[ز] > مفتاح:
            قائمة[ز + 1] = قائمة[ز]
            ز = ز - 1
        قائمة[ز + 1] = مفتاح
    ارجع قائمة

المتغير أرقام = [12, 11, 13, 5, 6]
اطبع "قبل:", أرقام
اطبع "بعد:", إدراج(أرقام)
