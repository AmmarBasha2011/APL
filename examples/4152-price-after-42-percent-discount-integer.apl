# مثال 4152 — السعر بعد خصم 42 بالمئة
# Price after 42 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4152-price-after-42-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 42 // 100

تأكد_يساوي(ف(100), 58, "حالة 1")
تأكد_يساوي(ف(250), 145, "حالة 2")
تأكد_يساوي(ف(999), 580, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
