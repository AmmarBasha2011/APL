# مثال 596 — تجزئة متسقة
# Consistent hashing
# Demonstrates: تجزئة متسقة، عقد، استقرار
#
# Run:  python apl.py examples/596-consistent-hashing.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# التجزئة المتسقة: توزيع مفاتيح على عقد قابلة للزيادة
# Demonstrates: حلقة تجزئة, استقرار التوزيع عند إزالة عقدة
# عند إزالة عقدة تعاد كتابة مفاتيحها فقط، لا كل المفاتيح

دالة تجزئة(نص):
  ح = 0
  لكل حرف في نص:
    ح = (ح * 31 + ترميز_حرف(حرف)) % 1000
  ارجع ح

دالة وّزع(مفاتيح, عقد):
  توزيع = {}
  لكل مفتاح في مفاتيح:
    عقدة = عقد[تجزئة(مفتاح) % طول(عقد)]
    توزيع[مفتاح] = عقدة
  ارجع توزيع

مفاتيح = []
لكل ي في نطاق(60):
  مفاتيح.append("مفتاح-" + نص(ي))

عقد_ثلاث = ["أ", "ب", "ج"]
ت = وّزع(مفاتيح, عقد_ثلاث)
عقد_بعد = ["أ", "ج"]
ت2 = وّزع(مفاتيح, عقد_بعد)

ثابتة = 0
لكل مفتاح في مفاتيح:
  لو ت[مفتاح] == ت2[مفتاح]:
    ثابتة = ثابتة + 1
اطبع "مفاتيح لم تتحرك بعد حذف عقدة:", ثابتة, "من", طول(مفاتيح)
تأكد_يساوي(ثابتة > 0, صواب, "أغلب التوزيع مستقر")
تأكد_يساوي(طول(ت2), 60, "كل المفاتيح ما زالت موزعة")
