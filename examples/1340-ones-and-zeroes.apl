# مثال 1340 — أصفار وآحاد
# Ones and zeroes subset size
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1340-ones-and-zeroes.apl

# حقيبة بحدين: عدد الأصفار وعدد الآحاد
# كل نص يكلف أصفاره وآحاده

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اكبر_مجموعة(نصوص, م, ن):
  د = []
  لكل ع في نطاق(م + 1):
    د.ألحق([0] * (ن + 1))
  لكل ن_ في نصوص:
    اصفار = 0
    آحاد = 0
    لكل ح في ن_:
      لو ح == "0":
        اصفار = اصفار + 1
      والا:
        آحاد = آحاد + 1
    لكل ع في نطاق(م, اصفار - 1, -1):
      لكل ج في نطاق(ن, آحاد - 1, -1):
        د[ع][ج] = أكبر(د[ع][ج], د[ع - اصفار][ج - آحاد] + 1)
  ارجع د[م][ن]

تأكد_يساوي(اكبر_مجموعة(["10","0001","111001","1","0"], 5, 3), 4, "أربعة")
تأكد_يساوي(اكبر_مجموعة(["10","0","1"], 1, 1), 2, "اثنان")
تأكد_يساوي(اكبر_مجموعة(["11"], 5, 1), 0, "لا يكفي")
