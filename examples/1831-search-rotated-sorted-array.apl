# مثال 1831 — البحث في مصفوفة مدورة
# Search in rotated sorted array
# Demonstrates: بحث
#
# Run:  python apl.py examples/1831-search-rotated-sorted-array.apl

# أحد النصفين مرتب دائماً
# نبحث فيه أو في الآخر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ابحث_مدور(ق, هدف):
  يسار = 0
  يمين = طول(ق) - 1
  طالما يسار <= يمين:
    وسط = (يسار + يمين) // 2
    لو ق[وسط] == هدف:
      ارجع وسط
    لو ق[يسار] <= ق[وسط]:
      لو ق[يسار] <= هدف و هدف < ق[وسط]:
        يمين = وسط - 1
      والا:
        يسار = وسط + 1
    والا:
      لو ق[وسط] < هدف و هدف <= ق[يمين]:
        يسار = وسط + 1
      والا:
        يمين = وسط - 1
  ارجع -1

تأكد_يساوي(ابحث_مدور([4, 5, 6, 7, 0, 1, 2], 0), 4, "صفر")
تأكد_يساوي(ابحث_مدور([4, 5, 6, 7, 0, 1, 2], 3), -1, "غائب")
تأكد_يساوي(ابحث_مدور([1], 1), 0, "واحد")
