# مثال 787 — عناوين IPv4 وCIDR
# IPv4 and CIDR
# Demonstrates: قناع بادئة، شبكة وبث
#
# Run:  python apl.py examples/787-ipv4-cidr.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# عناوين IPv4 وCIDR: تحويل، تحقق، مطابقة شبكة، حساب الشبكات الفرعية
# Demonstrates: عنوان 32-بت, قناع بادئة, عنوان الشبكة والبث

دالة عنوان_عدد(نص):
  أجزاء = نص.split(".")
  لو طول(أجزاء) != 4:
    ارجع 0 - 1
  عدد = 0
  لكل جزء في أجزاء:
    لو طول(جزء) == 0:
      ارجع 0 - 1
    لكل حرف في جزء:
      لو حرف < "0" أو حرف > "9":
        ارجع 0 - 1
    ق = صحيح(جزء)
    لو ق > 255:
      ارجع 0 - 1
    عدد = عدد * 256 + ق
  ارجع عدد

دالة عدد_عنوان(عدد):
  أ = (عدد // 16777216) % 256
  ب = (عدد // 65536) % 256
  ج = (عدد // 256) % 256
  د = عدد % 256
  ارجع نص(أ) + "." + نص(ب) + "." + نص(ج) + "." + نص(د)

دالة قناع(بتات):
  لو بتات == 0:
    ارجع 0
  ارجع (4294967296 - قوة2(32 - بتات)) % 4294967296

دالة قوة2(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 2
  ارجع ق

دالة في_شبكة(عنوان, شبكة):
  أجزاء = شبكة.split("/")
  أساس = عنوان_عدد(أجزاء[0])
  بتات = صحيح(أجزاء[1])
  ق = قناع(بتات)
  ارجع (عنوان_عدد(عنوان) & ق) == (أساس & ق)

تأكد_يساوي(عنوان_عدد("192.168.1.5"), 3232235781, "عنوان إلى عدد")
تأكد_يساوي(عدد_عنوان(3232235781), "192.168.1.5", "عدد إلى عنوان")
تأكد_يساوي(عنوان_عدد("256.1.1.1"), 0 - 1, "مقطة فاسدة")
تأكد_يساوي(عنوان_عدد("1.2.3"), 0 - 1, "ثلاث مقطوعات")
تأكد_يساوي(في_شبكة("192.168.1.5", "192.168.1.0/24"), صواب, "داخل /24")
تأكد_يساوي(في_شبكة("192.168.2.5", "192.168.1.0/24"), خطأ, "خارج /24")
تأكد_يساوي(في_شبكة("10.0.0.1", "10.0.0.0/8"), صواب, "داخل /8")
ق26 = قناع(26)
شبكة = 3232235776 & ق26
تأكد_يساوي(عدد_عنوان(شبكة), "192.168.1.0", "شبكة /26")
بث = شبكة | (4294967295 ^ ق26)
تأكد_يساوي(عدد_عنوان(بث), "192.168.1.63", "بث /26")
تأكد_يساوي(قوة2(32 - 26) - 2, 62, "مضيفو /26")
