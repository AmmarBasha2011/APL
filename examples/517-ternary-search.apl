# مثال 517 — البحث الثلاثي
# Ternary search
# Demonstrates: بحث ثلاثي، تقسيم ثلاثي
#
# Run:  python apl.py examples/517-ternary-search.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# بحث ثلاثي في قائمة مفرزة
دالة بحث_ثلاثي(ق, هدف):
    المتغير ب = 0
    المتغير ن = طول(ق) - 1
    طالما ب <= ن:
        المتغير ث1 = ب + (ن - ب) // 3
        المتغير ث2 = ن - (ن - ب) // 3
        لو ق[ث1] == هدف:
            ارجع ث1
        لو ق[ث2] == هدف:
            ارجع ث2
        لو هدف < ق[ث1]:
            ن = ث1 - 1
        الا لو هدف > ق[ث2]:
            ب = ث2 + 1
        الا:
            ب = ث1 + 1
            ن = ث2 - 1
    ارجع -1

المتغير ق = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]
تأكد_يساوي(بحث_ثلاثي(ق, 23), 5, "ثلاثي: 23")
تأكد_يساوي(بحث_ثلاثي(ق, 91), 9, "ثلاثي: الأخير")
تأكد_يساوي(بحث_ثلاثي(ق, 4), -1, "ثلاثي: غائب")
