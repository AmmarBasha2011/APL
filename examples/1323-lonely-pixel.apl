# مثال 1323 — بكسل وحيد
# Lonely pixel count
# Demonstrates: شبكة
#
# Run:  python apl.py examples/1323-lonely-pixel.apl

# نعد السود في كل صف وعمود
# ونحسب البكسلات التي صفها وعمودها كل منهما بواحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة وحيدة(ل):
  ر_ = طول(ل)
  ك_ = طول(ل[0])
  صفوف = [0] * ر_
  اعمدة = [0] * ك_
  لكل ص في نطاق(ر_):
    لكل ج في نطاق(ك_):
      لو ل[ص][ج] == "B":
        صفوف[ص] = صفوف[ص] + 1
        اعمدة[ج] = اعمدة[ج] + 1
  ع = 0
  لكل ص في نطاق(ر_):
    لكل ج في نطاق(ك_):
      لو (ل[ص][ج] == "B") و (صفوف[ص] == 1) و (اعمدة[ج] == 1):
        ع = ع + 1
  ارجع ع

تأكد_يساوي(وحيدة([["W","W","B"],["W","B","W"],["B","W","W"]]), 3, "ثلاثة")
تأكد_يساوي(وحيدة([["B","B"],["B","B"]]), 0, "مزدحمة")
تأكد_يساوي(وحيدة([["W","W"],["W","W"]]), 0, "بيضاء")
