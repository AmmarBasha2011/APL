# مثال 2982 — إضافة 27 لكل عنصر
# Add 27 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2982-list-add-27-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 27]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [30, 28, 29], "حالة 1")
تأكد_يساوي(ف([5]), [32], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [28, 29, 30, 31, 32, 33], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [25, 27, 34, 34, 31], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [37, 47, 37, 57, 47, 37], "حالة 5")
