# مثال 3504 — الحد النوني بخطوة 40
# Nth term step 40
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3504-nth-term-arithmetic-sequence-step-40.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 40

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 43, "حالة 2")
تأكد_يساوي(ف(10), 363, "حالة 3")
تأكد_يساوي(ف(100), 3963, "حالة 4")
