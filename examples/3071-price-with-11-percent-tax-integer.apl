# مثال 3071 — السعر مع ضريبة 11 بالمئة
# Price with 11 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3071-price-with-11-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 11 // 100

تأكد_يساوي(ف(100), 111, "حالة 1")
تأكد_يساوي(ف(250), 277, "حالة 2")
تأكد_يساوي(ف(999), 1108, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
