# مثال 949 — الأتمتة الخلوية 30
# Rule 30 cellular automaton
# Demonstrates: يسار XOR وسط OR يمين
#
# Run:  python apl.py examples/949-rule-30.apl

# الأتمتة الخلوية قاعدة 30: فوضى من قاعدة محلية بسيطة
# الخلية الجديدة = يسار XOR (وسط OR يمين)

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة خطوة(صف):
  جديد = []
  لكل i في نطاق(طول(صف)):
    يسار = 0
    لو i > 0:
      يسار = صف[i - 1]
    يمين = 0
    لو i < طول(صف) - 1:
      يمين = صف[i + 1]
    جديد.ألحق(يسار ^ (صف[i] | يمين))
  ارجع جديد

دالة ارسم(صف):
  نص = ""
  لكل خلية في صف:
    لو خلية == 1:
      نص = نص + "#"
    والا:
      نص = نص + "."
  ارجع نص

صف = [0, 0, 0, 1, 0, 0, 0]
خطوة1 = خطوة(صف)
خطوة2 = خطوة(خطوة1)
خطوة3 = خطوة(خطوة2)
اطبع "1:", ارسم(خطوة1)
اطبع "2:", ارسم(خطوة2)
اطبع "3:", ارسم(خطوة3)

تأكد_يساوي(ارسم(خطوة1), "..###..", "الخطوة الأولى")
تأكد_يساوي(ارسم(خطوة2), ".##..#.", "الخطوة الثانية")
تأكد_يساوي(ارسم(خطوة3), "##.####", "الخطوة الثالثة")

# حتمية: إعادة الحساب تعطي نفس النتيجة
تأكد_يساوي(ارسم(خطوة(خطوة(صف))), ارسم(خطوة2), "حتمية")

# من بذرة واحدة بعد 10 خطوات يمتلئ أكثر من نصف العرض الأيسر
عريض = [0]
لكل _ في نطاق(40):
  عريض.ألحق(0)
عريض[20] = 1
جاري = عريض
لكل _ في نطاق(10):
  جاري = خطوة(جاري)
عدد = 0
لكل خلية في جاري:
  عدد = عدد + خلية
لو عدد < 10:
  اطبع "فشل: النمو ضعيف", عدد
  قياسي_نظام_اخرج(1)
اطبع "ناجح: نمو القاعدة 30 =", عدد, "خلية حية"
