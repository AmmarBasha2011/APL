# مثال 2790 — مجموع الأعداد من 9 إلى ن
# Sum from 9 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2790-sum-of-integers-from-9-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(9, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(9), 9, "حالة 1")
تأكد_يساوي(ف(10), 19, "حالة 2")
تأكد_يساوي(ف(19), 154, "حالة 3")
تأكد_يساوي(ف(100), 5014, "حالة 4")
