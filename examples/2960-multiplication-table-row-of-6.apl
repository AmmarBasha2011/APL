# مثال 2960 — صف جدول ضرب 6
# Multiplication row of 6
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2960-multiplication-table-row-of-6.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 6]
  ارجع ر

تأكد_يساوي(ف(1), [6], "حالة 1")
تأكد_يساوي(ف(5), [6, 12, 18, 24, 30], "حالة 2")
تأكد_يساوي(ف(10), [6, 12, 18, 24, 30, 36, 42, 48, 54, 60], "حالة 3")
