# مثال 1411 — نصان صديقان
# Buddy strings one swap
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1411-buddy-strings.apl

# إن اختلف في موضعين متقابلين فهما صديقان
# وإن تساويا فيجب وجود حرف مكرر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اصدقاء(أ, ب):
  لو طول(أ) != طول(ب):
    ارجع خطأ
  لو أ == ب:
    مرئي = {}
    لكل ح في أ:
      لو مرئي.get(ح, خطأ):
        ارجع صواب
      مرئي[ح] = صواب
    ارجع خطأ
  فروق = []
  لكل ع في نطاق(طول(أ)):
    لو أ[ع] != ب[ع]:
      فروق.ألحق(ع)
  لو طول(فروق) != 2:
    ارجع خطأ
  ارجع (أ[فروق[0]] == ب[فروق[1]]) و (أ[فروق[1]] == ب[فروق[0]])

تأكد_يساوي(اصدقاء("ab", "ba"), صواب, "تبديل")
تأكد_يساوي(اصدقاء("ab", "ab"), خطأ, "بلا تكرار")
تأكد_يساوي(اصدقاء("aa", "aa"), صواب, "مع تكرار")
تأكد_يساوي(اصدقاء("aaaaaaabc", "aaaaaaacb"), صواب, "طويل")
