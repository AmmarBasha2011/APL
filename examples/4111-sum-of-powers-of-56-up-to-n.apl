# مثال 4111 — مجموع قوى 56
# Sum of powers of 56
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4111-sum-of-powers-of-56-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 56 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 57, "حالة 2")
تأكد_يساوي(ف(3), 178809, "حالة 3")
تأكد_يساوي(ف(6), 31401724537, "حالة 4")
تأكد_يساوي(ف(10), 308820134352407161, "حالة 5")
