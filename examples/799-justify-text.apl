# مثال 799 — ضبط النص
# Text justification
# Demonstrates: توزيع فراغات، قسمة وباقي
#
# Run:  python apl.py examples/799-justify-text.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ضبط النص بعرض ثابت: توزيع الفراغات بالتساوي بين الكلمات
# Demonstrates: تجميع الأسطر بالطول, قسمة وباقي لتوزيع الفراغات, سطر أخير بضبط يسار

دالة كرر(نص, عدد):
  ناتج = ""
  لكل ي في نطاق(عدد):
    ناتج = ناتج + نص
  ارجع ناتج

دالة اضبط(كلمات, عرض):
  أسطر = []
  سطر = [كلمات[0]]
  طول_سطر = طول(كلمات[0])
  لكل ي في نطاق(1, طول(كلمات)):
    ك = كلمات[ي]
    لو طول_سطر + 1 + طول(ك) <= عرض:
      سطر.append(ك)
      طول_سطر = طول_سطر + 1 + طول(ك)
    والا:
      أسطر.append(سطر)
      سطر = [ك]
      طول_سطر = طول(ك)
  أسطر.append(سطر)
  ناتج = []
  لكل ي في نطاق(طول(أسطر) - 1):
    س = أسطر[ي]
    لو طول(س) == 1:
      ناتج.append(س[0])
    والا:
      مجموع = 0
      لكل ك في س:
        مجموع = مجموع + طول(ك)
      فراغات = عرض - مجموع
      فجوات = طول(س) - 1
      أساس = فراغات // فجوات
      إضافي = فراغات % فجوات
      نص = ""
      لكل ك في نطاق(طول(س) - 1):
        نص = نص + س[ك]
        لو ك < إضافي:
          نص = نص + كرر(" ", أساس + 1)
        والا:
          نص = نص + كرر(" ", أساس)
      نص = نص + س[طول(س) - 1]
      ناتج.append(نص)
  ناتج.append(" ".ضم(أسطر[طول(أسطر) - 1]))
  ارجع ناتج

كلمات = "The quick brown fox jumps over the lazy dog".split(" ")
نتيجة = اضبط(كلمات, 20)
تأكد_يساوي(نتيجة, ["The  quick brown fox", "jumps  over the lazy", "dog"], "ضبط بعرض 20")
تأكد_يساوي(طول(نتيجة[0]), 20, "السطر الأول ممتلئ")
تأكد_يساوي(طول(نتيجة[1]), 20, "السطر الثاني ممتلئ")
نتيجة2 = اضبط("one two three four five six".split(" "), 11)
تأكد_يساوي(نتيجة2, ["one     two", "three  four", "five six"], "ضبط بعرض 11")
