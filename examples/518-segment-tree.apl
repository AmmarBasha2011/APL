# مثال 518 — شجرة المقاطع
# Segment tree
# Demonstrates: شجرة مقاطع، استعلام مجال، تحديث
#
# Run:  python apl.py examples/518-segment-tree.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# شجرة المقاطع لمجاميع المجالات مع تحديث
المتغير مصدر = [1, 3, 5, 7, 9, 11]
المتغير ن = طول(مصدر)
المتغير شجرة = [0] * 24

دالة ابن(عقدة, ب, ن):
    لو ب == ن:
        شجرة[عقدة] = مصدر[ب]
        ارجع
    المتغير وسط = (ب + ن) // 2
    ابن(عقدة * 2, ب, وسط)
    ابن(عقدة * 2 + 1, وسط + 1, ن)
    شجرة[عقدة] = شجرة[عقدة * 2] + شجرة[عقدة * 2 + 1]

دالة استعلم(عقدة, ب, ن, من, الى):
    لو من > ن أو الى < ب:
        ارجع 0
    لو من <= ب و ن <= الى:
        ارجع شجرة[عقدة]
    المتغير وسط = (ب + ن) // 2
    ارجع استعلم(عقدة * 2, ب, وسط, من, الى) + استعلم(عقدة * 2 + 1, وسط + 1, ن, من, الى)

دالة حدث(عقدة, ب, ن, موضع, قيمة):
    لو ب == ن:
        شجرة[عقدة] = قيمة
        ارجع
    المتغير وسط = (ب + ن) // 2
    لو موضع <= وسط:
        حدث(عقدة * 2, ب, وسط, موضع, قيمة)
    الا:
        حدث(عقدة * 2 + 1, وسط + 1, ن, موضع, قيمة)
    شجرة[عقدة] = شجرة[عقدة * 2] + شجرة[عقدة * 2 + 1]

ابن(1, 0, ن - 1)
تأكد_يساوي(استعلم(1, 0, ن - 1, 1, 3), 15, "مجموع [1..3]")
تأكد_يساوي(استعلم(1, 0, ن - 1, 0, 5), 36, "المجموع الكلي")
حدث(1, 0, ن - 1, 2, 10)
تأكد_يساوي(استعلم(1, 0, ن - 1, 1, 3), 20, "بعد التحديث")
