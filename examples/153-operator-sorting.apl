# مثال 153 — الترتيب بجالب العناصر
# Sorting with itemgetter
# Demonstrates: جالب_عنصر، مفرز، عوامل المقارنة
#
# Run:  python apl.py examples/153-operator-sorting.apl

المتغير طلاب = [("عمار", 90), ("سارة", 85), ("خالد", 95)]

اطبع "بالاسم:", مفرز(طلاب, key=جالب_عنصر(0))
اطبع "بالدرجة:", مفرز(طلاب, key=جالب_عنصر(1))
اطبع "بالدرجة تنازلياً:", مفرز(طلاب, key=جالب_عنصر(1), reverse=True)

اطبع "مساواة_عامل(5, 5):", مساواة_عامل(5, 5)
اطبع "أكبر_عامل(7, 3):", أكبر_عامل(7, 3)
