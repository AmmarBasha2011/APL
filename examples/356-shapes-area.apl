# مثال 356 — مساحات الأشكال
# Shapes and areas
# Demonstrates: تعدد أشكال بالوراثة
#
# Run:  python apl.py examples/356-shapes-area.apl

صنف شكل:
    دالة مساحة(ذات):
        ارجع 0

    دالة صف(ذات):
        اطبع "المساحة =", ذات.مساحة()

صنف مربع(شكل):
    دالة_إنشاء(ذات, ضلع):
        ذات.ضلع = ضلع

    دالة مساحة(ذات):
        ارجع ذات.ضلع * ذات.ضلع

صنف مستطيل(شكل):
    دالة_إنشاء(ذات, طول_ضلع, عرض_ضلع):
        ذات.طول_ضلع = طول_ضلع
        ذات.عرض_ضلع = عرض_ضلع

    دالة مساحة(ذات):
        ارجع ذات.طول_ضلع * ذات.عرض_ضلع

صنف دائرة(شكل):
    دالة_إنشاء(ذات, نصف_قطر):
        ذات.نصف_قطر = نصف_قطر

    دالة مساحة(ذات):
        ارجع مقرب(3.14159 * ذات.نصف_قطر * ذات.نصف_قطر, 2)

مربع(4).صف()
مستطيل(3, 5).صف()
دائرة(2).صف()
