# مثال 554 — الغربال المقطعي
# Segmented sieve
# Demonstrates: غربال مقطعي، أوليات مجال
#
# Run:  python apl.py examples/554-segmented-sieve.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# الغربال المقطعي: أوليات مجال بعيد دون غربال كامل
دالة أوليات_بسيطة(حد):
    المتغير نتيجة = قائمة()
    لكل مرشح في نطاق(2, حد + 1):
        المتغير أولي = صواب
        لكل قاسم في نطاق(2, جذر_صحيح(مرشح) + 1):
            لو (مرشح % قاسم) == 0:
                أولي = خطأ
                توقف
        لو أولي:
            نتيجة.أضف(مرشح)
    ارجع نتيجة

دالة غربال_مقطعي(من, الى):
    المتغير قاعدة = أوليات_بسيطة(جذر_صحيح(الى))
    المتغير مركب = قائمة()
    لكل i في نطاق(الى - من + 1):
        مركب.أضف(خطأ)
    لكل أول في قاعدة:
        المتغير بداية = ((من + أول - 1) // أول) * أول
        لو بداية == أول:
            بداية = بداية + أول
        المتغير م = بداية
        طالما م <= الى:
            مركب[م - من] = صواب
            م = م + أول
    المتغير نتيجة = قائمة()
    لكل i في نطاق(الى - من + 1):
        لو ليس مركب[i]:
            نتيجة.أضف(من + i)
    ارجع نتيجة

المتغير نتيجة = غربال_مقطعي(100, 150)
اطبع "أوليات [100..150]:", نتيجة
تأكد_يساوي(نتيجة, [101, 103, 107, 109, 113, 127, 131, 137, 139, 149], "الأوليات في المجال")
