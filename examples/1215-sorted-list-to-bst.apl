# مثال 1215 — قائمة مرتبة إلى شجرة
# Sorted list to balanced BST
# Demonstrates: تقسيم
#
# Run:  python apl.py examples/1215-sorted-list-to-bst.apl

# العنصر الأوسط هو الجذر
# والنصفان يصبحان الفرعين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ابن_شجرة(أ):
  لو طول(أ) == 0:
    ارجع []
  م = طول(أ) // 2
  ارجع [أ[م], ابن_شجرة(أ[:م]), ابن_شجرة(أ[م + 1:])]

دالة متوسط_قراءة(ش):
  لو طول(ش) == 0:
    ارجع []
  ارجع متوسط_قراءة(ش[1]) + [ش[0]] + متوسط_قراءة(ش[2])

دالة عمق(ش):
  لو طول(ش) == 0:
    ارجع 0
  ارجع 1 + أكبر(عمق(ش[1]), عمق(ش[2]))

ق = [-10, -3, 0, 5, 9]
ش = ابن_شجرة(ق)
تأكد_يساوي(ش[0], 0, "الجذر")
تأكد_يساوي(متوسط_قراءة(ش), ق, "مرتبة")
تأكد_يساوي(عمق(ش), 3, "متوازنة")
تأكد_يساوي(ابن_شجرة([]), [], "فارغة")
