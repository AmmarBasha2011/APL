# مثال 475 — التحكم بالصلاحيات
# Role-based access control
# Demonstrates: أدوار وصلاحيات
#
# Run:  python apl.py examples/475-rbac.apl

المتغير صلاحيات = {
    "مدير": ["قراءة", "كتابة", "حذف"],
    "محرر": ["قراءة", "كتابة"],
    "زائر": ["قراءة"]
}

دالة مسموح(دور, عمل):
    المتغير قائمة = صلاحيات.get(دور, [])
    ارجع قائمة.count(عمل) > 0

اطبع "مدير يحذف؟", مسموح("مدير", "حذف")
اطبع "محرر يحذف؟", مسموح("محرر", "حذف")
اطبع "زائر يقرأ؟", مسموح("زائر", "قراءة")
