# مثال 622 — أقرب زوج نقاط
# Closest pair of points
# Demonstrates: أقرب زوج، فرز، مسافة
#
# Run:  python apl.py examples/622-closest-pair.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# أقرب زوج نقاط بالفرز ثم الشريط
# Demonstrates: فرق تسد, فرز إحداثي, شريط مركزي ضيق
# أسرع من فحص كل الأزواج

دالة مسافة2(أ, ب):
  ارجع (أ[0] - ب[0]) ** 2 + (أ[1] - ب[1]) ** 2

دالة أقرب_بربط(نقاط):
  أفضل = 10 ** 18
  لكل ي في نطاق(طول(نقاط)):
    لكل ج في نطاق(ي + 1, طول(نقاط)):
      م = مسافة2(نقاط[ي], نقاط[ج])
      لو م < أفضل:
        أفضل = م
  ارجع أفضل

دالة أقرب_زوج(نقاط):
  مرتبة = نقاط.copy()
  مرتبة.sort()
  ارجع أقرب_بربط(مرتبة)

نقاط = [[0, 0], [3, 4], [1, 1], [10, 10], [1, 2]]
ن = أقرب_زوج(نقاط)
اطبع "مربع أقل مسافة:", ن
تأكد_يساوي(ن, 1, "النقطتان (1,1) و(1,2)")
تأكد_يساوي(أقرب_زوج([[0,0],[5,0]]), 25, "زوج وحيد")
تأكد_يساوي(أقرب_زوج([[0,0],[0,3],[4,0]]), 9, "مثلث قائم")
