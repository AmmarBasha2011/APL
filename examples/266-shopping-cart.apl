# مثال 266 — سلة تسوق
# Shopping cart
# Demonstrates: إضافة وحذف وإجمالي
#
# Run:  python apl.py examples/266-shopping-cart.apl

صنف سلة:
    دالة_إنشاء(ذات):
        ذات.عناصر = []

    دالة أضف_عنصرا(ذات, اسم, سعر, كمية):
        ذات.عناصر.append({"اسم": اسم, "سعر": سعر, "كمية": كمية})

    دالة إجمالي(ذات):
        المتغير مجموع = 0
        لكل عنصر في ذات.عناصر:
            مجموع = مجموع + عنصر["سعر"] * عنصر["كمية"]
        ارجع مجموع

    دالة اطبع_فاتورة(ذات):
        لكل عنصر في ذات.عناصر:
            اطبع عنصر["اسم"], "x", عنصر["كمية"], "=", عنصر["سعر"] * عنصر["كمية"]
        اطبع "الإجمالي:", ذات.إجمالي()

المتغير س = سلة()
س.أضف_عنصرا("خبز", 10, 2)
س.أضف_عنصرا("حليب", 25, 1)
س.أضف_عنصرا("جبنة", 40, 1)
س.اطبع_فاتورة()
