# مثال 67 — ثوابت حالات HTTP (مكتبة web)
# HTTP status codes as bare Arabic constants (http.HTTPStatus)
#
# Run:  python apl.py examples/67-web-http-status.apl

اطبع "=== ثوابت حالات HTTP ==="
اطبع "ناجح:", HTTP_حالة_ناجح
اطبع "أُنشئ:", HTTP_حالة_أُنشئ
اطبع "طلب سيئ:", HTTP_حالة_طلب_سيئ
اطبع "غير موجود:", HTTP_حالة_غير_موجود
اطبع "إبريق شاي:", HTTP_حالة_إبريق_شاي

اطبع ""
اطبع "=== رقم الحالة ==="
اطبع "نوع الحالة:", نوع(HTTP_حالة_غير_موجود)
اطبع "هي عدد؟", HTTP_حالة_غير_موجود == 404

اطبع ""
اطبع "=== استخدام في شرط ==="
دالة صف_الحالة(كود):
    لو كود == HTTP_حالة_ناجح:
        ارجع "تم بنجاح"
    الا لو كود == HTTP_حالة_غير_موجود:
        ارجع "غير موجود"
    والا:
        ارجع "حالة أخرى"

اطبع "200 ->", صف_الحالة(200)
اطبع "404 ->", صف_الحالة(404)
اطبع "500 ->", صف_الحالة(500)
