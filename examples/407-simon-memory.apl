# مثال 407 — لعبة ذاكرة الألوان
# Simon memory game
# Demonstrates: تسلسل متزايد
#
# Run:  python apl.py examples/407-simon-memory.apl

بذرة(6)
المتغير ألوان = ["أحمر", "أخضر", "أزرق", "أصفر"]
المتغير تسلسل = []

لكل جولة في نطاق(1, 5):
    تسلسل.append(ألوان[عشوائي_عدد(0, 3)])
    اطبع "الجولة", جولة, "- احفظ:", " ".ضم(تسلسل)

اطبع "طول التسلسل النهائي:", طول(تسلسل)
