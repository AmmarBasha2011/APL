# مثال 2898 — مجموع قوى 24
# Sum of powers of 24
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2898-sum-of-powers-of-24-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 24 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 25, "حالة 2")
تأكد_يساوي(ف(3), 14425, "حالة 3")
تأكد_يساوي(ف(6), 199411801, "حالة 4")
تأكد_يساوي(ف(10), 66160049703001, "حالة 5")
