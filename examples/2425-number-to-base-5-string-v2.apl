# مثال 2425 — عدد إلى الأساس 5
# Number to base 5
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2425-number-to-base-5-string-v2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع "0"
  خ = ""
  طالما ن > 0:
    خ = نص(ن % 5) + خ
    ن = ن // 5
  ارجع خ

تأكد_يساوي(ف(0), "0", "حالة 1")
تأكد_يساوي(ف(1), "1", "حالة 2")
تأكد_يساوي(ف(5), "10", "حالة 3")
تأكد_يساوي(ف(50), "200", "حالة 4")
تأكد_يساوي(ف(255), "2010", "حالة 5")
