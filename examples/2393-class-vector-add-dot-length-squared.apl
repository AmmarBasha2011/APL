# مثال 2393 — صنف متجه ثنائي
# Vector class dot product
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2393-class-vector-add-dot-length-squared.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف متجه:
    دالة_إنشاء(ذات, س, ص):
        ذات.س = س
        ذات.ص = ص

    دالة جمع(ذات, ق):
        ارجع متجه(ذات.س + ق.س, ذات.ص + ق.ص)

    دالة داخلي(ذات, ق):
        ارجع ذات.س * ق.س + ذات.ص * ق.ص

أ = متجه(1, 2)
ب = متجه(3, 4)
ج = أ.جمع(ب)
تأكد_يساوي(ج.س, 4, "س")
تأكد_يساوي(ج.ص, 6, "ص")
تأكد_يساوي(أ.داخلي(ب), 11, "داخلي")
