# مثال 885 — متتابعة ثيو-مورس
# Thue-Morse sequence
# Demonstrates: توليد بالمتمم
#
# Run:  python apl.py examples/885-thue-morse.apl

# متتابعة ثيو-مورس: كل حد هو متمم السابق (0 -> 01 -> 0110 -> ...)
# لا تحتوي أي تكرار ثلاثي متتال، وتظهر في نظرية الألعاب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ثيو_مورس(عدد):
  ت = [0]
  طالما طول(ت) < عدد:
    نصف = طول(ت)
    لكل i في نطاق(نصف):
      لو طول(ت) < عدد:
        لو ت[i] == 0:
          ت.ألحق(1)
        والا:
          ت.ألحق(0)
  ارجع ت

ت = ثيو_مورس(16)
اطبع "أول 16 حداً:", ت

تأكد_يساوي(طول(ت), 16, "الطول")
تأكد_يساوي(ت[0], 0, "ت[0]")
تأكد_يساوي(ت[1], 1, "ت[1]")
تأكد_يساوي(ت[3], 0, "ت[3]")
تأكد_يساوي(ت[8], 1, "ت[8]")
تأكد_يساوي(ت[15], 0, "ت[15]")

# تعريف بديل: ت[ن] = زوجية عدد الواحدات في تمثيل ن الثنائي
دالة زوجية_الواحدات(ن):
  عد = 0
  م = ن
  طالما م > 0:
    عد = عد + م % 2
    م = م // 2
  ارجع عد % 2

لكل ن في نطاق(16):
  تأكد_يساوي(ت[ن], زوجية_الواحدات(ن), "التعريف البديل عند " + نص(ن))

# خاصية التمام: النصف الثاني متمم الأول
لكل i في نطاق(8):
  تأكد_يساوي(ت[i] + ت[i + 8], 1, "التمام عند " + نص(i))
