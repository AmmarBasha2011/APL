# مثال 3183 — مجموع قوى 31
# Sum of powers of 31
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3183-sum-of-powers-of-31-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 31 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 32, "حالة 2")
تأكد_يساوي(ف(3), 30784, "حالة 3")
تأكد_يساوي(ف(6), 917087137, "حالة 4")
تأكد_يساوي(ف(10), 846949229880161, "حالة 5")
