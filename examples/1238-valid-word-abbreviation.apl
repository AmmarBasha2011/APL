# مثال 1238 — اختصار كلمة صالح
# Valid word abbreviation
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1238-valid-word-abbreviation.apl

# الأرقام تعني عدد الحروف المتجاوزة
# ولا يبدأ الرقم بصفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صالح(كلمة, اختصار):
  ك = 0
  ا = 0
  طالما (ك < طول(كلمة)) و (ا < طول(اختصار)):
    لو اختصار[ا].isdigit():
      لو اختصار[ا] == "0":
        ارجع خطأ
      ن = 0
      طالما (ا < طول(اختصار)) و اختصار[ا].isdigit():
        ن = ن * 10 + صحيح(اختصار[ا])
        ا = ا + 1
      ك = ك + ن
    والا:
      لو كلمة[ك] != اختصار[ا]:
        ارجع خطأ
      ك = ك + 1
      ا = ا + 1
  ارجع (ك == طول(كلمة)) و (ا == طول(اختصار))

تأكد_يساوي(صالح("internationalization", "i12iz4n"), صواب, "صالح")
تأكد_يساوي(صالح("apple", "a2e"), خطأ, "حرف خاطئ")
تأكد_يساوي(صالح("substitution", "s10n"), صواب, "عشرة")
تأكد_يساوي(صالح("hi", "01"), خطأ, "صفر بادئ")
