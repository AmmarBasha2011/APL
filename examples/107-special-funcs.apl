# مثال 107 — الدوال الخاصة: جاما ودالة الخطأ
# Special functions: gamma and error function
# Demonstrates: جاما، لوغاريتم_جاما، دالة_الخطأ، دالة_الخطأ_المكملة، مجموع_دقيق
#
# Run:  python apl.py examples/107-special-funcs.apl

اطبع "جاما(5) =", جاما(5), "  (تساوي مضروب 4)"
اطبع "جاما(0.5) =", مقرب(جاما(0.5), 6), "  (تساوي جذر ط)"
اطبع "لوغاريتم_جاما(100) =", مقرب(لوغاريتم_جاما(100), 4)
اطبع ""
اطبع "دالة_الخطأ(0) =", دالة_الخطأ(0)
اطبع "دالة_الخطأ(1) =", مقرب(دالة_الخطأ(1), 6)
اطبع "دالة_الخطأ_المكملة(1) =", مقرب(دالة_الخطأ_المكملة(1), 6)
اطبع ""
اطبع "مجموع_دقيق([0.1] * 10) =", مجموع_دقيق([0.1] * 10)
