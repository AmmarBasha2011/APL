# مثال 545 — الاختيار السريع
# Quickselect
# Demonstrates: اختيار سريع، ك-أصغر، تقسيم
#
# Run:  python apl.py examples/545-quickselect.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# اختيار سريع: ك-أصغر عنصر دون فرز كامل
المتغير بيانات = [7, 10, 4, 3, 20, 15]

دالة اختر(ق, ك):
    المتغير محور = ق[طول(ق) - 1]
    المتغير أصاغر = [س لكل س في ق لو س < محور]
    المتغير مساوون = [س لكل س في ق لو س == محور]
    المتغير أكابر = [س لكل س في ق لو س > محور]
    لو ك <= طول(أصاغر):
        ارجع اختر(أصاغر, ك)
    الا لو ك <= طول(أصاغر) + طول(مساوون):
        ارجع محور
    ارجع اختر(أكابر, ك - طول(أصاغر) - طول(مساوون))

تأكد_يساوي(اختر(بيانات, 3), 7, "ثالث أصغر")
تأكد_يساوي(اختر(بيانات, 1), 3, "الأصغر")
تأكد_يساوي(اختر(بيانات, 6), 20, "الأكبر")
