# مثال 3564 — تحويل وحدة بأساس 25
# Split by base 25
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3564-minutes-to-hours-and-minutes-base-25.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 25, ن % 25]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 9], "حالة 2")
تأكد_يساوي(ف(60), [2, 10], "حالة 3")
تأكد_يساوي(ف(125), [5, 0], "حالة 4")
تأكد_يساوي(ف(1000), [40, 0], "حالة 5")
