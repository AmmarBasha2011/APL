# مثال 50 — العرض النهائي (شامل)
# Final Showcase
# Demonstrates: classes, methods, aggregation, sorting, formatting
#
# Run:  python apl.py examples/50-final-showcase.apl

صنف طالب:
    دالة_إنشاء(ذات, اسم, درجات):
        ذات.اسم = اسم
        ذات.درجات = درجات

    دالة متوسط(ذات):
        لو طول(ذات.درجات) == 0:
            ارجع 0
        ارجع مجموع(ذات.درجات) / طول(ذات.درجات)

    دالة تصنيف(ذات):
        م = ذات.متوسط()
        إذا م >= 90:
            ارجع "ممتاز"
        سإذا م >= 80:
            ارجع "جيد جداً"
        سإذا م >= 70:
            ارجع "جيد"
        سإذا م >= 60:
            ارجع "مقبول"
        ارجع "راسب"

    دالة سطر(ذات):
        ارجع ذات.اسم + ": " + نص(مقرب(ذات.متوسط(), 1)) + " (" + ذات.تصنيف() + ")"

اطبع "╔═══════════════════════════════════╗"
اطبع "║     عرض شامل — لغة APL            ║"
اطبع "╚═══════════════════════════════════╝"
اطبع ""

المتغير الطلاب = [
    طالب("أحمد", [85, 90, 78]),
    طالب("سارة", [95, 98, 92]),
    طالب("محمد", [60, 72, 55]),
    طالب("فاطمة", [88, 84, 91])
]

اطبع "--- كشف الطلاب ---"
لكل طالب في الطلاب:
    اطبع "  " + طالب.سطر()

اطبع ""
اطبع "--- الإحصاء ---"
اطبع "  عدد الطلاب: " + نص(طول(الطلاب))
المتغير مجموع_متوسطات = 0
لكل طالب في الطلاب:
    مجموع_متوسطات = مجموع_متوسطات + طالب.متوسط()
اطبع "  متوسط الدفعة: " + نص(مقرب(مجموع_متوسطات / طول(الطلاب), 2))

اطبع ""
اطبع "--- توزيع التصنيفات ---"
ممتاز = 0
جيد_جدا = 0
راسب = 0
لكل طالب في الطلاب:
    التصنيف = طالب.تصنيف()
    إذا التصنيف == "ممتاز":
        ممتاز = ممتاز + 1
    سإذا التصنيف == "جيد جداً":
        جيد_جدا = جيد_جدا + 1
    سإذا التصنيف == "راسب":
        راسب = راسب + 1
اطبع "  ممتاز:   " + نص(ممتاز)
اطبع "  جيد جداً: " + نص(جيد_جدا)
اطبع "  راسب:     " + نص(راسب)

اطبع ""
اطبع "--- أعلى طالب ---"
المتغير الأعلى = الطلاب[0]
لكل طالب في الطلاب:
    لو طالب.متوسط() > الأعلى.متوسط():
        الأعلى = طالب
اطبع "  " + الأعلى.سطر()
