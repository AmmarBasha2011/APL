# مثال 1107 — مسجل بحد معدل
# Logger rate limiter
# Demonstrates: آخر وقت طباعة
#
# Run:  python apl.py examples/1107-logger-rate-limit.apl

# نحفظ آخر وقت طبعنا فيه كل رسالة
# ونسمح بها ثانية إذا مرت عشر ثوانٍ على الأقل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مسجل:
    دالة_إنشاء(ذات):
        ذات.رسائل = []
        ذات.ازمنة = []

    دالة يطبع(ذات, ث, رسالة):
        لو رسالة في ذات.رسائل:
            ف = 0
            طالما ذات.رسائل[ف] != رسالة:
                ف = ف + 1
            لو ث >= (ذات.ازمنة[ف] + 10):
                ذات.ازمنة[ف] = ث
                ارجع صواب
            ارجع خطأ
        ذات.رسائل.ألحق(رسالة)
        ذات.ازمنة.ألحق(ث)
        ارجع صواب

م = مسجل()
تأكد_يساوي(م.يطبع(1, "foo"), صواب, "foo الأولى")
تأكد_يساوي(م.يطبع(2, "bar"), صواب, "bar الأولى")
تأكد_يساوي(م.يطبع(3, "foo"), خطأ, "foo مبكرة")
تأكد_يساوي(م.يطبع(8, "bar"), خطأ, "bar مبكرة")
تأكد_يساوي(م.يطبع(10, "foo"), خطأ, "foo عند عشرة")
تأكد_يساوي(م.يطبع(11, "foo"), صواب, "foo بعد عشر")
