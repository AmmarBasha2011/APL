# مثال 2271 — هل العدد مربع كامل
# Is perfect square
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2271-is-perfect-square-via-root-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ي = 0
  طالما ي * ي < ن:
    ي = ي + 1
  ارجع ي * ي == ن

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(1), صواب, "حالة 2")
تأكد_يساوي(ف(2), خطأ, "حالة 3")
تأكد_يساوي(ف(16), صواب, "حالة 4")
تأكد_يساوي(ف(24), خطأ, "حالة 5")
تأكد_يساوي(ف(49), صواب, "حالة 6")
