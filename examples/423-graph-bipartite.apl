# مثال 423 — فحص الرسم الثنائي
# Bipartite graph check
# Demonstrates: تلوين بلونين
#
# Run:  python apl.py examples/423-graph-bipartite.apl

دالة ثنائي(جيران):
    المتغير لون = {}
    لكل بداية في جيران.keys():
        لو لون.get(بداية) == لا_شيء:
            لون[بداية] = 0
            المتغير قائمة = [بداية]
            طالما طول(قائمة) > 0:
                المتغير عقدة = قائمة.pop()
                لكل جار in جيران[عقدة]:
                    لو لون.get(جار) == لا_شيء:
                        لون[جار] = 1 - لون[عقدة]
                        قائمة.append(جار)
                    الا لو لون[جار] == لون[عقدة]:
                        ارجع خطأ
    ارجع صواب

المتغير رسم1 = {0: [1, 3], 1: [0, 2], 2: [1, 3], 3: [0, 2]}
اطبع "مربع:", ثنائي(رسم1)
المتغير رسم2 = {0: [1, 2], 1: [0, 2], 2: [0, 1]}
اطبع "مثلث:", ثنائي(رسم2)
