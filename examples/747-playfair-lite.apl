# مثال 747 — تشفير بلايفير
# Playfair cipher
# Demonstrates: مربع 5x5، أزواج، ثلاث قواعد
#
# Run:  python apl.py examples/747-playfair-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تشفير بلايفير: مربع 5x5 وقواعد الصف والعمود والمستطيل
# Demonstrates: بناء مربع مفتاح, أزواج حروف مع حشو X, ثلاث قواعد
# J تدمج في I، والأزواج المتساوية يفصلها X

دالة مربع_مفتاح(مفتاح):
  مربع = ""
  لكل ي في نطاق(طول(مفتاح)):
    حرف = مفتاح[ي]
    لو حرف == "J":
      حرف = "I"
    لو حرف >= "A" و حرف <= "Z":
      لو حرف في مربع:
        حرف = ""
      مربع = مربع + حرف
  أبجدية = "ABCDEFGHIKLMNOPQRSTUVWXYZ"
  لكل ي في نطاق(25):
    لو أبجدية[ي] في مربع:
      مربع = مربع + ""
    والا:
      مربع = مربع + أبجدية[ي]
  ارجع مربع

دالة جهز(نص):
  مهيأ = ""
  لكل ي في نطاق(طول(نص)):
    حرف = نص[ي]
    لو حرف >= "a" و حرف <= "z":
      حرف = نص.upper()[ي]
    لو حرف == "J":
      حرف = "I"
    لو حرف >= "A" و حرف <= "Z":
      مهيأ = مهيأ + حرف
  ارجع مهيأ

دالة شفر_بلايفير(نص, مفتاح):
  مربع = مربع_مفتاح(مفتاح)
  مهيأ = جهز(نص)
  ناتج = ""
  ي = 0
  طالما ي < طول(مهيأ):
    أ = مهيأ[ي]
    لو ي + 1 < طول(مهيأ):
      ب = مهيأ[ي + 1]
    والا:
      ب = "X"
    لو أ == ب:
      ب = "X"
      ي = ي - 1
    موضع_أ = مربع.index(أ)
    موضع_ب = مربع.index(ب)
    صف_أ = موضع_أ // 5
    عمود_أ = موضع_أ % 5
    صف_ب = موضع_ب // 5
    عمود_ب = موضع_ب % 5
    لو صف_أ == صف_ب:
      ناتج = ناتج + مربع[صف_أ * 5 + (عمود_أ + 1) % 5] + مربع[صف_ب * 5 + (عمود_ب + 1) % 5]
    والا_لو عمود_أ == عمود_ب:
      ناتج = ناتج + مربع[((صف_أ + 1) % 5) * 5 + عمود_أ] + مربع[((صف_ب + 1) % 5) * 5 + عمود_ب]
    والا:
      ناتج = ناتج + مربع[صف_أ * 5 + عمود_ب] + مربع[صف_ب * 5 + عمود_أ]
    ي = ي + 2
  ارجع ناتج

تأكد_يساوي(مربع_مفتاح("PLAYFAIREXAMPLE"), "PLAYFIREXMBCDGHKNOQSTUVWZ", "مربع المفتاح الكلاسيكي")
تأكد_يساوي(شفر_بلايفير("Hide the gold in the tree stump", "PLAYFAIREXAMPLE"), "BMODZBXDNABEKUDMUIXMMOUVIF", "المتجه الكلاسيكي")
تأكد_يساوي(شفر_بلايفير("BALLOON", "MONARCHY"), "IBSUPMNA", "بالون بمفتاح موناركي")
تأكد_يساوي(جهز("Hello, World!"), "HELLOWORLD", "تنقية الإدخال")

اطبع "التشفير:", شفر_بلايفير("INSTRUMENTS", "MONARCHY")
