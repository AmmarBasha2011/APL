# مثال 1964 — دمج صف في لعبة 2048
# 2048 row merge left
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1964-merge-row-left-2048-rule.apl

# # نحذف الأصفار ثم ندمج الأزواج المتساوية
# # ونملأ الباقي بأصفار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادمج(صف):
  ق = []
  لكل ع في صف:
    لو ع != 0:
      ق = ق + [ع]
  خرج = []
  ك = 0
  طالما ك < طول(ق):
    لو ك + 1 < طول(ق) و ق[ك] == ق[ك + 1]:
      خرج = خرج + [ق[ك] * 2]
      ك = ك + 2
    والا:
      خرج = خرج + [ق[ك]]
      ك = ك + 1
  طالما طول(خرج) < طول(صف):
    خرج = خرج + [0]
  ارجع خرج

تأكد_يساوي(ادمج([2, 2, 2, 2]), [4, 4, 0, 0], "أربعة متساوية")
تأكد_يساوي(ادمج([2, 0, 2, 4]), [4, 4, 0, 0], "مع صفر")
تأكد_يساوي(ادمج([4, 2, 2, 0]), [4, 4, 0, 0], "وسط")
تأكد_يساوي(ادمج([2, 4, 8, 16]), [2, 4, 8, 16], "لا دمج")
