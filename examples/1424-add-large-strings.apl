# مثال 1424 — جمع نصين رقميين
# Add two numeric strings
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1424-add-large-strings.apl

# نجمع من الأرقام الأخيرة مع الحمل
# ننتهي عند نفاد الرقمين والحمل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اجمع_نصين(أ, ب):
  ع = طول(أ) - 1
  ج = طول(ب) - 1
  حمل = 0
  ناتج = ""
  طالما (ع >= 0) أو (ج >= 0) أو (حمل > 0):
    مجموع = حمل
    لو ع >= 0:
      مجموع = مجموع + صحيح(أ[ع])
      ع = ع - 1
    لو ج >= 0:
      مجموع = مجموع + صحيح(ب[ج])
      ج = ج - 1
    ناتج = نص(مجموع % 10) + ناتج
    حمل = مجموع // 10
  ارجع ناتج

تأكد_يساوي(اجمع_نصين("11", "123"), "134", "ثلاثة أرقام")
تأكد_يساوي(اجمع_نصين("456", "77"), "533", "حمل")
تأكد_يساوي(اجمع_نصين("999", "1"), "1000", "حمل أخير")
