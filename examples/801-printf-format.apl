# مثال 801 — منسق printf
# printf formatter
# Demonstrates: %d و%s و%x، حشو أصفار
#
# Run:  python apl.py examples/801-printf-format.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# منسق بأسلوب printf: مواضع %d و%s و%x مع حشو بالأصفار
# Demonstrates: تحليل محارف التنسيق, تحويل لسداسي يدوياً, حشو بعرض ثابت

سداسي = "0123456789abcdef"

دالة سداسي_نص(ن):
  لو ن == 0:
    ارجع "0"
  ناتج = ""
  م = ن
  طالما م > 0:
    ناتج = سداسي[م % 16] + ناتج
    م = م // 16
  ارجع ناتج

دالة تنسيق(قالب, وسائط):
  ناتج = ""
  مؤشر = 0
  ي = 0
  طالما ي < طول(قالب):
    لو قالب[ي] == "%":
      لو قالب[ي + 1] == "%":
        ناتج = ناتج + "%"
        ي = ي + 2
      والا:
        ي = ي + 1
        حشو = " "
        لو قالب[ي] == "0":
          حشو = "0"
          ي = ي + 1
        عرض = 0
        طالما ي < طول(قالب) و قالب[ي] >= "0" و قالب[ي] <= "9":
          عرض = عرض * 10 + صحيح(قالب[ي])
          ي = ي + 1
        محرف = قالب[ي]
        قيمة = ""
        لو محرف == "d":
          قيمة = نص(وسائط[مؤشر])
        والا_لو محرف == "s":
          قيمة = وسائط[مؤشر]
        والا:
          قيمة = سداسي_نص(وسائط[مؤشر])
        مؤشر = مؤشر + 1
        طالما طول(قيمة) < عرض:
          قيمة = حشو + قيمة
        ناتج = ناتج + قيمة
        ي = ي + 1
    والا:
      ناتج = ناتج + قالب[ي]
      ي = ي + 1
  ارجع ناتج

تأكد_يساوي(تنسيق("%d + %d = %d", [2, 3, 5]), "2 + 3 = 5", "جمع بسيط")
تأكد_يساوي(تنسيق("hex: %x", [255]), "hex: ff", "سداسي")
تأكد_يساوي(تنسيق("[%05d]", [42]), "[00042]", "حشو أصفار")
تأكد_يساوي(تنسيق("%s=%d", ["x", 7]), "x=7", "نص ورقم")
تأكد_يساوي(تنسيق("100%%", []), "100%", "علامة مئوية مهربة")
تأكد_يساوي(سداسي_نص(0), "0", "صفر سداسي")
