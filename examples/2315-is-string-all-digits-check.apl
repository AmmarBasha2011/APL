# مثال 2315 — هل النص أرقام فقط
# Is all digits
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2315-is-string-all-digits-check.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == "":
    ارجع خطأ
  لكل ح في ن:
    لو ح.isdigit() == خطأ:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف("123"), صواب, "حالة 1")
تأكد_يساوي(ف("12a"), خطأ, "حالة 2")
تأكد_يساوي(ف(""), خطأ, "حالة 3")
تأكد_يساوي(ف("007"), صواب, "حالة 4")
تأكد_يساوي(ف("1 2"), خطأ, "حالة 5")
