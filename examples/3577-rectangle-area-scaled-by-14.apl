# مثال 3577 — مساحة مستطيل مكبر 14 مرات
# Rectangle area scaled by 14
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3577-rectangle-area-scaled-by-14.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 14) * (ق[1] * 14)

تأكد_يساوي(ف([1, 2]), 392, "حالة 1")
تأكد_يساوي(ف([3, 4]), 2352, "حالة 2")
تأكد_يساوي(ف([5, 5]), 4900, "حالة 3")
تأكد_يساوي(ف([10, 1]), 1960, "حالة 4")
