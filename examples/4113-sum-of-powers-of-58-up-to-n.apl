# مثال 4113 — مجموع قوى 58
# Sum of powers of 58
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4113-sum-of-powers-of-58-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 58 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 59, "حالة 2")
تأكد_يساوي(ف(3), 198535, "حالة 3")
تأكد_يساوي(ف(6), 38736564343, "حالة 4")
تأكد_يساوي(ف(10), 438362175441500663, "حالة 5")
