# مثال 2418 — مجموع أرقام 4 أس ن
# Digit sum of 4 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2418-digit-sum-of-4-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 4 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 4, "حالة 2")
تأكد_يساوي(ف(5), 7, "حالة 3")
تأكد_يساوي(ف(10), 31, "حالة 4")
تأكد_يساوي(ف(20), 61, "حالة 5")
