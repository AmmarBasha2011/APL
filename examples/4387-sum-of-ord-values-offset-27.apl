# مثال 4387 — مجموع ord مع إزاحة 27
# Sum of ord values plus 27 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/4387-sum-of-ord-values-offset-27.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 27
  ارجع م

تأكد_يساوي(ف("a"), 124, "حالة 1")
تأكد_يساوي(ف("abc"), 375, "حالة 2")
تأكد_يساوي(ف("xyz"), 444, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
