# مثال 1741 — أكبر حاوية ماء
# Container with most water
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1741-two-pointer-container-water.apl

# مؤشر من كل طرف
# المساحة بالأقصر في العرض

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أكبر_حاوية(ارتفاعات):
  ي = 0
  ك = طول(ارتفاعات) - 1
  أفضل = 0
  طالما ي < ك:
    مساحة = أصغر(ارتفاعات[ي], ارتفاعات[ك]) * (ك - ي)
    أفضل = أكبر(أفضل, مساحة)
    لو ارتفاعات[ي] < ارتفاعات[ك]:
      ي = ي + 1
    والا:
      ك = ك - 1
  ارجع أفضل

تأكد_يساوي(أكبر_حاوية([1, 8, 6, 2, 5, 4, 8, 3, 7]), 49, "كلاسيكي")
تأكد_يساوي(أكبر_حاوية([1, 1]), 1, "اثنان")
