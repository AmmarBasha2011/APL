# مثال 4184 — مجموع زوايا مضلع زائد 30
# Polygon angle sum plus 30
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4184-interior-angle-sum-of-polygon-plus-30.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 30

تأكد_يساوي(ف(3), 210, "حالة 1")
تأكد_يساوي(ف(4), 390, "حالة 2")
تأكد_يساوي(ف(5), 570, "حالة 3")
تأكد_يساوي(ف(6), 750, "حالة 4")
تأكد_يساوي(ف(12), 1830, "حالة 5")
