# مثال 672 — ضغط LZ78
# LZ78 compression
# Demonstrates: قاموس عبارات، ضغط، فك
#
# Run:  python apl.py examples/672-lz78.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ضغط LZ78: قاموس عبارات متنامي
# Demonstrates: أزواج مرجع وحرف, قاموس مبني أثناء القراءة, فك بالمثل
# عبارة جديدة = عبارة معروفة + حرف واحد

دالة شفر(نص):
  قاموس = {}
  ناتج = []
  جاري = ""
  تالي = 1
  لكل حرف في نص:
    مركب = جاري + حرف
    لو قاموس.get(مركب, لا_شيء) != لا_شيء:
      جاري = مركب
    والا:
      ناتج.append([قاموس.get(جاري, 0), حرف])
      قاموس[مركب] = تالي
      تالي = تالي + 1
      جاري = ""
  لو جاري != "":
    ناتج.append([قاموس.get(جاري, 0), ""])
  ارجع ناتج

دالة فك(ناتج):
  عبارات = [""]
  نص = ""
  لكل زوج في ناتج:
    عبارة = عبارات[زوج[0]] + زوج[1]
    نص = نص + عبارة
    لو زوج[1] != "":
      عبارات.append(عبارة)
  ارجع نص

ناتج = شفر("ABABABABA")
تأكد_يساوي(ناتج[0], [0, "A"], "أول زوج")
تأكد_يساوي(ناتج[1], [0, "B"], "ثاني زوج")
تأكد_يساوي(ناتج[2], [1, "B"], "مرجع لعبارة A")
تأكد_يساوي(فك(ناتج), "ABABABABA", "فك يعيد النص")
تأكد_يساوي(فك(شفر("AAAAAA")), "AAAAAA", "نص متكرر")
تأكد_يساوي(فك(شفر("")), "", "فارغ")
اطبع "أزواج:", ناتج
