# مثال 2440 — مجموع قوى 5
# Sum of powers of 5
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2440-sum-of-powers-of-5-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 5 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 6, "حالة 2")
تأكد_يساوي(ف(3), 156, "حالة 3")
تأكد_يساوي(ف(6), 19531, "حالة 4")
تأكد_يساوي(ف(10), 12207031, "حالة 5")
