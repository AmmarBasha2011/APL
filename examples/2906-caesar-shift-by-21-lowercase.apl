# مثال 2906 — قيصر بإزاحة 21
# Caesar shift 21
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2906-caesar-shift-by-21-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 21) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "vwx", "حالة 1")
تأكد_يساوي(ف("xyz"), "stu", "حالة 2")
تأكد_يساوي(ف("hello world"), "czggj rjmgy", "حالة 3")
تأكد_يساوي(ف("a1"), "v1", "حالة 4")
