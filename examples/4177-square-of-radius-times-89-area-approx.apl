# مثال 4177 — مساحة دائرة بتقريب 89
# Circle area with pi approx 89/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4177-square-of-radius-times-89-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 89 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 12, "حالة 2")
تأكد_يساوي(ف(7), 623, "حالة 3")
تأكد_يساوي(ف(14), 2492, "حالة 4")
تأكد_يساوي(ف(21), 5607, "حالة 5")
