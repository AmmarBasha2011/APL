# مثال 242 — تخمين الرقم (محاكاة آلية)
# Number guessing (auto player)
# Demonstrates: بحث ثنائي كاستراتيجية تخمين
#
# Run:  python apl.py examples/242-guess-number.apl

بذرة(7)
المتغير سر = عشوائي_عدد(1, 100)
المتغير منخفض = 1
المتغير مرتفع = 100
المتغير محاولات = 0

أبدا:
    المتغير تخمين = (منخفض + مرتفع) // 2
    محاولات = محاولات + 1
    لو تخمين == سر:
        اطبع "وجدتها:", تخمين, "في", محاولات, "محاولات"
        توقف
    الا لو تخمين < سر:
        منخفض = تخمين + 1
    الا:
        مرتفع = تخمين - 1
