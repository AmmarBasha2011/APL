# مثال 3331 — مجموع قوى 35
# Sum of powers of 35
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3331-sum-of-powers-of-35-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 35 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 36, "حالة 2")
تأكد_يساوي(ف(3), 44136, "حالة 3")
تأكد_يساوي(ف(6), 1892332261, "حالة 4")
تأكد_يساوي(ف(10), 2839681099207261, "حالة 5")
