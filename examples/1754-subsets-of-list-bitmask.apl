# مثال 1754 — كل المجموعات الجزئية بالقناع
# All subsets via bitmask
# Demonstrates: توافيق
#
# Run:  python apl.py examples/1754-subsets-of-list-bitmask.apl

# نمر على 2^ن قناعاً
# البت المضاء يعني اختيار العنصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجموعات(ق):
  ناتج = []
  لكل قناع في نطاق(2 ** طول(ق)):
    جزء = []
    لكل ك في نطاق(طول(ق)):
      لو (قناع >> ك) & 1 == 1:
        جزء.append(ق[ك])
    ناتج.append(جزء)
  ارجع ناتج

تأكد_يساوي(مجموعات([1, 2]), [[], [1], [2], [1, 2]], "اثنان")
تأكد_يساوي(طول(مجموعات([1, 2, 3, 4])), 16, "أربعة")
تأكد_يساوي(مجموعات([]), [[]], "فارغة")
