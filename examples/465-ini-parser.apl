# مثال 465 — قارئ ملفات INI
# INI parser
# Demonstrates: أقسام ومفاتيح
#
# Run:  python apl.py examples/465-ini-parser.apl

اكتب("/tmp/apl-465.ini", "[عام]\nاللغة = عربي\n[شبكة]\nالمنفذ = 8080")

المتغير إعدادات = {}
المتغير قسم_حالي = "عام"
المتغير سطور = اقرأ("/tmp/apl-465.ini").تقليم().تقسيم("\n")
لكل سطر في سطور:
    لو سطر.بداية("["):
        قسم_حالي = سطر[1:طول(سطر) - 1]
    الا:
        المتغير أجزاء = سطر.تقسيم(" = ")
        إعدادات[قسم_حالي + "." + أجزاء[0]] = أجزاء[1]

اطبع إعدادات
احذف_ملف("/tmp/apl-465.ini")
