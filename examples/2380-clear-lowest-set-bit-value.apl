# مثال 2380 — مسح أدنى بت مضاء
# Clear lowest set bit
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2380-clear-lowest-set-bit-value.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & (ن - 1)

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(2), 0, "حالة 2")
تأكد_يساوي(ف(12), 8, "حالة 3")
تأكد_يساوي(ف(40), 32, "حالة 4")
تأكد_يساوي(ف(96), 64, "حالة 5")
تأكد_يساوي(ف(7), 6, "حالة 6")
