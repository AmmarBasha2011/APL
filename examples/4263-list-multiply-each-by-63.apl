# مثال 4263 — ضرب كل عنصر في 63
# Multiply each item by 63
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4263-list-multiply-each-by-63.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 63]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [189, 63, 126], "حالة 1")
تأكد_يساوي(ف([5]), [315], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [63, 126, 189, 252, 315, 378], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-126, 0, 441, 441, 252], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [630, 1260, 630, 1890, 1260, 630], "حالة 5")
