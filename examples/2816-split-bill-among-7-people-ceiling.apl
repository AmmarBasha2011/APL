# مثال 2816 — تقسيم الفاتورة على 7
# Split bill among 7
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2816-split-bill-among-7-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 7 - 1) // 7

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 2, "حالة 2")
تأكد_يساوي(ف(100), 15, "حالة 3")
تأكد_يساوي(ف(101), 15, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
