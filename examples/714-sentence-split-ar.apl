# مثال 714 — تقسيم الجمل العربية
# Arabic sentence splitter
# Demonstrates: نهايات جمل، استثناءات، تقليم
#
# Run:  python apl.py examples/714-sentence-split-ar.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تقسيم نص عربي إلى جمل
# Demonstrates: نهايات . ! ؟ ?, تقليم فراغات, تجاهل الرموز المتتابعة
# النقطة داخل رقم عشري لا تقطع

دالة نهاية(ح):
  ارجع ح == "." أو ح == "!" أو ح == "؟" أو ح == "?"

دالة قسم(نص):
  جمل = []
  جارية = ""
  لكل ي في نطاق(طول(نص)):
    ح = نص[ي]
    جارية = جارية + ح
    لو نهاية(ح):
      تالية_رقم = خطأ
      لو ح == "." و ي + 1 < طول(نص):
        لو نص[ي + 1] في "0123456789" و ي > 0 و نص[ي - 1] في "0123456789":
          تالية_رقم = صواب
      لو تالية_رقم == خطأ:
        مقلمة = جارية.strip()
        لو طول(مقلمة) > 1:
          جمل.append(مقلمة)
        جارية = ""
  بقية = جارية.strip()
  لو طول(بقية) > 0:
    جمل.append(بقية)
  ارجع جمل

نص1 = "ذهب الولد إلى المدرسة. كان الجو جميلا! هل وصل متأخرا؟ لا، بل مبكرا."
ج1 = قسم(نص1)
تأكد_يساوي(طول(ج1), 4, "أربع جمل")
تأكد_يساوي(ج1[0], "ذهب الولد إلى المدرسة.", "الجملة الأولى")
تأكد_يساوي(ج1[2], "هل وصل متأخرا؟", "علامة الاستفهام العربية")
ج2 = قسم("النسخة 3.14 جديدة. صدرت اليوم.")
تأكد_يساوي(طول(ج2), 2, "النقطة العشرية لا تقطع")
تأكد_يساوي(ج2[0], "النسخة 3.14 جديدة.", "الرقم سليم")
ج3 = قسم("جملة بلا نهاية")
تأكد_يساوي(ج3, ["جملة بلا نهاية"], "بقية بلا رمز")
ج4 = قسم("أولى!  ثانية.")
تأكد_يساوي(طول(ج4), 2, "فراغ مزدوج يقلم")
اطبع ج1[1]
