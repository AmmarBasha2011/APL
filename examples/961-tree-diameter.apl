# مثال 961 — قطر الشجرة
# Tree diameter
# Demonstrates: مسحان عرضيان متتاليان
#
# Run:  python apl.py examples/961-tree-diameter.apl

# قطر الشجرة: أطول مسار بين عقدتين عبر مسحين عرضيين
# أول مسح يجد طرفاً بعيداً، وثاني مسح منه يعطي القطر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

جوار = [[], [], [], [], []]
حواف = [[0, 1], [1, 2], [2, 3], [1, 4]]
لكل ح في حواف:
  جوار[ح[0]].ألحق(ح[1])
  جوار[ح[1]].ألحق(ح[0])

دالة أبعد(بداية):
  مسافات = [-1, -1, -1, -1, -1]
  مسافات[بداية] = 0
  طابور = [بداية]
  رأس = 0
  طالما رأس < طول(طابور):
    عقدة = طابور[رأس]
    رأس = رأس + 1
    لكل جار في جوار[عقدة]:
      لو مسافات[جار] == -1:
        مسافات[جار] = مسافات[عقدة] + 1
        طابور.ألحق(جار)
  أفضل = 0
  أقصى = -1
  لكل عقدة2 في نطاق(5):
    لو مسافات[عقدة2] > أقصى:
      أقصى = مسافات[عقدة2]
      أفضل = عقدة2
  ارجع [أفضل, أقصى]

أول = أبعد(0)
ثان = أبعد(أول[0])
تأكد_يساوي(أول[0], 3, "أبعد عقدة عن الصفر")
تأكد_يساوي(ثان[1], 3, "قطر الشجرة")
