# مثال 455 — تنسيق العناوين الإنجليزية
# Title case converter
# Demonstrates: كلمات صغرى تبقى صغيرة
#
# Run:  python apl.py examples/455-title-case.apl

المتغير صغرى = ["a", "an", "the", "of", "in", "on", "and"]

دالة عنوان_سليم(نص_الدخل):
    المتغير كلمات = نص_الدخل.تقسيم(" ")
    المتغير نتائج = []
    لكل ي في نطاق(طول(كلمات)):
        المتغير كلمة = كلمات[ي]
        لو ي > 0 و صغرى.count(كلمة) > 0:
            نتائج.append(كلمة)
        الا:
            نتائج.append(كلمة[0].علوي() + كلمة[1:])
    ارجع " ".ضم(نتائج)

اطبع عنوان_سليم("the lord of the rings")
اطبع عنوان_سليم("a tale of two cities")
