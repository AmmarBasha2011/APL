# مثال 138 — معلومات النظام والبيئة
# System and environment info
# Demonstrates: متغير_بيئة، مجلد_حالي، معرف_عملية، مجلد_منزل
#
# Run:  python apl.py examples/138-os-env.apl

اطبع "المجلد الحالي:", مجلد_حالي()
اطبع "معرف العملية:", معرف_عملية() > 0
اطبع "المجلد المنزل موجود؟", موجود(مجلد_منزل("~"))
اطبع "PATH موجود؟", متغير_بيئة("PATH") != لا_شيء
اطبع "متغير غير موجود مع افتراضي:", متغير_بيئة("APL_NO_SUCH", "القيمة الافتراضية")
اطبع "فاصل المسار:", فاصل_مسار
