# مثال 2661 — مجموع الأعداد من 5 إلى ن
# Sum from 5 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2661-sum-of-integers-from-5-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(5, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(5), 5, "حالة 1")
تأكد_يساوي(ف(6), 11, "حالة 2")
تأكد_يساوي(ف(15), 110, "حالة 3")
تأكد_يساوي(ف(100), 5040, "حالة 4")
