# مثال 2744 — تدوير لليسار بمقدار 17
# Rotate left by 17
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2744-list-rotate-left-by-17.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لو طول(ق) == 0:
    ارجع ق
  ك = 17 % طول(ق)
  ارجع ق[ك:] + ق[:ك]

تأكد_يساوي(ف([3, 1, 2]), [2, 3, 1], "حالة 1")
تأكد_يساوي(ف([5]), [5], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [6, 1, 2, 3, 4, 5], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [7, 7, 4, -2, 0], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [10, 10, 20, 10, 30, 20], "حالة 5")
