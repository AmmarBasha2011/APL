# مثال 1260 — موقف سيارات
# Parking lot with slots by size
# Demonstrates: قوائم
#
# Run:  python apl.py examples/1260-parking-lot-slots.apl

# لكل حجم عدد أماكن محدد
# السيارة تحجز مكاناً من حجمها لو توافر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف موقف:
  دالة_إنشاء(ذات, كبيرة, متوسطة, صغيرة):
    ذات.متاح = {1: كبيرة, 2: متوسطة, 3: صغيرة}

  دالة اركن(ذات, نوع_سيارة):
    لو ذات.متاح[نوع_سيارة] > 0:
      ذات.متاح[نوع_سيارة] = ذات.متاح[نوع_سيارة] - 1
      ارجع صواب
    ارجع خطأ

م = موقف(1, 1, 0)
تأكد_يساوي(م.اركن(1), صواب, "كبيرة")
تأكد_يساوي(م.اركن(2), صواب, "متوسطة")
تأكد_يساوي(م.اركن(3), خطأ, "لا صغيرة")
تأكد_يساوي(م.اركن(1), خطأ, "ممتلئ")
