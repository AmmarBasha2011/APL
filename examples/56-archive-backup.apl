# مثال 56 — أداة نسخ احتياطي حقيقية بالأرشيف
# A real backup tool: zip a project folder, verify, rotate, restore
# Demonstrates: أنشئ_أرشيف, بيانات_الأرشيف, افحص_أرشيف, عرض_الأرشيف,
#               قائمة_الأرشيف, نص_العضو, بايتات_العضو, استخرج_الأرشيف,
#               احذف_من_الأرشيف, حجم_بشري, نوع_الأرشيف
#
# Run:  python apl.py examples/56-archive-backup.apl

المتغير الجذر = "_apl_نسخ_تجربة"
المتغير المشروع = الجذر + "/مشروع"
المتغير النسخ = الجذر + "/نسخ"

# ---------- 1) مشروع وهمي: كود ووثائق ----------
انشئ_مجلدات(المشروع + "/src")
انشئ_مجلدات(المشروع + "/docs")
انشئ_مجلدات(المشروع + "/src/utils")

اكتب(المشروع + "/README.md", "# مشروع تجريبي\nنسخة توضيحية لأداة النسخ الاحتياطي.\n")
اكتب(المشروع + "/src/main.py", "def main():\n    print('مرحباً')\n\nmain()\n")
اكتب(المشروع + "/src/utils/helpers.py", "def add(a, b):\n    return a + b\n")
المتغير سجلات = []
لكل رقم في نطاق(1, 151):
    سجلات.أضف("2026-11-20 INFO  العملية " + نص(رقم) + " تمت بنجاح\n")
اكتب(المشروع + "/docs/سجلات.log", "".ضم(سجلات))

# ---------- 2) دالة النسخ الاحتياطي ----------
دالة انسخ_احتياطياً(المصدر, مجلد_النسخ, اسم) -> نص:
    انشئ_مجلدات(مجلد_النسخ, موجود_سلفا = صواب)
    المتغير الهدف = مجلد_النسخ + "/" + اسم + ".zip"
    أنشئ_أرشيف(الهدف, [المصدر])
    ارجع الهدف

اطبع "=== 1) إنشاء النسخة ==="
المتغير اسم_النسخة = "مشروع-" + لتنسيق_وقت(التاريخ_الآن(), "%Y%m%d-%H%M%S")
المتغير نسخة_1 = انسخ_احتياطياً(المشروع, النسخ, اسم_النسخة)
اطبع "أُنشئت: " + نسخة_1
اطبع "الحجم: " + حجم_بشري(حجم_الأرشيف(نسخة_1))
اطبع "النوع: " + نوع_الأرشيف(نسخة_1)
اطبع ""

# ---------- 3) التحقق من السلامة ----------
اطبع "=== 2) التحقق ==="
اطبع "أرشيف ZIP سليم؟ " + نص(افحص_أرشيف(نسخة_1))

المتغير الأرش = افتح_أرشيف(نسخة_1)
اطبع "سلامة كل الأعضاء: " + نص(الأرش.افحص_السلامة())
الأرش.أغلق_الأرشيف()

المتغير إحصاء = بيانات_الأرشيف(نسخة_1)
اطبع "عدد الملفات: " + نص(إحصاء["عدد_الأعضاء"])
اطبع "قبل الضغط: " + حجم_بشري(إحصاء["الحجم_الأصلي"])
اطبع "بعد الضغط: " + حجم_بشري(إحصاء["الحجم_المضغوط"])
اطبع "نسبة الحجم النهائي: " + نص(إحصاء["نسبة_الضغط"]) + "%"
اطبع ""

# ---------- 4) محتوى النسخة ----------
اطبع "=== 3) محتويات النسخة ==="
عرض_الأرشيف(نسخة_1)
اطبع ""

# ---------- 5) استعادة ملف واحد من النسخة ----------
اطبع "=== 4) استعادة ملف ==="
المتغير مسار_الاستعادة = الجذر + "/استعادة"
استخرج_الأرشيف(نسخة_1, مسار_الاستعادة, ["مشروع/README.md"])
اطبع "المحتوى المستعاد:"
اطبع اقرأ(مسار_الاستعادة + "/مشروع/README.md")

# بايتات أحد الأعضاء مباشرة، بدون استخراج على القرص
المتغير خام = بايتات_العضو(نسخة_1, "مشروع/src/main.py")
اطبع "حجمه: " + حجم_بشري(طول(خام)) + " (بايتات خام)"
اطبع ""

# ---------- 6) نسخة ثانية ودوران النسخ ----------
اطبع "=== 5) نسخة ثانية وتقليم ==="
اكتب(المشروع + "/docs/ملاحظة.txt", "ملاحظة أُضيفت بعد النسخة الأولى\n")
المتغير نسخة_2 = انسخ_احتياطياً(المشروع, النسخ, اسم_النسخة + "-ب")
اطبع "أعضاء النسخة الثانية: " + نص(عدد_الأعضاء(نسخة_2))

# النسخة القديمة تُنقّى من أهم أعضائها لتصغيرها (تمثيل لعملية تقليم)
احذف_من_الأرشيف(نسخة_1, ["مشروع/docs/سجلات.log", "مشروع/src/utils/helpers.py"])
المتغير إحصاء_2 = بيانات_الأرشيف(نسخة_1)
اطبع "بعد التقليم — الأعضاء: " + نص(إحصاء_2["عدد_الأعضاء"]) + " | الحجم: " + حجم_بشري(إحصاء_2["الحجم_المضغوط"])
اطبع ""

# ---------- 7) استعادة كاملة من النسخة الثانية ----------
اطبع "=== 6) استعادة كاملة ==="
المستعاد_كامل = استخرج_الأرشيف(نسخة_2, الجذر + "/استعادة_كاملة")
اطبع "عدد الملفات المستعادة: " + نص(طول(المستعاد_كامل))
اطبع "هل وصلت الملاحظة الجديدة؟ " + نص(موجود(الجذر + "/استعادة_كاملة/مشروع/docs/ملاحظة.txt"))

# ---------- 8) تنظيف ----------
احذف_شجرة(الجذر)
اطبع ""
اطبع "تم تنظيف ملفات التجربة."
