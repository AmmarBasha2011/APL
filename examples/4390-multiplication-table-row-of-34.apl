# مثال 4390 — صف جدول ضرب 34
# Multiplication row of 34
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4390-multiplication-table-row-of-34.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 34]
  ارجع ر

تأكد_يساوي(ف(1), [34], "حالة 1")
تأكد_يساوي(ف(5), [34, 68, 102, 136, 170], "حالة 2")
تأكد_يساوي(ف(10), [34, 68, 102, 136, 170, 204, 238, 272, 306, 340], "حالة 3")
