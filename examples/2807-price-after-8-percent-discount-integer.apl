# مثال 2807 — السعر بعد خصم 8 بالمئة
# Price after 8 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2807-price-after-8-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 8 // 100

تأكد_يساوي(ف(100), 92, "حالة 1")
تأكد_يساوي(ف(250), 230, "حالة 2")
تأكد_يساوي(ف(999), 920, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
