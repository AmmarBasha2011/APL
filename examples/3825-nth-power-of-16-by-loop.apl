# مثال 3825 — قوة 16 بالحلقة
# Power of 16 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3825-nth-power-of-16-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 16
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 16, "حالة 2")
تأكد_يساوي(ف(3), 4096, "حالة 3")
تأكد_يساوي(ف(6), 16777216, "حالة 4")
تأكد_يساوي(ف(10), 1099511627776, "حالة 5")
