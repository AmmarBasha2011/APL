# مثال 229 — عكس الكلمات والجمل
# Word and sentence reverser
# Demonstrates: تقطيع عكسي، عكس ترتيب الكلمات
#
# Run:  python apl.py examples/229-word-reverser.apl

دالة اعكس_حروف(كلمة):
    ارجع كلمة[::-1]

دالة اعكس_ترتيب(جملة):
    المتغير كلمات = جملة.تقسيم(" ")
    المتغير معكوسة = []
    لكل ي في نطاق(طول(كلمات)):
        معكوسة.أضف(كلمات[طول(كلمات) - 1 - ي])
    ارجع " ".ضم(معكوسة)

اطبع اعكس_حروف("مرحبا")
اطبع اعكس_حروف("APL")
اطبع اعكس_ترتيب("البرمجة بالعربية جميلة")
