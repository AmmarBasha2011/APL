# مثال 163 — المعرفات الفريدة
# UUID generation
# Demonstrates: معرف_فريد، معرف_زمني، طول
#
# Run:  python apl.py examples/163-uuid-generate.apl

المتغير أ = معرف_فريد()
اطبع "معرف عشوائي:", أ
اطبع "طوله نصياً:", طول(نص(أ))
اطبع "معرف زمني مختلف؟", معرف_زمني() != معرف_زمني()

المتغير مجموعة = مجموعة_فريدة()
لكل _ في نطاق(100):
    مجموعة.add(نص(معرف_فريد()))
اطبع "100 معرف كلها فريدة؟", طول(مجموعة) == 100
