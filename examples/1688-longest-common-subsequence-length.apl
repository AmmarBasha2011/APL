# مثال 1688 — أطول متتالية جزئية مشتركة
# Longest common subsequence length
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1688-longest-common-subsequence-length.apl

# جدول بطول النصين
# نزيد القطر عند التطابق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة طول_مشترك(أ, ب):
  ن = طول(أ)
  م = طول(ب)
  جدول = []
  لكل ي في نطاق(ن + 1):
    صف = []
    لكل ك في نطاق(م + 1):
      صف.append(0)
    جدول.append(صف)
  لكل ي في نطاق(1, ن + 1):
    لكل ك في نطاق(1, م + 1):
      لو أ[ي - 1] == ب[ك - 1]:
        جدول[ي][ك] = جدول[ي - 1][ك - 1] + 1
      والا:
        جدول[ي][ك] = أكبر(جدول[ي - 1][ك], جدول[ي][ك - 1])
  ارجع جدول[ن][م]

تأكد_يساوي(طول_مشترك("abcde", "ace"), 3, "ثلاثة")
تأكد_يساوي(طول_مشترك("abc", "def"), 0, "لا شيء")
تأكد_يساوي(طول_مشترك("aaaa", "aa"), 2, "مكررة")
