# مثال 413 — مستكشف يونيكود
# Unicode explorer
# Demonstrates: ترميز_حرف وفك_ترميز_حرف
#
# Run:  python apl.py examples/413-unicode-explorer.apl

اطبع "الأبجدية العربية الأولى:"
لكل ي في نطاق(0, 10):
    المتغير رمز = 0x0627 + ي
    اطبع نص(رمز) + " = " + فك_ترميز_حرف(رمز)

اطبع "رموز خاصة:"
لكل رمز in [0x2764, 0x2713, 0x2605]:
    اطبع فك_ترميز_حرف(رمز)

اطبع "ترميز حرف أ:", ترميز_حرف("أ")
