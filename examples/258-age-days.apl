# مثال 258 — العمر بالأيام
# Age in days
# Demonstrates: حساب الأيام بين تاريخين يدويا
#
# Run:  python apl.py examples/258-age-days.apl

دالة كبيسة(سنة_م):
    لو سنة_م % 400 == 0:
        ارجع صواب
    لو سنة_م % 100 == 0:
        ارجع خطأ
    ارجع سنة_م % 4 == 0

دالة أيام_منذ_الميلاد(يوم_م, شهر_م, سنة_م):
    المتغير أيام_شهور = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    المتغير مجموع = يوم_م
    لكل س في نطاق(1, سنة_م):
        لو كبيسة(س):
            مجموع = مجموع + 366
        الا:
            مجموع = مجموع + 365
    لكل م في نطاق(شهر_م - 1):
        مجموع = مجموع + أيام_شهور[م]
    لو شهر_م > 2 و كبيسة(سنة_م):
        مجموع = مجموع + 1
    ارجع مجموع

المتغير ميلاد = أيام_منذ_الميلاد(9, 9, 2000)
المتغير اليوم_م = أيام_منذ_الميلاد(23, 11, 2026)
اطبع "العمر بالأيام:", اليوم_م - ميلاد
اطبع "بالأسابيع تقريبا:", (اليوم_م - ميلاد) // 7
