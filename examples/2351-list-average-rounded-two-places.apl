# مثال 2351 — المتوسط بمنزلتين
# Average rounded
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2351-list-average-rounded-two-places.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع round(sum(ق) / طول(ق), 2)

تأكد_يساوي(ف([1, 2]), 1.5, "حالة 1")
تأكد_يساوي(ف([1, 2, 2]), 1.67, "حالة 2")
تأكد_يساوي(ف([10]), 10.0, "حالة 3")
تأكد_يساوي(ف([3, 3, 4]), 3.33, "حالة 4")
