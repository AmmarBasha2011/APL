# مثال 1773 — أقواس صحيحة بثلاثة أنواع
# Valid brackets of three kinds
# Demonstrates: مكدسات
#
# Run:  python apl.py examples/1773-valid-brackets-three-kinds.apl

# نكدس الفاتح
# ونقارن عند الإغلاق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صحيحة(س):
  أزواج = {")": "(", "]": "[", "}": "{"}
  مكدس = []
  لكل ح في س:
    لو ح في "([{":
      مكدس.append(ح)
    والا_لو ح في ")]}":
      لو طول(مكدس) == 0:
        ارجع خطأ
      لو مكدس.pop() != أزواج[ح]:
        ارجع خطأ
  ارجع طول(مكدس) == 0

تأكد_يساوي(صحيحة("([]{})"), صواب, "متداخلة")
تأكد_يساوي(صحيحة("(]"), خطأ, "متعارضة")
تأكد_يساوي(صحيحة("(("), خطأ, "ناقصة")
تأكد_يساوي(صحيحة(""), صواب, "فارغة")
