# مثال 315 — المتتالية الحسابية
# Arithmetic sequence
# Demonstrates: الحد النوني والمجموع
#
# Run:  python apl.py examples/315-arithmetic-sequence.apl

دالة حد_نوني(أول, فرق, ن):
    ارجع أول + (ن - 1) * فرق

دالة مجموع_حسابية(أول, فرق, ن):
    ارجع ن * (2 * أول + (ن - 1) * فرق) // 2

اطبع "الحد العاشر (أول=3، فرق=2):", حد_نوني(3, 2, 10)
اطبع "مجموع أول 10 حدود:", مجموع_حسابية(3, 2, 10)
اطبع "مجموع 1 إلى 100:", مجموع_حسابية(1, 1, 100)
