# مثال 2520 — الحد النوني بخطوة 6
# Nth term step 6
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2520-nth-term-arithmetic-sequence-step-6.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 6

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 9, "حالة 2")
تأكد_يساوي(ف(10), 57, "حالة 3")
تأكد_يساوي(ف(100), 597, "حالة 4")
