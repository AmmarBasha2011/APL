# مثال 741 — HMAC يدوي
# HMAC from scratch
# Demonstrates: كتل 64 بايت، حشوات ipad/opad، XOR بايتي
#
# Run:  python apl.py examples/741-hmac-manual.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# بناء HMAC يدوياً من تجزئة SHA-256 (RFC 2104)
# Demonstrates: كتل 64 بايت, حشوات ipad/opad, XOR بايتي, تجزئة متداخلة
# HMAC(K, m) = H((K' ^ opad) || H((K' ^ ipad) || m))

دالة هماك_خام(مفتاح, رسالة):
  لو طول(مفتاح) > 64:
    مفتاح = تجزئة_sha256(مفتاح).digest()
  لو طول(مفتاح) < 64:
    مفتاح = مفتاح + b"\x00" * (64 - طول(مفتاح))
  أيباد = []
  أوباد = []
  لكل ي في نطاق(64):
    أيباد.append(مفتاح[ي] ^ 54)
    أوباد.append(مفتاح[ي] ^ 92)
  داخلي = تجزئة_sha256(bytearray(أيباد) + رسالة).digest()
  ارجع تجزئة_sha256(bytearray(أوباد) + داخلي).digest()

دالة هماك(مفتاح, رسالة):
  ارجع هماك_خام(مفتاح, رسالة).hex()

تأكد_يساوي(
  هماك(b"\x0b" * 20, b"Hi There"),
  "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
  "متجه RFC 4231 الأول"
)
تأكد_يساوي(
  هماك(b"key", b"The quick brown fox jumps over the lazy dog"),
  "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8",
  "مفتاح قصير ورسالة طويلة"
)

# مفتاح أطول من الكتلة يُجزأ أولاً
مفتاح_طويل = b"\xaa" * 100
تأكد_يساوي(طول(هماك(مفتاح_طويل, b"data")), 64, "مفتاح طويل يعمل")
تأكد_يساوي(هماك(b"k", b"") == هماك(b"k", b""), صواب, "حتمية الناتج")
تأكد_يساوي(هماك(b"k1", b"m") == هماك(b"k2", b"m"), خطأ, "مفتاحان مختلفان")

اطبع "HMAC:", هماك(b"key", b"message")
