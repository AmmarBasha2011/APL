# مثال 690 — قارئ TOML مصغر
# TOML lite parser
# Demonstrates: أقسام، مفاتيح، أنواع
#
# Run:  python apl.py examples/690-toml-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# قارئ TOML مصغر: أقسام ومفاتيح وقيم
# Demonstrates: تتبع القسم الحالي, قيم نصية ورقمية ومنطقية, تعليقات
# يدعم: [قسم]، مفتاح = "نص"، مفتاح = 42، مفتاح = true/false

دالة قيمة_من(خام):
  لو خام.startswith("\"") و خام.endswith("\""):
    ارجع خام[1:طول(خام) - 1]
  لو خام == "true":
    ارجع صواب
  لو خام == "false":
    ارجع خطأ
  ارجع صحيح(خام)

دالة اقرأ_تومل(سطور):
  جذر = {}
  حالي = جذر
  لكل سطر في سطور:
    م = سطر.strip()
    لو طول(م) == 0 أو م.startswith("#"):
      م = ""
    والا_لو م.startswith("["):
      اسم = م[1:طول(م) - 1]
      جذر[اسم] = {}
      حالي = جذر[اسم]
    والا:
      طرفان = م.split("=")
      مفتاح = طرفان[0].strip()
      خام = طرفان[1].strip()
      حالي[مفتاح] = قيمة_من(خام)
  ارجع جذر

سطور = [
  "# إعداد الخادم",
  "عنوان = \"موقعي\"",
  "",
  "[server]",
  "host = \"127.0.0.1\"",
  "port = 8080",
  "tls = true",
  "",
  "[limits]",
  "max_conn = 256",
  "debug = false"
]
ق = اقرأ_تومل(سطور)
تأكد_يساوي(ق["عنوان"], "موقعي", "مفتاح الجذر")
تأكد_يساوي(ق["server"]["host"], "127.0.0.1", "مضيف")
تأكد_يساوي(ق["server"]["port"], 8080, "منفذ رقمي")
تأكد_يساوي(ق["server"]["tls"], صواب, "قيمة منطقية صحيحة")
تأكد_يساوي(ق["limits"]["max_conn"], 256, "حد الاتصالات")
تأكد_يساوي(ق["limits"]["debug"], خطأ, "قيمة منطقية خاطئة")
اطبع "المنفذ:", ق["server"]["port"]
