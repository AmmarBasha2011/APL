# مثال 839 — جرام-شميدت
# Gram-Schmidt
# Demonstrates: إزالة إسقاطات، تطبيع
#
# Run:  python apl.py examples/839-gram-schmidt.apl

# عملية جرام-شميدت: تحويل متجهات مستقلة إلى متجهات متعامدة معيارية
# أساس تحليل QR وحل أصغر المربعات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ضرب_نقطي(أ, ب):
  مجموع = 0.0
  لكل i في نطاق(طول(أ)):
    مجموع = مجموع + أ[i] * ب[i]
  ارجع مجموع

دالة اطرح_إسقاط(م, مرجع):
  ناتج = []
  معامل = ضرب_نقطي(م, مرجع) / ضرب_نقطي(مرجع, مرجع)
  لكل i في نطاق(طول(م)):
    ناتج.ألحق(م[i] - معامل * مرجع[i])
  ارجع ناتج

دالة طبّع(م):
  مقياس = جذر(ضرب_نقطي(م, م))
  ناتج = []
  لكل ق في م:
    ناتج.ألحق(ق / مقياس)
  ارجع ناتج

ع1 = [1.0, 1.0, 0.0]
ع2 = [1.0, 0.0, 1.0]

و1 = ع1
و2 = اطرح_إسقاط(ع2, و1)
ق1 = طبّع(و1)
ق2 = طبّع(و2)

اطبع "u2 =", و2
اطبع "q1 =", ق1
اطبع "q2 =", ق2

تأكد_يساوي(و2[0], 0.5, "و2[0] بعد إزالة الإسقاط")
تأكد_يساوي(و2[1], -0.5, "و2[1] بعد إزالة الإسقاط")
تأكد_يساوي(و2[2], 1.0, "و2[2] لم يتغير")

تأكد_يساوي(مقرب(ضرب_نقطي(ق1, ق2), 9), 0.0, "ق1 عمودي على ق2")
تأكد_يساوي(مقرب(ضرب_نقطي(ق1, ق1), 9), 1.0, "ق1 وحدة الطول")
تأكد_يساوي(مقرب(ضرب_نقطي(ق2, ق2), 9), 1.0, "ق2 وحدة الطول")
