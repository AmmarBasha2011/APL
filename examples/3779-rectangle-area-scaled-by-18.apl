# مثال 3779 — مساحة مستطيل مكبر 18 مرات
# Rectangle area scaled by 18
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3779-rectangle-area-scaled-by-18.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 18) * (ق[1] * 18)

تأكد_يساوي(ف([1, 2]), 648, "حالة 1")
تأكد_يساوي(ف([3, 4]), 3888, "حالة 2")
تأكد_يساوي(ف([5, 5]), 8100, "حالة 3")
تأكد_يساوي(ف([10, 1]), 3240, "حالة 4")
