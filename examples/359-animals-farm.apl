# مثال 359 — مزرعة حيوانات
# Animal farm
# Demonstrates: عد وتجميع بالفصيلة
#
# Run:  python apl.py examples/359-animals-farm.apl

صنف حيوان_مزرعة:
    دالة_إنشاء(ذات, فصيلة, اسم, عمر):
        ذات.فصيلة = فصيلة
        ذات.اسم = اسم
        ذات.عمر = عمر

المتغير مزرعة = [
    حيوان_مزرعة("بقرة", "بهيمة", 5),
    حيوان_مزرعة("دجاجة", "كوكو", 1),
    حيوان_مزرعة("بقرة", "زبيدة", 3),
    حيوان_مزرعة("حصان", "صقر", 7),
    حيوان_مزرعة("دجاجة", "بيبي", 2)
]

المتغير بالفصيلة = {}
لكل ح in مزرعة:
    لو ح.فصيلة in بالفصيلة:
        بالفصيلة[ح.فصيلة] = بالفصيلة[ح.فصيلة] + 1
    الا:
        بالفصيلة[ح.فصيلة] = 1

لكل فصيلة in بالفصيلة:
    اطبع فصيلة, ":", بالفصيلة[فصيلة]

المتغير أكبر_عمر = مزرعة[0]
لكل ح in مزرعة:
    لو ح.عمر > أكبر_عمر.عمر:
        أكبر_عمر = ح
اطبع "الأكبر سنا:", أكبر_عمر.اسم, "(", أكبر_عمر.عمر, "سنوات)"
