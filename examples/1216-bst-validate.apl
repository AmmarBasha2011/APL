# مثال 1216 — التحقق من شجرة بحث
# Validate binary search tree
# Demonstrates: حدود
#
# Run:  python apl.py examples/1216-bst-validate.apl

# نمرر لكل عقدة حداً أدنى وأقصى
# والقيمة يجب أن تقع بينهما

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صحيحة(ش, ادنى, اقصى):
  لو طول(ش) == 0:
    ارجع صواب
  لو (ش[0] <= ادنى) أو (ش[0] >= اقصى):
    ارجع خطأ
  ي = صحيحة(ش[1], ادنى, ش[0])
  لو ليس ي:
    ارجع خطأ
  ارجع صحيحة(ش[2], ش[0], اقصى)

كبير = 10 ** 9
تأكد_يساوي(صحيحة([2, [1, [], []], [3, [], []]], -كبير, كبير), صواب, "صحيحة")
تأكد_يساوي(صحيحة([5, [1, [], []], [4, [3, [], []], [6, [], []]]], -كبير, كبير), خطأ, "فرع خاطئ")
تأكد_يساوي(صحيحة([5, [4, [], [6, [], []]], []], -كبير, كبير), خطأ, "حفيد خاطئ")
تأكد_يساوي(صحيحة([], -كبير, كبير), صواب, "فارغة")
