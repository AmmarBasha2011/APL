# مثال 1544 — الربيعات
# Quartiles of a list
# Demonstrates: إحصاء
#
# Run:  python apl.py examples/1544-quartile-bounds.apl

# نرتب القائمة
# نقسمها نصفين ونأخذ وسيط كل نصف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة وسيط(ق):
  ن = طول(ق)
  لو ن % 2 == 1:
    ارجع ق[ن // 2]
  ارجع (ق[ن // 2 - 1] + ق[ن // 2]) / 2

دالة ربيعات(أ):
  ق = []
  لكل ع في أ:
    ق.append(ع)
  ق.sort()
  ن = طول(ق)
  أول = ق[0:ن // 2]
  ثان = ق[(ن + 1) // 2:ن]
  ارجع [وسيط(أول), وسيط(ثان)]

تأكد_يساوي(ربيعات([1, 2, 3, 4, 5, 6, 7, 8]), [2.5, 6.5], "ثمانية")
تأكد_يساوي(ربيعات([7, 1, 3, 5, 9, 11, 13]), [3, 11], "سبعة")
