# مثال 1401 — الأعداد الخماسية
# Pentagonal numbers
# Demonstrates: رياضيات
#
# Run:  python apl.py examples/1401-pentagonal-numbers.apl

# الحد ن يساوي ن(3ن-1)/2
# نختبر الانتماء بالمرور على الحدود

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة خماسية(ن):
  ناتج = []
  لكل ك في نطاق(1, ن + 1):
    ناتج.ألحق(ك * (3 * ك - 1) // 2)
  ارجع ناتج

دالة خماسي(عدد):
  ك = 1
  طالما ك * (3 * ك - 1) // 2 < عدد:
    ك = ك + 1
  ارجع ك * (3 * ك - 1) // 2 == عدد

تأكد_يساوي(خماسية(5), [1,5,12,22,35], "خمسة حدود")
تأكد_يساوي(خماسي(22), صواب, "اثنان وعشرون")
تأكد_يساوي(خماسي(23), خطأ, "ثلاثة وعشرون")
