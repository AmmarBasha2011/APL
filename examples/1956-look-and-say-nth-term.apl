# مثال 1956 — متتالية انظر وقل
# Look-and-say sequence
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1956-look-and-say-nth-term.apl

# # نعد التكرارات المتتالية لكل رقم
# # ونكتب العدد ثم الرقم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة التالي(س):
  خرج = ""
  ك = 0
  طالما ك < طول(س):
    ي = ك
    طالما ي < طول(س) و س[ي] == س[ك]:
      ي = ي + 1
    خرج = خرج + نص(ي - ك) + س[ك]
    ك = ي
  ارجع خرج

دالة حد(ن):
  س = "1"
  لكل ك في نطاق(ن - 1):
    س = التالي(س)
  ارجع س

تأكد_يساوي(حد(1), "1", "الأول")
تأكد_يساوي(حد(4), "1211", "الرابع")
تأكد_يساوي(حد(6), "312211", "السادس")
تأكد_يساوي(طول(حد(10)), 20, "طول العاشر")
