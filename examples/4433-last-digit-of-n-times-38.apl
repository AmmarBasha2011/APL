# مثال 4433 — آخر رقم من ن×38
# Last digit of n times 38
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4433-last-digit-of-n-times-38.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 38) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 8, "حالة 2")
تأكد_يساوي(ف(7), 6, "حالة 3")
تأكد_يساوي(ف(12), 6, "حالة 4")
تأكد_يساوي(ف(99), 2, "حالة 5")
