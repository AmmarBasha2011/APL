# مثال 320 — عد الأولية وقائمتها حتى ن
# Primes up to N
# Demonstrates: غربال مع إحصاء
#
# Run:  python apl.py examples/320-sieve-count.apl

دالة أولية_حتى(حد):
    المتغير أولي = [صواب لكل _ في نطاق(حد + 1)]
    أولي[0] = خطأ
    لو حد >= 1:
        أولي[1] = خطأ
    المتغير س = 2
    طالما س * س <= حد:
        لو أولي[س]:
            المتغير م = س * س
            طالما م <= حد:
                أولي[م] = خطأ
                م = م + س
        س = س + 1
    ارجع [رقم لكل رقم في نطاق(2, حد + 1) لو أولي[رقم]]

المتغير قائمة = أولية_حتى(100)
اطبع "أولية حتى 100:", قائمة
اطبع "عددها:", طول(قائمة)
اطبع "عدد الأولية حتى 1000:", طول(أولية_حتى(1000))
