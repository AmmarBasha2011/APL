# مثال 558 — الحذف الجاوسي
# Gaussian elimination
# Demonstrates: جاوس، نظام خطي، تعويض خلفي
#
# Run:  python apl.py examples/558-gaussian-elimination.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# حذف جاوس لحل نظام معادلات خطية
دالة حل_نظام(مصفوفة, ثوابت):
    المتغير ن = طول(ثوابت)
    لكل عمود في نطاق(ن):
        المتغير أقصى_صف = عمود
        لكل صف في نطاق(عمود + 1, ن):
            لو مطلق(مصفوفة[صف][عمود]) > مطلق(مصفوفة[أقصى_صف][عمود]):
                أقصى_صف = صف
        المتغير مؤقت = مصفوفة[عمود]
        مصفوفة[عمود] = مصفوفة[أقصى_صف]
        مصفوفة[أقصى_صف] = مؤقت
        المتغير ع = ثوابت[عمود]
        ثوابت[عمود] = ثوابت[أقصى_صف]
        ثوابت[أقصى_صف] = ع
        لكل صف في نطاق(عمود + 1, ن):
            المتغير عامل = مصفوفة[صف][عمود] / مصفوفة[عمود][عمود]
            لكل ك في نطاق(عمود, ن):
                مصفوفة[صف][ك] = مصفوفة[صف][ك] - عامل * مصفوفة[عمود][ك]
            ثوابت[صف] = ثوابت[صف] - عامل * ثوابت[عمود]
    المتغير حل = [0] * ن
    لكل i في نطاق(ن - 1, -1, -1):
        المتغير م = ثوابت[i]
        لكل ك في نطاق(i + 1, ن):
            م = م - مصفوفة[i][ك] * حل[ك]
        حل[i] = م / مصفوفة[i][i]
    ارجع حل

المتغير حل = حل_نظام([[2, 1, -1], [-3, -1, 2], [-2, 1, 2]], [8, -11, -3])
اطبع "الحل:", حل
تأكد_يساوي(مقرب(حل[0], 9), 2, "س")
تأكد_يساوي(مقرب(حل[1], 9), 3, "ص")
تأكد_يساوي(مقرب(حل[2], 9), 0 - 1, "ع")
