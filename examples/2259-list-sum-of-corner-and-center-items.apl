# مثال 2259 — مجموع الأول والأخير والأوسط
# First last middle sum
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2259-list-sum-of-corner-and-center-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع ق[0] + ق[-1] + ق[طول(ق) // 2]

تأكد_يساوي(ف([3, 1, 2]), 6, "حالة 1")
تأكد_يساوي(ف([5]), 15, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 11, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 9, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 50, "حالة 5")
