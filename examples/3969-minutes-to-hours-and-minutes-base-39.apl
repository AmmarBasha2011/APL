# مثال 3969 — تحويل وحدة بأساس 39
# Split by base 39
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3969-minutes-to-hours-and-minutes-base-39.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 39, ن % 39]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 20], "حالة 2")
تأكد_يساوي(ف(60), [1, 21], "حالة 3")
تأكد_يساوي(ف(125), [3, 8], "حالة 4")
تأكد_يساوي(ف(1000), [25, 25], "حالة 5")
