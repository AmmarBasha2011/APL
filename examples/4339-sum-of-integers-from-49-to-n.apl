# مثال 4339 — مجموع الأعداد من 49 إلى ن
# Sum from 49 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4339-sum-of-integers-from-49-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(49, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(49), 49, "حالة 1")
تأكد_يساوي(ف(50), 99, "حالة 2")
تأكد_يساوي(ف(59), 594, "حالة 3")
تأكد_يساوي(ف(100), 3874, "حالة 4")
