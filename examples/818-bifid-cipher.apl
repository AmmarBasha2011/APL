# مثال 818 — شفرة بيفيد
# Bifid cipher
# Demonstrates: فصل إحداثيات، كتل بدورة
#
# Run:  python apl.py examples/818-bifid-cipher.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شفرة بيفيد التجزيئية: فصل الصفوف عن الأعمدة ثم إعادة الاقتران
# Demonstrates: مربع بوليبيوس, كتل بدورة ثابتة, خلط إحداثيات

مربع = "ABCDEFGHIKLMNOPQRSTUVWXYZ"

دالة موقع(ح):
  لكل ي في نطاق(25):
    لو مربع[ي] == ح:
      ارجع ي
  ارجع 0 - 1

دالة شفر_بيفيد(نص, دورة):
  ناتج = ""
  بداية = 0
  طالما بداية < طول(نص):
    صفوف = []
    أعمدة = []
    نهاية = بداية + دورة
    لو نهاية > طول(نص):
      نهاية = طول(نص)
    لكل ي في نطاق(بداية, نهاية):
      م = موقع(نص[ي])
      صفوف.append(م // 5 + 1)
      أعمدة.append(م % 5 + 1)
    أرقام = []
    لكل ر في صفوف:
      أرقام.append(ر)
    لكل ع في أعمدة:
      أرقام.append(ع)
    ي = 0
    طالما ي < طول(أرقام):
      ناتج = ناتج + مربع[(أرقام[ي] - 1) * 5 + أرقام[ي + 1] - 1]
      ي = ي + 2
    بداية = نهاية
  ارجع ناتج

تأكد_يساوي(شفر_بيفيد("HELLO", 5), "FNNVD", "كلمة واحدة")
تأكد_يساوي(شفر_بيفيد("HELLOWORLD", 5), "FNNVDXSBRD", "كلمتان بدورتين")
تأكد_يساوي(شفر_بيفيد("ABC", 3), "AAH", "كتلة قصيرة")
تأكد_يساوي(شفر_بيفيد("ABC", 10), "AAH", "دورة أكبر من النص")
