# مثال 2892 — الحد النوني بخطوة 23
# Nth term step 23
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2892-nth-term-arithmetic-sequence-step-23.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 23

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 26, "حالة 2")
تأكد_يساوي(ف(10), 210, "حالة 3")
تأكد_يساوي(ف(100), 2280, "حالة 4")
