# مثال 2220 — عدد الموجبات
# Count positive items
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2220-list-count-of-positive-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع2 = 0
  لكل ع في ق:
    لو ع > 0:
      ع2 = ع2 + 1
  ارجع ع2

تأكد_يساوي(ف([3, 1, 2]), 3, "حالة 1")
تأكد_يساوي(ف([5]), 1, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 6, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 3, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 6, "حالة 5")
