# مثال 1848 — متناظر مع تجاهل الرموز
# Palindrome ignoring non-alphanumeric
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1848-valid-palindrome-ignore-nonalnum.apl

# مؤشر من كل طرف
# نقارن بعد التحويل لحروف صغيرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متناظر(س):
  ي = 0
  ج = طول(س) - 1
  طالما ي < ج:
    لو (س[ي].isalpha() أو س[ي].isdigit()) == خطأ:
      ي = ي + 1
    والا_لو (س[ج].isalpha() أو س[ج].isdigit()) == خطأ:
      ج = ج - 1
    والا:
      لو س[ي].lower() != س[ج].lower():
        ارجع خطأ
      ي = ي + 1
      ج = ج - 1
  ارجع صواب

تأكد_يساوي(متناظر("A man, a plan, a canal: Panama"), صواب, "كلاسيكي")
تأكد_يساوي(متناظر("race a car"), خطأ, "ليس متناظراً")
تأكد_يساوي(متناظر(""), صواب, "فارغ")
