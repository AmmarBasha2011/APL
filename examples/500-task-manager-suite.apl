# مثال 500 — نظام إدارة مهام متكامل
# Complete task manager
# Demonstrates: أصناف وملفات وJSON وتقارير
#
# Run:  python apl.py examples/500-task-manager-suite.apl

صنف مدير_مهام:
    دالة_إنشاء(ذات, مسار):
        ذات.مسار = مسار
        ذات.مهام = []

    دالة ألحق(ذات, عنوان, أولوية):
        ذات.مهام.append({"عنوان": عنوان, "أولوية": أولوية, "منجزة": خطأ})

    دالة أنجز(ذات, رقم):
        ذات.مهام[رقم]["منجزة"] = صواب

    دالة احفظ(ذات):
        اكتب_ملف_جسون(ذات.مهام, ذات.مسار)

    دالة حمل(ذات):
        ذات.مهام = اقرأ_ملف_جسون(ذات.مسار)

    دالة تقرير(ذات):
        المتغير منجزة = 0
        لكل مهمة in ذات.مهام:
            لو مهمة["منجزة"]:
                منجزة = منجزة + 1
        اطبع "المهام:", طول(ذات.مهام), "- المنجزة:", منجزة

المتغير مدير = مدير_مهام("/tmp/apl-500.json")
مدير.ألحق("كتابة التقرير", "عالية")
مدير.ألحق("مراجعة الكود", "متوسطة")
مدير.ألحق("تحديث الموقع", "منخفضة")
مدير.أنجز(0)
مدير.احفظ()
مدير.حمل()
مدير.تقرير()
احذف_ملف("/tmp/apl-500.json")
