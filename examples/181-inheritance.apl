# مثال 181 — الوراثة وتعدد الأشكال
# Inheritance and polymorphism
# Demonstrates: صنف، وراثة، تجاوز الدوال
#
# Run:  python apl.py examples/181-inheritance.apl

صنف حيوان:
    دالة_إنشاء(ذات, اسم):
        ذات.اسم = اسم

    دالة صوت(ذات):
        ارجع "..."

    دالة صف(ذات):
        ارجع ذات.اسم + " يقول " + ذات.صوت()

صنف قطة(حيوان):
    دالة صوت(ذات):
        ارجع "مواء"

صنف كلب(حيوان):
    دالة صوت(ذات):
        ارجع "نباح"

صنف بقرة(حيوان):
    دالة صوت(ذات):
        ارجع "خوار"

المتغير حيوانات = [قطة("مشمش"), كلب("ركس"), بقرة("بقرة")]
لكل ح في حيوانات:
    اطبع ح.صف()
