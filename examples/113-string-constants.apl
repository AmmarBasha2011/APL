# مثال 113 — ثوابت النصوص وتصنيف الحروف
# String constants and character classification
# Demonstrates: حروف_انجليزية، أرقام_ثابتة، رموز_خاصة، في، طول
#
# Run:  python apl.py examples/113-string-constants.apl

اطبع "عدد الحروف الإنجليزية:", طول(حروف_انجليزية)
اطبع "الأرقام:", أرقام_ثابتة
اطبع "الرموز الخاصة:", رموز_خاصة

اطبع ""
المتغير نص = "APL2026lang!#"
المتغير حروف = 0
المتغير أرقام = 0
المتغير رموز = 0
لكل حرف في نص:
    لو حرف في حروف_انجليزية:
        حروف = حروف + 1
    الا لو حرف في أرقام_ثابتة:
        أرقام = أرقام + 1
    الا:
        رموز = رموز + 1
اطبع "النص:", نص
اطبع "حروف:", حروف, "، أرقام:", أرقام, "، رموز:", رموز
