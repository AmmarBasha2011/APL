# مثال 247 — ماكينة الحظ
# Slot machine
# Demonstrates: عشوائي، فحص التطابق، رصيد
#
# Run:  python apl.py examples/247-slot-machine.apl

بذرة(21)
المتغير رموز = ["🍒", "🍋", "⭐", "7"]
المتغير رصيد = 100

لكل جولة في نطاق(5):
    رصيد = رصيد - 10
    المتغير أ = عشوائي(رموز)
    المتغير ب = عشوائي(رموز)
    المتغير ج = عشوائي(رموز)
    لو أ == ب و ب == ج:
        رصيد = رصيد + 100
        اطبع أ, ب, ج, "- جائزة كبرى! +100"
    الا لو أ == ب أو ب == ج أو أ == ج:
        رصيد = رصيد + 20
        اطبع أ, ب, ج, "- زوج! +20"
    الا:
        اطبع أ, ب, ج, "- لا شيء"

اطبع "الرصيد النهائي:", رصيد
