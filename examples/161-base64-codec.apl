# مثال 161 — الترميز وفكه بقاعدة 64
# Base64 encode and decode
# Demonstrates: ترميز_قاعد64، فك_ترميز_قاعد64، ثنائي_إلى_نص
#
# Run:  python apl.py examples/161-base64-codec.apl

المتغير نص = "رسالة سرية بالعربية"
المتغير مشفر = ترميز_قاعد64(نص.encode())
اطبع "مشفر:", ثنائي_إلى_نص(مشفر)

المتغير مفكوك = فك_ترميز_قاعد64(مشفر)
اطبع "مفكوك:", ثنائي_إلى_نص(مفكوك)
اطبع "رجع زي ما كان؟", ثنائي_إلى_نص(مفكوك) == نص

اطبع "للروابط:", ثنائي_إلى_نص(ترميز_آمن_للروابط("a+b/c=?".encode()))
