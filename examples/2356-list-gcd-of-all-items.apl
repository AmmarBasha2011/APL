# مثال 2356 — القاسم المشترك الأكبر للقائمة
# GCD of list
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2356-list-gcd-of-all-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ق2(أ, ب):
  طالما ب != 0:
    أ, ب = ب, أ % ب
  ارجع أ

دالة ف(ق):
  غ = ق[0]
  لكل ع في ق:
    غ = ق2(غ, ع)
  ارجع غ

تأكد_يساوي(ف([12, 18]), 6, "حالة 1")
تأكد_يساوي(ف([7]), 7, "حالة 2")
تأكد_يساوي(ف([8, 12, 20]), 4, "حالة 3")
تأكد_يساوي(ف([9, 10]), 1, "حالة 4")
