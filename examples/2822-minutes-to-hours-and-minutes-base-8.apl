# مثال 2822 — تحويل وحدة بأساس 8
# Split by base 8
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2822-minutes-to-hours-and-minutes-base-8.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 8, ن % 8]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [7, 3], "حالة 2")
تأكد_يساوي(ف(60), [7, 4], "حالة 3")
تأكد_يساوي(ف(125), [15, 5], "حالة 4")
تأكد_يساوي(ف(1000), [125, 0], "حالة 5")
