# مثال 2545 — ملء الأصفار لعرض 4
# Zero pad to width 4
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2545-pad-number-with-zeros-to-width-4.apl

# # ندخل القيمة
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع نص(ن).zfill(4)

تأكد_يساوي(ف(7), "0007", "حالة 1")
تأكد_يساوي(ف(42), "0042", "حالة 2")
تأكد_يساوي(ف(123), "0123", "حالة 3")
تأكد_يساوي(ف(99999), "99999", "حالة 4")
