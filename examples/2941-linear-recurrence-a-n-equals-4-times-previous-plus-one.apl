# مثال 2941 — متتالية أ=4×السابق+1
# Recurrence times 4 plus one
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/2941-linear-recurrence-a-n-equals-4-times-previous-plus-one.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 1
  لكل ي في نطاق(ن):
    أ = أ * 4 + 1
  ارجع أ

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 5, "حالة 2")
تأكد_يساوي(ف(2), 21, "حالة 3")
تأكد_يساوي(ف(5), 1365, "حالة 4")
تأكد_يساوي(ف(8), 87381, "حالة 5")
