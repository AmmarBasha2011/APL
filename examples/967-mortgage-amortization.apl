# مثال 967 — إطفاء قرض عقاري
# Mortgage amortization
# Demonstrates: دفعة ثابتة بمعادلة القيمة
#
# Run:  python apl.py examples/967-mortgage-amortization.apl

# إطفاء قرض عقاري: الدفعة الشهرية الثابتة بمعادلة القيمة الحالية
# ثم جدول يوضح تناقص الفائدة ونمو سداد الأصل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة دفعة(أصل, فائدة, أشهر):
  معامل = (1 + فائدة) ** (0 - أشهر)
  ارجع (أصل * فائدة) / (1 - معامل)

د = دفعة(12000, 0.01, 12)
تأكد_يساوي(مقرب(د, 2), 1066.19, "الدفعة الشهرية")
تأكد_يساوي(مقرب(د * 12, 2), 12794.23, "إجمالي المدفوع")
تأكد_يساوي(مقرب((د * 12) - 12000, 2), 794.23, "إجمالي الفائدة")

رصيد = 12000
فائدة_أول = رصيد * 0.01
أصل_أول = د - فائدة_أول
رصيد = رصيد - أصل_أول
فائدة_ثان = رصيد * 0.01
تأكد_يساوي(مقرب(فائدة_أول, 2), 120, "فائدة الشهر الأول")
تأكد_يساوي(مقرب(أصل_أول, 2), 946.19, "أصل الشهر الأول")
تأكد_يساوي(فائدة_ثان < فائدة_أول, 1 == 1, "الفائدة تتناقص")
