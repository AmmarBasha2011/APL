# مثال 1089 — نمط جزئي مكرر
# Repeated substring pattern
# Demonstrates: تجربة الأطوال
#
# Run:  python apl.py examples/1089-repeated-substring.apl

# نجرب كل طول يقسم طول النص
# ونتحقق أن تكرار البادئة بهذا الطول يعيد النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مكرر(نص_):
  ن = طول(نص_)
  لكل ط في نطاق(1, (ن // 2) + 1):
    لو (ن % ط == 0) و ((نص_[:ط] * (ن // ط)) == نص_):
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(مكرر("abab"), صواب, "abab")
تأكد_يساوي(مكرر("aba"), خطأ, "aba")
تأكد_يساوي(مكرر("abcabcabcabc"), صواب, "أربع مرات")
تأكد_يساوي(مكرر("a"), خطأ, "حرف")
