# مثال 1637 — هل العدد مربع كامل
# Perfect square check by binary search
# Demonstrates: بحث ثنائي
#
# Run:  python apl.py examples/1637-perfect-square-binary-check.apl

# نبحث عن عدد مربعه يساوي المدخل
# نحصر البحث بين 1 والعدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مربع_كامل(ن):
  ي = 1
  ج = ن
  طالما ي <= ج:
    م = (ي + ج) // 2
    لو م * م == ن:
      ارجع صواب
    والا_لو م * م < ن:
      ي = م + 1
    والا:
      ج = م - 1
  ارجع خطأ

تأكد_يساوي(مربع_كامل(16), صواب, "ستة عشر")
تأكد_يساوي(مربع_كامل(14), خطأ, "أربعة عشر")
تأكد_يساوي(مربع_كامل(1), صواب, "واحد")
