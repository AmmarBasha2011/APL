# مثال 2908 — قيصر بإزاحة 23
# Caesar shift 23
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2908-caesar-shift-by-23-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 23) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "xyz", "حالة 1")
تأكد_يساوي(ف("xyz"), "uvw", "حالة 2")
تأكد_يساوي(ف("hello world"), "ebiil tloia", "حالة 3")
تأكد_يساوي(ف("a1"), "x1", "حالة 4")
