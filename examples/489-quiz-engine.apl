# مثال 489 — محرك اختبارات من ملف
# Quiz engine from file
# Demonstrates: أسئلة JSON وتصحيح
#
# Run:  python apl.py examples/489-quiz-engine.apl

المتغير أسئلة = [
    {"سؤال": "عاصمة مصر؟", "خيارات": ["القاهرة", "جدة"], "صحيح": 0},
    {"سؤال": "2 + 2 =؟", "خيارات": ["3", "4"], "صحيح": 1}
]
اكتب_ملف_جسون(أسئلة, "/tmp/apl-489.json")

المتغير محملة = اقرأ_ملف_جسون("/tmp/apl-489.json")
المتغير إجابات_مستخدم = [0, 1]
المتغير نتيجة = 0
لكل ي في نطاق(طول(محملة)):
    اطبع محملة[ي]["سؤال"]
    لو إجابات_مستخدم[ي] == محملة[ي]["صحيح"]:
        نتيجة = نتيجة + 1

اطبع "النتيجة:", نتيجة, "من", طول(محملة)
احذف_ملف("/tmp/apl-489.json")
