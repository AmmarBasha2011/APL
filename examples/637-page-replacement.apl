# مثال 637 — إحلال الصفحات
# Page replacement
# Demonstrates: FIFO، أمثل، أخطاء صفحات
#
# Run:  python apl.py examples/637-page-replacement.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# إحلال الصفحات: FIFO والأمثل (OPT)
# Demonstrates: طابور إحلال, إحلال أمثل بأبعد استخدام, مقارنة أخطاء الصفحات
# الأمثل نظري؛ FIFO واقعي بسيط

دالة أخطاء_fifo(مرجع, سعة):
  ذاكرة = []
  طابور = []
  أخطاء = 0
  لكل صفحة في مرجع:
    موجودة = صفحة في ذاكرة
    لو موجودة == خطأ:
      أخطاء = أخطاء + 1
      لو طول(ذاكرة) >= سعة:
        أقدم = طابور.pop(0)
        ذاكرة.remove(أقدم)
      ذاكرة.append(صفحة)
      طابور.append(صفحة)
  ارجع أخطاء

دالة أخطاء_أمثل(مرجع, سعة):
  ذاكرة = []
  أخطاء = 0
  لكل ي في نطاق(طول(مرجع)):
    صفحة = مرجع[ي]
    موجودة = صفحة في ذاكرة
    لو موجودة == خطأ:
      أخطاء = أخطاء + 1
      لو طول(ذاكرة) >= سعة:
        أبعد = -1
        ضحية = ذاكرة[0]
        لكل موجودة في ذاكرة:
          تالي = 10 ** 9
          لكل ج في نطاق(ي + 1, طول(مرجع)):
            لو مرجع[ج] == موجودة:
              تالي = ج
          لو تالي > أبعد:
            أبعد = تالي
            ضحية = موجودة
        ذاكرة.remove(ضحية)
      ذاكرة.append(صفحة)
  ارجع أخطاء

مرجع = [1, 2, 3, 4, 1, 2, 5, 1, 2, 3, 4, 5]
ف = أخطاء_fifo(مرجع, 3)
م = أخطاء_أمثل(مرجع, 3)
اطبع "أخطاء FIFO:", ف, " وأخطاء الأمثل:", م
تأكد_يساوي(ف, 9, "FIFO تسع أخطاء")
تأكد_يساوي(م, 7, "الأمثل سبع أخطاء")
تأكد_يساوي(م <= ف, صواب, "الأمثل لا يتجاوز FIFO")
