# مثال 24 — تحويل إلى أرقام رومانية
# Roman Numerals Converter
# Demonstrates: dicts, division/modulo, lists, algorithmic thinking
#
# Run:  python apl.py examples/24-roman-numerals.apl

دالة_إلى_روماني(رقم):
    جدول = [
        (1000, "M"), (900, "CM"), (500, "D"), (400, "CD"),
        (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
        (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")
    ]
    النتيجة = ""
    المتبقي = رقم
    لكل زوج في جدول:
        القيمة = زوج[0]
        الرمز = زوج[1]
        طالما المتبقي >= القيمة:
            النتيجة = النتيجة + الرمز
            المتبقي = المتبقي - القيمة
    ارجع النتيجة

اطبع "=== الأرقام الرومانية ==="
لكل رقم in [1, 4, 9, 14, 40, 90, 400, 1990, 2024, 3999]:
    اطبع f"  {رقم:>5} = {دالة_إلى_روماني(رقم)}"
