# مثال 2813 — السعر مع ضريبة 9 بالمئة
# Price with 9 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2813-price-with-9-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 9 // 100

تأكد_يساوي(ف(100), 109, "حالة 1")
تأكد_يساوي(ف(250), 272, "حالة 2")
تأكد_يساوي(ف(999), 1088, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
