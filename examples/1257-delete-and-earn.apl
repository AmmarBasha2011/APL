# مثال 1257 — احذف واكسب
# Delete and earn
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1257-delete-and-earn.apl

# نجمع نقاط كل قيمة
# ثم نحلها كمسألة سرقة بيوت متجاورة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اكسب(أ):
  لو طول(أ) == 0:
    ارجع 0
  اقصى = 0
  لكل س في أ:
    لو س > اقصى:
      اقصى = س
  نقاط = [0] * (اقصى + 1)
  لكل س في أ:
    نقاط[س] = نقاط[س] + س
  سابق = 0
  حالي = 0
  لكل ن في نقاط:
    جديد = أكبر(حالي, سابق + ن)
    سابق = حالي
    حالي = جديد
  ارجع حالي

تأكد_يساوي(اكسب([3,4,2]), 6, "مثال أول")
تأكد_يساوي(اكسب([2,2,3,3,3,4]), 9, "مثال ثان")
تأكد_يساوي(اكسب([1]), 1, "عنصر")
تأكد_يساوي(اكسب([]), 0, "فارغة")
