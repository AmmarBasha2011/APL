# مثال 52 — بناء ملف XML وتعديله وحفظه
# Building, Editing and Saving an XML File
# Demonstrates: عنصر_جديد, عنصر_فرعي_جديد, عين_خاصية, أضف_عنصر,
#               احذف_عنصر, انسخ_العنصر, احفظ_إكس_إم_إل, اقرأ_إكس_إم_إل,
#               شجرة_إكس_إم_إل, احسب_المسار, نسّق_إكس_إم_إل, رتّب_الشجرة
#
# Run:  python apl.py examples/52-xml-build.apl

المتغير المسار = "_apl_students.xml"

# ---------- 1) بناء الشجرة من الصفر ----------
اطبع "=== بناء شجرة XML ==="
المتغير الجذر = عنصر_جديد("طلاب")
عين_خاصية(الجذر, "الفصل", "الثالث الثانوي")

دالة أضف_طالب(اسم, الدرجة, الشعبة):
    المتغير سجل = عنصر_فرعي_جديد(الجذر, "طالب")
    سجل.عين_خاصية("اسم", اسم)
    سجل.عين_خاصية("الشعبة", الشعبة)
    المتغير د = عنصر_فرعي_جديد(سجل, "الدرجة")
    د.نص_العنصر = نص(الدرجة)
    ارجع سجل

أضف_طالب("أحمد", 92, "أ")
أضف_طالب("سارة", 98, "ب")
أضف_طالب("محمد", 74, "أ")
أضف_طالب("فاطمة", 88, "ج")

اطبع "عدد الطلاب: " + نص(عد_العناصر(الجذر, "طالب"))

# ---------- 2) الحفظ إلى ملف ----------
احفظ_إكس_إم_إل(الجذر, المسار)
اطبع "تم حفظ الملف: " + المسار
اطبع ""

# ---------- 3) القراءة من الملف ----------
اطبع "=== قراءة الملف مرة أخرى ==="
المتغير الشجرة = اقرأ_إكس_إم_إل(المسار)
المتغير الجذر2 = الشجرة.جذر_الشجرة()
اطبع "الجذر: " + الجذر2.اسم_العنصر + " | الفصل: " + اقرأ_خاصية(الجذر2, "الفصل")
اطبع ""

اطبع "--- تقرير الطلاب ---"
المتغير المجموع = 0
لكل طالب في الجذر2.كرر("طالب"):
    اسم = اقرأ_خاصية(طالب, "اسم")
    الشعبة = اقرأ_خاصية(طالب, "الشعبة")
    الدرجة = عشري(طالب.ابحث_نص("الدرجة"))
    المجموع = المجموع + الدرجة
    المسار_الداخلي = احسب_المسار(الجذر2, طالب)
    اطبع "  " + اسم + " (" + الشعبة + "): " + نص(الدرجة) + "  ←  " + المسار_الداخلي

اطبع ""
اطبع "المجموع: " + نص(المجموع)
اطبع "المتوسط: " + نص(مقرب(المجموع / عد_العناصر(الجذر2, "طالب"), 2))
اطبع ""

# ---------- 4) التعديل: نسخ، إضافة، حذف ----------
اطبع "=== تعديل البيانات ==="
المتغير الأول = الجذر2.ابحث_عنصر("طالب")
المتغير نسخة = انسخ_العنصر(الأول)
نسخة.عين_خاصية("اسم", "أحمد (نسخة)")
نسخة.عين_خاصية("الشعبة", "د")
نسخة.ابحث_عنصر("الدرجة").نص_العنصر = "60"
الجذر2.أضف_عنصر(نسخة)
اطبع "بعد إضافة نسخة: " + نص(عد_العناصر(الجذر2, "طالب")) + " طالباً"

المتغير الأخير = الجذر2.ابحث_الكل("طالب")
الجذر2.احذف_عنصر(الأخير[طول(الأخير) - 1])
اطبع "بعد حذف النسخة: " + نص(عد_العناصر(الجذر2, "طالب")) + " طالباً"

# تعديل درجة داخل الشجرة
لكل طالب في الجذر2.كرر("طالب"):
    لو اقرأ_خاصية(طالب, "اسم") == "محمد":
        طالب.ابحث_عنصر("الدرجة").نص_العنصر = "79"
        طالب.عين_خاصية("ملاحظة", "تم رفع الدرجة بدرجة المشاركة")
اطبع "تم تحديث درجة محمد إلى 79"

# ---------- 5) التنسيق والحفظ النهائي ----------
# نسّق_إكس_إم_إل تُرجع نصاً منسّقاً دون تعديل الشجرة الأصلية،
# أما رتّب_الشجرة فتُزيح الشجرة نفسها في مكانها.
اطبع ""
اطبع "--- الشجرة منسّقة بصرياً ---"
اطبع نسّق_إكس_إم_إل(الجذر2)

رتّب_الشجرة(الجذر2)
احفظ_إكس_إم_إل(الجذر2, المسار)
اطبع ""
اطبع "--- الملف بعد التعديل ---"
اطبع إكس_إم_إل_إلى_نص(الجذر2)

# ---------- 6) تنظيف ----------
احذف_ملف(المسار)
اطبع ""
اطبع "تم حذف الملف المؤقت."
