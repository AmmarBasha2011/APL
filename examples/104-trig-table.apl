# مثال 104 — جدول الدوال المثلثية
# Trigonometry table
# Demonstrates: جب، جتا، ظا، راديان، درجات، مقرب
#
# Run:  python apl.py examples/104-trig-table.apl

اطبع "الزاوية |   الجيب | جيب التمام |      الظل"
اطبع "-------+---------+------------+---------"
لكل درجة في [0, 30, 45, 60, 90]:
    المتغير زاوية = راديان(درجة)
    اطبع درجة, "  |", مقرب(جب(زاوية), 4), "|", مقرب(جتا(زاوية), 4), "|", مقرب(ظا(زاوية), 4)

اطبع ""
اطبع "راديان(180) =", راديان(180), "= ط"
اطبع "درجات(ط) =", درجات(ط)
اطبع "وتر(3, 4) =", وتر(3, 4)
اطبع "مسافة((0,0), (3,4)) =", مسافة([0, 0], [3, 4])
