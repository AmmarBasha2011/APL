# مثال 907 — النظام السالب الثنائي
# Negabinary
# Demonstrates: أساس ناقص اثنين
#
# Run:  python apl.py examples/907-negabinary.apl

# النظام السالب الثنائي: تمثيل الأعداد بالأساس -2
# كل عدد صحيح (موجباً أو سالباً) له تمثيل بلا إشارة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة إلى_سالب_ثنائي(ن):
  لو ن == 0:
    ارجع [0]
  أرقام = []
  م = ن
  طالما م != 0:
    باقي = م % -2
    م = م // -2
    لو باقي < 0:
      باقي = باقي + 2
      م = م + 1
    أرقام.ألحق(باقي)
  # الأرقام بالترتيب العكسي (الأقل أهمية أولاً) ثم نعكسها
  مقلوبة = []
  لكل i في نطاق(طول(أرقام)):
    مقلوبة.ألحق(أرقام[طول(أرقام) - 1 - i])
  ارجع مقلوبة

دالة من_سالب_ثنائي(أرقام):
  قيمة = 0
  أساس = 1
  لكل i في نطاق(طول(أرقام)):
    قيمة = قيمة + أرقام[طول(أرقام) - 1 - i] * أساس
    أساس = أساس * -2
  ارجع قيمة

س7 = إلى_سالب_ثنائي(7)
س9 = إلى_سالب_ثنائي(-9)
اطبع "7 بالسالب الثنائي:", س7
اطبع "-9 بالسالب الثنائي:", س9

# 7 = 16 - 8 + 0 + 2 - 1 = 11011 بالأساس -2
تأكد_يساوي(طول(س7), 5, "طول تمثيل 7")
تأكد_يساوي(س7[0], 1, "خانة أولى")

# سالب 9 = 1011: -8 + 0 + 2 - 1... تحقق بالفك
تأكد_يساوي(من_سالب_ثنائي(س7), 7, "فك 7")
تأكد_يساوي(من_سالب_ثنائي(س9), -9, "فك -9")

# طي وفك لمجال واسع
لكل ن في نطاق(-50, 51):
  تأكد_يساوي(من_سالب_ثنائي(إلى_سالب_ثنائي(ن)), ن, "طي وفك " + نص(ن))
