# مثال 3709 — الحد النوني بخطوة 49
# Nth term step 49
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3709-nth-term-arithmetic-sequence-step-49.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 49

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 52, "حالة 2")
تأكد_يساوي(ف(10), 444, "حالة 3")
تأكد_يساوي(ف(100), 4854, "حالة 4")
