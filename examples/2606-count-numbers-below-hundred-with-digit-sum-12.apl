# مثال 2606 — أعداد دون المئة مجموع أرقامها 12
# Numbers below 100 with digit sum 12
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2606-count-numbers-below-hundred-with-digit-sum-12.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(ن):
    م = 0
    لكل ر في نص(ي):
      م = م + int(ر)
    لو م == 12:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(10), 0, "حالة 1")
تأكد_يساوي(ف(50), 2, "حالة 2")
تأكد_يساوي(ف(100), 7, "حالة 3")
تأكد_يساوي(ف(200), 15, "حالة 4")
