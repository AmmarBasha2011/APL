# مثال 2948 — إزاحة يسار 1 مع قناع بايت
# Shift left 1 and mask byte
# Demonstrates: بتات
#
# Run:  python apl.py examples/2948-shift-left-by-1-then-mask-byte.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن << 1) & 255

تأكد_يساوي(ف(1), 2, "حالة 1")
تأكد_يساوي(ف(3), 6, "حالة 2")
تأكد_يساوي(ف(85), 170, "حالة 3")
تأكد_يساوي(ف(170), 84, "حالة 4")
تأكد_يساوي(ف(255), 254, "حالة 5")
