# مثال 3328 — الحد النوني بخطوة 37
# Nth term step 37
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3328-nth-term-arithmetic-sequence-step-37.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 37

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 40, "حالة 2")
تأكد_يساوي(ف(10), 336, "حالة 3")
تأكد_يساوي(ف(100), 3666, "حالة 4")
