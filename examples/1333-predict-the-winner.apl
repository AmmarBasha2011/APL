# مثال 1333 — توقع الفائز
# Predict the winner
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1333-predict-the-winner.apl

# نحسب أفضل فارق للاعب الحالي في كل مجال
# الفارق غير السالب يعني فوز الأول أو التعادل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة الأول_يفوز(أرقام):
  ن = طول(أرقام)
  ف = أرقام[:]
  لكل بعد في نطاق(1, ن):
    لكل ي في نطاق(0, ن - بعد):
      ف[ي] = أكبر(أرقام[ي] - ف[ي + 1], أرقام[ي + بعد] - ف[ي])
  ارجع ف[0] >= 0

تأكد_يساوي(الأول_يفوز([1,5,2]), خطأ, "يخسر")
تأكد_يساوي(الأول_يفوز([1,5,233,7]), صواب, "يفوز")
تأكد_يساوي(الأول_يفوز([2]), صواب, "رقم واحد")
