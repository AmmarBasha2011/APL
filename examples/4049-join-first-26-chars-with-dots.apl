# مثال 4049 — ربط أول 26 أحرف بنقاط
# Join first 26 chars with dots
# Demonstrates: نصوص
#
# Run:  python apl.py examples/4049-join-first-26-chars-with-dots.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ".".join(ن[:26])

تأكد_يساوي(ف("hello"), "h.e.l.l.o", "حالة 1")
تأكد_يساوي(ف("ab"), "a.b", "حالة 2")
تأكد_يساوي(ف("abcdefghijklmn"), "a.b.c.d.e.f.g.h.i.j.k.l.m.n", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
