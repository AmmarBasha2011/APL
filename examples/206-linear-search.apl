# مثال 206 — البحث الخطي وكل المواضع
# Linear search, all positions
# Demonstrates: المرور مع الفهرس، تجميع النتائج
#
# Run:  python apl.py examples/206-linear-search.apl

دالة ابحث_كل(قائمة, هدف):
    المتغير مواضع = []
    لكل ي في نطاق(طول(قائمة)):
        لو قائمة[ي] == هدف:
            مواضع.أضف(ي)
    ارجع مواضع

المتغير أرقام = [5, 3, 7, 3, 9, 3, 1]
اطبع "مواضع 3:", ابحث_كل(أرقام, 3)
اطبع "مواضع 9:", ابحث_كل(أرقام, 9)
اطبع "مواضع 100:", ابحث_كل(أرقام, 100)
