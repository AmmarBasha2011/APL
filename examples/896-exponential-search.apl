# مثال 896 — البحث الأسي
# Exponential search
# Demonstrates: تضاعف المدى ثم ثنائي
#
# Run:  python apl.py examples/896-exponential-search.apl

# البحث الأسي: تضاعف المدى 1,2,4,8... ثم ثنائي داخله
# مثالي للمصفوفات غير المحدودة الطول: O(log i) حيث i موضع الهدف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بحث_أسي(مصفوفة, هدف):
  لو مصفوفة[0] == هدف:
    ارجع 0
  ن = طول(مصفوفة)
  حد = 1
  طالما حد < ن و مصفوفة[حد] <= هدف:
    حد = حد * 2
  أدنى = حد // 2
  أعلى = حد
  لو أعلى > ن - 1:
    أعلى = ن - 1
  طالما أدنى <= أعلى:
    وسط = (أدنى + أعلى) // 2
    لو مصفوفة[وسط] == هدف:
      ارجع وسط
    لو مصفوفة[وسط] < هدف:
      أدنى = وسط + 1
    والا:
      أعلى = وسط - 1
  ارجع -1

مصفوفة = [1, 3, 4, 6, 7, 8, 10, 13, 14]
اطبع "موضع 7:", بحث_أسي(مصفوفة, 7)
اطبع "موضع 14:", بحث_أسي(مصفوفة, 14)
اطبع "موضع 5:", بحث_أسي(مصفوفة, 5)

تأكد_يساوي(بحث_أسي(مصفوفة, 1), 0, "الأول")
تأكد_يساوي(بحث_أسي(مصفوفة, 7), 4, "الهدف الأوسط")
تأكد_يساوي(بحث_أسي(مصفوفة, 14), 8, "الأخير")
تأكد_يساوي(بحث_أسي(مصفوفة, 5), -1, "غير موجود")
تأكد_يساوي(بحث_أسي(مصفوفة, 100), -1, "أكبر من الكل")

# يطابق البحث الخطي على كل القيم الموجودة
لكل i في نطاق(طول(مصفوفة)):
  تأكد_يساوي(بحث_أسي(مصفوفة, مصفوفة[i]), i, "موضع " + نص(مصفوفة[i]))
