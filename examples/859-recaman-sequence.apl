# مثال 859 — متتابعة ريكامان
# Recaman sequence
# Demonstrates: تراجع إن أمكن وإلا تقدم
#
# Run:  python apl.py examples/859-recaman-sequence.apl

# متتابعة ريكامان: تراجع خطوة ن للخلف إن أمكن وإلا تقدم
# أ₀=0 وأₙ = أₙ₋₁ - ن إن كان موجباً وجديداً، وإلا أₙ₋₁ + ن

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة موجود(قائمة, قيمة):
  لكل عنصر في قائمة:
    لو عنصر == قيمة:
      ارجع 1 == 1
  ارجع خطأ

دالة ريكامان(عدد_الحدود):
  ت = [0]
  لكل ن في نطاق(1, عدد_الحدود):
    مرشح = ت[طول(ت) - 1] - ن
    لو مرشح > 0 و ليس موجود(ت, مرشح):
      ت.ألحق(مرشح)
    والا:
      ت.ألحق(ت[طول(ت) - 1] + ن)
  ارجع ت

ت = ريكامان(21)
اطبع "أول 21 حداً:", ت

تأكد_يساوي(طول(ت), 21, "21 حداً")
تأكد_يساوي(ت[1], 1, "أ₁ = 1")
تأكد_يساوي(ت[4], 2, "أ₄ = 2 (أول تراجع)")
تأكد_يساوي(ت[10], 11, "أ₁₀ = 11")
تأكد_يساوي(ت[18], 43, "أ₁₈ = 43")
تأكد_يساوي(ت[19], 62, "أ₁₉ = 62")
تأكد_يساوي(ت[20], 42, "أ₂₀ = 42")
