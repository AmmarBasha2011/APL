# مثال 1833 — أول وآخر موضع للعنصر
# First and last position in sorted array
# Demonstrates: بحث
#
# Run:  python apl.py examples/1833-first-last-position-sorted.apl

# نبحث عن أول ظهور
# ثم عن آخر ظهور

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حد(ق, هدف, أول):
  يسار = 0
  يمين = طول(ق) - 1
  نتيجة = -1
  طالما يسار <= يمين:
    وسط = (يسار + يمين) // 2
    لو ق[وسط] == هدف:
      نتيجة = وسط
      لو أول:
        يمين = وسط - 1
      والا:
        يسار = وسط + 1
    والا_لو ق[وسط] < هدف:
      يسار = وسط + 1
    والا:
      يمين = وسط - 1
  ارجع نتيجة

دالة مدى(ق, هدف):
  ارجع [حد(ق, هدف, صواب), حد(ق, هدف, خطأ)]

تأكد_يساوي(مدى([5, 7, 7, 8, 8, 10], 8), [3, 4], "مكرر")
تأكد_يساوي(مدى([5, 7, 7, 8, 8, 10], 6), [-1, -1], "غائب")
تأكد_يساوي(مدى([2], 2), [0, 0], "واحد")
