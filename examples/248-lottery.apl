# مثال 248 — محاكاة يانصيب
# Lottery simulation
# Demonstrates: عشوائي_عينة، تطابق الأرقام
#
# Run:  python apl.py examples/248-lottery.apl

بذرة(13)
المتغير فائزة = عشوائي_عينة(نطاق(1, 50), 6)
المتغير تذكرتي = عشوائي_عينة(نطاق(1, 50), 6)

المتغير تطابق = 0
لكل رقم في تذكرتي:
    لو رقم في فائزة:
        تطابق = تطابق + 1

اطبع "الأرقام الفائزة:", مفرز(فائزة)
اطبع "تذكرتي:", مفرز(تذكرتي)
اطبع "عدد المتطابقة:", تطابق

حالة تطابق:
    قيمة 6:
        اطبع "الجائزة الكبرى!"
    قيمة 5:
        اطبع "جائزة كبيرة"
    قيمة 4:
        اطبع "جائزة متوسطة"
    افتراضي:
        اطبع "حظ أوفر المرة القادمة"
