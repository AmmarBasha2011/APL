# مثال 1344 — حساب القسمة
# Evaluate division queries
# Demonstrates: رسوم بيانية
#
# Run:  python apl.py examples/1344-evaluate-division.apl

# كل معادلة حافة موزونة في رسم بياني
# نبحث عن مسار ونضرب الأوزان

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة احسب_القسمة(معادلات, قيم, استعلامات):
  جيران = {}
  لكل ع في نطاق(طول(معادلات)):
    أ = معادلات[ع][0]
    ب = معادلات[ع][1]
    لو أ ليس في جيران:
      جيران[أ] = []
    لو ب ليس في جيران:
      جيران[ب] = []
    جيران[أ].ألحق([ب, قيم[ع]])
    جيران[ب].ألحق([أ, 1.0 / قيم[ع]])
  نتائج = []
  لكل س في استعلامات:
    لو (س[0] ليس في جيران) أو (س[1] ليس في جيران):
      نتائج.ألحق(-1.0)
    والا:
      مرئي = {}
      مرئي[س[0]] = صواب
      مكدس = [[س[0], 1.0]]
      جواب = -1.0
      طالما طول(مكدس) > 0:
        ن = مكدس.pop()
        لو ن[0] == س[1]:
          جواب = ن[1]
        لكل ج في جيران[ن[0]]:
          لو ج[0] ليس في مرئي:
            مرئي[ج[0]] = صواب
            مكدس.ألحق([ج[0], ن[1] * ج[1]])
      نتائج.ألحق(جواب)
  ارجع نتائج

م = [["a","b"],["b","c"]]
ق = [2.0, 3.0]
تأكد_يساوي(احسب_القسمة(م, ق, [["a","c"]]), [6.0], "نسبة غير مباشرة")
تأكد_يساوي(احسب_القسمة(م, ق, [["b","a"]]), [0.5], "نسبة معكوسة")
تأكد_يساوي(احسب_القسمة(م, ق, [["a","x"]]), [-1.0], "متغير مجهول")
