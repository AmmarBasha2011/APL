# مثال 44 — لعبة tic-tac-toe
# Tic-Tac-Toe Game
# Demonstrates: 2D lists, game logic, win detection
#
# Run:  python apl.py examples/44-tic-tac-toe.apl

دالة_لوحة_فارغة():
    صف = []
    رقم = 0
    طالما رقم < 3:
        صف.ألحق(["-", "-", "-"])
        رقم = رقم + 1
    ارجع صف

دالة_عرض(لوحة):
    لكل صف في لوحة:
        اطبع "  " + صف[0] + " | " + صف[1] + " | " + صف[2]
        اطبع "  ---|---|---|---"

دالة_فاز(لوحة, رمز):
    # صفوف
    لكل صف في لوحة:
        لو صف[0] == رمز و صف[1] == رمز و صف[2] == رمز:
            ارجع صواب
    # أعمدة
    رقم = 0
    طالما رقم < 3:
        لو لوحة[0][رقم] == رمز و لوحة[1][رقم] == رمز و لوحة[2][رقم] == رمز:
            ارجع صواب
        رقم = رقم + 1
    # أقطار
    لو لوحة[0][0] == رمز و لوحة[1][1] == رمز و لوحة[2][2] == رمز:
        ارجع صواب
    لو لوحة[0][2] == رمز و لوحة[1][1] == رمز و لوحة[2][0] == رمز:
        ارجع صواب
    ارجع خطأ

المتغير اللوحة = دالة_لوحة_فارغة()
اللوحة[1][1] = "X"
اللوحة[0][0] = "O"
اللوحة[2][2] = "X"
اللوحة[0][2] = "O"
اللوحة[1][2] = "X"

اطبع "=== tic-tac-toe ==="
اطبع ""
دالة_عرض(اللوحة)
اطبع ""
اطبع "فاز X؟ " + نص(دالة_فاز(اللوحة, "X"))
اطبع "فاز O؟ " + نص(دالة_فاز(اللوحة, "O"))
