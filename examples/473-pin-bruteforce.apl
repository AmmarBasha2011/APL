# مثال 473 — تجربة كسر رمز PIN
# PIN brute force demo
# Demonstrates: تعداد رموز من 4 خانات
#
# Run:  python apl.py examples/473-pin-bruteforce.apl

بذرة(7)
المتغير رمز = عشوائي_عدد(0, 9999)
المتغير محاولات = 0
المتغير تخمين = 0
طالما تخمين != رمز:
    تخمين = تخمين + 1
    محاولات = محاولات + 1

اطبع "الرمز:", رمز
اطبع "المحاولات:", محاولات
