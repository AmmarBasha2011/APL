# مثال 1283 — عدد أطول المتتاليات
# Number of longest increasing subsequences
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1283-lis-count.apl

# لكل موضع نخزن الطول وعدد الطرق
# وندمج الطرق عند تساوي الطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عدد_المتتاليات(أ):
  ن = طول(أ)
  لو ن == 0:
    ارجع 0
  طول_ = [1] * ن
  عدد_ = [1] * ن
  لكل ع في نطاق(ن):
    لكل ج في نطاق(ع):
      لو أ[ج] < أ[ع]:
        لو طول_[ج] + 1 > طول_[ع]:
          طول_[ع] = طول_[ج] + 1
          عدد_[ع] = عدد_[ج]
        والا_لو طول_[ج] + 1 == طول_[ع]:
          عدد_[ع] = عدد_[ع] + عدد_[ج]
  اقصى = 0
  لكل ل في طول_:
    لو ل > اقصى:
      اقصى = ل
  مج = 0
  لكل ع في نطاق(ن):
    لو طول_[ع] == اقصى:
      مج = مج + عدد_[ع]
  ارجع مج

تأكد_يساوي(عدد_المتتاليات([1,3,5,4,7]), 2, "مثال أول")
تأكد_يساوي(عدد_المتتاليات([2,2,2,2,2]), 5, "متساوية")
تأكد_يساوي(عدد_المتتاليات([1,2,4,3,5,4,7,2]), 3, "ثلاث")
