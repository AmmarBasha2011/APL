# مثال 449 — كسور رياضية
# Fraction arithmetic
# Demonstrates: جمع وضرب وتبسيط
#
# Run:  python apl.py examples/449-fractions-math.apl

دالة قاسم_مشترك(أ, ب):
    طالما ب != 0:
        المتغير بدل = ب
        ب = أ % ب
        أ = بدل
    ارجع أ

دالة بسط_كسر(بسط, مقام_عدد):
    المتغير ق = قاسم_مشترك(مطلق(بسط), مطلق(مقام_عدد))
    ارجع [بسط // ق, مقام_عدد // ق]

دالة اجمع_كسر(ب1, م1, ب2, م2):
    ارجع بسط_كسر(ب1 * م2 + ب2 * م1, م1 * م2)

دالة اضرب_كسر(ب1, م1, ب2, م2):
    ارجع بسط_كسر(ب1 * ب2, م1 * م2)

اطبع "1/2 + 1/3 =", اجمع_كسر(1, 2, 1, 3)
اطبع "2/3 * 3/4 =", اضرب_كسر(2, 3, 3, 4)
اطبع "تبسيط 10/15 =", بسط_كسر(10, 15)
