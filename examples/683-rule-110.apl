# مثال 683 — القاعدة 110
# Rule 110
# Demonstrates: أتمتة أولية، جدول قاعدة، أجيال
#
# Run:  python apl.py examples/683-rule-110.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الأتمتة الخلوية الأولية: القاعدة 110 (تuring-complete)
# Demonstrates: جدول قاعدة من رقم, تطور أجيال, حدود ميتة
# القاعدة 110: 111->0 110->1 101->1 100->0 011->1 010->1 001->1 000->0

دالة جيل(صف, عرض):
  جديد = []
  لكل ج في نطاق(عرض):
    يسار = 0
    لو ج > 0:
      يسار = صف[ج - 1]
    وسط = صف[ج]
    يمين = 0
    لو ج < عرض - 1:
      يمين = صف[ج + 1]
    قيمة = 4 * يسار + 2 * وسط + يمين
    لو قيمة == 0 أو قيمة == 4 أو قيمة == 7:
      جديد.append(0)
    والا:
      جديد.append(1)
  ارجع جديد

دالة نص(صف, عرض):
  س = ""
  لكل ج في نطاق(عرض):
    لو صف[ج] == 1:
      س = س + "#"
    والا:
      س = س + " "
  ارجع س

عرض = 21
صف = []
لكل ج في نطاق(عرض):
  صف.append(0)
صف[10] = 1
تأكد_يساوي(نص(صف, عرض), "          #          ", "الجيل صفر")
صف = جيل(صف, عرض)
تأكد_يساوي(نص(صف, عرض), "         ##          ", "الجيل الأول")
صف = جيل(صف, عرض)
تأكد_يساوي(نص(صف, عرض), "        ###          ", "الجيل الثاني")
صف = جيل(صف, عرض)
تأكد_يساوي(نص(صف, عرض), "       ## #          ", "الجيل الثالث")
لكل ي في نطاق(4):
  صف = جيل(صف, عرض)
اطبع "الجيل 7:", نص(صف, عرض)
مجموع = 0
لكل ج في نطاق(عرض):
  مجموع = مجموع + صف[ج]
تأكد_يساوي(مجموع, 6, "ست خلايا حية في الجيل السابع")
