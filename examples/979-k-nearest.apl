# مثال 979 — ك أقرب الجيران
# k-nearest neighbors
# Demonstrates: تصويت الأقربين بالمسافة
#
# Run:  python apl.py examples/979-k-nearest.apl

# ك أقرب الجيران: تصنيف نقطة بتصويت أقرب ك جاراً إليها
# المسافة الإقليدية المربعة تكفي للمقارنة دون جذر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

تدريب = [[1, 1], [2, 1], [1, 2], [10, 10], [11, 10], [10, 11]]
فئات = ["أ", "أ", "أ", "ب", "ب", "ب"]

دالة صنف(نقطة, ك):
  مسافات = []
  لكل i في نطاق(طول(تدريب)):
    ف_س = تدريب[i][0] - نقطة[0]
    ف_ص = تدريب[i][1] - نقطة[1]
    مسافات.ألحق([(ف_س * ف_س) + (ف_ص * ف_ص), فئات[i]])
  مرتبة = []
  لكل عنصر في مسافات:
    وضع = طول(مرتبة)
    لكل ف في نطاق(طول(مرتبة)):
      لو (عنصر[0] < مرتبة[ف][0]) و (وضع == طول(مرتبة)):
        وضع = ف
    مرتبة.ألحق(عنصر)
    لكل ج في نطاق(طول(مرتبة) - 1, وضع, -1):
      مرتبة[ج] = مرتبة[ج - 1]
    مرتبة[وضع] = عنصر
  أصوات_أ = 0
  أصوات_ب = 0
  لكل i في نطاق(ك):
    لو مرتبة[i][1] == "أ":
      أصوات_أ = أصوات_أ + 1
    والا:
      أصوات_ب = أصوات_ب + 1
  لو أصوات_أ > أصوات_ب:
    ارجع "أ"
  ارجع "ب"

تأكد_يساوي(صنف([1.5, 1.5], 3), "أ", "نقطة قرب عنقود أ")
تأكد_يساوي(صنف([10, 10.5], 3), "ب", "نقطة قرب عنقود ب")
تأكد_يساوي(صنف([0, 0], 1), "أ", "أقرب جار واحد")
