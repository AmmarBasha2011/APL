# مثال 976 — سرخس بارنسلي
# Barnsley fern
# Demonstrates: تحويلات أفينية مرجحة
#
# Run:  python apl.py examples/976-barnsley-fern.apl

# سرخس بارنسلي: نظام دوال متكررة بأربع تحويلات أفينية
# مولد حتمي يجعل النقاط قابلة للتحقق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

بذرة = [7]
دالة عشوائي100():
  بذرة[0] = (بذرة[0] * 1103515245 + 12345) % 2147483648
  ارجع بذرة[0] % 100

س = 0
ص = 0
نقاط = []
لكل i في نطاق(50):
  ر = عشوائي100()
  لو ر < 1:
    س_ج = 0
    ص_ج = 0.16 * ص
  والا_لو ر < 86:
    س_ج = (0.85 * س) + (0.04 * ص)
    ص_ج = (((0 - 0.04) * س) + (0.85 * ص)) + 1.6
  والا_لو ر < 93:
    س_ج = (0.2 * س) - (0.26 * ص)
    ص_ج = ((0.23 * س) + (0.22 * ص)) + 1.6
  والا:
    س_ج = ((0 - 0.15) * س) + (0.28 * ص)
    ص_ج = ((0.26 * س) + (0.24 * ص)) + 0.44
  س = س_ج
  ص = ص_ج
  نقاط.ألحق([س, ص])

تأكد_يساوي(طول(نقاط), 50, "عدد النقاط")
تأكد_يساوي(مقرب(نقاط[10][0], 4), 0.9831, "س النقطة العاشرة")
تأكد_يساوي(مقرب(نقاط[10][1], 4), 3.4579, "ص النقطة العاشرة")
تأكد_يساوي(مقرب(نقاط[25][0], 4), 1.2448, "س النقطة الخامسة والعشرين")
تأكد_يساوي(مقرب(نقاط[25][1], 4), 8.3391, "ص النقطة الخامسة والعشرين")
تأكد_يساوي(مقرب(نقاط[49][0], 4), 1.507, "س النقطة الأخيرة")
تأكد_يساوي(مقرب(نقاط[49][1], 4), 9.3219, "ص النقطة الأخيرة")
