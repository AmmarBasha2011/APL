# مثال 205 — ترتيب الكومة
# Heap sort
# Demonstrates: بناء الكومة، الغربلة للأسفل
#
# Run:  python apl.py examples/205-heap-sort.apl

دالة غربل(قائمة, ن_كومة, جذر):
    المتغير أكبر_موضع = جذر
    المتغير أيسر = 2 * جذر + 1
    المتغير أيمن = 2 * جذر + 2
    لو أيسر < ن_كومة و قائمة[أيسر] > قائمة[أكبر_موضع]:
        أكبر_موضع = أيسر
    لو أيمن < ن_كومة و قائمة[أيمن] > قائمة[أكبر_موضع]:
        أكبر_موضع = أيمن
    لو أكبر_موضع != جذر:
        المتغير مؤقت = قائمة[جذر]
        قائمة[جذر] = قائمة[أكبر_موضع]
        قائمة[أكبر_موضع] = مؤقت
        غربل(قائمة, ن_كومة, أكبر_موضع)

دالة ترتيب_كومة(قائمة):
    المتغير ن = طول(قائمة)
    لكل ي في نطاق(ن // 2):
        غربل(قائمة, ن, ن // 2 - 1 - ي)
    لكل ي في نطاق(1, ن):
        المتغير ك = ن - ي
        المتغير مؤقت = قائمة[0]
        قائمة[0] = قائمة[ك]
        قائمة[ك] = مؤقت
        غربل(قائمة, ك, 0)
    ارجع قائمة

المتغير أرقام = [12, 11, 13, 5, 6, 7]
اطبع "قبل:", أرقام
اطبع "بعد:", ترتيب_كومة(أرقام)
