# مثال 3555 — السعر مع ضريبة 26 بالمئة
# Price with 26 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3555-price-with-26-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 26 // 100

تأكد_يساوي(ف(100), 126, "حالة 1")
تأكد_يساوي(ف(250), 315, "حالة 2")
تأكد_يساوي(ف(999), 1258, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
