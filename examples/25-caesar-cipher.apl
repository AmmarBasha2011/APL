# مثال 25 — شيفرة قيصر
# Caesar Cipher
# Demonstrates: modular arithmetic, ord/chr, string building
#
# Run:  python apl.py examples/25-caesar-cipher.apl

دالة_شيفرة(النص, الإزاحة):
    النتيجة = ""
    لكل حرف في النص:
        إذا حرف >= "a" وحرف <= "z":
            رمز = (ترميز_حرف(حرف) - 97 + الإزاحة) % 26 + 97
            النتيجة = النتيجة + فك_ترميز_حرف(رمز)
        سإذا حرف >= "A" وحرف <= "Z":
            رمز = (ترميز_حرف(حرف) - 65 + الإزاحة) % 26 + 65
            النتيجة = النتيجة + فك_ترميز_حرف(رمز)
        والا:
            النتيجة = النتيجة + حرف
    ارجع النتيجة

المتغير الرسالة = "Hello, World! APL is amazing."
المتغير المفتاح = 3

اطبع "=== شيفرة قيصر ==="
اطبع "الأصلية : " + الرسالة
المتغير المشفر = دالة_شيفرة(الرسالة, المفتاح)
اطبع "المشفرة : " + المشفر
اطبع "مفكوكة : " + دالة_شيفرة(المشفر, 26 - المفتاح)
اطبع ""
اطبع "مفاتيح مختلفة على APL:"
لكل مفتاح في [1, 5, 13, 25]:
    اطبع "  shift " + نص(مفتاح) + ": " + دالة_شيفرة("APL", مفتاح)
