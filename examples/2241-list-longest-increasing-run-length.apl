# مثال 2241 — أطول تزايد متتال
# Longest increasing run
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2241-list-longest-increasing-run-length.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ك = 1
  ع = 1
  لكل ي في نطاق(1, طول(ق)):
    لو ق[ي] > ق[ي - 1]:
      ع = ع + 1
    والا:
      ع = 1
    لو ع > ك:
      ك = ع
  ارجع ك

تأكد_يساوي(ف([3, 1, 2]), 2, "حالة 1")
تأكد_يساوي(ف([5]), 1, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 6, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 3, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 2, "حالة 5")
