# مثال 2503 — عدد إلى الأساس 9
# Number to base 9
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2503-number-to-base-9-string-v2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع "0"
  خ = ""
  طالما ن > 0:
    خ = نص(ن % 9) + خ
    ن = ن // 9
  ارجع خ

تأكد_يساوي(ف(0), "0", "حالة 1")
تأكد_يساوي(ف(1), "1", "حالة 2")
تأكد_يساوي(ف(9), "10", "حالة 3")
تأكد_يساوي(ف(50), "55", "حالة 4")
تأكد_يساوي(ف(255), "313", "حالة 5")
