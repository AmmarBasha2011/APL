# مثال 459 — قصة بقوالب
# Mad libs story
# Demonstrates: تعبئة قالب بكلمات
#
# Run:  python apl.py examples/459-mad-libs.apl

دالة املأ(قالب, مقاطع):
    المتغير أجزاء = قالب.تقسيم("[x]")
    المتغير ناتج = أجزاء[0]
    لكل ي في نطاق(طول(مقاطع)):
        ناتج = ناتج + مقاطع[ي] + أجزاء[ي + 1]
    ارجع ناتج

المتغير قالب = "في يوم مشمس، ذهب [x] إلى [x] لشراء [x] وعاد سعيدا"
اطبع املأ(قالب, ["عمار", "السوق", "الخبز"])
