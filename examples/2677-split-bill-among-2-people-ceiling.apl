# مثال 2677 — تقسيم الفاتورة على 2
# Split bill among 2
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2677-split-bill-among-2-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 2 - 1) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 5, "حالة 2")
تأكد_يساوي(ف(100), 50, "حالة 3")
تأكد_يساوي(ف(101), 51, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
