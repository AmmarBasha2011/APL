# مثال 474 — مولد رموز تحقق
# OTP generator
# Demonstrates: رمز 6 خانات حتمي من بذرة
#
# Run:  python apl.py examples/474-otp-generator.apl

دالة رمز_تحقق(سر, عداد):
    المتغير قيمة = سر * 1103515245 + عداد * 12345
    قيمة = قيمة % 2147483648
    ارجع قيمة % 1000000

اطبع "الرمز الأول:", رمز_تحقق(987654, 1)
اطبع "الرمز الثاني:", رمز_تحقق(987654, 2)
اطبع "نفس العداد = نفس الرمز:", رمز_تحقق(987654, 1)
