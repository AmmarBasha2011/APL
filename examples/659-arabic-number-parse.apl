# مثال 659 — تحليل الأرقام العربية
# Arabic-Indic digit parsing
# Demonstrates: أرقام عربية، تحليل، إشارة
#
# Run:  python apl.py examples/659-arabic-number-parse.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحليل الأرقام العربية المشرقية
# Demonstrates: خريطة أرقام ٠١٢٣, رفض غير الصالح, إشارة سالبة
# يقرأ ١٢٣٤٥ كما يكتبها مستخدم عربي

دالة قيمة_رقم(حرف):
  أرقام = "٠١٢٣٤٥٦٧٨٩"
  لكل ي في نطاق(طول(أرقام)):
    لو أرقام[ي] == حرف:
      ارجع ي
  لاتيني = "0123456789"
  لكل ي في نطاق(طول(لاتيني)):
    لو لاتيني[ي] == حرف:
      ارجع ي
  ارجع 0 - 1

دالة حلل_رقم(نص):
  لو طول(نص) == 0:
    ارجع لا_شيء
  إشارة = 1
  بداية = 0
  لو نص[0] == "-":
    إشارة = 0 - 1
    بداية = 1
  لو بداية >= طول(نص):
    ارجع لا_شيء
  قيمة = 0
  لكل ي في نطاق(بداية, طول(نص)):
    ق = قيمة_رقم(نص[ي])
    لو ق == 0 - 1:
      ارجع لا_شيء
    قيمة = قيمة * 10 + ق
  ارجع إشارة * قيمة

تأكد_يساوي(حلل_رقم("٤٢"), 42, "رقمان عربيان")
تأكد_يساوي(حلل_رقم("١٢٣٤٥"), 12345, "خمسة أرقام")
تأكد_يساوي(حلل_رقم("3٤"), 34, "مزيج لاتيني عربي")
تأكد_يساوي(حلل_رقم("0"), 0, "صفر")
تأكد_يساوي(حلل_رقم("٠"), 0, "صفر عربي")
تأكد_يساوي(حلل_رقم("-١٧"), 0 - 17, "سالب")
تأكد_يساوي(حلل_رقم("أب"), لا_شيء, "حروف مرفوضة")
تأكد_يساوي(حلل_رقم(""), لا_شيء, "فارغ مرفوض")
تأكد_يساوي(حلل_رقم("-"), لا_شيء, "إشارة وحدها مرفوضة")
اطبع "انتهى التحليل"
