# مثال 3026 — مجموع قوى 26
# Sum of powers of 26
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3026-sum-of-powers-of-26-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 26 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 27, "حالة 2")
تأكد_يساوي(ف(3), 18279, "حالة 3")
تأكد_يساوي(ف(6), 321272407, "حالة 4")
تأكد_يساوي(ف(10), 146813779479511, "حالة 5")
