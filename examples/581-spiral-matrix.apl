# مثال 581 — مصفوفة حلزونية
# Spiral matrix
# Demonstrates: حلزوني، حدود، اتجاهات
#
# Run:  python apl.py examples/581-spiral-matrix.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# اجتياز حلزوني لمصفوفة
دالة حلزوني(مصفوفة):
    المتغير نتيجة = قائمة()
    المتغير أعلى = 0
    المتغير أسفل = طول(مصفوفة) - 1
    المتغير يسار = 0
    المتغير يمين = طول(مصفوفة[0]) - 1
    طالما أعلى <= أسفل و يسار <= يمين:
        لكل ك في نطاق(يسار, يمين + 1):
            نتيجة.أضف(مصفوفة[أعلى][ك])
        أعلى = أعلى + 1
        لكل ك في نطاق(أعلى, أسفل + 1):
            نتيجة.أضف(مصفوفة[ك][يمين])
        يمين = يمين - 1
        لو أعلى <= أسفل:
            لكل ك في نطاق(يمين, يسار - 1, -1):
                نتيجة.أضف(مصفوفة[أسفل][ك])
            أسفل = أسفل - 1
        لو يسار <= يمين:
            لكل ك في نطاق(أسفل, أعلى - 1, -1):
                نتيجة.أضف(مصفوفة[ك][يسار])
        يسار = يسار + 1
    ارجع نتيجة

تأكد_يساوي(حلزوني([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [1, 2, 3, 6, 9, 8, 7, 4, 5], "3×3")
تأكد_يساوي(حلزوني([[1, 2], [3, 4]]), [1, 2, 4, 3], "2×2")
