# مثال 388 — فهرس عناوين ماركداون
# Markdown headings index
# Demonstrates: استخراج المستويات والعناوين
#
# Run:  python apl.py examples/388-markdown-headings.apl

المتغير مستند = "# العنوان الرئيسي\nنص هنا\n## قسم أول\nنص\n## قسم ثاني\n### فرعي\n"

المتغير سطور = تقسيم(مستند, "\n")
لكل سطر في سطور:
    المتغير م = بحث_نمطي("^(#+) (.+)$", سطر)
    لو م != لا_شيء:
        المتغير مستوى = طول(م.group(1))
        المتغير مسافة = ""
        لكل _ في نطاق(مستوى - 1):
            مسافة = مسافة + "  "
        اطبع مسافة + "- " + م.group(2)
