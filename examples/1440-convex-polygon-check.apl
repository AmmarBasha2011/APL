# مثال 1440 — فحص المضلع المحدب
# Convex polygon check
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1440-convex-polygon-check.apl

# ندور على الرؤوس ونحسب الجداء التقاطعي
# كل الإشارات يجب أن تتفق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة محدب(ن):
  عدد = طول(ن)
  موجب = خطأ
  سالب = خطأ
  لكل ع في نطاق(عدد):
    أ = ن[ع]
    ب = ن[(ع + 1) % عدد]
    ج = ن[(ع + 2) % عدد]
    ض = (ب[0] - أ[0]) * (ج[1] - ب[1]) - (ب[1] - أ[1]) * (ج[0] - ب[0])
    لو ض > 0:
      موجب = صواب
    لو ض < 0:
      سالب = صواب
  مختلط = موجب و سالب
  ارجع مختلط == خطأ

تأكد_يساوي(محدب([[0,0],[0,5],[5,5],[5,0]]), صواب, "مربع")
تأكد_يساوي(محدب([[0,0],[0,10],[10,10],[10,0],[5,5]]), خطأ, "مقعر")
تأكد_يساوي(محدب([[0,0],[4,0],[0,3]]), صواب, "مثلث")
