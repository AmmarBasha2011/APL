# مثال 103 — القاسم المشترك والمضاعف المشترك ونظرية الأعداد
# GCD, LCM and number theory
# Demonstrates: قاسم_مشترك، مضاعف_مشترك، مضروب، توافيق، تباديل، جداء
#
# Run:  python apl.py examples/103-gcd-lcm.apl

اطبع "=== القاسم المشترك الأكبر ==="
اطبع "قاسم_مشترك(48, 36) =", قاسم_مشترك(48, 36)
اطبع "قاسم_مشترك(17, 5) =", قاسم_مشترك(17, 5)

اطبع ""
اطبع "=== المضاعف المشترك الأصغر ==="
اطبع "مضاعف_مشترك(4, 6) =", مضاعف_مشترك(4, 6)
اطبع "مضاعف_مشترك(21, 14) =", مضاعف_مشترك(21, 14)

اطبع ""
اطبع "=== المضروب والتوافيق والتباديل ==="
اطبع "مضروب(6) =", مضروب(6)
اطبع "توافيق(10, 3) =", توافيق(10, 3)
اطبع "تباديل(10, 3) =", تباديل(10, 3)
اطبع "جداء [1..5] =", جداء([1, 2, 3, 4, 5])
