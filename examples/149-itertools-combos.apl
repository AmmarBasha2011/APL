# مثال 149 — التوافيق والناتج الديكارتي
# Combinations and cartesian product
# Demonstrates: ناتج_ديكارتي، توافيق_مع_إرجاع، تراكم
#
# Run:  python apl.py examples/149-itertools-combos.apl

اطبع "ناتج ديكارتي:", قائمة(ناتج_ديكارتي([1, 2], ["أ", "ب"]))
اطبع "توافيق مع إرجاع:", قائمة(توافيق_مع_إرجاع([1, 2, 3], 2))
اطبع "تراكم (مجموع جارٍ):", قائمة(تراكم([1, 2, 3, 4, 5]))
اطبع "تراكم بالضرب:", قائمة(تراكم([1, 2, 3, 4], (أ, ب) => أ * ب))
