# مثال 369 — مجموع شجرة بالعودية
# Recursive tree sum
# Demonstrates: جمع على بنية متداخلة
#
# Run:  python apl.py examples/369-tree-sum.apl

دالة مجموع_شجرة(عقدة):
    لو عقدة == لا_شيء:
        ارجع 0
    ارجع عقدة["قيمة"] + مجموع_شجرة(عقدة["أيسر"]) + مجموع_شجرة(عقدة["أيمن"])

المتغير شجرة = {
    "قيمة": 10,
    "أيسر": {"قيمة": 5, "أيسر": لا_شيء, "أيمن": لا_شيء},
    "أيمن": {"قيمة": 20, "أيسر": لا_شيء, "أيمن": لا_شيء}
}
اطبع "مجموع الشجرة:", مجموع_شجرة(شجرة)
