# مثال 3906 — الحد النوني بخطوة 51
# Nth term step 51
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3906-nth-term-arithmetic-sequence-step-51.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 51

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 54, "حالة 2")
تأكد_يساوي(ف(10), 462, "حالة 3")
تأكد_يساوي(ف(100), 5052, "حالة 4")
