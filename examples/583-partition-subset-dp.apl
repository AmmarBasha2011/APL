# مثال 583 — تقسيم متساو
# Equal partition DP
# Demonstrates: تقسيم، مجموع نصف، برمجة ديناميكية
#
# Run:  python apl.py examples/583-partition-subset-dp.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تقسيم قائمة إلى مجموعتين متساويتي المجموع
دالة قابل_للتقسيم(ق):
    المتغير إجمالي = مجموع(ق)
    لو (إجمالي % 2) == 1:
        ارجع خطأ
    المتغير هدف = إجمالي // 2
    المتغير ممكن = [صواب] + [خطأ] * هدف
    لكل عدد في ق:
        لكل م في نطاق(هدف, عدد - 1, -1):
            لو ممكن[م - عدد]:
                ممكن[م] = صواب
    ارجع ممكن[هدف]

تأكد_يساوي(قابل_للتقسيم([1, 5, 11, 5]), صواب, "1+5+5=11")
تأكد_يساوي(قابل_للتقسيم([1, 2, 3, 5]), خطأ, "مستحيل")
تأكد_يساوي(قابل_للتقسيم([2, 2, 2, 2]), صواب, "متساوية")
