# مثال 661 — التقويم القبطي
# Coptic calendar
# Demonstrates: تقويم قبطي، سنة كبيسة، شهر صغير
#
# Run:  python apl.py examples/661-coptic-calendar.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# التقويم القبطي: سنوات وشهور وقبسي
# Demonstrates: سنة 365 يوما مع كبس كل أربع, 12 شهرا وشهر صغير, ذهاب وإياب
# تقويم ما زال يحدد الأعياد في مصر

حقبة = 1825029

دالة أول_سنة(سنة):
  ارجع حقبة + 365 * (سنة - 1) + سنة // 4

دالة كبيسة(سنة):
  ارجع سنة % 4 == 3

دالة إلى_قبطي(يوم_جولياني):
  سنة = (يوم_جولياني - حقبة) * 4 // 1461 + 1
  طالما أول_سنة(سنة) > يوم_جولياني:
    سنة = سنة - 1
  طالما أول_سنة(سنة + 1) <= يوم_جولياني:
    سنة = سنة + 1
  من_السنة = يوم_جولياني - أول_سنة(سنة)
  شهر = من_السنة // 30 + 1
  يوم = من_السنة % 30 + 1
  ارجع [سنة, شهر, يوم]

دالة من_قبطي(سنة, شهر, يوم):
  ارجع أول_سنة(سنة) + (شهر - 1) * 30 + (يوم - 1)

تأكد_يساوي(كبيسة(3), صواب, "السنة الثالثة كبيسة")
تأكد_يساوي(كبيسة(1739), صواب, "1739 كبيسة")
تأكد_يساوي(كبيسة(1740), خطأ, "1740 بسيطة")
تأكد_يساوي(أول_سنة(4) - أول_سنة(3), 366, "طول سنة كبيسة")
تأكد_يساوي(أول_سنة(2) - أول_سنة(1), 365, "طول سنة بسيطة")
لكل ي في [2450000, 2459000, 2460200, 2460300]:
  ق = إلى_قبطي(ي)
  تأكد_يساوي(من_قبطي(ق[0], ق[1], ق[2]), ي, "ذهاب وإياب")
ق = إلى_قبطي(2460200)
تأكد_يساوي(ق[1] >= 1 و ق[1] <= 13, صواب, "شهر صالح")
تأكد_يساوي(ق[2] >= 1 و ق[2] <= 30, صواب, "يوم صالح")
اطبع "2460200 قبطيا:", ق
