# مثال 4392 — مجموع المربعات من 26 إلى ن
# Sum of squares from 26
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4392-sum-of-squares-from-26-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(26, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(26), 676, "حالة 1")
تأكد_يساوي(ف(27), 1405, "حالة 2")
تأكد_يساوي(ف(36), 10681, "حالة 3")
تأكد_يساوي(ف(100), 332825, "حالة 4")
