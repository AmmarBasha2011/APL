# مثال 1631 — أقرب مجموع ثلاثي للهدف
# Three sum closest to target
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1631-three-sum-closest-target.apl

# نرتب ونثبت عنصراً ونحرك مؤشرين
# نحتفظ بالأقرب للهدف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أقرب_مجموع(أ, هدف):
  ق = []
  لكل ع في أ:
    ق.append(ع)
  ق.sort()
  أفضل = ق[0] + ق[1] + ق[2]
  لكل ع في نطاق(طول(ق) - 2):
    ي = ع + 1
    ج = طول(ق) - 1
    طالما ي < ج:
      م = ق[ع] + ق[ي] + ق[ج]
      فرق_جديد = م - هدف
      فرق_أفضل = أفضل - هدف
      لو فرق_جديد < 0:
        فرق_جديد = -فرق_جديد
      لو فرق_أفضل < 0:
        فرق_أفضل = -فرق_أفضل
      لو فرق_جديد < فرق_أفضل:
        أفضل = م
      لو م < هدف:
        ي = ي + 1
      والا_لو م > هدف:
        ج = ج - 1
      والا:
        ارجع م
  ارجع أفضل

تأكد_يساوي(أقرب_مجموع([-1, 2, 1, -4], 1), 2, "كلاسيكي")
تأكد_يساوي(أقرب_مجموع([0, 0, 0], 1), 0, "أصفار")
تأكد_يساوي(أقرب_مجموع([1, 1, 1, 0], 100), 3, "هدف بعيد")
