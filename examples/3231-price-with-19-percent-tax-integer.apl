# مثال 3231 — السعر مع ضريبة 19 بالمئة
# Price with 19 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3231-price-with-19-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 19 // 100

تأكد_يساوي(ف(100), 119, "حالة 1")
تأكد_يساوي(ف(250), 297, "حالة 2")
تأكد_يساوي(ف(999), 1188, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
