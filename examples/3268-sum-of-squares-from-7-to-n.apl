# مثال 3268 — مجموع المربعات من 7 إلى ن
# Sum of squares from 7
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3268-sum-of-squares-from-7-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(7, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(7), 49, "حالة 1")
تأكد_يساوي(ف(8), 113, "حالة 2")
تأكد_يساوي(ف(17), 1694, "حالة 3")
تأكد_يساوي(ف(100), 338259, "حالة 4")
