# مثال 4030 — آخر رقم من ن×21
# Last digit of n times 21
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4030-last-digit-of-n-times-21.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 21) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(7), 7, "حالة 3")
تأكد_يساوي(ف(12), 2, "حالة 4")
تأكد_يساوي(ف(99), 9, "حالة 5")
