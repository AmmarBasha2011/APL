# مثال 1932 — ضغط النص بالتكرار
# Run length encode text
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1932-run-length-encode-plain-text.apl

# نعد الحروف المتتالية المتشابهة
# نكتب الحرف ثم العدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اضغط(س):
  لو طول(س) == 0:
    ارجع ""
  خرج = ""
  حالي = س[0]
  عد = 1
  لكل ك في نطاق(1, طول(س)):
    لو س[ك] == حالي:
      عد = عد + 1
    والا:
      خرج = خرج + حالي + نص(عد)
      حالي = س[ك]
      عد = 1
  خرج = خرج + حالي + نص(عد)
  ارجع خرج

تأكد_يساوي(اضغط("aaabcc"), "a3b1c2", "مثال")
تأكد_يساوي(اضغط("z"), "z1", "حرف")
تأكد_يساوي(اضغط(""), "", "فارغ")
