# مثال 283 — توليد الأقواس المتوازنة
# Generate balanced parentheses
# Demonstrates: تراجع بشرطين
#
# Run:  python apl.py examples/283-generate-parentheses.apl

دالة ولد(حالية, مفتوحة, مغلقة, ن, نتيجة):
    لو طول(حالية) == 2 * ن:
        نتيجة.أضف(حالية)
        ارجع
    لو مفتوحة < ن:
        ولد(حالية + "(", مفتوحة + 1, مغلقة, ن, نتيجة)
    لو مغلقة < مفتوحة:
        ولد(حالية + ")", مفتوحة, مغلقة + 1, ن, نتيجة)

دالة أقواس(ن):
    المتغير نتيجة = []
    ولد("", 0, 0, ن, نتيجة)
    ارجع نتيجة

اطبع أقواس(3)
اطبع "عدد حلول 4:", طول(أقواس(4))
