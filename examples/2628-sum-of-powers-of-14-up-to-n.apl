# مثال 2628 — مجموع قوى 14
# Sum of powers of 14
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2628-sum-of-powers-of-14-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 14 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 15, "حالة 2")
تأكد_يساوي(ف(3), 2955, "حالة 3")
تأكد_يساوي(ف(6), 8108731, "حالة 4")
تأكد_يساوي(ف(10), 311505013051, "حالة 5")
