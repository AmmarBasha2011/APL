# مثال 4153 — السعر بعد خصم 43 بالمئة
# Price after 43 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4153-price-after-43-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 43 // 100

تأكد_يساوي(ف(100), 57, "حالة 1")
تأكد_يساوي(ف(250), 143, "حالة 2")
تأكد_يساوي(ف(999), 570, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
