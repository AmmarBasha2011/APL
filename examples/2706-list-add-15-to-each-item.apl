# مثال 2706 — إضافة 15 لكل عنصر
# Add 15 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2706-list-add-15-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 15]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [18, 16, 17], "حالة 1")
تأكد_يساوي(ف([5]), [20], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [16, 17, 18, 19, 20, 21], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [13, 15, 22, 22, 19], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [25, 35, 25, 45, 35, 25], "حالة 5")
