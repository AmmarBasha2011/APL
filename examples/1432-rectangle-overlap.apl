# مثال 1432 — تداخل مستطيلين
# Do two rectangles overlap
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1432-rectangle-overlap.apl

# التداخل يحتاج تقاطعاً في المحورين معاً
# اللمس عند الحافة لا يكفي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يتداخلان(أ, ب):
  افقي = (أصغر(أ[2], ب[2]) - أكبر(أ[0], ب[0])) > 0
  رأسي = (أصغر(أ[3], ب[3]) - أكبر(أ[1], ب[1])) > 0
  ارجع افقي و رأسي

تأكد_يساوي(يتداخلان([0,0,2,2], [1,1,3,3]), صواب, "تداخل")
تأكد_يساوي(يتداخلان([0,0,1,1], [1,0,2,1]), خطأ, "لمس")
تأكد_يساوي(يتداخلان([0,0,1,1], [2,2,3,3]), خطأ, "منفصلان")
