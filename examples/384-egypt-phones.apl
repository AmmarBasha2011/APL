# مثال 384 — أرقام الهواتف المصرية
# Egyptian phone numbers
# Demonstrates: نمط 01x
#
# Run:  python apl.py examples/384-egypt-phones.apl

دالة هاتف_مصري(رقم):
    المتغير م = بحث_نمطي("^01[0125][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$", رقم)
    ارجع م != لا_شيء

المتغير أرقام = ["01012345678", "01198765432", "01555512345", "0101234567", "012345678901", "02012345678"]
لكل ر in أرقام:
    اطبع ر, "->", هاتف_مصري(ر)
