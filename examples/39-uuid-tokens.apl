# مثال 39 — توليد معرفات فريدة
# UUID Tokens
# Demonstrates: uuid library, unique identifiers, deterministic UUIDs
#
# Run:  python apl.py examples/39-uuid-tokens.apl

اطبع "=== المعرفات الفريدة ==="
اطبع ""
اطبع "--- v4 عشوائي ---"
لكل رقم في [1, 2, 3]:
    اطبع "  " + معرف_نص(معرف_فريد())

اطبع ""
اطبع "--- خصائص المعرّف ---"
المتغير المعرف = معرف_فريد()
اطبع "  النص      : " + معرف_نص(المعرف)
اطبع "  النسخة    : " + نص(المعرف.نسخة_المعرف)
اطبع "  عدد المحارف: " + نص(طول(معرف_نص(المعرف)))

اطبع ""
اطبع "--- v3 ثابت (نفس الاسم يعطي نفس المعرّف) ---"
المتغير أ = معرف_بالاسم(نطاق_دنس, "apl.example.com")
المتغير ب = معرف_بالاسم(نطاق_دنس, "apl.example.com")
اطبع "  الأول  : " + معرف_نص(أ)
اطبع "  الثاني : " + معرف_نص(ب)
اطبع "  متساويان: " + نص(أ == ب)
