# مثال 2462 — مجموع مضاعفات 8 تحت حد
# Sum of multiples of 8 below limit
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2462-sum-multiples-of-8-below-limit-v2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(0, ن, 8):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(7), 0, "حالة 2")
تأكد_يساوي(ف(12), 8, "حالة 3")
تأكد_يساوي(ف(50), 168, "حالة 4")
تأكد_يساوي(ف(100), 624, "حالة 5")
