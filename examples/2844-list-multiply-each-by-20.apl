# مثال 2844 — ضرب كل عنصر في 20
# Multiply each item by 20
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2844-list-multiply-each-by-20.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 20]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [60, 20, 40], "حالة 1")
تأكد_يساوي(ف([5]), [100], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [20, 40, 60, 80, 100, 120], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-40, 0, 140, 140, 80], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [200, 400, 200, 600, 400, 200], "حالة 5")
