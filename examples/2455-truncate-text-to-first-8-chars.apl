# مثال 2455 — اقتطاع أول 8 أحرف
# First 8 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2455-truncate-text-to-first-8-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:8]

تأكد_يساوي(ف("hello world"), "hello wo", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abcdefgh", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
