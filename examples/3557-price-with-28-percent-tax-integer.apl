# مثال 3557 — السعر مع ضريبة 28 بالمئة
# Price with 28 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3557-price-with-28-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 28 // 100

تأكد_يساوي(ف(100), 128, "حالة 1")
تأكد_يساوي(ف(250), 320, "حالة 2")
تأكد_يساوي(ف(999), 1278, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
