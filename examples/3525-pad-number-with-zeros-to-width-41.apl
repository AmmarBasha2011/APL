# مثال 3525 — ملء الأصفار لعرض 41
# Zero pad to width 41
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3525-pad-number-with-zeros-to-width-41.apl

# # ندخل القيمة
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع نص(ن).zfill(41)

تأكد_يساوي(ف(7), "00000000000000000000000000000000000000007", "حالة 1")
تأكد_يساوي(ف(42), "00000000000000000000000000000000000000042", "حالة 2")
تأكد_يساوي(ف(123), "00000000000000000000000000000000000000123", "حالة 3")
تأكد_يساوي(ف(99999), "00000000000000000000000000000000000099999", "حالة 4")
