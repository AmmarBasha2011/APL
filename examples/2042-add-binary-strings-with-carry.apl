# مثال 2042 — جمع عددين ثنائيين نصيين
# Add binary strings
# Demonstrates: بتات
#
# Run:  python apl.py examples/2042-add-binary-strings-with-carry.apl

# # نمشي على الخانات من الأقل أهمية
# # ونكتب الناتج من اليمين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اجمع(ا, ب):
  ي = طول(ا) - 1
  ل = طول(ب) - 1
  حمل = 0
  خرج = ""
  طالما ي >= 0 أو ل >= 0 أو حمل > 0:
    م = حمل
    لو ي >= 0:
      م = م + int(ا[ي])
      ي = ي - 1
    لو ل >= 0:
      م = م + int(ب[ل])
      ل = ل - 1
    خرج = نص(م % 2) + خرج
    حمل = م // 2
  ارجع خرج

تأكد_يساوي(اجمع("11", "1"), "100", "حمل")
تأكد_يساوي(اجمع("1010", "1011"), "10101", "أربع خانات")
تأكد_يساوي(اجمع("0", "0"), "0", "صفران")
