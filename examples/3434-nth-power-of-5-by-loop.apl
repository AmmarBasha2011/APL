# مثال 3434 — قوة 5 بالحلقة
# Power of 5 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3434-nth-power-of-5-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 5
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 5, "حالة 2")
تأكد_يساوي(ف(3), 125, "حالة 3")
تأكد_يساوي(ف(6), 15625, "حالة 4")
تأكد_يساوي(ف(10), 9765625, "حالة 5")
