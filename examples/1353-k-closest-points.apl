# مثال 1353 — أقرب نقاط
# K closest points to origin
# Demonstrates: فرز
#
# Run:  python apl.py examples/1353-k-closest-points.apl

# نحسب مربع المسافة لكل نقطة
# نرتب ونأخذ أول ك

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقرب_نقاط(نقاط, ك):
  مع_مسافة = []
  لكل ن في نقاط:
    مع_مسافة.ألحق([ن[0] * ن[0] + ن[1] * ن[1], ن[0], ن[1]])
  مع_مسافة = مفرز(مع_مسافة)
  ناتج = []
  لكل ع في نطاق(ك):
    ناتج.ألحق([مع_مسافة[ع][1], مع_مسافة[ع][2]])
  ارجع ناتج

تأكد_يساوي(اقرب_نقاط([[1,3],[-2,2]], 1), [[-2,2]], "نقطة واحدة")
تأكد_يساوي(اقرب_نقاط([[3,3],[5,-1],[-2,4]], 2), [[3,3],[-2,4]], "نقطتان")
تأكد_يساوي(اقرب_نقاط([[0,1],[1,0]], 2), [[0,1],[1,0]], "كلهما")
