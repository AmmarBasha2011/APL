# مثال 3050 — مجموع الأعداد من 10 إلى ن
# Sum from 10 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3050-sum-of-integers-from-10-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(10, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(10), 10, "حالة 1")
تأكد_يساوي(ف(11), 21, "حالة 2")
تأكد_يساوي(ف(20), 165, "حالة 3")
تأكد_يساوي(ف(100), 5005, "حالة 4")
