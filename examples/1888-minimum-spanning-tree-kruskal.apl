# مثال 1888 — أقل شجرة ممتدة بكروسكال
# Kruskal minimum spanning tree weight
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1888-minimum-spanning-tree-kruskal.apl

# نرتب الحواف بالوزن
# نتجنب الدورات بالاتحاد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جذر(أب, ع):
  طالما أب[ع] != ع:
    ع = أب[ع]
  ارجع ع

دالة كروسكال(ن, حواف):
  مرتبة = []
  لكل ح في حواف:
    مرتبة.append([ح[2], ح[0], ح[1]])
  مرتبة.sort()
  أب = []
  لكل ك في نطاق(ن):
    أب.append(ك)
  مجموع = 0
  لكل ح في مرتبة:
    أ = جذر(أب, ح[1])
    ب = جذر(أب, ح[2])
    لو أ != ب:
      أب[أ] = ب
      مجموع = مجموع + ح[0]
  ارجع مجموع

ح = [[0, 1, 1], [1, 2, 2], [0, 2, 3], [2, 3, 4], [1, 3, 5]]
تأكد_يساوي(كروسكال(4, ح), 7, "أربع عقد")
تأكد_يساوي(كروسكال(2, [[0, 1, 9]]), 9, "حافة")
