# مثال 4351 — السعر بعد خصم 46 بالمئة
# Price after 46 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4351-price-after-46-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 46 // 100

تأكد_يساوي(ف(100), 54, "حالة 1")
تأكد_يساوي(ف(250), 135, "حالة 2")
تأكد_يساوي(ف(999), 540, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
