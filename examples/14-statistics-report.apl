# مثال 14 — تقرير إحصائي للدرجات
# Student Grades Statistics Report
# Demonstrates: statistics library, mean/median/mode/stdev, sorting
#
# Run:  python apl.py examples/14-statistics-report.apl

المتغير الدرجات = [85, 92, 78, 95, 88, 61, 74, 99, 82, 90, 55, 68]

اطبع "=== تقرير الدرجات ==="
اطبع "الدرجات: " + نص(الدرجات)
اطبع ""
اطبع "عدد الطلاب: " + نص(طول(الدرجات))
اطبع "المتوسط: " + نص(مقرب(متوسط(الدرجات), 2))
اطبع "الوسيط: " + نص(وسيط(الدرجات))
اطبع "المنوال: " + نص(منوال(الدرجات))
اطبع "انحراف معياري: " + نص(مقرب(انحراف_معياري(الدرجات), 2))
اطبع ""
اطبع "--- التقديرات ---"
لكل درجة في الدرجات:
    إذا درجة >= 90:
        اطبع "  " + نص(درجة) + ": ممتاز"
    سإذا درجة >= 80:
        اطبع "  " + نص(درجة) + ": جيد جداً"
    سإذا درجة >= 70:
        اطبع "  " + نص(درجة) + ": جيد"
    سإذا درجة >= 60:
        اطبع "  " + نص(درجة) + ": مقبول"
    والا:
        اطبع "  " + نص(درجة) + ": راسب"
اطبع ""
اطبع "--- مرتب تنازلياً ---"
اطبع نص(مفرز(الدرجات, معكوس = صواب))
