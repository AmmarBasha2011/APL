# مثال 3288 — إضافة 37 لكل عنصر
# Add 37 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3288-list-add-37-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 37]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [40, 38, 39], "حالة 1")
تأكد_يساوي(ف([5]), [42], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [38, 39, 40, 41, 42, 43], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [35, 37, 44, 44, 41], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [47, 57, 47, 67, 57, 47], "حالة 5")
