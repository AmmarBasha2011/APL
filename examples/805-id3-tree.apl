# مثال 805 — شجرة قرار ID3
# ID3 decision tree
# Demonstrates: إنتروبيا، كسب معلومات
#
# Run:  python apl.py examples/805-id3-tree.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شجرة قرار ID3: إنتروبيا وكسب معلومات لاختيار أفضل سمة
# Demonstrates: إنتروبيا شانون, كسب المعلومات, تقسيم عودي بسيط

صفوف = [["مشمس", "عالية", "لا"], ["مشمس", "عالية", "لا"], ["غائم", "عالية", "نعم"], ["ممطر", "عادية", "نعم"], ["ممطر", "عادية", "نعم"], ["ممطر", "عالية", "لا"], ["غائم", "عالية", "نعم"], ["مشمس", "عادية", "نعم"]]

دالة إنتروبيا(صفوف):
  ن = طول(صفوف)
  نعم = 0
  لكل صف في صفوف:
    لو صف[2] == "نعم":
      نعم = نعم + 1
  لو نعم == 0 أو نعم == ن:
    ارجع 0.0
  ح1 = نعم / ن
  ح2 = (ن - نعم) / ن
  لوغ2 = لوغاريتم(2.0)
  ارجع 0 - ح1 * لوغاريتم(ح1) / لوغ2 - ح2 * لوغاريتم(ح2) / لوغ2

دالة كسب(صفوف, عمود):
  أساس = إنتروبيا(صفوف)
  ن = طول(صفوف)
  قيم = []
  لكل صف في صفوف:
    لو (صف[عمود] في قيم) == خطأ:
      قيم.append(صف[عمود])
  باقي = 0.0
  لكل قيمة في قيم:
    فرعي = []
    لكل صف في صفوف:
      لو صف[عمود] == قيمة:
        فرعي.append(صف)
    باقي = باقي + (طول(فرعي) / ن) * إنتروبيا(فرعي)
  ارجع أساس - باقي

دالة أغلبية(صفوف):
  نعم = 0
  لكل صف في صفوف:
    لو صف[2] == "نعم":
      نعم = نعم + 1
  لو نعم * 2 > طول(صفوف):
    ارجع "نعم"
  ارجع "لا"

تأكد_يساوي(مقرب(إنتروبيا(صفوف), 4), 0.9544, "إنتروبيا الكل")
تأكد_يساوي(مقرب(كسب(صفوف, 0), 4), 0.2657, "كسب المظهر")
تأكد_يساوي(مقرب(كسب(صفوف, 1), 4), 0.3476, "كسب الرطوبة")
تأكد_يساوي(كسب(صفوف, 1) > كسب(صفوف, 0) == خطأ, خطأ, "الرطوبة جذر أفضل")
عالية = []
عادية = []
لكل صف في صفوف:
  لو صف[1] == "عالية":
    عالية.append(صف)
  والا:
    عادية.append(صف)
تأكد_يساوي(أغلبية(عالية), "لا", "رطوبة عالية تعني لا")
تأكد_يساوي(أغلبية(عادية), "نعم", "رطوبة عادية تعني نعم")
