# مثال 1230 — عدد قبيح فائق
# Super ugly number
# Demonstrates: مؤشرات متعددة
#
# Run:  python apl.py examples/1230-super-ugly.apl

# لكل أولي مؤشر في القائمة المبنية
# نأخذ الأصغر ونحرك كل المؤشرات التي أنتجته

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قبيح_فائق(ن, اوليات):
  أ = [1]
  مؤشرات = [0] * طول(اوليات)
  طالما طول(أ) < ن:
    مرشحون = []
    لكل ع في نطاق(طول(اوليات)):
      مرشحون.ألحق(أ[مؤشرات[ع]] * اوليات[ع])
    ت = مرشحون[0]
    لكل م في مرشحون:
      لو م < ت:
        ت = م
    أ.ألحق(ت)
    لكل ع في نطاق(طول(اوليات)):
      لو مرشحون[ع] == ت:
        مؤشرات[ع] = مؤشرات[ع] + 1
  ارجع أ[ن - 1]

تأكد_يساوي(قبيح_فائق(12, [2,7,13,19]), 32, "مثال أول")
تأكد_يساوي(قبيح_فائق(1, [2,3,5]), 1, "الأول")
تأكد_يساوي(قبيح_فائق(10, [2,3,5]), 12, "مثل القبيح")
