# مثال 946 — الجذر البدائي
# Primitive root
# Demonstrates: قوى تغطي الزمرة
#
# Run:  python apl.py examples/946-primitive-root.apl

# الجذر البدائي: مولد الزمرة الدائرية مودولو أولي
# ج هو جذر بدائي إن كانت قواه تغطي كل غير الأصفار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة(أساس, أس, مقام):
  ناتج = 1
  ب = أساس % مقام
  ه = أس
  طالما ه > 0:
    لو ه % 2 == 1:
      ناتج = (ناتج * ب) % مقام
    ب = (ب * ب) % مقام
    ه = ه // 2
  ارجع ناتج

دالة جذر_بدائي(أولي):
  فاي = أولي - 1
  # عوامل فاي الأولية
  عوامل = []
  م = فاي
  د = 2
  طالما د * د <= م:
    طالما م % د == 0:
      لو (طول(عوامل) == 0) أو (عوامل[طول(عوامل) - 1] != د):
        عوامل.ألحق(د)
      م = م // د
    د = د + 1
  لو م > 1:
    لو (طول(عوامل) == 0) أو (عوامل[طول(عوامل) - 1] != م):
      عوامل.ألحق(م)
  # أول ج يحقق ج^(في/ق) != 1 لكل ق
  لكل ج في نطاق(2, أولي):
    صالح = 1
    لكل ق في عوامل:
      لو قوة(ج, فاي // ق, أولي) == 1:
        صالح = 0
    لو صالح == 1:
      ارجع ج
  ارجع -1

اطبع "جذر بدائي لـ 7:", جذر_بدائي(7)
اطبع "جذر بدائي لـ 23:", جذر_بدائي(23)
اطبع "جذر بدائي لـ 41:", جذر_بدائي(41)

تأكد_يساوي(جذر_بدائي(7), 3, "الجذر البدائي لسبعة")
تأكد_يساوي(جذر_بدائي(23), 5, "الجذر البدائي لـ 23")
تأكد_يساوي(جذر_بدائي(41), 6, "الجذر البدائي لـ 41")

# التحقق: قوى 3 مودولو 7 تغطي 1..6 كلها
مشاهد = [0, 0, 0, 0, 0, 0, 0]
قوة_جارية = 1
لكل i في نطاق(6):
  قوة_جارية = (قوة_جارية * 3) % 7
  مشاهد[قوة_جارية] = 1
مجموع = 0
لكل i في نطاق(1, 7):
  مجموع = مجموع + مشاهد[i]
تأكد_يساوي(مجموع, 6, "القوى تغطي الكل")
