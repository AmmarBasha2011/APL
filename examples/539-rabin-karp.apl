# مثال 539 — بحث رابين-كارب
# Rabin-Karp search
# Demonstrates: تجزئة دوارة، مطابقة أنماط
#
# Run:  python apl.py examples/539-rabin-karp.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# بحث رابين-كارب بالتجزئة الدوارة
دالة بحث_رابين(نص, نمط):
    المتغير أساس = 256
    المتغير معيار = 101
    المتغير ط = طول(نمط)
    المتغير تجزئة_نمط = 0
    المتغير تجزئة_نافذة = 0
    المتغير عالي = 1
    لكل i في نطاق(ط - 1):
        عالي = (عالي * أساس) % معيار
    لكل i في نطاق(ط):
        تجزئة_نمط = (أساس * تجزئة_نمط + ترميز_حرف(نمط[i])) % معيار
        تجزئة_نافذة = (أساس * تجزئة_نافذة + ترميز_حرف(نص[i])) % معيار
    لكل i في نطاق(طول(نص) - ط + 1):
        لو تجزئة_نمط == تجزئة_نافذة:
            لو نص[i:i+ط] == نمط:
                ارجع i
        لو i < طول(نص) - ط:
            تجزئة_نافذة = (أساس * (تجزئة_نافذة - ترميز_حرف(نص[i]) * عالي) + ترميز_حرف(نص[i + ط])) % معيار
            لو تجزئة_نافذة < 0:
                تجزئة_نافذة = تجزئة_نافذة + معيار
    ارجع -1

تأكد_يساوي(بحث_رابين("abxabcabcaby", "abcaby"), 6, "رابين-كارب: موجود")
تأكد_يساوي(بحث_رابين("aaaaab", "aab"), 3, "رابين-كارب: تكرارات")
تأكد_يساوي(بحث_رابين("hello", "zz"), -1, "رابين-كارب: غائب")
