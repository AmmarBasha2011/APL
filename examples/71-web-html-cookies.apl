# مثال 71 — HTML وملفات تعريف الارتباط (مكتبة web)
# HTML escaping/parsing and cookies (html / http.cookies)
#
# Run:  python apl.py examples/71-web-html-cookies.apl

اطبع "=== تهريب HTML ==="
المتغير نص_أصلي = "<b>مرحباً</b> & 'السلام'"
اطبع "الأصلي:", نص_أصلي
اطبع "مهرب:", اهرب_من_HTML(نص_أصلي)
اطبع "مفكوك:", فكّ_هروب_HTML("&lt;b&gt;مرحباً&lt;/b&gt;")

اطبع ""
اطبع "=== محلل HTML ==="
المتغير محلل = محلل_HTML()
المتغير نص_HTML = "<html><body><h1>عنوان</h1><p>فقرة</p></body></html>"
محلل.HTML_محلل_غذّ(نص_HTML)

اطبع ""
اطبع "=== ملف تعريف ارتباط بسيط ==="
المتغير ملف = ملف_تعريف_بسيط()
ملف.بسيط_ملف_تعريف_حمّل("name=ahmed; city=cairo")
اطبع "الإخراج:", ملف.بسيط_ملف_تعريف_إخراج()

اطبع ""
اطبع "=== قراءة القيم ==="
اطبع "الاسم:", ملف["name"].قيمة
اطبع "المدينة:", ملف["city"].قيمة
