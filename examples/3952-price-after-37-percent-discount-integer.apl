# مثال 3952 — السعر بعد خصم 37 بالمئة
# Price after 37 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3952-price-after-37-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 37 // 100

تأكد_يساوي(ف(100), 63, "حالة 1")
تأكد_يساوي(ف(250), 158, "حالة 2")
تأكد_يساوي(ف(999), 630, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
