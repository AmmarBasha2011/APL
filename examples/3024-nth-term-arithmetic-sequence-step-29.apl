# مثال 3024 — الحد النوني بخطوة 29
# Nth term step 29
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3024-nth-term-arithmetic-sequence-step-29.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 29

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 32, "حالة 2")
تأكد_يساوي(ف(10), 264, "حالة 3")
تأكد_يساوي(ف(100), 2874, "حالة 4")
