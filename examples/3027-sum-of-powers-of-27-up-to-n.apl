# مثال 3027 — مجموع قوى 27
# Sum of powers of 27
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3027-sum-of-powers-of-27-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 27 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 28, "حالة 2")
تأكد_يساوي(ف(3), 20440, "حالة 3")
تأكد_يساوي(ف(6), 402321277, "حالة 4")
تأكد_يساوي(ف(10), 213810021790597, "حالة 5")
