# مثال 1360 — عدد الجزر
# Number of islands
# Demonstrates: بحث بالعمق
#
# Run:  python apl.py examples/1360-number-of-islands.apl

# نمشي بالعمق من كل أرض جديدة
# ونعلم كل ما نصل إليه كمزور

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عد_الجزر(ش):
  ر_ = طول(ش)
  ك_ = طول(ش[0])
  مرئي = []
  لكل ع في نطاق(ر_):
    مرئي.ألحق([خطأ] * ك_)
  عدد = 0
  لكل ص في نطاق(ر_):
    لكل ج في نطاق(ك_):
      لو (ش[ص][ج] == 1) و (ليس مرئي[ص][ج]):
        عدد = عدد + 1
        مرئي[ص][ج] = صواب
        مكدس = [[ص, ج]]
        طالما طول(مكدس) > 0:
          ن = مكدس.pop()
          لكل د في [[1,0],[-1,0],[0,1],[0,-1]]:
            ر = ن[0] + د[0]
            ك = ن[1] + د[1]
            لو (ر >= 0) و (ر < ر_) و (ك >= 0) و (ك < ك_):
              لو (ش[ر][ك] == 1) و (ليس مرئي[ر][ك]):
                مرئي[ر][ك] = صواب
                مكدس.ألحق([ر, ك])
  ارجع عدد

تأكد_يساوي(عد_الجزر([[1,1,0],[0,1,0],[0,0,1]]), 2, "جزيرتان")
تأكد_يساوي(عد_الجزر([[1,0,1],[0,1,0],[1,0,1]]), 5, "خمس جزر")
تأكد_يساوي(عد_الجزر([[0]]), 0, "ماء")
