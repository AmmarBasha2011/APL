# مثال 2272 — مجموع مضاعفات 3 أو 5
# Sum multiples of 3 or 5
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2272-sum-of-integers-divisible-by-three-or-five.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن):
    لو ي % 3 == 0 أو ي % 5 == 0:
      م = م + ي
  ارجع م

تأكد_يساوي(ف(10), 23, "حالة 1")
تأكد_يساوي(ف(16), 60, "حالة 2")
تأكد_يساوي(ف(100), 2318, "حالة 3")
تأكد_يساوي(ف(1000), 233168, "حالة 4")
