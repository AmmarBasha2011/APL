# مثال 3465 — إضافة 41 لكل عنصر
# Add 41 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3465-list-add-41-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 41]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [44, 42, 43], "حالة 1")
تأكد_يساوي(ف([5]), [46], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [42, 43, 44, 45, 46, 47], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [39, 41, 48, 48, 45], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [51, 61, 51, 71, 61, 51], "حالة 5")
