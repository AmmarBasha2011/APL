# مثال 198 — قائمة مهام محفوظة في ملف JSON
# JSON-backed todo list
# Demonstrates: اكتب_ملف_جسون، اقرأ_ملف_جسون، إدارة حالة
#
# Run:  python apl.py examples/198-todo-json.apl

المتغير مسار = "/tmp/apl_todo_198.json"

المتغير مهام = []
مهام.أضف({"عنوان": "شراء حليب", "منجزة": خطأ})
مهام.أضف({"عنوان": "مراجعة الكود", "منجزة": صواب})
مهام.أضف({"عنوان": "كتابة التقرير", "منجزة": خطأ})

اكتب_ملف_جسون(مهام, مسار)
اطبع "حُفظت", طول(مهام), "مهام."

المتغير محملة = اقرأ_ملف_جسون(مسار)
المتغير متبقية = 0
لكل م في محملة:
    لو م["منجزة"]:
        اطبع "[x]", م["عنوان"]
    الا:
        اطبع "[ ]", م["عنوان"]
        متبقية = متبقية + 1

اطبع "المتبقي:", متبقية, "مهمة"
احذف_ملف(مسار)
