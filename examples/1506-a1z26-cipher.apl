# مثال 1506 — تشفير أرقام الحروف
# A1Z26 letter number cipher
# Demonstrates: تشفير
#
# Run:  python apl.py examples/1506-a1z26-cipher.apl

# a هي 1 وz هي 26
# نفصل الأرقام بشرطة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة الى_أرقام(نص_):
  أبجدية = "abcdefghijklmnopqrstuvwxyz"
  أجزاء = []
  لكل ح في نص_:
    موضع = أبجدية.find(ح)
    لو موضع >= 0:
      أجزاء.append(نص(موضع + 1))
  ارجع "-".join(أجزاء)

دالة الى_حروف(نص_):
  أبجدية = "abcdefghijklmnopqrstuvwxyz"
  ناتج = ""
  لكل ج في نص_.split("-"):
    ناتج = ناتج + أبجدية[صحيح(ج) - 1]
  ارجع ناتج

تأكد_يساوي(الى_أرقام("abc"), "1-2-3", "ثلاثة")
تأكد_يساوي(الى_أرقام("zip"), "26-9-16", "كلمة")
تأكد_يساوي(الى_حروف("8-9"), "hi", "فك")
