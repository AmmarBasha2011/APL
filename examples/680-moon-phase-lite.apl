# مثال 680 — طور القمر التقريبي
# Moon phase lite
# Demonstrates: شهر اقتراني، يوم جولياني، أطوار
#
# Run:  python apl.py examples/680-moon-phase-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# طور القمر التقريبي
# Demonstrates: شهر اقتراني, يوم جولياني, أطوار مسماة
# يعرف هل الليلة محاق أم بدر من التاريخ وحده

اقتراني = 29.530588853
مرجع = 2451550.1

دالة يوم_جولياني(سنة, شهر, يوم):
  أ = (14 - شهر) // 12
  س2 = سنة + 4800 - أ
  ش2 = شهر + 12 * أ - 3
  ارجع يوم + (153 * ش2 + 2) // 5 + 365 * س2 + س2 // 4 - س2 // 100 + س2 // 400 - 32045

دالة طور(سنة, شهر, يوم):
  عمر = (يوم_جولياني(سنة, شهر, يوم) - مرجع) % اقتراني
  لو عمر < 1.84566:
    ارجع "محاق"
  لو عمر < 5.53699:
    ارجع "هلال متزايد"
  لو عمر < 9.22831:
    ارجع "تربيع أول"
  لو عمر < 12.91963:
    ارجع "أحدب متزايد"
  لو عمر < 16.61096:
    ارجع "بدر"
  لو عمر < 20.30228:
    ارجع "أحدب متناقص"
  لو عمر < 23.99361:
    ارجع "تربيع أخير"
  لو عمر < 27.68493:
    ارجع "هلال متناقص"
  ارجع "محاق"

تأكد_يساوي(طور(2024, 1, 11), "محاق", "محاق يناير 2024")
تأكد_يساوي(طور(2024, 1, 18), "تربيع أول", "تربيع أول")
تأكد_يساوي(طور(2024, 1, 25), "بدر", "بدر يناير 2024")
تأكد_يساوي(طور(2024, 2, 2), "تربيع أخير", "تربيع أخير")
تأكد_يساوي(طور(2024, 2, 9), "محاق", "محاق فبراير 2024")
اطبع "طور 2024-01-25:", طور(2024, 1, 25)
