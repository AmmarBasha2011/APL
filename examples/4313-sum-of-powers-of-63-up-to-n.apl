# مثال 4313 — مجموع قوى 63
# Sum of powers of 63
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4313-sum-of-powers-of-63-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 63 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 64, "حالة 2")
تأكد_يساوي(ف(3), 254080, "حالة 3")
تأكد_يساوي(ف(6), 63531945793, "حالة 4")
تأكد_يساوي(ف(10), 1000816264331497153, "حالة 5")
