# مثال 3184 — مجموع قوى 32
# Sum of powers of 32
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3184-sum-of-powers-of-32-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 32 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 33, "حالة 2")
تأكد_يساوي(ف(3), 33825, "حالة 3")
تأكد_يساوي(ف(6), 1108378657, "حالة 4")
تأكد_يساوي(ف(10), 1162219258676257, "حالة 5")
