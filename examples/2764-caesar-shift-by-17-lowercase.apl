# مثال 2764 — قيصر بإزاحة 17
# Caesar shift 17
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2764-caesar-shift-by-17-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 17) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "rst", "حالة 1")
تأكد_يساوي(ف("xyz"), "opq", "حالة 2")
تأكد_يساوي(ف("hello world"), "yvccf nficu", "حالة 3")
تأكد_يساوي(ف("a1"), "r1", "حالة 4")
