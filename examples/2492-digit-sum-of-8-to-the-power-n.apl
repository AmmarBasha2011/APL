# مثال 2492 — مجموع أرقام 8 أس ن
# Digit sum of 8 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2492-digit-sum-of-8-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 8 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 8, "حالة 2")
تأكد_يساوي(ف(5), 26, "حالة 3")
تأكد_يساوي(ف(10), 37, "حالة 4")
تأكد_يساوي(ف(20), 82, "حالة 5")
