# مثال 3445 — ربط أول 3 أحرف بنقاط
# Join first 3 chars with dots
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3445-join-first-3-chars-with-dots.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ".".join(ن[:3])

تأكد_يساوي(ف("hello"), "h.e.l", "حالة 1")
تأكد_يساوي(ف("ab"), "a.b", "حالة 2")
تأكد_يساوي(ف("abcdefghijklmn"), "a.b.c", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
