# مثال 2519 — الحد النوني بخطوة 3
# Nth term step 3
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2519-nth-term-arithmetic-sequence-step-3.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 3

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 6, "حالة 2")
تأكد_يساوي(ف(10), 30, "حالة 3")
تأكد_يساوي(ف(100), 300, "حالة 4")
