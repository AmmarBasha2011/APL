# مثال 3666 — إضافة 46 لكل عنصر
# Add 46 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3666-list-add-46-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 46]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [49, 47, 48], "حالة 1")
تأكد_يساوي(ف([5]), [51], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [47, 48, 49, 50, 51, 52], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [44, 46, 53, 53, 50], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [56, 66, 56, 76, 66, 56], "حالة 5")
