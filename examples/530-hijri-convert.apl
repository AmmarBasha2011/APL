# مثال 530 — التحويل إلى التقويم الهجري
# Gregorian to Hijri conversion
# Demonstrates: تقويم هجري، الخوارزمية الكويتية
#
# Run:  python apl.py examples/530-hijri-convert.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تحويل ميلادي إلى هجري (الخوارزمية الكويتية التقريبية)
دالة إلى_هجري(سنة, شهر, يوم):
    المتغير أ = صحيح((شهر - 14) / 12)
    المتغير جد = صحيح(1461 * (سنة + 4800 + أ) / 4) + صحيح(367 * (شهر - 2 - 12 * أ) / 12) - صحيح(3 * صحيح((سنة + 4900 + أ) / 100) / 4) + يوم - 32075
    المتغير ل = جد - 1948440 + 10632
    المتغير ن = صحيح((ل - 1) / 10631)
    ل = ل - 10631 * ن + 354
    المتغير ج = صحيح((10985 - ل) / 5316) * صحيح(50 * ل / 17719) + صحيح(ل / 5670) * صحيح(43 * ل / 15238)
    ل = ل - صحيح((30 - ج) / 15) * صحيح(17719 * ج / 50) - صحيح(ج / 16) * صحيح(15238 * ج / 43) + 29
    المتغير شهر_ه = صحيح(24 * ل / 709)
    المتغير يوم_ه = ل - صحيح(709 * شهر_ه / 24)
    المتغير سنة_ه = 30 * ن + ج - 30
    ارجع [سنة_ه, شهر_ه, يوم_ه]

المتغير نتيجة = إلى_هجري(2024, 3, 11)
اطبع "11 مارس 2024 هجرياً:", نتيجة
تأكد_يساوي(نتيجة, [1445, 9, 1], "أول رمضان 1445")
