# مثال 2804 — السعر بعد خصم 4 بالمئة
# Price after 4 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2804-price-after-4-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 4 // 100

تأكد_يساوي(ف(100), 96, "حالة 1")
تأكد_يساوي(ف(250), 240, "حالة 2")
تأكد_يساوي(ف(999), 960, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
