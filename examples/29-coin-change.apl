# مثال 29 — مشكلة تغيير العملات
# Coin Change Problem (Dynamic Programming)
# Demonstrates: dynamic programming, nested loops, counting combinations
#
# Run:  python apl.py examples/29-coin-change.apl

دالة_عدد_التركيبات(الحد, العملات):
    جدول = [0] * (الحد + 1)
    جدول[0] = 1
    رقم = 0
    طالما رقم < طول(العملات):
        قيمة = العملات[رقم]
        مبلغ = قيمة
        طالما مبلغ <= الحد:
            جدول[مبلغ] = جدول[مبلغ] + جدول[مبلغ - قيمة]
            مبلغ = مبلغ + 1
        رقم = رقم + 1
    ارجع جدول[الحد]

دالة_أقل_عدد(الحد, العملات):
    الأفضل = [0] * (الحد + 1)
    مبلغ = 1
    طالما مبلغ <= الحد:
        الأفضل[مبلغ] = مبلغ
        رقم = 0
        طالما رقم < طول(العملات):
            قيمة = العملات[رقم]
            لو قيمة <= مبلغ:
                مرشح = الأفضل[مبلغ - قيمة] + 1
                لو مرشح < الأفضل[مبلغ]:
                    الأفضل[مبلغ] = مرشح
            رقم = رقم + 1
        مبلغ = مبلغ + 1
    ارجع الأفضل[الحد]

المتغير العملات = [1, 3, 4]
اطبع "=== تغيير العملات ==="
اطبع "العملات المتاحة: " + نص(العملات)
اطبع ""
اطبع "--- عدد التركيبات الممكنة ---"
لكل مبلغ في [0, 4, 6, 8, 12]:
    اطبع "  " + نص(مبلغ) + " -> " + نص(دالة_عدد_التركيبات(مبلغ, العملات)) + " تركيبة"
اطبع ""
اطبع "--- أقل عدد عملات ---"
لكل مبلغ في [6, 7, 9, 11, 20]:
    اطبع "  " + نص(مبلغ) + " -> " + نص(دالة_أقل_عدد(مبلغ, العملات)) + " عملة"
