# مثال 3951 — السعر بعد خصم 36 بالمئة
# Price after 36 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3951-price-after-36-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 36 // 100

تأكد_يساوي(ف(100), 64, "حالة 1")
تأكد_يساوي(ف(250), 160, "حالة 2")
تأكد_يساوي(ف(999), 640, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
