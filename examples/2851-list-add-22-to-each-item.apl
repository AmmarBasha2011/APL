# مثال 2851 — إضافة 22 لكل عنصر
# Add 22 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2851-list-add-22-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 22]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [25, 23, 24], "حالة 1")
تأكد_يساوي(ف([5]), [27], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [23, 24, 25, 26, 27, 28], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [20, 22, 29, 29, 26], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [32, 42, 32, 52, 42, 32], "حالة 5")
