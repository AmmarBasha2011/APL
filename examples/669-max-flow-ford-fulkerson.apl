# مثال 669 — أقصى تدفق بفورد-فولكرسون
# Max-flow Ford-Fulkerson
# Demonstrates: تدفق أقصى، مسارات معززة، شبكة متبقية
#
# Run:  python apl.py examples/669-max-flow-ford-fulkerson.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# التدفق الأقصى: فورد-فلكرسون
# Demonstrates: شبكة سعات, مسار زيادة ببحث عرضي, حواف عكسية
# أكبر تدفق من المصدر إلى المصب يساوي سعة أصغر قطع

ن = 6
طاقة = [
  [0, 16, 13, 0, 0, 0],
  [0, 0, 0, 12, 0, 0],
  [0, 4, 0, 0, 14, 0],
  [0, 0, 9, 0, 0, 20],
  [0, 0, 0, 7, 0, 4],
  [0, 0, 0, 0, 0, 0],
]

دالة مسار_زيادة(بقايا, مصدر, مصب):
  أب = []
  لكل ي في نطاق(ن):
    أب.append(0 - 1)
  أب[مصدر] = مصدر
  طابور = [مصدر]
  رأس = 0
  طالما رأس < طول(طابور):
    حالي = طابور[رأس]
    رأس = رأس + 1
    لكل جار في نطاق(ن):
      لو أب[جار] == 0 - 1 و بقايا[حالي][جار] > 0:
        أب[جار] = حالي
        لو جار == مصب:
          طريق = []
          ع = مصب
          طالما ع != مصدر:
            طريق.append(ع)
            ع = أب[ع]
          طريق.append(مصدر)
          ارجع طريق
        طابور.append(جار)
  ارجع []

دالة تدفق_أقصى():
  بقايا = []
  لكل صف في طاقة:
    بقايا.append(صف.copy())
  تدفق = 0
  طالما صواب:
    طريق = مسار_زيادة(بقايا, 0, 5)
    لو طول(طريق) == 0:
      ارجع تدفق
    زيادة = 9999
    لكل ي في نطاق(طول(طريق) - 1):
      حافة = بقايا[طريق[ي + 1]][طريق[ي]]
      لو حافة < زيادة:
        زيادة = حافة
    لكل ي في نطاق(طول(طريق) - 1):
      بقايا[طريق[ي + 1]][طريق[ي]] = بقايا[طريق[ي + 1]][طريق[ي]] - زيادة
      بقايا[طريق[ي]][طريق[ي + 1]] = بقايا[طريق[ي]][طريق[ي + 1]] + زيادة
    تدفق = تدفق + زيادة

تأكد_يساوي(تدفق_أقصى(), 23, "تدفق أقصى للشبكة الكلاسيكية")
اطبع "التدفق الأقصى:", تدفق_أقصى()
