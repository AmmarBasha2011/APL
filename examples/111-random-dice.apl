# مثال 111 — محاكاة رمي نرد
# Dice rolling simulation
# Demonstrates: بذرة، عشوائي_عدد، عداد
#
# Run:  python apl.py examples/111-random-dice.apl

بذرة(42)
المتغير رميات = []
لكل _ في نطاق(600):
    رميات.أضف(عشوائي_عدد(1, 6))

المتغير عد = عداد(رميات)
اطبع "نتائج 600 رمية نرد:"
لكل الوجه في نطاق(1, 7):
    اطبع "الوجه", الوجه, ":", عد[الوجه], "مرة"

اطبع ""
اطبع "المتوسط:", متوسط(رميات)
اطبع "أكثر وجه ظهراً:", عنصر_أكثر(عد, 1)
