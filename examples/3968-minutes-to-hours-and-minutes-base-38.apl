# مثال 3968 — تحويل وحدة بأساس 38
# Split by base 38
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3968-minutes-to-hours-and-minutes-base-38.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 38, ن % 38]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 21], "حالة 2")
تأكد_يساوي(ف(60), [1, 22], "حالة 3")
تأكد_يساوي(ف(125), [3, 11], "حالة 4")
تأكد_يساوي(ف(1000), [26, 12], "حالة 5")
