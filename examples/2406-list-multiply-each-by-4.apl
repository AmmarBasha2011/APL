# مثال 2406 — ضرب كل عنصر في 4
# Multiply each item by 4
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2406-list-multiply-each-by-4.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 4]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [12, 4, 8], "حالة 1")
تأكد_يساوي(ف([5]), [20], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [4, 8, 12, 16, 20, 24], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-8, 0, 28, 28, 16], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [40, 80, 40, 120, 80, 40], "حالة 5")
