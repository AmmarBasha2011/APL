# مثال 1449 — الصندوق المحيط
# Bounding box of points
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1449-bounding-box-points.apl

# نتتبع أصغر وأكبر قيمة لكل إحداثي
# نعيد الزاويتين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صندوق(نقاط):
  س0 = نقاط[0][0]
  ص0 = نقاط[0][1]
  س1 = س0
  ص1 = ص0
  لكل ن في نقاط:
    س0 = أصغر(س0, ن[0])
    ص0 = أصغر(ص0, ن[1])
    س1 = أكبر(س1, ن[0])
    ص1 = أكبر(ص1, ن[1])
  ارجع [س0, ص0, س1, ص1]

تأكد_يساوي(صندوق([[1,2],[3,-1],[0,5]]), [0, -1, 3, 5], "ثلاث نقاط")
تأكد_يساوي(صندوق([[2,2]]), [2, 2, 2, 2], "نقطة")
تأكد_يساوي(صندوق([[-1,-1],[1,1]]), [-1, -1, 1, 1], "قطر")
