# مثال 492 — حجز مقاعد حافلة
# Bus seat booking
# Demonstrates: خريطة مقاعد
#
# Run:  python apl.py examples/492-bus-booking.apl

المتغير مقاعد = []
لكل ي في نطاق(10):
    مقاعد.append("فارغ")

دالة اعرض():
    المتغير رسم = ""
    لكل م في مقاعد:
        لو م == "فارغ":
            رسم = رسم + "[_]"
        الا:
            رسم = رسم + "[X]"
    اطبع رسم

دالة احجز_مقعد(رقم):
    لو مقاعد[رقم] == "فارغ":
        مقاعد[رقم] = "محجوز"
        اطبع "تم حجز المقعد", رقم
    الا:
        اطبع "المقعد", رقم, "محجوز مسبقا"

اعرض()
احجز_مقعد(3)
احجز_مقعد(3)
احجز_مقعد(7)
اعرض()
