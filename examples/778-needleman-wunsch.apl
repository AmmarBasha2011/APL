# مثال 778 — محاذاة نيدلمان-فنش
# Needleman-Wunsch
# Demonstrates: ديناميكية شاملة، تتبع خلفي
#
# Run:  python apl.py examples/778-needleman-wunsch.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# محاذاة نيدلمان-فنش الشاملة لتسلسلين
# Demonstrates: برمجة ديناميكية ثنائية, تتبع خلفي, درجات تطابق/فجوة
# خلافاً عن سميث-ووترمان (محلية), هذه محاذاة شاملة من الطرف للطرف

دالة محاذاة_شاملة(أ, ب):
  ن = طول(أ)
  م = طول(ب)
  جدول = []
  لكل ي في نطاق(ن + 1):
    صف = []
    لكل ج في نطاق(م + 1):
      صف.append(0)
    جدول.append(صف)
  لكل ي في نطاق(ن + 1):
    صف = جدول[ي]
    صف[0] = 0 - ي
  لكل ج في نطاق(م + 1):
    صف = جدول[0]
    صف[ج] = 0 - ج
  لكل ي في نطاق(1, ن + 1):
    لكل ج في نطاق(1, م + 1):
      لو أ[ي - 1] == ب[ج - 1]:
        ق = 1
      والا:
        ق = 0 - 1
      قطري = جدول[ي - 1][ج - 1] + ق
      اعلى = جدول[ي - 1][ج] - 1
      يسار = جدول[ي][ج - 1] - 1
      افضل = قطري
      لو اعلى > افضل:
        افضل = اعلى
      لو يسار > افضل:
        افضل = يسار
      صف = جدول[ي]
      صف[ج] = افضل
  محاذاة_أ = ""
  محاذاة_ب = ""
  ي = ن
  ج = م
  طالما ي > 0 أو ج > 0:
    تم = خطأ
    لو ي > 0 و ج > 0:
      لو أ[ي - 1] == ب[ج - 1]:
        ق = 1
      والا:
        ق = 0 - 1
      لو جدول[ي][ج] == جدول[ي - 1][ج - 1] + ق:
        محاذاة_أ = أ[ي - 1] + محاذاة_أ
        محاذاة_ب = ب[ج - 1] + محاذاة_ب
        ي = ي - 1
        ج = ج - 1
        تم = صواب
    لو تم == خطأ و ي > 0 و جدول[ي][ج] == جدول[ي - 1][ج] - 1:
      محاذاة_أ = أ[ي - 1] + محاذاة_أ
      محاذاة_ب = "-" + محاذاة_ب
      ي = ي - 1
      تم = صواب
    لو تم == خطأ:
      محاذاة_أ = "-" + محاذاة_أ
      محاذاة_ب = ب[ج - 1] + محاذاة_ب
      ج = ج - 1
  ارجع [جدول[ن][م], محاذاة_أ, محاذاة_ب]

ن1 = محاذاة_شاملة("GATTACA", "GCATGCU")
تأكد_يساوي(ن1[0], 0, "درجة GATTACA/GCATGCU")
تأكد_يساوي(ن1[1], "G-ATTACA", "محاذاة أولى")
تأكد_يساوي(ن1[2], "GCA-TGCU", "محاذاة ثانية")
ن2 = محاذاة_شاملة("ACGT", "AAGT")
تأكد_يساوي(ن2[0], 2, "درجة ACGT/AAGT")
تأكد_يساوي(ن2[1], "ACGT", "محاذاة 2 أولى")
تأكد_يساوي(ن2[2], "AAGT", "محاذاة 2 ثانية")
ن3 = محاذاة_شاملة("AGT", "AGT")
تأكد_يساوي(ن3[0], 3, "تطابق تام")
