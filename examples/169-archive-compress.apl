# مثال 169 — ضغط النصوص بثلاث خوارزميات
# Text compression with three algorithms
# Demonstrates: ضغط_gz، فك_ضغط_gz، ضغط_bz2، ضغط_xz، حجم_بشري
#
# Run:  python apl.py examples/169-archive-compress.apl

المتغير نص = "هذا نص طويل للتجربة. " * 100
اطبع "الحجم الأصلي:", حجم_بشري(طول(نص.encode()))

المتغير م1 = ضغط_gz(نص.encode())
اطبع "gzip:", حجم_بشري(طول(م1)), "->", فك_ضغط_gz(م1) == نص

المتغير م2 = ضغط_bz2(نص.encode())
اطبع "bz2:", حجم_بشري(طول(م2)), "->", فك_ضغط_قوي(م2) == نص

المتغير م3 = ضغط_xz(نص.encode())
اطبع "xz:", حجم_بشري(طول(م3)), "->", فك_ضغط_فائق(م3) == نص
