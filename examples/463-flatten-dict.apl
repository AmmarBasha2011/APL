# مثال 463 — تسطيح القواميس المتداخلة
# Flatten nested dict
# Demonstrates: مفاتيح مسطحة بنقاط
#
# Run:  python apl.py examples/463-flatten-dict.apl

دالة سطح(قاموس, بادئة_مسار, نتيجة):
    لكل مفتاح في قاموس.keys():
        المتغير قيمة = قاموس[مفتاح]
        المتغير مسار = بادئة_مسار + مفتاح
        لو type(قيمة) == dict:
            سطح(قيمة, مسار + ".", نتيجة)
        الا:
            نتيجة[مسار] = قيمة

المتغير متداخل = {"مستخدم": {"اسم": "عمار", "عمر": 26}, "نشط": صواب}
المتغير مسطح = {}
سطح(متداخل, "", مسطح)
اطبع مسطح
