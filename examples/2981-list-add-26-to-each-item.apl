# مثال 2981 — إضافة 26 لكل عنصر
# Add 26 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2981-list-add-26-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 26]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [29, 27, 28], "حالة 1")
تأكد_يساوي(ف([5]), [31], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [27, 28, 29, 30, 31, 32], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [24, 26, 33, 33, 30], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [36, 46, 36, 56, 46, 36], "حالة 5")
