# مثال 1295 — تقويم بحجز مزدوج
# My calendar II double booking allowed
# Demonstrates: مجالات
#
# Run:  python apl.py examples/1295-my-calendar-two.apl

# نحتفظ بالحجوزات المفردة والتقاطعات المزدوجة
# ونرفض الحجز الذي يقطع تقاطعاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف تقويم_ثان:
  دالة_إنشاء(ذات):
    ذات.مفردة = []
    ذات.مزدوجة = []

  دالة احجز(ذات, ب, ن):
    لكل م في ذات.مزدوجة:
      لو (ب < م[1]) و (ن > م[0]):
        ارجع خطأ
    لكل م في ذات.مفردة:
      لو (ب < م[1]) و (ن > م[0]):
        ذات.مزدوجة.ألحق([أكبر(ب, م[0]), أصغر(ن, م[1])])
    ذات.مفردة.ألحق([ب, ن])
    ارجع صواب

ت = تقويم_ثان()
تأكد_يساوي(ت.احجز(10, 20), صواب, "أول")
تأكد_يساوي(ت.احجز(50, 60), صواب, "ثان")
تأكد_يساوي(ت.احجز(10, 40), صواب, "مزدوج")
تأكد_يساوي(ت.احجز(5, 15), خطأ, "ثلاثي")
تأكد_يساوي(ت.احجز(5, 10), صواب, "قبل")
تأكد_يساوي(ت.احجز(25, 55), صواب, "مزدوج آخر")
