# مثال 2551 — اقتطاع أول 4 أحرف
# First 4 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2551-truncate-text-to-first-4-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:4]

تأكد_يساوي(ف("hello world"), "hell", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abcd", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
