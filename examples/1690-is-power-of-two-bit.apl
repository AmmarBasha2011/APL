# مثال 1690 — هل العدد قوة للاثنين
# Is power of two by bit trick
# Demonstrates: بتات
#
# Run:  python apl.py examples/1690-is-power-of-two-bit.apl

# قوة الاثنين فيها بت واحد
# الطرح يقلب ذلك البت

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة_اثنين(ن):
  لو ن <= 0:
    ارجع خطأ
  ارجع (ن & (ن - 1)) == 0

تأكد_يساوي(قوة_اثنين(1), صواب, "واحد")
تأكد_يساوي(قوة_اثنين(64), صواب, "أربعة وستون")
تأكد_يساوي(قوة_اثنين(12), خطأ, "اثنا عشر")
تأكد_يساوي(قوة_اثنين(0), خطأ, "صفر")
