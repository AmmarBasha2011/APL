# مثال 1613 — عدد المكونات المتصلة
# Count connected components
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1613-connected-components-count.apl

# نبدأ بحثاً من كل رأس لم نزره
# كل بحث جديد مكون جديد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عدد_المكونات(ن, أضلاع):
  جيران = {}
  لكل ع في نطاق(ن):
    جيران[ع] = []
  لكل ض في أضلاع:
    جيران[ض[0]].append(ض[1])
    جيران[ض[1]].append(ض[0])
  زرنا = {}
  مكونات = 0
  لكل بداية في نطاق(ن):
    لو بداية في زرنا:
      مكونات = مكونات
    والا:
      مكونات = مكونات + 1
      مكدس = [بداية]
      زرنا[بداية] = صواب
      طالما طول(مكدس) > 0:
        ح = مكدس.pop()
        لكل ج في جيران[ح]:
          لو ج في زرنا:
            مكونات = مكونات
          والا:
            زرنا[ج] = صواب
            مكدس.append(ج)
  ارجع مكونات

تأكد_يساوي(عدد_المكونات(5, [[0, 1], [1, 2], [3, 4]]), 2, "مكونان")
تأكد_يساوي(عدد_المكونات(4, []), 4, "منعزلة")
تأكد_يساوي(عدد_المكونات(3, [[0, 1], [1, 2]]), 1, "مكون واحد")
