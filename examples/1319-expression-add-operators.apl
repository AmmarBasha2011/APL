# مثال 1319 — إضافة عمليات
# Expression add operators
# Demonstrates: رجوع
#
# Run:  python apl.py examples/1319-expression-add-operators.apl

# نجرب بين كل رقمين جمعاً أو طرحاً أو ضرباً أو لصقاً
# ونحسب القيمة بحذر في الضرب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عبارات(ارقام, هدف):
  ناتج = []
  مكدس = []
  لكل ط في نطاق(1, طول(ارقام) + 1):
    اول = ارقام[:ط]
    لو (طول(اول) == 1) أو (اول[0] != "0"):
      مكدس.ألحق([ط, اول, صحيح(اول), صحيح(اول)])
  طالما طول(مكدس) > 0:
    ح = مكدس.pop()
    ع = ح[0]
    نص_ = ح[1]
    قيمة = ح[2]
    اخير = ح[3]
    لو ع == طول(ارقام):
      لو قيمة == هدف:
        ناتج.ألحق(نص_)
    والا:
      لكل ط في نطاق(ع + 1, طول(ارقام) + 1):
        جزء = ارقام[ع:ط]
        لو (طول(جزء) > 1) و (جزء[0] == "0"):
          تجاهل = 0
        والا:
          ق = صحيح(جزء)
          مكدس.ألحق([ط, نص_ + "+" + جزء, قيمة + ق, ق])
          مكدس.ألحق([ط, نص_ + "-" + جزء, قيمة - ق, -ق])
          مكدس.ألحق([ط, نص_ + "*" + جزء, قيمة - اخير + اخير * ق, اخير * ق])
  ارجع مفرز(ناتج)

تأكد_يساوي(عبارات("123", 6), ["1*2*3", "1+2+3"], "ستة")
تأكد_يساوي(عبارات("232", 8), ["2*3+2", "2+3*2"], "ثمانية")
تأكد_يساوي(عبارات("105", 5), ["1*0+5", "10-5"], "أصفار")
تأكد_يساوي(عبارات("00", 0), ["0*0", "0+0", "0-0"], "أصفار فقط")
تأكد_يساوي(عبارات("12", 100), [], "لا حل")
