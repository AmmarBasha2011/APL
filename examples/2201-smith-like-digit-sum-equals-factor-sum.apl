# مثال 2201 — عدد سميث
# Smith number check
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2201-smith-like-digit-sum-equals-factor-sum.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجد(ن):
  م = 0
  لكل ر في نص(ن):
    م = م + int(ر)
  ارجع م

دالة ف(ن):
  ا = ن
  د = 2
  ع = 0
  ف2 = 0
  طالما ا > 1:
    لو ا % د == 0:
      ف2 = ف2 + مجد(د)
      ع = ع + 1
      ا = ا // د
    والا:
      د = د + 1
  ارجع ع > 1 و ف2 == مجد(ن)

تأكد_يساوي(ف(4), صواب, "حالة 4")
تأكد_يساوي(ف(22), صواب, "حالة 22")
تأكد_يساوي(ف(27), صواب, "حالة 27")
تأكد_يساوي(ف(13), خطأ, "حالة 13")
تأكد_يساوي(ف(58), صواب, "حالة 58")
تأكد_يساوي(ف(85), صواب, "حالة 85")
