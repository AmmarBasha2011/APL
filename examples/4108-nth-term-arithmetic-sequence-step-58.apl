# مثال 4108 — الحد النوني بخطوة 58
# Nth term step 58
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4108-nth-term-arithmetic-sequence-step-58.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 58

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 61, "حالة 2")
تأكد_يساوي(ف(10), 525, "حالة 3")
تأكد_يساوي(ف(100), 5745, "حالة 4")
