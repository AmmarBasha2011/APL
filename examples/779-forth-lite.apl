# مثال 779 — مفسر فورث
# Forth interpreter
# Demonstrates: مكدس RPN، تعريف كلمات
#
# Run:  python apl.py examples/779-forth-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مفسر فورث مصغر: مكدس، كلمات مدمجة، تعريفات جديدة
# Demonstrates: مكدس RPN, تعريف : اسم ... ;, إعادة استخدام الكلمات

دالة كلها_ارقام(س):
  نتيجة = صواب
  لكل حرف في س:
    لو حرف < "0" أو حرف > "9":
      نتيجة = خطأ
  ارجع نتيجة

دالة نفذ(وحدات, مكدس, أسماء, أجسام, مخرجات):
  ي = 0
  طالما ي < طول(وحدات):
    وح = وحدات[ي]
    لو وح == ":":
      أسماء.append(وحدات[ي + 1])
      جسم = []
      ي = ي + 2
      طالما وحدات[ي] != ";":
        جسم.append(وحدات[ي])
        ي = ي + 1
      أجسام.append(جسم)
    والا_لو وح == ".":
      مخرجات.append(مكدس.pop())
    والا_لو وح == "dup":
      مكدس.append(مكدس[طول(مكدس) - 1])
    والا_لو وح == "drop":
      مكدس.pop()
    والا_لو وح == "swap":
      أ = مكدس.pop()
      ب = مكدس.pop()
      مكدس.append(أ)
      مكدس.append(ب)
    والا_لو وح == "over":
      مكدس.append(مكدس[طول(مكدس) - 2])
    والا_لو وح == "+":
      ب = مكدس.pop()
      أ = مكدس.pop()
      مكدس.append(أ + ب)
    والا_لو وح == "-":
      ب = مكدس.pop()
      أ = مكدس.pop()
      مكدس.append(أ - ب)
    والا_لو وح == "*":
      ب = مكدس.pop()
      أ = مكدس.pop()
      مكدس.append(أ * ب)
    والا_لو وح == "/":
      ب = مكدس.pop()
      أ = مكدس.pop()
      مكدس.append(أ // ب)
    والا_لو كلها_ارقام(وح):
      مكدس.append(صحيح(وح))
    والا_لو وح في أسماء:
      نفذ(أجسام[أسماء.index(وح)], مكدس, أسماء, أجسام, مخرجات)
    ي = ي + 1

دالة فورث(برنامج):
  مخرجات = []
  نفذ(برنامج.split(" "), [], [], [], مخرجات)
  ارجع مخرجات

ن1 = فورث("3 4 + .")
تأكد_يساوي(ن1[0], 7, "جمع")
ن2 = فورث(": sq dup * ; 5 sq .")
تأكد_يساوي(ن2[0], 25, "كلمة معرفة")
ن3 = فورث("10 3 - 2 * .")
تأكد_يساوي(ن3[0], 14, "أولوية المكدس")
ن4 = فورث("1 2 swap - .")
تأكد_يساوي(ن4[0], 1, "swap")
ن5 = فورث("1 2 over + + .")
تأكد_يساوي(ن5[0], 4, "over")
ن6 = فورث(": avg + 2 / ; 3 9 avg .")
تأكد_يساوي(ن6[0], 6, "متوسط بكلمة")
ن7 = فورث("5 dup dup * * .")
تأكد_يساوي(ن7[0], 125, "تكعيب")
