# مثال 1098 — الباقي في كشك الليمونادة
# Lemonade change
# Demonstrates: جشع في الفكة
#
# Run:  python apl.py examples/1098-lemonade-change.apl

# الكوب بخمسة والزبائن يدفعون 5 أو 10 أو 20
# نفضل إرجاع ورقة عشرة مع خمسة قبل ثلاث أوراق خمسة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نعطي_باقي(اوراق):
  خمسات = 0
  عشرات = 0
  لكل ورقة في اوراق:
    لو ورقة == 5:
      خمسات = خمسات + 1
    والا_لو ورقة == 10:
      لو خمسات == 0:
        ارجع خطأ
      خمسات = خمسات - 1
      عشرات = عشرات + 1
    والا:
      لو (عشرات > 0) و (خمسات > 0):
        عشرات = عشرات - 1
        خمسات = خمسات - 1
      والا_لو خمسات >= 3:
        خمسات = خمسات - 3
      والا:
        ارجع خطأ
  ارجع صواب

تأكد_يساوي(نعطي_باقي([5, 5, 5, 10, 20]), صواب, "ينجح")
تأكد_يساوي(نعطي_باقي([5, 5, 10, 10, 20]), خطأ, "يفشل")
تأكد_يساوي(نعطي_باقي([10]), خطأ, "بلا فكة")
تأكد_يساوي(نعطي_باقي([5, 5, 5, 5, 20, 20]), خطأ, "فكة تنفد")
