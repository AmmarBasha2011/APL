# مثال 532 — قراءة الرقم القومي المصري
# Egyptian national ID parsing
# Demonstrates: رقم قومي مصري، تحليل حقول
#
# Run:  python apl.py examples/532-egypt-national-id.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# قراءة الرقم القومي المصري (14 رقماً): الميلاد والمحافظة والنوع
دالة حلل_رقم_قومي(رقم):
    المتغير قرون = {"2": 1900, "3": 2000}
    المتغير محافظات = {"01": "القاهرة", "02": "الإسكندرية", "03": "بورسعيد", "11": "دمياط", "12": "الدقهلية", "13": "الشرقية", "14": "القليوبية", "15": "كفر الشيخ", "16": "الغربية", "17": "المنوفية", "18": "البحيرة", "19": "الإسماعيلية", "21": "الجيزة", "22": "بني سويف", "23": "الفيوم", "24": "المنيا", "25": "أسيوط", "26": "سوهاج", "27": "قنا", "28": "أسوان", "29": "الأقصر", "31": "البحر الأحمر", "32": "الوادي الجديد", "33": "مطروح", "34": "شمال سيناء", "35": "جنوب سيناء", "88": "خارج الجمهورية"}
    المتغير سنة = قرون[رقم[0]] + صحيح(رقم[1:3])
    المتغير شهر = صحيح(رقم[3:5])
    المتغير يوم = صحيح(رقم[5:7])
    المتغير محافظة = محافظات[رقم[7:9]]
    المتغير تسلسل = صحيح(رقم[9:12])
    المتغير جندر = "ذكر"
    لو تسلسل % 2 == 0:
        جندر = "أنثى"
    ارجع [سنة, شهر, يوم, محافظة, جندر]

المتغير نتيجة = حلل_رقم_قومي("30009091234467")
اطبع "النتيجة:", نتيجة
تأكد_يساوي(نتيجة[0], 2000, "سنة الميلاد")
تأكد_يساوي(نتيجة[3], "الدقهلية", "المحافظة")
تأكد_يساوي(نتيجة[4], "أنثى", "النوع من التسلسل الزوجي")
