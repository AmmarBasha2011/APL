# مثال 1210 — شجرة متناظرة
# Symmetric tree check
# Demonstrates: تكرار ذاتي
#
# Run:  python apl.py examples/1210-tree-symmetric.apl

# نقارن الفرع الأيسر بالأيمن معكوساً
# القيم متساوية والأبناء متقابلون

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مرآة(أ, ب):
  لو (طول(أ) == 0) و (طول(ب) == 0):
    ارجع صواب
  لو (طول(أ) == 0) أو (طول(ب) == 0):
    ارجع خطأ
  لو أ[0] != ب[0]:
    ارجع خطأ
  س1 = مرآة(أ[1], ب[2])
  لو ليس س1:
    ارجع خطأ
  ارجع مرآة(أ[2], ب[1])

دالة متناظرة(ش):
  لو طول(ش) == 0:
    ارجع صواب
  ارجع مرآة(ش[1], ش[2])

سليمة = [1, [2, [3, [], []], [4, [], []]], [2, [4, [], []], [3, [], []]]]
معطوبة = [1, [2, [], [3, [], []]], [2, [], [3, [], []]]]
تأكد_يساوي(متناظرة(سليمة), صواب, "متناظرة")
تأكد_يساوي(متناظرة(معطوبة), خطأ, "غير متناظرة")
تأكد_يساوي(متناظرة([]), صواب, "فارغة")
