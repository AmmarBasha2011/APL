# مثال 2761 — قيصر بإزاحة 14
# Caesar shift 14
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2761-caesar-shift-by-14-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 14) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "opq", "حالة 1")
تأكد_يساوي(ف("xyz"), "lmn", "حالة 2")
تأكد_يساوي(ف("hello world"), "vszzc kcfzr", "حالة 3")
تأكد_يساوي(ف("a1"), "o1", "حالة 4")
