# مثال 4069 — إضافة 59 لكل عنصر
# Add 59 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4069-list-add-59-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 59]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [62, 60, 61], "حالة 1")
تأكد_يساوي(ف([5]), [64], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [60, 61, 62, 63, 64, 65], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [57, 59, 66, 66, 63], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [69, 79, 69, 89, 79, 69], "حالة 5")
