# مثال 2478 — إضافة 9 لكل عنصر
# Add 9 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2478-list-add-9-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 9]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [12, 10, 11], "حالة 1")
تأكد_يساوي(ف([5]), [14], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [10, 11, 12, 13, 14, 15], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [7, 9, 16, 16, 13], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [19, 29, 19, 39, 29, 19], "حالة 5")
