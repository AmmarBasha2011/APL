# مثال 806 — اللوغاريتم المتقطع
# Discrete log BSGS
# Demonstrates: خطوات طفل وعملاق، جذر
#
# Run:  python apl.py examples/806-discrete-log-bsgs.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# اللوغاريتم المتقطع بخطوات الطفل والعملاق: جذر تربيعي بدل الفحص الكامل
# Demonstrates: جدول خطوات صغيرة, معكوس فيرما, خطوات عملاقة

دالة أس_معياري(أساس, أس, م):
  ناتج = 1
  ب = أساس % م
  ه = أس
  طالما ه > 0:
    لو ه % 2 == 1:
      ناتج = (ناتج * ب) % م
    ب = (ب * ب) % م
    ه = ه // 2
  ارجع ناتج

دالة خطوات_عملاق(مولد, هدف, أولي):
  م = صحيح(جذر(أولي)) + 1
  قيم = []
  دلائل = []
  ه = 1
  لكل ج في نطاق(م):
    قيم.append(ه)
    دلائل.append(ج)
    ه = (ه * مولد) % أولي
  عامل = أس_معياري(أس_معياري(مولد, م, أولي), أولي - 2, أولي)
  ت = هدف
  لكل ي في نطاق(م):
    لو ت في قيم:
      ارجع ي * م + دلائل[قيم.index(ت)]
    ت = (ت * عامل) % أولي
  ارجع 0 - 1

تأكد_يساوي(خطوات_عملاق(5, 8, 23), 6, "خمسة أس ستة")
تأكد_يساوي(خطوات_عملاق(5, 17, 23), 7, "خمسة أس سبعة")
تأكد_يساوي(خطوات_عملاق(2, 11, 29), 25, "اثنان أس خمسة وعشرون")
تأكد_يساوي(أس_معياري(5, خطوات_عملاق(5, 8, 23), 23), 8, "تحقق عكسي")
