# مثال 1143 — أقواس بنجمة
# Valid parentheses with star
# Demonstrates: مدى
#
# Run:  python apl.py examples/1143-star-parentheses.apl

# نتتبع أدنى وأقصى عدد ممكن للأقواس المفتوحة
# والنجمة تغيّر المدى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صالح(س):
  ادنى = 0
  اقصى = 0
  لكل ح في س:
    لو ح == "(":
      ادنى = ادنى + 1
      اقصى = اقصى + 1
    والا_لو ح == ")":
      ادنى = ادنى - 1
      اقصى = اقصى - 1
    والا:
      ادنى = ادنى - 1
      اقصى = اقصى + 1
    لو اقصى < 0:
      ارجع خطأ
    لو ادنى < 0:
      ادنى = 0
  ارجع ادنى == 0

تأكد_يساوي(صالح("()"), صواب, "عادي")
تأكد_يساوي(صالح("(*)"), صواب, "نجمة وسط")
تأكد_يساوي(صالح("(*))"), صواب, "نجمة تفتح")
تأكد_يساوي(صالح(")("), خطأ, "معكوس")
تأكد_يساوي(صالح("((*"), خطأ, "ناقصة")
تأكد_يساوي(صالح(""), صواب, "فارغة")
