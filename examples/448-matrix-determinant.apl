# مثال 448 — محدد المصفوفة
# Matrix determinant
# Demonstrates: 2x2 و 3x3
#
# Run:  python apl.py examples/448-matrix-determinant.apl

دالة محدد2(م):
    ارجع م[0][0] * م[1][1] - م[0][1] * م[1][0]

دالة محدد3(م):
    المتغير أ = م[0][0] * (م[1][1] * م[2][2] - م[1][2] * م[2][1])
    المتغير ب = م[0][1] * (م[1][0] * م[2][2] - م[1][2] * م[2][0])
    المتغير ج = م[0][2] * (م[1][0] * م[2][1] - م[1][1] * م[2][0])
    ارجع أ - ب + ج

اطبع محدد2([[1, 2], [3, 4]])
اطبع محدد3([[1, 2, 3], [0, 1, 4], [5, 6, 0]])
