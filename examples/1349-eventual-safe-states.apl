# مثال 1349 — حالات آمنة
# Find eventual safe states
# Demonstrates: رسوم بيانية
#
# Run:  python apl.py examples/1349-eventual-safe-states.apl

# نعكس الحواف ونطبق ترتيباً طوبولوجياً
# العقدة الآمنة لا تصل إلى دورة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عقد_آمنة(رسم):
  ن = طول(رسم)
  عكس = []
  عدد_خارج = []
  لكل ع في نطاق(ن):
    عكس.ألحق([])
    عدد_خارج.ألحق(طول(رسم[ع]))
  لكل ع في نطاق(ن):
    لكل ج في رسم[ع]:
      عكس[ج].ألحق(ع)
  طابور = []
  لكل ع في نطاق(ن):
    لو عدد_خارج[ع] == 0:
      طابور.ألحق(ع)
  آمنة = []
  ك = 0
  طالما ك < طول(طابور):
    ق = طابور[ك]
    ك = ك + 1
    آمنة.ألحق(ق)
    لكل س في عكس[ق]:
      عدد_خارج[س] = عدد_خارج[س] - 1
      لو عدد_خارج[س] == 0:
        طابور.ألحق(س)
  ارجع مفرز(آمنة)

تأكد_يساوي(عقد_آمنة([[1,2],[2,3],[5],[0],[5],[],[]]), [2,4,5,6], "مثال أول")
تأكد_يساوي(عقد_آمنة([[1,2,3,4],[1,2],[3,4],[0,4],[]]), [4], "عقدة واحدة")
تأكد_يساوي(عقد_آمنة([[]]), [0], "طرفية")
