# مثال 234 — نمط الاستراتيجية
# Strategy pattern
# Demonstrates: تبديل الخوارزمية وقت التشغيل
#
# Run:  python apl.py examples/234-strategy.apl

دالة خصم_عادي(سعر):
    ارجع سعر

دالة خصم_طالب(سعر):
    ارجع سعر * 0.9

دالة خصم_ذهبي(سعر):
    ارجع سعر * 0.75

دالة احسب(سعر, استراتيجية):
    ارجع استراتيجية(سعر)

المتغير سعر = 200
اطبع "عادي:", احسب(سعر, خصم_عادي)
اطبع "طالب:", احسب(سعر, خصم_طالب)
اطبع "ذهبي:", احسب(سعر, خصم_ذهبي)
