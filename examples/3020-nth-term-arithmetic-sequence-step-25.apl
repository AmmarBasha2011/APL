# مثال 3020 — الحد النوني بخطوة 25
# Nth term step 25
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3020-nth-term-arithmetic-sequence-step-25.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 25

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 28, "حالة 2")
تأكد_يساوي(ف(10), 228, "حالة 3")
تأكد_يساوي(ف(100), 2478, "حالة 4")
