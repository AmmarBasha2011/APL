# مثال 1775 — تقييم التعبير اللاحق
# Evaluate postfix expression
# Demonstrates: مكدسات
#
# Run:  python apl.py examples/1775-postfix-expression-evaluate.apl

# نقسم التعبير بالمسافات
# نطبق العملية على آخر عددين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قيّم(تعبير):
  مكدس = []
  لكل ر في تعبير.split(" "):
    لو ر.isdigit():
      مكدس.append(صحيح(ر))
    والا:
      ب = مكدس.pop()
      أ = مكدس.pop()
      لو ر == "+":
        مكدس.append(أ + ب)
      والا_لو ر == "-":
        مكدس.append(أ - ب)
      والا_لو ر == "*":
        مكدس.append(أ * ب)
      والا:
        مكدس.append(أ // ب)
  ارجع مكدس[0]

تأكد_يساوي(قيّم("2 3 +"), 5, "جمع")
تأكد_يساوي(قيّم("5 1 2 + 4 * + 3 -"), 14, "مركب")
تأكد_يساوي(قيّم("8 2 /"), 4, "قسمة")
