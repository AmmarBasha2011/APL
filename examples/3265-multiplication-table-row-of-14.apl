# مثال 3265 — صف جدول ضرب 14
# Multiplication row of 14
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3265-multiplication-table-row-of-14.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 14]
  ارجع ر

تأكد_يساوي(ف(1), [14], "حالة 1")
تأكد_يساوي(ف(5), [14, 28, 42, 56, 70], "حالة 2")
تأكد_يساوي(ف(10), [14, 28, 42, 56, 70, 84, 98, 112, 126, 140], "حالة 3")
