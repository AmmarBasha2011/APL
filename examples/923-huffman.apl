# مثال 923 — ترميز هوفمان
# Huffman coding
# Demonstrates: دمج أقل عقدتين
#
# Run:  python apl.py examples/923-huffman.apl

# ترميز هوفمان: رموز بطول متغير حسب التكرار
# جشع: ادمج أقل عقدتين تكراراً حتى تبقى جذراً واحداً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# العقد: [تكرار, أحرف]، ونبني الشيفرات عند الدمج
دالة هوفمان(أحرف, تكرارات):
  ن = طول(أحرف)
  عقد = []
  لكل i في نطاق(ن):
    عقد.ألحق([تكرارات[i], [أحرف[i]], ""])
  # شيفرات نهائية لكل حرف
  شيفرات = []
  لكل i في نطاق(ن):
    شيفرات.ألحق("")
  طالما طول(عقد) > 1:
    # أوجد أقل عقدتين (بفهرسين متميزين)
    أول = -1
    ثان = -1
    لكل i في نطاق(طول(عقد)):
      لو أول == -1 أو عقد[i][0] < عقد[أول][0]:
        ثان = أول
        أول = i
      والا_لو ثان == -1 أو عقد[i][0] < عقد[ثان][0]:
        ثان = i
    # أضف 0 لشيفرات أحرف الأولى و 1 لأحرف الثانية
    لكل حرف في عقد[أول][1]:
      لكل i في نطاق(ن):
        لو أحرف[i] == حرف:
          شيفرات[i] = "0" + شيفرات[i]
    لكل حرف في عقد[ثان][1]:
      لكل i في نطاق(ن):
        لو أحرف[i] == حرف:
          شيفرات[i] = "1" + شيفرات[i]
    # ادمج: أزل الأعلى فهرساً أولاً
    تكرار_مجموع = عقد[أول][0] + عقد[ثان][0]
    أحرف_مجموع = عقد[أول][1] + عقد[ثان][1]
    لو أول > ثان:
      عقد = عقد[:أول] + عقد[أول + 1:]
      عقد = عقد[:ثان] + عقد[ثان + 1:]
    والا:
      عقد = عقد[:ثان] + عقد[ثان + 1:]
      عقد = عقد[:أول] + عقد[أول + 1:]
    عقد.ألحق([تكرار_مجموع, أحرف_مجموع, ""])
  ارجع شيفرات

أحرف = ["a", "b", "c", "d", "e", "f"]
تكرارات = [5, 9, 12, 13, 16, 45]
شيفرات = هوفمان(أحرف, تكرارات)
اطبع "الشيفرات:", شيفرات

# f الأكثر تكراراً يأخذ أقصر شيفرة
تأكد_يساوي(طول(شيفرات[5]), 1, "f بحرف واحد")
# خاصية البادئة: لا شيفرة بادئة لأخرى
لكل i في نطاق(6):
  لكل ج في نطاق(6):
    لو i != ج:
      أقصر = شيفرات[i]
      أطول = شيفرات[ج]
      لو طول(أقصر) <= طول(أطول):
        لو أطول[:طول(أقصر)] == أقصر:
          اطبع "فشل: خاصية البادئة", أقصر, أطول
          قياسي_نظام_اخرج(1)
اطبع "ناجح: خاصية البادئة"

# الطول المرجح: 5*4+9*4+12*3+13*3+16*3+45*1 = 224
طول_مرجح = 0
لكل i في نطاق(6):
  طول_مرجح = طول_مرجح + تكرارات[i] * طول(شيفرات[i])
اطبع "الطول المرجح:", طول_مرجح
تأكد_يساوي(طول_مرجح, 224, "الطول المرجح الأمثل")
