# مثال 3241 — تحويل وحدة بأساس 19
# Split by base 19
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3241-minutes-to-hours-and-minutes-base-19.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 19, ن % 19]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [3, 2], "حالة 2")
تأكد_يساوي(ف(60), [3, 3], "حالة 3")
تأكد_يساوي(ف(125), [6, 11], "حالة 4")
تأكد_يساوي(ف(1000), [52, 12], "حالة 5")
