# مثال 811 — ألوان الويب
# Hex colors & WCAG
# Demonstrates: sRGB خطي، إضاءة، تباين
#
# Run:  python apl.py examples/811-hex-color.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ألوان الويب: تحويل hex إلى RGB وحساب الإضاءة ونسبة التباين WCAG
# Demonstrates: تحليل خانات سداسية, خطية قناة sRGB, نسبة تباين معيارية

سداسي = "0123456789abcdef"

دالة قيمة_خانة(ح):
  لكل ي في نطاق(16):
    لو سداسي[ي] == ح:
      ارجع ي
  ارجع 0

دالة حلل_لون(لون):
  خالص = لون
  لو لون[0] == "#":
    خالص = لون[1:7]
  قيم = []
  لكل ي في نطاق(3):
    قيم.append(قيمة_خانة(خالص[ي * 2]) * 16 + قيمة_خانة(خالص[ي * 2 + 1]))
  ارجع قيم

دالة خطية(قناة):
  ج = قناة / 255.0
  لو ج <= 0.03928:
    ارجع ج / 12.92
  ارجع ((ج + 0.055) / 1.055) ** 2.4

دالة إضاءة(قيم):
  ارجع 0.2126 * خطية(قيم[0]) + 0.7152 * خطية(قيم[1]) + 0.0722 * خطية(قيم[2])

دالة تباين(لون1, لون2):
  إ1 = إضاءة(حلل_لون(لون1))
  إ2 = إضاءة(حلل_لون(لون2))
  لو إ1 < إ2:
    مؤقت = إ1
    إ1 = إ2
    إ2 = مؤقت
  ارجع (إ1 + 0.05) / (إ2 + 0.05)

تأكد_يساوي(حلل_لون("#1e80ff"), [30, 128, 255], "تحليل أزرق")
تأكد_يساوي(حلل_لون("ffffff"), [255, 255, 255], "بدون شباك")
تأكد_يساوي(مقرب(إضاءة([255, 255, 255]), 4), 1.0, "إضاءة الأبيض")
تأكد_يساوي(مقرب(إضاءة([30, 128, 255]), 4), 0.2293, "إضاءة الأزرق")
تأكد_يساوي(مقرب(تباين("#000000", "#ffffff"), 2), 21.0, "أعلى تباين")
تأكد_يساوي(مقرب(تباين("#1e80ff", "#ffffff"), 2), 3.76, "أزرق على أبيض")
تأكد_يساوي(مقرب(تباين("#767676", "#ffffff"), 2), 4.54, "رمادي AA")
