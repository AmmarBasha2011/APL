# مثال 493 — مدير وصفات الطعام
# Recipe manager
# Demonstrates: وصفات ومقادير وحفظ
#
# Run:  python apl.py examples/493-recipe-manager.apl

المتغير وصفات = [
    {"اسم": "كشري", "مقادير": ["أرز", "عدس", "مكرونة"], "وقت": 45},
    {"اسم": "ملوخية", "مقادير": ["ملوخية", "ثوم", "أرز"], "وقت": 60}
]
اكتب_ملف_جسون(وصفات, "/tmp/apl-493.json")

المتغير محملة = اقرأ_ملف_جسون("/tmp/apl-493.json")
لكل طبخة في محملة:
    اطبع "وصفة:", طبخة["اسم"], "- الوقت:", طبخة["وقت"], "دقيقة"
    اطبع "  المقادير:", "، ".ضم(طبخة["مقادير"])

احذف_ملف("/tmp/apl-493.json")
