# مثال 3769 — تحويل وحدة بأساس 34
# Split by base 34
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3769-minutes-to-hours-and-minutes-base-34.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 34, ن % 34]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 25], "حالة 2")
تأكد_يساوي(ف(60), [1, 26], "حالة 3")
تأكد_يساوي(ف(125), [3, 23], "حالة 4")
تأكد_يساوي(ف(1000), [29, 14], "حالة 5")
