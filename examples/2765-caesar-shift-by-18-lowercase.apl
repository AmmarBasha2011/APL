# مثال 2765 — قيصر بإزاحة 18
# Caesar shift 18
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2765-caesar-shift-by-18-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 18) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "stu", "حالة 1")
تأكد_يساوي(ف("xyz"), "pqr", "حالة 2")
تأكد_يساوي(ف("hello world"), "zwddg ogjdv", "حالة 3")
تأكد_يساوي(ف("a1"), "s1", "حالة 4")
