# مثال 1415 — سجل حضور الطالب
# Student attendance record eligibility
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1415-student-attendance-record.apl

# أقل من غيابين
# ولا ثلاث مرات تأخر متتالية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يستحق(سجل):
  لو سجل.count("A") >= 2:
    ارجع خطأ
  لو "LLL" في سجل:
    ارجع خطأ
  ارجع صواب

تأكد_يساوي(يستحق("PPALLP"), صواب, "مستحق")
تأكد_يساوي(يستحق("PPALLL"), خطأ, "تأخر ثلاثاً")
تأكد_يساوي(يستحق("AA"), خطأ, "غائب مرتين")
