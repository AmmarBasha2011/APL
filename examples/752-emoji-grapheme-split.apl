# مثال 752 — عنقودات الإيموجي
# Emoji grapheme clusters
# Demonstrates: ZWJ، معدلات بشرة، محددات تنويع
#
# Run:  python apl.py examples/752-emoji-grapheme-split.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تقسيم نص إلى عنقودات مرئية (grapheme clusters) للإيموجي
# Demonstrates: نقطة ترميز ZWJ, معدّلات لون البشرة, محددات التنويع
# العائلة 👨‍👩‍👧‍👦 عنقود واحد رغم أنها 7 نقاط ترميز

دالة هو_ممدد(نقطة):
  لو نقطة == 8205:
    ارجع صواب
  لو نقطة >= 127995 و نقطة <= 127999:
    ارجع صواب
  لو نقطة >= 65024 و نقطة <= 65039:
    ارجع صواب
  ارجع خطأ

دالة عنقودات(نص):
  ناتج = []
  لكل ي في نطاق(طول(نص)):
    نقطة = ترميز_حرف(نص[ي])
    لو طول(ناتج) > 0 و هو_ممدد(نقطة):
      ناتج[طول(ناتج) - 1] = ناتج[طول(ناتج) - 1] + نص[ي]
    والا_لو طول(ناتج) > 0 و ناتج[طول(ناتج) - 1].endswith("‍"):
      ناتج[طول(ناتج) - 1] = ناتج[طول(ناتج) - 1] + نص[ي]
    والا:
      ناتج.append(نص[ي])
  ارجع ناتج

أسرة = "👨‍👩‍👧‍👦"
عنقودات1 = عنقودات("👨‍👩‍👧‍👦👍🏽a❤️")

تأكد_يساوي(طول(عنقودات1), 4, "أربعة عنقودات")
تأكد_يساوي(عنقودات1[0], "👨‍👩‍👧‍👦", "العائلة عنقود واحد")
تأكد_يساوي(عنقودات1[1], "👍🏽", "إبهام بلون بشرة")
تأكد_يساوي(عنقودات1[2], "a", "حرف لاتيني")
تأكد_يساوي(عنقودات1[3], "❤️", "قلب بمحدد تنويع")

تأكد_يساوي(طول(عنقودات("abc")), 3, "نص عادي")
تأكد_يساوي(طول(عنقودات("")), 0, "نص فارغ")
تأكد_يساوي(طول(عنقودات("a👨‍👩‍👧‍👦b")), 3, "عائلة بين حرفين")
تأكد_يساوي(طول(أسرة), 7, "سبع نقاط ترميز خام")

اطبع "العنقودات:", عنقودات1
