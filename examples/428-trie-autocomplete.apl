# مثال 428 — إكمال تلقائي بشجرة البادئات
# Trie autocomplete
# Demonstrates: اقتراح كلمات ببادئة
#
# Run:  python apl.py examples/428-trie-autocomplete.apl

دالة أدرج(جذر_شجرة, كلمة):
    المتغير عقدة = جذر_شجرة
    لكل حرف في كلمة:
        لو عقدة.get(حرف) == لا_شيء:
            عقدة[حرف] = {}
        عقدة = عقدة[حرف]
    عقدة["*"] = صواب

دالة اجمع_كلمات(عقدة, بادئة_حالية, نتائج):
    لو عقدة.get("*") == صواب:
        نتائج.append(بادئة_حالية)
    لكل مفتاح in عقدة.keys():
        لو مفتاح != "*":
            اجمع_كلمات(عقدة[مفتاح], بادئة_حالية + مفتاح, نتائج)

المتغير جذر_شجرة = {}
أدرج(جذر_شجرة, "باب")
أدرج(جذر_شجرة, "بحر")
أدرج(جذر_شجرة, "بيت")
أدرج(جذر_شجرة, "شجرة")

المتغير عقدة = جذر_شجرة["ب"]
المتغير اقتراحات = []
اجمع_كلمات(عقدة, "ب", اقتراحات)
اطبع "اقتراحات بـ ب:", اقتراحات
