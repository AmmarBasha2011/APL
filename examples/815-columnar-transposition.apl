# مثال 815 — النقل العمودي
# Columnar transposition
# Demonstrates: ترتيب أعمدة بالمفتاح، صفوف ناقصة
#
# Run:  python apl.py examples/815-columnar-transposition.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شفرة النقل العمودي: كتابة بصفوف وقراءة بأعمدة حسب ترتيب المفتاح
# Demonstrates: ترتيب أعمدة أبجدي, صفوف غير مكتملة, فك بالعكس

دالة ترتيب_مفتاح(مفتاح):
  دلائل = []
  لكل ي في نطاق(طول(مفتاح)):
    دلائل.append(ي)
  لكل ي في نطاق(طول(دلائل)):
    أدنى = ي
    لكل ج في نطاق(ي + 1, طول(دلائل)):
      لو مفتاح[دلائل[ج]] < مفتاح[دلائل[أدنى]]:
        أدنى = ج
    مؤقت = دلائل[ي]
    دلائل[ي] = دلائل[أدنى]
    دلائل[أدنى] = مؤقت
  ارجع دلائل

دالة شفر_عمودي(نص, مفتاح):
  ن = طول(مفتاح)
  ترتيب = ترتيب_مفتاح(مفتاح)
  ناتج = ""
  لكل عمود في ترتيب:
    صف = 0
    طالما صف * ن + عمود < طول(نص):
      ناتج = ناتج + نص[صف * ن + عمود]
      صف = صف + 1
  ارجع ناتج

تأكد_يساوي(ترتيب_مفتاح("ZEBRA"), [4, 2, 1, 3, 0], "ترتيب ZEBRA")
تأكد_يساوي(شفر_عمودي("WEAREDISCOVERED", "ZEBRA"), "EODASREIERCEWDV", "تشفير كلاسيكي")
تأكد_يساوي(شفر_عمودي("HELLOWORLD", "KEY"), "EORHLODLWL", "تشفير قصير")
تأكد_يساوي(طول(شفر_عمودي("ABCDEFG", "DCBA")), 7, "الطول محفوظ")
