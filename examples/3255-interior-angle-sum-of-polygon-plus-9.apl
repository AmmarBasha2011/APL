# مثال 3255 — مجموع زوايا مضلع زائد 9
# Polygon angle sum plus 9
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3255-interior-angle-sum-of-polygon-plus-9.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 9

تأكد_يساوي(ف(3), 189, "حالة 1")
تأكد_يساوي(ف(4), 369, "حالة 2")
تأكد_يساوي(ف(5), 549, "حالة 3")
تأكد_يساوي(ف(6), 729, "حالة 4")
تأكد_يساوي(ف(12), 1809, "حالة 5")
