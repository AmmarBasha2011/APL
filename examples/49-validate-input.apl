# مثال 49 — التحقق من صحة المدخلات
# Input Validation
# Demonstrates: validation logic, error messages, re
#
# Run:  python apl.py examples/49-validate-input.apl

دالة_تحقق_بريد(نص):
    إذا طول(نص) < 5:
        ارجع خطأ
    إذا "@" not in نص:
        ارجع خطأ
    إذا "." not in نص:
        ارجع خطأ
    ارجع صواب

دالة_تحقق_رقم(نص):
    لكل حرف in نص:
        إذا حرف < "0" أو حرف > "9":
            ارجع خطأ
    ارجع صواب

دالة_طول_كلمة_مرور(نص, الحد):
    إذا طول(نص) < الحد:
        ارجع خطأ
    ارجع صواب

اطبع "=== التحقق من المدخلات ==="
اطبع ""
اطبع "--- بريد إلكتروني ---"
لكل بريد in ["user@example.com", "bad-email", "a@b", "name@site.org"]:
    إذا تحقق_بريد(بريد):
        اطبع "  ✓ " + بريد + ": صالح"
    والا:
        اطبع "  ✗ " + بريد + ": غير صالح"

اطبع ""
اطبع "--- رقم ---"
لكل رقم in ["12345", "12a45", "999"]:
    إذا تحقق_رقم(رقم):
        اطبع "  ✓ " + رقم + ": رقم صحيح"
    والا:
        اطبع "  ✗ " + رقم + ": يحتوي حروف"

اطبع ""
اطبع "--- كلمة مرور ---"
لكل كلمة in ["short", "longenoughpassword"]:
    إذا طول_كلمة_مرور(كلمة, 8):
        اطبع "  ✓ " + كلمة + ": قوية"
    والا:
        اطبع "  ✗ " + كلمة + ": قصيرة"
