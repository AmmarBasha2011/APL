# مثال 2390 — صنف حساب بنكي بسقف سحب
# Bank account with withdraw limit
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2390-class-bank-account-deposit-withdraw-limit.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف حساب:
    دالة_إنشاء(ذات, ر):
        ذات.ر = ر

    دالة ايداع(ذات, م):
        ذات.ر = ذات.ر + م

    دالة سحب(ذات, م):
        لو م > ذات.ر:
            ارجع خطأ
        ذات.ر = ذات.ر - م
        ارجع صواب

ح = حساب(100)
ح.ايداع(50)
تأكد_يساوي(ح.ر, 150, "بعد الإيداع")
تأكد_يساوي(ح.سحب(200), خطأ, "سحب زائد")
تأكد_يساوي(ح.سحب(30), صواب, "سحب مقبول")
تأكد_يساوي(ح.ر, 120, "الرصيد")
