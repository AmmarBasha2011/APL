# مثال 2537 — قيصر بإزاحة 6
# Caesar shift 6
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2537-caesar-shift-by-6-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 6) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "ghi", "حالة 1")
تأكد_يساوي(ف("xyz"), "def", "حالة 2")
تأكد_يساوي(ف("hello world"), "nkrru cuxrj", "حالة 3")
تأكد_يساوي(ف("a1"), "g1", "حالة 4")
