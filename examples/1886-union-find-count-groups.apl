# مثال 1886 — عدد المجموعات بالاتحاد والبحث
# Union find group count
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1886-union-find-count-groups.apl

# نبحث عن جذر كل عنصر
# الدمج يقلل عدد المجموعات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جذر(أب, ع):
  طالما أب[ع] != ع:
    أب[ع] = أب[أب[ع]]
    ع = أب[ع]
  ارجع ع

دالة عد_المجموعات(ن, أزواج):
  أب = []
  لكل ك في نطاق(ن):
    أب.append(ك)
  عدد = ن
  لكل ز في أزواج:
    أ = جذر(أب, ز[0])
    ب = جذر(أب, ز[1])
    لو أ != ب:
      أب[أ] = ب
      عدد = عدد - 1
  ارجع عدد

تأكد_يساوي(عد_المجموعات(5, [[0, 1], [1, 2], [3, 4]]), 2, "مجموعتان")
تأكد_يساوي(عد_المجموعات(3, []), 3, "منفصلة")
تأكد_يساوي(عد_المجموعات(4, [[0, 1], [1, 0]]), 3, "مكرر")
