# مثال 4229 — آخر رقم من ن×27
# Last digit of n times 27
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4229-last-digit-of-n-times-27.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 27) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 7, "حالة 2")
تأكد_يساوي(ف(7), 9, "حالة 3")
تأكد_يساوي(ف(12), 4, "حالة 4")
تأكد_يساوي(ف(99), 3, "حالة 5")
