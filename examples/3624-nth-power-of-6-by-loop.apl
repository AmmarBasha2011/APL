# مثال 3624 — قوة 6 بالحلقة
# Power of 6 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3624-nth-power-of-6-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 6
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 6, "حالة 2")
تأكد_يساوي(ف(3), 216, "حالة 3")
تأكد_يساوي(ف(6), 46656, "حالة 4")
تأكد_يساوي(ف(10), 60466176, "حالة 5")
