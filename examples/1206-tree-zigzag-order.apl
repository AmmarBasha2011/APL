# مثال 1206 — قراءة متعرجة
# Zigzag level order
# Demonstrates: بحث بالعرض
#
# Run:  python apl.py examples/1206-tree-zigzag-order.apl

# المستوى الأول من اليسار والثاني من اليمين وهكذا
# نعكس المستويات الفردية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متعرج(ش):
  ناتج = []
  لو طول(ش) == 0:
    ارجع ناتج
  حالي = [ش]
  اتجاه = 0
  طالما طول(حالي) > 0:
    قيم = []
    تالي = []
    لكل ع في حالي:
      قيم.ألحق(ع[0])
      لو طول(ع[1]) > 0:
        تالي.ألحق(ع[1])
      لو طول(ع[2]) > 0:
        تالي.ألحق(ع[2])
    لو اتجاه == 1:
      قيم.reverse()
    ناتج.ألحق(قيم)
    اتجاه = 1 - اتجاه
    حالي = تالي
  ارجع ناتج

شجرة = [3, [9, [], []], [20, [15, [], []], [7, [], []]]]
تأكد_يساوي(متعرج(شجرة), [[3], [20, 9], [15, 7]], "مثال أول")
تأكد_يساوي(متعرج([]), [], "فارغة")
