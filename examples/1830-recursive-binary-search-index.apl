# مثال 1830 — بحث ثنائي تكراري
# Recursive binary search
# Demonstrates: بحث
#
# Run:  python apl.py examples/1830-recursive-binary-search-index.apl

# نقارن بالمنتصف
# نستدعي النصف المناسب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ابحث(ق, هدف, يسار, يمين):
  لو يسار > يمين:
    ارجع -1
  وسط = (يسار + يمين) // 2
  لو ق[وسط] == هدف:
    ارجع وسط
  لو ق[وسط] < هدف:
    ارجع ابحث(ق, هدف, وسط + 1, يمين)
  ارجع ابحث(ق, هدف, يسار, وسط - 1)

ق = [1, 3, 5, 7, 9, 11]
تأكد_يساوي(ابحث(ق, 7, 0, 5), 3, "وجد")
تأكد_يساوي(ابحث(ق, 4, 0, 5), -1, "لم يوجد")
تأكد_يساوي(ابحث(ق, 1, 0, 5), 0, "الأول")
