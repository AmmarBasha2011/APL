# مثال 1732 — هل الكلمتان جناس
# Anagram check by sorted letters
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1732-anagram-pair-check-sorted.apl

# نرتب حروف الكلمة
# نقارن القائمتين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حروف_مرتبة(س):
  ح = []
  لكل ك في س:
    ح.append(ك)
  ح.sort()
  ارجع ح

دالة جناس(أ, ب):
  ارجع حروف_مرتبة(أ) == حروف_مرتبة(ب)

تأكد_يساوي(جناس("listen", "silent"), صواب, "جناس")
تأكد_يساوي(جناس("abc", "abd"), خطأ, "ليس جناساً")
تأكد_يساوي(جناس("a", "aa"), خطأ, "طول مختلف")
