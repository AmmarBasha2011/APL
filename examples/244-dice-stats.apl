# مثال 244 — إحصاءات رمي النرد
# Dice roll statistics
# Demonstrates: عشوائي_عدد، عدّاد تكرارات
#
# Run:  python apl.py examples/244-dice-stats.apl

بذرة(11)
المتغير تكرارات = {}
لكل _ في نطاق(1000):
    المتغير مجموع = عشوائي_عدد(1, 6) + عشوائي_عدد(1, 6)
    لو مجموع في تكرارات:
        تكرارات[مجموع] = تكرارات[مجموع] + 1
    الا:
        تكرارات[مجموع] = 1

لكل مفتاح في مفرز(قائمة(تكرارات.keys())):
    المتغير نسبة = تكرارات[مفتاح] / 10
    اطبع مفتاح, ":", تكرارات[مفتاح], "(", نسبة, "%)"
