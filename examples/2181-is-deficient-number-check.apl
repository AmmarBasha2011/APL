# مثال 2181 — هل العدد ناقص
# Is number deficient
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2181-is-deficient-number-check.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن):
    لو ن % ي == 0:
      م = م + ي
  ارجع م < ن

تأكد_يساوي(ف(8), صواب, "حالة 8")
تأكد_يساوي(ف(12), خطأ, "حالة 12")
تأكد_يساوي(ف(9), صواب, "حالة 9")
تأكد_يساوي(ف(28), خطأ, "حالة 28")
تأكد_يساوي(ف(7), صواب, "حالة 7")
