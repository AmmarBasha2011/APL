# مثال 948 — شفرة هامنغ
# Hamming code
# Demonstrates: بتات توازن ومتلازمة
#
# Run:  python apl.py examples/948-hamming-code.apl

# شفرة هامنغ (7,4): تصحيح خطأ واحد في 4 بتات بيانات
# ثلاث بتات توازن تكشف موضع الخطأ بمتلازمة ثنائية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مواضع البتات: 1,2,4 توازن؛ 3,5,6,7 بيانات (فهرسة 1-مبنية)
دالة شفر(بيانات):
  # بيانات = [د1, د2, د3, د4]
  د1 = بيانات[0]
  د2 = بيانات[1]
  د3 = بيانات[2]
  د4 = بيانات[3]
  ت1 = د1 ^ د2 ^ د4
  ت2 = د1 ^ د3 ^ د4
  ت3 = د2 ^ د3 ^ د4
  ارجع [ت1, ت2, د1, ت3, د2, د3, د4]

دالة متلازمة(شفرة):
  س1 = شفرة[0] ^ شفرة[2] ^ شفرة[4] ^ شفرة[6]
  س2 = شفرة[1] ^ شفرة[2] ^ شفرة[5] ^ شفرة[6]
  س3 = شفرة[3] ^ شفرة[4] ^ شفرة[5] ^ شفرة[6]
  ارجع س1 + س2 * 2 + س3 * 4

شفرة = شفر([1, 0, 1, 1])
اطبع "شفرة 1011:", شفرة

تأكد_يساوي(طول(شفرة), 7, "سبع بتات")
متوقع = [0, 1, 1, 0, 0, 1, 1]
لكل i في نطاق(7):
  تأكد_يساوي(شفرة[i], متوقع[i], "بت " + نص(i))

# بلا خطأ: المتلازمة صفر
تأكد_يساوي(متلازمة(شفرة), 0, "لا خطأ")

# أدخل خطأ في الموضع 4 (فهرس 3): المتلازمة = 4
معطوبة = []
لكل i في نطاق(7):
  لو i == 3:
    معطوبة.ألحق(1 - شفرة[i])
  والا:
    معطوبة.ألحق(شفرة[i])
تأكد_يساوي(متلازمة(معطوبة), 4, "المتلازمة تشير للموضع 4")

# صحح: اقلب البتة عند (المتلازمة - 1) واستخرج البيانات
موضع = متلازمة(معطوبة) - 1
مصححة = []
لكل i في نطاق(7):
  لو i == موضع:
    مصححة.ألحق(1 - معطوبة[i])
  والا:
    مصححة.ألحق(معطوبة[i])
تأكد_يساوي(مصححة[2], 1, "بيانات 1")
تأكد_يساوي(مصححة[4], 0, "بيانات 2")
تأكد_يساوي(مصححة[5], 1, "بيانات 3")
تأكد_يساوي(مصححة[6], 1, "بيانات 4")
