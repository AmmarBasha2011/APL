# مثال 1943 — غرامة تأخير كتب المكتبة
# Library late fine
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1943-library-fine-days-late.apl

# # نحسب الأيام المتأخرة بعد فترة السماح
# # ونحدد الغرامة لكل كتاب بسقف 20

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة غرامة(ايام_التأخر):
  فعلي = ايام_التأخر - 3
  لو فعلي <= 0:
    ارجع 0
  ارجع أصغر(فعلي * 2, 20)

دالة مجموع_الغرامات(قائمة):
  مج = 0
  لكل ع في قائمة:
    مج = مج + غرامة(ع)
  ارجع مج

تأكد_يساوي(غرامة(2), 0, "ضمن السماح")
تأكد_يساوي(غرامة(5), 4, "يومان")
تأكد_يساوي(غرامة(30), 20, "سقف")
تأكد_يساوي(مجموع_الغرامات([0, 4, 10, 50]), 2 + 14 + 20, "مجموع")
