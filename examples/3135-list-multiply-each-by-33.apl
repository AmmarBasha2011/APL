# مثال 3135 — ضرب كل عنصر في 33
# Multiply each item by 33
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3135-list-multiply-each-by-33.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 33]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [99, 33, 66], "حالة 1")
تأكد_يساوي(ف([5]), [165], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [33, 66, 99, 132, 165, 198], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-66, 0, 231, 231, 132], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [330, 660, 330, 990, 660, 330], "حالة 5")
