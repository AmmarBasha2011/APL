# مثال 929 — وسيط الوسائط
# Median of medians
# Demonstrates: محور مضمون الجودة
#
# Run:  python apl.py examples/929-median-of-medians.apl

# وسيط الوسائط: اختيار العنصر k بضمان خطي في أسوأ حالة
# يقسم حول وسيط وسائط مجموعات الخمسات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رتب(قيم):
  م = []
  لكل x في قيم:
    م.ألحق(x)
  ن = طول(م)
  لكل i في نطاق(ن):
    لكل ج في نطاق(i + 1, ن):
      لو م[ج] < م[i]:
        مؤقت = م[i]
        م[i] = م[ج]
        م[ج] = مؤقت
  ارجع م

دالة اختر(قيم, ك):
  لو طول(قيم) <= 5:
    ارجع رتب(قيم)[ك]
  وسائط = []
  i = 0
  طالما i < طول(قيم):
    نهاية = i + 5
    لو نهاية > طول(قيم):
      نهاية = طول(قيم)
    مجموعة = رتب(قيم[i:نهاية])
    وسائط.ألحق(مجموعة[طول(مجموعة) // 2])
    i = i + 5
  محور = اختر(وسائط, طول(وسائط) // 2)
  أصغر = []
  مساو = []
  أكبر = []
  لكل x في قيم:
    لو x < محور:
      أصغر.ألحق(x)
    والا_لو x == محور:
      مساو.ألحق(x)
    والا:
      أكبر.ألحق(x)
  لو ك < طول(أصغر):
    ارجع اختر(أصغر, ك)
  لو ك < طول(أصغر) + طول(مساو):
    ارجع محور
  ارجع اختر(أكبر, ك - طول(أصغر) - طول(مساو))

قيم = [7, 2, 1, 6, 8, 5, 3, 4]
اطبع "الخامس تصاعدياً:", اختر(قيم, 4)

# المرتبة تصاعدياً: [1,2,3,4,5,6,7,8] والموضع 4 هو 5
تأكد_يساوي(اختر(قيم, 4), 5, "الوسيط")
تأكد_يساوي(اختر(قيم, 0), 1, "الأصغر")
تأكد_يساوي(اختر(قيم, 7), 8, "الأكبر")

# يطابق الفرز على كل المواضع
مرتبة = رتب(قيم)
لكل i في نطاق(طول(قيم)):
  تأكد_يساوي(اختر(قيم, i), مرتبة[i], "موضع " + نص(i))

# مع تكرارات
مكررة = [3, 1, 3, 3, 1]
تأكد_يساوي(اختر(مكررة, 2), 3, "وسيط مكررة")
