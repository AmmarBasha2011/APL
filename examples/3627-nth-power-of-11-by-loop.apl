# مثال 3627 — قوة 11 بالحلقة
# Power of 11 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3627-nth-power-of-11-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 11
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 11, "حالة 2")
تأكد_يساوي(ف(3), 1331, "حالة 3")
تأكد_يساوي(ف(6), 1771561, "حالة 4")
تأكد_يساوي(ف(10), 25937424601, "حالة 5")
