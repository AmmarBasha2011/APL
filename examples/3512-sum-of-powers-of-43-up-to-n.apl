# مثال 3512 — مجموع قوى 43
# Sum of powers of 43
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3512-sum-of-powers-of-43-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 43 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 44, "حالة 2")
تأكد_يساوي(ف(3), 81400, "حالة 3")
تأكد_يساوي(ف(6), 6471871693, "حالة 4")
تأكد_يساوي(ف(10), 22126041415981493, "حالة 5")
