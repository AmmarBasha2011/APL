# مثال 486 — مقسم المصاريف
# Expense splitter
# Demonstrates: تقسيم فاتورة رحلة بالتساوي
#
# Run:  python apl.py examples/486-expense-splitter.apl

المتغير مصاريف = [
    {"دافع": "عمار", "مبلغ": 300},
    {"دافع": "سارة", "مبلغ": 150},
    {"دافع": "خالد", "مبلغ": 60}
]

المتغير أسماء = ["عمار", "سارة", "خالد"]
المتغير إجمالي = 0
لكل مصروف في مصاريف:
    إجمالي = إجمالي + مصروف["مبلغ"]
المتغير نصيب = إجمالي / طول(أسماء)

اطبع "الإجمالي:", إجمالي, "- نصيب كل واحد:", نصيب
لكل مصروف في مصاريف:
    المتغير فرق = مصروف["مبلغ"] - نصيب
    لو فرق > 0:
        اطبع مصروف["دافع"], "يستحق", فرق
    الا لو فرق < 0:
        اطبع مصروف["دافع"], "يدفع", مطلق(فرق)
    الا:
        اطبع مصروف["دافع"], "متساوي"
