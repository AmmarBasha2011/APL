# مثال 3028 — مجموع قوى 28
# Sum of powers of 28
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3028-sum-of-powers-of-28-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 28 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 29, "حالة 2")
تأكد_يساوي(ف(3), 22765, "حالة 3")
تأكد_يساوي(ف(6), 499738093, "حالة 4")
تأكد_يساوي(ف(10), 307167017313773, "حالة 5")
