# مثال 2283 — السنة الكبيسة
# Leap year check
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2283-leap-year-gregorian-rule-check.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن % 400 == 0:
    ارجع صواب
  لو ن % 100 == 0:
    ارجع خطأ
  ارجع ن % 4 == 0

تأكد_يساوي(ف(1900), خطأ, "حالة 1")
تأكد_يساوي(ف(2000), صواب, "حالة 2")
تأكد_يساوي(ف(2024), صواب, "حالة 3")
تأكد_يساوي(ف(2023), خطأ, "حالة 4")
تأكد_يساوي(ف(2100), خطأ, "حالة 5")
