# مثال 906 — الالتواء والتفرطح
# Skewness and kurtosis
# Demonstrates: علات مركزية معيارية
#
# Run:  python apl.py examples/906-skewness-kurtosis.apl

# الالتواء والتفرطح: العلتان الثالثة والرابعة للتوزيع
# الالتواء يقيس عدم التماثل والتفرطح ثقل الأذيال

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة وسط(قيم):
  مجموع = 0
  لكل x في قيم:
    مجموع = مجموع + x
  ارجع مجموع / طول(قيم)

دالة علة_مركزية(قيم, رتبة):
  م = وسط(قيم)
  مجموع = 0
  لكل x في قيم:
    مجموع = مجموع + (x - م) ** رتبة
  ارجع مجموع / طول(قيم)

دالة التواء(قيم):
  ع2 = علة_مركزية(قيم, 2)
  ع3 = علة_مركزية(قيم, 3)
  ارجع ع3 / ع2 ** 1.5

دالة تفرطح(قيم):
  ع2 = علة_مركزية(قيم, 2)
  ع4 = علة_مركزية(قيم, 4)
  ارجع ع4 / ع2 ** 2 - 3

قيم = [1, 2, 3, 4, 10]
التواء_ق = التواء(قيم)
تفرطح_ق = تفرطح(قيم)
اطبع "الالتواء:", التواء_ق
اطبع "التفرطح الزائد:", تفرطح_ق

# القيمة المتطرفة 10 تسحب الذيل يميناً: التواء موجب
تأكد_يساوي(مقرب(التواء_ق, 4), 1.1384, "التواء موجب")
تأكد_يساوي(مقرب(تفرطح_ق, 3), -0.212, "تفرطح")

# التوزيع المتماثل التواؤه صفر
تأكد_يساوي(مقرب(التواء([1, 2, 3, 4, 5]), 9), 0, "متماثل")
