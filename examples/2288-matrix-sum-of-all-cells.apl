# مثال 2288 — مجموع كل الخلايا
# Sum of all cells
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2288-matrix-sum-of-all-cells.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ت = 0
  لكل ص في م:
    لكل ع في ص:
      ت = ت + ع
  ارجع ت

تأكد_يساوي(ف([[1, 2], [3, 4]]), 10, "حالة 1")
تأكد_يساوي(ف([[5]]), 5, "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), 45, "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), 2, "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), 8, "حالة 5")
