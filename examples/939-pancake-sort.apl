# مثال 939 — فرز الفطائر
# Pancake sort
# Demonstrates: قلب البوادئ فقط
#
# Run:  python apl.py examples/939-pancake-sort.apl

# فرز الفطائر: الفرز الوحيد المسموح هو قلب بادئة
# كل عنصر يصل لموضعه بقلبين كحد أقصى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقلب(م, حتى):
  نتيجة = []
  لكل i في نطاق(حتى + 1):
    نتيجة.ألحق(م[حتى - i])
  لكل i في نطاق(حتى + 1, طول(م)):
    نتيجة.ألحق(م[i])
  ارجع نتيجة

دالة فرز_فطائر(قيم):
  م = []
  لكل x في قيم:
    م.ألحق(x)
  قلبات = 0
  حجم = طول(م)
  طالما حجم > 1:
    # موضع الأكبر في أول حجم عنصر
    أعظم = 0
    لكل i في نطاق(حجم):
      لو م[i] > م[أعظم]:
        أعظم = i
    لو أعظم != حجم - 1:
      لو أعظم > 0:
        م = اقلب(م, أعظم)
        قلبات = قلبات + 1
      م = اقلب(م, حجم - 1)
      قلبات = قلبات + 1
    حجم = حجم - 1
  ارجع [م, قلبات]

نتيجة = فرز_فطائر([3, 1, 2])
اطبع "المرتبة:", نتيجة[0]
اطبع "القلبات:", نتيجة[1]

تأكد_يساوي(نتيجة[0][0], 1, "أول")
تأكد_يساوي(نتيجة[0][1], 2, "ثانٍ")
تأكد_يساوي(نتيجة[0][2], 3, "ثالث")
تأكد_يساوي(نتيجة[1], 2, "قلبتان تكفيان")

# مرتبة أصلاً: صفر قلبات
تأكد_يساوي(فرز_فطائر([1, 2, 3])[1], 0, "مرتبة بلا قلبات")

# معكوسة كلياً
عكس = فرز_فطائر([4, 3, 2, 1])
تأكد_يساوي(عكس[0][0], 1, "عكس أول")
تأكد_يساوي(عكس[0][3], 4, "عكس أخير")
# حد أعلى نظري: 2ن-3 قلبات
لو عكس[1] > 2 * 4 - 3:
  اطبع "فشل: تجاوز الحد النظري"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: ضمن الحد النظري"
