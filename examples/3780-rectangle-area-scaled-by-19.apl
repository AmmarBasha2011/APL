# مثال 3780 — مساحة مستطيل مكبر 19 مرات
# Rectangle area scaled by 19
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3780-rectangle-area-scaled-by-19.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 19) * (ق[1] * 19)

تأكد_يساوي(ف([1, 2]), 722, "حالة 1")
تأكد_يساوي(ف([3, 4]), 4332, "حالة 2")
تأكد_يساوي(ف([5, 5]), 9025, "حالة 3")
تأكد_يساوي(ف([10, 1]), 3610, "حالة 4")
