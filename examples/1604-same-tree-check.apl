# مثال 1604 — هل الشجرتان متطابقتان
# Same tree check
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1604-same-tree-check.apl

# الفارغتان متطابقتان
# نقارن الجذر ثم الفرعين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متطابقتان(أ, ب):
  لو أ == [] و ب == []:
    ارجع صواب
  لو أ == [] أو ب == []:
    ارجع خطأ
  لو أ[0] != ب[0]:
    ارجع خطأ
  ارجع متطابقتان(أ[1], ب[1]) و متطابقتان(أ[2], ب[2])

تأكد_يساوي(متطابقتان([1, [2, [], []], []], [1, [2, [], []], []]), صواب, "متطابقتان")
تأكد_يساوي(متطابقتان([1, [2, [], []], []], [1, [], [2, [], []]]), خطأ, "شكل مختلف")
تأكد_يساوي(متطابقتان([], []), صواب, "فارغتان")
