# مثال 2810 — السعر مع ضريبة 6 بالمئة
# Price with 6 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2810-price-with-6-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 6 // 100

تأكد_يساوي(ف(100), 106, "حالة 1")
تأكد_يساوي(ف(250), 265, "حالة 2")
تأكد_يساوي(ف(999), 1058, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
