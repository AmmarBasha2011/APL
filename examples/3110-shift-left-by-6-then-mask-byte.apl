# مثال 3110 — إزاحة يسار 6 مع قناع بايت
# Shift left 6 and mask byte
# Demonstrates: بتات
#
# Run:  python apl.py examples/3110-shift-left-by-6-then-mask-byte.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن << 6) & 255

تأكد_يساوي(ف(1), 64, "حالة 1")
تأكد_يساوي(ف(3), 192, "حالة 2")
تأكد_يساوي(ف(85), 64, "حالة 3")
تأكد_يساوي(ف(170), 128, "حالة 4")
تأكد_يساوي(ف(255), 192, "حالة 5")
