# مثال 426 — بيلمان فورد
# Bellman-Ford
# Demonstrates: مسارات بأوزان سالبة
#
# Run:  python apl.py examples/426-bellman-ford.apl

المتغير حواف = [[0, 1, 5], [0, 2, 4], [1, 2, -3], [2, 3, 2], [1, 3, 6]]
المتغير مسافات = {0: 0, 1: 999, 2: 999, 3: 999}

لكل _ في نطاق(3):
    لكل حافة في حواف:
        لو مسافات[حافة[0]] + حافة[2] < مسافات[حافة[1]]:
            مسافات[حافة[1]] = مسافات[حافة[0]] + حافة[2]

اطبع "المسافات من 0:", مسافات
