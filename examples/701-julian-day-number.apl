# مثال 701 — رقم اليوم الجولياني
# Julian day number
# Demonstrates: تحويل ذو اتجاهين، يوم أسبوع، فرق
#
# Run:  python apl.py examples/701-julian-day-number.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# رقم اليوم الجولياني: التحويل في الاتجاهين ويوم الأسبوع
# Demonstrates: تحويل تاريخ إلى رقم مطلق, عكسه, فرق الأيام
# الفرق بين تاريخين هو مجرد طرح

دالة إلى_جولياني(سنة, شهر, يوم):
  أ = (14 - شهر) // 12
  س2 = سنة + 4800 - أ
  ش2 = شهر + 12 * أ - 3
  ارجع يوم + (153 * ش2 + 2) // 5 + 365 * س2 + س2 // 4 - س2 // 100 + س2 // 400 - 32045

دالة من_جولياني(ج):
  ل = ج + 68569
  ن = (4 * ل) // 146097
  ل = ل - (146097 * ن + 3) // 4
  ي = (4000 * (ل + 1)) // 1461001
  ل = ل - (1461 * ي) // 4 + 31
  ش = (80 * ل) // 2447
  يوم = ل - (2447 * ش) // 80
  ل = ش // 11
  شهر = ش + 2 - 12 * ل
  سنة = 100 * (ن - 49) + ي + ل
  ارجع [سنة, شهر, يوم]

دالة يوم_أسبوع(ج):
  أسماء = ["أحد", "اثنين", "ثلاثاء", "أربعاء", "خميس", "جمعة", "سبت"]
  ارجع أسماء[(ج + 1) % 7]

تأكد_يساوي(إلى_جولياني(2000, 1, 1), 2451545, "ألفينية")
تأكد_يساوي(إلى_جولياني(1970, 1, 1), 2440588, "عصر يونكس")
تأكد_يساوي(من_جولياني(2451545), [2000, 1, 1], "العكس ألفينية")
تأكد_يساوي(من_جولياني(2440588), [1970, 1, 1], "العكس يونكس")
تأكد_يساوي(يوم_أسبوع(2451545), "سبت", "أول 2000 كان سبتا")
تأكد_يساوي(يوم_أسبوع(إلى_جولياني(2024, 2, 29)), "خميس", "كبيسة 2024 خميس")
تأكد_يساوي(إلى_جولياني(2024, 3, 1) - إلى_جولياني(2024, 2, 1), 29, "فبراير الكبيس 29")
عمر = إلى_جولياني(2024, 1, 1) - إلى_جولياني(2000, 9, 9)
تأكد_يساوي(عمر, 8514, "فرق تاريخين بالأيام")
اطبع "يوم 2000-01-01:", يوم_أسبوع(2451545)
