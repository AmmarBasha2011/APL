# مثال 1195 — برتقال عفن
# Rotting oranges
# Demonstrates: بحث بالعرض
#
# Run:  python apl.py examples/1195-rotting-oranges.apl

# كل دقيقة يعفن جيران العفن الأربعة
# نمشي بالعرض من كل برتقالة فاسدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة دقائق(ش):
  ص_ = طول(ش)
  ج_ = طول(ش[0])
  طابور = []
  طازج = 0
  لكل ص في نطاق(ص_):
    لكل ج في نطاق(ج_):
      لو ش[ص][ج] == 2:
        طابور.ألحق([ص, ج, 0])
      والا_لو ش[ص][ج] == 1:
        طازج = طازج + 1
  ع = 0
  وقت = 0
  اتجاهات = [[1, 0], [-1, 0], [0, 1], [0, -1]]
  طالما ع < طول(طابور):
    ص = طابور[ع][0]
    ج = طابور[ع][1]
    وقت = طابور[ع][2]
    ع = ع + 1
    لكل د في اتجاهات:
      ر = ص + د[0]
      ك = ج + د[1]
      لو (ر >= 0) و (ر < ص_) و (ك >= 0) و (ك < ج_):
        لو ش[ر][ك] == 1:
          ش[ر][ك] = 2
          طازج = طازج - 1
          طابور.ألحق([ر, ك, وقت + 1])
  لو طازج > 0:
    ارجع -1
  ارجع وقت

تأكد_يساوي(دقائق([[2,1,1],[1,1,0],[0,1,1]]), 4, "مثال أول")
تأكد_يساوي(دقائق([[2,1,1],[0,1,1],[1,0,1]]), -1, "معزولة")
تأكد_يساوي(دقائق([[0,2]]), 0, "لا طازج")
تأكد_يساوي(دقائق([[1]]), -1, "طازجة فقط")
