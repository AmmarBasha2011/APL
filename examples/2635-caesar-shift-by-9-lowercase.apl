# مثال 2635 — قيصر بإزاحة 9
# Caesar shift 9
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2635-caesar-shift-by-9-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 9) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "jkl", "حالة 1")
تأكد_يساوي(ف("xyz"), "ghi", "حالة 2")
تأكد_يساوي(ف("hello world"), "qnuux fxaum", "حالة 3")
تأكد_يساوي(ف("a1"), "j1", "حالة 4")
