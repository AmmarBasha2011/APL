# مثال 2852 — إضافة 23 لكل عنصر
# Add 23 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2852-list-add-23-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 23]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [26, 24, 25], "حالة 1")
تأكد_يساوي(ف([5]), [28], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [24, 25, 26, 27, 28, 29], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [21, 23, 30, 30, 27], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [33, 43, 33, 53, 43, 33], "حالة 5")
