# مثال 2148 — التبديلة رقم ن بالمضروب
# Nth permutation factoradic
# Demonstrates: توافيق
#
# Run:  python apl.py examples/2148-nth-permutation-of-string-factoradic.apl

# # نحذف الحرف المختار
# # ونكمل بالباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تبديلة(س, ن):
  باقي = sorted(س)
  مض = 1
  لكل ك في نطاق(2, طول(س)):
    مض = مض * ك
  خرج = ""
  لكل ك في نطاق(طول(س)):
    ف = ن // مض
    خرج = خرج + باقي[ف]
    باقي.pop(ف)
    ن = ن % مض
    لو طول(س) - 1 - ك > 0:
      مض = مض // (طول(س) - 1 - ك)
  ارجع خرج

تأكد_يساوي(تبديلة("abc", 3), "bca", "الرابعة")
تأكد_يساوي(تبديلة("abc", 5), "cba", "الأخيرة")
تأكد_يساوي(تبديلة("abcd", 0), "abcd", "الأولى")
تأكد_يساوي(تبديلة("abcd", 23), "dcba", "آخر أربعة")
