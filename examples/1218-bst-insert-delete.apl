# مثال 1218 — إدراج وحذف شجرة بحث
# BST insert and delete
# Demonstrates: شجرة بحث
#
# Run:  python apl.py examples/1218-bst-insert-delete.apl

# الحذف لعقدة بابنين يستبدلها بأصغر قيمة في الفرع الأيمن
# ونعيد بناء الفروع بدوال ذاتية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادرج(ش, ق):
  لو طول(ش) == 0:
    ارجع [ق, [], []]
  لو ق < ش[0]:
    ارجع [ش[0], ادرج(ش[1], ق), ش[2]]
  لو ق > ش[0]:
    ارجع [ش[0], ش[1], ادرج(ش[2], ق)]
  ارجع ش

دالة اصغر_قيمة(ش):
  طالما طول(ش[1]) > 0:
    ش = ش[1]
  ارجع ش[0]

دالة احذف_قيمة(ش, ق):
  لو طول(ش) == 0:
    ارجع []
  لو ق < ش[0]:
    ارجع [ش[0], احذف_قيمة(ش[1], ق), ش[2]]
  لو ق > ش[0]:
    ارجع [ش[0], ش[1], احذف_قيمة(ش[2], ق)]
  لو طول(ش[1]) == 0:
    ارجع ش[2]
  لو طول(ش[2]) == 0:
    ارجع ش[1]
  خلف = اصغر_قيمة(ش[2])
  ارجع [خلف, ش[1], احذف_قيمة(ش[2], خلف)]

دالة قراءة(ش):
  لو طول(ش) == 0:
    ارجع []
  ارجع قراءة(ش[1]) + [ش[0]] + قراءة(ش[2])

ش = []
لكل ق في [5, 3, 7, 2, 4, 6, 8]:
  ش = ادرج(ش, ق)
تأكد_يساوي(قراءة(ش), [2, 3, 4, 5, 6, 7, 8], "بعد الإدراج")
ش = احذف_قيمة(ش, 3)
تأكد_يساوي(قراءة(ش), [2, 4, 5, 6, 7, 8], "حذف ببن")
ش = احذف_قيمة(ش, 5)
تأكد_يساوي(قراءة(ش), [2, 4, 6, 7, 8], "حذف الجذر")
ش = احذف_قيمة(ش, 100)
تأكد_يساوي(قراءة(ش), [2, 4, 6, 7, 8], "غير موجود")
