# مثال 2154 — صنف متجه ثنائي الأبعاد
# 2D vector class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2154-vector-two-d-class-add-dot.apl

# # المتجه مركبتان
# # العمليات ترجع قيما جديدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف متجه:
    دالة_إنشاء(ذات, س, ص):
        ذات.س = س
        ذات.ص = ص

    دالة اجمع(ذات, ا):
        ارجع متجه(ذات.س + ا.س, ذات.ص + ا.ص)

    دالة نقطي(ذات, ا):
        ارجع ذات.س * ا.س + ذات.ص * ا.ص

    دالة طول_مربع(ذات):
        ارجع ذات.نقطي(ذات)

ا = متجه(1, 2)
ب = متجه(3, 4)
ج = ا.اجمع(ب)
تأكد_يساوي([ج.س, ج.ص], [4, 6], "الجمع")
تأكد_يساوي(ا.نقطي(ب), 11, "نقطي")
تأكد_يساوي(ب.طول_مربع(), 25, "طول مربع")
