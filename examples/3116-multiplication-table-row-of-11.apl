# مثال 3116 — صف جدول ضرب 11
# Multiplication row of 11
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3116-multiplication-table-row-of-11.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 11]
  ارجع ر

تأكد_يساوي(ف(1), [11], "حالة 1")
تأكد_يساوي(ف(5), [11, 22, 33, 44, 55], "حالة 2")
تأكد_يساوي(ف(10), [11, 22, 33, 44, 55, 66, 77, 88, 99, 110], "حالة 3")
