# مثال 636 — خوارزمية المصرفي
# Banker algorithm
# Demonstrates: جمود، حالة آمنة، موارد
#
# Run:  python apl.py examples/636-banker-algorithm.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# خوارزمية المصرفي: هل الحالة آمنة من الجمود؟
# Demonstrates: مصفوفات تخصيص واحتياج, بحث عن تسلسل آمن
# الحالة آمنة إذا وُجد ترتيب تكمل به كل العمليات

متاح = [3, 3, 2]
أقصى = [[7,5,3],[3,2,2],[9,0,2],[2,2,2],[4,3,3]]
مخصص = [[0,1,0],[2,0,0],[3,0,2],[2,1,1],[0,0,2]]

دالة آمنة(متاح, أقصى, مخصص):
  ن = طول(أقصى)
  عمل = متاح.copy()
  منتهية = [خطأ] * ن
  تسلسل = []
  طالما طول(تسلسل) < ن:
    تقدم = خطأ
    لكل ي في نطاق(ن):
      لو منتهية[ي] == خطأ:
        يكفي = صواب
        لكل م في نطاق(طول(عمل)):
          لو أقصى[ي][م] - مخصص[ي][م] > عمل[م]:
            يكفي = خطأ
        لو يكفي:
          لكل م في نطاق(طول(عمل)):
            عمل[م] = عمل[م] + مخصص[ي][م]
          منتهية[ي] = صواب
          تسلسل.append(ي)
          تقدم = صواب
    لو تقدم == خطأ:
      ارجع []
  ارجع تسلسل

نتيجة = آمنة(متاح, أقصى, مخصص)
اطبع "تسلسل آمن:", نتيجة
تأكد_يساوي(طول(نتيجة), 5, "المثال الكلاسيكي آمن")
تأكد_يساوي(نتيجة[0], 1, "العملية 1 أولا")
تأكد_يساوي(آمنة([1, 0, 0], أقصى, مخصص), [], "نقص الموارد غير آمن")
