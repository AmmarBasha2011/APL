# مثال 602 — الجدول المتناثر
# Sparse table RMQ
# Demonstrates: جدول متناثر، أدنى مدى، تجهيز مسبق
#
# Run:  python apl.py examples/602-sparse-table.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الجدول المتناثر: أدنى مدى بزمن ثابت بعد تجهيز
# Demonstrates: قوى اثنين, تجهيز مسبق, استعلام O(1) لدالة idempotent
# مناسب للمصفوفات الثابتة كثيرة الاستعلامات

أرقام = [4, 6, 1, 5, 7, 3, 9, 2]
ن = طول(أرقام)
سجل = [0] * (ن + 1)
لكل ي في نطاق(2, ن + 1):
  سجل[ي] = سجل[ي // 2] + 1
أعمدة = سجل[ن] + 1

جدول = []
لكل ي في نطاق(ن):
  جدول.append([0] * أعمدة)
لكل ي في نطاق(ن):
  جدول[ي][0] = أرقام[ي]
لكل ع في نطاق(1, أعمدة):
  طول_القفزة = 2 ** ع
  نصف = طول_القفزة // 2
  لكل ي في نطاق(ن - طول_القفزة + 1):
    جدول[ي][ع] = أصغر(جدول[ي][ع - 1], جدول[ي + نصف][ع - 1])

دالة أدنى_مدى(أ, ب):
  ع = سجل[ب - أ + 1]
  طول_القفزة = 2 ** ع
  ارجع أصغر(جدول[أ][ع], جدول[ب - طول_القفزة + 1][ع])

تأكد_يساوي(أدنى_مدى(0, 7), 1, "أدنى الكل")
تأكد_يساوي(أدنى_مدى(3, 6), 3, "أدنى مدى وسطي")
تأكد_يساوي(أدنى_مدى(2, 2), 1, "عنصر واحد")
تأكد_يساوي(أدنى_مدى(5, 7), 2, "مدى أخير")
اطبع "أدنى المدى 1-4:", أدنى_مدى(1, 4)
