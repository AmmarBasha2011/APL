# مثال 827 — الزواج المستقر
# Gale-Shapley
# Demonstrates: قبول مؤجل، قوائم تفضيل
#
# Run:  python apl.py examples/827-gale-shapley.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# زواج مستقر بقبول مؤجل: الرجال يعرضون والنساء يخترن الأفضل
# Demonstrates: قوائم تفضيل, خطوبة قابلة للاستبدال, استقرار مضمون

عروض_رجال = [["س", "ل", "م"], ["ل", "س", "م"], ["س", "م", "ل"]]
تفضيل_نساء = [["ب", "أ", "ج"], ["أ", "ب", "ج"], ["أ", "ج", "ب"]]
رجال = ["أ", "ب", "ج"]
نساء = ["س", "ل", "م"]

دالة زواج():
  خطوبة = [0 - 1, 0 - 1, 0 - 1]
  تالي = [0, 0, 0]
  أحرار = [0, 1, 2]
  طالما طول(أحرار) > 0:
    رجل = أحرار.pop(0)
    امرأة = نساء.index(عروض_رجال[رجل][تالي[رجل]])
    تالي[رجل] = تالي[رجل] + 1
    لو خطوبة[امرأة] == 0 - 1:
      خطوبة[امرأة] = رجل
    والا:
      حالي = خطوبة[امرأة]
      لو تفضيل_نساء[امرأة].index(رجال[رجل]) < تفضيل_نساء[امرأة].index(رجال[حالي]):
        خطوبة[امرأة] = رجل
        أحرار.append(حالي)
      والا:
        أحرار.append(رجل)
  ناتج = []
  لكل ي في نطاق(3):
    ناتج.append([رجال[خطوبة[ي]], نساء[ي]])
  ارجع ناتج

نتيجة = زواج()
تأكد_يساوي(نتيجة, [["أ", "س"], ["ب", "ل"], ["ج", "م"]], "الزواج المستقر")
تأكد_يساوي(طول(نتيجة), 3, "ثلاثة أزواج")
