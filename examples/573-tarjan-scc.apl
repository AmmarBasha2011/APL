# مثال 573 — مكونات تارجان القوية
# Tarjan strongly connected components
# Demonstrates: تارجان، مكونات قوية، رسم موجه
#
# Run:  python apl.py examples/573-tarjan-scc.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# مكونات تارجان المتصلة قوياً (رسم موجه)
المتغير رسم = {"أ": ["ب"], "ب": ["ج"], "ج": ["أ", "د"], "د": ["هـ"], "هـ": ["د"]}
المتغير فهارس = قاموس()
المتغير منخفض = قاموس()
المتغير مكدس = قائمة()
المتغير على_مكدس = قاموس()
المتغير عداد = [0]
المتغير مكونات = قائمة()

دالة قوي(عقدة):
    فهارس[عقدة] = عداد[0]
    منخفض[عقدة] = عداد[0]
    عداد[0] = عداد[0] + 1
    مكدس.أضف(عقدة)
    على_مكدس[عقدة] = صواب
    لكل جار في رسم[عقدة]:
        لو جار ليس في فهارس:
            قوي(جار)
            منخفض[عقدة] = أصغر(منخفض[عقدة], منخفض[جار])
        الا لو جار في على_مكدس:
            منخفض[عقدة] = أصغر(منخفض[عقدة], فهارس[جار])
    لو منخفض[عقدة] == فهارس[عقدة]:
        المتغير مكون = قائمة()
        المتغير قمة = ""
        طالما قمة != عقدة:
            قمة = مكدس.pop()
            مكون.أضف(قمة)
            على_مكدس[قمة] = خطأ
        مكونات.أضف(مفرز(مكون))

لكل عقدة في رسم:
    لو عقدة ليس في فهارس:
        قوي(عقدة)

اطبع "المكونات:", مكونات
تأكد_يساوي(طول(مكونات), 2, "مكونان")
تأكد_يساوي(مكونات[0], ["د", "هـ"], "دورة د-هـ")
تأكد_يساوي(مكونات[1], ["أ", "ب", "ج"], "دورة أ-ب-ج")
