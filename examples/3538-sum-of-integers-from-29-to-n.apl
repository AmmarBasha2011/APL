# مثال 3538 — مجموع الأعداد من 29 إلى ن
# Sum from 29 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3538-sum-of-integers-from-29-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(29, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(29), 29, "حالة 1")
تأكد_يساوي(ف(30), 59, "حالة 2")
تأكد_يساوي(ف(39), 374, "حالة 3")
تأكد_يساوي(ف(100), 4644, "حالة 4")
