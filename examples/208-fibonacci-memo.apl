# مثال 208 — فيبوناتشي بالتخزين
# Fibonacci with memoization
# Demonstrates: عودية + قاموس حفظ
#
# Run:  python apl.py examples/208-fibonacci-memo.apl

المتغير محفوظ = {}

دالة فيب(ن):
    لو ن < 2:
        ارجع ن
    لو ن في محفوظ:
        ارجع محفوظ[ن]
    المتغير قيمة = فيب(ن - 1) + فيب(ن - 2)
    محفوظ[ن] = قيمة
    ارجع قيمة

لكل ن في [10, 30, 50, 100]:
    اطبع "فيب(", ن, ") =", فيب(ن)

اطبع "عناصر محفوظة:", طول(محفوظ)
