# مثال 704 — متاهة ويلسون
# Wilson's maze
# Demonstrates: مشي ممحى الحلقات، شجرة ممتدة، LCG
#
# Run:  python apl.py examples/704-maze-wilson.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# متاهة مثالية بخوارزمية ويلسون (شجرة ممتدة منتظمة)
# Demonstrates: مشي عشوائي ممحى الحلقات, مولد LCG حتمي, شجرة
# البذرة ثابتة فتتولد نفس المتاهة دائما

دالة جيران(خلية, صفوف, أعمدة):
  ص = خلية // أعمدة
  ع2 = خلية % أعمدة
  ناتج = []
  لو ص > 0:
    ناتج.append(خلية - أعمدة)
  لو ص < صفوف - 1:
    ناتج.append(خلية + أعمدة)
  لو ع2 > 0:
    ناتج.append(خلية - 1)
  لو ع2 < أعمدة - 1:
    ناتج.append(خلية + 1)
  ارجع ناتج

دالة ويلسون(صفوف, أعمدة, بذرة):
  ن = صفوف * أعمدة
  في_الشجرة = [خطأ] * ن
  حواف = []
  ع = بذرة
  في_الشجرة[0] = صواب
  باقي = ن - 1
  لكل بداية في نطاق(1, ن):
    لو في_الشجرة[بداية]:
      باقي = باقي
    والا:
      مسار = [بداية]
      حالية = بداية
      طالما في_الشجرة[حالية] == خطأ:
        ج = جيران(حالية, صفوف, أعمدة)
        ع = (ع * 1103515245 + 12345) % 2147483648
        تالية = ج[ع % طول(ج)]
        لو تالية في مسار:
          موضع = مسار.index(تالية)
          مسار = مسار[:موضع + 1]
        والا:
          مسار.append(تالية)
        حالية = تالية
      لكل ي في نطاق(طول(مسار) - 1):
        حواف.append([مسار[ي], مسار[ي + 1]])
        في_الشجرة[مسار[ي]] = صواب
      في_الشجرة[مسار[طول(مسار) - 1]] = صواب
  ارجع حواف

دالة متصلة_كليا(حواف, ن):
  جوار = {}
  لكل ي في نطاق(ن):
    جوار[ي] = []
  لكل ح في حواف:
    جوار[ح[0]].append(ح[1])
    جوار[ح[1]].append(ح[0])
  مرئي = [خطأ] * ن
  طابور = [0]
  مرئي[0] = صواب
  رأس = 0
  طالما رأس < طول(طابور):
    حالية = طابور[رأس]
    رأس = رأس + 1
    لكل ج في جوار[حالية]:
      لو مرئي[ج] == خطأ:
        مرئي[ج] = صواب
        طابور.append(ج)
  عدد = 0
  لكل ي في نطاق(ن):
    لو مرئي[ي]:
      عدد = عدد + 1
  ارجع عدد

حواف = ويلسون(4, 4, 7)
تأكد_يساوي(طول(حواف), 15, "شجرة 16 خلية لها 15 حافة")
تأكد_يساوي(متصلة_كليا(حواف, 16), 16, "كل الخلايا متصلة")
حواف2 = ويلسون(4, 4, 7)
تأكد_يساوي(طول(حواف2), 15, "حتمية بنفس البذرة")
حواف3 = ويلسون(3, 3, 7)
تأكد_يساوي(طول(حواف3), 8, "شجرة 9 خلايا لها 8 حواف")
تأكد_يساوي(متصلة_كليا(حواف3, 9), 9, "متاهة 3×3 متصلة")
اطبع "حواف 4×4:", طول(حواف)
