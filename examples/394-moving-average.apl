# مثال 394 — المتوسط المتحرك
# Moving average
# Demonstrates: نافذة انزلاقية
#
# Run:  python apl.py examples/394-moving-average.apl

دالة متحرك(قائمة, نافذة):
    المتغير نتائج = []
    لكل ب في نطاق(طول(قائمة) - نافذة + 1):
        المتغير مجموع = 0
        لكل ي في نطاق(نافذة):
            مجموع = مجموع + قائمة[ب + ي]
        نتائج.append(مجموع / نافذة)
    ارجع نتائج

المتغير أسعار = [10, 12, 14, 13, 15, 17, 16, 18]
اطبع "متوسط 3 أيام:", متحرك(أسعار, 3)
