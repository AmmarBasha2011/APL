# مثال 2105 — الأعداد النرجسية ذات ثلاثة أرقام
# Three digit narcissistic numbers
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2105-narcissistic-numbers-three-digits-list.apl

# # نفحص من 100 إلى 999
# # 153 مثال شهير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نرجسي(ن):
  مج = 0
  لكل ر في نص(ن):
    مج = مج + int(ر) ** 3
  ارجع مج == ن

ق = []
لكل ن في نطاق(100, 1000):
  لو نرجسي(ن):
    ق = ق + [ن]
تأكد_يساوي(ق, [153, 370, 371, 407], "الأربعة")
