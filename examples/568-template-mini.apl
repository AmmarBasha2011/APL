# مثال 568 — محرك قوالب مصغر
# Mini template engine
# Demonstrates: قوالب، متغيرات، معالجة نصوص
#
# Run:  python apl.py examples/568-template-mini.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# محرك قوالب مصغر بمتغيرات {{اسم}}
دالة املأ(قالب, قيم):
    المتغير ناتج = ""
    المتغير باقي = قالب
    طالما "{{" في باقي:
        المتغير قبل = باقي.تقسيم("{{", 1)[0]
        المتغير بعد_فتح = باقي.تقسيم("{{", 1)[1]
        المتغير اسم = بعد_فتح.تقسيم("}}", 1)[0]
        باقي = بعد_فتح.تقسيم("}}", 1)[1]
        ناتج = ناتج + قبل
        لو اسم في قيم:
            ناتج = ناتج + نص(قيم[اسم])
        الا:
            ناتج = ناتج + "{{" + اسم + "}}"
    ارجع ناتج + باقي

المتغير قالب = "أهلاً {{الاسم}}، رصيدك {{الرصيد}} جنيه في {{البنك}}."
المتغير قيم = {"الاسم": "عمار", "الرصيد": 1250, "البنك": "الأهلي"}
تأكد_يساوي(املأ(قالب, قيم), "أهلاً عمار، رصيدك 1250 جنيه في الأهلي.", "قالب مكتمل")
تأكد_يساوي(املأ("x{{مفقود}}y", قيم), "x{{مفقود}}y", "المفقود يبقى كما هو")
