# مثال 422 — المكونات المتصلة
# Connected components
# Demonstrates: DFS لعد المكونات
#
# Run:  python apl.py examples/422-graph-components.apl

المتغير جيران = {
    0: [1],
    1: [0],
    2: [3],
    3: [2],
    4: []
}

دالة امسح(عقدة, جيران, مزارة):
    مزارة.append(عقدة)
    لكل جار in جيران[عقدة]:
        لو مزارة.count(جار) == 0:
            امسح(جار, جيران, مزارة)

المتغير مزارة = []
المتغير مكونات = 0
لكل عقدة في جيران.keys():
    لو مزارة.count(عقدة) == 0:
        امسح(عقدة, جيران, مزارة)
        مكونات = مكونات + 1

اطبع "عدد المكونات:", مكونات
