# مثال 3582 — مجموع زوايا مضلع زائد 17
# Polygon angle sum plus 17
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3582-interior-angle-sum-of-polygon-plus-17.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 17

تأكد_يساوي(ف(3), 197, "حالة 1")
تأكد_يساوي(ف(4), 377, "حالة 2")
تأكد_يساوي(ف(5), 557, "حالة 3")
تأكد_يساوي(ف(6), 737, "حالة 4")
تأكد_يساوي(ف(12), 1817, "حالة 5")
