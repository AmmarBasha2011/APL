# مثال 3090 — مساحة دائرة بتقريب 5
# Circle area with pi approx 5/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3090-square-of-radius-times-5-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 5 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(7), 35, "حالة 3")
تأكد_يساوي(ف(14), 140, "حالة 4")
تأكد_يساوي(ف(21), 315, "حالة 5")
