# مثال 3987 — مجموع ord مع إزاحة 21
# Sum of ord values plus 21 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3987-sum-of-ord-values-offset-21.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 21
  ارجع م

تأكد_يساوي(ف("a"), 118, "حالة 1")
تأكد_يساوي(ف("abc"), 357, "حالة 2")
تأكد_يساوي(ف("xyz"), 426, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
