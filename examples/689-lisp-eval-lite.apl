# مثال 689 — مفسر ليسب مصغر
# Lisp evaluator lite
# Demonstrates: تجزئة، شجرة، تقييم عودي
#
# Run:  python apl.py examples/689-lisp-eval-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مفسر ليسب مصغر: حساب بالبادئة فقط
# Demonstrates: تجزئة رموز, شجرة متداخلة بالعودية, تقييم عودي
# يدعم + - * / على الأعداد الصحيحة

دالة رموز(نص):
  مبعد = نص.replace("(", " ( ").replace(")", " ) ")
  ارجع مبعد.split()

دالة حلل(قائمة, موضع):
  رمز = قائمة[موضع]
  لو رمز == "(":
    شجرة = []
    موضع = موضع + 1
    طالما قائمة[موضع] != ")":
      زوج = حلل(قائمة, موضع)
      شجرة.append(زوج[0])
      موضع = زوج[1]
    ارجع [شجرة, موضع + 1]
  لو رمز في ["+", "-", "*", "/"]:
    ارجع [رمز, موضع + 1]
  ارجع [صحيح(رمز), موضع + 1]

دالة قيم(عقدة):
  لو نوع(عقدة) == نوع(0):
    ارجع عقدة
  عملية = عقدة[0]
  أ = قيم(عقدة[1])
  ب = قيم(عقدة[2])
  لو عملية == "+":
    ارجع أ + ب
  لو عملية == "-":
    ارجع أ - ب
  لو عملية == "*":
    ارجع أ * ب
  ارجع أ // ب

دالة احسب(نص):
  زوج = حلل(رموز(نص), 0)
  ارجع قيم(زوج[0])

تأكد_يساوي(احسب("(+ 1 (* 2 3))"), 7, "جمع وضرب")
تأكد_يساوي(احسب("(- 10 (/ 8 2))"), 6, "طرح وقسمة")
تأكد_يساوي(احسب("(* (+ 1 2) (- 5 3))"), 6, "تداخل عميق")
تأكد_يساوي(احسب("42"), 42, "عدد مفرد")
تأكد_يساوي(احسب("(+ (+ (+ 1 1) 1) 1)"), 4, "تداخل أيسر")
اطبع "الناتج:", احسب("(+ 1 (* 2 3))")
