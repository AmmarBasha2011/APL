# مثال 743 — كلمة مرور لمرة واحدة
# HOTP one-time password
# Demonstrates: عداد 8 بايتات، اقتطاع ديناميكي، ست خانات
#
# Run:  python apl.py examples/743-otp-hotp-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# كلمة مرور لمرة واحدة HOTP (بنية RFC 4226 مع SHA-256)
# Demonstrates: عداد 8 بايتات كبير النهاية, اقتطاع ديناميكي, ست خانات
# الاقتطاع: إزاحة من آخر بايت ثم 31 بت ثم باقي قسمة على مليون

دالة هماك_خام(مفتاح, رسالة):
  لو طول(مفتاح) > 64:
    مفتاح = تجزئة_sha256(مفتاح).digest()
  لو طول(مفتاح) < 64:
    مفتاح = مفتاح + b"\x00" * (64 - طول(مفتاح))
  أيباد = []
  أوباد = []
  لكل ي في نطاق(64):
    أيباد.append(مفتاح[ي] ^ 54)
    أوباد.append(مفتاح[ي] ^ 92)
  داخلي = تجزئة_sha256(bytearray(أيباد) + رسالة).digest()
  ارجع تجزئة_sha256(bytearray(أوباد) + داخلي).digest()

دالة عداد_بايتات(عداد):
  بايتات = []
  باقي = عداد
  لكل ي في نطاق(8):
    بايتات = [باقي % 256] + بايتات
    باقي = باقي // 256
  ارجع bytearray(بايتات)

دالة اقتطع(هاش):
  إزاحة = هاش[طول(هاش) - 1] % 16
  قيمة = (هاش[إزاحة] % 128) * 16777216 + هاش[إزاحة + 1] * 65536 + هاش[إزاحة + 2] * 256 + هاش[إزاحة + 3]
  ارجع قيمة

دالة هوتب(مفتاح, عداد):
  ارجع اقتطع(هماك_خام(مفتاح, عداد_بايتات(عداد))) % 1000000

مفتاح = b"12345678901234567890"

تأكد_يساوي(عداد_بايتات(0), bytearray([0, 0, 0, 0, 0, 0, 0, 0]), "عداد صفر")
تأكد_يساوي(عداد_بايتات(1), bytearray([0, 0, 0, 0, 0, 0, 0, 1]), "عداد واحد")
تأكد_يساوي(عداد_بايتات(258), bytearray([0, 0, 0, 0, 0, 0, 1, 2]), "عداد 258")

تأكد_يساوي(هوتب(مفتاح, 0), 875740, "العداد 0")
تأكد_يساوي(هوتب(مفتاح, 1), 247374, "العداد 1")
تأكد_يساوي(هوتب(مفتاح, 2), 254785, "العداد 2")
تأكد_يساوي(هوتب(مفتاح, 7) != هوتب(مفتاح, 8), صواب, "عدادات مختلفة")
تأكد_يساوي(هوتب(مفتاح, 5) < 1000000, صواب, "ست خانات على الأكثر")

اطبع "HOTP(0):", هوتب(مفتاح, 0)
