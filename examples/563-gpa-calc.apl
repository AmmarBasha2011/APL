# مثال 563 — المعدل التراكمي
# GPA calculator
# Demonstrates: GPA، ساعات معتمدة، متوسط موزون
#
# Run:  python apl.py examples/563-gpa-calc.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# المعدل التراكمي بالساعات المعتمدة
المتغير مواد = [["برمجة", 3, 4.0], ["رياضيات", 3, 3.7], ["فيزياء", 2, 3.0], ["تخرج", 4, 3.3]]
المتغير نقاط = 0
المتغير ساعات_كلية = 0
لكل مادة في مواد:
    نقاط = نقاط + مادة[1] * مادة[2]
    ساعات_كلية = ساعات_كلية + مادة[1]
    اطبع مادة[0], ":", مادة[1], "ساعات ×", مادة[2]
المتغير معدل = نقاط / ساعات_كلية
اطبع "الساعات:", ساعات_كلية, "| النقاط:", مقرب(نقاط, 2)
اطبع "المعدل:", مقرب(معدل, 2)
تأكد_يساوي(ساعات_كلية, 12, "إجمالي الساعات")
تأكد_يساوي(مقرب(معدل, 2), 3.52, "المعدل التراكمي")
