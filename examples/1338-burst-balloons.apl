# مثال 1338 — فرقعة البالونات
# Burst balloons maximum coins
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1338-burst-balloons.apl

# نفكر في آخر بالون يفرقع في كل مجال
# ونجمع الحلول الجزئية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة افرقع(أرقام):
  ب = [1] + أرقام + [1]
  ن = طول(ب)
  د = []
  لكل ع في نطاق(ن):
    د.ألحق([0] * ن)
  لكل طول_ في نطاق(2, ن):
    لكل يسار في نطاق(0, ن - طول_):
      يمين = يسار + طول_
      لكل ك في نطاق(يسار + 1, يمين):
        قيمة = د[يسار][ك] + د[ك][يمين] + ب[يسار] * ب[ك] * ب[يمين]
        لو قيمة > د[يسار][يمين]:
          د[يسار][يمين] = قيمة
  ارجع د[0][ن - 1]

تأكد_يساوي(افرقع([3,1,5,8]), 167, "مثال أول")
تأكد_يساوي(افرقع([1,5]), 10, "اثنان")
تأكد_يساوي(افرقع([7]), 7, "واحد")
