# مثال 1281 — ثلاثية متزايدة
# Increasing triplet subsequence
# Demonstrates: مسح واحد
#
# Run:  python apl.py examples/1281-longest-increasing-triplet.apl

# نحتفظ بأصغر قيمتين رأيناهما
# وأي عنصر يتجاوزهما يكمل الثلاثية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ثلاثية(أ):
  اول = 10 ** 9
  ثان = 10 ** 9
  لكل س في أ:
    لو س <= اول:
      اول = س
    والا_لو س <= ثان:
      ثان = س
    والا:
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(ثلاثية([1,2,3,4,5]), صواب, "تصاعدي")
تأكد_يساوي(ثلاثية([5,4,3,2,1]), خطأ, "تنازلي")
تأكد_يساوي(ثلاثية([2,1,5,0,4,6]), صواب, "متقطعة")
تأكد_يساوي(ثلاثية([1,1,1]), خطأ, "متساوية")
