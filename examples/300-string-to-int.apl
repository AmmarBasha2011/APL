# مثال 300 — تحويل نص إلى عدد (atoi)
# String to integer
# Demonstrates: تحليل يدوي مع إشارة
#
# Run:  python apl.py examples/300-string-to-int.apl

دالة حول_عدد(نص_الدخل):
    المتغير نص_نظيف = نص_الدخل.تقليم()
    لو طول(نص_نظيف) == 0:
        ارجع 0
    المتغير إشارة = 1
    المتغير ي = 0
    لو نص_نظيف[0] == "-":
        إشارة = -1
        ي = 1
    الا لو نص_نظيف[0] == "+":
        ي = 1
    المتغير قيمة = 0
    طالما ي < طول(نص_نظيف) و نص_نظيف[ي] >= "0" و نص_نظيف[ي] <= "9":
        قيمة = قيمة * 10 + ترميز_حرف(نص_نظيف[ي]) - 48
        ي = ي + 1
    ارجع إشارة * قيمة

اطبع حول_عدد("42")
اطبع حول_عدد("   -42")
اطبع حول_عدد("4193 مع كلمات")
اطبع حول_عدد("كلمات 987")
