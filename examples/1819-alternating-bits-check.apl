# مثال 1819 — بتات متناوبة
# Alternating bits check
# Demonstrates: بتات
#
# Run:  python apl.py examples/1819-alternating-bits-check.apl

# نقارن البت بالذي قبله
# نزيح العدد في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متناوبة(ن):
  سابق = ن & 1
  ن = ن >> 1
  طالما ن > 0:
    حالي = ن & 1
    لو حالي == سابق:
      ارجع خطأ
    سابق = حالي
    ن = ن >> 1
  ارجع صواب

تأكد_يساوي(متناوبة(5), صواب, "101")
تأكد_يساوي(متناوبة(7), خطأ, "111")
تأكد_يساوي(متناوبة(10), صواب, "1010")
تأكد_يساوي(متناوبة(11), خطأ, "1011")
