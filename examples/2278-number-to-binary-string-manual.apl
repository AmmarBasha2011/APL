# مثال 2278 — عدد إلى سلسلة ثنائية
# Number to binary string
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2278-number-to-binary-string-manual.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع "0"
  خ = ""
  طالما ن > 0:
    خ = نص(ن % 2) + خ
    ن = ن // 2
  ارجع خ

تأكد_يساوي(ف(0), "0", "حالة 1")
تأكد_يساوي(ف(1), "1", "حالة 2")
تأكد_يساوي(ف(5), "101", "حالة 3")
تأكد_يساوي(ف(10), "1010", "حالة 4")
تأكد_يساوي(ف(255), "11111111", "حالة 5")
