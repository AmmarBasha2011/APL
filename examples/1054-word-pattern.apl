# مثال 1054 — نمط الكلمات
# Word pattern
# Demonstrates: تقابل واحد لواحد
#
# Run:  python apl.py examples/1054-word-pattern.apl

# كل حرف في النمط يقابل كلمة واحدة وبالعكس
# نتحقق بمقارنة أول ظهور لكل عنصر في الطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اول_ظهور(قائمة_, ع):
  ف = 0
  طالما قائمة_[ف] != قائمة_[ع]:
    ف = ف + 1
  ارجع ف

دالة يتبع(نمط, جملة):
  كلمات = جملة.تقسيم(" ")
  لو طول(نمط) != طول(كلمات):
    ارجع خطأ
  لكل ع في نطاق(طول(نمط)):
    لو اول_ظهور(قائمة(نمط), ع) != اول_ظهور(كلمات, ع):
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(يتبع("abba", "dog cat cat dog"), صواب, "يتبع")
تأكد_يساوي(يتبع("abba", "dog cat cat fish"), خطأ, "كلمة مختلفة")
تأكد_يساوي(يتبع("aaaa", "dog cat cat dog"), خطأ, "حرف واحد لكلمات")
تأكد_يساوي(يتبع("abba", "dog dog dog dog"), خطأ, "كلمة واحدة لحرفين")
