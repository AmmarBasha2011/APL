# مثال 2388 — صنف طابور
# Queue class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2388-class-queue-enqueue-dequeue-front.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف طابور:
    دالة_إنشاء(ذات):
        ذات.ع = []

    دالة ادخل(ذات, ق):
        ذات.ع = ذات.ع + [ق]

    دالة اخرج(ذات):
        ق = ذات.ع[0]
        ذات.ع = ذات.ع[1:]
        ارجع ق

    دالة حجم(ذات):
        ارجع طول(ذات.ع)

ط = طابور()
ط.ادخل("أ")
ط.ادخل("ب")
تأكد_يساوي(ط.اخرج(), "أ", "الأول")
تأكد_يساوي(ط.اخرج(), "ب", "الثاني")
تأكد_يساوي(ط.حجم(), 0, "فارغ")
