# مثال 3390 — تحويل وحدة بأساس 24
# Split by base 24
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3390-minutes-to-hours-and-minutes-base-24.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 24, ن % 24]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 11], "حالة 2")
تأكد_يساوي(ف(60), [2, 12], "حالة 3")
تأكد_يساوي(ف(125), [5, 5], "حالة 4")
تأكد_يساوي(ف(1000), [41, 16], "حالة 5")
