# مثال 74 — الملفات والمسارات (مكتبة datafiles)
# Files and paths (os.path / glob / fnmatch / stat)
#
# Run:  python apl.py examples/74-df-paths.apl

اطبع "=== بناء المسارات ==="
المتغير مسار = دمج_مسار("/tmp", "apl-df-dir")
اطبع "المسار:", مسار
اطبع "الاسم:", اسم_الأساس(مسار)
اطبع "المجلد:", اسم_المجلد(مسار)
اطبع "الامتداد:", افصل_الامتداد("تقرير.pdf")

اطبع ""
اطبع "=== البحث النمطي ==="
المتغير نتائج = بحث_نمطي_2("/tmp/apl-df-dir*")
اطبع "عدد النتائج:", طول(نتائج)
لكل ر in نتائج:
    اطبع "   ", ر

اطبع ""
اطبع "=== مطابقة نمطية ==="
اطبع "a.txt  vs *.txt :", طابق_نمطياً("a.txt", "*.txt")
اطبع "a.pdf  vs *.txt :", طابق_نمطياً("a.pdf", "*.txt")

اطبع ""
اطبع "=== وضع الملف ==="
اطبع "0o644 ->", وضع_الملف(420)
