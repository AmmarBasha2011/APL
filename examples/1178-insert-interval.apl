# مثال 1178 — إدراج مجال
# Insert interval
# Demonstrates: مسح خطي
#
# Run:  python apl.py examples/1178-insert-interval.apl

# ننسخ ما قبله بلا تداخل
# وندمج المتداخل ثم ننسخ ما بعده

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادرج(مجالات, جديد):
  ناتج = []
  ع = 0
  ن = طول(مجالات)
  طالما (ع < ن) و (مجالات[ع][1] < جديد[0]):
    ناتج.ألحق(مجالات[ع])
    ع = ع + 1
  ب = جديد[0]
  ه = جديد[1]
  طالما (ع < ن) و (مجالات[ع][0] <= ه):
    ب = أصغر(ب, مجالات[ع][0])
    ه = أكبر(ه, مجالات[ع][1])
    ع = ع + 1
  ناتج.ألحق([ب, ه])
  طالما ع < ن:
    ناتج.ألحق(مجالات[ع])
    ع = ع + 1
  ارجع ناتج

تأكد_يساوي(ادرج([[1,3],[6,9]], [2,5]), [[1,5],[6,9]], "مثال أول")
تأكد_يساوي(ادرج([[1,2],[3,5],[6,7],[8,10],[12,16]], [4,8]), [[1,2],[3,10],[12,16]], "مثال ثان")
تأكد_يساوي(ادرج([], [5,7]), [[5,7]], "فارغة")
تأكد_يساوي(ادرج([[1,5]], [6,8]), [[1,5],[6,8]], "بعدها")
