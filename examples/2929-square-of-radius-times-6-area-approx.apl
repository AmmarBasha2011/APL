# مثال 2929 — مساحة دائرة بتقريب 6
# Circle area with pi approx 6/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/2929-square-of-radius-times-6-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 6 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(7), 42, "حالة 3")
تأكد_يساوي(ف(14), 168, "حالة 4")
تأكد_يساوي(ف(21), 378, "حالة 5")
