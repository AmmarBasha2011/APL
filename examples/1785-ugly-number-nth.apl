# مثال 1785 — العدد القبيح رقم ن
# Nth ugly number
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1785-ugly-number-nth.apl

# ثلاثة مؤشرات للمضاعفات
# نأخذ الأصغر في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قبيح(ن):
  أعداد = [1]
  أ = 0
  ب = 0
  ج = 0
  طالما طول(أعداد) < ن:
    ت = أصغر(أصغر(أعداد[أ] * 2, أعداد[ب] * 3), أعداد[ج] * 5)
    أعداد.append(ت)
    لو أعداد[أ] * 2 == ت:
      أ = أ + 1
    لو أعداد[ب] * 3 == ت:
      ب = ب + 1
    لو أعداد[ج] * 5 == ت:
      ج = ج + 1
  ارجع أعداد[ن - 1]

تأكد_يساوي(قبيح(1), 1, "الأول")
تأكد_يساوي(قبيح(10), 12, "العاشر")
تأكد_يساوي(قبيح(15), 24, "الخامس عشر")
