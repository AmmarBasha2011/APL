# مثال 1276 — دمج تدفقات
# Merge k sorted lists
# Demonstrates: دمج
#
# Run:  python apl.py examples/1276-merge-sorted-streams.apl

# نأخذ الأصغر من رؤوس القوائم في كل خطوة
# حتى تنفد كلها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادمج_كل(قوائم):
  مؤشرات = [0] * طول(قوائم)
  ناتج = []
  طالما صواب:
    افضل = -1
    لكل ع في نطاق(طول(قوائم)):
      لو مؤشرات[ع] < طول(قوائم[ع]):
        لو (افضل == -1) أو (قوائم[ع][مؤشرات[ع]] < قوائم[افضل][مؤشرات[افضل]]):
          افضل = ع
    لو افضل == -1:
      ارجع ناتج
    ناتج.ألحق(قوائم[افضل][مؤشرات[افضل]])
    مؤشرات[افضل] = مؤشرات[افضل] + 1

تأكد_يساوي(ادمج_كل([[1,4,5],[1,3,4],[2,6]]), [1,1,2,3,4,4,5,6], "ثلاث قوائم")
تأكد_يساوي(ادمج_كل([]), [], "لا قوائم")
تأكد_يساوي(ادمج_كل([[], [1]]), [1], "فارغة وواحدة")
