# مثال 127 — حساب العمر بالتفصيل
# Age calculation
# Demonstrates: تاريخ، التاريخ_اليوم، مدة
#
# Run:  python apl.py examples/127-datetime-age.apl

دالة عمر_بالسنوات(ميلاد):
    المتغير اليوم = التاريخ_اليوم()
    المتغير سنوات = اليوم.رقم_السنة - ميلاد.رقم_السنة
    لو (اليوم.رقم_الشهر, اليوم.رقم_اليوم) < (ميلاد.رقم_الشهر, ميلاد.رقم_اليوم):
        سنوات = سنوات - 1
    ارجع سنوات

المتغير ميلاد = تاريخ(2000, 9, 9)
اطبع "تاريخ الميلاد:", ميلاد
اطبع "العمر:", عمر_بالسنوات(ميلاد), "سنة"

المتغير أيام_معاشة = التاريخ_اليوم() - ميلاد
اطبع "الأيام المعاشة:", أيام_معاشة.days
اطبع "تقريباً بالساعات:", أيام_معاشة.days * 24
