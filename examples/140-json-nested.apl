# مثال 140 — JSON متداخل: بناء وقراءة
# Nested JSON build and read
# Demonstrates: جسون_تحويل، جسون، قواميس وقوائم
#
# Run:  python apl.py examples/140-json-nested.apl

المتغير شركة = {
    "الاسم": "تقنية",
    "الموظفون": [
        {"الاسم": "عمار", "العمر": 26},
        {"الاسم": "سارة", "العمر": 24}
    ],
    "ناشطة": صواب
}

المتغير نص = جسون_تحويل(شركة)
اطبع "النص:", نص

المتغير مفكوك = جسون(نص)
اطبع "اسم الشركة:", مفكوك["الاسم"]
اطبع "أول موظف:", مفكوك["الموظفون"][0]["الاسم"]
اطبع "عدد الموظفين:", طول(مفكوك["الموظفون"])
