# مثال 3990 — صف جدول ضرب 28
# Multiplication row of 28
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3990-multiplication-table-row-of-28.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 28]
  ارجع ر

تأكد_يساوي(ف(1), [28], "حالة 1")
تأكد_يساوي(ف(5), [28, 56, 84, 112, 140], "حالة 2")
تأكد_يساوي(ف(10), [28, 56, 84, 112, 140, 168, 196, 224, 252, 280], "حالة 3")
