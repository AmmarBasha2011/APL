# مثال 495 — بطاقات استذكار
# Flashcards
# Demonstrates: أسئلة وأجوبة مرتبة عشوائيا
#
# Run:  python apl.py examples/495-flashcards.apl

بذرة(8)
المتغير بطاقات = [
    {"س": "ما هي عاصمة اليابان؟", "ج": "طوكيو"},
    {"س": "كم 5 * 6؟", "ج": "30"},
    {"س": "أكبر كوكب؟", "ج": "المشتري"}
]

خلط(بطاقات)
لكل بطاقة في بطاقات:
    اطبع "س:", بطاقة["س"]
    اطبع "  ج:", بطاقة["ج"]
