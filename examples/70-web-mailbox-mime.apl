# مثال 70 — صناديق البريد وأنواع MIME (مكتبة web)
# Mailbox folders and MIME type guessing (mailbox / mimetypes)
#
# Run:  python apl.py examples/70-web-mailbox-mime.apl

اطبع "=== تخمين نوع MIME ==="
المتغير ملفات = ["صورة.png", "مستند.pdf", "صفحة.html", "نص.txt", "أرشيف.zip"]
لكل ملف في ملفات:
    المتغير نوع = تخمين_نوع_الملف(ملف)
    اطبع ملف, "->", نوع[0]

اطبع ""
اطبع "=== تخمين الامتداد ==="
اطبع "image/png ->", تخمين_امتداد_الملف("image/png")
اطبع "application/pdf ->", تخمين_امتداد_الملف("application/pdf")

اطبع ""
اطبع "=== صندوق mbox ==="
المتغير مسار = "/tmp/apl-web-mailbox.mbox"
المتغير صندوق = صندوق_mbox(مسار)

المتغير رسالة = نص_بريد_2("رسالة داخل صندوق البريد", "utf-8")
صندوق.mbox_أضف(رسالة)
اطبع "عدد الرسائل:", طول(صندوق.mbox_مفاتيح())

المتغير مفاتيح = صندوق.mbox_مفاتيح()
لكل مفتاح في مفاتيح:
    المتغير ر = صندوق.mbox_احصل_رسالة(مفتاح)
    اطبع "مفتاح:", مفتاح, "| الحمولة:", ر.MIME_نص_احصل_حمولة()

صندوق.mbox_أغلق()
