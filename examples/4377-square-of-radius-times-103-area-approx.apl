# مثال 4377 — مساحة دائرة بتقريب 103
# Circle area with pi approx 103/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4377-square-of-radius-times-103-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 103 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 14, "حالة 2")
تأكد_يساوي(ف(7), 721, "حالة 3")
تأكد_يساوي(ف(14), 2884, "حالة 4")
تأكد_يساوي(ف(21), 6489, "حالة 5")
