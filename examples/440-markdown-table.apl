# مثال 440 — مولد جداول ماركداون
# Markdown table generator
# Demonstrates: بناء جدول من قواميس
#
# Run:  python apl.py examples/440-markdown-table.apl

دالة جدول_ماركداون(عناوين, صفوف):
    اطبع "| " + " | ".ضم(عناوين) + " |"
    المتغير فاصل = []
    لكل _ في نطاق(طول(عناوين)):
        فاصل.append("---")
    اطبع "| " + " | ".ضم(فاصل) + " |"
    لكل صف_جدول في صفوف:
        اطبع "| " + " | ".ضم(صف_جدول) + " |"

جدول_ماركداون(["اللغة", "السنة", "المجال"], [
    ["APL", "2026", "برمجة"],
    ["بايثون", "1991", "عام"],
    ["جافاسكربت", "1995", "ويب"]
])
