# مثال 1614 — دورة في رسم غير موجه
# Cycle detection in undirected graph
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1614-undirected-graph-has-cycle.apl

# بحث عميق مع تتبع الأب
# جار مزور غير الأب يعني دورة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فيه_دورة(ن, أضلاع):
  جيران = {}
  لكل ع في نطاق(ن):
    جيران[ع] = []
  لكل ض في أضلاع:
    جيران[ض[0]].append(ض[1])
    جيران[ض[1]].append(ض[0])
  زرنا = {}
  لكل بداية في نطاق(ن):
    لو بداية في زرنا:
      زرنا = زرنا
    والا:
      زرنا[بداية] = صواب
      مكدس = [[بداية, -1]]
      طالما طول(مكدس) > 0:
        ح = مكدس.pop()
        لكل ج في جيران[ح[0]]:
          لو ج == ح[1]:
            زرنا = زرنا
          والا_لو ج في زرنا:
            ارجع صواب
          والا:
            زرنا[ج] = صواب
            مكدس.append([ج, ح[0]])
  ارجع خطأ

تأكد_يساوي(فيه_دورة(3, [[0, 1], [1, 2], [2, 0]]), صواب, "مثلث")
تأكد_يساوي(فيه_دورة(4, [[0, 1], [1, 2], [2, 3]]), خطأ, "مسار")
تأكد_يساوي(فيه_دورة(2, []), خطأ, "بلا أضلاع")
