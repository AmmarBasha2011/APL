# مثال 261 — اختبار حساب آلي
# Auto math quiz
# Demonstrates: توليد أسئلة وتصحيح آلي
#
# Run:  python apl.py examples/261-math-quiz.apl

بذرة(31)
المتغير صحيحة = 0
لكل سؤال في نطاق(5):
    المتغير أ = عشوائي_عدد(1, 20)
    المتغير ب = عشوائي_عدد(1, 20)
    المتغير جواب_المستخدم = أ + ب
    اطبع "س", سؤال + 1, ":", أ, "+", ب, "=", جواب_المستخدم
    لو جواب_المستخدم == أ + ب:
        صحيحة = صحيحة + 1

اطبع "النتيجة:", صحيحة, "من 5"
