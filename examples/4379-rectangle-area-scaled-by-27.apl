# مثال 4379 — مساحة مستطيل مكبر 27 مرات
# Rectangle area scaled by 27
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4379-rectangle-area-scaled-by-27.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 27) * (ق[1] * 27)

تأكد_يساوي(ف([1, 2]), 1458, "حالة 1")
تأكد_يساوي(ف([3, 4]), 8748, "حالة 2")
تأكد_يساوي(ف([5, 5]), 18225, "حالة 3")
تأكد_يساوي(ف([10, 1]), 7290, "حالة 4")
