# مثال 51 — قراءة XML وتحليله
# Reading & Inspecting an XML Document
# Demonstrates: إكس_إم_إل_من_نص, ابحث_الكل, اقرأ_خاصية, نص_العنصر,
#               كرر, عد_العناصر, نص_كامل, إكس_إم_إل_إلى_نص
#
# Run:  python apl.py examples/51-xml-read.apl

المتغير البيانات = """<?xml version="1.0" encoding="utf-8"?>
<مكتبة>
    <كتاب نوع="علمي" متوفر="نعم">
        <العنوان>الفيزياء الحديثة</العنوان>
        <المؤلف>أحمد زويل</المؤلف>
        <السعر>120</السعر>
    </كتاب>
    <كتاب نوع="أدب" متوفر="لا">
        <العنوان>الأيام</العنوان>
        <المؤلف>طه حسين</المؤلف>
        <السعر>80</السعر>
    </كتاب>
    <كتاب نوع="تقني" متوفر="نعم">
        <العنوان>مدخل إلى البرمجة</العنوان>
        <المؤلف>عمار الخطيب</المؤلف>
        <السعر>150</السعر>
    </كتاب>
</مكتبة>"""

المتغير الجذر = إكس_إم_إل_من_نص(البيانات)

اطبع "=== قراءة مستند XML ==="
اطبع ""
اطبع "العنصر الجذر: " + الجذر.اسم_العنصر
اطبع "عدد الكتب: " + نص(عد_العناصر(الجذر, "كتاب"))
اطبع ""

اطبع "--- قائمة الكتب ---"
المتغير الكتب = الجذر.ابحث_الكل("كتاب")
المتغير الإجمالي = 0
لكل كتاب في الكتب:
    العنوان = كتاب.ابحث_نص("العنوان")
    المؤلف = كتاب.ابحث_نص("المؤلف")
    السعر = عشري(كتاب.ابحث_نص("السعر"))
    النوع = كتاب.اقرأ_خاصية("نوع")
    المتوفر = كتاب.اقرأ_خاصية("متوفر")
    الإجمالي = الإجمالي + السعر
    اطبع "  • " + العنوان + " — " + المؤلف
    اطبع "    النوع: " + النوع + " | السعر: " + نص(السعر) + " | متوفر: " + المتوفر

اطبع ""
اطبع "إجمالي أسعار الكتب: " + نص(الإجمالي)
اطبع "متوسط السعر: " + نص(مقرب(الإجمالي / طول(الكتب), 2))
اطبع ""

اطبع "--- الكتب المتوفرة فقط ---"
لكل كتاب في الجذر.كرر("كتاب"):
    لو كتاب.اقرأ_خاصية("متوفر") == "نعم":
        اطبع "  ✔ " + كتاب.ابحث_نص("العنوان")

اطبع ""
اطبع "--- أول كتاب تقني ---"
المتغير التقني = الجذر.ابحث_الكل("كتاب[@نوع='تقني']")
لو التقني:
    اطبع "  " + التقني[0].ابحث_نص("العنوان")
    اطبع "  خصائصه: " + نص(التقني[0].خصائص_العنصر)

اطبع ""
اطبع "--- كل النصوص في المستند ---"
اطبع "  " + نص_كامل(الجذر)

اطبع ""
اطبع "--- إعادة الإخراج كـ XML ---"
اطبع إكس_إم_إل_إلى_نص(الجذر)
