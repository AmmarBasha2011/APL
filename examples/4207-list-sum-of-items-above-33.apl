# مثال 4207 — مجموع العناصر فوق 33
# Sum of items above 33
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4207-list-sum-of-items-above-33.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    لو خ > 33:
      م = م + خ
  ارجع م

تأكد_يساوي(ف([3, 1, 2]), 0, "حالة 1")
تأكد_يساوي(ف([5]), 0, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 0, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 0, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 0, "حالة 5")
