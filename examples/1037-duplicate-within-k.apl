# مثال 1037 — تكرار قريب
# Contains nearby duplicate
# Demonstrates: آخر فهرس
#
# Run:  python apl.py examples/1037-duplicate-within-k.apl

# نحفظ آخر فهرس رأيناه لكل قيمة
# لو كانت المسافة للظهور السابق لا تتجاوز ك فالتكرار قريب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تكرار_قريب(ق, ك):
  قيم = []
  فهارس = []
  لكل ع في نطاق(طول(ق)):
    لو ق[ع] في قيم:
      ف = 0
      طالما قيم[ف] != ق[ع]:
        ف = ف + 1
      لو (ع - فهارس[ف]) <= ك:
        ارجع صواب
      فهارس[ف] = ع
    والا:
      قيم.ألحق(ق[ع])
      فهارس.ألحق(ع)
  ارجع خطأ

تأكد_يساوي(تكرار_قريب([1, 2, 3, 1], 3), صواب, "مسافة ثلاثة")
تأكد_يساوي(تكرار_قريب([1, 0, 1, 1], 1), صواب, "متجاوران")
تأكد_يساوي(تكرار_قريب([1, 2, 3, 1, 2, 3], 2), خطأ, "بعيدة")
