# مثال 2548 — ملء الأصفار لعرض 7
# Zero pad to width 7
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2548-pad-number-with-zeros-to-width-7.apl

# # ندخل القيمة
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع نص(ن).zfill(7)

تأكد_يساوي(ف(7), "0000007", "حالة 1")
تأكد_يساوي(ف(42), "0000042", "حالة 2")
تأكد_يساوي(ف(123), "0000123", "حالة 3")
تأكد_يساوي(ف(99999), "0099999", "حالة 4")
