# مثال 2227 — حذف المكرر مع الترتيب
# Dedupe keep order
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2227-list-remove-duplicates-keep-order.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    لو ر.count(ع) == 0:
      ر = ر + [ع]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [3, 1, 2], "حالة 1")
تأكد_يساوي(ف([5]), [5], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [1, 2, 3, 4, 5, 6], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-2, 0, 7, 4], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [10, 20, 30], "حالة 5")
