# مثال 731 — نسخ DNA
# DNA transcription
# Demonstrates: واطسون-كريك، مكمل عكسي، RNA
#
# Run:  python apl.py examples/731-dna-transcribe.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# نسخ DNA إلى RNA والمكمل العكسي
# Demonstrates: خريطة قواعد, عكس سلسلة, زوج واطسون-كريك
# T تصبح U في RNA، والمكمل يقرأ بالعكس

دالة نسخ(سلسلة):
  ناتج = ""
  لكل ي في نطاق(طول(سلسلة)):
    لو سلسلة[ي] == "T":
      ناتج = ناتج + "U"
    والا:
      ناتج = ناتج + سلسلة[ي]
  ارجع ناتج

دالة مكمل(قاعدة):
  لو قاعدة == "A":
    ارجع "T"
  لو قاعدة == "T":
    ارجع "A"
  لو قاعدة == "C":
    ارجع "G"
  لو قاعدة == "G":
    ارجع "C"
  ارجع "N"

دالة مكمل_عكسي(سلسلة):
  ناتج = ""
  لكل ي في نطاق(طول(سلسلة)):
    ناتج = ناتج + مكمل(سلسلة[طول(سلسلة) - 1 - ي])
  ارجع ناتج

تأكد_يساوي(نسخ("ATGC"), "AUGC", "نسخ أساسي")
تأكد_يساوي(نسخ("TTTT"), "UUUU", "كل ثايمين")
تأكد_يساوي(مكمل_عكسي("ATGC"), "GCAT", "مكمل عكسي")
تأكد_يساوي(مكمل_عكسي("AAAA"), "TTTT", "أدنين فقط")
تأكد_يساوي(مكمل_عكسي("ATCG"), "CGAT", "مختلط")
تأكد_يساوي(مكمل_عكسي(مكمل_عكسي("ATGCCGTA")), "ATGCCGTA", "عكسان يرجعان الأصل")
تأكد_يساوي(مكمل_عكسي("AAATTT"), "AAATTT", "متناظرة ذاتيا")
اطبع "ATGCCGTA بالعكس:", مكمل_عكسي("ATGCCGTA")
