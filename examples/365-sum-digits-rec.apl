# مثال 365 — مجموع الأرقام بالعودية
# Recursive digit sum
# Demonstrates: قسمة وباقي
#
# Run:  python apl.py examples/365-sum-digits-rec.apl

دالة مجموع_أرقام(عدد):
    لو عدد == 0:
        ارجع 0
    ارجع عدد % 10 + مجموع_أرقام(عدد // 10)

اطبع "12345 ->", مجموع_أرقام(12345)
اطبع "999 ->", مجموع_أرقام(999)
