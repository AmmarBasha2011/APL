# مثال 3535 — مجموع الأعداد من 26 إلى ن
# Sum from 26 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3535-sum-of-integers-from-26-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(26, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(26), 26, "حالة 1")
تأكد_يساوي(ف(27), 53, "حالة 2")
تأكد_يساوي(ف(36), 341, "حالة 3")
تأكد_يساوي(ف(100), 4725, "حالة 4")
