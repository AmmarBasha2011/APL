# مثال 368 — القوة بالعودية
# Recursive power
# Demonstrates: تقسيم الأس
#
# Run:  python apl.py examples/368-power-rec.apl

دالة قوة(قاعدة, أس):
    لو أس == 0:
        ارجع 1
    لو أس % 2 == 0:
        المتغير نصف = قوة(قاعدة, أس // 2)
        ارجع نصف * نصف
    ارجع قاعدة * قوة(قاعدة, أس - 1)

اطبع "2^8 =", قوة(2, 8)
اطبع "3^4 =", قوة(3, 4)
اطبع "9^0 =", قوة(9, 0)
