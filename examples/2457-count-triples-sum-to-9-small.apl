# مثال 2457 — ثلاثيات مجموعها 9
# Triples summing to 9
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2457-count-triples-sum-to-9-small.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل أ في نطاق(1, ن + 1):
    لكل ب في نطاق(أ, ن + 1):
      لكل ج في نطاق(ب, ن + 1):
        لو أ + ب + ج == 9:
          ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(5), 5, "حالة 1")
تأكد_يساوي(ف(9), 7, "حالة 2")
تأكد_يساوي(ف(12), 7, "حالة 3")
