# مثال 188 — البحث الثنائي بالعودية
# Recursive binary search
# Demonstrates: العودية، التقسيم النصفي
#
# Run:  python apl.py examples/188-binary-search.apl

دالة بحث_ثنائي(قائمة, هدف, منخفض, مرتفع):
    لو منخفض > مرتفع:
        ارجع -1
    المتغير منتصف = (منخفض + مرتفع) // 2
    لو قائمة[منتصف] == هدف:
        ارجع منتصف
    الا لو قائمة[منتصف] < هدف:
        ارجع بحث_ثنائي(قائمة, هدف, منتصف + 1, مرتفع)
    الا:
        ارجع بحث_ثنائي(قائمة, هدف, منخفض, منتصف - 1)

المتغير أرقام = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]
اطبع "موضع 23:", بحث_ثنائي(أرقام, 23, 0, طول(أرقام) - 1)
اطبع "موضع 100:", بحث_ثنائي(أرقام, 100, 0, طول(أرقام) - 1)
