# مثال 826 — كوساراجو
# Kosaraju SCC
# Demonstrates: ترتيب إنهاء، مخطط مقلوب
#
# Run:  python apl.py examples/826-kosaraju.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# خوارزمية كوساراجو للمكونات القوية: تمريرا DFS أحدهما على المقلوب
# Demonstrates: ترتيب إنهاء, مخطط مقلوب, مكونات متصلة قوياً

جوار = [[1], [2, 3], [0], [4], [5], [3]]

دالة ترتيب_إنهاء():
  مزار = []
  لكل ي في نطاق(6):
    مزار.append(0)
  ترتيب = []
  دالة زر(عقدة):
    مزار[عقدة] = 1
    لكل جار في جوار[عقدة]:
      لو مزار[جار] == 0:
        زر(جار)
    ترتيب.append(عقدة)
  لكل ي في نطاق(6):
    لو مزار[ي] == 0:
      زر(ي)
  ارجع ترتيب

دالة مكونات():
  ترتيب = ترتيب_إنهاء()
  مقلوب = [[], [], [], [], [], []]
  لكل ي في نطاق(6):
    لكل جار في جوار[ي]:
      مقلوب[جار].append(ي)
  مزار = []
  لكل ي في نطاق(6):
    مزار.append(0)
  كل = []
  دالة اجمع(عقدة, مكون):
    مزار[عقدة] = 1
    مكون.append(عقدة)
    لكل جار في مقلوب[عقدة]:
      لو مزار[جار] == 0:
        اجمع(جار, مكون)
  ي = طول(ترتيب) - 1
  طالما ي >= 0:
    عقدة = ترتيب[ي]
    لو مزار[عقدة] == 0:
      مكون = []
      اجمع(عقدة, مكون)
      كل.append(مكون)
    ي = ي - 1
  ارجع كل

تأكد_يساوي(ترتيب_إنهاء(), [2, 5, 4, 3, 1, 0], "ترتيب الإنهاء")
نتيجة = مكونات()
تأكد_يساوي(طول(نتيجة), 2, "مكونان")
تأكد_يساوي(نتيجة[0], [0, 2, 1], "دورة أولى")
تأكد_يساوي(نتيجة[1], [3, 5, 4], "دورة ثانية")
