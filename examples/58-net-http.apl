# مثال 58 — خادم HTTP محلي وعميله: مسار كامل من الطلب إلى JSON
# Local HTTP server + client round trip
# Demonstrates: خادم_http, خادم_http_متعدد, معالج_طلبات_http, أرسل_استجابة,
#               أرسل_رأساً, أنهِ_الرؤوس_http, serve عبر عالج_طلباً,
#               اتصال_http, أرسل_طلب, اقرأ_الاستجابة, حالة_الاستجابة,
#               رؤوس_الاستجابة, اقرأ_رأس_استجابة, اقرأ_جسم_الاستجابة
#
# Run:  python apl.py examples/58-net-http.apl

اطبع "=== 1) خادم يعيد JSON ==="

المتغير قاعدة = معالج_طلبات_http

صنف معالج_المدينة(قاعدة):
    دالة do_GET(ذات):
        المتغير الجسم = '{"المدينة": "المنصورة", "السكان": 1200000}'
        ذات.send_response(200)
        ذات.send_header("Content-Type", "application/json")
        ذات.send_header("Content-Length", نص(طول(الجسم.encode())))
        ذات.end_headers()
        ذات.wfile.write(الجسم.encode())

المتغير خادم = خادم_http(("127.0.0.1", 0), معالج_المدينة)
المتغير المنفذ = خادم.عنوان_الخادم[1]
اطبع "الخادم يعمل على المنفذ " + نص(المنفذ)

# ---------- 2) طلب واحد كامل ----------
اطبع "=== 2) الطلب والاستجابة ==="
المتغير عميل = اتصال_http("127.0.0.1", المنفذ)
عميل.أرسل_طلب("GET", "/data")
خادم.عالج_طلباً()

المتغير جواب = عميل.اقرأ_الاستجابة()
اطبع "الحالة: " + نص(جواب.حالة_الاستجابة)
اطبع "السبب: " + جواب.سبب_الحالة
اطبع "النوع: " + جواب.اقرأ_رأس_استجابة("Content-Type")
اطبع "الطول: " + جواب.اقرأ_رأس_استجابة("Content-Length")

المتغير نص_الجواب = جواب.اقرأ_جسم_الاستجابة().decode("utf-8")
اطبع "الجسم الخام: " + نص_الجواب

عميل.أغلق_الاتصال()

# ---------- 3) تحليل JSON ----------
اطبع "=== 3) بعد التحليل ==="
المتغير بيانات = جسون(نص_الجواب)
اطبع "المدينة: " + بيانات["المدينة"]
اطبع "السكان: " + نص(بيانات["السكان"])

خادم.أغلق_الخادم_كلية()

# ---------- 4) أكواد الحالة بالأسماء ----------
اطبع "=== 4) أكواد الحالة ==="
المتغير أكواد = [HTTP_حالة_غير_موجود, معرّف_حالة_محظور, HTTP_حالة_طلب_سيئ]
لكل كود في أكواد:
    اطبع "  " + نص(كود.value) + " -> " + كود.phrase

# ---------- 5) أنواع الملفات كما يراها المتصفح ----------
اطبع "=== 5) أنواع المحتوى ==="
لكل امتداد في [".json", ".html", ".csv", ".png"]:
    اطبع "  " + امتداد + " -> " + نص(نوع_الملف_من_الاسم("ملف" + امتداد))

اطبع "تم."
