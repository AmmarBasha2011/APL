# مثال 1369 — قفزات أربعة
# Jump game IV equal values
# Demonstrates: بحث بالعرض
#
# Run:  python apl.py examples/1369-jump-game-four.apl

# من i نقفز إلى i±1 أو لأي موضع بنفس القيمة
# نفرغ قائمة القيمة بعد استخدامها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_قفزات(مصفوفة):
  ن = طول(مصفوفة)
  لو ن == 1:
    ارجع 0
  مواضع = {}
  لكل ع في نطاق(ن):
    لو مصفوفة[ع] ليس في مواضع:
      مواضع[مصفوفة[ع]] = []
    مواضع[مصفوفة[ع]].ألحق(ع)
  بعد_ = [-1] * ن
  بعد_[0] = 0
  طابور = [0]
  ك = 0
  طالما ك < طول(طابور):
    ق = طابور[ك]
    ك = ك + 1
    جيران = [ق - 1, ق + 1]
    لكل م في مواضع[مصفوفة[ق]]:
      جيران.ألحق(م)
    مواضع[مصفوفة[ق]] = []
    لكل ج في جيران:
      لو (ج >= 0) و (ج < ن):
        لو بعد_[ج] == -1:
          بعد_[ج] = بعد_[ق] + 1
          لو ج == ن - 1:
            ارجع بعد_[ج]
          طابور.ألحق(ج)
  ارجع بعد_[ن - 1]

تأكد_يساوي(اقل_قفزات([100,-23,-23,404,100,23,23,23,3,404]), 3, "ثلاث قفزات")
تأكد_يساوي(اقل_قفزات([7]), 0, "عنصر")
تأكد_يساوي(اقل_قفزات([7,6,9,6,9,6,9,7]), 1, "قفزة واحدة")
