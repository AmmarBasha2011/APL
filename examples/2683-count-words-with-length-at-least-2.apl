# مثال 2683 — كلمات طولها 2 فأكثر
# Words with length at least 2
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2683-count-words-with-length-at-least-2.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل و2 في ن.split():
    لو طول(و2) >= 2:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("the quick brown fox"), 4, "حالة 1")
تأكد_يساوي(ف("a b c"), 0, "حالة 2")
تأكد_يساوي(ف("hello world program"), 3, "حالة 3")
تأكد_يساوي(ف("x"), 0, "حالة 4")
