# مثال 1322 — مصفوفة توبليتز
# Toeplitz matrix check
# Demonstrates: شبكة
#
# Run:  python apl.py examples/1322-toeplitz-check.apl

# كل خلية تساوي الخلية القطرية العليا اليسرى
# نقارن كل خلية بما فوقها قطرياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة توبليتز(م):
  لكل ص في نطاق(1, طول(م)):
    لكل ج في نطاق(1, طول(م[0])):
      لو م[ص][ج] != م[ص - 1][ج - 1]:
        ارجع خطأ
  ارجع صواب

تأكد_يساوي(توبليتز([[1,2,3,4],[5,1,2,3],[9,5,1,2]]), صواب, "توبليتز")
تأكد_يساوي(توبليتز([[1,2],[2,2]]), خطأ, "ليست توبليتز")
تأكد_يساوي(توبليتز([[1]]), صواب, "خلية")
