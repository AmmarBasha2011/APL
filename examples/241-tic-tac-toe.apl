# مثال 241 — لعبة إكس أو (منطق)
# Tic-tac-toe logic
# Demonstrates: لوحة 3x3، فحص الفائز
#
# Run:  python apl.py examples/241-tic-tac-toe.apl

دالة فائز(لوحة):
    المتغير خطوط = [
        [لوحة[0], لوحة[1], لوحة[2]],
        [لوحة[3], لوحة[4], لوحة[5]],
        [لوحة[6], لوحة[7], لوحة[8]],
        [لوحة[0], لوحة[3], لوحة[6]],
        [لوحة[1], لوحة[4], لوحة[7]],
        [لوحة[2], لوحة[5], لوحة[8]],
        [لوحة[0], لوحة[4], لوحة[8]],
        [لوحة[2], لوحة[4], لوحة[6]]
    ]
    لكل خط في خطوط:
        لو خط[0] == خط[1] و خط[1] == خط[2] و خط[0] != " ":
            ارجع خط[0]
    ارجع لا_شيء

دالة اطبع_لوحة(لوحة):
    اطبع لوحة[0] + "|" + لوحة[1] + "|" + لوحة[2]
    اطبع "-+-+-"
    اطبع لوحة[3] + "|" + لوحة[4] + "|" + لوحة[5]
    اطبع "-+-+-"
    اطبع لوحة[6] + "|" + لوحة[7] + "|" + لوحة[8]

المتغير لوحة = ["X", "O", "X", "O", "X", "O", "X", " ", " "]
اطبع_لوحة(لوحة)
اطبع "الفائز:", فائز(لوحة)
