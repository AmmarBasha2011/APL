# مثال 3511 — مجموع قوى 42
# Sum of powers of 42
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3511-sum-of-powers-of-42-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 42 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 43, "حالة 2")
تأكد_يساوي(ف(3), 75895, "حالة 3")
تأكد_يساوي(ف(6), 5622910567, "حالة 4")
تأكد_يساوي(ف(10), 17496788319767527, "حالة 5")
