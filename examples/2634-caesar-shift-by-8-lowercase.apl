# مثال 2634 — قيصر بإزاحة 8
# Caesar shift 8
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2634-caesar-shift-by-8-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 8) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "ijk", "حالة 1")
تأكد_يساوي(ف("xyz"), "fgh", "حالة 2")
تأكد_يساوي(ف("hello world"), "pmttw ewztl", "حالة 3")
تأكد_يساوي(ف("a1"), "i1", "حالة 4")
