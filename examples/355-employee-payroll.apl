# مثال 355 — رواتب الموظفين
# Employee payroll
# Demonstrates: وراثة وحساب صافي
#
# Run:  python apl.py examples/355-employee-payroll.apl

صنف موظف:
    دالة_إنشاء(ذات, اسم, أساسي):
        ذات.اسم = اسم
        ذات.أساسي = أساسي

    دالة صافي(ذات):
        ارجع ذات.أساسي

    دالة قسيمة(ذات):
        اطبع ذات.اسم, ": الصافي =", ذات.صافي()

صنف مدير(موظف):
    دالة_إنشاء(ذات, اسم, أساسي, بدل):
        ذات.اسم = اسم
        ذات.أساسي = أساسي
        ذات.بدل = بدل

    دالة صافي(ذات):
        ارجع ذات.أساسي + ذات.بدل

صنف مندوب(موظف):
    دالة_إنشاء(ذات, اسم, أساسي, عمولة):
        ذات.اسم = اسم
        ذات.أساسي = أساسي
        ذات.عمولة = عمولة

    دالة صافي(ذات):
        ارجع ذات.أساسي + ذات.عمولة

موظف("أحمد", 5000).قسيمة()
مدير("سارة", 8000, 2000).قسيمة()
مندوب("خالد", 4000, 1500).قسيمة()
