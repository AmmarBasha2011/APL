# مثال 240 — نمط المركّب (نظام ملفات)
# Composite pattern (file system)
# Demonstrates: شجرة كائنات متجانسة
#
# Run:  python apl.py examples/240-composite.apl

صنف ملف:
    دالة_إنشاء(ذات, اسم, مقاس):
        ذات.اسم = اسم
        ذات.مقاس_الملف = مقاس

    دالة مقاس_كلي(ذات):
        ارجع ذات.مقاس_الملف

صنف مجلد:
    دالة_إنشاء(ذات, اسم):
        ذات.اسم = اسم
        ذات.محتويات = []

    دالة أضف_عنصر(ذات, عنصر):
        ذات.محتويات.append(عنصر)
        ارجع ذات

    دالة مقاس_كلي(ذات):
        المتغير مجموع = 0
        لكل عنصر في ذات.محتويات:
            مجموع = مجموع + عنصر.مقاس_كلي()
        ارجع مجموع

المتغير جذر = مجلد("الجذر")
جذر.أضف_عنصر(ملف("أ.txt", 100))
المتغير فرعي = مجلد("فرعي")
فرعي.أضف_عنصر(ملف("ب.txt", 200))
فرعي.أضف_عنصر(ملف("ج.txt", 300))
جذر.أضف_عنصر(فرعي)
اطبع "المقاس الكلي:", جذر.مقاس_كلي()
