# مثال 593 — اتجاه القبلة
# Qibla bearing
# Demonstrates: ملاحة كروية، قبلة، زاوية
#
# Run:  python apl.py examples/593-qibla-bearing.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# اتجاه القبلة من القاهرة: الزاوية من الشمال نحو الكعبة
# Demonstrates: راديان ودرجات, جب وجتا وم_ظا2, حساب الملاحة الكروية
# القاهرة: 30.0444 شمالا, 31.2357 شرقا — الكعبة: 21.4225 شمالا, 39.8262 شرقا

عرض_قاهرة = راديان(30.0444)
طول_قاهرة = راديان(31.2357)
عرض_كعبة = راديان(21.4225)
طول_كعبة = راديان(39.8262)
فرق_الطول = طول_كعبة - طول_قاهرة

بسط = جب(فرق_الطول) * جتا(عرض_كعبة)
مقام = جتا(عرض_قاهرة) * جب(عرض_كعبة) - جب(عرض_قاهرة) * جتا(عرض_كعبة) * جتا(فرق_الطول)
زاوية = درجات(م_ظا2(بسط, مقام))

اطبع "اتجاه القبلة من القاهرة:", مقرب(زاوية, 1), "درجة من الشمال"
تأكد_يساوي(مقرب(زاوية, 1), 136.1, "اتجاه القبلة 136.1 درجة")
