# مثال 3869 — إضافة 54 لكل عنصر
# Add 54 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3869-list-add-54-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 54]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [57, 55, 56], "حالة 1")
تأكد_يساوي(ف([5]), [59], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [55, 56, 57, 58, 59, 60], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [52, 54, 61, 61, 58], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [64, 74, 64, 84, 74, 64], "حالة 5")
