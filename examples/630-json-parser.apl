# مثال 630 — محلل JSON من الصفر
# JSON parser
# Demonstrates: تحليل عودي، محلل رمزي، JSON
#
# Run:  python apl.py examples/630-json-parser.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# محلل JSON مصغر من الصفر
# Demonstrates: تحليل عودي تنازلي, محلل رمزي, بناء قيم APL
# يحول نص JSON إلى قواميس وقوائم دون مكتبة

دالة محلل(نص):
  ارجع {"نص": نص, "موضع": 0}

دالة جسون_فراغ(م):
  طالما م["موضع"] < طول(م["نص"]) و م["نص"][م["موضع"]] == " ":
    م["موضع"] = م["موضع"] + 1

دالة جسون_حرف(م):
  ح = م["نص"][م["موضع"]]
  م["موضع"] = م["موضع"] + 1
  ارجع ح

دالة جسون_قيمة(م):
  جسون_فراغ(م)
  ح = م["نص"][م["موضع"]]
  لو ح == "{":
    ارجع جسون_كائن(م)
  لو ح == "[":
    ارجع جسون_قائمة(م)
  لو ترميز_حرف(ح) == 34:
    ارجع جسون_نص(م)
  ارجع جسون_عدد(م)

دالة جسون_نص(م):
  جسون_حرف(م)
  ناتج = ""
  طالما ترميز_حرف(م["نص"][م["موضع"]]) != 34:
    ناتج = ناتج + جسون_حرف(م)
  جسون_حرف(م)
  ارجع ناتج

دالة جسون_عدد(م):
  بداية = م["موضع"]
  طالما م["موضع"] < طول(م["نص"]) و م["نص"][م["موضع"]] في "0123456789.-":
    م["موضع"] = م["موضع"] + 1
  ارجع صحيح(م["نص"][بداية:م["موضع"]])

دالة جسون_كائن(م):
  جسون_حرف(م)
  قاموس = {}
  جسون_فراغ(م)
  لو م["نص"][م["موضع"]] == "}":
    جسون_حرف(م)
    ارجع قاموس
  طالما صواب:
    جسون_فراغ(م)
    مفتاح = جسون_نص(م)
    جسون_فراغ(م)
    جسون_حرف(م)
    قاموس[مفتاح] = جسون_قيمة(م)
    جسون_فراغ(م)
    ح = جسون_حرف(م)
    لو ح == "}":
      ارجع قاموس

دالة جسون_قائمة(م):
  جسون_حرف(م)
  عناصر = []
  جسون_فراغ(م)
  لو م["نص"][م["موضع"]] == "]":
    جسون_حرف(م)
    ارجع عناصر
  طالما صواب:
    عناصر.append(جسون_قيمة(م))
    جسون_فراغ(م)
    ح = جسون_حرف(م)
    لو ح == "]":
      ارجع عناصر

نص = "{ \"اسم\": \"أحمد\", \"عمر\": 30, \"هوايات\": [\"قراءة\", \"سباحة\"], \"رصيد\": -5 }"
م = محلل(نص)
قيمة = جسون_قيمة(م)
اطبع "الاسم:", قيمة["اسم"], " والعمر:", قيمة["عمر"]
تأكد_يساوي(قيمة["اسم"], "أحمد", "حقل نصي")
تأكد_يساوي(قيمة["عمر"], 30, "حقل عددي")
تأكد_يساوي(قيمة["هوايات"], ["قراءة", "سباحة"], "قائمة متداخلة")
تأكد_يساوي(قيمة["رصيد"], -5, "عدد سالب")
