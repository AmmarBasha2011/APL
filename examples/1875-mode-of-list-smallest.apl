# مثال 1875 — المنوال الأصغر
# Mode with smallest tie
# Demonstrates: إحصاء
#
# Run:  python apl.py examples/1875-mode-of-list-smallest.apl

# نعد التكرار بقاموس
# عند التعادل الأصغر قيمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة منوال(ق):
  عد = {}
  لكل ع في ق:
    عد[نص(ع)] = عد.get(نص(ع), 0) + 1
  أفضل = ق[0]
  أعلى = 0
  لكل ع في ق:
    ج = عد[نص(ع)]
    لو ج > أعلى أو (ج == أعلى و ع < أفضل):
      أعلى = ج
      أفضل = ع
  ارجع أفضل

تأكد_يساوي(منوال([1, 2, 2, 3, 3]), 2, "تعادل")
تأكد_يساوي(منوال([5]), 5, "واحد")
تأكد_يساوي(منوال([4, 4, 1, 1, 1]), 1, "أغلبية")
