# مثال 3905 — الحد النوني بخطوة 50
# Nth term step 50
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3905-nth-term-arithmetic-sequence-step-50.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 50

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 53, "حالة 2")
تأكد_يساوي(ف(10), 453, "حالة 3")
تأكد_يساوي(ف(100), 4953, "حالة 4")
