# مثال 1304 — قائمة متناظرة
# Palindrome list check
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1304-palindrome-linked-list.apl

# ننسخ النصف الثاني معكوساً
# ونقارنه بالنصف الأول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متناظرة(قيم):
  ن = طول(قيم)
  نصف = ن // 2
  اول = قيم[:نصف]
  ثان = قيم[ن - نصف:]
  ثان.reverse()
  ارجع اول == ثان

تأكد_يساوي(متناظرة([1,2,2,1]), صواب, "زوجي")
تأكد_يساوي(متناظرة([1,2,3,2,1]), صواب, "فردي")
تأكد_يساوي(متناظرة([1,2]), خطأ, "غير متناظرة")
تأكد_يساوي(متناظرة([]), صواب, "فارغة")
