# مثال 191 — كشف الجناس الناقص
# Anagram detection
# Demonstrates: مفرز، ضم، تجميع بالقواميس
#
# Run:  python apl.py examples/191-anagrams.apl

دالة مفتاح_جناس(كلمة):
    ارجع "".ضم(مفرز(كلمة))

دالة جناس(أ, ب):
    ارجع مفتاح_جناس(أ) == مفتاح_جناس(ب)

اطبع "listen / silent:", جناس("listen", "silent")
اطبع "hello / world:", جناس("hello", "world")

المتغير كلمات = ["eat", "tea", "tan", "ate", "nat", "bat"]
المتغير مجموعات = {}
لكل ك في كلمات:
    المتغير م = مفتاح_جناس(ك)
    لو م ليس في مجموعات:
        مجموعات[م] = []
    مجموعات[م].أضف(ك)

لكل م في مجموعات:
    اطبع مجموعات[م]
