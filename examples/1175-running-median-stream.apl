# مثال 1175 — وسيط متدفق
# Running median of a stream
# Demonstrates: إدراج مرتب
#
# Run:  python apl.py examples/1175-running-median-stream.apl

# ندرج كل رقم في مكانه بقائمة مرتبة
# ونقرأ الوسيط بعد كل إدراج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف وسيط_متدفق:
  دالة_إنشاء(ذات):
    ذات.مرتبة = []

  دالة اضف(ذات, س):
    ع = 0
    طالما (ع < طول(ذات.مرتبة)) و (ذات.مرتبة[ع] < س):
      ع = ع + 1
    ذات.مرتبة.insert(ع, س)

  دالة الوسيط(ذات):
    ن = طول(ذات.مرتبة)
    لو ن % 2 == 1:
      ارجع ذات.مرتبة[ن // 2] * 1.0
    ارجع (ذات.مرتبة[ن // 2 - 1] + ذات.مرتبة[ن // 2]) / 2

م = وسيط_متدفق()
نتائج = []
لكل س في [5, 15, 1, 3]:
  م.اضف(س)
  نتائج.ألحق(م.الوسيط())
تأكد_يساوي(نتائج, [5.0, 10.0, 5.0, 4.0], "تدفق")
