# مثال 143 — كتابة وقراءة CSV
# CSV write and read
# Demonstrates: اقرأ_csv، كتابة نص، تقسيم
#
# Run:  python apl.py examples/143-csv-write-read.apl

المتغير مسار = "/tmp/apl_csv_demo.csv"
اكتب(مسار, "الاسم,العمر,المدينة\nعمار,26,المنصورة\nسارة,24,القاهرة\n")

المتغير محتوى = اقرأ(مسار).تقليم()
المتغير صفوف = قائمة(اقرأ_csv(محتوى.تقسيم("\n")))
اطبع "الترويسة:", صفوف[0]
اطبع "أول صف:", صفوف[1]
اطبع "عدد الصفوف:", طول(صفوف) - 1

احذف_ملف(مسار)
