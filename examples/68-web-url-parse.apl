# مثال 68 — تحليل وبناء العناوين (مكتبة web)
# Parsing, quoting and joining URLs (urllib.parse)
#
# Run:  python apl.py examples/68-web-url-parse.apl

المتغير عنوان = "https://user:pass@example.com:8080/path/to/page?a=1&b=2#frag"

اطبع "=== تحليل عنوان ==="
المتغير ج = حلل_العنوان(عنوان)
اطبع "المخطط:", ج.حلل_نتيجة_مخطط
اطبع "موضع_الشبكة:", ج.حلل_نتيجة_موضع_الشبكة
اطبع "اسم_المضيف:", ج.حلل_نتيجة_اسم_المضيف
اطبع "المنفذ:", ج.حلل_نتيجة_منفذ
اطبع "المسار:", ج.حلل_نتيجة_مسار
اطبع "الاستعلام:", ج.حلل_نتيجة_استعلام
اطبع "اسم_المستخدم:", ج.حلل_نتيجة_اسم_المستخدم
اطبع "كلمة_المرور:", ج.حلل_نتيجة_كلمة_المرور

اطبع ""
اطبع "=== ترميز الاستعلام ==="
المتغير معاملات = {"نص": "أهلاً بالعالم", "صفحة": "2"}
اطبع "رمّز_العنوان:", رمّز_العنوان(معاملات)

اطبع ""
اطبع "=== الاقتباس ==="
اطبع "اقتبس_عنوان:", اقتبس_عنوان("أهلاً بالعالم")
اطبع "فكّ_اقتباس_عنوان:", فكّ_اقتباس_عنوان("%D8%A3%D9%87%D9%84%D8%A7%D9%8B")

اطبع ""
اطبع "=== ربط العناوين ==="
اطبع "اربط_العنوان:", اربط_العنوان("https://example.com/a/b/", "../c/d")
اطبع "وحّد_العنوان:", وحّد_العنوان(["https", "example.com", "/x", "k=1", ""])
