# مثال 626 — مجموع CRC32
# CRC32 checksum
# Demonstrates: CRC32، بتات، تحقق
#
# Run:  python apl.py examples/626-crc32.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مجموع CRC32 الاختباري بت بت
# Demonstrates: كثيرة حدود عكسية, أو-حصري على البتات, قيمة تحقق معيارية
# نفس الخوارزمية في zip و PNG و Ethernet

دالة كrc32(نص):
  بيانات = نص.encode("utf-8")
  ك = 4294967295
  لكل بايت في بيانات:
    ك = ك ^ بايت
    لكل بت في نطاق(8):
      لو ك % 2 == 1:
        ك = (ك // 2) ^ 3988292384
      والا:
        ك = ك // 2
  ارجع ك ^ 4294967295

نتيجة = كrc32("123456789")
اطبع "CRC32(123456789) =", نتيجة
تأكد_يساوي(نتيجة, 3421780262, "القيمة المعيارية 0xCBF43926")
تأكد_يساوي(كrc32(""), 0, "نص فارغ")
تأكد_يساوي(كrc32("أ") != كrc32("ب"), صواب, "حرف مختلف يعطي قيمة مختلفة")
