# مثال 1296 — أول إصدار سيئ
# First bad version
# Demonstrates: بحث ثنائي
#
# Run:  python apl.py examples/1296-data-stream-first-bad.apl

# الإصدارات بعد السيئ كلها سيئة
# فنبحث ثنائياً عن أول سيئ

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اول_سيئ(ن, الاول_السيئ):
  يسار = 1
  يمين = ن
  استدعاءات = 0
  طالما يسار < يمين:
    وسط = (يسار + يمين) // 2
    استدعاءات = استدعاءات + 1
    لو وسط >= الاول_السيئ:
      يمين = وسط
    والا:
      يسار = وسط + 1
  ارجع [يسار, استدعاءات]

تأكد_يساوي(اول_سيئ(5, 4)[0], 4, "خمسة")
تأكد_يساوي(اول_سيئ(1, 1)[0], 1, "واحد")
تأكد_يساوي(اول_سيئ(1000, 777)[0], 777, "ألف")
تأكد_يساوي(اول_سيئ(1000, 777)[1] <= 10, صواب, "عدد قليل من الاستدعاءات")
