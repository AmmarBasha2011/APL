# مثال 3467 — إضافة 43 لكل عنصر
# Add 43 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3467-list-add-43-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 43]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [46, 44, 45], "حالة 1")
تأكد_يساوي(ف([5]), [48], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [44, 45, 46, 47, 48, 49], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [41, 43, 50, 50, 47], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [53, 63, 53, 73, 63, 53], "حالة 5")
