# مثال 604 — جولة الحصان
# Knight tour
# Demonstrates: حصان الشطرنج، وارنسدورف، جولة
#
# Run:  python apl.py examples/604-knight-tour.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# جولة الحصان: زيارة كل مربع مرة واحدة
# Demonstrates: قاعدة وارنسدورف, أقل الخيارات أولا, تحقق من الجولة
# حصان الشطرنج يتحرك بحرف L

ن = 8
حركات = [[2, 1], [2, -1], [-2, 1], [-2, -1], [1, 2], [1, -2], [-1, 2], [-1, -2]]

دالة داخل(س, ص):
  ارجع س >= 0 و س < ن و ص >= 0 و ص < ن

دالة عدد_الخيارات(س, ص, لوحة):
  عدد = 0
  لكل ح في حركات:
    لو داخل(س + ح[0], ص + ح[1]) و لوحة[س + ح[0]][ص + ح[1]] == -1:
      عدد = عدد + 1
  ارجع عدد

لوحة = []
لكل ي في نطاق(ن):
  لوحة.append([-1] * ن)
لوحة[0][0] = 0
س = 0
ص = 0
لكل خطوة في نطاق(1, ن * ن):
  أفضل = -1
  أقل = ن + 1
  لكل ح في حركات:
    س2 = س + ح[0]
    ص2 = ص + ح[1]
    لو داخل(س2, ص2) و لوحة[س2][ص2] == -1:
      خيارات = عدد_الخيارات(س2, ص2, لوحة)
      لو خيارات < أقل:
        أقل = خيارات
        أفضل = ح
  س = س + أفضل[0]
  ص = ص + أفضل[1]
  لوحة[س][ص] = خطوة

اطبع "آخر خطوة:", لوحة[س][ص]
تأكد_يساوي(لوحة[س][ص], ن * ن - 1, "زيارة كل المربعات")
مجموع = 0
لكل صف في لوحة:
  لكل خانة في صف:
    مجموع = مجموع + خانة
تأكد_يساوي(مجموع, (ن * ن - 1) * ن * ن // 2, "مجموع أرقام الخطوات")
