# مثال 1334 — أكبر مجموعة قابلة للقسمة
# Largest divisible subset
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1334-largest-divisible-subset.apl

# نرتب الأرقام ثم نبني سلسلة القسمة
# نتتبع السابق لاسترجاع المجموعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اكبر_قسمة(أرقام):
  لو طول(أرقام) == 0:
    ارجع []
  ر = مفرز(أرقام)
  ن = طول(ر)
  طول_ = [1] * ن
  سابق = [-1] * ن
  افضل = 0
  لكل ع في نطاق(ن):
    لكل ج في نطاق(ع):
      لو (ر[ع] % ر[ج] == 0) و (طول_[ج] + 1 > طول_[ع]):
        طول_[ع] = طول_[ج] + 1
        سابق[ع] = ج
    لو طول_[ع] > طول_[افضل]:
      افضل = ع
  ناتج = []
  ع = افضل
  طالما ع != -1:
    ناتج.ألحق(ر[ع])
    ع = سابق[ع]
  ناتج.reverse()
  ارجع ناتج

تأكد_يساوي(اكبر_قسمة([1,2,3]), [1,2], "ثلاثة")
تأكد_يساوي(اكبر_قسمة([1,2,4,8]), [1,2,4,8], "قوى اثنين")
تأكد_يساوي(اكبر_قسمة([]), [], "فارغة")
