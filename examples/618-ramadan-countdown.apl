# مثال 618 — العد التنازلي لرمضان
# Ramadan countdown
# Demonstrates: رمضان، دورة ثلاثينية، فرق تواريخ
#
# Run:  python apl.py examples/618-ramadan-countdown.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# العد التنازلي لرمضان بالتقويم الاصطلاحي
# Demonstrates: تحويل هجري إلى أيام مطلقة, فرق تواريخ, دورة 30 سنة
# يحسب الأيام المتبقية حتى أول رمضان من أي تاريخ هجري

دالة كبيسة(سنة):
  ارجع سنة % 30 في [2, 5, 7, 10, 13, 16, 18, 21, 24, 26, 29]

دالة أيام_حتى_سنة(سنة):
  دورات = (سنة - 1) // 30
  باقي = (سنة - 1) % 30
  مجموع = دورات * 10631
  لكل س في نطاق(1, باقي + 1):
    لو كبيسة(س):
      مجموع = مجموع + 355
    والا:
      مجموع = مجموع + 354
  ارجع مجموع

دالة طول_شهر(سنة, شهر):
  لو شهر % 2 == 1:
    ارجع 30
  لو شهر == 12 و كبيسة(سنة):
    ارجع 30
  ارجع 29

دالة رقم_مطلق(سنة, شهر, يوم):
  مجموع = أيام_حتى_سنة(سنة) + يوم - 1
  لكل م في نطاق(1, شهر):
    مجموع = مجموع + طول_شهر(سنة, م)
  ارجع مجموع

دالة متبقي_لرمضان(سنة, شهر, يوم):
  لو شهر <= 9:
    هدف = رقم_مطلق(سنة, 9, 1)
  والا:
    هدف = رقم_مطلق(سنة + 1, 9, 1)
  ارجع هدف - رقم_مطلق(سنة, شهر, يوم)

تأكد_يساوي(متبقي_لرمضان(1447, 9, 1), 0, "أول رمضان نفسه")
تأكد_يساوي(متبقي_لرمضان(1447, 8, 1), 29, "شعبان 29 قبل رمضان")
تأكد_يساوي(متبقي_لرمضان(1447, 1, 1), 236, "من أول محرم")
بعد_رمضان = متبقي_لرمضان(1447, 10, 1)
اطبع "من أول شوال إلى رمضان التالي:", بعد_رمضان
تأكد_يساوي(بعد_رمضان, 325, "من شوال إلى رمضان 1448")
