# مثال 937 — ضغط LZW
# LZW compression
# Demonstrates: قاموس ينمو أثناء القراءة
#
# Run:  python apl.py examples/937-lzw.apl

# ضغط LZW: قاموس يكبر أثناء القراءة بلا نوافذ
# أساس GIF و compress

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# قاموس: قوائم متوازية (سلسلة، رمز)
دالة ابحث_قاموس(سلاسل, هدف):
  لكل i في نطاق(طول(سلاسل)):
    لو سلاسل[i] == هدف:
      ارجع i
  ارجع -1

دالة اضغط(نص):
  سلاسل = []
  رموز = []
  # القاموس الأولي: كل حرف منفرد موجود في النص
  لكل i في نطاق(طول(نص)):
    حرف = نص[i]
    لو ابحث_قاموس(سلاسل, حرف) < 0:
      سلاسل.ألحق(حرف)
      رموز.ألحق(ترميز_حرف(حرف))
  تالي = 256
  خرج = []
  جاري = ""
  لكل i في نطاق(طول(نص)):
    حرف = نص[i]
    مرشح = جاري + حرف
    لو ابحث_قاموس(سلاسل, مرشح) >= 0:
      جاري = مرشح
    والا:
      خرج.ألحق(رموز[ابحث_قاموس(سلاسل, جاري)])
      سلاسل.ألحق(مرشح)
      رموز.ألحق(تالي)
      تالي = تالي + 1
      جاري = حرف
  لو جاري != "":
    خرج.ألحق(رموز[ابحث_قاموس(سلاسل, جاري)])
  ارجع خرج

ناتج = اضغط("TOBEORNOTTOBEORTOBEORNOT")
اطبع "الرموز:", ناتج

متوقع = [84, 79, 66, 69, 79, 82, 78, 79, 84, 256, 258, 260, 265, 259, 261, 263]
تأكد_يساوي(طول(ناتج), 16, "16 رمزاً")
لكل i في نطاق(16):
  تأكد_يساوي(ناتج[i], متوقع[i], "رمز " + نص(i))

# نص من 25 حرفاً يضغط إلى 16 رمزاً
لو طول(ناتج) >= طول("TOBEORNOTTOBEORTOBEORNOT"):
  اطبع "فشل: لم يحدث ضغط"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: ضغط فعلي"
