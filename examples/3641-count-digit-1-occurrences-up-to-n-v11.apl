# مثال 3641 — عدد ظهور الرقم 1 حتى ن
# Occurrences of digit 1 up to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3641-count-digit-1-occurrences-up-to-n-v11.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(1, ن + 1):
    ع = ع + نص(ي).count("1")
  ارجع ع

تأكد_يساوي(ف(9), 1, "حالة 1")
تأكد_يساوي(ف(10), 2, "حالة 2")
تأكد_يساوي(ف(50), 15, "حالة 3")
تأكد_يساوي(ف(100), 21, "حالة 4")
تأكد_يساوي(ف(200), 140, "حالة 5")
