# مثال 2680 — تحويل وحدة بأساس 2
# Split by base 2
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2680-minutes-to-hours-and-minutes-base-2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 2, ن % 2]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [29, 1], "حالة 2")
تأكد_يساوي(ف(60), [30, 0], "حالة 3")
تأكد_يساوي(ف(125), [62, 1], "حالة 4")
تأكد_يساوي(ف(1000), [500, 0], "حالة 5")
