# مثال 3114 — إزاحة يمين 7
# Shift right by 7
# Demonstrates: بتات
#
# Run:  python apl.py examples/3114-shift-right-by-7-bits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 7

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(16), 0, "حالة 2")
تأكد_يساوي(ف(255), 1, "حالة 3")
تأكد_يساوي(ف(1000), 7, "حالة 4")
تأكد_يساوي(ف(65535), 511, "حالة 5")
