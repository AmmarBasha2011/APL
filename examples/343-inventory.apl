# مثال 343 — مخزون منتجات
# Product inventory
# Demonstrates: كميات وقيمة إجمالية
#
# Run:  python apl.py examples/343-inventory.apl

المتغير مسار = "/tmp/apl_inventory_343.json"

المتغير مخزون = [
    {"منتج": "شاشة", "كمية": 10, "سعر": 3000},
    {"منتج": "لوحة مفاتيح", "كمية": 25, "سعر": 400},
    {"منتج": "فأرة", "كمية": 0, "سعر": 250}
]

اكتب_ملف_جسون(مخزون, مسار)
المتغير محمل = اقرأ_ملف_جسون(مسار)

المتغير قيمة = 0
لكل م in محمل:
    قيمة = قيمة + م["كمية"] * م["سعر"]
    لو م["كمية"] == 0:
        اطبع "نفد:", م["منتج"]

اطبع "قيمة المخزون:", قيمة
احذف_ملف(مسار)
