# مثال 2938 — مجموع ord مع إزاحة 3
# Sum of ord values plus 3 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2938-sum-of-ord-values-offset-3.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 3
  ارجع م

تأكد_يساوي(ف("a"), 100, "حالة 1")
تأكد_يساوي(ف("abc"), 303, "حالة 2")
تأكد_يساوي(ف("xyz"), 372, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
