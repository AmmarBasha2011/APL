# مثال 443 — حسابات الدائرة والخط
# Circle and line math
# Demonstrates: محيط ومساحة وميل
#
# Run:  python apl.py examples/443-circle-line.apl

المتغير باي = 3.14159265358979

دالة دائرة(نصف_قطر):
    ارجع [باي * نصف_قطر * نصف_قطر, 2 * باي * نصف_قطر]

دالة ميل_خط(س1, ص1, س2, ص2):
    لو س2 == س1:
        ارجع "رأسي"
    ارجع (ص2 - ص1) / (س2 - س1)

المتغير نتيجة = دائرة(5)
اطبع "المساحة:", نتيجة[0]
اطبع "المحيط:", نتيجة[1]
اطبع "الميل:", ميل_خط(0, 0, 2, 6)
اطبع "الميل:", ميل_خط(3, 1, 3, 5)
