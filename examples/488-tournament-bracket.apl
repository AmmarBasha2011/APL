# مثال 488 — شجرة بطولة
# Tournament bracket
# Demonstrates: أدوار إقصائية
#
# Run:  python apl.py examples/488-tournament-bracket.apl

بذرة(5)
دالة دور(فرق, اسم_دور):
    اطبع "==", اسم_دور, "=="
    المتغير فائزون = []
    لكل ي في نطاق(0, طول(فرق), 2):
        المتغير فائز = فرق[ي + عشوائي_عدد(0, 1)]
        اطبع فرق[ي], "ضد", فرق[ي + 1], "-> فاز", فائز
        فائزون.append(فائز)
    ارجع فائزون

المتغير فرق = ["النادي أ", "النادي ب", "النادي ج", "النادي د"]
المتغير نصف = دور(فرق, "نصف النهائي")
المتغير نهائي = دور(نصف, "النهائي")
اطبع "البطل:", نهائي[0]
