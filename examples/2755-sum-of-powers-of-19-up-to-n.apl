# مثال 2755 — مجموع قوى 19
# Sum of powers of 19
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2755-sum-of-powers-of-19-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 19 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 20, "حالة 2")
تأكد_يساوي(ف(3), 7240, "حالة 3")
تأكد_يساوي(ف(6), 49659541, "حالة 4")
تأكد_يساوي(ف(10), 6471681049901, "حالة 5")
