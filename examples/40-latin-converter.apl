# مثال 40 — تحويل بين الأرقام العربية والهندية
# Arabic-Indic Digit Converter
# Demonstrates: ord/chr, string building, loops
#
# Run:  python apl.py examples/40-latin-converter.apl

دالة_إلى_عربية(رقم_نص):
    الناتج = ""
    لكل حرف in رقم_نص:
        لو حرف >= "0" وحرف <= "9":
            الناتج = الناتج + فك_ترميز_حرف(ترميز_حرف(حرف) - 48 + 1632)
        والا:
            الناتج = الناتج + حرف
    ارجع الناتج

دالة_إلى_لاتينية(رقم_نص):
    الناتج = ""
    لكل حرف in رقم_نص:
        لو حرف >= "\u0660" وحرف <= "\u0669":
            الناتج = الناتج + فك_ترميز_حرف(ترميز_حرف(حرف) - 1632 + 48)
        والا:
            الناتج = الناتج + حرف
    ارجع الناتج

اطبع "=== تحويل الأرقام ==="
اطبع ""
المتغير أمثلة = ["2026", "3.14", "1000", "42"]
لكل رقم in أمثلة:
    عربي = دالة_إلى_عربية(رقم)
    لاتيني = دالة_إلى_لاتينية(عربي)
    اطبع "  " + رقم + " -> " + عربي + " -> " + لاتيني
اطبع ""
اطبع "التحقق: " + نص(دالة_إلى_لاتينية(دالة_إلى_عربية("2026")) == "2026")
