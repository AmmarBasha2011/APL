# مثال 4156 — السعر مع ضريبة 41 بالمئة
# Price with 41 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4156-price-with-41-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 41 // 100

تأكد_يساوي(ف(100), 141, "حالة 1")
تأكد_يساوي(ف(250), 352, "حالة 2")
تأكد_يساوي(ف(999), 1408, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
