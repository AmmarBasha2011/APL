# مثال 166 — بناء مستند XML من الصفر
# Building an XML document
# Demonstrates: عنصر_جديد، عنصر_فرعي_جديد، غذِّ_نص_العنصر، إكس_إم_إل_إلى_نص
#
# Run:  python apl.py examples/166-xml-build.apl

المتغير قناة = عنصر_جديد("قناة")
عين_خاصية(قناة, "اللغة", "العربية")

المتغير عنصر1 = عنصر_فرعي_جديد(قناة, "خبر")
غذِّ_نص_العنصر(عنصر1, "إطلاق الإصدار الجديد")
المتغير عنصر2 = عنصر_فرعي_جديد(قناة, "خبر")
غذِّ_نص_العنصر(عنصر2, "توثيق كامل لكل المكتبات")

اطبع إكس_إم_إل_إلى_نص(قناة)
اطبع "عدد الأخبار:", عد_العناصر(قناة, "خبر")
اطبع "صيغة سليمة؟", تحقق_من_عنصر(إكس_إم_إل_إلى_نص(قناة))
