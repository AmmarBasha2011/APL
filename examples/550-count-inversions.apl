# مثال 550 — عدّ المعكوسات
# Counting inversions
# Demonstrates: معكوسات، فرز دمج، عد
#
# Run:  python apl.py examples/550-count-inversions.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# عدّ المعكوسات بفرز الدمج
دالة عدّ_ودمج(ق):
    لو طول(ق) <= 1:
        ارجع [ق, 0]
    المتغير وسط = طول(ق) // 2
    المتغير يسار = عدّ_ودمج(ق[:وسط])
    المتغير يمين = عدّ_ودمج(ق[وسط:])
    المتغير مدمج = قائمة()
    المتغير معكوسات = يسار[1] + يمين[1]
    المتغير i = 0
    المتغير j = 0
    طالما i < طول(يسار[0]) و j < طول(يمين[0]):
        لو يسار[0][i] <= يمين[0][j]:
            مدمج.أضف(يسار[0][i])
            i = i + 1
        الا:
            مدمج.أضف(يمين[0][j])
            معكوسات = معكوسات + طول(يسار[0]) - i
            j = j + 1
    مدمج = مدمج + يسار[0][i:] + يمين[0][j:]
    ارجع [مدمج, معكوسات]

المتغير نتيجة = عدّ_ودمج([8, 4, 2, 1])
تأكد_يساوي(نتيجة[1], 6, "معكوسات [8,4,2,1]")
تأكد_يساوي(نتيجة[0], [1, 2, 4, 8], "الفرز سليم")
تأكد_يساوي(عدّ_ودمج([1, 2, 3])[1], 0, "مفرزة بلا معكوسات")
