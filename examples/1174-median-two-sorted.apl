# مثال 1174 — وسيط قائمتين
# Median of two sorted lists
# Demonstrates: دمج
#
# Run:  python apl.py examples/1174-median-two-sorted.apl

# ندمج القائمتين بترتيب
# ونأخذ الوسيط من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادمج(أ, ب):
  ن = []
  ي = 0
  ك = 0
  طالما (ي < طول(أ)) و (ك < طول(ب)):
    لو أ[ي] <= ب[ك]:
      ن.ألحق(أ[ي])
      ي = ي + 1
    والا:
      ن.ألحق(ب[ك])
      ك = ك + 1
  ارجع ن + أ[ي:] + ب[ك:]

دالة وسيط_قائمتين(أ, ب):
  م = ادمج(أ, ب)
  ع = طول(م)
  لو ع % 2 == 1:
    ارجع م[ع // 2] * 1.0
  ارجع (م[ع // 2 - 1] + م[ع // 2]) / 2

تأكد_يساوي(وسيط_قائمتين([1,3], [2]), 2.0, "فردي")
تأكد_يساوي(وسيط_قائمتين([1,2], [3,4]), 2.5, "زوجي")
تأكد_يساوي(وسيط_قائمتين([], [1]), 1.0, "فارغة")
تأكد_يساوي(وسيط_قائمتين([0,0], [0,0]), 0.0, "أصفار")
