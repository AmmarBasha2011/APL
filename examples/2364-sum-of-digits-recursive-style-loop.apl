# مثال 2364 — مجموع الأرقام بالباقي
# Digit sum by remainder
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2364-sum-of-digits-recursive-style-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(9), 9, "حالة 2")
تأكد_يساوي(ف(123), 6, "حالة 3")
تأكد_يساوي(ف(9999), 36, "حالة 4")
تأكد_يساوي(ف(1000001), 2, "حالة 5")
