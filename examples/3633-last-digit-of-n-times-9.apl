# مثال 3633 — آخر رقم من ن×9
# Last digit of n times 9
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3633-last-digit-of-n-times-9.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 9) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 9, "حالة 2")
تأكد_يساوي(ف(7), 3, "حالة 3")
تأكد_يساوي(ف(12), 8, "حالة 4")
تأكد_يساوي(ف(99), 1, "حالة 5")
