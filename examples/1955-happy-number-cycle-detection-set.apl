# مثال 1955 — العدد السعيد
# Happy number check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1955-happy-number-cycle-detection-set.apl

# # نحفظ الأعداد التي مررنا بها في قاموس
# # إن تكرر عدد فقد دخلنا دورة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة سعيد(ن):
  رأينا = {}
  طالما ن != 1 و (ن في رأينا) == خطأ:
    رأينا[ن] = 1
    مج = 0
    لكل ر في نص(ن):
      مج = مج + int(ر) * int(ر)
    ن = مج
  ارجع ن == 1

تأكد_يساوي(سعيد(19), صواب, "١٩")
تأكد_يساوي(سعيد(2), خطأ, "٢")
تأكد_يساوي(سعيد(7), صواب, "٧")
تأكد_يساوي(سعيد(1), صواب, "١")
