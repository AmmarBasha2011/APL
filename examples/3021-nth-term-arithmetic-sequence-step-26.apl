# مثال 3021 — الحد النوني بخطوة 26
# Nth term step 26
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3021-nth-term-arithmetic-sequence-step-26.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 26

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 29, "حالة 2")
تأكد_يساوي(ف(10), 237, "حالة 3")
تأكد_يساوي(ف(100), 2577, "حالة 4")
