# مثال 515 — فرز الحاويات
# Bucket sort
# Demonstrates: فرز الحاويات، توزيع على سلال
#
# Run:  python apl.py examples/515-bucket-sort.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# فرز الحاويات لأعداد بين 0 و1
المتغير ق = [0.42, 0.32, 0.23, 0.52, 0.25, 0.47, 0.51, 0.05]
المتغير حاويات = [[], [], [], [], [], [], [], [], [], []]
لكل س في ق:
    حاويات[صحيح(س * 10)].أضف(س)
المتغير ناتج = قائمة()
لكل حاوية في حاويات:
    لكل س في مفرز(حاوية):
        ناتج.أضف(س)
اطبع "مفرزة:", ناتج
تأكد_يساوي(ناتج[0], 0.05, "أصغر عنصر")
تأكد_يساوي(ناتج[7], 0.52, "أكبر عنصر")
تأكد_يساوي(طول(ناتج), 8, "العدد ثابت")
