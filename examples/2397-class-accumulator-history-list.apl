# مثال 2397 — صنف مجمع بسجل
# Accumulator with history
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2397-class-accumulator-history-list.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مجمع:
    دالة_إنشاء(ذات):
        ذات.م = 0
        ذات.س = []

    دالة اضف(ذات, ق):
        ذات.م = ذات.م + ق
        ذات.س = ذات.س + [ذات.م]

مج = مجمع()
مج.اضف(5)
مج.اضف(10)
مج.اضف(-3)
تأكد_يساوي(مج.م, 12, "المجموع")
تأكد_يساوي(مج.س, [5, 15, 12], "السجل")
