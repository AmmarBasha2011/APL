# مثال 2891 — الحد النوني بخطوة 22
# Nth term step 22
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2891-nth-term-arithmetic-sequence-step-22.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 22

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 25, "حالة 2")
تأكد_يساوي(ف(10), 201, "حالة 3")
تأكد_يساوي(ف(100), 2181, "حالة 4")
