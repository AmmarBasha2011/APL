# مثال 118 — الاستبدال والتقسيم بالأنماط
# Regex substitution and splitting
# Demonstrates: استبدل، استبدل_عدد، قسم_نمطي، هرب
#
# Run:  python apl.py examples/118-re-substitutions.apl

المتغير نص = "رقم بطاقتي 1234-5678-9012-3456 وسري للغاية"
اطبع "الأصل:", نص
اطبع "المُقنَّع:", استبدل("[0-9]", "*", نص)

المتغير سطر = "الاسم:عمار، العمر:26، المدينة:المنصورة"
اطبع "التقسيم:", قسم_نمطي("[:،]", سطر)

المتغير نتيجة = استبدل_عدد("[0-9]+", "N", "عندي 3 قطط و 7 كلاب")
اطبع "استبدل_عدد:", نتيجة

اطبع "هرب:", هرب("سعر (خاص) 100%")
