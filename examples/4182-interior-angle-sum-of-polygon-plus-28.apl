# مثال 4182 — مجموع زوايا مضلع زائد 28
# Polygon angle sum plus 28
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4182-interior-angle-sum-of-polygon-plus-28.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 28

تأكد_يساوي(ف(3), 208, "حالة 1")
تأكد_يساوي(ف(4), 388, "حالة 2")
تأكد_يساوي(ف(5), 568, "حالة 3")
تأكد_يساوي(ف(6), 748, "حالة 4")
تأكد_يساوي(ف(12), 1828, "حالة 5")
