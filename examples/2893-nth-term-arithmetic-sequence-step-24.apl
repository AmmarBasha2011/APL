# مثال 2893 — الحد النوني بخطوة 24
# Nth term step 24
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2893-nth-term-arithmetic-sequence-step-24.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 24

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 27, "حالة 2")
تأكد_يساوي(ف(10), 219, "حالة 3")
تأكد_يساوي(ف(100), 2379, "حالة 4")
