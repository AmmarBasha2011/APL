# مثال 3736 — مجموع الأعداد من 31 إلى ن
# Sum from 31 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3736-sum-of-integers-from-31-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(31, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(31), 31, "حالة 1")
تأكد_يساوي(ف(32), 63, "حالة 2")
تأكد_يساوي(ف(41), 396, "حالة 3")
تأكد_يساوي(ف(100), 4585, "حالة 4")
