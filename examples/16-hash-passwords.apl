# مثال 16 — بصمات كلمات السر
# Password Hashing & Verification
# Demonstrates: hashlib, secrets, random salt, comparison
#
# Run:  python apl.py examples/16-hash-passwords.apl

دالة بصمة_مع_ملح(كلمة_السر, ملح):
    مدخل = ملح + ":" + كلمة_السر
    أ = تجزئة_sha256(مدخل.encode("utf-8")).hexdigest()
    ملح_جديد = secrets_ملح()
    مدخل2 = ملح_جديد + ":" + كلمة_السر
    ب = تجزئة_sha256(مدخل2.encode("utf-8")).hexdigest()
    ارجع ملح_جديد + "|" + ب

دالة تحقق(كلمة_السر, مخزن):
    Parts = تقسيم(مخزن, "|")
    الملح = Parts[0]
    المحفوظ = Parts[1]
    المحسوب = تجزئة_sha256((الملح + ":" + كلمة_السر).encode("utf-8")).hexdigest()
    ارجع مقارنة_آمنة(المحسوب, المحفوظ)

دالة secrets_ملح():
    ارجع سر_سداسي(16)

اطبع "=== بصمات كلمات السر ==="
المتغير كلمة = "MySecret123"
المتغير التجزئة = بصمة_مع_ملح(كلمة, "salt123")
اطبع "كلمة السر: " + كلمة
اطبع "البصمة المخزنة (مقتطعة): " + نص(التجزئة[0:40]) + "..."
اطبع ""
اطبع "تحقق بكلمة صحيحة: " + نص(تحقق(كلمة, التجزئة))
اطبع "تحقق بكلمة خاطئة: " + نص(تحقق("wrong", التجزئة))
اطبع ""
اطبع "--- ملح عشوائي ---"
اطبع "ملح جديد: " + سر_سداسي(8)
اطبع "طول SHA256: " + نص(طول(تجزئة_sha256(كلمة.encode("utf-8")).hexdigest()))
