# مثال 2750 — الحد النوني بخطوة 19
# Nth term step 19
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2750-nth-term-arithmetic-sequence-step-19.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 19

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 22, "حالة 2")
تأكد_يساوي(ف(10), 174, "حالة 3")
تأكد_يساوي(ف(100), 1884, "حالة 4")
