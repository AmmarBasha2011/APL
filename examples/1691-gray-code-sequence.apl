# مثال 1691 — شيفرة غراي
# Gray code sequence
# Demonstrates: بتات
#
# Run:  python apl.py examples/1691-gray-code-sequence.apl

# غراي(ن) = ن ^ (ن >> 1)
# نولد التسلسل كاملاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة غراي(ن):
  ارجع ن ^ (ن >> 1)

دالة تسلسل_غراي(بتات):
  ناتج = []
  لكل ع في نطاق(2 ** بتات):
    ناتج.append(غراي(ع))
  ارجع ناتج

تأكد_يساوي(تسلسل_غراي(2), [0, 1, 3, 2], "بتان")
تأكد_يساوي(تسلسل_غراي(3), [0, 1, 3, 2, 6, 7, 5, 4], "ثلاثة")
