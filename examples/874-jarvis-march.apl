# مثال 874 — مسيرة جارفيس
# Jarvis march
# Demonstrates: تغليف الهدية بالالتفاف
#
# Run:  python apl.py examples/874-jarvis-march.apl

# مسيرة جارفيس (تغليف الهدية): غلاف محدب بالالتفاف حول أقصى نقطة
# أبطأ من مسح غراهام نظرياً لكنه أبسط ومناسب للأغلفة الصغيرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جداء_متقاطع(مبدا, أول, ثان):
  ارجع (أول[0] - مبدا[0]) * (ثان[1] - مبدا[1]) - (أول[1] - مبدا[1]) * (ثان[0] - مبدا[0])

دالة جارفيس(نقاط):
  # أدنى نقطة (ص ثم س)
  بداية = نقاط[0]
  لكل ن في نقاط:
    لو ن[1] < بداية[1] أو (ن[1] == بداية[1] و ن[0] < بداية[0]):
      بداية = ن
  غلاف = [بداية]
  حالية = بداية
  طالما 1 == 1:
    تالية = نقاط[0]
    لو تالية == حالية:
      تالية = نقاط[1]
    لكل ن في نقاط:
      لو جداء_متقاطع(حالية, تالية, ن) < 0:
        تالية = ن
    حالية = تالية
    لو حالية == بداية:
      ارجع غلاف
    غلاف.ألحق(حالية)

نقاط = [[0, 0], [1, 1], [2, 0], [2, 2], [0, 2], [1, 0]]
غلاف = جارفيس(نقاط)
اطبع "الغلاف:", غلاف

تأكد_يساوي(طول(غلاف), 4, "أربع زوايا")
تأكد_يساوي(غلاف[0][0], 0, "تبدأ من أدنى نقطة")
تأكد_يساوي(غلاف[1][0], 2, "ثم أقصى اليمين أسفل")

# النقاط الداخلية (1,1) و(1,0) مستبعدة... (1,0) على الحافة: الالتفاف الصارم يتخطاها
موجود_11 = خطأ
لكل ن في غلاف:
  لو ن[0] == 1 و ن[1] == 1:
    موجود_11 = 1 == 1
تأكد_يساوي(موجود_11, خطأ, "النقطة الداخلية مستبعدة")
