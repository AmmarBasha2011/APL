# مثال 3359 — مجموع الأعداد من 23 إلى ن
# Sum from 23 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3359-sum-of-integers-from-23-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(23, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(23), 23, "حالة 1")
تأكد_يساوي(ف(24), 47, "حالة 2")
تأكد_يساوي(ف(33), 308, "حالة 3")
تأكد_يساوي(ف(100), 4797, "حالة 4")
