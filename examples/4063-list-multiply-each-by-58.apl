# مثال 4063 — ضرب كل عنصر في 58
# Multiply each item by 58
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4063-list-multiply-each-by-58.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 58]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [174, 58, 116], "حالة 1")
تأكد_يساوي(ف([5]), [290], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [58, 116, 174, 232, 290, 348], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-116, 0, 406, 406, 232], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [580, 1160, 580, 1740, 1160, 580], "حالة 5")
