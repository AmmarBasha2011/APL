# مثال 513 — بحث كنوث-موريس-برات
# KMP pattern search
# Demonstrates: مطابقة أنماط، جدول الفشل، بحث خطي الزمن
#
# Run:  python apl.py examples/513-kmp-search.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# بحث كنوث-موريس-برات عن نمط في نص
دالة جدول_فشل(نمط):
    المتغير ج = [0]
    المتغير ط = 0
    لكل i في نطاق(1, طول(نمط)):
        طالما ط > 0 و نمط[i] != نمط[ط]:
            ط = ج[ط - 1]
        لو نمط[i] == نمط[ط]:
            ط = ط + 1
        ج.أضف(ط)
    ارجع ج

دالة بحث_kmp(نص, نمط):
    المتغير ج = جدول_فشل(نمط)
    المتغير ط = 0
    لكل i في نطاق(طول(نص)):
        طالما ط > 0 و نص[i] != نمط[ط]:
            ط = ج[ط - 1]
        لو نص[i] == نمط[ط]:
            ط = ط + 1
        لو ط == طول(نمط):
            ارجع i - طول(نمط) + 1
    ارجع -1

المتغير نص = "abxabcabcaby"
اطبع "جدول الفشل:", جدول_فشل("abcaby")
تأكد_يساوي(بحث_kmp(نص, "abcaby"), 6, "KMP: موضع أول تطابق")
تأكد_يساوي(بحث_kmp(نص, "xyz"), -1, "KMP: نمط غائب")
