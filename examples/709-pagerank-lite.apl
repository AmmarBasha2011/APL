# مثال 709 — بيج رانك مصغر
# PageRank lite
# Demonstrates: تخميد، تكرار، تطبيع
#
# Run:  python apl.py examples/709-pagerank-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# بيج رانك مصغر على رسم ويب صغير
# Demonstrates: تخميد 0.85, تكرار حتى التقارب, تطبيع المجموع 1
# أربع صفحات: 0 -> 1,2 ; 1 -> 2 ; 2 -> 0 ; 3 -> 2

دالة رتب(روابط, ن, تخميد, دورات):
  رتبة = []
  لكل ي في نطاق(ن):
    رتبة.append(1.0 / ن)
  خارجة = []
  لكل ي في نطاق(ن):
    خارجة.append(طول(روابط[ي]))
  لكل دورة في نطاق(دورات):
    جديد = []
    لكل ي في نطاق(ن):
      جديد.append((1.0 - تخميد) / ن)
    لكل مصدر في نطاق(ن):
      لو خارجة[مصدر] > 0:
        حصة = تخميد * رتبة[مصدر] / خارجة[مصدر]
        لكل هدف في روابط[مصدر]:
          جديد[هدف] = جديد[هدف] + حصة
      والا:
        حصة = تخميد * رتبة[مصدر] / ن
        لكل ي في نطاق(ن):
          جديد[ي] = جديد[ي] + حصة
    رتبة = جديد
  ارجع رتبة

روابط = [[1, 2], [2], [0], [2]]
رتبة = رتب(روابط, 4, 0.85, 40)
مجموع = رتبة[0] + رتبة[1] + رتبة[2] + رتبة[3]
تأكد_يساوي(مقرب(مجموع, 6), 1.0, "المجموع واحد")
تأكد_يساوي(رتبة[2] > رتبة[0], صواب, "الصفحة 2 الأقوى")
تأكد_يساوي(رتبة[0] > رتبة[1], صواب, "صفر أقوى من واحد")
تأكد_يساوي(رتبة[1] > رتبة[3], صواب, "واحد أقوى من ثلاثة")
تأكد_يساوي(مقرب(رتبة[2], 3), 0.394, "رتبة الصفحة 2")
اطبع "الرتب:", رتبة
