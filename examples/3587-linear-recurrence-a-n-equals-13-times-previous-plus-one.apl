# مثال 3587 — متتالية أ=13×السابق+1
# Recurrence times 13 plus one
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/3587-linear-recurrence-a-n-equals-13-times-previous-plus-one.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 1
  لكل ي في نطاق(ن):
    أ = أ * 13 + 1
  ارجع أ

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 14, "حالة 2")
تأكد_يساوي(ف(2), 183, "حالة 3")
تأكد_يساوي(ف(5), 402234, "حالة 4")
تأكد_يساوي(ف(8), 883708281, "حالة 5")
