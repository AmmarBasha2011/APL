# مثال 4226 — قوة 31 بالحلقة
# Power of 31 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4226-nth-power-of-31-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 31
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 31, "حالة 2")
تأكد_يساوي(ف(3), 29791, "حالة 3")
تأكد_يساوي(ف(6), 887503681, "حالة 4")
تأكد_يساوي(ف(10), 819628286980801, "حالة 5")
