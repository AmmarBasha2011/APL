# مثال 1244 — ضرب أعداد نصية
# Multiply big numbers as digit lists
# Demonstrates: ضرب طويل
#
# Run:  python apl.py examples/1244-multiply-strings-big.apl

# نضرب كل رقمين ونجمع في الخانة المناسبة
# ثم نمرر الحمل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اضرب(أ, ب):
  لو (أ == "0") أو (ب == "0"):
    ارجع "0"
  ن = طول(أ)
  م = طول(ب)
  نتيجة = [0] * (ن + م)
  لكل ع في نطاق(ن - 1, -1, -1):
    لكل ج في نطاق(م - 1, -1, -1):
      ح = صحيح(أ[ع]) * صحيح(ب[ج]) + نتيجة[ع + ج + 1]
      نتيجة[ع + ج + 1] = ح % 10
      نتيجة[ع + ج] = نتيجة[ع + ج] + ح // 10
  ناتج = ""
  لكل ر في نتيجة:
    ناتج = ناتج + نص(ر)
  ارجع ناتج.lstrip("0")

تأكد_يساوي(اضرب("2", "3"), "6", "صغير")
تأكد_يساوي(اضرب("123", "456"), "56088", "ثلاثة أرقام")
تأكد_يساوي(اضرب("999", "999"), "998001", "تسعات")
تأكد_يساوي(اضرب("0", "12345"), "0", "صفر")
تأكد_يساوي(اضرب("123456789", "987654321"), نص(123456789 * 987654321), "كبير")
