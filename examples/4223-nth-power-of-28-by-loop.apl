# مثال 4223 — قوة 28 بالحلقة
# Power of 28 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4223-nth-power-of-28-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 28
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 28, "حالة 2")
تأكد_يساوي(ف(3), 21952, "حالة 3")
تأكد_يساوي(ف(6), 481890304, "حالة 4")
تأكد_يساوي(ف(10), 296196766695424, "حالة 5")
