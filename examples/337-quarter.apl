# مثال 337 — الربع السنوي والفصل
# Quarter and season
# Demonstrates: تصنيف الشهر
#
# Run:  python apl.py examples/337-quarter.apl

المتغير اليوم = التاريخ_اليوم()
المتغير ربع = (اليوم.month - 1) // 3 + 1
اطبع "نحن في الربع", ربع, "من السنة"

حالة ربع:
    قيمة 1:
        اطبع "الفصل: شتاء"
    قيمة 2:
        اطبع "الفصل: ربيع"
    قيمة 3:
        اطبع "الفصل: صيف"
    افتراضي:
        اطبع "الفصل: خريف"
