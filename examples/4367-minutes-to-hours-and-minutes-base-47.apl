# مثال 4367 — تحويل وحدة بأساس 47
# Split by base 47
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4367-minutes-to-hours-and-minutes-base-47.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 47, ن % 47]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 12], "حالة 2")
تأكد_يساوي(ف(60), [1, 13], "حالة 3")
تأكد_يساوي(ف(125), [2, 31], "حالة 4")
تأكد_يساوي(ف(1000), [21, 13], "حالة 5")
