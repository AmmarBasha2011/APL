# مثال 944 — مرشح كالمان الأحادي
# 1D Kalman filter
# Demonstrates: كسب متكيف للقياس
#
# Run:  python apl.py examples/944-kalman.apl

# مرشح كالمان الأحادي: دمج قياسات مضججة في تقدير سلس
# يوازن بين ثقة النموذج وثقة القياس بكسب متكيف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ضجيج العملية وضجيج القياس ثابتان
ضجيج_عملية = 0.01
ضجيج_قياس = 0.5

دالة رشح(قياسات):
  تقدير = قياسات[0]
  تباين = 1
  خرج = []
  لكل قياس في قياسات:
    # تنبؤ
    تباين = تباين + ضجيج_عملية
    # تحديث
    كسب = تباين / (تباين + ضجيج_قياس)
    تقدير = تقدير + كسب * (قياس - تقدير)
    تباين = (1 - كسب) * تباين
    خرج.ألحق(تقدير)
  ارجع خرج

قياسات = [1, 1.3, 0.8, 1.1, 1]
تقديرات = رشح(قياسات)
اطبع "التقديرات:", تقديرات

متوقع = [1, 1.1224, 1.0258, 1.0437, 1.0347]
تأكد_يساوي(طول(تقديرات), 5, "الطول")
لكل i في نطاق(5):
  تأكد_يساوي(مقرب(تقديرات[i], 4), متوقع[i], "تقدير " + نص(i))

# التقدير أكثر سلاسة من القياسات: قفزاته أصغر
قفزة_قياس = 1.3 - 0.8
قفزة_تقدير = تقديرات[3] - تقديرات[2]
لو قفزة_تقدير < 0:
  قفزة_تقدير = -قفزة_تقدير
لو قفزة_تقدير >= قفزة_قياس:
  اطبع "فشل: المرشح لا ينعّم"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: المرشح ينعّم"
