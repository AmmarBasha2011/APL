# مثال 2848 — ضرب كل عنصر في 24
# Multiply each item by 24
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2848-list-multiply-each-by-24.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 24]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [72, 24, 48], "حالة 1")
تأكد_يساوي(ف([5]), [120], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [24, 48, 72, 96, 120, 144], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-48, 0, 168, 168, 96], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [240, 480, 240, 720, 480, 240], "حالة 5")
