# مثال 1784 — العدد السعيد
# Happy number check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1784-happy-number-check-loop.apl

# نكرر حتى نصل واحداً أو ندور
# نخزن ما رأيناه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مربعات(ن):
  مجموع = 0
  طالما ن > 0:
    ر = ن % 10
    مجموع = مجموع + ر * ر
    ن = ن // 10
  ارجع مجموع

دالة سعيد(ن):
  رأينا = {}
  طالما ن != 1 و (نص(ن) في رأينا) == خطأ:
    رأينا[نص(ن)] = 1
    ن = مربعات(ن)
  ارجع ن == 1

تأكد_يساوي(سعيد(19), صواب, "تسعة عشر")
تأكد_يساوي(سعيد(2), خطأ, "اثنان")
تأكد_يساوي(سعيد(7), صواب, "سبعة")
تأكد_يساوي(سعيد(1), صواب, "واحد")
