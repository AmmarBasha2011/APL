# مثال 1193 — نظام ملفات
# In-memory file system
# Demonstrates: قواميس متداخلة
#
# Run:  python apl.py examples/1193-file-system-tree.apl

# كل مجلد قاموس يحوي مجلدات فرعية
# والملف نص مخزن تحت اسمه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف نظام_ملفات:
  دالة_إنشاء(ذات):
    ذات.جذر = {}

  دالة اجزاء(ذات, مسار):
    ناتج = []
    لكل ج في مسار.split("/"):
      لو ج != "":
        ناتج.ألحق(ج)
    ارجع ناتج

  دالة انشئ_مجلد(ذات, مسار):
    عقدة = ذات.جذر
    لكل ج في ذات.اجزاء(مسار):
      لو ج ليس في عقدة:
        عقدة[ج] = {}
      عقدة = عقدة[ج]

  دالة اكتب(ذات, مسار, نص_):
    ج = ذات.اجزاء(مسار)
    عقدة = ذات.جذر
    لكل ع في نطاق(طول(ج) - 1):
      لو ج[ع] ليس في عقدة:
        عقدة[ج[ع]] = {}
      عقدة = عقدة[ج[ع]]
    عقدة[ج[-1]] = نص_

  دالة اقرأ(ذات, مسار):
    عقدة = ذات.جذر
    لكل ج في ذات.اجزاء(مسار):
      عقدة = عقدة[ج]
    ارجع عقدة

  دالة اعرض(ذات, مسار):
    عقدة = ذات.جذر
    لكل ج في ذات.اجزاء(مسار):
      عقدة = عقدة[ج]
    لو نوع(عقدة) == نوع({}):
      ارجع مفرز(قائمة(عقدة))
    ارجع [ذات.اجزاء(مسار)[-1]]

ن = نظام_ملفات()
ن.انشئ_مجلد("/a/b")
ن.اكتب("/a/b/c.txt", "hello")
ن.اكتب("/a/d.txt", "world")
تأكد_يساوي(ن.اعرض("/"), ["a"], "الجذر")
تأكد_يساوي(ن.اعرض("/a"), ["b", "d.txt"], "مجلد a")
تأكد_يساوي(ن.اقرأ("/a/b/c.txt"), "hello", "قراءة ملف")
تأكد_يساوي(ن.اعرض("/a/d.txt"), ["d.txt"], "عرض ملف")
