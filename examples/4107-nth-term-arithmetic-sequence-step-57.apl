# مثال 4107 — الحد النوني بخطوة 57
# Nth term step 57
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4107-nth-term-arithmetic-sequence-step-57.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 57

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 60, "حالة 2")
تأكد_يساوي(ف(10), 516, "حالة 3")
تأكد_يساوي(ف(100), 5646, "حالة 4")
