# مثال 4166 — تحويل وحدة بأساس 41
# Split by base 41
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4166-minutes-to-hours-and-minutes-base-41.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 41, ن % 41]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 18], "حالة 2")
تأكد_يساوي(ف(60), [1, 19], "حالة 3")
تأكد_يساوي(ف(125), [3, 2], "حالة 4")
تأكد_يساوي(ف(1000), [24, 16], "حالة 5")
