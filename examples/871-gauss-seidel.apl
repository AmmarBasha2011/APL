# مثال 871 — جاوس-زايدل
# Gauss-Seidel
# Demonstrates: تحديث فوري بالقيم الجديدة
#
# Run:  python apl.py examples/871-gauss-seidel.apl

# جاوس-زايدل: حل تكراري للأنظمة الخطية يستخدم أحدث القيم فوراً
# يتقارب للمصفوفات المهيمنة قطرياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جاوس_زايدل(معاملات, ثوابت, تكرارات):
  ن = طول(ثوابت)
  حل = []
  لكل _ في نطاق(ن):
    حل.ألحق(0.0)
  لكل _ في نطاق(تكرارات):
    لكل i في نطاق(ن):
      مجموع = 0.0
      لكل ج في نطاق(ن):
        لو ج != i:
          مجموع = مجموع + معاملات[i][ج] * حل[ج]
      حل[i] = (ثوابت[i] - مجموع) / معاملات[i][i]
  ارجع حل

# 4س + ص = 1 ، س + 3ص = 2  =>  س = 1/11 ، ص = 7/11
حل = جاوس_زايدل(
  [
    [4.0, 1.0],
    [1.0, 3.0]
  ],
  [1.0, 2.0],
  50
)
اطبع "الحل:", حل

تأكد_يساوي(مقرب(حل[0], 9), مقرب(1.0 / 11.0, 9), "س = 1/11")
تأكد_يساوي(مقرب(حل[1], 9), مقرب(7.0 / 11.0, 9), "ص = 7/11")

# تحقق بالتعويض
تحقق1 = 4.0 * حل[0] + حل[1]
تحقق2 = حل[0] + 3.0 * حل[1]
تأكد_يساوي(مقرب(تحقق1, 9), 1.0, "المعادلة الأولى")
تأكد_يساوي(مقرب(تحقق2, 9), 2.0, "المعادلة الثانية")
