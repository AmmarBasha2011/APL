# مثال 358 — مدرسة وطلاب ومواد
# School, students and courses
# Demonstrates: علاقات بين الكائنات
#
# Run:  python apl.py examples/358-school.apl

صنف طالب:
    دالة_إنشاء(ذات, اسم):
        ذات.اسم = اسم
        ذات.مواد = []

    دالة سجل_مادة(ذات, مادة):
        ذات.مواد.append(مادة)

صنف مادة:
    دالة_إنشاء(ذات, اسم, س_معتمدة):
        ذات.اسم = اسم
        ذات.س_معتمدة = س_معتمدة

المتغير رياضيات = مادة("رياضيات", 4)
المتغير علوم = مادة("علوم", 3)

المتغير أ = طالب("أحمد")
أ.سجل_مادة(رياضيات)
أ.سجل_مادة(علوم)

المتغير مجموع_س_معتمدة = 0
اطبع "مواد", أ.اسم, ":"
لكل م in أ.مواد:
    اطبع " -", م.اسم, "(", م.س_معتمدة, "س_معتمدة)"
    مجموع_س_معتمدة = مجموع_س_معتمدة + م.س_معتمدة
اطبع "إجمالي الس_معتمدة:", مجموع_س_معتمدة
