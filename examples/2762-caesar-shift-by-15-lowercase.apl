# مثال 2762 — قيصر بإزاحة 15
# Caesar shift 15
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2762-caesar-shift-by-15-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 15) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "pqr", "حالة 1")
تأكد_يساوي(ف("xyz"), "mno", "حالة 2")
تأكد_يساوي(ف("hello world"), "wtaad ldgas", "حالة 3")
تأكد_يساوي(ف("a1"), "p1", "حالة 4")
