# مثال 4023 — قوة 21 بالحلقة
# Power of 21 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4023-nth-power-of-21-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 21
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 21, "حالة 2")
تأكد_يساوي(ف(3), 9261, "حالة 3")
تأكد_يساوي(ف(6), 85766121, "حالة 4")
تأكد_يساوي(ف(10), 16679880978201, "حالة 5")
