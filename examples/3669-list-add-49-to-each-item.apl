# مثال 3669 — إضافة 49 لكل عنصر
# Add 49 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3669-list-add-49-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 49]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [52, 50, 51], "حالة 1")
تأكد_يساوي(ف([5]), [54], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [50, 51, 52, 53, 54, 55], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [47, 49, 56, 56, 53], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [59, 69, 59, 79, 69, 59], "حالة 5")
