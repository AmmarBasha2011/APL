# مثال 598 — مسار أويلر
# Eulerian path
# Demonstrates: أويلر، درجات فردية، هيرهولتزر
#
# Run:  python apl.py examples/598-euler-path.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مسار أويلر: زيارة كل حافة مرة واحدة
# Demonstrates: شرط الدرجات الفردية, خوارزمية هيرهولتزر, إعادة بناء المسار
# الرسم: مسار شجري، كل حافة فيه جسر

جوار = {0: [1, 3, 2], 1: [0, 2], 2: [1, 3, 0], 3: [2, 0]}
عدد_الحواف = 5

فردية = []
لكل عقدة في جوار.keys():
  لو طول(جوار[عقدة]) % 2 == 1:
    فردية.append(عقدة)
فردية.sort()
اطبع "عقد فردية الدرجة:", فردية
تأكد_يساوي(فردية, [0, 2], "شرط وجود المسار")

# هيرهولتزر
نسخة = {}
لكل عقدة في جوار.keys():
  نسخة[عقدة] = جوار[عقدة].copy()
مكدس = [فردية[0]]
مسار = []
طالما طول(مكدس) > 0:
  قمة = مكدس[طول(مكدس) - 1]
  لو طول(نسخة[قمة]) > 0:
    تال = نسخة[قمة].pop()
    نسخة[تال].remove(قمة)
    مكدس.append(تال)
  والا:
    مسار.append(مكدس.pop())
مسار.reverse()
اطبع "مسار أويلر:", مسار
تأكد_يساوي(طول(مسار), عدد_الحواف + 1, "كل الحواف مستخدمة")
تأكد_يساوي(مسار[0], 0, "يبدأ من عقدة فردية")
تأكد_يساوي(مسار[طول(مسار) - 1], 2, "ينتهي عند العقدة الفردية الأخرى")
