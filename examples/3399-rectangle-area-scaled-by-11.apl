# مثال 3399 — مساحة مستطيل مكبر 11 مرات
# Rectangle area scaled by 11
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3399-rectangle-area-scaled-by-11.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 11) * (ق[1] * 11)

تأكد_يساوي(ف([1, 2]), 242, "حالة 1")
تأكد_يساوي(ف([3, 4]), 1452, "حالة 2")
تأكد_يساوي(ف([5, 5]), 3025, "حالة 3")
تأكد_يساوي(ف([10, 1]), 1210, "حالة 4")
