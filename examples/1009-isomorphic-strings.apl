# مثال 1009 — نصان متماثلان بنيوياً
# Isomorphic strings
# Demonstrates: توقيع أول ظهور
#
# Run:  python apl.py examples/1009-isomorphic-strings.apl

# نصان متماثلان لو أمكن استبدال حروف الأول بحروف الثاني
# نحسب لكل نص توقيعاً من فهرس أول ظهور لكل حرف ونقارن التوقيعين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة توقيع(نص_):
  ناتج = []
  لكل ع في نطاق(طول(نص_)):
    ف = 0
    طالما نص_[ف] != نص_[ع]:
      ف = ف + 1
    ناتج.ألحق(ف)
  ارجع ناتج

دالة متماثلان(أ, ب):
  ارجع (طول(أ) == طول(ب)) و (توقيع(أ) == توقيع(ب))

تأكد_يساوي(متماثلان("egg", "add"), صواب, "egg و add")
تأكد_يساوي(متماثلان("foo", "bar"), خطأ, "foo و bar")
تأكد_يساوي(متماثلان("paper", "title"), صواب, "paper و title")
تأكد_يساوي(متماثلان("ab", "aa"), خطأ, "ربط مزدوج")
