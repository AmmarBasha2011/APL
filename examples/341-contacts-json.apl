# مثال 341 — دليل جهات اتصال بملف JSON
# Contacts book with JSON
# Demonstrates: إضافة وبحث وحفظ
#
# Run:  python apl.py examples/341-contacts-json.apl

المتغير مسار = "/tmp/apl_contacts_341.json"

المتغير جهات = []
جهات.أضف({"اسم": "أحمد", "هاتف": "01001234567"})
جهات.أضف({"اسم": "سارة", "هاتف": "01112223334"})
جهات.أضف({"اسم": "أمين", "هاتف": "01223334445"})

اكتب_ملف_جسون(جهات, مسار)
المتغير محملة = اقرأ_ملف_جسون(مسار)

اطبع "الأسماء التي تبدأ بأم:"
لكل ج in محملة:
    لو ج["اسم"].بداية("أم"):
        اطبع " ", ج["اسم"], "-", ج["هاتف"]

احذف_ملف(مسار)
