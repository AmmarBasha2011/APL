# مثال 3250 — مساحة مستطيل مكبر 8 مرات
# Rectangle area scaled by 8
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3250-rectangle-area-scaled-by-8.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 8) * (ق[1] * 8)

تأكد_يساوي(ف([1, 2]), 128, "حالة 1")
تأكد_يساوي(ف([3, 4]), 768, "حالة 2")
تأكد_يساوي(ف([5, 5]), 1600, "حالة 3")
تأكد_يساوي(ف([10, 1]), 640, "حالة 4")
