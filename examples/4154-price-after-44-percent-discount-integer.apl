# مثال 4154 — السعر بعد خصم 44 بالمئة
# Price after 44 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4154-price-after-44-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 44 // 100

تأكد_يساوي(ف(100), 56, "حالة 1")
تأكد_يساوي(ف(250), 140, "حالة 2")
تأكد_يساوي(ف(999), 560, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
