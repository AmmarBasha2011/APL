# مثال 17 — نظام حساب بنكي مبسّط
# Simplified Bank Account System
# Demonstrates: classes, methods, self, transactions list
#
# Run:  python apl.py examples/17-bank-account.apl

صنف الحساب:
    دالة_إنشاء(ذات, رقم, رصيد_أول):
        ذات.رقم = رقم
        ذات.رصيد = رصيد_أول
        ذات.سجل = []

    دالة إيداع(ذات, مبلغ):
        إذا مبلغ <= 0:
            ارجع خطأ
        ذات.رصيد = ذات.رصيد + مبلغ
        ذات.سجل.ألحق("إيداع " + نص(مبلغ))
        ارجع صواب

    دالة سحب(ذات, مبلغ):
        إذا مبلغ <= 0:
            ارجع خطأ
        إذا مبلغ > ذات.رصيد:
            ارجع خطأ
        ذات.رصيد = ذات.رصيد - مبلغ
        ذات.سجل.ألحق("سحب " + نص(مبلغ))
        ارجع صواب

    دالة تحويل(ذات, إلى, مبلغ):
        إذا ذات.سحب(مبلغ) == صواب:
            إلى.إيداع(مبلغ)
            ارجع صواب
        ارجع خطأ

    دالة كشف(ذات):
        ارجع "حساب " + نص(ذات.رقم) + ": رصيد " + نص(ذات.رصيد) + " — عمليات: " + نص(طول(ذات.سجل))

المتغير حساب_أ = الحساب("1001", 5000)
المتغير حساب_ب = الحساب("1002", 1000)

اطبع "=== نظام حساب بنكي ==="
اطبع حساب_أ.كشف()
اطبع حساب_ب.كشف()
اطبع ""
اطبع "إيداع 1500 لحساب أ: " + نص(حساب_أ.إيداع(1500))
اطبع "سحب 2000 لحساب أ: " + نص(حساب_أ.سحب(2000))
اطبع "سحب 99999 (أكبر من الرصيد): " + نص(حساب_أ.سحب(99999))
اطبع ""
اطبع "تحويل 1000 من أ إلى ب: " + نص(حساب_أ.تحويل(حساب_ب, 1000))
اطبع ""
اطبع "الرصيد النهائي:"
اطبع "  " + حساب_أ.كشف()
اطبع "  " + حساب_ب.كشف()
