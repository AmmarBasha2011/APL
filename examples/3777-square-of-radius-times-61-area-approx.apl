# مثال 3777 — مساحة دائرة بتقريب 61
# Circle area with pi approx 61/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3777-square-of-radius-times-61-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 61 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 8, "حالة 2")
تأكد_يساوي(ف(7), 427, "حالة 3")
تأكد_يساوي(ف(14), 1708, "حالة 4")
تأكد_يساوي(ف(21), 3843, "حالة 5")
