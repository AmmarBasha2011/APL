# مثال 31 — مزخرف قياس الأداء
# Timing Decorator
# Demonstrates: user decorators, wrappers, time library
#
# Run:  python apl.py examples/31-decorator-timer.apl

دالة_مزخرفة(الدالة):
    دالة_غلاف(س):
        البداية = وقت()
        النتيجة = الدالة(س)
        النهاية = وقت()
        اطبع f"  [قياس] {س}: {(النهاية - البداية) * 1000:.2f} ms"
        ارجع النتيجة
    ارجع دالة_غلاف

@دالة_مزخرفة
دالة_جمع_بطيء(عدد):
    مجموع = 0
    رقم = 0
    طالما رقم < عدد:
        مجموع = مجموع + رقم * رقم
        رقم = رقم + 1
    ارجع مجموع

@دالة_مزخرفة
دالة_جذر(عدد):
    ارجع عدد ** 0.5

اطبع "=== مزخرف قياس الأداء ==="
اطبع ""
اطبع "جمع بطيء (10000):"
اطبع "  النتيجة: " + نص(دالة_جمع_بطيء(10000))
اطبع ""
اطبع "جذر (2):"
اطبع "  النتيجة: " + نص(مقرب(دالة_جذر(2), 6))
