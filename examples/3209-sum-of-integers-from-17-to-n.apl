# مثال 3209 — مجموع الأعداد من 17 إلى ن
# Sum from 17 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3209-sum-of-integers-from-17-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(17, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(17), 17, "حالة 1")
تأكد_يساوي(ف(18), 35, "حالة 2")
تأكد_يساوي(ف(27), 242, "حالة 3")
تأكد_يساوي(ف(100), 4914, "حالة 4")
