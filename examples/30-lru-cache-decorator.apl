# مثال 30 — كاش LRU مع functools
# LRU Cache with Decorators
# Demonstrates: functools cache decorator, memoization
#
# Run:  python apl.py examples/30-lru-cache-decorator.apl

@كاش_مؤقت_دالة(128)
دالة_فيب(ن):
    لو ن < 2:
        ارجع ن
    ارجع دالة_فيب(ن - 1) + دالة_فيب(ن - 2)

دالة_فيب_بطيء(ن):
    لو ن < 2:
        ارجع ن
    ارجع دالة_فيب_بطيء(ن - 1) + دالة_فيب_بطيء(ن - 2)

اطبع "=== كاش LRU ==="
اطبع ""
اطبع "فيب(20) مع الكاش : " + نص(دالة_فيب(20))
اطبع "فيب(30) مع الكاش : " + نص(دالة_فيب(30))
اطبع "فيب(50) مع الكاش : " + نص(دالة_فيب(50))
اطبع ""
اطبع "بدون كاش فيب(20) : " + نص(دالة_فيب_بطيء(20))
اطبع ""
اطبع "الكاش يجعل الاستدعاء الثاني فورياً لأن النتيجة محفوظة."
