# مثال 720 — مجموع فليتشر-16
# Fletcher-16 checksum
# Demonstrates: مجموعان متوازيان، التفاف، بايتات
#
# Run:  python apl.py examples/720-fletcher16.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مجموع فليتشر-16 الاختباري
# Demonstrates: مجموعان بباقي 255, حساسية للترتيب, معيار RFC 1146
# أبسط من أدلر: باقي 255 بدل عدد أولي

دالة فليتشر(بايتات):
  ج1 = 0
  ج2 = 0
  لكل بايت في بايتات:
    ج1 = (ج1 + بايت) % 255
    ج2 = (ج2 + ج1) % 255
  ارجع ج2 * 256 + ج1

دالة بايتات(نص):
  ناتج = []
  لكل ي في نطاق(طول(نص)):
    ناتج.append(ترميز_حرف(نص[ي]) % 256)
  ارجع ناتج

تأكد_يساوي(فليتشر(بايتات("abcde")), 51440, "مثال المعيار abcde")
تأكد_يساوي(فليتشر(بايتات("abcdef")), 8279, "مثال المعيار abcdef")
تأكد_يساوي(فليتشر(بايتات("abcdefgh")), 1575, "مثال المعيار abcdefgh")
تأكد_يساوي(فليتشر(بايتات("")), 0, "الفارغ صفر")
تأكد_يساوي(فليتشر(بايتات("abc")) != فليتشر(بايتات("acb")), صواب, "الترتيب يهم")
تأكد_يساوي(فليتشر(بايتات("abc")) != فليتشر(بايتات("abd")), صواب, "حرف يغير")
اطبع "فليتشر(abcde):", فليتشر(بايتات("abcde"))
