# مثال 819 — تجزية djb2
# djb2 hash
# Demonstrates: 5381 مضروباً 33، التفاف 32-بت
#
# Run:  python apl.py examples/819-djb2-hash.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تجزية djb2 لدان برنستاين: حاصل 5381 مضروباً في 33 زائد المحرف
# Demonstrates: ضرب متكرر ب33, التفاف 32-بت, جدول تجزئة بسيط

م32 = 4294967296

دالة دجب2(نص):
  ه = 5381
  لكل حرف في نص:
    ه = (ه * 33 + ترميز_حرف(حرف)) % م32
  ارجع ه

تأكد_يساوي(دجب2(""), 5381, "نص فارغ")
تأكد_يساوي(دجب2("hello"), 261238937, "hello")
تأكد_يساوي(دجب2("APL"), 193450498, "APL")
تأكد_يساوي(دجب2("a") != دجب2("b") == خطأ, خطأ, "حرفان مختلفان")

دالة دلو(مفاتيح, حجم):
  جدول = []
  لكل ي في نطاق(حجم):
    جدول.append([])
  لكل ك في مفاتيح:
    جدول[دجب2(ك) % حجم].append(ك)
  ارجع جدول

دلاء = دلو(["apple", "banana", "cherry", "date"], 8)
مجموع = 0
لكل خلية في دلاء:
  مجموع = مجموع + طول(خلية)
تأكد_يساوي(مجموع, 4, "كل المفاتيح مدخلة")
تأكد_يساوي(طول(دلاء), 8, "حجم الجدول")
