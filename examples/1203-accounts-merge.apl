# مثال 1203 — دمج الحسابات
# Accounts merge by shared email
# Demonstrates: اتحاد وبحث
#
# Run:  python apl.py examples/1203-accounts-merge.apl

# نوحد الحسابات التي تتشارك أي بريد
# ثم نجمع بريد كل مجموعة ونرتبه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جذر(اب, س):
  طالما اب[س] != س:
    اب[س] = اب[اب[س]]
    س = اب[س]
  ارجع س

دالة ادمج_حسابات(حسابات):
  اب = قائمة(نطاق(طول(حسابات)))
  مالك = {}
  لكل ع في نطاق(طول(حسابات)):
    لكل بريد في حسابات[ع][1:]:
      لو بريد في مالك:
        اب[جذر(اب, ع)] = جذر(اب, مالك[بريد])
      والا:
        مالك[بريد] = ع
  مجموعات = {}
  لكل بريد في مالك:
    ر = جذر(اب, مالك[بريد])
    لو ر ليس في مجموعات:
      مجموعات[ر] = []
    مجموعات[ر].ألحق(بريد)
  ناتج = []
  لكل ر في مفرز(قائمة(مجموعات)):
    ناتج.ألحق([حسابات[ر][0]] + مفرز(مجموعات[ر]))
  ارجع ناتج

ح = [["John","a@x","b@x"],["John","b@x","c@x"],["Mary","m@x"],["John","j@x"]]
تأكد_يساوي(ادمج_حسابات(ح), [["John","a@x","b@x","c@x"],["Mary","m@x"],["John","j@x"]], "مثال أول")
