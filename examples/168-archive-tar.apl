# مثال 168 — أرشيف TAR كامل
# Full TAR archive flow
# Demonstrates: أنشئ_طر، أسماء_الطر، نص_من_الطر، استخرج_طر
#
# Run:  python apl.py examples/168-archive-tar.apl

المتغير جذر = "/tmp/apl_tar_demo"
انشئ_مجلدات(جذر + "/مصدر")
اكتب(جذر + "/مصدر/أ.txt", "ملف أول")
اكتب(جذر + "/مصدر/ب.txt", "ملف ثانٍ")

أنشئ_طر(جذر + "/أرشيف.tar", [جذر + "/مصدر"])
اطبع "الأعضاء:", أسماء_الطر(جذر + "/أرشيف.tar")
اطبع "محتوى أ.txt:", نص_من_الطر(جذر + "/أرشيف.tar", "مصدر/أ.txt")

استخرج_طر(جذر + "/أرشيف.tar", جذر + "/مستخرج")
اطبع "استُخرج بنجاح؟", موجود(جذر + "/مستخرج/مصدر/ب.txt")

احذف_شجرة(جذر)
اطبع "تم التنظيف."
