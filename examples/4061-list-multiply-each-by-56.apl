# مثال 4061 — ضرب كل عنصر في 56
# Multiply each item by 56
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4061-list-multiply-each-by-56.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 56]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [168, 56, 112], "حالة 1")
تأكد_يساوي(ف([5]), [280], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [56, 112, 168, 224, 280, 336], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-112, 0, 392, 392, 224], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [560, 1120, 560, 1680, 1120, 560], "حالة 5")
