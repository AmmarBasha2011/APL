# مثال 3706 — الحد النوني بخطوة 46
# Nth term step 46
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3706-nth-term-arithmetic-sequence-step-46.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 46

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 49, "حالة 2")
تأكد_يساوي(ف(10), 417, "حالة 3")
تأكد_يساوي(ف(100), 4557, "حالة 4")
