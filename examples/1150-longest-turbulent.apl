# مثال 1150 — أطول تذبذب
# Longest turbulent subarray
# Demonstrates: مسح واحد
#
# Run:  python apl.py examples/1150-longest-turbulent.apl

# نتتبع طول التذبذب الحالي
# ونعيد العدّ عند تساوي جارين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اطول_تذبذب(أ):
  لو طول(أ) < 2:
    ارجع طول(أ)
  اطول = 1
  حالي = 1
  سابق = 0
  لكل ع في نطاق(1, طول(أ)):
    لو أ[ع] > أ[ع - 1]:
      اتجاه = 1
    والا_لو أ[ع] < أ[ع - 1]:
      اتجاه = -1
    والا:
      اتجاه = 0
    لو اتجاه == 0:
      حالي = 1
    والا_لو اتجاه == -سابق:
      حالي = حالي + 1
    والا:
      حالي = 2
    سابق = اتجاه
    لو حالي > اطول:
      اطول = حالي
  ارجع اطول

تأكد_يساوي(اطول_تذبذب([9,4,2,10,7,8,8,1,9]), 5, "مثال أول")
تأكد_يساوي(اطول_تذبذب([4,8,12,16]), 2, "تصاعدي")
تأكد_يساوي(اطول_تذبذب([100]), 1, "عنصر")
تأكد_يساوي(اطول_تذبذب([9,9]), 1, "متساويان")
