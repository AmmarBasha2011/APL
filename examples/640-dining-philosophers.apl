# مثال 640 — الفلاسفة المتعشون
# Dining philosophers
# Demonstrates: جمود، ترتيب موارد، تجويع
#
# Run:  python apl.py examples/640-dining-philosophers.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الفلاسفة المتعشون: تجنب الجمود بترتيب الموارد
# Demonstrates: قفل بترتيب رقمي, كسر الانتظار الدائري, محاكاة وجبات
# كل فيلسوف يلتقط الشوكة الأقل رقما أولا

دالة حاكي(عدد, وجبات):
  شوك = [صواب] * عدد
  أكل = [0] * عدد
  لكل جولة في نطاق(وجبات * 3):
    لكل ف في نطاق(عدد):
      يسار = ف
      يمين = (ف + 1) % عدد
      أول = أصغر(يسار, يمين)
      ثان = أكبر(يسار, يمين)
      لو شوك[أول] و شوك[ثان]:
        شوك[أول] = خطأ
        شوك[ثان] = خطأ
        أكل[ف] = أكل[ف] + 1
        شوك[أول] = صواب
        شوك[ثان] = صواب
  ارجع أكل

أكل = حاكي(5, 3)
اطبع "وجبات كل فيلسوف:", أكل
مجموع = 0
لكل وجبة في أكل:
  مجموع = مجموع + وجبة
تأكد_يساوي(مجموع, 45, "خمسة فلاسفة × 3 جولات × 3 فرص")
تأكد_يساوي(أصغر(أكل) > 0, صواب, "لا جمود ولا تجويع بترتيب الموارد")
