# مثال 154 — حالات الطلب بالتعداد
# Order states with enums
# Demonstrates: نوع_تعداد، كل_الأسماء، قيمة_من_اسم، تحقق_من_القيمة
#
# Run:  python apl.py examples/154-enum-states.apl

المتغير حالة = نوع_تعداد("حالة", "جديد، قيد_الشحن، تم_التسليم، ملغي")

اطبع "الحالات:", كل_الأسماء(حالة)
اطبع "القيم:", كل_القيم(حالة)
اطبع "قيمة جديد:", حالة.جديد.value
اطبع "اسم القيمة 3:", قيمة_من_اسم(حالة, "تم_التسليم")
اطبع "هل 7 قيمة صالحة؟", تحقق_من_القيمة(حالة, 7)

المتغير طلب = حالة.قيد_الشحن
لو طلب == حالة.قيد_الشحن:
    اطبع "الطلب في الطريق إليك"
