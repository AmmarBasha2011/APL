# مثال 4180 — مساحة مستطيل مكبر 25 مرات
# Rectangle area scaled by 25
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4180-rectangle-area-scaled-by-25.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 25) * (ق[1] * 25)

تأكد_يساوي(ف([1, 2]), 1250, "حالة 1")
تأكد_يساوي(ف([3, 4]), 7500, "حالة 2")
تأكد_يساوي(ف([5, 5]), 15625, "حالة 3")
تأكد_يساوي(ف([10, 1]), 6250, "حالة 4")
