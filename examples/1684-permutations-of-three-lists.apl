# مثال 1684 — تباديل ثلاثة عناصر
# All permutations of a short list
# Demonstrates: توافيق
#
# Run:  python apl.py examples/1684-permutations-of-three-lists.apl

# نختار عنصراً غير مستخدم
# نكرر على الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تباديل(ق):
  لو طول(ق) <= 1:
    ارجع [ق]
  ناتج = []
  لكل ك في نطاق(طول(ق)):
    باقي = []
    لكل ي في نطاق(طول(ق)):
      لو ي != ك:
        باقي.append(ق[ي])
    لكل ت في تباديل(باقي):
      ناتج.append([ق[ك]] + ت)
  ارجع ناتج

تأكد_يساوي(طول(تباديل([1, 2, 3])), 6, "ستة")
تأكد_يساوي(تباديل([1, 2, 3])[0], [1, 2, 3], "الأول")
تأكد_يساوي(تباديل([1, 2, 3])[5], [3, 2, 1], "الأخير")
تأكد_يساوي(طول(تباديل([1, 2, 3, 4])), 24, "أربعة")
