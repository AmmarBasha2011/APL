# مثال 2354 — هل هي متوالية هندسية
# Is geometric progression
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2354-list-is-geometric-progression-int.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لكل ي في نطاق(2, طول(ق)):
    لو ق[ي] * ق[0] != ق[ي - 1] * ق[1]:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف([1, 2, 4, 8]), صواب, "حالة 1")
تأكد_يساوي(ف([2, 6, 18]), صواب, "حالة 2")
تأكد_يساوي(ف([1, 2, 3]), خطأ, "حالة 3")
تأكد_يساوي(ف([3, 3, 3]), صواب, "حالة 4")
تأكد_يساوي(ف([5, 10]), صواب, "حالة 5")
