# مثال 4106 — الحد النوني بخطوة 56
# Nth term step 56
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4106-nth-term-arithmetic-sequence-step-56.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 56

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 59, "حالة 2")
تأكد_يساوي(ف(10), 507, "حالة 3")
تأكد_يساوي(ف(100), 5547, "حالة 4")
