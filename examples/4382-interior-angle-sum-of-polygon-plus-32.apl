# مثال 4382 — مجموع زوايا مضلع زائد 32
# Polygon angle sum plus 32
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4382-interior-angle-sum-of-polygon-plus-32.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 32

تأكد_يساوي(ف(3), 212, "حالة 1")
تأكد_يساوي(ف(4), 392, "حالة 2")
تأكد_يساوي(ف(5), 572, "حالة 3")
تأكد_يساوي(ف(6), 752, "حالة 4")
تأكد_يساوي(ف(12), 1832, "حالة 5")
