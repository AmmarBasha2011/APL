# مثال 1032 — تدوير النص
# Rotate string check
# Demonstrates: النص مضاعفاً
#
# Run:  python apl.py examples/1032-rotate-string.apl

# نص هو دوران لنص آخر لو ظهر داخل الآخر مكرراً مرتين
# وبشرط تساوي الطولين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة دوران(أ, ب):
  لو طول(أ) != طول(ب):
    ارجع خطأ
  مضاعف = ب + ب
  ارجع أ في مضاعف

تأكد_يساوي(دوران("abcde", "cdeab"), صواب, "دوران ثلاثة")
تأكد_يساوي(دوران("abcde", "abced"), خطأ, "ليس دوراناً")
تأكد_يساوي(دوران("", ""), صواب, "فارغان")
تأكد_يساوي(دوران("ab", "abc"), خطأ, "طولان مختلفان")
