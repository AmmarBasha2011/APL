# مثال 857 — ط بصيغة ماشين
# Machin formula
# Demonstrates: arctan مركبة، تايلور
#
# Run:  python apl.py examples/857-machin-pi.apl

# صيغة ماشين: ط/4 = 4 arctan(1/5) - arctan(1/239)
# arctan بمتسلسلة تايلور؛ استخدمت لحساب ط يدوياً لمئة خانة عام 1706

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة آركتان(س, حدود):
  مجموع = 0.0
  قوة = س
  إشارة = 1.0
  لكل ك في نطاق(حدود):
    مجموع = مجموع + إشارة * قوة / (2 * ك + 1)
    إشارة = -إشارة
    قوة = قوة * س * س
  ارجع مجموع

ط = 4.0 * (4.0 * آركتان(1.0 / 5.0, 15) - آركتان(1.0 / 239.0, 5))
اطبع "ط بصيغة ماشين:", ط

تأكد_يساوي(مقرب(ط, 9), 3.141592654, "تسع خانات عشرية صحيحة")

# آركتان(1) = ط/4: تحقق مستقل عبر ماشين نفسها
ربع_ط = آركتان(1.0, 2000)
تأكد_يساوي(مقرب(4.0 * ربع_ط, 2), 3.14, "arctan(1) متقاربة مع الصيغة")
