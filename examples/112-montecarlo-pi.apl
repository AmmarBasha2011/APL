# مثال 112 — تقدير ط بطريقة مونت كارلو
# Estimating pi with Monte Carlo
# Demonstrates: بذرة، عشوائي_كسر، جذر
#
# Run:  python apl.py examples/112-montecarlo-pi.apl

بذرة(7)
المتغير داخل = 0
المتغير الكل = 20000
لكل _ في نطاق(الكل):
    المتغير س = عشوائي_كسر()
    المتغير ص = عشوائي_كسر()
    لو س * س + ص * ص <= 1:
        داخل = داخل + 1

المتغير تقدير = 4 * داخل / الكل
اطبع "نقاط داخل الربع دائرة:", داخل, "من", الكل
اطبع "تقدير ط =", تقدير
اطبع "القيمة الحقيقية =", ط
اطبع "الفرق =", مقرب(مطلق_عشري(تقدير - ط), 5)
