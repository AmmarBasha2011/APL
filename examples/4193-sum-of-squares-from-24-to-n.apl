# مثال 4193 — مجموع المربعات من 24 إلى ن
# Sum of squares from 24
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4193-sum-of-squares-from-24-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(24, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(24), 576, "حالة 1")
تأكد_يساوي(ف(25), 1201, "حالة 2")
تأكد_يساوي(ف(34), 9361, "حالة 3")
تأكد_يساوي(ف(100), 334026, "حالة 4")
