# مثال 846 — أولية إيمرب
# Emirp primes
# Demonstrates: أولي يعكس أولياً مختلفاً
#
# Run:  python apl.py examples/846-emirp.apl

# أولية إيمرب: أولي يبقى أولياً عند عكس أرقامه (وليس متناظراً)
# "إيمرب" هو "برايم" (أولي) مقلوباً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أولي(ن):
  لو ن < 2:
    ارجع خطأ
  لو ن < 4:
    ارجع 1 == 1
  لو ن % 2 == 0:
    ارجع خطأ
  قاسم = 3
  طالما قاسم * قاسم <= ن:
    لو ن % قاسم == 0:
      ارجع خطأ
    قاسم = قاسم + 2
  ارجع 1 == 1

دالة اعكس_أرقام(ن):
  مقلوب = 0
  م = ن
  طالما م > 0:
    مقلوب = مقلوب * 10 + م % 10
    م = م // 10
  ارجع مقلوب

إيمرب = []
لكل ف في نطاق(2, 100):
  لو أولي(ف):
    مقلوب = اعكس_أرقام(ف)
    لو مقلوب != ف و أولي(مقلوب):
      إيمرب.ألحق(ف)

اطبع "إيمرب تحت 100:", إيمرب

تأكد_يساوي(طول(إيمرب), 8, "ثمانية تحت 100")
تأكد_يساوي(إيمرب[0], 13, "الأول")
تأكد_يساوي(إيمرب[7], 97, "الأخير")

# المتناظرات مستبعدة رغم أنها أولية
تأكد_يساوي(أولي(11), 1 == 1, "11 أولي")
تأكد_يساوي(اعكس_أرقام(11), 11, "لكن 11 متناظر فليس إيمرب")
