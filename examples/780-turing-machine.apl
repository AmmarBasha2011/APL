# مثال 780 — آلة تورينغ
# Turing machine
# Demonstrates: شريط ورأس، جدول انتقالات
#
# Run:  python apl.py examples/780-turing-machine.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# آلة تورينغ: جمع أحادي "111+11=" إلى "11111"
# Demonstrates: شريط ورأس, جدول انتقالات, حالة توقف

دالة آلة_تورينغ(مدخل, قواعد, بداية, نهاية):
  شريط = []
  لكل حرف في مدخل:
    شريط.append(حرف)
  لكل ي في نطاق(20):
    شريط.append(" ")
  موضع = 0
  حالة = بداية
  خطوات = 0
  طالما حالة != نهاية و خطوات < 1000:
    مطبقة = خطأ
    لكل قاعدة في قواعد:
      لو قاعدة[0] == حالة و قاعدة[1] == شريط[موضع] و مطبقة == خطأ:
        شريط[موضع] = قاعدة[2]
        موضع = موضع + قاعدة[3]
        حالة = قاعدة[4]
        مطبقة = صواب
    خطوات = خطوات + 1
  ارجع [شريط, خطوات, حالة]

قواعد = [["q0", "1", "1", 1, "q0"], ["q0", "+", "1", 1, "q1"], ["q1", "1", "1", 1, "q1"], ["q1", "=", " ", 0 - 1, "q2"], ["q2", "1", " ", 0, "qf"]]
ن = آلة_تورينغ("111+11=", قواعد, "q0", "qf")
شريط = ن[0]
تأكد_يساوي(ن[2], "qf", "توقفت")
تأكد_يساوي(ن[1], 8, "عدد الخطوات")
تأكد_يساوي(شريط[0] + شريط[1] + شريط[2] + شريط[3] + شريط[4], "11111", "الناتج 3+2=5")
تأكد_يساوي(شريط[5], " ", "مسح الأخيرة")
ن2 = آلة_تورينغ("1+1=", قواعد, "q0", "qf")
ش2 = ن2[0]
تأكد_يساوي(ش2[0] + ش2[1], "11", "الناتج 1+1=2")
