# مثال 1453 — توزيع مجموع النردين
# Distribution of two dice sums
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1453-dice-sum-distribution.apl

# نعد كل الأزواج الممكنة
# نخزن العدد لكل مجموع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة توزيع_النردين():
  عد = {}
  لكل أ في نطاق(1, 7):
    لكل ب في نطاق(1, 7):
      م = أ + ب
      عد[م] = عد.get(م, 0) + 1
  ارجع عد

نتيجة = توزيع_النردين()
تأكد_يساوي(نتيجة[7], 6, "سبعة")
تأكد_يساوي(نتيجة[2], 1, "اثنان")
تأكد_يساوي(نتيجة[12], 1, "اثنا عشر")
تأكد_يساوي(طول(نتيجة), 11, "أحد عشر مجموعاً")
