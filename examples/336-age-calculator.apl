# مثال 336 — حاسبة العمر الدقيقة
# Precise age calculator
# Demonstrates: سنوات وشهور وأيام
#
# Run:  python apl.py examples/336-age-calculator.apl

دالة عمر_دقيق(س_م, ش_م, ي_م):
    المتغير ميلاد = تاريخ(س_م, ش_م, ي_م)
    المتغير اليوم = التاريخ_اليوم()
    المتغير سنوات = اليوم.year - ميلاد.year
    لو (اليوم.month < ميلاد.month) أو (اليوم.month == ميلاد.month و اليوم.day < ميلاد.day):
        سنوات = سنوات - 1
    ارجع سنوات

اطبع "مواليد 9/9/2000 عمره:", عمر_دقيق(2000, 9, 9)
اطبع "مواليد 1/1/2010 عمره:", عمر_دقيق(2010, 1, 1)
