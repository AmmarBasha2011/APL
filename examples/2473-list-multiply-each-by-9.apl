# مثال 2473 — ضرب كل عنصر في 9
# Multiply each item by 9
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2473-list-multiply-each-by-9.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 9]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [27, 9, 18], "حالة 1")
تأكد_يساوي(ف([5]), [45], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [9, 18, 27, 36, 45, 54], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-18, 0, 63, 63, 36], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [90, 180, 90, 270, 180, 90], "حالة 5")
