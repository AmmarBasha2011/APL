# مثال 231 — نمط المصنع
# Factory pattern
# Demonstrates: إنشاء كائنات حسب النوع
#
# Run:  python apl.py examples/231-factory-pattern.apl

صنف سيارة:
    دالة نوع(ذات):
        ارجع "سيارة"
    دالة عجلات(ذات):
        ارجع 4

صنف دراجة:
    دالة نوع(ذات):
        ارجع "دراجة"
    دالة عجلات(ذات):
        ارجع 2

صنف شاحنة:
    دالة نوع(ذات):
        ارجع "شاحنة"
    دالة عجلات(ذات):
        ارجع 6

دالة مصنع_مركبات(اسم):
    حالة اسم:
        قيمة "سيارة":
            ارجع سيارة()
        قيمة "دراجة":
            ارجع دراجة()
        قيمة "شاحنة":
            ارجع شاحنة()
        افتراضي:
            ارجع لا_شيء

لكل اسم في ["سيارة", "دراجة", "شاحنة"]:
    المتغير م = مصنع_مركبات(اسم)
    اطبع م.نوع(), "- عدد العجلات:", م.عجلات()
