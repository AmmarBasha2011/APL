# مثال 2451 — ملء الأصفار لعرض 8
# Zero pad to width 8
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2451-pad-number-with-zeros-to-width-8.apl

# # ندخل القيمة
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع نص(ن).zfill(8)

تأكد_يساوي(ف(7), "00000007", "حالة 1")
تأكد_يساوي(ف(42), "00000042", "حالة 2")
تأكد_يساوي(ف(123), "00000123", "حالة 3")
تأكد_يساوي(ف(99999), "00099999", "حالة 4")
