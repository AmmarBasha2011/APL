# مثال 1633 — متوسط متحرك من تدفق
# Moving average from a data stream
# Demonstrates: نوافذ
#
# Run:  python apl.py examples/1633-moving-average-from-stream.apl

# نحتفظ بقائمة النافذة ومجموعها
# القيمة الأقدم تخرج عند الامتلاء

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متوسطات_متحركة(قيم, حجم):
  نافذة = []
  مجموع = 0
  ناتج = []
  لكل ق في قيم:
    نافذة.append(ق)
    مجموع = مجموع + ق
    لو طول(نافذة) > حجم:
      مجموع = مجموع - نافذة[0]
      نافذة.pop(0)
    ناتج.append(مجموع / طول(نافذة))
  ارجع ناتج

تأكد_يساوي(متوسطات_متحركة([1, 10, 3, 5], 3), [1.0, 5.5, 14 / 3, 6.0], "نافذة ثلاثة")
تأكد_يساوي(متوسطات_متحركة([4, 4], 1), [4.0, 4.0], "نافذة واحدة")
