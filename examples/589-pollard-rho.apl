# مثال 589 — تحليل بولارد-رو
# Pollard rho factorization
# Demonstrates: عوامل أولية، بولارد-رو، دورات
#
# Run:  python apl.py examples/589-pollard-rho.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحليل بولارد-رو إلى عوامل أولية
# Demonstrates: خوارزمية احتمالية ببذرة ثابتة, قاسم_مشترك, كشف دورات
# مثال كلاسيكي: تحليل 8051 = 83 × 97

دالة قاسم_مشترك(أ, ب):
  طالما ب != 0:
    مؤقت = ب
    ب = أ % ب
    أ = مؤقت
  ارجع أ

دالة بولارد(ن):
  لو ن % 2 == 0:
    ارجع 2
  س = 2
  ص = 2
  ق = 1
  طالما ق == 1:
    س = (س * س + 1) % ن
    ص = (ص * ص + 1) % ن
    ص = (ص * ص + 1) % ن
    ق = قاسم_مشترك(أكبر(س - ص, ص - س), ن)
  ارجع ق

ع = بولارد(8051)
مكمل = 8051 // ع
اطبع "عامل:", ع, " والمكمل:", مكمل
تأكد_يساوي(أصغر(ع, مكمل), 83, "العامل الأصغر")
تأكد_يساوي(أكبر(ع, مكمل), 97, "العامل الأكبر")
تأكد_يساوي(ع * مكمل, 8051, "التحقق من الناتج")
