# مثال 2257 — عدد العناصر الأكبر من السابق
# Elements greater than previous
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2257-list-count-elements-greater-than-previous.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع = 0
  لكل ي في نطاق(1, طول(ق)):
    لو ق[ي] > ق[ي - 1]:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([3, 1, 2]), 1, "حالة 1")
تأكد_يساوي(ف([5]), 0, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 5, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 2, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 2, "حالة 5")
