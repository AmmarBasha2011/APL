# مثال 1142 — بحث في مصفوفة
# Search a sorted 2D matrix
# Demonstrates: بحث ثنائي
#
# Run:  python apl.py examples/1142-search-2d-matrix.apl

# نعامل المصفوفة كقائمة واحدة مرتبة
# ونحسب الصف والعمود من الفهرس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة موجود(م, هدف):
  لو طول(م) == 0:
    ارجع خطأ
  ع = طول(م[0])
  يسار = 0
  يمين = طول(م) * ع - 1
  طالما يسار <= يمين:
    وسط = (يسار + يمين) // 2
    ق = م[وسط // ع][وسط % ع]
    لو ق == هدف:
      ارجع صواب
    والا_لو ق < هدف:
      يسار = وسط + 1
    والا:
      يمين = وسط - 1
  ارجع خطأ

م = [[1,3,5,7],[10,11,16,20],[23,30,34,60]]
تأكد_يساوي(موجود(م, 3), صواب, "موجود")
تأكد_يساوي(موجود(م, 13), خطأ, "غير موجود")
تأكد_يساوي(موجود(م, 60), صواب, "الأخير")
تأكد_يساوي(موجود([], 1), خطأ, "فارغة")
