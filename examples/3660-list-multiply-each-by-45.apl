# مثال 3660 — ضرب كل عنصر في 45
# Multiply each item by 45
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3660-list-multiply-each-by-45.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 45]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [135, 45, 90], "حالة 1")
تأكد_يساوي(ف([5]), [225], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [45, 90, 135, 180, 225, 270], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-90, 0, 315, 315, 180], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [450, 900, 450, 1350, 900, 450], "حالة 5")
