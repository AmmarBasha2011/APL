# مثال 2962 — مجموع المربعات من 1 إلى ن
# Sum of squares from 1
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2962-sum-of-squares-from-1-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 5, "حالة 2")
تأكد_يساوي(ف(11), 506, "حالة 3")
تأكد_يساوي(ف(100), 338350, "حالة 4")
