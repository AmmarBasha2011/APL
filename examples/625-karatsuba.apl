# مثال 625 — ضرب كاراتسوبا
# Karatsuba multiplication
# Demonstrates: كاراتسوبا، فرق تسد، أعداد كبيرة
#
# Run:  python apl.py examples/625-karatsuba.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ضرب كاراتسوبا: ضرب الأعداد الكبيرة بتقسيم أسرع
# Demonstrates: فرق تسد, ثلاثة ضروب بدل أربعة, تقسيم عشري
# الضرب المدرسي O(n²) وهذه O(n^1.585)

دالة كاراتسوبا(س, ص):
  لو س < 10 أو ص < 10:
    ارجع س * ص
  ن = أكبر(طول(نص(س)), طول(نص(ص)))
  نصف = ن // 2
  قوة = 10 ** نصف
  أعلى1 = س // قوة
  أدنى1 = س % قوة
  أعلى2 = ص // قوة
  أدنى2 = ص % قوة
  ز0 = كاراتسوبا(أدنى1, أدنى2)
  ز2 = كاراتسوبا(أعلى1, أعلى2)
  ز1 = كاراتسوبا(أدنى1 + أعلى1, أدنى2 + أعلى2) - ز0 - ز2
  ارجع ز2 * (10 ** (2 * نصف)) + ز1 * قوة + ز0

تأكد_يساوي(كاراتسوبا(1234, 5678), 7006652, "ضرب رباعي")
تأكد_يساوي(كاراتسوبا(123456789, 987654321), 123456789 * 987654321, "ضرب تساعي")
تأكد_يساوي(كاراتسوبا(7, 8), 56, "حالة أساس")
اطبع "1234 × 5678 =", كاراتسوبا(1234, 5678)
