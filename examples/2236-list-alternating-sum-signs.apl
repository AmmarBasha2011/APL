# مثال 2236 — المجموع المتناوب
# Alternating sum
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2236-list-alternating-sum-signs.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل ي في نطاق(طول(ق)):
    لو ي % 2 == 0:
      م = م + ق[ي]
    والا:
      م = م - ق[ي]
  ارجع م

تأكد_يساوي(ف([3, 1, 2]), 4, "حالة 1")
تأكد_يساوي(ف([5]), 5, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), -3, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 2, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), -20, "حالة 5")
