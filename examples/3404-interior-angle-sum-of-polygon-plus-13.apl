# مثال 3404 — مجموع زوايا مضلع زائد 13
# Polygon angle sum plus 13
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3404-interior-angle-sum-of-polygon-plus-13.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 13

تأكد_يساوي(ف(3), 193, "حالة 1")
تأكد_يساوي(ف(4), 373, "حالة 2")
تأكد_يساوي(ف(5), 553, "حالة 3")
تأكد_يساوي(ف(6), 733, "حالة 4")
تأكد_يساوي(ف(12), 1813, "حالة 5")
