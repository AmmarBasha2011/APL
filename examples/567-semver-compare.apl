# مثال 567 — مقارنة semver
# Semver comparison
# Demonstrates: semver، إصدارات، مقارنة رقمية
#
# Run:  python apl.py examples/567-semver-compare.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# مقارنة إصدارات دلالية semver
دالة قارن(أ, ب):
    المتغير أجزاء_أ = [صحيح(ج) لكل ج في أ.تقسيم(".")]
    المتغير أجزاء_ب = [صحيح(ج) لكل ج في ب.تقسيم(".")]
    لكل i في نطاق(3):
        لو أجزاء_أ[i] > أجزاء_ب[i]:
            ارجع 1
        لو أجزاء_أ[i] < أجزاء_ب[i]:
            ارجع 0 - 1
    ارجع 0

تأكد_يساوي(قارن("1.10.2", "1.9.9"), 1, "1.10.2 أحدث")
تأكد_يساوي(قارن("2.0.0", "10.0.0"), 0 - 1, "2 أقدم من 10")
تأكد_يساوي(قارن("3.4.5", "3.4.5"), 0, "متساويان")
تأكد_يساوي(قارن("1.0.1", "1.0.0"), 1, "تصحيح أحدث")
