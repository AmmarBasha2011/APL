# مثال 2291 — أكبر خلية
# Max cell
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2291-matrix-max-cell-value.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ك = م[0][0]
  لكل ص في م:
    لكل ع في ص:
      لو ع > ك:
        ك = ع
  ارجع ك

تأكد_يساوي(ف([[1, 2], [3, 4]]), 4, "حالة 1")
تأكد_يساوي(ف([[5]]), 5, "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), 9, "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), 1, "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), 3, "حالة 5")
