# مثال 263 — صراف آلي مبسط
# Simple ATM
# Demonstrates: رصيد وعمليات، ورق نقدي
#
# Run:  python apl.py examples/263-atm.apl

المتغير رصيد = 2500

دالة اسحب_نقد(مبلغ):
    عام_رصيد = رصيد
    لو مبلغ > رصيد:
        ارجع "رصيد غير كاف"
    لو مبلغ % 50 != 0:
        ارجع "المبلغ يجب أن يكون من مضاعفات 50"
    ارجع "تم صرف " + نص(مبلغ)

اطبع اسحب_نقد(500)
اطبع اسحب_نقد(130)
اطبع اسحب_نقد(99999)

المتغير فئات = [200, 100, 50]
المتغير مطلوب = 750
اطبع "صرف", مطلوب, ":"
لكل فئة في فئات:
    المتغير عدد = مطلوب // فئة
    مطلوب = مطلوب % فئة
    لو عدد > 0:
        اطبع " ", عدد, "×", فئة
