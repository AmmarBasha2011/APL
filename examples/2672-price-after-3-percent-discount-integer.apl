# مثال 2672 — السعر بعد خصم 3 بالمئة
# Price after 3 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2672-price-after-3-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 3 // 100

تأكد_يساوي(ف(100), 97, "حالة 1")
تأكد_يساوي(ف(250), 243, "حالة 2")
تأكد_يساوي(ف(999), 970, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
