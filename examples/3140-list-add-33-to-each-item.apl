# مثال 3140 — إضافة 33 لكل عنصر
# Add 33 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3140-list-add-33-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 33]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [36, 34, 35], "حالة 1")
تأكد_يساوي(ف([5]), [38], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [34, 35, 36, 37, 38, 39], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [31, 33, 40, 40, 37], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [43, 53, 43, 63, 53, 43], "حالة 5")
