# مثال 1559 — هل المتجهان متعامدان
# Perpendicular vectors check
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1559-perpendicular-vectors-check.apl

# نحسب الجداء النقطي
# إن كان صفراً فالزاوية قائمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متعامدان(أ, ب):
  مجموع = 0
  لكل ع في نطاق(طول(أ)):
    مجموع = مجموع + أ[ع] * ب[ع]
  ارجع مجموع == 0

تأكد_يساوي(متعامدان([1, 0], [0, 5]), صواب, "محوران")
تأكد_يساوي(متعامدان([1, 2], [2, -1]), صواب, "قطري")
تأكد_يساوي(متعامدان([1, 1], [1, 2]), خطأ, "غير متعامدين")
تأكد_يساوي(متعامدان([1, 2, 3], [3, 0, -1]), صواب, "ثلاثة أبعاد")
