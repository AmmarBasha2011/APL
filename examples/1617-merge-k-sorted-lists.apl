# مثال 1617 — دمج عدة قوائم مرتبة
# Merge k sorted lists
# Demonstrates: قوائم
#
# Run:  python apl.py examples/1617-merge-k-sorted-lists.apl

# ندمج قائمتين في كل مرة
# نكرر حتى تبقى قائمة واحدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادمج_اثنتين(أ, ب):
  ي = 0
  ج = 0
  ناتج = []
  طالما ي < طول(أ) و ج < طول(ب):
    لو أ[ي] <= ب[ج]:
      ناتج.append(أ[ي])
      ي = ي + 1
    والا:
      ناتج.append(ب[ج])
      ج = ج + 1
  لكل ع في نطاق(ي, طول(أ)):
    ناتج.append(أ[ع])
  لكل ع في نطاق(ج, طول(ب)):
    ناتج.append(ب[ع])
  ارجع ناتج

دالة ادمج_الكل(قوائم):
  ناتج = []
  لكل ق في قوائم:
    ناتج = ادمج_اثنتين(ناتج, ق)
  ارجع ناتج

تأكد_يساوي(ادمج_الكل([[1, 4, 5], [1, 3, 4], [2, 6]]), [1, 1, 2, 3, 4, 4, 5, 6], "ثلاث قوائم")
تأكد_يساوي(ادمج_الكل([]), [], "بلا قوائم")
تأكد_يساوي(ادمج_الكل([[], [1]]), [1], "قائمة فارغة")
