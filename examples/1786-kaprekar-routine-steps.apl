# مثال 1786 — خطوات كابريكار
# Kaprekar routine steps
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1786-kaprekar-routine-steps.apl

# نرتب أرقام العدد
# نكرر حتى نصل 6174

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة خطوة(ن):
  أرقام = []
  لكل ك في نطاق(4):
    أرقام.append(ن % 10)
    ن = ن // 10
  أرقام.sort()
  صغير = 0
  لكل ر في أرقام:
    صغير = صغير * 10 + ر
  أرقام.reverse()
  كبير = 0
  لكل ر في أرقام:
    كبير = كبير * 10 + ر
  ارجع كبير - صغير

دالة عدد_الخطوات(ن):
  عد = 0
  طالما ن != 6174:
    ن = خطوة(ن)
    عد = عد + 1
  ارجع عد

تأكد_يساوي(عدد_الخطوات(3524), 3, "ثلاث")
تأكد_يساوي(عدد_الخطوات(6174), 0, "الثابت")
تأكد_يساوي(عدد_الخطوات(2111), 5, "خمس")
