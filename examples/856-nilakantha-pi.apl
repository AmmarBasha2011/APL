# مثال 856 — ط بنيلاكانتا
# Nilakantha series
# Demonstrates: كسور ثلاثية متناوبة
#
# Run:  python apl.py examples/856-nilakantha-pi.apl

# متسلسلة نيلاكانتا: ط = 3 + 4/(2*3*4) - 4/(4*5*6) + 4/(6*7*8) - ...
# أسرع بكثير من لايبنتز: مئة حد تكفي لخمس خانات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ط_نيلاكانتا(حدود):
  مجموع = 3.0
  إشارة = 1.0
  أ = 2
  لكل _ في نطاق(حدود):
    مجموع = مجموع + إشارة * 4.0 / (أ * (أ + 1) * (أ + 2))
    إشارة = -إشارة
    أ = أ + 2
  ارجع مجموع

ط = ط_نيلاكانتا(100)
اطبع "ط بعد 100 حد:", ط

تأكد_يساوي(مقرب(ط, 5), 3.14159, "خمس خانات صحيحة")
تأكد_يساوي(مقرب(ط, 7), 3.1415924, "سبع خانات صحيحة")

# قارن بالتقارب البطيء للايبنتز: أول حد من نيلاكانتا يعطي 3.1666
ط1 = ط_نيلاكانتا(1)
تأكد_يساوي(مقرب(ط1, 4), 3.1667, "حد واحد: 3 + 4/24")
