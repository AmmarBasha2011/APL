# مثال 3377 — السعر مع ضريبة 21 بالمئة
# Price with 21 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3377-price-with-21-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 21 // 100

تأكد_يساوي(ف(100), 121, "حالة 1")
تأكد_يساوي(ف(250), 302, "حالة 2")
تأكد_يساوي(ف(999), 1208, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
