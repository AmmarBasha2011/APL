# مثال 2158 — صنف سلة تسوق بخصم نسبة
# Shopping cart class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2158-shopping-cart-class-total-with-discount.apl

# # السعر بالقروش
# # الخصم بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف سلة:
    دالة_إنشاء(ذات):
        ذات.بنود = []

    دالة اضف(ذات, سعر, كمية):
        ذات.بنود = ذات.بنود + [[سعر, كمية]]

    دالة مجموع(ذات, خصم):
        م = 0
        لكل ب في ذات.بنود:
            م = م + ب[0] * ب[1]
        ارجع م * (100 - خصم) // 100

س = سلة()
س.اضف(250, 2)
س.اضف(100, 3)
تأكد_يساوي(س.مجموع(0), 800, "بلا خصم")
تأكد_يساوي(س.مجموع(10), 720, "عشرة بالمئة")
تأكد_يساوي(سلة().مجموع(50), 0, "فارغة")
