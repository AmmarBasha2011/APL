# مثال 119 — كشف النصوص المتناظرة
# Palindrome detection
# Demonstrates: دوال، حلقات، شروط، دوال النصوص
#
# Run:  python apl.py examples/119-text-palindromes.apl

دالة متناظرة(نص):
    المتغير نظيف = ""
    لكل حرف في نص:
        لو حرف != " ":
            نظيف = نظيف + حرف
    ارجع نظيف == نظيف[::-1]

المتغير عبارات = ["aba", "رادر", "مادام", "لغة", "12321", "APL"]
لكل عبارة في عبارات:
    لو متناظرة(عبارة):
        اطبع عبارة, ": متناظرة"
    الا:
        اطبع عبارة, ": ليست متناظرة"
