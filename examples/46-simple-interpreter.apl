# مثال 46 — مفسّر حسابات مبسّط
# Simple Calculator Interpreter
# Demonstrates: parsing, eval-like dispatch, loops
#
# Run:  python apl.py examples/46-simple-interpreter.apl

دالة_تطبيق(عملية, أ, ب):
    إذا عملية == "+":
        ارجع أ + ب
    سإذا عملية == "-":
        ارجع أ - ب
    سإذا عملية == "*":
        ارجع أ * ب
    سإذا عملية == "/":
        إذا ب == 0:
            ارجع "خطأ: قسمة على صفر"
        ارجع أ / ب
    سإذا عملية == "^":
        ارجع أ ** ب
    سإذا عملية == "%":
        ارجع أ % ب
    ارجع "عملية غير معروفة: " + عملية

دالة_تنفيذ(سطر):
    الأجزاء = دالة_تقسيم(سطر, " ")
    إذا طول(الأجزاء) < 3:
        ارجع "سطر غير صالح: " + سطر
    ارجع [دالة_تطبيق(الأجزاء[1], الأجزاء[0] * 1, الأجزاء[2] * 1)]

اطبع "=== مفسّر الحسابات ==="
اطبع ""
المتغير الأوامر = [
    "3 + 4",
    "10 - 6",
    "7 * 8",
    "20 / 4",
    "2 ^ 10",
    "17 % 5"
]

لكل أمر in الأوامر:
    نتيجة = دالة_تنفيذ(أمر)
    اطبع "  " + أمر + "  =  " + نص(نتيجة)

اطبع ""
اطبع "--- حالة خطأ ---"
اطبع "  " + نص(دالة_تنفيذ("5 / 0"))
