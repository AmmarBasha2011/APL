# مثال 436 — تنسيق أحجام الملفات
# Byte size formatting
# Demonstrates: KB MB GB
#
# Run:  python apl.py examples/436-byte-format.apl

دالة حجم_نص(بايت):
    المتغير مقاييس = ["بايت", "كيلوبايت", "ميجابايت", "جيجابايت"]
    المتغير قيمة = بايت
    المتغير مرتبة = 0
    طالما قيمة >= 1024 و مرتبة < 3:
        قيمة = قيمة / 1024
        مرتبة = مرتبة + 1
    ارجع نص(صحيح(قيمة * 100) / 100) + " " + مقاييس[مرتبة]

اطبع حجم_نص(512)
اطبع حجم_نص(2048)
اطبع حجم_نص(5242880)
اطبع حجم_نص(3221225472)
