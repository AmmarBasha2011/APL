# مثال 772 — ترميز فيبوناتشي
# Fibonacci coding
# Demonstrates: زكندورف، بت إنهاء، فصل ذاتي
#
# Run:  python apl.py examples/772-fibonacci-coding.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ترميز فيبوناتشي للأعداد: تمثيل زكندورف + بت إنهاء
# Demonstrates: تمثيل زكندورف الجشع, شفرة ذاتية الفصل ببتين متتاليين

دالة فيبوناتشي_ترميز(ن):
  فيب = [1, 2]
  طالما فيب[طول(فيب) - 1] + فيب[طول(فيب) - 2] <= ن:
    فيب.append(فيب[طول(فيب) - 1] + فيب[طول(فيب) - 2])
  بتات = []
  لكل ي في نطاق(طول(فيب)):
    بتات.append(0)
  باقي = ن
  ي = طول(فيب) - 1
  طالما ي >= 0:
    لو فيب[ي] <= باقي:
      بتات[ي] = 1
      باقي = باقي - فيب[ي]
    ي = ي - 1
  اعلى = طول(بتات) - 1
  طالما بتات[اعلى] == 0:
    اعلى = اعلى - 1
  ناتج = ""
  ي = 0
  طالما ي <= اعلى:
    لو بتات[ي] == 1:
      ناتج = ناتج + "1"
    والا:
      ناتج = ناتج + "0"
    ي = ي + 1
  ارجع ناتج + "1"

دالة فيبوناتشي_فك(شفرة):
  فيب = [1, 2]
  طالما طول(فيب) < طول(شفرة):
    فيب.append(فيب[طول(فيب) - 1] + فيب[طول(فيب) - 2])
  حصيلة = 0
  لكل ي في نطاق(طول(شفرة)):
    لو شفرة[ي] == "1":
      لو ي > 0 و شفرة[ي - 1] == "1":
        ارجع حصيلة
      حصيلة = حصيلة + فيب[ي]
  ارجع حصيلة

تأكد_يساوي(فيبوناتشي_ترميز(1), "11", "ترميز 1")
تأكد_يساوي(فيبوناتشي_ترميز(11), "001011", "ترميز 11")
تأكد_يساوي(فيبوناتشي_ترميز(65), "0100100011", "ترميز 65")
تأكد_يساوي(فيبوناتشي_ترميز(100), "00101000011", "ترميز 100")
تأكد_يساوي(فيبوناتشي_فك("11"), 1, "فك 1")
تأكد_يساوي(فيبوناتشي_فك("001011"), 11, "فك 11")
تأكد_يساوي(فيبوناتشي_فك("0100100011"), 65, "فك 65")
تأكد_يساوي(فيبوناتشي_فك("00101000011"), 100, "فك 100")
تأكد_يساوي(فيبوناتشي_فك(فيبوناتشي_ترميز(999)), 999, "ذهاب وإياب 999")
