# مثال 2366 — القسمة على 11 بالمتناوب
# Divisible by eleven rule
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2366-divisible-by-eleven-via-alternating-sum.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  ش = 1
  طالما ن > 0:
    م = م + ش * (ن % 10)
    ش = -ش
    ن = ن // 10
  ارجع م % 11 == 0

تأكد_يساوي(ف(11), صواب, "حالة 1")
تأكد_يساوي(ف(121), صواب, "حالة 2")
تأكد_يساوي(ف(123), خطأ, "حالة 3")
تأكد_يساوي(ف(1331), صواب, "حالة 4")
تأكد_يساوي(ف(2728), صواب, "حالة 5")
تأكد_يساوي(ف(100), خطأ, "حالة 6")
