# مثال 1426 — أقرب وقت تالٍ
# Next closest time reusing digits
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1426-next-closest-time.apl

# نتقدم دقيقة دقيقة
# ونقبل أول وقت أرقامه كلها من الأرقام الأصلية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بخانتين(ن):
  لو ن < 10:
    ارجع "0" + نص(ن)
  ارجع نص(ن)

دالة وقت_تالي(وقت):
  مسموح = {}
  لكل ح في وقت:
    مسموح[ح] = صواب
  قيمة_الوقت = صحيح(وقت[:2]) * 60 + صحيح(وقت[3:])
  لكل خطوة في نطاق(1, 1441):
    ت = (قيمة_الوقت + خطوة) % 1440
    نتيجة = بخانتين(ت // 60) + ":" + بخانتين(ت % 60)
    سليم = صواب
    لكل ح في نتيجة:
      لو ح ليس في مسموح:
        سليم = خطأ
    لو سليم:
      ارجع نتيجة
  ارجع وقت

تأكد_يساوي(وقت_تالي("19:34"), "19:39", "مثال أول")
تأكد_يساوي(وقت_تالي("23:59"), "22:22", "منتصف الليل")
تأكد_يساوي(وقت_تالي("01:32"), "01:33", "دقيقة")
