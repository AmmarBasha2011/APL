# مثال 329 — تجميع زوجي وفردي
# Group by parity
# Demonstrates: تصنيف قائمة
#
# Run:  python apl.py examples/329-group-parity.apl

دالة صنف_زوجية(أرقام):
    المتغير زوجية = []
    المتغير فردية = []
    لكل ع في أرقام:
        لو ع % 2 == 0:
            زوجية.أضف(ع)
        الا:
            فردية.أضف(ع)
    ارجع {"زوجية": زوجية, "فردية": فردية}

المتغير ن = صنف_زوجية([1, 2, 3, 4, 5, 6, 7, 8, 9])
اطبع "الزوجية:", ن["زوجية"]
اطبع "الفردية:", ن["فردية"]
