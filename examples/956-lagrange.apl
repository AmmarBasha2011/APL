# مثال 956 — استيفاء لاغرانج
# Lagrange interpolation
# Demonstrates: حدود أساس متعامدة
#
# Run:  python apl.py examples/956-lagrange.apl

# استيفاء لاغرانج: كثير الحدود الوحيد المار بنقاط معطاة
# أساس مشاركة الأسرار والاستيفاء العددي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة استوف(نقاط_س, نقاط_ص, س):
  مجموع = 0
  لكل i في نطاق(طول(نقاط_س)):
    حد = نقاط_ص[i]
    لكل ج في نطاق(طول(نقاط_س)):
      لو i != ج:
        حد = حد * (س - نقاط_س[ج]) / (نقاط_س[i] - نقاط_س[ج])
    مجموع = مجموع + حد
  ارجع مجموع

# النقاط (0,1) (1,3) (2,7) تقع على ص = س^2 + س + 1
نقاط_س = [0, 1, 2]
نقاط_ص = [1, 3, 7]

اطبع "عند 3:", استوف(نقاط_س, نقاط_ص, 3)
اطبع "عند 1.5:", استوف(نقاط_س, نقاط_ص, 1.5)

# 3^2+3+1 = 13
تأكد_يساوي(مقرب(استوف(نقاط_س, نقاط_ص, 3), 6), 13, "استيفاء عند 3")
# 1.5^2+1.5+1 = 4.75
تأكد_يساوي(مقرب(استوف(نقاط_س, نقاط_ص, 1.5), 6), 4.75, "استيفاء عند 1.5")

# يمر بنقاط العينة نفسها
لكل i في نطاق(3):
  تأكد_يساوي(مقرب(استوف(نقاط_س, نقاط_ص, نقاط_س[i]), 6), نقاط_ص[i], "نقطة " + نص(i))
