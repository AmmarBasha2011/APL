# مثال 830 — بحث تابو
# Tabu search
# Demonstrates: قائمة محرمات، جوار موسع
#
# Run:  python apl.py examples/830-tabu-search.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# بحث تابو: جوار موسع مع قائمة محرمات قصيرة الذاكرة
# Demonstrates: قائمة تابو, قبول أفضل جار غير محرم, خروج من الحلول المحلية

دالة هدف(س):
  ارجع (س - 7) * (س - 7)

دالة بحث_تابو(بداية, خطوات):
  س = بداية
  أفضل = س
  أفضل_قيمة = هدف(س)
  تابو = [س]
  لكل خطوة في نطاق(خطوات):
    مرشحون = []
    لكل جار في [س - 2, س - 1, س + 1, س + 2]:
      لو جار >= 0 و جار <= 15 و (جار في تابو) == خطأ:
        مرشحون.append(جار)
    لو طول(مرشحون) == 0:
      ارجع [أفضل, أفضل_قيمة]
    أقرب = مرشحون[0]
    لكل جار في مرشحون:
      لو هدف(جار) < هدف(أقرب):
        أقرب = جار
    س = أقرب
    لو هدف(س) < أفضل_قيمة:
      أفضل = س
      أفضل_قيمة = هدف(س)
    تابو.append(س)
    لو طول(تابو) > 3:
      تابو.pop(0)
  ارجع [أفضل, أفضل_قيمة]

تأكد_يساوي(بحث_تابو(5, 10), [7, 0], "الوصول للحل الأمثل")
تأكد_يساوي(بحث_تابو(0, 15), [7, 0], "من الطرف البعيد")
تأكد_يساوي(بحث_تابو(14, 15), [7, 0], "من الطرف الآخر")
تأكد_يساوي(هدف(7), 0, "قيمة الأمثل")
