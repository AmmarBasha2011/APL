# مثال 150 — تقطيع المكررات وتجميعها
# Slicing and chaining iterables
# Demonstrates: قطّع، تجميع، زوجي، كرر_لا نهائي
#
# Run:  python apl.py examples/150-itertools-slicing.apl

اطبع "أول 5 من نطاق كبير:", قائمة(قطّع(نطاق(1000), 5))
اطبع "من 10 لـ 15:", قائمة(قطّع(نطاق(100), 10, 15))
اطبع "تجميع قائمتين:", قائمة(تجميع([1, 2], [3, 4]))
اطبع "تكرار قيمة:", قائمة(كرر_لا نهائي("نجمة", 3))
اطبع "زوجي مع ملء:", قائمة(زوجي([1, 2, 3], ["أ"], fillvalue="فارغ"))
