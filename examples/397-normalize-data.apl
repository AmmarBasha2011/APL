# مثال 397 — تطبيع البيانات
# Normalize data
# Demonstrates: min-max و z-score
#
# Run:  python apl.py examples/397-normalize-data.apl

دالة تطبيع(قائمة):
    المتغير أدنى = قائمة[0]
    المتغير أعلى = قائمة[0]
    لكل ق in قائمة:
        لو ق < أدنى:
            أدنى = ق
        لو ق > أعلى:
            أعلى = ق
    المتغير نتائج = []
    لكل ق in قائمة:
        نتائج.append((ق - أدنى) / (أعلى - أدنى))
    ارجع نتائج

دالة زد(قائمة):
    المتغير مجموع = 0
    لكل ق in قائمة:
        مجموع = مجموع + ق
    المتغير م = مجموع / طول(قائمة)
    المتغير ت = 0
    لكل ق in قائمة:
        ت = ت + (ق - م) * (ق - م)
    المتغير انحراف = جذر(ت / طول(قائمة))
    المتغير نتائج = []
    لكل ق in قائمة:
        نتائج.append((ق - م) / انحراف)
    ارجع نتائج

المتغير بيانات = [10, 20, 30, 40, 50]
اطبع "مطبيع:", تطبيع(بيانات)
اطبع "z-score:", زد(بيانات)
