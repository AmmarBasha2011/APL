# مثال 3626 — قوة 9 بالحلقة
# Power of 9 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3626-nth-power-of-9-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 9
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 9, "حالة 2")
تأكد_يساوي(ف(3), 729, "حالة 3")
تأكد_يساوي(ف(6), 531441, "حالة 4")
تأكد_يساوي(ف(10), 3486784401, "حالة 5")
