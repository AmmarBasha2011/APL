# مثال 471 — مقياس قوة كلمة المرور
# Password strength meter
# Demonstrates: نقاط حسب المعايير
#
# Run:  python apl.py examples/471-password-strength.apl

دالة قوة(كلمة):
    المتغير نقاط = 0
    لو طول(كلمة) >= 8:
        نقاط = نقاط + 1
    لو طول(كلمة) >= 12:
        نقاط = نقاط + 1
    لو بحث_نمطي("[A-Z]", كلمة) != لا_شيء:
        نقاط = نقاط + 1
    لو بحث_نمطي("[0-9]", كلمة) != لا_شيء:
        نقاط = نقاط + 1
    لو بحث_نمطي("[!@#$%]", كلمة) != لا_شيء:
        نقاط = نقاط + 1
    ارجع نقاط

دالة وصف_قوة(نقاط):
    لو نقاط <= 2:
        ارجع "ضعيفة"
    لو نقاط <= 3:
        ارجع "متوسطة"
    ارجع "قوية"

لكل ك in ["abc", "Password1", "P@ssw0rd!2026"]:
    اطبع ك, "->", وصف_قوة(قوة(ك))
