# مثال 499 — مخطط فعاليات
# Event planner
# Demonstrates: جدول بدون تداخل
#
# Run:  python apl.py examples/499-event-planner.apl

المتغير فعاليات = [
    {"اسم": "اجتماع", "من": 9, "إلى": 10},
    {"اسم": "ورشة", "من": 10, "إلى": 12},
    {"اسم": "غداء", "من": 12, "إلى": 13},
    {"اسم": "عرض", "من": 11, "إلى": 12}
]

دالة متداخل(أ, ب):
    ارجع أ["من"] < ب["إلى"] و ب["من"] < أ["إلى"]

اطبع "فحص التداخلات:"
لكل ي في نطاق(طول(فعاليات)):
    لكل ز في نطاق(ي + 1, طول(فعاليات)):
        لو متداخل(فعاليات[ي], فعاليات[ز]):
            اطبع "تداخل:", فعاليات[ي]["اسم"], "مع", فعاليات[ز]["اسم"]
