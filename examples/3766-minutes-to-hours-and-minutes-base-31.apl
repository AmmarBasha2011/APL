# مثال 3766 — تحويل وحدة بأساس 31
# Split by base 31
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3766-minutes-to-hours-and-minutes-base-31.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 31, ن % 31]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 28], "حالة 2")
تأكد_يساوي(ف(60), [1, 29], "حالة 3")
تأكد_يساوي(ف(125), [4, 1], "حالة 4")
تأكد_يساوي(ف(1000), [32, 8], "حالة 5")
