# مثال 2829 — عدد الحرف t في النص
# Count letter t
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2829-count-letter-t-in-text-v5.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن.count("t")

تأكد_يساوي(ف("elephant"), 1, "حالة 1")
تأكد_يساوي(ف("aaa"), 0, "حالة 2")
تأكد_يساوي(ف("status quo"), 2, "حالة 3")
تأكد_يساوي(ف("mississippi"), 0, "حالة 4")
