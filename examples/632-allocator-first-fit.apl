# مثال 632 — مخصص ذاكرة بأول ملائم
# First-fit allocator
# Demonstrates: malloc، كتل، دمج
#
# Run:  python apl.py examples/632-allocator-first-fit.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# محاكي مخصص ذاكرة: أول ملائم مع دمج الحر
# Demonstrates: كتل حرة ومشغولة, أول ملائم, دمج الجيران
# هكذا تدير malloc الذاكرة

دالة أنشئ_ذاكرة(حجم):
  ارجع [{"بداية": 0, "حجم": حجم, "حر": صواب}]

دالة خصص(ذاكرة, حجم):
  لكل كتلة في ذاكرة:
    لو كتلة["حر"] و كتلة["حجم"] >= حجم:
      بداية = كتلة["بداية"]
      لو كتلة["حجم"] > حجم:
        ذاكرة.insert(ذاكرة.index(كتلة) + 1, {"بداية": بداية + حجم, "حجم": كتلة["حجم"] - حجم, "حر": صواب})
        كتلة["حجم"] = حجم
      كتلة["حر"] = خطأ
      ارجع بداية
  ارجع -1

دالة حرر(ذاكرة, بداية):
  لكل كتلة في ذاكرة:
    لو كتلة["بداية"] == بداية:
      كتلة["حر"] = صواب
  ذاكرة2 = []
  لكل كتلة في ذاكرة:
    لو طول(ذاكرة2) > 0 و ذاكرة2[طول(ذاكرة2) - 1]["حر"] و كتلة["حر"]:
      ذاكرة2[طول(ذاكرة2) - 1]["حجم"] = ذاكرة2[طول(ذاكرة2) - 1]["حجم"] + كتلة["حجم"]
    والا:
      ذاكرة2.append(كتلة)
  ارجع ذاكرة2

ذاكرة = أنشئ_ذاكرة(100)
أ = خصص(ذاكرة, 30)
ب = خصص(ذاكرة, 20)
ج = خصص(ذاكرة, 50)
تأكد_يساوي([أ, ب, ج], [0, 30, 50], "عناوين متتالية")
تأكد_يساوي(خصص(ذاكرة, 10), -1, "لا مكان")
ذاكرة = حرر(ذاكرة, 30)
تأكد_يساوي(خصص(ذاكرة, 10), 30, "إعادة استخدام الحر")
ذاكرة = حرر(ذاكرة, 0)
ذاكرة = حرر(ذاكرة, 50)
ذاكرة = حرر(ذاكرة, 30)
تأكد_يساوي(خصص(ذاكرة, 90), 0, "دمج الجيران كلها")
اطبع "كتل:", طول(ذاكرة)
