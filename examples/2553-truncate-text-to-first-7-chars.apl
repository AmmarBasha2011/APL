# مثال 2553 — اقتطاع أول 7 أحرف
# First 7 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2553-truncate-text-to-first-7-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:7]

تأكد_يساوي(ف("hello world"), "hello w", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abcdefg", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
