# مثال 128 — تحويل اجتماع بين المناطق الزمنية
# Meeting across timezones
# Demonstrates: منطقة_زمنية، التاريخ_الآن، مفتاح_المنطقة
#
# Run:  python apl.py examples/128-zoneinfo-meeting.apl

المتغير قاهرة = منطقة_زمنية("Africa/Cairo")
المتغير نيويورك = منطقة_زمنية("America/New_York")
المتغير لندن = منطقة_زمنية("Europe/London")

المتغير الآن = التاريخ_الآن().astimezone(قاهرة)
اطبع "القاهرة:", لتنسيق_وقت(الآن, "%H:%M"), "-", قاهرة.مفتاح_المنطقة

المتغير ن = الآن.astimezone(نيويورك)
اطبع "نيويورك:", لتنسيق_وقت(ن, "%H:%M")

المتغير ل = الآن.astimezone(لندن)
اطبع "لندن:", لتنسيق_وقت(ل, "%H:%M")

اطبع "عدد المناطق المتاحة:", طول(كل_المناطق_الزمنية()) > 400
