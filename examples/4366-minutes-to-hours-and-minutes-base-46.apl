# مثال 4366 — تحويل وحدة بأساس 46
# Split by base 46
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4366-minutes-to-hours-and-minutes-base-46.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 46, ن % 46]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 13], "حالة 2")
تأكد_يساوي(ف(60), [1, 14], "حالة 3")
تأكد_يساوي(ف(125), [2, 33], "حالة 4")
تأكد_يساوي(ف(1000), [21, 34], "حالة 5")
