# مثال 4179 — مساحة مستطيل مكبر 24 مرات
# Rectangle area scaled by 24
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4179-rectangle-area-scaled-by-24.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 24) * (ق[1] * 24)

تأكد_يساوي(ف([1, 2]), 1152, "حالة 1")
تأكد_يساوي(ف([3, 4]), 6912, "حالة 2")
تأكد_يساوي(ف([5, 5]), 14400, "حالة 3")
تأكد_يساوي(ف([10, 1]), 5760, "حالة 4")
