# مثال 651 — حيل البتات
# Bit tricks
# Demonstrates: بتات، إزاحات، XOR
#
# Run:  python apl.py examples/651-bit-tricks.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# حيل البتات الشائعة
# Demonstrates: س & -س, س & (س-1), إزاحات, مقايضة XOR
# عمليات البتات أسرع من القسمة والباقي

دالة عد_البتات(س):
  عدد = 0
  طالما س > 0:
    عدد = عدد + س % 2
    س = س // 2
  ارجع عدد

دالة أدنى_بت(س):
  ارجع س & (0 - س)

دالة قوة_اثنين(س):
  ارجع س > 0 و (س & (س - 1)) == 0

تأكد_يساوي(عد_البتات(182), 5, "عد البتات المضيئة")
تأكد_يساوي(أدنى_بت(40), 8, "أدنى بت مضيء")
تأكد_يساوي(قوة_اثنين(16), صواب, "16 قوة اثنين")
تأكد_يساوي(قوة_اثنين(18), خطأ, "18 ليست قوة اثنين")
تأكد_يساوي(40 & 39, 32, "إطفاء أدنى بت")
تأكد_يساوي(1 << 10, 1024, "إزاحة يسار")
تأكد_يساوي(1024 >> 3, 128, "إزاحة يمين")
س = 7
ص = 9
س = س ^ ص
ص = س ^ ص
س = س ^ ص
تأكد_يساوي([س, ص], [9, 7], "مقايضة بلا متغير ثالث")
اطبع "انتهت الحيل"
