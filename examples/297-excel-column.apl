# مثال 297 — عنوان عمود إكسل
# Excel column title
# Demonstrates: تحويل أساس 26
#
# Run:  python apl.py examples/297-excel-column.apl

دالة عمود_إكسل(عدد):
    المتغير نتيجة = ""
    طالما عدد > 0:
        عدد = عدد - 1
        نتيجة = فك_ترميز_حرف(65 + عدد % 26) + نتيجة
        عدد = عدد // 26
    ارجع نتيجة

اطبع "1 =", عمود_إكسل(1)
اطبع "28 =", عمود_إكسل(28)
اطبع "701 =", عمود_إكسل(701)
اطبع "702 =", عمود_إكسل(702)
