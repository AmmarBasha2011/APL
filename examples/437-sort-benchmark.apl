# مثال 437 — مقارنة خوارزميات الترتيب
# Sort algorithms comparison
# Demonstrates: عد المقارنات
#
# Run:  python apl.py examples/437-sort-benchmark.apl

دالة فقاعي(قائمة):
    المتغير ق = []
    لكل عنصر في قائمة:
        ق.append(عنصر)
    المتغير مقارنات = 0
    لكل ي في نطاق(طول(ق)):
        لكل ز في نطاق(طول(ق) - 1):
            مقارنات = مقارنات + 1
            لو ق[ز] > ق[ز + 1]:
                المتغير بدل = ق[ز]
                ق[ز] = ق[ز + 1]
                ق[ز + 1] = بدل
    ارجع مقارنات

دالة اختياري(قائمة):
    المتغير ق = []
    لكل عنصر في قائمة:
        ق.append(عنصر)
    المتغير مقارنات = 0
    لكل ي في نطاق(طول(ق)):
        المتغير أدنى = ي
        لكل ز في نطاق(ي + 1, طول(ق)):
            مقارنات = مقارنات + 1
            لو ق[ز] < ق[أدنى]:
                أدنى = ز
        المتغير بدل = ق[ي]
        ق[ي] = ق[أدنى]
        ق[أدنى] = بدل
    ارجع مقارنات

بذرة(1)
المتغير بيانات = []
لكل _ في نطاق(20):
    بيانات.append(عشوائي_عدد(1, 100))

اطبع "فقاعي:", فقاعي(بيانات), "مقارنة"
اطبع "اختياري:", اختياري(بيانات), "مقارنة"
