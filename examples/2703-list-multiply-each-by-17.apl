# مثال 2703 — ضرب كل عنصر في 17
# Multiply each item by 17
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2703-list-multiply-each-by-17.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 17]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [51, 17, 34], "حالة 1")
تأكد_يساوي(ف([5]), [85], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [17, 34, 51, 68, 85, 102], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-34, 0, 119, 119, 68], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [170, 340, 170, 510, 340, 170], "حالة 5")
