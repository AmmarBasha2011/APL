# مثال 129 — ساعة إيقاف لقياس الأداء
# Stopwatch with perf_counter
# Demonstrates: مؤشر_أداء، مقرب
#
# Run:  python apl.py examples/129-time-stopwatch.apl

المتغير بداية = مؤشر_أداء()
المتغير مجموع = 0
لكل ر في نطاق(100000):
    مجموع = مجموع + ر * ر
المتغير نهاية = مؤشر_أداء()

اطبع "المجموع:", مجموع
اطبع "الزمن (ثوانٍ):", مقرب(نهاية - بداية, 6)
اطبع "الزمن (مللي ثانية):", مقرب((نهاية - بداية) * 1000, 3)
