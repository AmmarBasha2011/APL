# مثال 4032 — آخر رقم من ن×23
# Last digit of n times 23
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4032-last-digit-of-n-times-23.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 23) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(7), 1, "حالة 3")
تأكد_يساوي(ف(12), 6, "حالة 4")
تأكد_يساوي(ف(99), 7, "حالة 5")
