# مثال 3936 — مجموع الأعداد من 36 إلى ن
# Sum from 36 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3936-sum-of-integers-from-36-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(36, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(36), 36, "حالة 1")
تأكد_يساوي(ف(37), 73, "حالة 2")
تأكد_يساوي(ف(46), 451, "حالة 3")
تأكد_يساوي(ف(100), 4420, "حالة 4")
