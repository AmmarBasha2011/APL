# مثال 3757 — السعر مع ضريبة 32 بالمئة
# Price with 32 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3757-price-with-32-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 32 // 100

تأكد_يساوي(ف(100), 132, "حالة 1")
تأكد_يساوي(ف(250), 330, "حالة 2")
تأكد_يساوي(ف(999), 1318, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
