# مثال 2139 — عكس حالة الأحرف بأكواد ASCII
# Swap case with ASCII
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2139-swap-letter-case-with-ascii-codes.apl

# # الأحرف الأخرى تبقى
# # نستخدم ord وchr

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اعكس(س):
  خرج = ""
  لكل ح في س:
    ر = ord(ح)
    لو ر >= 65 و ر <= 90:
      خرج = خرج + chr(ر + 32)
    والا_لو ر >= 97 و ر <= 122:
      خرج = خرج + chr(ر - 32)
    والا:
      خرج = خرج + ح
  ارجع خرج

تأكد_يساوي(اعكس("Hello World"), "hELLO wORLD", "عبارة")
تأكد_يساوي(اعكس("a1B2"), "A1b2", "أرقام")
تأكد_يساوي(اعكس(""), "", "فارغ")
