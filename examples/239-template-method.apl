# مثال 239 — نمط القالب
# Template method pattern
# Demonstrates: هيكل ثابت وخطوات متغيرة
#
# Run:  python apl.py examples/239-template-method.apl

صنف مشروب:
    دالة حضر(ذات):
        ذات.اغل_الماء()
        ذات.أضف_الأساس()
        ذات.قدم()

    دالة اغل_الماء(ذات):
        اطبع "غلي الماء"

    دالة أضف_الأساس(ذات):
        اطبع "أساس عام"

    دالة قدم(ذات):
        اطبع "يقدم في كوب"

صنف شاي(مشروب):
    دالة أضف_الأساس(ذات):
        اطبع "نقع الشاي"

صنف قهوة(مشروب):
    دالة أضف_الأساس(ذات):
        اطبع "تصفية القهوة"

اطبع "--- شاي ---"
شاي().حضر()
اطبع "--- قهوة ---"
قهوة().حضر()
