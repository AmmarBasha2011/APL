# مثال 332 — أيام العمل بين تاريخين
# Working days between dates
# Demonstrates: استبعاد الجمعة والسبت
#
# Run:  python apl.py examples/332-working-days.apl

دالة أيام_عمل(بداية, نهاية):
    المتغير عدد = 0
    المتغير ت = بداية
    طالما ت <= نهاية:
        لو ت.weekday() != 4 و ت.weekday() != 5:
            عدد = عدد + 1
        ت = ت + مدة(أيام=1)
    ارجع عدد

المتغير أول = تاريخ(2026, 11, 1)
المتغير آخر = تاريخ(2026, 11, 30)
اطبع "أيام العمل في نوفمبر 2026:", أيام_عمل(أول, آخر)
