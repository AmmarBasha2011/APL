# مثال 2572 — ضرب كل عنصر في 13
# Multiply each item by 13
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2572-list-multiply-each-by-13.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 13]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [39, 13, 26], "حالة 1")
تأكد_يساوي(ف([5]), [65], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [13, 26, 39, 52, 65, 78], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-26, 0, 91, 91, 52], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [130, 260, 130, 390, 260, 130], "حالة 5")
