# مثال 252 — الفائدة المركبة
# Compound interest
# Demonstrates: نمو سنوي مركب
#
# Run:  python apl.py examples/252-compound-interest.apl

دالة فائدة_مركبة(أصل, نسبة, سنوات):
    المتغير مبلغ = أصل
    لكل سنة في نطاق(1, سنوات + 1):
        مبلغ = مبلغ * (1 + نسبة / 100)
        اطبع "سنة", سنة, ":", مقرب(مبلغ, 2)
    ارجع مبلغ

المتغير نهائي = فائدة_مركبة(1000, 5, 5)
اطبع "ربحت:", مقرب(نهائي - 1000, 2)
