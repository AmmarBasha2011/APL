# مثال 482 — نظام مكتبة
# Library system
# Demonstrates: إعارة وإرجاع كتب
#
# Run:  python apl.py examples/482-library-system.apl

صنف كتاب:
    دالة_إنشاء(ذات, عنوان):
        ذات.عنوان = عنوان
        ذات.معار = خطأ

    دالة أعر(ذات):
        لو ذات.معار:
            اطبع "غير متاح:", ذات.عنوان
            ارجع
        ذات.معار = صواب
        اطبع "تمت الإعارة:", ذات.عنوان

    دالة أرجع_الكتاب(ذات):
        ذات.معار = خطأ
        اطبع "تم الإرجاع:", ذات.عنوان

المتغير ك1 = كتاب("مقدمة في البرمجة")
المتغير ك2 = كتاب("أسرار الخوارزميات")
ك1.أعر()
ك1.أعر()
ك1.أرجع_الكتاب()
ك2.أعر()
