# مثال 3789 — صف جدول ضرب 24
# Multiplication row of 24
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3789-multiplication-table-row-of-24.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 24]
  ارجع ر

تأكد_يساوي(ف(1), [24], "حالة 1")
تأكد_يساوي(ف(5), [24, 48, 72, 96, 120], "حالة 2")
تأكد_يساوي(ف(10), [24, 48, 72, 96, 120, 144, 168, 192, 216, 240], "حالة 3")
