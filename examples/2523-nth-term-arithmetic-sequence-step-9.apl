# مثال 2523 — الحد النوني بخطوة 9
# Nth term step 9
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2523-nth-term-arithmetic-sequence-step-9.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 9

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 12, "حالة 2")
تأكد_يساوي(ف(10), 84, "حالة 3")
تأكد_يساوي(ف(100), 894, "حالة 4")
