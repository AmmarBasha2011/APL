# مثال 1338 — زمن تأخر الشبكة
# Network delay time
# Demonstrates: رسوم بيانية
#
# Run:  python apl.py examples/1338-network-delay-time.apl

# نحسب أقصر زمن لكل عقدة بخوارزمية بيلمان فورد
# الجواب أكبر زمن بينها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تأخر_الشبكة(حواف, ن, بداية):
  كبير = 1000000000
  زمن = [كبير] * (ن + 1)
  زمن[بداية] = 0
  لكل جولة في نطاق(ن):
    لكل ح في حواف:
      لو زمن[ح[0]] + ح[2] < زمن[ح[1]]:
        زمن[ح[1]] = زمن[ح[0]] + ح[2]
  اقصى = 0
  لكل ع في نطاق(1, ن + 1):
    لو زمن[ع] > اقصى:
      اقصى = زمن[ع]
  لو اقصى == كبير:
    ارجع -1
  ارجع اقصى

تأكد_يساوي(تأخر_الشبكة([[2,1,1],[2,3,1],[3,4,1]], 4, 2), 2, "مثال أول")
تأكد_يساوي(تأخر_الشبكة([[1,2,1]], 2, 1), 1, "عقدتان")
تأكد_يساوي(تأخر_الشبكة([[1,2,1]], 2, 2), -1, "لا يصل")
