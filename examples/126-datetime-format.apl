# مثال 126 — تنسيق وتحليل التواريخ
# Formatting and parsing dates
# Demonstrates: لتنسيق_وقت، من_نص_وقت، حوّل_نص_لتاريخ
#
# Run:  python apl.py examples/126-datetime-format.apl

المتغير الآن = التاريخ_الآن()
اطبع "ISO:", لتنسيق_وقت(الآن, "%Y-%m-%d %H:%M")
اطبع "بالعربي:", لتنسيق_وقت(الآن, "%d/%m/%Y")
اطبع "السنة فقط:", لتنسيق_وقت(الآن, "%Y")

المتغير م = من_نص_وقت("2026-11-23 21:30", "%Y-%m-%d %H:%M")
اطبع "حُلل:", م
اطبع "سنة المحلل:", م.رقم_السنة

المتغير ت = حوّل_نص_لتاريخ("2000-09-09")
اطبع "من نص ISO:", ت
