# مثال 1384 — أكبر فجوة
# Maximum gap between sorted neighbors
# Demonstrates: فرز
#
# Run:  python apl.py examples/1384-maximum-gap-sorted.apl

# نرتب المصفوفة
# ونقارن كل عنصر مع سابقه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اكبر_فجوة(أرقام):
  لو طول(أرقام) < 2:
    ارجع 0
  ر = مفرز(أرقام)
  اقصى = 0
  لكل ع في نطاق(1, طول(ر)):
    لو ر[ع] - ر[ع - 1] > اقصى:
      اقصى = ر[ع] - ر[ع - 1]
  ارجع اقصى

تأكد_يساوي(اكبر_فجوة([3,6,9,1]), 3, "ثلاثة")
تأكد_يساوي(اكبر_فجوة([10]), 0, "عنصر")
تأكد_يساوي(اكبر_فجوة([1,1,1,1]), 0, "متساوية")
