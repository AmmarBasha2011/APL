# مثال 4138 — مجموع الأعداد من 43 إلى ن
# Sum from 43 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4138-sum-of-integers-from-43-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(43, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(43), 43, "حالة 1")
تأكد_يساوي(ف(44), 87, "حالة 2")
تأكد_يساوي(ف(53), 528, "حالة 3")
تأكد_يساوي(ف(100), 4147, "حالة 4")
