# مثال 3411 — صف جدول ضرب 17
# Multiplication row of 17
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3411-multiplication-table-row-of-17.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 17]
  ارجع ر

تأكد_يساوي(ف(1), [17], "حالة 1")
تأكد_يساوي(ف(5), [17, 34, 51, 68, 85], "حالة 2")
تأكد_يساوي(ف(10), [17, 34, 51, 68, 85, 102, 119, 136, 153, 170], "حالة 3")
