# مثال 1700 — أقل عدد عملات للمبلغ
# Minimum coins to make amount
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1700-coin-change-min-coins.apl

# أقل عدد لكل مبلغ
# نجرب كل عملة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أقل_عملات(عملات, مبلغ):
  كبير = مبلغ + 1
  جدول = [0]
  لكل ك في نطاق(مبلغ):
    جدول.append(كبير)
  لكل م في نطاق(1, مبلغ + 1):
    لكل ع في عملات:
      لو ع <= م:
        جدول[م] = أصغر(جدول[م], جدول[م - ع] + 1)
  لو جدول[مبلغ] > مبلغ:
    ارجع -1
  ارجع جدول[مبلغ]

تأكد_يساوي(أقل_عملات([1, 2, 5], 11), 3, "أحد عشر")
تأكد_يساوي(أقل_عملات([2], 3), -1, "مستحيل")
تأكد_يساوي(أقل_عملات([1], 0), 0, "صفر")
