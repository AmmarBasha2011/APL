# مثال 3267 — صف جدول ضرب 16
# Multiplication row of 16
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3267-multiplication-table-row-of-16.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 16]
  ارجع ر

تأكد_يساوي(ف(1), [16], "حالة 1")
تأكد_يساوي(ف(5), [16, 32, 48, 64, 80], "حالة 2")
تأكد_يساوي(ف(10), [16, 32, 48, 64, 80, 96, 112, 128, 144, 160], "حالة 3")
