# مثال 3643 — ربط أول 2 أحرف بنقاط
# Join first 2 chars with dots
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3643-join-first-2-chars-with-dots.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ".".join(ن[:2])

تأكد_يساوي(ف("hello"), "h.e", "حالة 1")
تأكد_يساوي(ف("ab"), "a.b", "حالة 2")
تأكد_يساوي(ف("abcdefghijklmn"), "a.b", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
