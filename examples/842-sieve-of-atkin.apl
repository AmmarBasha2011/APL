# مثال 842 — غربال أتكن
# Sieve of Atkin
# Demonstrates: معادلات تربيعية modulo 60
#
# Run:  python apl.py examples/842-sieve-of-atkin.apl

# غربال أتكن: غربال أولي حديث يعتمد معادلات تربيعية modulo 60
# أسرع نظرياً من غربال إراتوستينس للنطاقات الكبيرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة غربال_أتكن(حد):
  مرشح = []
  لكل _ في نطاق(حد + 1):
    مرشح.ألحق(خطأ)
  لو حد > 2:
    مرشح[2] = 1 == 1
  لو حد > 3:
    مرشح[3] = 1 == 1
  لو حد > 5:
    مرشح[5] = 1 == 1
  لكل س في نطاق(1, حد + 1):
    س2 = س * س
    # أقصى س نافع: الحالة الثالثة تحتاج 2س²+2س-1 <= حد (عند ص=س-1)
    لو 2 * س2 + 2 * س - 1 <= حد:
      لكل ص في نطاق(1, حد + 1):
        ص2 = ص * ص
        # ن = 4س² + ص²
        ن = 4 * س2 + ص2
        لو ن <= حد:
          باقي = ن % 60
          لو باقي == 1 أو باقي == 13 أو باقي == 17 أو باقي == 29 أو باقي == 37 أو باقي == 41 أو باقي == 49 أو باقي == 53:
            مرشح[ن] = ليس مرشح[ن]
        # ن = 3س² + ص²
        ن = 3 * س2 + ص2
        لو ن <= حد:
          باقي = ن % 60
          لو باقي == 7 أو باقي == 19 أو باقي == 31 أو باقي == 43:
            مرشح[ن] = ليس مرشح[ن]
        # ن = 3س² - ص² (فقط عندما س > ص)
        لو س > ص:
          ن = 3 * س2 - ص2
          لو ن <= حد:
            باقي = ن % 60
            لو باقي == 11 أو باقي == 23 أو باقي == 47 أو باقي == 59:
              مرشح[ن] = ليس مرشح[ن]
  # إلغاء مربعات الأولية
  أولية = []
  لكل ن في نطاق(6, حد + 1):
    لو مرشح[ن]:
      أولية.ألحق(ن)
      مربع = ن * ن
      مضاعف = مربع
      طالما مضاعف <= حد:
        مرشح[مضاعف] = خطأ
        مضاعف = مضاعف + مربع
  نتيجة = []
  لو حد >= 2:
    نتيجة.ألحق(2)
  لو حد >= 3:
    نتيجة.ألحق(3)
  لو حد >= 5:
    نتيجة.ألحق(5)
  لكل ن في أولية:
    لو مرشح[ن]:
      نتيجة.ألحق(ن)
  ارجع نتيجة

أولية100 = غربال_أتكن(100)
اطبع "أولية حتى 100:", أولية100

تأكد_يساوي(طول(أولية100), 25, "عدد الأولية حتى 100 هو 25")
تأكد_يساوي(أولية100[0], 2, "أول أولي")
تأكد_يساوي(أولية100[24], 97, "آخر أولي قبل 100")
تأكد_يساوي(أولية100[8], 23, "الأولي التاسع")
تأكد_يساوي(أولية100[13], 43, "الأولي الرابع عشر")
