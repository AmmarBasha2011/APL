# مثال 3782 — مجموع زوايا مضلع زائد 20
# Polygon angle sum plus 20
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3782-interior-angle-sum-of-polygon-plus-20.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 20

تأكد_يساوي(ف(3), 200, "حالة 1")
تأكد_يساوي(ف(4), 380, "حالة 2")
تأكد_يساوي(ف(5), 560, "حالة 3")
تأكد_يساوي(ف(6), 740, "حالة 4")
تأكد_يساوي(ف(12), 1820, "حالة 5")
