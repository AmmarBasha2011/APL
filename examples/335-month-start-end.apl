# مثال 335 — أول وآخر يوم في الشهر
# Month start and end
# Demonstrates: التنقل بين الشهور
#
# Run:  python apl.py examples/335-month-start-end.apl

المتغير اليوم = التاريخ_اليوم()
المتغير أول_الشهر = تاريخ(اليوم.year, اليوم.month, 1)
لو اليوم.month == 12:
    المتغير أول_التالي = تاريخ(اليوم.year + 1, 1, 1)
الا:
    المتغير أول_التالي = تاريخ(اليوم.year, اليوم.month + 1, 1)
المتغير آخر_الشهر = أول_التالي - مدة(أيام=1)

اطبع "أول الشهر:", أول_الشهر
اطبع "آخر الشهر:", آخر_الشهر
اطبع "عدد أيامه:", آخر_الشهر.day
