# مثال 2328 — ترتيب الحروف تنازليا
# Letters descending
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2328-string-sorted-letters-descending.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = sorted(ن)
  ق.reverse()
  ارجع "".join(ق)

تأكد_يساوي(ف("abc"), "cba", "حالة 1")
تأكد_يساوي(ف("hello"), "ollhe", "حالة 2")
تأكد_يساوي(ف("zxy"), "zyx", "حالة 3")
تأكد_يساوي(ف("banana"), "nnbaaa", "حالة 4")
