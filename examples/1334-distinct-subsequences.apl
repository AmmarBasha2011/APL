# مثال 1334 — متتاليات مميزة
# Distinct subsequences count
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1334-distinct-subsequences.apl

# نعد الطرق لكل بادئة من الهدف
# كل حرف مطابق يضيف طرق ما قبله

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة طرق_المتتالية(مصدر, هدف):
  ن = طول(هدف)
  طرق = [0] * (ن + 1)
  طرق[0] = 1
  لكل ح في مصدر:
    لكل ع في نطاق(ن, 0, -1):
      لو هدف[ع - 1] == ح:
        طرق[ع] = طرق[ع] + طرق[ع - 1]
  ارجع طرق[ن]

تأكد_يساوي(طرق_المتتالية("rabbbit", "rabbit"), 3, "ثلاث طرق")
تأكد_يساوي(طرق_المتتالية("babgbag", "bag"), 5, "خمس طرق")
تأكد_يساوي(طرق_المتتالية("abc", "d"), 0, "لا طرق")
