# مثال 167 — تعديل مستند XML
# Modifying an XML document
# Demonstrates: تضيف، تحذف، عين_خاصية، إكس_إم_إل_إلى_نص
#
# Run:  python apl.py examples/167-xml-modify.apl

المتغير جذر = إكس_إم_إل_من_نص("<مهام><مهمة>الأولى</مهمة><مهمة>الثانية</مهمة></مهام>")

المتغير جديدة = عنصر_جديد("مهمة")
غذِّ_نص_العنصر(جديدة, "الثالثة")
عين_خاصية(جديدة, "أولوية", "عالية")
تضيف(جذر, جديدة)

اطبع "قبل الحذف:", طول(تجد_الكل(جذر, "مهمة"))
المتغير أولى = تجد(جذر, "مهمة")
تحذف(جذر, أولى)
اطبع "بعد حذف الأولى:", طول(تجد_الكل(جذر, "مهمة"))
اطبع إكس_إم_إل_إلى_نص(جذر)
