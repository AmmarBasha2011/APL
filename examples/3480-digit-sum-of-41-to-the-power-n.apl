# مثال 3480 — مجموع أرقام 41 أس ن
# Digit sum of 41 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3480-digit-sum-of-41-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 41 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 5, "حالة 2")
تأكد_يساوي(ف(5), 29, "حالة 3")
تأكد_يساوي(ف(10), 49, "حالة 4")
تأكد_يساوي(ف(20), 142, "حالة 5")
