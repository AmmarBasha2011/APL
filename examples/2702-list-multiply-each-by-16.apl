# مثال 2702 — ضرب كل عنصر في 16
# Multiply each item by 16
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2702-list-multiply-each-by-16.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 16]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [48, 16, 32], "حالة 1")
تأكد_يساوي(ف([5]), [80], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [16, 32, 48, 64, 80, 96], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-32, 0, 112, 112, 64], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [160, 320, 160, 480, 320, 160], "حالة 5")
