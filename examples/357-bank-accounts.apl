# مثال 357 — حسابات بنكية متعددة
# Multiple bank accounts
# Demonstrates: تحويل بين الحسابات
#
# Run:  python apl.py examples/357-bank-accounts.apl

صنف حساب_بنكي:
    دالة_إنشاء(ذات, مالك, رصيد):
        ذات.مالك = مالك
        ذات.رصيد = رصيد

    دالة حول_إلى(ذات, آخر, مبلغ):
        لو مبلغ > ذات.رصيد:
            اطبع "فشل التحويل: رصيد", ذات.مالك, "غير كاف"
            ارجع خطأ
        ذات.رصيد = ذات.رصيد - مبلغ
        آخر.رصيد = آخر.رصيد + مبلغ
        ارجع صواب

    دالة اطبع_رصيد(ذات):
        اطبع ذات.مالك, ":", ذات.رصيد

المتغير أ = حساب_بنكي("أحمد", 1000)
المتغير ب = حساب_بنكي("سارة", 500)
أ.حول_إلى(ب, 300)
أ.اطبع_رصيد()
ب.اطبع_رصيد()
أ.حول_إلى(ب, 10000)
