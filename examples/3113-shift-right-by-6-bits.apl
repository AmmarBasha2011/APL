# مثال 3113 — إزاحة يمين 6
# Shift right by 6
# Demonstrates: بتات
#
# Run:  python apl.py examples/3113-shift-right-by-6-bits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 6

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(16), 0, "حالة 2")
تأكد_يساوي(ف(255), 3, "حالة 3")
تأكد_يساوي(ف(1000), 15, "حالة 4")
تأكد_يساوي(ف(65535), 1023, "حالة 5")
