# مثال 3662 — ضرب كل عنصر في 47
# Multiply each item by 47
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3662-list-multiply-each-by-47.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 47]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [141, 47, 94], "حالة 1")
تأكد_يساوي(ف([5]), [235], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [47, 94, 141, 188, 235, 282], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-94, 0, 329, 329, 188], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [470, 940, 470, 1410, 940, 470], "حالة 5")
