# مثال 623 — نقطة داخل مضلع
# Point in polygon
# Demonstrates: شعاع، تكافؤ، مضلع
#
# Run:  python apl.py examples/623-point-in-polygon.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# نقطة داخل مضلع؟ قذف شعاع أفقي
# Demonstrates: تقاطع شعاع مع أضلاع, تكافؤ عدد التقاطعات
# عدد فردي من التقاطعات يعني أن النقطة بالداخل

دالة داخل(نقطة, مضلع):
  س = نقطة[0]
  ص = نقطة[1]
  تقاطعات = 0
  ن = طول(مضلع)
  لكل ي في نطاق(ن):
    أ = مضلع[ي]
    ب = مضلع[(ي + 1) % ن]
    لو (أ[1] > ص) != (ب[1] > ص):
      س_تقاطع = أ[0] + (ص - أ[1]) * (ب[0] - أ[0]) / (ب[1] - أ[1])
      لو س < س_تقاطع:
        تقاطعات = تقاطعات + 1
  ارجع تقاطعات % 2 == 1

مربع = [[0, 0], [10, 0], [10, 10], [0, 10]]
تأكد_يساوي(داخل([5, 5], مربع), صواب, "المنتصف داخل")
تأكد_يساوي(داخل([15, 5], مربع), خطأ, "خارج يمينا")
تأكد_يساوي(داخل([5, 15], مربع), خطأ, "خارج أعلى")
مثلث = [[0, 0], [10, 0], [5, 10]]
تأكد_يساوي(داخل([5, 3], مثلث), صواب, "داخل مثلث")
تأكد_يساوي(داخل([1, 9], مثلث), خطأ, "خارج مثلث")
اطبع "اختبار (5,5) في مربع:", داخل([5, 5], مربع)
