# مثال 2115 — الأولي المعكوس
# Emirp check v2
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/2115-emirp-prime-whose-reverse-is-prime.apl

# # المتماثلات مثل 11 مستبعدة
# # 13 و31 مثال

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  د = 2
  طالما د * د <= ن:
    لو ن % د == 0:
      ارجع خطأ
    د = د + 1
  ارجع صواب

دالة ايمرب(ن):
  م = int(نص(ن)[::-1])
  ارجع اولي(ن) و اولي(م) و م != ن

تأكد_يساوي(ايمرب(13), صواب, "١٣")
تأكد_يساوي(ايمرب(11), خطأ, "١١")
تأكد_يساوي(ايمرب(17), صواب, "١٧")
تأكد_يساوي(ايمرب(23), خطأ, "٢٣")
تأكد_يساوي(ايمرب(2), خطأ, "٢")
