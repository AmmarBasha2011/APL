# مثال 1663 — هل العدد خالٍ من المربعات
# Square free number check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1663-square-free-check.apl

# نجرب القسمة على ك تربيعاً
# إن انقسم فليس خالياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة خالٍ_من_المربعات(ن):
  ك = 2
  طالما ك * ك <= ن:
    لو ن % (ك * ك) == 0:
      ارجع خطأ
    ك = ك + 1
  ارجع صواب

تأكد_يساوي(خالٍ_من_المربعات(10), صواب, "عشرة")
تأكد_يساوي(خالٍ_من_المربعات(12), خطأ, "اثنا عشر")
تأكد_يساوي(خالٍ_من_المربعات(30), صواب, "ثلاثون")
تأكد_يساوي(خالٍ_من_المربعات(50), خطأ, "خمسون")
