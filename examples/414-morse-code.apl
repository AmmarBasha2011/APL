# مثال 414 — شيفرة مورس
# Morse code
# Demonstrates: قاموس حروف وترميز
#
# Run:  python apl.py examples/414-morse-code.apl

المتغير مورس = {
    "A": ".-", "B": "-...", "C": "-.-.", "D": "-..", "E": ".",
    "S": "...", "O": "---", "L": ".-..", "P": ".--.", "T": "-"
}

دالة إلى_مورس(نص_الدخل):
    المتغير ناتج = []
    لكل حرف in نص_الدخل:
        لو حرف == " ":
            ناتج.append("/")
        الا لو مورس.get(حرف) != لا_شيء:
            ناتج.append(مورس[حرف])
    ارجع " ".ضم(ناتج)

اطبع إلى_مورس("SOS")
اطبع إلى_مورس("APL")
