# مثال 1154 — مجموع ثلاثة
# Three sum
# Demonstrates: ترتيب ومؤشران
#
# Run:  python apl.py examples/1154-three-sum.apl

# نرتب القائمة ونثبت عنصراً
# ثم نبحث عن الزوج المكمل بمؤشرين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ثلاثيات(أ):
  ق = مفرز(أ)
  ناتج = []
  لكل ع في نطاق(طول(ق) - 2):
    مكرر = خطأ
    لو ع > 0:
      مكرر = ق[ع] == ق[ع - 1]
    ي = ع + 1
    ن = طول(ق) - 1
    لو مكرر:
      ي = ن
    طالما ي < ن:
      مج = ق[ع] + ق[ي] + ق[ن]
      لو مج == 0:
        ناتج.ألحق([ق[ع], ق[ي], ق[ن]])
        ي = ي + 1
        طالما (ي < ن) و (ق[ي] == ق[ي - 1]):
          ي = ي + 1
      والا_لو مج < 0:
        ي = ي + 1
      والا:
        ن = ن - 1
  ارجع ناتج

تأكد_يساوي(ثلاثيات([-1,0,1,2,-1,-4]), [[-1,-1,2],[-1,0,1]], "مثال أول")
تأكد_يساوي(ثلاثيات([0,1,1]), [], "لا حل")
تأكد_يساوي(ثلاثيات([0,0,0,0]), [[0,0,0]], "أصفار")
