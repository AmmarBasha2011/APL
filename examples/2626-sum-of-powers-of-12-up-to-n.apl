# مثال 2626 — مجموع قوى 12
# Sum of powers of 12
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2626-sum-of-powers-of-12-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 12 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 13, "حالة 2")
تأكد_يساوي(ف(3), 1885, "حالة 3")
تأكد_يساوي(ف(6), 3257437, "حالة 4")
تأكد_يساوي(ف(10), 67546215517, "حالة 5")
