# مثال 2325 — سداسي عشري إلى عشري
# Hex string to decimal
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2325-hex-string-to-decimal-manual.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = "0123456789abcdef"
  ق = 0
  لكل ح في ن.lower():
    ق = ق * 16 + ر.find(ح)
  ارجع ق

تأكد_يساوي(ف("0"), 0, "حالة 1")
تأكد_يساوي(ف("a"), 10, "حالة 2")
تأكد_يساوي(ف("ff"), 255, "حالة 3")
تأكد_يساوي(ف("FF"), 255, "حالة 4")
تأكد_يساوي(ف("1a2b"), 6699, "حالة 5")
