# مثال 69 — بناء بريد إلكتروني (مكتبة web)
# Building and inspecting email messages (email.message / email.mime)
#
# Run:  python apl.py examples/69-web-email-build.apl

اطبع "=== رسالة MIME نصية ==="
المتغير نص_رسالة = نص_بريد_2("نص عربي مع همزات", "utf-8")
اطبع "النوع:", نص_رسالة.MIME_نص_احصل_محتوى_نوع()
اطبع "الحمولة:", نص_رسالة.MIME_نص_احصل_حمولة()

اطبع ""
اطبع "=== إخراج الرسالة نصاً ==="
المتغير نص = نص_رسالة.MIME_نص_كـ_نص()
اطبع "طول النص:", طول(نص)

اطبع ""
اطبع "=== رسالة كاملة ==="
المتغير رسالة = رسالة_بريد_كاملة()
رسالة.بريد_رسالة_عيّن_محتوى("مرحباً من مكتبة الويب")
اطبع "المحتوى:", رسالة.بريد_رسالة_احصل_محتوى()
اطبع "عدد عناصر الترويسة:", طول(رسالة.بريد_رسالة_عناصر())
