# مثال 3534 — مجموع الأعداد من 25 إلى ن
# Sum from 25 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3534-sum-of-integers-from-25-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(25, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(25), 25, "حالة 1")
تأكد_يساوي(ف(26), 51, "حالة 2")
تأكد_يساوي(ف(35), 330, "حالة 3")
تأكد_يساوي(ف(100), 4750, "حالة 4")
