# مثال 2933 — مجموع زوايا مضلع زائد 1
# Polygon angle sum plus 1
# Demonstrates: هندسة
#
# Run:  python apl.py examples/2933-interior-angle-sum-of-polygon-plus-1.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 1

تأكد_يساوي(ف(3), 181, "حالة 1")
تأكد_يساوي(ف(4), 361, "حالة 2")
تأكد_يساوي(ف(5), 541, "حالة 3")
تأكد_يساوي(ف(6), 721, "حالة 4")
تأكد_يساوي(ف(12), 1801, "حالة 5")
