# مثال 1463 — من الثواني إلى ساعة:دقيقة:ثانية
# Seconds to hh:mm:ss
# Demonstrates: وقت
#
# Run:  python apl.py examples/1463-seconds-to-clock.apl

# نقسم على 3600 ثم 60
# نضيف صفراً لكل رقم أقل من عشرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رقمين(ن):
  لو ن < 10:
    ارجع "0" + نص(ن)
  ارجع نص(ن)

دالة كساعة(ث):
  س = ث // 3600
  د = (ث % 3600) // 60
  ثا = ث % 60
  ارجع رقمين(س) + ":" + رقمين(د) + ":" + رقمين(ثا)

تأكد_يساوي(كساعة(0), "00:00:00", "صفر")
تأكد_يساوي(كساعة(3661), "01:01:01", "ساعة ودقيقة وثانية")
تأكد_يساوي(كساعة(86399), "23:59:59", "آخر اليوم")
