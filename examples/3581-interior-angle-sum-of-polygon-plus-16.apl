# مثال 3581 — مجموع زوايا مضلع زائد 16
# Polygon angle sum plus 16
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3581-interior-angle-sum-of-polygon-plus-16.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 16

تأكد_يساوي(ف(3), 196, "حالة 1")
تأكد_يساوي(ف(4), 376, "حالة 2")
تأكد_يساوي(ف(5), 556, "حالة 3")
تأكد_يساوي(ف(6), 736, "حالة 4")
تأكد_يساوي(ف(12), 1816, "حالة 5")
