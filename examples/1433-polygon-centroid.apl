# مثال 1433 — مركز ثقل مضلع
# Polygon centroid by shoelace
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1433-polygon-centroid.apl

# نحسب المساحة الموقعة
# ثم متوسط الإحداثيات موزوناً بالضرب التقاطعي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مركز_الثقل(نقاط):
  ن = طول(نقاط)
  مساحة = 0
  مس = 0
  مص = 0
  لكل ع في نطاق(ن):
    أ = نقاط[ع]
    ب = نقاط[(ع + 1) % ن]
    ض = أ[0] * ب[1] - ب[0] * أ[1]
    مساحة = مساحة + ض
    مس = مس + (أ[0] + ب[0]) * ض
    مص = مص + (أ[1] + ب[1]) * ض
  مساحة = مساحة / 2
  ارجع [مس / (6 * مساحة), مص / (6 * مساحة)]

تأكد_يساوي(مركز_الثقل([[0,0],[4,0],[4,4],[0,4]]), [2.0, 2.0], "مربع")
تأكد_يساوي(مركز_الثقل([[0,0],[6,0],[0,3]]), [2.0, 1.0], "مثلث")
