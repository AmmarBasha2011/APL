# مثال 2578 — إضافة 14 لكل عنصر
# Add 14 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2578-list-add-14-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 14]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [17, 15, 16], "حالة 1")
تأكد_يساوي(ف([5]), [19], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [15, 16, 17, 18, 19, 20], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [12, 14, 21, 21, 18], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [24, 34, 24, 44, 34, 24], "حالة 5")
