# مثال 1339 — مسار أقل جهد
# Path with minimum effort
# Demonstrates: رسوم بيانية
#
# Run:  python apl.py examples/1339-path-min-effort.apl

# نبحث ثنائياً عن الجهد الأقصى
# ونختبر الوصول بالبحث بالعمق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يصل_بجهد(ش, حد):
  ر_ = طول(ش)
  ك_ = طول(ش[0])
  مرئي = []
  لكل ع في نطاق(ر_):
    مرئي.ألحق([خطأ] * ك_)
  مكدس = [[0, 0]]
  مرئي[0][0] = صواب
  طالما طول(مكدس) > 0:
    ن = مكدس.pop()
    لو (ن[0] == ر_ - 1) و (ن[1] == ك_ - 1):
      ارجع صواب
    لكل د في [[1,0],[-1,0],[0,1],[0,-1]]:
      ص = ن[0] + د[0]
      ج = ن[1] + د[1]
      لو (ص >= 0) و (ص < ر_) و (ج >= 0) و (ج < ك_):
        لو ليس مرئي[ص][ج]:
          ف = ش[ص][ج] - ش[ن[0]][ن[1]]
          لو ف < 0:
            ف = -ف
          لو ف <= حد:
            مرئي[ص][ج] = صواب
            مكدس.ألحق([ص, ج])
  ارجع خطأ

دالة اقل_جهد(ش):
  ادنى = 0
  اعلى = 1000000
  طالما ادنى < اعلى:
    وسط = (ادنى + اعلى) // 2
    لو يصل_بجهد(ش, وسط):
      اعلى = وسط
    والا:
      ادنى = وسط + 1
  ارجع ادنى

تأكد_يساوي(اقل_جهد([[1,2,2],[3,8,2],[5,3,5]]), 2, "جهد اثنان")
تأكد_يساوي(اقل_جهد([[1,2,3],[3,8,4],[5,3,5]]), 1, "جهد واحد")
تأكد_يساوي(اقل_جهد([[7]]), 0, "خلية")
