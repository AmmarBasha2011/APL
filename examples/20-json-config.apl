# مثال 20 — قراءة وكتابة إعدادات JSON
# JSON Config Reader/Writer
# Demonstrates: json library, file I/O, nested dict access
#
# Run:  python apl.py examples/20-json-config.apl

المتغير المسار = "_apl_config.json"
المتغير الإعدادات = {
    "الاسم": "تطبيقي",
    "الإصدار": "1.0",
    "قاعدة_البيانات": {"المضيف": "localhost", "المنفذ": 5432, "الاسم": "myapp"},
    "المميزات": ["تسجيل_الدخول", "لوحة_تحكم", "تقارير"],
    "مفعّل": صواب
}

اطبع "=== إعدادات JSON ==="
اطبع ""
اكتب(المسار, جسون_تحويل(الإعدادات))
اطبع "تم الكتابة إلى: " + المسار
اطبع ""
المتغير المقروء = اقرأ_ملف_جسون(المسار)
اطبع "--- ما قُرئ من الملف ---"
اطبع "الاسم: " + المقروء["الاسم"]
اطبع "الإصدار: " + المقروء["الإصدار"]
اطبع "المضيف: " + المقروء["قاعدة_البيانات"]["المضيف"]
اطبع "المنفذ: " + نص(المقروء["قاعدة_البيانات"]["المنفذ"])
اطبع "عدد المميزات: " + نص(طول(المقروء["المميزات"]))
اطبع "مفعّل: " + نص(المقروء["مفعّل"])
اطبع ""
اطبع "--- تعديل ثم كتابة ---"
المقروء["الإصدار"] = "2.0"
اكتب(المسار, جسون_تحويل(المقروء))
اطبع "الإصدار الجديد: " + اقرأ_ملف_جسون(المسار)["الإصدار"]
اطبع ""
اطبع "حجم الملف: " + نص(طول(اقرأ(المسار))) + " حرف"
احذف_ملف(المسار)
اطبع "تم حذف الملف"
