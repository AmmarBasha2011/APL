# مثال 352 — أعداد مركبة يدويا
# Manual complex numbers
# Demonstrates: جمع وضرب الأعداد المركبة
#
# Run:  python apl.py examples/352-complex-manual.apl

صنف مركب:
    دالة_إنشاء(ذات, جزء_حقيقي, جزء_تخيلي):
        ذات.جزء_حقيقي = جزء_حقيقي
        ذات.جزء_تخيلي = جزء_تخيلي

    دالة اجمع(ذات, آخر):
        ارجع مركب(ذات.جزء_حقيقي + آخر.جزء_حقيقي, ذات.جزء_تخيلي + آخر.جزء_تخيلي)

    دالة اضرب(ذات, آخر):
        المتغير ح = ذات.جزء_حقيقي * آخر.جزء_حقيقي - ذات.جزء_تخيلي * آخر.جزء_تخيلي
        المتغير ت = ذات.جزء_حقيقي * آخر.جزء_تخيلي + ذات.جزء_تخيلي * آخر.جزء_حقيقي
        ارجع مركب(ح, ت)

    دالة كنص(ذات):
        لو ذات.جزء_تخيلي >= 0:
            ارجع نص(ذات.جزء_حقيقي) + "+" + نص(ذات.جزء_تخيلي) + "i"
        ارجع نص(ذات.جزء_حقيقي) + نص(ذات.جزء_تخيلي) + "i"

المتغير أ = مركب(2, 3)
المتغير ب = مركب(1, -1)
اطبع "أ + ب =", أ.اجمع(ب).كنص()
اطبع "أ × ب =", أ.اضرب(ب).كنص()
