# مثال 1189 — درجة الأقواس
# Score of parentheses
# Demonstrates: مكدس
#
# Run:  python apl.py examples/1189-score-of-parentheses.apl

# الزوج المتجاور بواحد
# والمتداخل بضعف ما بداخله

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة درجة(س):
  مكدس = [0]
  لكل ح في س:
    لو ح == "(":
      مكدس.ألحق(0)
    والا:
      داخل = مكدس.pop()
      قيمة = 1
      لو داخل > 0:
        قيمة = 2 * داخل
      مكدس[-1] = مكدس[-1] + قيمة
  ارجع مكدس[0]

تأكد_يساوي(درجة("()"), 1, "زوج")
تأكد_يساوي(درجة("(())"), 2, "متداخل")
تأكد_يساوي(درجة("()()"), 2, "متجاور")
تأكد_يساوي(درجة("(()(()))"), 6, "مختلط")
