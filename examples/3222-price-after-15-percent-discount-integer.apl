# مثال 3222 — السعر بعد خصم 15 بالمئة
# Price after 15 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3222-price-after-15-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 15 // 100

تأكد_يساوي(ف(100), 85, "حالة 1")
تأكد_يساوي(ف(250), 213, "حالة 2")
تأكد_يساوي(ف(999), 850, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
