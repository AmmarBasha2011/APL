# مثال 597 — الجسور ونقاط الارتكاز
# Bridges and articulation points
# Demonstrates: جسور، نقاط ارتكاز، DFS بأزمنة دخول
#
# Run:  python apl.py examples/597-bridges-articulation.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الجسور ونقاط الارتكاز في رسم غير موجه
# Demonstrates: DFS بأزمنة دخول, قيم دنيا, كشف الحواف الحرجة
# حذف جسر أو نقطة ارتكاز يفصل الرسم إلى قسمين

جوار = {0: [1], 1: [0, 2, 3], 2: [1], 3: [1, 4], 4: [3]}
ن = 5
دخول = [-1] * ن
أدنى = [-1] * ن
جسور = []
ارتكاز = []
عداد = [0]

دالة غاص(عقدة, أب):
  دخول[عقدة] = عداد[0]
  أدنى[عقدة] = عداد[0]
  عداد[0] = عداد[0] + 1
  أبناء = 0
  هو_ارتكاز = خطأ
  لكل جار في جوار[عقدة]:
    لو جار != أب:
      لو دخول[جار] != -1:
        أدنى[عقدة] = أصغر(أدنى[عقدة], دخول[جار])
      والا:
        غاص(جار, عقدة)
        أدنى[عقدة] = أصغر(أدنى[عقدة], أدنى[جار])
        لو أدنى[جار] > دخول[عقدة]:
          جسور.append([عقدة, جار])
        لو أدنى[جار] >= دخول[عقدة] و أب != -1:
          هو_ارتكاز = صواب
        أبناء = أبناء + 1
  لو أب == -1 و أبناء > 1:
    هو_ارتكاز = صواب
  لو هو_ارتكاز:
    ارتكاز.append(عقدة)

غاص(0, -1)
اطبع "الجسور:", جسور
اطبع "نقاط الارتكاز:", ارتكاز
جسور.sort()
تأكد_يساوي(جسور, [[0, 1], [1, 2], [1, 3], [3, 4]], "أربعة جسور (شجرة)")
ارتكاز.sort()
تأكد_يساوي(ارتكاز, [1, 3], "نقطتا ارتكاز")
