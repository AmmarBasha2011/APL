# مثال 2622 — الحد النوني بخطوة 13
# Nth term step 13
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2622-nth-term-arithmetic-sequence-step-13.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 13

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 16, "حالة 2")
تأكد_يساوي(ف(10), 120, "حالة 3")
تأكد_يساوي(ف(100), 1290, "حالة 4")
