# مثال 3375 — السعر بعد خصم 24 بالمئة
# Price after 24 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3375-price-after-24-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 24 // 100

تأكد_يساوي(ف(100), 76, "حالة 1")
تأكد_يساوي(ف(250), 190, "حالة 2")
تأكد_يساوي(ف(999), 760, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
