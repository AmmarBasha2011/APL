# مثال 2907 — قيصر بإزاحة 22
# Caesar shift 22
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2907-caesar-shift-by-22-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 22) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "wxy", "حالة 1")
تأكد_يساوي(ف("xyz"), "tuv", "حالة 2")
تأكد_يساوي(ف("hello world"), "dahhk sknhz", "حالة 3")
تأكد_يساوي(ف("a1"), "w1", "حالة 4")
