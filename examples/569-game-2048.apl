# مثال 569 — منطق لعبة 2048
# 2048 merge logic
# Demonstrates: 2048، دمج صفوف، انزلاق
#
# Run:  python apl.py examples/569-game-2048.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# منطق دمج 2048: انزلاق ودمج صف
دالة دمج_صف(صف):
    المتغير مضغوط = [خ for خ في صف لو خ != 0]
    المتغير ناتج = قائمة()
    المتغير نقاط = 0
    المتغير i = 0
    طالما i < طول(مضغوط):
        لو i + 1 < طول(مضغوط) و مضغوط[i] == مضغوط[i + 1]:
            ناتج.أضف(مضغوط[i] * 2)
            نقاط = نقاط + مضغوط[i] * 2
            i = i + 2
        الا:
            ناتج.أضف(مضغوط[i])
            i = i + 1
    طالما طول(ناتج) < طول(صف):
        ناتج.أضف(0)
    ارجع [ناتج, نقاط]

دالة حرك_يسار(لوحة):
    المتغير جديدة = قائمة()
    المتغير إجمالي = 0
    لكل صف في لوحة:
        المتغير نتيجة = دمج_صف(صف)
        جديدة.أضف(نتيجة[0])
        إجمالي = إجمالي + نتيجة[1]
    ارجع [جديدة, إجمالي]

تأكد_يساوي(دمج_صف([2, 2, 4, 4])[0], [4, 8, 0, 0], "دمج مزدوج")
تأكد_يساوي(دمج_صف([2, 2, 2, 0])[0], [4, 2, 0, 0], "ثلاثة متشابهة")
تأكد_يساوي(دمج_صف([4, 0, 4, 8])[0], [8, 8, 0, 0], "انزلاق ثم دمج")
تأكد_يساوي(دمج_صف([2, 2, 4, 4])[1], 12, "النقاط")
المتغير لوحة = [[2, 2, 0, 0], [4, 4, 4, 4], [0, 0, 2, 2], [2, 4, 8, 16]]
تأكد_يساوي(حرك_يسار(لوحة)[1], 24, "نقاط الحركة")
