# مثال 3993 — مجموع المربعات من 21 إلى ن
# Sum of squares from 21
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3993-sum-of-squares-from-21-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(21, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(21), 441, "حالة 1")
تأكد_يساوي(ف(22), 925, "حالة 2")
تأكد_يساوي(ف(31), 7546, "حالة 3")
تأكد_يساوي(ف(100), 335480, "حالة 4")
