# مثال 860 — بحث بوير-مور
# Boyer-Moore search
# Demonstrates: قاعدة الحرف السيئ، مقارنة معكوسة
#
# Run:  python apl.py examples/860-boyer-moore-search.apl

# بوير-مور: بحث نمط بقاعدة الحرف السيئ، يقفز أكثر من موضع
# على عكس KMP يقارن النمط من نهايته لبدايته

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة آخر_موضع(نمط, حرف):
  آخر = -1
  لكل i في نطاق(طول(نمط)):
    لو نمط[i] == حرف:
      آخر = i
  ارجع آخر

دالة بحث_بوير_مور(نص, نمط):
  مواضع = []
  ط_نمط = طول(نمط)
  i = 0
  طالما i <= طول(نص) - ط_نمط:
    ج = ط_نمط - 1
    طالما ج >= 0 و نمط[ج] == نص[i + ج]:
      ج = ج - 1
    لو ج < 0:
      مواضع.ألحق(i)
      i = i + 1
    والا:
      قفزة = ج - آخر_موضع(نمط, نص[i + ج])
      لو قفزة < 1:
        قفزة = 1
      i = i + قفزة
  ارجع مواضع

نص = "GCATCGCAGAGAGTATACAGTACG"
مواضع = بحث_بوير_مور(نص, "GCAG")
اطبع "مواضع GCAG:", مواضع

تأكد_يساوي(طول(مواضع), 1, "تطابق واحد")
تأكد_يساوي(مواضع[0], 5, "في الموضع 5")

# نمط متكرر: aab في aabaaabaaab يظهر في 0 و4 و8
مواضع2 = بحث_بوير_مور("aabaaabaaab", "aab")
اطبع "مواضع aab:", مواضع2
تأكد_يساوي(طول(مواضع2), 3, "ثلاثة تطابقات")
تأكد_يساوي(مواضع2[0], 0, "الأول")
تأكد_يساوي(مواضع2[1], 4, "الثاني")
تأكد_يساوي(مواضع2[2], 8, "الثالث")

# لا تطابق
تأكد_يساوي(طول(بحث_بوير_مور("abcabc", "xyz")), 0, "لا تطابق")
