# مثال 130 — أيام الأسبوع وعطلات نهاية الأسبوع
# Weekdays and weekends
# Demonstrates: تاريخ، مدة، weekday
#
# Run:  python apl.py examples/130-datetime-weekday.apl

المتغير أيام = ["الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت", "الأحد"]
المتغير اليوم = التاريخ_اليوم()
اطبع "اليوم هو:", أيام[اليوم.weekday()]

اطبع ""
اطبع "أيام العمل السبعة القادمة:"
المتغير ت = اليوم
المتغير عدد = 0
طالما عدد < 7:
    ت = ت + مدة(أيام=1)
    لو ت.weekday() < 5:
        اطبع ت, "-", أيام[ت.weekday()]
        عدد = عدد + 1
