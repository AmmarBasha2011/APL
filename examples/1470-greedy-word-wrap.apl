# مثال 1470 — التفاف الكلمات في أسطر
# Greedy word wrap
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1470-greedy-word-wrap.apl

# نضيف كلمة للسطر الحالي إن كفى العرض
# وإلا نبدأ سطراً جديداً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة التفاف(كلمات, عرض):
  أسطر = []
  سطر = ""
  لكل ك في كلمات:
    لو سطر == "":
      سطر = ك
    والا_لو طول(سطر) + 1 + طول(ك) <= عرض:
      سطر = سطر + " " + ك
    والا:
      أسطر.append(سطر)
      سطر = ك
  لو سطر != "":
    أسطر.append(سطر)
  ارجع أسطر

تأكد_يساوي(التفاف(["aa", "bb", "cc", "dd"], 5), ["aa bb", "cc dd"], "سطران")
تأكد_يساوي(التفاف(["abcdef"], 3), ["abcdef"], "كلمة طويلة")
تأكد_يساوي(التفاف([], 5), [], "فارغ")
