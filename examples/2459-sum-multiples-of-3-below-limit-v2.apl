# مثال 2459 — مجموع مضاعفات 3 تحت حد
# Sum of multiples of 3 below limit
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2459-sum-multiples-of-3-below-limit-v2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(0, ن, 3):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(7), 9, "حالة 2")
تأكد_يساوي(ف(12), 18, "حالة 3")
تأكد_يساوي(ف(50), 408, "حالة 4")
تأكد_يساوي(ف(100), 1683, "حالة 5")
