# مثال 2398 — صنف موقف سيارات
# Parking lot class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2398-class-parking-lot-capacity-park-leave.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف موقف:
    دالة_إنشاء(ذات, س):
        ذات.س = س
        ذات.ع = 0

    دالة ادخل(ذات):
        لو ذات.ع >= ذات.س:
            ارجع خطأ
        ذات.ع = ذات.ع + 1
        ارجع صواب

    دالة اخرج(ذات):
        لو ذات.ع > 0:
            ذات.ع = ذات.ع - 1

م = موقف(2)
تأكد_يساوي(م.ادخل(), صواب, "الأولى")
تأكد_يساوي(م.ادخل(), صواب, "الثانية")
تأكد_يساوي(م.ادخل(), خطأ, "ممتلئ")
م.اخرج()
تأكد_يساوي(م.ادخل(), صواب, "بعد الخروج")
