# مثال 2980 — إضافة 25 لكل عنصر
# Add 25 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2980-list-add-25-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 25]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [28, 26, 27], "حالة 1")
تأكد_يساوي(ف([5]), [30], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [26, 27, 28, 29, 30, 31], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [23, 25, 32, 32, 29], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [35, 45, 35, 55, 45, 35], "حالة 5")
