# مثال 2217 — عدد بتات الواحد في النص
# Total one bits of text
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2217-hamming-weight-of-text-bits.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    ك = ord(ح)
    طالما ك > 0:
      ع = ع + ك % 2
      ك = ك // 2
  ارجع ع

تأكد_يساوي(ف("a"), 3, "حالة 1")
تأكد_يساوي(ف("abc"), 10, "حالة 2")
تأكد_يساوي(ف("AZ"), 6, "حالة 3")
تأكد_يساوي(ف("hi"), 7, "حالة 4")
