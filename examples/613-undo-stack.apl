# مثال 613 — تراجع وإعادة
# Undo redo stack
# Demonstrates: تراجع، إعادة، سجل أوامر
#
# Run:  python apl.py examples/613-undo-stack.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تراجع وإعادة: محرر نصوص بسجل أوامر
# Demonstrates: مكدسا تراجع وإعادة, أمر عكسي, نقطة الحفظ
# كل تعديل يسجل عكسه ليتراجع عنه بدقة

دالة أنشئ_محرر():
  ارجع {"نص": "", "تراجع": [], "إعادة": []}

دالة أضف(م, نص):
  م["تراجع"].append({"نوع_العملية": "حذف", "نص": نص, "طول_قبل": طول(م["نص"])})
  م["نص"] = م["نص"] + نص
  م["إعادة"] = []

دالة تراجع(م):
  لو طول(م["تراجع"]) > 0:
    أمر = م["تراجع"].pop()
    محذوف = م["نص"][أمر["طول_قبل"]:]
    م["نص"] = م["نص"][:أمر["طول_قبل"]]
    م["إعادة"].append({"نص": محذوف})

دالة أعد(م):
  لو طول(م["إعادة"]) > 0:
    أمر = م["إعادة"].pop()
    م["تراجع"].append({"نوع_العملية": "حذف", "نص": أمر["نص"], "طول_قبل": طول(م["نص"])})
    م["نص"] = م["نص"] + أمر["نص"]

م = أنشئ_محرر()
أضف(م, "مرحبا")
أضف(م, " ")
أضف(م, "يا عالم")
تأكد_يساوي(م["نص"], "مرحبا يا عالم", "نص كامل")
تراجع(م)
تأكد_يساوي(م["نص"], "مرحبا ", "بعد التراجع")
أعد(م)
تأكد_يساوي(م["نص"], "مرحبا يا عالم", "بعد الإعادة")
تراجع(م)
تراجع(م)
أضف(م, "-")
تأكد_يساوي(طول(م["إعادة"]), 0, "تعديل جديد يمسح الإعادة")
اطبع "النص النهائي:", م["نص"]
