# مثال 984 — شجرة البحث المثلى
# Optimal BST
# Demonstrates: ديناميكية على كل مدى
#
# Run:  python apl.py examples/984-optimal-bst.apl

# شجرة البحث المثلى: أدنى كلفة بحث متوقعة بتكرارات الوصول
# برمجة ديناميكية على كل المدى الفرعي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أدنى_كلفة(تكرارات):
  ن = طول(تكرارات)
  كلفة = []
  لكل i في نطاق(ن):
    صف = []
    لكل j في نطاق(ن):
      صف.ألحق(0)
    كلفة.ألحق(صف)
  لكل i في نطاق(ن):
    كلفة[i][i] = تكرارات[i]
  لكل مدى في نطاق(2, ن + 1):
    لكل i في نطاق(0, (ن - مدى) + 1):
      j = (i + مدى) - 1
      مجموع = 0
      لكل ف في نطاق(i, j + 1):
        مجموع = مجموع + تكرارات[ف]
      أفضل = -1
      لكل ك في نطاق(i, j + 1):
        يسار = 0
        لو ك > i:
          يسار = كلفة[i][ك - 1]
        يمين = 0
        لو ك < j:
          يمين = كلفة[ك + 1][j]
        لو (أفضل == -1) أو ((يسار + يمين) < أفضل):
          أفضل = يسار + يمين
      كلفة[i][j] = أفضل + مجموع
  ارجع كلفة[0][ن - 1]

تأكد_يساوي(أدنى_كلفة([34, 8, 50]), 142, "مثال كلاسيكي")
تأكد_يساوي(أدنى_كلفة([10, 12, 20]), 72, "تكرارات ثلاثة")
تأكد_يساوي(أدنى_كلفة([5, 6]), 16, "مفتاحان")
