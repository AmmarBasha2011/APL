# مثال 1500 — نتيجة الشوط في التنس
# Tennis game score
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1500-tennis-game-score.apl

# النقاط تعلن 15 و30 و40
# التعادل والأفضلية بعد الأربعين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نتيجة_الشوط(أ, ب):
  أسماء = ["0", "15", "30", "40"]
  لو أ >= 4 و أ - ب >= 2:
    ارجع "فوز اللاعب الأول"
  لو ب >= 4 و ب - أ >= 2:
    ارجع "فوز اللاعب الثاني"
  لو أ >= 3 و ب >= 3:
    لو أ == ب:
      ارجع "تعادل"
    لو أ > ب:
      ارجع "أفضلية الأول"
    ارجع "أفضلية الثاني"
  ارجع أسماء[أ] + "-" + أسماء[ب]

تأكد_يساوي(نتيجة_الشوط(2, 1), "30-15", "عادي")
تأكد_يساوي(نتيجة_الشوط(3, 3), "تعادل", "تعادل")
تأكد_يساوي(نتيجة_الشوط(4, 3), "أفضلية الأول", "أفضلية")
تأكد_يساوي(نتيجة_الشوط(2, 4), "فوز اللاعب الثاني", "فوز")
