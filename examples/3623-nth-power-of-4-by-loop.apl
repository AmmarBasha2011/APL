# مثال 3623 — قوة 4 بالحلقة
# Power of 4 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3623-nth-power-of-4-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 4
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 4, "حالة 2")
تأكد_يساوي(ف(3), 64, "حالة 3")
تأكد_يساوي(ف(6), 4096, "حالة 4")
تأكد_يساوي(ف(10), 1048576, "حالة 5")
