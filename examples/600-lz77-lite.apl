# مثال 600 — ضغط LZ77 المبسط
# LZ77 lite compression
# Demonstrates: ضغط، نافذة منزلقة، أزواج إزاحة وطول
#
# Run:  python apl.py examples/600-lz77-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ضغط LZ77 المبسط: أزواج (إزاحة، طول، حرف)
# Demonstrates: نافذة منزلقة للضغط, فك الضغط, مكسب الحجم
# أساس ضغط zip و gzip

دالة اضغط(نص):
  أزواج = []
  ي = 0
  طالما ي < طول(نص):
    أفضل_إزاحة = 0
    أفضل_طول = 0
    بداية = أكبر(0, ي - 6)
    لكل ج في نطاق(بداية, ي):
      ط = 0
      طالما ي + ط < طول(نص) و نص[ج + ط] == نص[ي + ط] و ط < 6:
        ط = ط + 1
      لو ط > أفضل_طول:
        أفضل_طول = ط
        أفضل_إزاحة = ي - ج
    لو أفضل_طول >= 2:
      أزواج.append([أفضل_إزاحة, أفضل_طول, ""])
      ي = ي + أفضل_طول
    والا:
      أزواج.append([0, 0, نص[ي]])
      ي = ي + 1
  ارجع أزواج

دالة فك(أزواج):
  ناتج = ""
  لكل زوج في أزواج:
    لو زوج[0] == 0:
      ناتج = ناتج + زوج[2]
    والا:
      بداية = طول(ناتج) - زوج[0]
      لكل ك في نطاق(زوج[1]):
        ناتج = ناتج + ناتج[بداية + ك]
  ارجع ناتج

نص = "ababababab"
مضغوط = اضغط(نص)
اطبع "أزواج:", مضغوط
تأكد_يساوي(فك(مضغوط), نص, "فك الضغط يعيد الأصل")
تأكد_يساوي(طول(مضغوط) < طول(نص), صواب, "الضغط يقلص التكرار")
تأكد_يساوي(فك(اضغط("مرحبا")), "مرحبا", "نص بلا تكرار")
