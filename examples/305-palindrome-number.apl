# مثال 305 — الأعداد المتناظرة
# Palindrome numbers
# Demonstrates: عكس العدد حسابيا
#
# Run:  python apl.py examples/305-palindrome-number.apl

دالة اعكس_عدد(عدد):
    المتغير معكوس = 0
    طالما عدد > 0:
        معكوس = معكوس * 10 + عدد % 10
        عدد = عدد // 10
    ارجع معكوس

دالة متناظر(عدد):
    لو عدد < 0:
        ارجع خطأ
    ارجع عدد == اعكس_عدد(عدد)

اطبع "121:", متناظر(121)
اطبع "12321:", متناظر(12321)
اطبع "123:", متناظر(123)

المتغير قائمة = [ن لكل ن في نطاق(1, 200) لو متناظر(ن)]
اطبع "عدد المتناظرة حتى 200:", طول(قائمة)
