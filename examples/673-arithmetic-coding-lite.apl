# مثال 673 — الترميز الحسابي المصغر
# Arithmetic coding lite
# Demonstrates: مدى احتمالي، ترميز كسور، فك
#
# Run:  python apl.py examples/673-arithmetic-coding-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الترميز الحسابي: رسالة كاملة في عدد واحد
# Demonstrates: مجالات متداخلة, ترميز هورنر بأساس الكلي, فك بالقلب
# النص كله يصير فترة واحدة بين عددين

رموز = ["A", "B", "C"]
تكرارات = [2, 7, 1]
تراكمي = [0, 2, 9]
كلي = 10

دالة رمز_من_رقم(رقم):
  لكل ي في نطاق(3):
    لو تراكمي[ي] == رقم:
      ارجع رموز[ي]
  ارجع ""

دالة شفر(نص):
  منخفض = 0
  مجال = 1
  لكل حرف في نص:
    رقم = 0
    لكل ي في نطاق(3):
      لو رموز[ي] == حرف:
        رقم = تراكمي[ي]
        مجال = مجال * تكرارات[ي]
    منخفض = منخفض * كلي + رقم
  ارجع [منخفض, مجال]

دالة فك(قيمة, خطوات):
  نص = ""
  قوة = 1
  لكل ي في نطاق(خطوات - 1):
    قوة = قوة * كلي
  طالما قوة > 0:
    رقم = قيمة // قوة
    قيمة = قيمة % قوة
    نص = نص + رمز_من_رقم(رقم)
    قوة = قوة // كلي
  ارجع نص

مشفر = شفر("ABCA")
تأكد_يساوي(مشفر[0], 290, "العدد المشفر")
تأكد_يساوي(مشفر[1], 28, "عرض الفترة")
تأكد_يساوي(فك(مشفر[0], 4), "ABCA", "الفك يعيد النص")
تأكد_يساوي(فك(شفر("BBBB")[0], 4), "BBBB", "نص مكرر")
اطبع "ABCA تساوي الفترة:", مشفر
