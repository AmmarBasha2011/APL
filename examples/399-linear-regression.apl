# مثال 399 — الانحدار الخطي
# Linear regression
# Demonstrates: الميل والمقطع يدويا
#
# Run:  python apl.py examples/399-linear-regression.apl

دالة انحدار(س, ص):
    المتغير ن = طول(س)
    المتغير مجموع_س = 0
    المتغير مجموع_ص = 0
    المتغير مجموع_سص = 0
    المتغير مجموع_سس = 0
    لكل ي في نطاق(ن):
        مجموع_س = مجموع_س + س[ي]
        مجموع_ص = مجموع_ص + ص[ي]
        مجموع_سص = مجموع_سص + س[ي] * ص[ي]
        مجموع_سس = مجموع_سس + س[ي] * س[ي]
    المتغير ميل = (ن * مجموع_سص - مجموع_س * مجموع_ص) / (ن * مجموع_سس - مجموع_س * مجموع_س)
    المتغير مقطع = (مجموع_ص - ميل * مجموع_س) / ن
    ارجع [ميل, مقطع]

المتغير نتيجة = انحدار([1, 2, 3, 4, 5], [2, 4, 5, 4, 5])
اطبع "الميل:", نتيجة[0]
اطبع "المقطع:", نتيجة[1]
اطبع "التوقع عند 6:", نتيجة[0] * 6 + نتيجة[1]
