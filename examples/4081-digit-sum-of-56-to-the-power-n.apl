# مثال 4081 — مجموع أرقام 56 أس ن
# Digit sum of 56 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4081-digit-sum-of-56-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 56 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 11, "حالة 2")
تأكد_يساوي(ف(5), 41, "حالة 3")
تأكد_يساوي(ف(10), 70, "حالة 4")
تأكد_يساوي(ف(20), 157, "حالة 5")
