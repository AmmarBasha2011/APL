# مثال 605 — كشف كاسحة الألغام
# Minesweeper reveal
# Demonstrates: كاسحة ألغام، كشف متتال، BFS
#
# Run:  python apl.py examples/605-minesweeper-reveal.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# كاسحة الألغام: كشف متتالي للخلايا الفارغة
# Demonstrates: BFS/DFS للكشف, عد الجيران الملغومة, تتالي الأصفار
# كشف خلية صفرية يكشف جيرانها تلقائيا

لغم = -1
لوحة = [
  [0, 0, 0, 0],
  [0, 1, 1, 1],
  [0, 1, لغم, 1],
  [0, 1, 1, 1]
]
ن = 4
مكشوف = []
لكل ي في نطاق(ن):
  مكشوف.append([خطأ] * ن)

دالة اكشف(س, ص):
  طابور = [[س, ص]]
  عدد = 0
  طالما طول(طابور) > 0:
    خلية = طابور.pop(0)
    أ = خلية[0]
    ب = خلية[1]
    لو أ >= 0 و أ < ن و ب >= 0 و ب < ن و مكشوف[أ][ب] == خطأ:
      مكشوف[أ][ب] = صواب
      عدد = عدد + 1
      لو لوحة[أ][ب] == 0:
        لكل ف في نطاق(-1, 2):
          لكل ج في نطاق(-1, 2):
            طابور.append([أ + ف, ب + ج])
  ارجع عدد

عدد = اكشف(0, 0)
اطبع "خلايا مكشوفة:", عدد
تأكد_يساوي(عدد, 12, "تتالي الكشف يغطي المنطقة الآمنة")
تأكد_يساوي(مكشوف[2][2], خطأ, "اللغم غير مكشوف")
