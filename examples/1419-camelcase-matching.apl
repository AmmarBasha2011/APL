# مثال 1419 — مطابقة الحالة الجملية
# Camelcase matching queries
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1419-camelcase-matching.apl

# الحروف الصغيرة الزائدة مسموحة
# أي حرف كبير زائد يفسد المطابقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يطابق(استعلام, نمط):
  ج = 0
  لكل ح في استعلام:
    لو (ج < طول(نمط)) و (ح == نمط[ج]):
      ج = ج + 1
    والا_لو ح.isupper():
      ارجع خطأ
  ارجع ج == طول(نمط)

دالة طابق_الكل(استعلامات, نمط):
  ناتج = []
  لكل س في استعلامات:
    ناتج.ألحق(يطابق(س, نمط))
  ارجع ناتج

تأكد_يساوي(طابق_الكل(["FooBar","FooBarTest","FootBall","FrameBuffer","ForceFeedBack"], "FB"), [صواب,خطأ,صواب,صواب,خطأ], "نمط FB")
تأكد_يساوي(طابق_الكل(["FooBar","FooBarTest"], "FoBa"), [صواب,خطأ], "نمط FoBa")
