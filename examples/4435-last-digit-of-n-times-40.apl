# مثال 4435 — آخر رقم من ن×40
# Last digit of n times 40
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4435-last-digit-of-n-times-40.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 40) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(7), 0, "حالة 3")
تأكد_يساوي(ف(12), 0, "حالة 4")
تأكد_يساوي(ف(99), 0, "حالة 5")
