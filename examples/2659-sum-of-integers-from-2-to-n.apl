# مثال 2659 — مجموع الأعداد من 2 إلى ن
# Sum from 2 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2659-sum-of-integers-from-2-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(2, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(2), 2, "حالة 1")
تأكد_يساوي(ف(3), 5, "حالة 2")
تأكد_يساوي(ف(12), 77, "حالة 3")
تأكد_يساوي(ف(100), 5049, "حالة 4")
