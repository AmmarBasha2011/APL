# مثال 514 — فرز شل
# Shell sort
# Demonstrates: فرز بالفجوات، فرز شل
#
# Run:  python apl.py examples/514-shell-sort.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# فرز شل بفجوات متناقصة
المتغير ق = [23, 12, 1, 8, 34, 54, 2, 3, 21, 9]
المتغير ن = طول(ق)
المتغير فجوة = ن // 2
طالما فجوة > 0:
    لكل i في نطاق(فجوة, ن):
        المتغير م = ق[i]
        المتغير j = i
        طالما j >= فجوة و ق[j - فجوة] > م:
            ق[j] = ق[j - فجوة]
            j = j - فجوة
        ق[j] = م
    فجوة = فجوة // 2
اطبع "مفرزة:", ق
تأكد_يساوي(ق, [1, 2, 3, 8, 9, 12, 21, 23, 34, 54], "فرز شل")
