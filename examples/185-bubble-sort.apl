# مثال 185 — الترتيب الفقاعي
# Bubble sort
# Demonstrates: حلقات متداخلة، مقارنة وتبديل
#
# Run:  python apl.py examples/185-bubble-sort.apl

دالة فقاعي(قائمة):
    المتغير ن = طول(قائمة)
    لكل ي في نطاق(ن):
        لكل ز في نطاق(ن - ي - 1):
            لو قائمة[ز] > قائمة[ز + 1]:
                المتغير مؤقت = قائمة[ز]
                قائمة[ز] = قائمة[ز + 1]
                قائمة[ز + 1] = مؤقت
    ارجع قائمة

المتغير أرقام = [64, 34, 25, 12, 22, 11, 90]
اطبع "قبل:", أرقام
اطبع "بعد:", فقاعي(أرقام)
