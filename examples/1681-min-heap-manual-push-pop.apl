# مثال 1681 — كومة صغرى يدوية
# Manual min heap push and pop
# Demonstrates: هياكل بيانات
#
# Run:  python apl.py examples/1681-min-heap-manual-push-pop.apl

# الإضافة تصعد العنصر
# الحذف ينقل الأخير للجذر وينزله

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادفع(كومة, قيمة):
  كومة.append(قيمة)
  ك = طول(كومة) - 1
  طالما ك > 0:
    أب = (ك - 1) // 2
    لو كومة[أب] > كومة[ك]:
      ت = كومة[أب]
      كومة[أب] = كومة[ك]
      كومة[ك] = ت
      ك = أب
    والا:
      ك = 0

دالة اسحب(كومة):
  أول = كومة[0]
  أخير = كومة.pop()
  لو طول(كومة) > 0:
    كومة[0] = أخير
    ك = 0
    طالما صواب:
      يسار = 2 * ك + 1
      يمين = 2 * ك + 2
      صغير = ك
      لو يسار < طول(كومة):
        لو كومة[يسار] < كومة[صغير]:
          صغير = يسار
      لو يمين < طول(كومة):
        لو كومة[يمين] < كومة[صغير]:
          صغير = يمين
      لو صغير == ك:
        ارجع أول
      ت = كومة[ك]
      كومة[ك] = كومة[صغير]
      كومة[صغير] = ت
      ك = صغير
  ارجع أول

ك = []
لكل ع في [5, 3, 8, 1, 9, 2]:
  ادفع(ك, ع)
خرج = []
طالما طول(ك) > 0:
  خرج.append(اسحب(ك))
تأكد_يساوي(خرج, [1, 2, 3, 5, 8, 9], "ترتيب")
