# مثال 2853 — إضافة 24 لكل عنصر
# Add 24 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2853-list-add-24-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 24]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [27, 25, 26], "حالة 1")
تأكد_يساوي(ف([5]), [29], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [25, 26, 27, 28, 29, 30], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [22, 24, 31, 31, 28], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [34, 44, 34, 54, 44, 34], "حالة 5")
