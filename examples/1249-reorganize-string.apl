# مثال 1249 — إعادة ترتيب النص
# Reorganize string no adjacent equal
# Demonstrates: جشع
#
# Run:  python apl.py examples/1249-reorganize-string.apl

# نضع الحرف الأكثر تكراراً في المواضع الزوجية
# ثم نكمل بباقي الحروف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اعد_ترتيب(س):
  عد = {}
  لكل ح في س:
    عد[ح] = عد.get(ح, 0) + 1
  ازواج = []
  لكل ح في عد:
    ازواج.ألحق([-عد[ح], ح])
  ازواج = مفرز(ازواج)
  لو -ازواج[0][0] > (طول(س) + 1) // 2:
    ارجع ""
  حروف = []
  لكل ز في ازواج:
    لكل ك في نطاق(-ز[0]):
      حروف.ألحق(ز[1])
  ناتج = [""] * طول(س)
  موضع = 0
  لكل ح في حروف:
    لو موضع >= طول(س):
      موضع = 1
    ناتج[موضع] = ح
    موضع = موضع + 2
  ارجع "".join(ناتج)

دالة سليم(س):
  لكل ع في نطاق(طول(س) - 1):
    لو س[ع] == س[ع + 1]:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(سليم(اعد_ترتيب("aab")), صواب, "سليم")
تأكد_يساوي(اعد_ترتيب("aaab"), "", "مستحيل")
تأكد_يساوي(سليم(اعد_ترتيب("aabbcc")), صواب, "ثلاثة حروف")
تأكد_يساوي(طول(اعد_ترتيب("vvvlo")), 5, "الطول")
