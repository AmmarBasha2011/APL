# مثال 1876 — مدى القائمة
# Range of a list
# Demonstrates: إحصاء
#
# Run:  python apl.py examples/1876-range-and-spread-of-list.apl

# نمر مرة واحدة
# نحتفظ بالحدين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مدى(ق):
  صغير = ق[0]
  كبير = ق[0]
  لكل ع في ق:
    صغير = أصغر(صغير, ع)
    كبير = أكبر(كبير, ع)
  ارجع كبير - صغير

تأكد_يساوي(مدى([3, 9, 1, 7]), 8, "مختلط")
تأكد_يساوي(مدى([5]), 0, "واحد")
تأكد_يساوي(مدى([-2, 2]), 4, "سالب")
