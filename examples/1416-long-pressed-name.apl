# مثال 1416 — اسم مضغوط طويلاً
# Long pressed name
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1416-long-pressed-name.apl

# مؤشران على الاسم والمكتوب
# الحرف المكرر يجب أن يطابق الحرف السابق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ضغط_طويل(اسم, مكتوب):
  ع = 0
  لكل ج في نطاق(طول(مكتوب)):
    لو (ع < طول(اسم)) و (اسم[ع] == مكتوب[ج]):
      ع = ع + 1
    والا_لو (ج == 0) أو (مكتوب[ج] != مكتوب[ج - 1]):
      ارجع خطأ
  ارجع ع == طول(اسم)

تأكد_يساوي(ضغط_طويل("alex", "aaleex"), صواب, "ضغط")
تأكد_يساوي(ضغط_طويل("saeed", "ssaaedd"), خطأ, "ناقص")
تأكد_يساوي(ضغط_طويل("a", "a"), صواب, "حرف")
