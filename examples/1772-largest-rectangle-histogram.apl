# مثال 1772 — أكبر مستطيل في مدرج
# Largest rectangle in histogram
# Demonstrates: مكدسات
#
# Run:  python apl.py examples/1772-largest-rectangle-histogram.apl

# نحسب المساحة عند كل انخفاض
# نضيف عموداً وهمياً صفرياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أكبر_مستطيل(ع):
  ع = ع + [0]
  مكدس = []
  أفضل = 0
  لكل ك في نطاق(طول(ع)):
    طالما طول(مكدس) > 0 و ع[مكدس[طول(مكدس) - 1]] >= ع[ك]:
      ارتفاع = ع[مكدس.pop()]
      عرض = ك
      لو طول(مكدس) > 0:
        عرض = ك - مكدس[طول(مكدس) - 1] - 1
      أفضل = أكبر(أفضل, ارتفاع * عرض)
    مكدس.append(ك)
  ارجع أفضل

تأكد_يساوي(أكبر_مستطيل([2, 1, 5, 6, 2, 3]), 10, "كلاسيكي")
تأكد_يساوي(أكبر_مستطيل([2, 4]), 4, "اثنان")
تأكد_يساوي(أكبر_مستطيل([3, 3, 3]), 9, "متساوية")
