# مثال 629 — محرك تعبيرات نمطية مصغر
# Mini regex engine
# Demonstrates: تعبيرات نمطية، نجمة كلفن، بدل
#
# Run:  python apl.py examples/629-regex-nfa-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# محرك تعبيرات نمطية مصغر: حرف ونقطة ونجمة
# Demonstrates: مطابقة عودية, كلفن نجمة, نقطة البدل
# جوهر التعبيرات النمطية بثلاث قواعد فقط

دالة طابق(نمط, نص):
  لو نمط == "":
    ارجع نص == ""
  أول = نص != "" و (نمط[0] == نص[0] أو نمط[0] == ".")
  لو طول(نمط) >= 2 و نمط[1] == "*":
    لو طابق(نمط[2:], نص):
      ارجع صواب
    ارجع أول و طابق(نمط, نص[1:])
  ارجع أول و طابق(نمط[1:], نص[1:])

تأكد_يساوي(طابق("aab", "aab"), صواب, "حرفي")
تأكد_يساوي(طابق("a*b", "b"), صواب, "نجمة صفرية")
تأكد_يساوي(طابق("a*b", "aaab"), صواب, "نجمة متكررة")
تأكد_يساوي(طابق("a.b", "acb"), صواب, "نقطة بدل")
تأكد_يساوي(طابق("a*b", "aaa"), خطأ, "يجب أن ينتهي بباء")
تأكد_يساوي(طابق("c*a*b", "aab"), صواب, "نجمتان متتاليتان")
اطبع "c*a*b مع aab:", طابق("c*a*b", "aab")
