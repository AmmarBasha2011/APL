# مثال 1368 — أقل حافلات
# Bus routes minimum buses
# Demonstrates: بحث بالعرض
#
# Run:  python apl.py examples/1368-bus-routes-min.apl

# نربط كل محطة بخطوطها
# ونتوسع بالعرض خطاً خطاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_حافلات(خطوط, مصدر, هدف):
  لو مصدر == هدف:
    ارجع 0
  خطوط_المحطة = {}
  لكل ر في نطاق(طول(خطوط)):
    لكل م في خطوط[ر]:
      لو م ليس في خطوط_المحطة:
        خطوط_المحطة[م] = []
      خطوط_المحطة[م].ألحق(ر)
  محطات_مرئية = {}
  محطات_مرئية[مصدر] = صواب
  خطوط_مرئية = {}
  طابور = [[مصدر, 0]]
  ع = 0
  طالما ع < طول(طابور):
    محطة = طابور[ع][0]
    حافلات = طابور[ع][1]
    ع = ع + 1
    لكل ر في خطوط_المحطة.get(محطة, []):
      لو ليس خطوط_مرئية.get(ر, خطأ):
        خطوط_مرئية[ر] = صواب
        لكل م في خطوط[ر]:
          لو م == هدف:
            ارجع حافلات + 1
          لو ليس محطات_مرئية.get(م, خطأ):
            محطات_مرئية[م] = صواب
            طابور.ألحق([م, حافلات + 1])
  ارجع -1

تأكد_يساوي(اقل_حافلات([[1,2,7],[3,6,7]], 1, 6), 2, "حافلتان")
تأكد_يساوي(اقل_حافلات([[7,12],[4,5,15],[6],[15,19],[9,12,13]], 15, 12), -1, "لا وصول")
تأكد_يساوي(اقل_حافلات([[1,2]], 1, 1), 0, "نفس المحطة")
