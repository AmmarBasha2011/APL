# مثال 919 — متتابعة فان إك
# Van Eck sequence
# Demonstrates: عمر آخر ظهور
#
# Run:  python apl.py examples/919-van-eck.apl

# متتابعة فان إك: الحد التالي هو عمر الحد الحالي
# صفر إن ظهر لأول مرة، وإلا الفرق بين آخر ظهورين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فان_إك(عدد):
  أ = [0]
  لكل i في نطاق(1, عدد):
    أخير = أ[طول(أ) - 1]
    # ابحث عن آخر ظهور سابق (ليس الموضع الأخير)
    سابق = -1
    ج = طول(أ) - 2
    طالما ج >= 0:
      لو أ[ج] == أخير و سابق == -1:
        سابق = ج
      ج = ج - 1
    لو سابق == -1:
      أ.ألحق(0)
    والا:
      أ.ألحق(طول(أ) - 1 - سابق)
  ارجع أ

أ = فان_إك(12)
اطبع "أول 12 حداً:", أ

متوقع = [0, 0, 1, 0, 2, 0, 2, 2, 1, 6, 0, 5]
تأكد_يساوي(طول(أ), 12, "الطول")
لكل i في نطاق(12):
  تأكد_يساوي(أ[i], متوقع[i], "حد " + نص(i))
