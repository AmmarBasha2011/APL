# مثال 1771 — أيام الانتظار لدرجة أدفأ
# Days until a warmer temperature
# Demonstrates: مكدسات
#
# Run:  python apl.py examples/1771-daily-temperatures-wait-days.apl

# مكدس من المواضع
# عند ارتفاع نحسب الفرق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة انتظار(د):
  ناتج = []
  لكل ع في د:
    ناتج.append(0)
  مكدس = []
  لكل ك في نطاق(طول(د)):
    طالما طول(مكدس) > 0 و د[مكدس[طول(مكدس) - 1]] < د[ك]:
      ي = مكدس.pop()
      ناتج[ي] = ك - ي
    مكدس.append(ك)
  ارجع ناتج

تأكد_يساوي(انتظار([73, 74, 75, 71, 69, 72, 76, 73]), [1, 1, 4, 2, 1, 1, 0, 0], "كلاسيكي")
تأكد_يساوي(انتظار([30, 20, 10]), [0, 0, 0], "هابطة")
