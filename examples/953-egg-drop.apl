# مثال 953 — لغز إسقاط البيض
# Egg drop puzzle
# Demonstrates: أدنى أسوأ حالة
#
# Run:  python apl.py examples/953-egg-drop.apl

# لغز إسقاط البيض: أقل عدد محاولات مضمون بـ ك بيضة و ن طابقاً
# برمجة ديناميكية: ع[ب][ط] = 1 + أدنى(أعظم(كسر، نجاة))

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة إسقاط(بيض, طوابق):
  # ع السطر السابق والحالي
  سابق = []
  لكل _ في نطاق(طوابق + 1):
    سابق.ألحق(0)
  لكل ب في نطاق(1, بيض + 1):
    حالي = []
    حالي.ألحق(0)
    لكل طابق في نطاق(1, طوابق + 1):
      لو ب == 1:
        حالي.ألحق(طابق)
      والا:
        أدنى = طابق
        لكل س في نطاق(1, طابق + 1):
          كسر = حالي[س - 1]
          نجاة = سابق[طابق - س]
          أسوأ = كسر
          لو نجاة > أسوأ:
            أسوأ = نجاة
          لو 1 + أسوأ < أدنى:
            أدنى = 1 + أسوأ
        حالي.ألحق(أدنى)
    سابق = حالي
  ارجع سابق[طوابق]

اطبع "بيضتان 36 طابقاً:", إسقاط(2, 36)
اطبع "بيضتان 100 طابق:", إسقاط(2, 100)
اطبع "ثلاث بيضات 100 طابق:", إسقاط(3, 100)

تأكد_يساوي(إسقاط(2, 36), 8, "المثال الشهير 36")
تأكد_يساوي(إسقاط(2, 100), 14, "المثال الشهير 100")
تأكد_يساوي(إسقاط(3, 100), 9, "ثلاث بيضات أسرع")
تأكد_يساوي(إسقاط(1, 10), 10, "بيضة واحدة: خطي")
تأكد_يساوي(إسقاط(5, 1), 1, "طابق واحد")
