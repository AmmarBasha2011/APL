# مثال 2368 — نقاط الشبكة داخل دائرة
# Lattice points in circle
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2368-count-lattice-points-in-circle-radius.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في نطاق(-ن, ن + 1):
    لكل ص في نطاق(-ن, ن + 1):
      لو س * س + ص * ص <= ن * ن:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 5, "حالة 2")
تأكد_يساوي(ف(2), 13, "حالة 3")
تأكد_يساوي(ف(5), 81, "حالة 4")
تأكد_يساوي(ف(10), 317, "حالة 5")
