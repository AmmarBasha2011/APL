# مثال 401 — لعبة الجلاد
# Hangman game
# Demonstrates: حلقة تخمين بمحاولات
#
# Run:  python apl.py examples/401-hangman-game.apl

المتغير كلمة = "برمجة"
المتغير مخفي = ["_", "_", "_", "_", "_"]
المتغير تخمينات = ["ب", "م", "ر", "ج", "ة", "س"]
المتغير أخطاء = 0

لكل حرف_تخمين in تخمينات:
    المتغير أصاب = خطأ
    لكل ي في نطاق(طول(كلمة)):
        لو كلمة[ي] == حرف_تخمين:
            مخفي[ي] = حرف_تخمين
            أصاب = صواب
    لو أصاب == خطأ:
        أخطاء = أخطاء + 1
    اطبع "".ضم(مخفي), "(أخطاء:", نص(أخطاء) + ")"

اطبع "انتهت اللعبة"
