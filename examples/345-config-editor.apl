# مثال 345 — محرر إعدادات بسيط
# Simple config editor
# Demonstrates: قراءة وتعديل وحفظ إعدادات
#
# Run:  python apl.py examples/345-config-editor.apl

المتغير مسار = "/tmp/apl_config_345.json"
اكتب_ملف_جسون({"السمة": "فاتحة", "اللغة": "ar", "خط": 12}, مسار)

المتغير إعدادات = اقرأ_ملف_جسون(مسار)
اطبع "قبل:", إعدادات["السمة"]

إعدادات["السمة"] = "داكنة"
إعدادات["خط"] = 14
اكتب_ملف_جسون(إعدادات, مسار)

المتغير بعد = اقرأ_ملف_جسون(مسار)
اطبع "بعد:", بعد["السمة"], "- خط", بعد["خط"]

احذف_ملف(مسار)
