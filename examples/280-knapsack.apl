# مثال 280 — حقيبة الظهر 0/1
# 0/1 Knapsack
# Demonstrates: برمجة ديناميكية للاختيار الأمثل
#
# Run:  python apl.py examples/280-knapsack.apl

دالة حقيبة(أوزان, قيم, سعة):
    المتغير ن = طول(أوزان)
    المتغير جدول = []
    لكل _ في نطاق(ن + 1):
        جدول.أضف([0 لكل _ في نطاق(سعة + 1)])
    لكل ي في نطاق(1, ن + 1):
        لكل س في نطاق(سعة + 1):
            جدول[ي][س] = جدول[ي - 1][س]
            لو أوزان[ي - 1] <= س:
                المتغير أخذ = جدول[ي - 1][س - أوزان[ي - 1]] + قيم[ي - 1]
                لو أخذ > جدول[ي][س]:
                    جدول[ي][س] = أخذ
    ارجع جدول[ن][سعة]

اطبع حقيبة([1, 3, 4, 5], [1, 4, 5, 7], 7)
اطبع حقيبة([10, 20, 30], [60, 100, 120], 50)
