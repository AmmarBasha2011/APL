# مثال 3551 — السعر بعد خصم 27 بالمئة
# Price after 27 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3551-price-after-27-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 27 // 100

تأكد_يساوي(ف(100), 73, "حالة 1")
تأكد_يساوي(ف(250), 183, "حالة 2")
تأكد_يساوي(ف(999), 730, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
