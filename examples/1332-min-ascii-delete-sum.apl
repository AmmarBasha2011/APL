# مثال 1332 — مجموع حذف أسكي
# Minimum ASCII delete sum
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1332-min-ascii-delete-sum.apl

# نبني جدولاً لأقل تكلفة لكل بادئتين
# الحذف يكلف كود الحرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حذف_اسكي(أ, ب):
  جدول = []
  لكل ع في نطاق(طول(أ) + 1):
    جدول.ألحق([0] * (طول(ب) + 1))
  لكل ع في نطاق(1, طول(أ) + 1):
    جدول[ع][0] = جدول[ع - 1][0] + ord(أ[ع - 1])
  لكل ج في نطاق(1, طول(ب) + 1):
    جدول[0][ج] = جدول[0][ج - 1] + ord(ب[ج - 1])
  لكل ع في نطاق(1, طول(أ) + 1):
    لكل ج في نطاق(1, طول(ب) + 1):
      لو أ[ع - 1] == ب[ج - 1]:
        جدول[ع][ج] = جدول[ع - 1][ج - 1]
      والا:
        جدول[ع][ج] = أصغر(جدول[ع - 1][ج] + ord(أ[ع - 1]), جدول[ع][ج - 1] + ord(ب[ج - 1]))
  ارجع جدول[طول(أ)][طول(ب)]

تأكد_يساوي(حذف_اسكي("sea", "eat"), 231, "sea eat")
تأكد_يساوي(حذف_اسكي("delete", "leet"), 403, "delete leet")
تأكد_يساوي(حذف_اسكي("a", "a"), 0, "متساويان")
