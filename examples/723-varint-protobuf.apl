# مثال 723 — أعداد varint
# Protobuf varint
# Demonstrates: بت استمرار، سبع بتات، فك
#
# Run:  python apl.py examples/723-varint-protobuf.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ترميز varint من protobuf (LEB128)
# Demonstrates: سبع بتات لكل بايت, بت استمرار علوي, ترتيب صغير-النهاية
# الأعداد الصغيرة تأخذ بايتا واحدا: مفتاح كفاءة protobuf

دالة شفر(عدد):
  بايتات = []
  طالما عدد >= 128:
    بايتات.append(عدد % 128 + 128)
    عدد = عدد // 128
  بايتات.append(عدد)
  ارجع بايتات

دالة فك(بايتات):
  عدد = 0
  إزاحة = 0
  لكل بايت في بايتات:
    عدد = عدد + (بايت % 128) * قوة(128, إزاحة)
    إزاحة = إزاحة + 1
  ارجع عدد

تأكد_يساوي(شفر(1), [1], "واحد بايت واحد")
تأكد_يساوي(شفر(127), [127], "أعلى بايت مفرد")
تأكد_يساوي(شفر(300), [172, 2], "مثال protobuf الرسمي")
تأكد_يساوي(شفر(16384), [128, 128, 1], "ثلاثة بايتات")
تأكد_يساوي(فك([172, 2]), 300, "فك 300")
تأكد_يساوي(فك([128, 128, 1]), 16384, "فك كبير")
تأكد_يساوي(فك(شفر(4294967295)), 4294967295, "32-بت ذهاب وعودة")
تأكد_يساوي(طول(شفر(70)), 1, "صغير موفر")
تأكد_يساوي(طول(شفر(1000000)), 3, "مليون ثلاثة")
اطبع "300 مشفرا:", شفر(300)
