# مثال 411 — ترميز Base64 يدويا
# Manual Base64 encoding
# Demonstrates: تحويل نص إلى base64
#
# Run:  python apl.py examples/411-base64-manual.apl

المتغير أبجدية = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

دالة إلى_ثنائي8(عدد):
    المتغير بتات = ""
    لكل _ في نطاق(8):
        بتات = نص(عدد % 2) + بتات
        عدد = عدد // 2
    ارجع بتات

دالة من_ثنائي(بتات):
    المتغير قيمة = 0
    لكل ب in بتات:
        قيمة = قيمة * 2
        لو ب == "1":
            قيمة = قيمة + 1
    ارجع قيمة

دالة بيس64(نص_الدخل):
    المتغير بتات = ""
    لكل حرف in نص_الدخل:
        بتات = بتات + إلى_ثنائي8(ترميز_حرف(حرف))
    طالما طول(بتات) % 6 != 0:
        بتات = بتات + "0"
    المتغير ناتج = ""
    لكل ي في نطاق(0, طول(بتات), 6):
        ناتج = ناتج + أبجدية[من_ثنائي(بتات[ي:ي + 6])]
    ارجع ناتج

اطبع بيس64("Hi")
اطبع بيس64("APL")
