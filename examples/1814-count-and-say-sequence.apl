# مثال 1814 — متتالية عد وقل
# Count and say sequence
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1814-count-and-say-sequence.apl

# نقرأ المجموعات المتتالية
# نكتب العدد ثم الرقم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صف(س):
  ناتج = ""
  ك = 0
  طالما ك < طول(س):
    ي = ك
    طالما ي < طول(س) و س[ي] == س[ك]:
      ي = ي + 1
    ناتج = ناتج + نص(ي - ك) + س[ك]
    ك = ي
  ارجع ناتج

دالة عد_وقل(ن):
  س = "1"
  لكل ك في نطاق(ن - 1):
    س = صف(س)
  ارجع س

تأكد_يساوي(عد_وقل(1), "1", "الأول")
تأكد_يساوي(عد_وقل(4), "1211", "الرابع")
تأكد_يساوي(عد_وقل(6), "312211", "السادس")
