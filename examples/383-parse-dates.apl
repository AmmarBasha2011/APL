# مثال 383 — استخراج التواريخ من نص
# Extract dates from text
# Demonstrates: نمط تاريخ dd/mm/yyyy
#
# Run:  python apl.py examples/383-parse-dates.apl

المتغير نص = "الاجتماع يوم 15/03/2026 والتسليم في 30/06/2026 وأيضا 1/1/2027"
المتغير تواريخ = بحث_شامل("[0-9]?[0-9]/[0-9]?[0-9]/[0-9][0-9][0-9][0-9]", نص)
اطبع "التواريخ الموجودة:", تواريخ
اطبع "عددها:", طول(تواريخ)
