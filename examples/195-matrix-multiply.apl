# مثال 195 — ضرب المصفوفات
# Matrix multiplication
# Demonstrates: حلقات ثلاثية، مصفوفات متداخلة
#
# Run:  python apl.py examples/195-matrix-multiply.apl

دالة اضرب(أ, ب):
    المتغير صفوف = طول(أ)
    المتغير أعمدة = طول(ب[0])
    المتغير داخل = طول(ب)
    المتغير نتيجة = []
    لكل ي في نطاق(صفوف):
        المتغير صف = []
        لكل ز في نطاق(أعمدة):
            المتغير مجموع = 0
            لكل ك في نطاق(داخل):
                مجموع = مجموع + أ[ي][ك] * ب[ك][ز]
            صف.أضف(مجموع)
        نتيجة.أضف(صف)
    ارجع نتيجة

المتغير أ = [[1, 2], [3, 4]]
المتغير ب = [[5, 6], [7, 8]]
المتغير ن = اضرب(أ, ب)
اطبع "النتيجة:", ن
اطبع "العنصر (0,0):", ن[0][0]
اطبع "العنصر (1,1):", ن[1][1]
