# مثال 1802 — هل النقطة على القطعة
# Point on line segment
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1802-point-on-segment-check.apl

# الجداء الاتجاهي صفر
# الإحداثيات داخل المستطيل المحيط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة على_القطعة(أ, ب, ن):
  ق = (ب[0] - أ[0]) * (ن[1] - أ[1]) - (ب[1] - أ[1]) * (ن[0] - أ[0])
  لو ق != 0:
    ارجع خطأ
  ارجع ن[0] >= أصغر(أ[0], ب[0]) و ن[0] <= أكبر(أ[0], ب[0]) و ن[1] >= أصغر(أ[1], ب[1]) و ن[1] <= أكبر(أ[1], ب[1])

تأكد_يساوي(على_القطعة([0, 0], [4, 4], [2, 2]), صواب, "منتصف")
تأكد_يساوي(على_القطعة([0, 0], [4, 4], [5, 5]), خطأ, "خارج")
تأكد_يساوي(على_القطعة([0, 0], [4, 4], [2, 3]), خطأ, "بعيدة")
