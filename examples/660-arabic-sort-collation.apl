# مثال 660 — ترتيب عربي هجائي
# Arabic collation sort
# Demonstrates: ترتيب هجائي، مفاتيح حروف، ألف
#
# Run:  python apl.py examples/660-arabic-sort-collation.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ترتيب عربي أبجدي
# Demonstrates: خريطة ترتيب الحروف, مفاتيح مقارنة عددية, معالجة الألف
# يرتب الأسماء بالترتيب الهجائي العربي لا بالترميز

ترتيب_حروف = "اأإآبتثجحخدذرزسشصضطظعغفقكلمنهوي"
دالة رتبة(حرف):
  لكل ي في نطاق(طول(ترتيب_حروف)):
    لو ترتيب_حروف[ي] == حرف:
      ارجع ي // 1
  ارجع 100

دالة مفتاح(كلمة):
  م = []
  لكل حرف في كلمة:
    م.append(رتبة(حرف))
  طالما طول(م) < 12:
    م.append(100)
  ارجع م

أسماء = ["زيد", "أحمد", "محمد", "خالد", "بشير", "إياد", "حسن"]
مزودة = []
لكل اسم في أسماء:
  مزودة.append([مفتاح(اسم), اسم])
مزودة.sort()
نتيجة = []
لكل زوج في مزودة:
  نتيجة.append(زوج[1])
تأكد_يساوي(نتيجة, ["أحمد", "إياد", "بشير", "حسن", "خالد", "زيد", "محمد"], "الترتيب الهجائي")
اطبع "مرتبة:", نتيجة
