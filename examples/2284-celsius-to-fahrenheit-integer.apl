# مثال 2284 — سلسيوس إلى فهرنهايت
# Celsius to Fahrenheit
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2284-celsius-to-fahrenheit-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * 9 // 5 + 32

تأكد_يساوي(ف(0), 32, "حالة 1")
تأكد_يساوي(ف(100), 212, "حالة 2")
تأكد_يساوي(ف(-40), -40, "حالة 3")
تأكد_يساوي(ف(37), 98, "حالة 4")
تأكد_يساوي(ف(20), 68, "حالة 5")
