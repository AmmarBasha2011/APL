# مثال 1931 — هل القائمة جزء من أخرى
# Check whether one list is a subset of another
# Demonstrates: مجموعات
#
# Run:  python apl.py examples/1931-is-subset-of-list-check.apl

# نمر على عناصر الصغرى
# نتوقف عند أول عنصر غائب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جزء(صغرى, كبرى):
  لكل ع في صغرى:
    لو (ع في كبرى) == خطأ:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(جزء([1, 2], [1, 2, 3]), صواب, "جزء")
تأكد_يساوي(جزء([1, 4], [1, 2, 3]), خطأ, "ليس جزءا")
تأكد_يساوي(جزء([], [1]), صواب, "فارغة")
