# مثال 410 — ماكينة الحظ
# Slot machine
# Demonstrates: رموز وجوائز
#
# Run:  python apl.py examples/410-slot-machine.apl

بذرة(9)
المتغير رموز = ["كرز", "ليمون", "سبعة", "جرس"]
المتغير رصيد = 100

لكل جولة في نطاق(3):
    رصيد = رصيد - 10
    المتغير نتيجة = [رموز[عشوائي_عدد(0, 3)], رموز[عشوائي_عدد(0, 3)], رموز[عشوائي_عدد(0, 3)]]
    اطبع "النتيجة:", "-".ضم(نتيجة)
    لو نتيجة[0] == نتيجة[1] و نتيجة[1] == نتيجة[2]:
        رصيد = رصيد + 50
        اطبع "جائزة كبرى! +50"

اطبع "الرصيد النهائي:", رصيد
