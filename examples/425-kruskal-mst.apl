# مثال 425 — شجرة كروسكال الممتدة
# Kruskal's MST
# Demonstrates: دمج المجموعات
#
# Run:  python apl.py examples/425-kruskal-mst.apl

دالة جذر(أصل, عقدة):
    طالما أصل[عقدة] != عقدة:
        عقدة = أصل[عقدة]
    ارجع عقدة

المتغير حواف = [[0, 1, 4], [0, 2, 3], [1, 2, 1], [1, 3, 2], [2, 3, 4]]
المتغير مرتبة = []
لكل حافة في حواف:
    مرتبة.append(حافة)
لكل ي في نطاق(طول(مرتبة)):
    لكل ز في نطاق(ي + 1, طول(مرتبة)):
        لو مرتبة[ز][2] < مرتبة[ي][2]:
            المتغير بدل = مرتبة[ي]
            مرتبة[ي] = مرتبة[ز]
            مرتبة[ز] = بدل

المتغير أصل = {0: 0, 1: 1, 2: 2, 3: 3}
المتغير تكلفة = 0
المتغير مختارة = []
لكل حافة في مرتبة:
    المتغير ج1 = جذر(أصل, حافة[0])
    المتغير ج2 = جذر(أصل, حافة[1])
    لو ج1 != ج2:
        أصل[ج1] = ج2
        تكلفة = تكلفة + حافة[2]
        مختارة.append(حافة)

اطبع "الحواف المختارة:", مختارة
اطبع "التكلفة:", تكلفة
