# مثال 804 — بايز الساذج
# Naive Bayes
# Demonstrates: تمهيد لابلاس، لوغاريتمات
#
# Run:  python apl.py examples/804-naive-bayes.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مصنف بايز الساذج متعدد الحدود للنصوص مع تمهيد لابلاس
# Demonstrates: عد الكلمات بقوائم متوازية, لوغاريتمات الاحتمالات, تصويت بأعلى درجة

تدريب = [["goal match score win", "رياضة"], ["team goal match", "رياضة"], ["election vote law", "سياسة"], ["vote senate law", "سياسة"]]

دالة مفردات():
  قائمة = []
  لكل عينة في تدريب:
    لكل كلمة في عينة[0].split(" "):
      لو (كلمة في قائمة) == خطأ:
        قائمة.append(كلمة)
  ارجع قائمة

دالة عد_فئة(فئة, مفردات):
  أعداد = []
  لكل كلمة في مفردات:
    أعداد.append(0)
  لكل عينة في تدريب:
    لو عينة[1] == فئة:
      لكل كلمة في عينة[0].split(" "):
        أعداد[مفردات.index(كلمة)] = أعداد[مفردات.index(كلمة)] + 1
  ارجع أعداد

دالة درجة(مستند, فئة, مفردات, أعداد):
  إجمالي = 0
  لكل ع في أعداد:
    إجمالي = إجمالي + ع
  عدد_فئة = 0
  لكل عينة في تدريب:
    لو عينة[1] == فئة:
      عدد_فئة = عدد_فئة + 1
  نتيجة = لوغاريتم(عدد_فئة / طول(تدريب))
  لكل كلمة في مستند.split(" "):
    عدد = 0
    لو كلمة في مفردات:
      عدد = أعداد[مفردات.index(كلمة)]
    نتيجة = نتيجة + لوغاريتم((عدد + 1) / (إجمالي + طول(مفردات)))
  ارجع نتيجة

م = مفردات()
تأكد_يساوي(طول(م), 9, "حجم المفردات")
تأكد_يساوي(عد_فئة("رياضة", م)[م.index("goal")], 2, "عد goal في رياضة")
درجة1 = درجة("goal match", "رياضة", م, عد_فئة("رياضة", م))
درجة2 = درجة("goal match", "سياسة", م, عد_فئة("سياسة", م))
تأكد_يساوي(مقرب(درجة1, 4), 0 - 4.0411, "درجة رياضة")
تأكد_يساوي(درجة1 > درجة2 == خطأ, خطأ, "رياضة تفوز")
تأكد_يساوي(درجة("vote law", "سياسة", م, عد_فئة("سياسة", م)) > درجة("vote law", "رياضة", م, عد_فئة("رياضة", م)) == خطأ, خطأ, "سياسة تفوز")
