# مثال 727 — بوني كود مصغر
# Punycode lite
# Demonstrates: أساس 36، فاصل، تكييف
#
# Run:  python apl.py examples/727-punycode-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# بيونيكود (RFC 3492) بخوارزمية كاملة مصغرة التعليق
# Demonstrates: أساس 36, متحيز متكيف, أعداد بطول متغير
# أسماء النطاقات العربية: xn-- ثم بيونيكود

دالة رقم_حرف(ر):
  لو ر < 26:
    ارجع فك_ترميز_حرف(ترميز_حرف("a") + ر)
  ارجع فك_ترميز_حرف(ترميز_حرف("0") + ر - 26)

دالة تكيف(فرق, نقاط, أول):
  قاعدة = 36
  أدنى = 1
  أعلى = 26
  ميل = 38
  ترطيب = 700
  لو أول:
    فرق = فرق // ترطيب
  والا:
    فرق = فرق // 2
  فرق = فرق + فرق // نقاط
  ك = 0
  طالما فرق > ((قاعدة - أدنى) * أعلى) // 2:
    فرق = فرق // (قاعدة - أدنى)
    ك = ك + قاعدة
  ارجع ك + (قاعدة - أدنى + 1) * فرق // (فرق + ميل)

دالة شفر(نص):
  نقاط = []
  لكل ي في نطاق(طول(نص)):
    نقاط.append(ترميز_حرف(نص[ي]))
  ناتج = ""
  لكل ن في نقاط:
    لو ن < 128:
      ناتج = ناتج + فك_ترميز_حرف(ن)
  أساسي = طول(ناتج)
  لو أساسي > 0 و أساسي < طول(نقاط):
    ناتج = ناتج + "-"
  ن = 128
  فرق = 0
  متحيز = 72
  طول_سابق = أساسي
  طالما طول_سابق < طول(نقاط):
    أدنى_ج = -1
    لكل ن2 في نقاط:
      لو ن2 >= ن و (أدنى_ج < 0 أو ن2 < أدنى_ج):
        أدنى_ج = ن2
    فرق = فرق + (أدنى_ج - ن) * (طول_سابق + 1)
    ن = أدنى_ج
    لكل ن2 في نقاط:
      لو ن2 < ن:
        فرق = فرق + 1
      لو ن2 == ن:
        ق = فرق
        ك = 36
        مستمر = صواب
        طالما مستمر:
          لو ك <= متحيز:
            ت = 1
          والا_لو ك >= متحيز + 26:
            ت = 26
          والا:
            ت = ك - متحيز
          لو ق < ت:
            مستمر = خطأ
          والا:
            ناتج = ناتج + رقم_حرف(ت + (ق - ت) % (36 - ت))
            ق = (ق - ت) // (36 - ت)
            ك = ك + 36
        ناتج = ناتج + رقم_حرف(ق)
        متحيز = تكيف(فرق, طول_سابق + 1, طول_سابق == أساسي)
        فرق = 0
        طول_سابق = طول_سابق + 1
    فرق = فرق + 1
    ن = ن + 1
  ارجع ناتج

تأكد_يساوي(شفر("mañana"), "maana-pta", "مثال RFC")
تأكد_يساوي(شفر("bücher"), "bcher-kva", "ألمانية")
تأكد_يساوي(شفر("hello"), "hello", "آسكي خالص بلا لاحقة")
تأكد_يساوي(شفر("a"), "a", "حرف واحد")
تأكد_يساوي(شفر("例え"), "r8jz45g", "يابانية")
اطبع "مثال بيونيكود:", شفر("mañana")
