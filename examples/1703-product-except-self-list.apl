# مثال 1703 — حاصل الضرب دون العنصر نفسه
# Product of array except self
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1703-product-except-self-list.apl

# حاصل ما قبل العنصر
# ثم حاصل ما بعده

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ضرب_الباقي(ق):
  ن = طول(ق)
  ناتج = []
  لكل ك في نطاق(ن):
    ناتج.append(1)
  بادئة = 1
  لكل ك في نطاق(ن):
    ناتج[ك] = بادئة
    بادئة = بادئة * ق[ك]
  لاحقة = 1
  لكل ك في نطاق(ن - 1, -1, -1):
    ناتج[ك] = ناتج[ك] * لاحقة
    لاحقة = لاحقة * ق[ك]
  ارجع ناتج

تأكد_يساوي(ضرب_الباقي([1, 2, 3, 4]), [24, 12, 8, 6], "أربعة")
تأكد_يساوي(ضرب_الباقي([2, 0, 3]), [0, 6, 0], "صفر")
