# مثال 190 — مجموع العددين
# Two sum
# Demonstrates: قاموس للبحث السريع
#
# Run:  python apl.py examples/190-two-sum.apl

دالة مجموع_العددين(أرقام, هدف):
    المتغير مرئية = {}
    لكل ي في نطاق(طول(أرقام)):
        المتغير مكمل = هدف - أرقام[ي]
        لو مكمل في مرئية:
            ارجع [مرئية[مكمل], ي]
        مرئية[أرقام[ي]] = ي
    ارجع []

اطبع مجموع_العددين([2, 7, 11, 15], 9)
اطبع مجموع_العددين([3, 2, 4], 6)
اطبع مجموع_العددين([3, 3], 6)
