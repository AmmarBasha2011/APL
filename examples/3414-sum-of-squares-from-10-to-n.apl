# مثال 3414 — مجموع المربعات من 10 إلى ن
# Sum of squares from 10
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3414-sum-of-squares-from-10-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(10, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(10), 100, "حالة 1")
تأكد_يساوي(ف(11), 221, "حالة 2")
تأكد_يساوي(ف(20), 2585, "حالة 3")
تأكد_يساوي(ف(100), 338065, "حالة 4")
