# مثال 992 — خوارزمية أبريوري
# Apriori algorithm
# Demonstrates: تقليم بعتبة الدعم
#
# Run:  python apl.py examples/992-apriori.apl

# خوارزمية أبريوري: الأصناف والأزواج المتكررة في سلة مشتريات
# عتبة الدعم تقلم المرشحين جيلاً بعد جيل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

سلال = [["milk", "bread"], ["milk", "diaper", "beer"], ["milk", "bread", "diaper"], ["bread", "diaper"], ["milk", "bread", "beer"]]
أصناف = ["beer", "bread", "diaper", "milk"]
عتبة = 2

دالة يحتوي(سلة, صنف):
  لكل عنصر في سلة:
    لو عنصر == صنف:
      ارجع 1
  ارجع 0

دالة دعم1(صنف):
  عد = 0
  لكل سلة في سلال:
    لو يحتوي(سلة, صنف) == 1:
      عد = عد + 1
  ارجع عد

دالة دعم2(أ, ب):
  عد = 0
  لكل سلة في سلال:
    لو (يحتوي(سلة, أ) == 1) و (يحتوي(سلة, ب) == 1):
      عد = عد + 1
  ارجع عد

متكررة = []
لكل صنف في أصناف:
  لو دعم1(صنف) >= عتبة:
    متكررة.ألحق(صنف)

أزواج = 0
دعم_خبز_حليب = 0
لكل i في نطاق(طول(متكررة)):
  لكل j في نطاق(i + 1, طول(متكررة)):
    د = دعم2(متكررة[i], متكررة[j])
    لو د >= عتبة:
      أزواج = أزواج + 1
      لو (متكررة[i] == "bread") و (متكررة[j] == "milk"):
        دعم_خبز_حليب = د

تأكد_يساوي(طول(متكررة), 4, "أربعة أصناف متكررة")
تأكد_يساوي(دعم1("bread"), 4, "دعم الخبز")
تأكد_يساوي(دعم1("beer"), 2, "دعم المشروب")
تأكد_يساوي(أزواج, 4, "أربعة أزواج متكررة")
تأكد_يساوي(دعم_خبز_حليب, 3, "دعم الزوج الأشهر")
