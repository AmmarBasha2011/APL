# مثال 2595 — مجموع البواقي على 11
# Sum of remainders mod 11
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2595-sum-of-remainders-mod-11-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن + 1):
    م = م + ي % 11
  ارجع م

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(7), 28, "حالة 2")
تأكد_يساوي(ف(12), 56, "حالة 3")
تأكد_يساوي(ف(50), 241, "حالة 4")
تأكد_يساوي(ف(100), 496, "حالة 5")
