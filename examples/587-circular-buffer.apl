# مثال 587 — مخزن دائري
# Circular buffer
# Demonstrates: مخزن دائري، كتابة فوق، سعة ثابتة
#
# Run:  python apl.py examples/587-circular-buffer.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مخزن دائري (ring buffer) بحجم ثابت
# Demonstrates: كتابة تلف حول مصفوفة, استهلاك بالترتيب, كشف الامتلاء
# يستخدم في تدفقات البيانات والسجلات

دالة أنشئ_مخزن(سعة):
  ارجع {"عناصر": [0] * سعة, "رأس": 0, "ذيل": 0, "عدد": 0, "سعة": سعة}

دالة ادفع(م, قيمة):
  م["عناصر"][م["ذيل"]] = قيمة
  م["ذيل"] = (م["ذيل"] + 1) % م["سعة"]
  لو م["عدد"] < م["سعة"]:
    م["عدد"] = م["عدد"] + 1
  والا:
    م["رأس"] = (م["رأس"] + 1) % م["سعة"]

دالة اسحب(م):
  قيمة = م["عناصر"][م["رأس"]]
  م["رأس"] = (م["رأس"] + 1) % م["سعة"]
  م["عدد"] = م["عدد"] - 1
  ارجع قيمة

م = أنشئ_مخزن(3)
ادفع(م, 10)
ادفع(م, 20)
ادفع(م, 30)
ادفع(م, 40)
اطبع "عدد العناصر:", م["عدد"]
تأكد_يساوي(م["عدد"], 3, "السعة القصوى محفوظة")
تأكد_يساوي(اسحب(م), 20, "أقدم عنصر بعد الكتابة فوق 10")
ادفع(م, 50)
تأكد_يساوي(اسحب(م), 30, "ترتيب الاستهلاك 1")
تأكد_يساوي(اسحب(م), 40, "ترتيب الاستهلاك 2")
تأكد_يساوي(اسحب(م), 50, "ترتيب الاستهلاك 3")
تأكد_يساوي(م["عدد"], 0, "فارغ في النهاية")
