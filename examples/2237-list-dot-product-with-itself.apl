# مثال 2237 — الجداء الداخلي مع نفسها
# Self dot product
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2237-list-dot-product-with-itself.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل ع في ق:
    م = م + ع * ع
  ارجع م

تأكد_يساوي(ف([3, 1, 2]), 14, "حالة 1")
تأكد_يساوي(ف([5]), 25, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 91, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 118, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 2000, "حالة 5")
