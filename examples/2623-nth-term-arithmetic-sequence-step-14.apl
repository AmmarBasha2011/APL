# مثال 2623 — الحد النوني بخطوة 14
# Nth term step 14
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2623-nth-term-arithmetic-sequence-step-14.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 14

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 17, "حالة 2")
تأكد_يساوي(ف(10), 129, "حالة 3")
تأكد_يساوي(ف(100), 1389, "حالة 4")
