# مثال 592 — تربيع المصفوفات
# Matrix exponentiation
# Demonstrates: مصفوفات، رفع لقوة، تريبوناتشي
#
# Run:  python apl.py examples/592-matrix-exponentiation.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تربيع المصفوفات لحساب تريبوناتشي بسرعة
# Demonstrates: ضرب مصفوفات 3x3, رفع لقوة بالتربيع المتكرر, متتالية من الدرجة الثالثة
# ت(0)=0, ت(1)=1, ت(2)=1, ت(ن) = ت(ن-1)+ت(ن-2)+ت(ن-3)

دالة اضرب(أ, ب):
  ن = طول(أ)
  ناتج = []
  لكل سطر_ي في نطاق(ن):
    ناتج.append([0] * ن)
  لكل س في نطاق(ن):
    لكل ص في نطاق(ن):
      مجموع = 0
      لكل ك في نطاق(ن):
        مجموع = مجموع + أ[س][ك] * ب[ك][ص]
      ناتج[س][ص] = مجموع
  ارجع ناتج

دالة قوة(مصفوفة, أ):
  ن = طول(مصفوفة)
  ناتج = []
  لكل سطر_ي في نطاق(ن):
    ناتج.append([0] * ن)
  لكل ي في نطاق(ن):
    ناتج[ي][ي] = 1
  أساس = مصفوفة
  طالما أ > 0:
    لو أ % 2 == 1:
      ناتج = اضرب(ناتج, أساس)
    أساس = اضرب(أساس, أساس)
    أ = أ // 2
  ارجع ناتج

دالة تريبو(ن):
  لو ن == 0:
    ارجع 0
  لو ن <= 2:
    ارجع 1
  تحويل = [[1, 1, 1], [1, 0, 0], [0, 1, 0]]
  مرفوعة = قوة(تحويل, ن - 2)
  ارجع مرفوعة[0][0] * 1 + مرفوعة[0][1] * 1 + مرفوعة[0][2] * 0

تأكد_يساوي(تريبو(5), 7, "ت(5)")
تأكد_يساوي(تريبو(10), 149, "ت(10)")
تأكد_يساوي(تريبو(20), 66012, "ت(20)")
اطبع "ت(20) =", تريبو(20)
