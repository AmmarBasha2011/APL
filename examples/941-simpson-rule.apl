# مثال 941 — قاعدة سيمبسون
# Simpson rule
# Demonstrates: أوزان 1-4-2-4
#
# Run:  python apl.py examples/941-simpson-rule.apl

# قاعدة سيمبسون: تكامل عددي بقطع مكافئ
# أوزان 1-4-2-4-...-2-4-1 مضروبة في عرض الخطوة على 3

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# نكامل جيب(س) من 0 إلى طاي (طاي تقريبياً 3.14159265358979)
طاي = 3.14159265358979
عدد = 100
عرض = طاي / عدد
مجموع = جب(0) + جب(طاي)
لكل i في نطاق(1, عدد):
  وزن = 2
  لو i % 2 == 1:
    وزن = 4
  مجموع = مجموع + جب(i * عرض) * وزن
تكامل_جيب = مجموع * عرض / 3
اطبع "تكامل الجيب 0..طاي:", تكامل_جيب

تأكد_يساوي(مقرب(تكامل_جيب, 6), 2, "تكامل الجيب = 2")

# تكامل س^3 من 0 إلى 1 = 1/4 (دقيق تماماً عند سيمبسون لأنه مكعب)
عدد2 = 10
عرض2 = 1 / عدد2
مجموع2 = 0 ** 3 + 1 ** 3
لكل i في نطاق(1, عدد2):
  وزن2 = 2
  لو i % 2 == 1:
    وزن2 = 4
  مجموع2 = مجموع2 + (i * عرض2) ** 3 * وزن2
تكامل_مكعب = مجموع2 * عرض2 / 3
اطبع "تكامل س^3 0..1:", تكامل_مكعب

تأكد_يساوي(مقرب(تكامل_مكعب, 9), 0.25, "تكامل المكعب دقيق")

# سيمبسون دقيق للكثيرات حتى الدرجة الثالثة: س^2 من 0 إلى 2 = 8/3
عرض3 = 2 / 10
مجموع3 = 0 ** 2 + 2 ** 2
لكل i في نطاق(1, 10):
  وزن3 = 2
  لو i % 2 == 1:
    وزن3 = 4
  مجموع3 = مجموع3 + (i * عرض3) ** 2 * وزن3
تأكد_يساوي(مقرب(مجموع3 * عرض3 / 3, 9), مقرب(8 / 3, 9), "تكامل التربيع")
