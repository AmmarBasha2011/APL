# مثال 2476 — إضافة 7 لكل عنصر
# Add 7 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2476-list-add-7-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 7]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [10, 8, 9], "حالة 1")
تأكد_يساوي(ف([5]), [12], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [8, 9, 10, 11, 12, 13], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [5, 7, 14, 14, 11], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [17, 27, 17, 37, 27, 17], "حالة 5")
