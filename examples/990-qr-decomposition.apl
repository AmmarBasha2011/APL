# مثال 990 — تحليل QR
# QR decomposition
# Demonstrates: تعامد غرام-شميدت
#
# Run:  python apl.py examples/990-qr-decomposition.apl

# تحليل QR: كل مصفوفة قياس متعامد في مثلثية عليا
# تعامد غرام-شميدت على الأعمدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

عمود1 = [1, 1]
عمود2 = [1, -1]

دالة نقطة(أ, ب):
  ارجع (أ[0] * ب[0]) + (أ[1] * ب[1])

دالة طبيع(ع):
  ط = جذر(نقطة(ع, ع))
  ارجع [ع[0] / ط, ع[1] / ط]

ق1 = طبيع(عمود1)
ر11 = جذر(نقطة(عمود1, عمود1))
ر12 = نقطة(ق1, عمود2)
ع2 = [عمود2[0] - (ر12 * ق1[0]), عمود2[1] - (ر12 * ق1[1])]
ر22 = جذر(نقطة(ع2, ع2))
ق2 = [ع2[0] / ر22, ع2[1] / ر22]

تأكد_يساوي(مقرب(ر11, 4), 1.4142, "القطر الأول")
تأكد_يساوي(مقرب(ر12, 4), 0, "فوق القطر")
تأكد_يساوي(مقرب(ر22, 4), 1.4142, "القطر الثاني")
تأكد_يساوي(مقرب(نقطة(ق1, ق2), 6), 0, "تعامد الأعمدة")
تأكد_يساوي(مقرب(نقطة(ق1, ق1), 6), 1, "وحدة الأول")
تأكد_يساوي(مقرب((ر11 * ق1[0]) + (ر12 * ق2[0]), 6), 1, "إعادة تركيب العمود الثاني")
