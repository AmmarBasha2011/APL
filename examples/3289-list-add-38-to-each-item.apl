# مثال 3289 — إضافة 38 لكل عنصر
# Add 38 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3289-list-add-38-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 38]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [41, 39, 40], "حالة 1")
تأكد_يساوي(ف([5]), [43], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [39, 40, 41, 42, 43, 44], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [36, 38, 45, 45, 42], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [48, 58, 48, 68, 58, 48], "حالة 5")
