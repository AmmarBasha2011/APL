# مثال 1719 — الكلمة الأكثر تكراراً
# Most frequent word
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1719-string-word-frequency-top.apl

# نقسم النص بالمسافات
# نحتفظ بأعلى عدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أكثر_كلمة(س):
  عدد = {}
  لكل ك في س.split(" "):
    عدد[ك] = عدد.get(ك, 0) + 1
  أفضل = ""
  أعلى = 0
  لكل ك في س.split(" "):
    لو عدد[ك] > أعلى:
      أعلى = عدد[ك]
      أفضل = ك
  ارجع أفضل

تأكد_يساوي(أكثر_كلمة("a b a c b a"), "a", "الأولى")
تأكد_يساوي(أكثر_كلمة("x y"), "x", "تعادل")
تأكد_يساوي(أكثر_كلمة("hi"), "hi", "كلمة")
