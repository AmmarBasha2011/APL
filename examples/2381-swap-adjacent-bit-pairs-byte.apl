# مثال 2381 — تبديل البتات المتجاورة
# Swap adjacent bits in byte
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2381-swap-adjacent-bit-pairs-byte.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((ن & 170) >> 1) | ((ن & 85) << 1)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(2), 1, "حالة 3")
تأكد_يساوي(ف(3), 3, "حالة 4")
تأكد_يساوي(ف(170), 85, "حالة 5")
تأكد_يساوي(ف(255), 255, "حالة 6")
