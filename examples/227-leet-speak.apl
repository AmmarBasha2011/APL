# مثال 227 — لغة الليت (1337)
# Leet speak
# Demonstrates: قاموس استبدال أحرف
#
# Run:  python apl.py examples/227-leet-speak.apl

المتغير ليت = {"a": "4", "e": "3", "i": "1", "o": "0", "s": "5", "t": "7", "l": "1", "g": "9"}

دالة إلى_ليت(نص_الدخل):
    المتغير نتيجة = ""
    لكل حرف في نص_الدخل.سفلي():
        لو حرف في ليت:
            نتيجة = نتيجة + ليت[حرف]
        الا:
            نتيجة = نتيجة + حرف
    ارجع نتيجة

اطبع إلى_ليت("elite hacker")
اطبع إلى_ليت("aplnguage is great")
