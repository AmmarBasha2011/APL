# مثال 1273 — مشاركة السيارة
# Car pooling capacity
# Demonstrates: فروق
#
# Run:  python apl.py examples/1273-car-pooling.apl

# نضيف الركاب عند الصعود ونطرحهم عند النزول
# ونتحقق أن العدد لا يتجاوز السعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تكفي(رحلات, سعة):
  تغير = [0] * 1001
  لكل ر في رحلات:
    تغير[ر[1]] = تغير[ر[1]] + ر[0]
    تغير[ر[2]] = تغير[ر[2]] - ر[0]
  حالي = 0
  لكل ت في تغير:
    حالي = حالي + ت
    لو حالي > سعة:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(تكفي([[2,1,5],[3,3,7]], 4), خطأ, "لا تكفي")
تأكد_يساوي(تكفي([[2,1,5],[3,3,7]], 5), صواب, "تكفي")
تأكد_يساوي(تكفي([[3,2,7],[3,7,9],[8,3,9]], 11), صواب, "ثلاث رحلات")
