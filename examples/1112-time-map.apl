# مثال 1112 — خريطة زمنية
# Time based key-value store
# Demonstrates: نسخ بالطوابع الزمنية
#
# Run:  python apl.py examples/1112-time-map.apl

# كل مفتاح يحتفظ بقيمه مع أوقاتها
# والقراءة ترجع آخر قيمة وقتها لا يتجاوز الوقت المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف خريطة_زمنية:
    دالة_إنشاء(ذات):
        ذات.مفاتيح = []
        ذات.سجلات = []

    دالة ضع(ذات, مفتاح, قيمة, وقت):
        لو مفتاح ليس في ذات.مفاتيح:
            ذات.مفاتيح.ألحق(مفتاح)
            ذات.سجلات.ألحق([])
        ف = 0
        طالما ذات.مفاتيح[ف] != مفتاح:
            ف = ف + 1
        ذات.سجلات[ف].ألحق([وقت, قيمة])

    دالة هات(ذات, مفتاح, وقت):
        لو مفتاح ليس في ذات.مفاتيح:
            ارجع ""
        ف = 0
        طالما ذات.مفاتيح[ف] != مفتاح:
            ف = ف + 1
        نتيجة = ""
        لكل زوج في ذات.سجلات[ف]:
            لو زوج[0] <= وقت:
                نتيجة = زوج[1]
        ارجع نتيجة

خ = خريطة_زمنية()
خ.ضع("foo", "bar", 1)
تأكد_يساوي(خ.هات("foo", 1), "bar", "الوقت نفسه")
تأكد_يساوي(خ.هات("foo", 3), "bar", "وقت لاحق")
خ.ضع("foo", "bar2", 4)
تأكد_يساوي(خ.هات("foo", 4), "bar2", "القيمة الجديدة")
تأكد_يساوي(خ.هات("foo", 5), "bar2", "بعد القيمة الجديدة")
تأكد_يساوي(خ.هات("foo", 0), "", "قبل أي قيمة")
تأكد_يساوي(خ.هات("baz", 9), "", "مفتاح غائب")
