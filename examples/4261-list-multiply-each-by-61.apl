# مثال 4261 — ضرب كل عنصر في 61
# Multiply each item by 61
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4261-list-multiply-each-by-61.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 61]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [183, 61, 122], "حالة 1")
تأكد_يساوي(ف([5]), [305], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [61, 122, 183, 244, 305, 366], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-122, 0, 427, 427, 244], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [610, 1220, 610, 1830, 1220, 610], "حالة 5")
