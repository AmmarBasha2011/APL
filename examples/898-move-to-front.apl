# مثال 898 — تحويلة انقل للأمام
# Move-to-front transform
# Demonstrates: جدول متكيف ذاتياً
#
# Run:  python apl.py examples/898-move-to-front.apl

# تحويلة انقل للأمام: ضغط يستغل التكرار الموضعي
# كل رمز يستبدل بموضعه في جدول ثم ينتقل لمقدمته

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة انقل_للأمام(دخل, جدول):
  خرج = []
  ج = []
  لكل x في جدول:
    ج.ألحق(x)
  لكل رمز في دخل:
    موضع = 0
    لكل i في نطاق(طول(ج)):
      لو ج[i] == رمز:
        موضع = i
    خرج.ألحق(موضع)
    ج = [رمز] + ج[:موضع] + ج[موضع + 1:]
  ارجع خرج

دالة فك_انقل(مشفر, جدول):
  خرج = []
  ج = []
  لكل x في جدول:
    ج.ألحق(x)
  لكل موضع في مشفر:
    رمز = ج[موضع]
    خرج.ألحق(رمز)
    ج = [رمز] + ج[:موضع] + ج[موضع + 1:]
  ارجع خرج

جدول = [1, 2, 3, 4]
دخل = [3, 1, 4, 1]
مشفر = انقل_للأمام(دخل, جدول)
اطبع "المشفر:", مشفر
اطبع "المفكوك:", فك_انقل(مشفر, جدول)

تأكد_يساوي(مشفر[0], 2, "أول موضع")
تأكد_يساوي(طول(مشفر), 4, "طول المشفر")

# الفك يعيد الأصل
مفكوك = فك_انقل(مشفر, جدول)
تأكد_يساوي(طول(مفكوك), 4, "طول المفكوك")
لكل i في نطاق(4):
  تأكد_يساوي(مفكوك[i], دخل[i], "رمز " + نص(i))

# التكرار المتتالي يعطي أصفاراً: مفتاح كفاءة الضغط
دخل2 = [7, 7, 7, 7]
جدول2 = [7, 8, 9]
مشفر2 = انقل_للأمام(دخل2, جدول2)
تأكد_يساوي(مشفر2[1], 0, "تكرار أول")
تأكد_يساوي(مشفر2[2], 0, "تكرار ثانٍ")
تأكد_يساوي(مشفر2[3], 0, "تكرار ثالث")
