# مثال 3957 — السعر مع ضريبة 37 بالمئة
# Price with 37 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3957-price-with-37-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 37 // 100

تأكد_يساوي(ف(100), 137, "حالة 1")
تأكد_يساوي(ف(250), 342, "حالة 2")
تأكد_يساوي(ف(999), 1368, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
