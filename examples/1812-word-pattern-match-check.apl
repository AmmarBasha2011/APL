# مثال 1812 — مطابقة نمط الكلمات
# Word pattern match
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1812-word-pattern-match-check.apl

# نقسم الجملة
# نربط الحرف بالكلمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يطابق(نمط, جملة):
  كلمات = جملة.split(" ")
  لو طول(كلمات) != طول(نمط):
    ارجع خطأ
  أ = {}
  ب = {}
  لكل ك في نطاق(طول(نمط)):
    ح = نمط[ك]
    ك_كلمة = كلمات[ك]
    لو ح في أ:
      لو أ[ح] != ك_كلمة:
        ارجع خطأ
    والا:
      أ[ح] = ك_كلمة
    لو ك_كلمة في ب:
      لو ب[ك_كلمة] != ح:
        ارجع خطأ
    والا:
      ب[ك_كلمة] = ح
  ارجع صواب

تأكد_يساوي(يطابق("abba", "dog cat cat dog"), صواب, "مطابق")
تأكد_يساوي(يطابق("abba", "dog cat cat fish"), خطأ, "كلمة مختلفة")
تأكد_يساوي(يطابق("aaaa", "dog cat cat dog"), خطأ, "نمط واحد")
