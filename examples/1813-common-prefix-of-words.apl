# مثال 1813 — أطول بادئة مشتركة
# Longest common prefix
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1813-common-prefix-of-words.apl

# نأخذ الكلمة الأولى مرجعاً
# نتوقف عند أول اختلاف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بادئة(كلمات):
  لو طول(كلمات) == 0:
    ارجع ""
  أول = كلمات[0]
  لكل ك في نطاق(طول(أول)):
    لكل ك_كلمة في كلمات:
      لو ك >= طول(ك_كلمة):
        ارجع أول[:ك]
      لو ك_كلمة[ك] != أول[ك]:
        ارجع أول[:ك]
  ارجع أول

تأكد_يساوي(بادئة(["flower", "flow", "flight"]), "fl", "كلاسيكي")
تأكد_يساوي(بادئة(["dog", "car"]), "", "لا شيء")
تأكد_يساوي(بادئة(["abc"]), "abc", "كلمة")
