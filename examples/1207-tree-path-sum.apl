# مثال 1207 — مجموع مسار
# Path sum root to leaf
# Demonstrates: تكرار ذاتي
#
# Run:  python apl.py examples/1207-tree-path-sum.apl

# ننقص قيمة كل عقدة من الهدف
# وعند الورقة نتحقق أن الباقي صفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مسار(ش, هدف):
  لو طول(ش) == 0:
    ارجع خطأ
  باق = هدف - ش[0]
  لو (طول(ش[1]) == 0) و (طول(ش[2]) == 0):
    ارجع باق == 0
  ارجع مسار(ش[1], باق) أو مسار(ش[2], باق)

شجرة = [5, [4, [11, [7, [], []], [2, [], []]], []], [8, [13, [], []], [4, [], [1, [], []]]]]
تأكد_يساوي(مسار(شجرة, 22), صواب, "اثنان وعشرون")
تأكد_يساوي(مسار(شجرة, 26), صواب, "ست وعشرون")
تأكد_يساوي(مسار(شجرة, 5), خطأ, "جذر ليس ورقة")
تأكد_يساوي(مسار([], 0), خطأ, "فارغة")
