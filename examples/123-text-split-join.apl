# مثال 123 — التقسيم والدمج
# Split and join pipelines
# Demonstrates: تقسيم، ضم، فرز، عكس
#
# Run:  python apl.py examples/123-text-split-join.apl

المتغير سطر = "تفاح,موز,برتقال,عنب,فراولة"
المتغير فواكه = سطر.تقسيم(",")
اطبع "القائمة:", فواكه

فواكه.فرز()
اطبع "مرتبة:", " | ".ضم(فواكه)

فواكه.عكس()
اطبع "معكوسة:", "-".ضم(فواكه)

المتغير جملة = ["APL", "لغة", "عربية"]
اطبع "جملة:", " ".ضم(جملة)
