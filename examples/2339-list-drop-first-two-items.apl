# مثال 2339 — حذف أول عنصرين
# Drop first two
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2339-list-drop-first-two-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع ق[2:]

تأكد_يساوي(ف([1, 2, 3, 4]), [3, 4], "حالة 1")
تأكد_يساوي(ف([1]), [], "حالة 2")
تأكد_يساوي(ف([]), [], "حالة 3")
تأكد_يساوي(ف([5, 6, 7]), [7], "حالة 4")
