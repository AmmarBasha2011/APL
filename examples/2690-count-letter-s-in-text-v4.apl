# مثال 2690 — عدد الحرف s في النص
# Count letter s
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2690-count-letter-s-in-text-v4.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن.count("s")

تأكد_يساوي(ف("elephant"), 0, "حالة 1")
تأكد_يساوي(ف("aaa"), 0, "حالة 2")
تأكد_يساوي(ف("status quo"), 2, "حالة 3")
تأكد_يساوي(ف("mississippi"), 4, "حالة 4")
