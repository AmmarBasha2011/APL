# مثال 1163 — لوحة سودوكو صالحة
# Validate sudoku board
# Demonstrates: مجموعات
#
# Run:  python apl.py examples/1163-valid-sudoku-board.apl

# لا يتكرر رقم في صف ولا عمود ولا مربع 3x3
# نستخدم قائمة مرئيات لكل وحدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صالحة(لوحة):
  صفوف = []
  اعمدة = []
  مربعات = []
  لكل ع في نطاق(9):
    صفوف.ألحق([])
    اعمدة.ألحق([])
    مربعات.ألحق([])
  لكل ص في نطاق(9):
    لكل ج في نطاق(9):
      ق = لوحة[ص][ج]
      لو ق != ".":
        م = (ص // 3) * 3 + (ج // 3)
        لو ق في صفوف[ص]:
          ارجع خطأ
        لو ق في اعمدة[ج]:
          ارجع خطأ
        لو ق في مربعات[م]:
          ارجع خطأ
        صفوف[ص].ألحق(ق)
        اعمدة[ج].ألحق(ق)
        مربعات[م].ألحق(ق)
  ارجع صواب

فارغ = []
لكل ع في نطاق(9):
  فارغ.ألحق(["."] * 9)
تأكد_يساوي(صالحة(فارغ), صواب, "فارغة")
فارغ[0][0] = "5"
فارغ[0][5] = "5"
تأكد_يساوي(صالحة(فارغ), خطأ, "تكرار في صف")
فارغ[0][5] = "."
فارغ[7][0] = "5"
تأكد_يساوي(صالحة(فارغ), خطأ, "تكرار في عمود")
فارغ[7][0] = "."
فارغ[1][1] = "5"
تأكد_يساوي(صالحة(فارغ), خطأ, "تكرار في مربع")
