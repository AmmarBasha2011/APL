# مثال 2385 — مجموع الكسور 1/ي تقريب صحيح
# Harmonic sum floor
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2385-digits-of-pi-style-sum-reciprocal-int.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن + 1):
    م = م + 1000 // ي
  ارجع م

تأكد_يساوي(ف(1), 1000, "حالة 1")
تأكد_يساوي(ف(5), 2283, "حالة 2")
تأكد_يساوي(ف(10), 2927, "حالة 3")
تأكد_يساوي(ف(100), 5142, "حالة 4")
