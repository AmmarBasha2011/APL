# مثال 3864 — ضرب كل عنصر في 54
# Multiply each item by 54
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3864-list-multiply-each-by-54.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 54]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [162, 54, 108], "حالة 1")
تأكد_يساوي(ف([5]), [270], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [54, 108, 162, 216, 270, 324], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-108, 0, 378, 378, 216], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [540, 1080, 540, 1620, 1080, 540], "حالة 5")
