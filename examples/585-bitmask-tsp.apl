# مثال 585 — جولة بأقنعة البتات
# Bitmask TSP
# Demonstrates: TSP، أقنعة بتات، برمجة ديناميكية
#
# Run:  python apl.py examples/585-bitmask-tsp.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# أقصر جولة تزور كل المدن (TSP) ببرمجة ديناميكية على أقنعة البتات
# Demonstrates: bitmask DP, حالات 2^n, مسألة البائع المتجول
# يعمل على 5 مدن كمثال صغير

مسافات = [
  [0, 10, 15, 20, 25],
  [10, 0, 35, 25, 30],
  [15, 35, 0, 30, 10],
  [20, 25, 30, 0, 15,],
  [25, 30, 10, 15, 0]
]
ن = 5
كامل = (2 ** ن) - 1
لا_نهاية = 10 ** 9

# م[قناع][آخر] = أقصر طريق يبدأ من 0 ويزور مدن القناع وينتهي عند «آخر»
م = []
لكل سطر_ي في نطاق(كامل + 1):
  م.append([لا_نهاية] * ن)
م[1][0] = 0

لكل قناع في نطاق(كامل + 1):
  لكل آخر في نطاق(ن):
    لو م[قناع][آخر] < لا_نهاية:
      لكل تال في نطاق(ن):
        بت = 2 ** تال
        لو (قناع // بت) % 2 == 0:
          قناع_جديد = قناع + بت
          مرشح = م[قناع][آخر] + مسافات[آخر][تال]
          لو مرشح < م[قناع_جديد][تال]:
            م[قناع_جديد][تال] = مرشح

أفضل = لا_نهاية
لكل آخر في نطاق(1, ن):
  لو م[كامل][آخر] + مسافات[آخر][0] < أفضل:
    أفضل = م[كامل][آخر] + مسافات[آخر][0]

اطبع "أقصر جولة:", أفضل
تأكد_يساوي(أفضل, 75, "أقصر جولة 5 مدن")
تأكد_يساوي(م[1][0], 0, "الحالة الابتدائية")
