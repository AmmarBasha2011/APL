# مثال 4378 — مساحة مستطيل مكبر 26 مرات
# Rectangle area scaled by 26
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4378-rectangle-area-scaled-by-26.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 26) * (ق[1] * 26)

تأكد_يساوي(ف([1, 2]), 1352, "حالة 1")
تأكد_يساوي(ف([3, 4]), 8112, "حالة 2")
تأكد_يساوي(ف([5, 5]), 16900, "حالة 3")
تأكد_يساوي(ف([10, 1]), 6760, "حالة 4")
