# مثال 1328 — حركات الحصان
# Minimum knight moves
# Demonstrates: بحث بالعرض
#
# Run:  python apl.py examples/1328-minimum-knight-moves.apl

# الحصان يتحرك بثماني حركات ممكنة
# نستخدم البحث بالعرض على رقعة كبيرة بما يكفي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حركات(هدف_س, هدف_ص):
  ح = [[1,2],[2,1],[-1,2],[-2,1],[1,-2],[2,-1],[-1,-2],[-2,-1]]
  مرئي = {}
  مرئي["0,0"] = صواب
  طابور = [[0, 0, 0]]
  ع = 0
  طالما ع < طول(طابور):
    س = طابور[ع][0]
    ص = طابور[ع][1]
    خ = طابور[ع][2]
    ع = ع + 1
    لو (س == هدف_س) و (ص == هدف_ص):
      ارجع خ
    لكل ز في ح:
      ن1 = س + ز[0]
      ن2 = ص + ز[1]
      مفتاح = نص(ن1) + "," + نص(ن2)
      لو (مفتاح ليس في مرئي) و (ن1 >= -2) و (ن1 <= 12) و (ن2 >= -2) و (ن2 <= 12):
        مرئي[مفتاح] = صواب
        طابور.ألحق([ن1, ن2, خ + 1])
  ارجع -1

تأكد_يساوي(حركات(2, 1), 1, "حركة واحدة")
تأكد_يساوي(حركات(5, 5), 4, "أربع حركات")
تأكد_يساوي(حركات(0, 0), 0, "نفس الخانة")
تأكد_يساوي(حركات(1, 1), 2, "قطرية")
