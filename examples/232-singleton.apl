# مثال 232 — نمط المفرد
# Singleton pattern
# Demonstrates: نسخة واحدة مشتركة
#
# Run:  python apl.py examples/232-singleton.apl

صنف إعدادات:
    دالة_إنشاء(ذات):
        ذات.قيم = {}

    دالة ضع(ذات, مفتاح, قيمة):
        ذات.قيم[مفتاح] = قيمة

    دالة خذ(ذات, مفتاح):
        ارجع ذات.قيم.get(مفتاح, "غير موجود")

المتغير صندوق = {"نسخة": لا_شيء}

دالة إعدادات_التطبيق():
    لو صندوق["نسخة"] == لا_شيء:
        صندوق["نسخة"] = إعدادات()
    ارجع صندوق["نسخة"]

المتغير أ = إعدادات_التطبيق()
أ.ضع("اللغة", "العربية")
المتغير ب = إعدادات_التطبيق()
اطبع "نفس النسخة؟", أ == ب
اطبع "اللغة من ب:", ب.خذ("اللغة")
