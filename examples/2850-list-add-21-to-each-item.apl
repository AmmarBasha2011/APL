# مثال 2850 — إضافة 21 لكل عنصر
# Add 21 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2850-list-add-21-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 21]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [24, 22, 23], "حالة 1")
تأكد_يساوي(ف([5]), [26], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [22, 23, 24, 25, 26, 27], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [19, 21, 28, 28, 25], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [31, 41, 31, 51, 41, 31], "حالة 5")
