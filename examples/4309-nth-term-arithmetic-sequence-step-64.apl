# مثال 4309 — الحد النوني بخطوة 64
# Nth term step 64
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4309-nth-term-arithmetic-sequence-step-64.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 64

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 67, "حالة 2")
تأكد_يساوي(ف(10), 579, "حالة 3")
تأكد_يساوي(ف(100), 6339, "حالة 4")
