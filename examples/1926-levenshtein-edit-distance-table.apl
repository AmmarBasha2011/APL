# مثال 1926 — مسافة التعديل بين نصين
# Levenshtein edit distance
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1926-levenshtein-edit-distance-table.apl

# نملأ الجدول من الصف الأول والعمود الأول
# نأخذ أقل تكلفة من ثلاث عمليات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مسافة(أ, ب):
  ج = []
  لكل ي في نطاق(طول(أ) + 1):
    صف = []
    لكل ك في نطاق(طول(ب) + 1):
      صف = صف + [0]
    ج = ج + [صف]
  لكل ي في نطاق(طول(أ) + 1):
    ج[ي][0] = ي
  لكل ك في نطاق(طول(ب) + 1):
    ج[0][ك] = ك
  لكل ي في نطاق(1, طول(أ) + 1):
    لكل ك في نطاق(1, طول(ب) + 1):
      تكلفة = 1
      لو أ[ي - 1] == ب[ك - 1]:
        تكلفة = 0
      ج[ي][ك] = أصغر(ج[ي - 1][ك] + 1, ج[ي][ك - 1] + 1, ج[ي - 1][ك - 1] + تكلفة)
  ارجع ج[طول(أ)][طول(ب)]

تأكد_يساوي(مسافة("kitten", "sitting"), 3, "kitten")
تأكد_يساوي(مسافة("", "abc"), 3, "فارغ")
تأكد_يساوي(مسافة("same", "same"), 0, "متطابق")
