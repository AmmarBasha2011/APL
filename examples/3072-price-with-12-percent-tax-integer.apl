# مثال 3072 — السعر مع ضريبة 12 بالمئة
# Price with 12 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3072-price-with-12-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 12 // 100

تأكد_يساوي(ف(100), 112, "حالة 1")
تأكد_يساوي(ف(250), 280, "حالة 2")
تأكد_يساوي(ف(999), 1118, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
