# مثال 2675 — السعر مع ضريبة 3 بالمئة
# Price with 3 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2675-price-with-3-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 3 // 100

تأكد_يساوي(ف(100), 103, "حالة 1")
تأكد_يساوي(ف(250), 257, "حالة 2")
تأكد_يساوي(ف(999), 1028, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
