# مثال 224 — شيفرة مورس
# Morse code
# Demonstrates: قاموس تحويل، بناء نص
#
# Run:  python apl.py examples/224-morse.apl

المتغير مورس = {"a": ".-", "b": "-...", "c": "-.-.", "d": "-..", "e": ".", "f": "..-.", "g": "--.", "h": "....", "i": "..", "j": ".---", "k": "-.-", "l": ".-..", "m": "--", "n": "-.", "o": "---", "p": ".--.", "q": "--.-", "r": ".-.", "s": "...", "t": "-", "u": "..-", "v": "...-", "w": ".--", "x": "-..-", "y": "-.--", "z": "--..", " ": "/"}

دالة إلى_مورس(نص_الدخل):
    المتغير رموز = []
    لكل حرف في نص_الدخل.سفلي():
        لو حرف في مورس:
            رموز.أضف(مورس[حرف])
    ارجع " ".ضم(رموز)

دالة من_مورس(شفرة):
    المتغير عكس = {}
    لكل حرف في مورس:
        عكس[مورس[حرف]] = حرف
    المتغير حروف = []
    لكل رمز في شفرة.تقسيم(" "):
        لو رمز في عكس:
            حروف.أضف(عكس[رمز])
    ارجع "".ضم(حروف)

المتغير شفرة = إلى_مورس("sos apl")
اطبع "مورس:", شفرة
اطبع "مفكوكة:", من_مورس(شفرة)
