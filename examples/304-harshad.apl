# مثال 304 — أعداد هارشاد
# Harshad numbers
# Demonstrates: قابلية القسمة على مجموع الأرقام
#
# Run:  python apl.py examples/304-harshad.apl

دالة هارشاد(عدد):
    المتغير مجموع = 0
    لكل رقم في نص(عدد):
        مجموع = مجموع + صحيح(رقم)
    ارجع عدد % مجموع == 0

اطبع "18:", هارشاد(18)
اطبع "19:", هارشاد(19)

المتغير قائمة = [ن لكل ن في نطاق(1, 60) لو هارشاد(ن)]
اطبع "هارشاد حتى 60:", قائمة
