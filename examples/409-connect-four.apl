# مثال 409 — منطق أربعة تربح
# Connect four logic
# Demonstrates: فحص أربعة في صف
#
# Run:  python apl.py examples/409-connect-four.apl

دالة فائز_أفقي(شبكة):
    لكل سطر in شبكة:
        لكل ي في نطاق(طول(سطر) - 3):
            لو سطر[ي] != "-" و سطر[ي] == سطر[ي + 1] و سطر[ي + 1] == سطر[ي + 2] و سطر[ي + 2] == سطر[ي + 3]:
                ارجع سطر[ي]
    ارجع "-"

المتغير شبكة = [
    ["-", "-", "-", "-", "-", "-"],
    ["-", "-", "-", "-", "-", "-"],
    ["أ", "أ", "أ", "أ", "-", "-"]
]
اطبع "الفائز:", فائز_أفقي(شبكة)
