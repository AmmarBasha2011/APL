# مثال 1954 — أطول سلسلة كولاتز تحت حد
# Longest Collatz chain below limit
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1954-collatz-longest-chain-start-below.apl

# # نذكر طول السلسلة لكل عدد في قاموس
# # ونبحث عن أكبر طول بين 1 وحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة طول_سلسلة(ن, ذاكرة):
  مسار = []
  طالما (ن في ذاكرة) == خطأ:
    مسار = مسار + [ن]
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
  عدد = ذاكرة[ن]
  لكل ك في نطاق(طول(مسار)):
    عدد = عدد + 1
    ذاكرة[مسار[طول(مسار) - 1 - ك]] = عدد
  لو طول(مسار) > 0:
    ارجع ذاكرة[مسار[0]]
  ارجع ذاكرة[ن]

دالة افضل_بداية(حد):
  ذاكرة = {}
  ذاكرة[1] = 1
  افضل = 1
  اطول = 1
  لكل ن في نطاق(2, حد):
    ط = طول_سلسلة(ن, ذاكرة)
    لو ط > اطول:
      اطول = ط
      افضل = ن
  ارجع [افضل, اطول]

تأكد_يساوي(افضل_بداية(10), [9, 20], "تحت عشرة")
تأكد_يساوي(افضل_بداية(100), [97, 119], "تحت مئة")
تأكد_يساوي(افضل_بداية(1000), [871, 179], "تحت ألف")
