# مثال 646 — شجرة تريب
# Treap
# Demonstrates: تريب، أولويات، دورات
#
# Run:  python apl.py examples/646-treap.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تريب: شجرة بحث بأولويات كومة
# Demonstrates: أولوية ثابتة مشتقة من المفتاح, دورات يمين ويسار, خاصيتا BST وكومة
# شجرة متوازنة عشوائيا بلا مولد أرقام خارجي

دالة أولوية(مفتاح):
  ارجع ((مفتاح * 1103515245 + 12345) % 2147483648) % 1000

دالة عقدة_جديدة(مفتاح):
  ارجع {"مفتاح": مفتاح, "أولوية": أولوية(مفتاح), "يسار": لا_شيء, "يمين": لا_شيء}

دالة أدخل(ع, مفتاح):
  لو ع == لا_شيء:
    ارجع عقدة_جديدة(مفتاح)
  لو مفتاح < ع["مفتاح"]:
    ع["يسار"] = أدخل(ع["يسار"], مفتاح)
    لو ع["يسار"]["أولوية"] > ع["أولوية"]:
      جديد = ع["يسار"]
      ع["يسار"] = جديد["يمين"]
      جديد["يمين"] = ع
      ارجع جديد
  والا:
    ع["يمين"] = أدخل(ع["يمين"], مفتاح)
    لو ع["يمين"]["أولوية"] > ع["أولوية"]:
      جديد = ع["يمين"]
      ع["يمين"] = جديد["يسار"]
      جديد["يسار"] = ع
      ارجع جديد
  ارجع ع

دالة تجول(ع, ناتج):
  لو ع == لا_شيء:
    ارجع
  تجول(ع["يسار"], ناتج)
  ناتج.append(ع["مفتاح"])
  تجول(ع["يمين"], ناتج)

دالة تحقق_كومة(ع):
  لو ع == لا_شيء:
    ارجع صواب
  لو ع["يسار"] != لا_شيء و ع["يسار"]["أولوية"] > ع["أولوية"]:
    ارجع خطأ
  لو ع["يمين"] != لا_شيء و ع["يمين"]["أولوية"] > ع["أولوية"]:
    ارجع خطأ
  ارجع تحقق_كومة(ع["يسار"]) و تحقق_كومة(ع["يمين"])

جذر = لا_شيء
لكل م في [5, 3, 8, 1, 4, 7, 9, 2, 6]:
  جذر = أدخل(جذر, م)
ناتج = []
تجول(جذر, ناتج)
تأكد_يساوي(ناتج, [1, 2, 3, 4, 5, 6, 7, 8, 9], "ترتيب BST")
تأكد_يساوي(تحقق_كومة(جذر), صواب, "خاصية الكومة")
تأكد_يساوي(جذر["مفتاح"], 9, "أعلى أولوية في الجذر")
اطبع "أولوية الجذر:", جذر["أولوية"]
