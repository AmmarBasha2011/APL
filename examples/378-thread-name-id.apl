# مثال 378 — أسماء الخيوط
# Thread names
# Demonstrates: تسمية وتتبع
#
# Run:  python apl.py examples/378-thread-name-id.apl

دالة مهمة():
    اطبع "أعمل في:", ثريد_حالي().name

المتغير خيوط = []
لكل اسم in ["عامل-أ", "عامل-ب"]:
    المتغير ت = أنشئ_ثريد(target=مهمة, name=اسم)
    خيوط.أضف(ت)
    ت.start()
لكل ت في خيوط:
    ت.join()

اطبع "عدد الخيوط النشطة:", عداد_ثريدات()
