# مثال 1495 — عنوان MAC صحيح
# Validate MAC address
# Demonstrates: تحليل
#
# Run:  python apl.py examples/1495-mac-address-valid.apl

# نفصل على النقطتين
# كل جزء حرفان من الأرقام السداسية العشرية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ماك_صحيح(نص_):
  أجزاء = نص_.split(":")
  لو طول(أجزاء) != 6:
    ارجع خطأ
  مسموح = "0123456789abcdefABCDEF"
  لكل ج في أجزاء:
    لو طول(ج) != 2:
      ارجع خطأ
    لكل ح في ج:
      موجود = ح في مسموح
      لو موجود == خطأ:
        ارجع خطأ
  ارجع صواب

تأكد_يساوي(ماك_صحيح("00:1A:2b:3C:4d:5E"), صواب, "صحيح")
تأكد_يساوي(ماك_صحيح("00:1A:2b:3C:4d"), خطأ, "ناقص")
تأكد_يساوي(ماك_صحيح("00:1A:2b:3C:4d:5G"), خطأ, "حرف خاطئ")
