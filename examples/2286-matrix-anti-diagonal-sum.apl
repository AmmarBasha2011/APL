# مثال 2286 — مجموع القطر الثانوي
# Anti diagonal sum
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2286-matrix-anti-diagonal-sum.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ت = 0
  لكل ي في نطاق(طول(م)):
    ت = ت + م[ي][طول(م) - 1 - ي]
  ارجع ت

تأكد_يساوي(ف([[1, 2], [3, 4]]), 5, "حالة 1")
تأكد_يساوي(ف([[5]]), 5, "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), 15, "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), 2, "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), 4, "حالة 5")
