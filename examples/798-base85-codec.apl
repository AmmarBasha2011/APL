# مثال 798 — ترميز Ascii85
# Ascii85 codec
# Demonstrates: أربعة بايتات لخمسة أحرف، حشو
#
# Run:  python apl.py examples/798-base85-codec.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ترميز Ascii85: أربعة بايتات تصبح خمسة أحرف قابلة للطباعة
# Demonstrates: قسمة متكررة على 85, حشو المجموعة الأخيرة, فك عكسي

دالة ترميز_85(بيانات):
  ب = []
  لكل حرف في بيانات:
    ب.append(ترميز_حرف(حرف))
  ناتج = ""
  ي = 0
  طالما ي < طول(ب):
    مجموعة = []
    لكل ك في نطاق(4):
      لو ي + ك < طول(ب):
        مجموعة.append(ب[ي + ك])
      والا:
        مجموعة.append(0)
    قيمة = مجموعة[0] * 16777216 + مجموعة[1] * 65536 + مجموعة[2] * 256 + مجموعة[3]
    أحرف = ["!", "!", "!", "!", "!"]
    لكل ك في نطاق(5):
      أحرف[4 - ك] = فك_ترميز_حرف(33 + قيمة % 85)
      قيمة = قيمة // 85
    متبقي = طول(ب) - ي
    لو متبقي >= 4:
      لكل ح في أحرف:
        ناتج = ناتج + ح
    والا:
      لكل ك في نطاق(متبقي + 1):
        ناتج = ناتج + أحرف[ك]
    ي = ي + 4
  ارجع ناتج

دالة فك_85(مشفر):
  ناتج = ""
  ي = 0
  طالما ي < طول(مشفر):
    متبقي = طول(مشفر) - ي
    عدد = 5
    لو متبقي < 5:
      عدد = متبقي
    قيمة = 0
    لكل ك في نطاق(عدد):
      قيمة = قيمة * 85 + ترميز_حرف(مشفر[ي + ك]) - 33
    لكل ك في نطاق(5 - عدد):
      قيمة = قيمة * 85 + 84
    لكل ك في نطاق(عدد - 1):
      إزاحة = (3 - ك) * 8
      ناتج = ناتج + فك_ترميز_حرف((قيمة // (2 ** إزاحة)) % 256)
    ي = ي + عدد
  ارجع ناتج

تأكد_يساوي(ترميز_85("APL!"), "5u:5u", "أربعة أحرف")
تأكد_يساوي(ترميز_85("hello world"), "BOu!rD]j7BEbo7", "hello world")
تأكد_يساوي(فك_85("5u:5u"), "APL!", "فك أربعة")
تأكد_يساوي(فك_85("BOu!rD]j7BEbo7"), "hello world", "فك hello world")
تأكد_يساوي(فك_85(ترميز_85("12345678")), "12345678", "دورة ثمانية")
