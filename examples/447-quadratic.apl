# مثال 447 — حل المعادلة التربيعية
# Quadratic equation
# Demonstrates: المميز والجذور
#
# Run:  python apl.py examples/447-quadratic.apl

دالة حل_تربيعية(أ, ب, ج):
    المتغير مميز = ب * ب - 4 * أ * ج
    لو مميز < 0:
        ارجع "لا جذور حقيقية"
    لو مميز == 0:
        ارجع [(-ب) / (2 * أ)]
    ارجع [(-ب + جذر(مميز)) / (2 * أ), (-ب - جذر(مميز)) / (2 * أ)]

اطبع حل_تربيعية(1, -3, 2)
اطبع حل_تربيعية(1, 2, 1)
اطبع حل_تربيعية(1, 0, 1)
