# مثال 322 — تسطيح قائمة متداخلة (عودي)
# Flatten a nested list
# Demonstrates: عودية على العمق
#
# Run:  python apl.py examples/322-flatten-nested.apl

دالة سطح(عنصر, نتيجة):
    لو نوع(عنصر) == نوع([]):
        لكل فرعي في عنصر:
            سطح(فرعي, نتيجة)
    الا:
        نتيجة.أضف(عنصر)

دالة تسطيح(قائمة):
    المتغير نتيجة = []
    سطح(قائمة, نتيجة)
    ارجع نتيجة

اطبع تسطيح([1, [2, [3, 4], 5], 6])
اطبع تسطيح([["أ"], ["ب", ["ج"]]])
