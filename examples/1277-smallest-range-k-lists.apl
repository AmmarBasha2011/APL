# مثال 1277 — أصغر مدى
# Smallest range covering k lists
# Demonstrates: نافذة
#
# Run:  python apl.py examples/1277-smallest-range-k-lists.apl

# ندمج كل الأرقام مع رقم قائمتها
# ونطبق نافذة منزلقة تغطي كل القوائم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اصغر_مدى(قوائم):
  ازواج = []
  لكل ع في نطاق(طول(قوائم)):
    لكل س في قوائم[ع]:
      ازواج.ألحق([س, ع])
  ازواج = مفرز(ازواج)
  عد = {}
  يسار = 0
  افضل = [-10 ** 9, 10 ** 9]
  لكل يمين في نطاق(طول(ازواج)):
    ق = ازواج[يمين][1]
    عد[ق] = عد.get(ق, 0) + 1
    طالما طول(عد) == طول(قوائم):
      لو ازواج[يمين][0] - ازواج[يسار][0] < افضل[1] - افضل[0]:
        افضل = [ازواج[يسار][0], ازواج[يمين][0]]
      ل = ازواج[يسار][1]
      عد[ل] = عد[ل] - 1
      لو عد[ل] == 0:
        عد.pop(ل)
      يسار = يسار + 1
  ارجع افضل

تأكد_يساوي(اصغر_مدى([[4,10,15,24,26],[0,9,12,20],[5,18,22,30]]), [20, 24], "مثال أول")
تأكد_يساوي(اصغر_مدى([[1,2,3],[1,2,3],[1,2,3]]), [1, 1], "متطابقة")
