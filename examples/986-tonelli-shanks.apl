# مثال 986 — جذر تونلي-شانكس
# Tonelli-Shanks
# Demonstrates: جذر تربيعي مودولو أولي
#
# Run:  python apl.py examples/986-tonelli-shanks.apl

# تونلي-شانكس: الجذر التربيعي في الحقول المنتهية بترد أولي
# يحل س^2 تطابق ن بترد ب حتى لو كان ب-1 زوجي البنية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة_مود(أ, هـ, م):
  ناتج = 1
  قاعدة = أ % م
  باقي = هـ
  طالما باقي > 0:
    لو (باقي % 2) == 1:
      ناتج = (ناتج * قاعدة) % م
    قاعدة = (قاعدة * قاعدة) % م
    باقي = باقي // 2
  ارجع ناتج

دالة جذر_مود(ن, ب):
  لو قوة_مود(ن, (ب - 1) // 2, ب) != 1:
    ارجع -1
  ق = ب - 1
  س = 0
  طالما (ق % 2) == 0:
    ق = ق // 2
    س = س + 1
  ز = 2
  طالما قوة_مود(ز, (ب - 1) // 2, ب) != (ب - 1):
    ز = ز + 1
  ج = قوة_مود(ز, ق, ب)
  س_حل = قوة_مود(ن, (ق + 1) // 2, ب)
  ت = قوة_مود(ن, ق, ب)
  م = س
  طالما ت != 1:
    i = 1
    ت2 = (ت * ت) % ب
    طالما ت2 != 1:
      ت2 = (ت2 * ت2) % ب
      i = i + 1
    ب_م = قوة_مود(ج, 1 << ((م - i) - 1), ب)
    ج = (ب_م * ب_م) % ب
    س_حل = (س_حل * ب_م) % ب
    ت = (ت * ج) % ب
    م = i
  ارجع س_حل

حل1 = جذر_مود(10, 13)
تأكد_يساوي((حل1 * حل1) % 13, 10, "جذر العشرة بترد 13")
حل2 = جذر_مود(4, 13)
تأكد_يساوي((حل2 * حل2) % 13, 4, "جذر الأربعة بترد 13")
تأكد_يساوي(جذر_مود(5, 13), -1, "لا جذر للخمسة")
