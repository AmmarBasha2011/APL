# مثال 354 — كسر اعتيادي يدوي
# Manual rational numbers
# Demonstrates: تبسيط وجمع الكسور
#
# Run:  python apl.py examples/354-rational.apl

دالة قاسم_مشترك(أ, ب):
    طالما ب != 0:
        المتغير مؤقت = ب
        ب = أ % ب
        أ = مؤقت
    ارجع أ

صنف كسر_يدوي:
    دالة_إنشاء(ذات, فوق_كسر, تحت_كسر):
        المتغير ق = قاسم_مشترك(فوق_كسر, تحت_كسر)
        ذات.فوق_كسر = فوق_كسر // ق
        ذات.تحت_كسر = تحت_كسر // ق

    دالة اجمع(ذات, آخر):
        المتغير ب = ذات.فوق_كسر * آخر.تحت_كسر + آخر.فوق_كسر * ذات.تحت_كسر
        المتغير م = ذات.تحت_كسر * آخر.تحت_كسر
        ارجع كسر_يدوي(ب, م)

    دالة كنص(ذات):
        ارجع نص(ذات.فوق_كسر) + "/" + نص(ذات.تحت_كسر)

المتغير أ = كسر_يدوي(1, 2)
المتغير ب = كسر_يدوي(1, 3)
اطبع "1/2 + 1/3 =", أ.اجمع(ب).كنص()
اطبع "تبسيط 4/8 =", كسر_يدوي(4, 8).كنص()
