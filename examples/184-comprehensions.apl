# مثال 184 — التوليدات الشاملة المتقدمة
# Advanced list comprehensions
# Demonstrates: توليدات القوائم، المعالجة المتسلسلة
#
# Run:  python apl.py examples/184-comprehensions.apl

المتغير مربعات = [س * س لكل س في نطاق(10)]
اطبع "المربعات:", مربعات

المتغير مكعبات = [س * س * س لكل س في نطاق(5)]
اطبع "المكعبات:", مكعبات

المتغير كلمات = ["تفاح", "موز", "كرز"]
المتغير أطوال = [طول(ك) لكل ك في كلمات]
اطبع "الأطوال:", أطوال

المتغير أحرف = [ك[0] لكل ك في كلمات]
اطبع "الأحرف الأولى:", أحرف

المتغير مصفوفة = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
المتغير قطري = [مصفوفة[ي][ي] لكل ي في نطاق(3)]
اطبع "القطري:", قطري

المتغير منقولة = []
لكل ي في نطاق(3):
    المتغير صف_جديد = [مصفوفة[ص][ي] لكل ص في نطاق(3)]
    منقولة.أضف(صف_جديد)
اطبع "المنقولة:", منقولة
