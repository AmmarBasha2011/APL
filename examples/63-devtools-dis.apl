# مثال 63 — تفكيك الشيفرة وتقطيعها (مكتبة devtools)
# Bytecode disassembly (dis), tokenizing (tokenize) and symbol tables (symtable)
#
# Run:  python apl.py examples/63-devtools-dis.apl

دالة ضرب(س, ص):
    ارجع س * ص

اطبع "=== تفكيك الشيفرة (dis) ==="
المتغير تعليمات = قائمة(التعليمات(ضرب))
اطبع "عدد التعليمات:", طول(تعليمات)
لكل ت في تعليمات:
    اطبع "  ", ت.الإزاحة, ت.اسم_الرمز, ت.قيمة_الحجة

اطبع ""
اطبع "=== معلومات الشيفرة ==="
اطبع معلومات_الشيفرة(ضرب)

اطبع ""
اطبع "=== تقطيع الشفرة (tokenize) ==="
مع افتح_ملف_المصدر("examples/63-devtools-dis.apl") مثل م:
    المتغير رموز = قائمة(ولّد_الرموز(م.readline))
    اطبع "عدد الرموز:", طول(رموز)
    المتغير أول = رموز[1]
    اطبع "أول رمز نصي:", أول.النص
    اطبع "نوعه:", أول.النوع

اطبع ""
اطبع "=== جداول الرموز (symtable) ==="
المتغير جدول = جدول_الرموز("x = 1", "تجربة.py", "exec")
اطبع "رموز الجدول:", طول(جدول.الرموز())
اطبع "اسم الجدول:", جدول.اسم_الرمز_الدلالي()
اطبع "نوع النطاق:", جدول.نوع_النطاق()
اطبع "له أبناء:", جدول.له_أبناء()
