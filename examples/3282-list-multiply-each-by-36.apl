# مثال 3282 — ضرب كل عنصر في 36
# Multiply each item by 36
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3282-list-multiply-each-by-36.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 36]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [108, 36, 72], "حالة 1")
تأكد_يساوي(ف([5]), [180], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [36, 72, 108, 144, 180, 216], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-72, 0, 252, 252, 144], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [360, 720, 360, 1080, 720, 360], "حالة 5")
