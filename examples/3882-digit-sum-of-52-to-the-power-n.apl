# مثال 3882 — مجموع أرقام 52 أس ن
# Digit sum of 52 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3882-digit-sum-of-52-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 52 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 7, "حالة 2")
تأكد_يساوي(ف(5), 22, "حالة 3")
تأكد_يساوي(ف(10), 70, "حالة 4")
تأكد_يساوي(ف(20), 148, "حالة 5")
