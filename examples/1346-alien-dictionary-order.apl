# مثال 1346 — ترتيب قاموس غريب
# Alien dictionary order
# Demonstrates: رسوم بيانية
#
# Run:  python apl.py examples/1346-alien-dictionary-order.apl

# نقارن كل كلمتين متجاورتين لنجد أول حرف مختلف
# ثم نرتب الحروف طوبولوجياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ترتيب_الحروف(كلمات):
  تالي = {}
  دخل = {}
  لكل ك في كلمات:
    لكل ح في ك:
      لو ح ليس في تالي:
        تالي[ح] = []
        دخل[ح] = 0
  لكل ع في نطاق(طول(كلمات) - 1):
    أ = كلمات[ع]
    ب = كلمات[ع + 1]
    لو (طول(أ) > طول(ب)) و (أ[:طول(ب)] == ب):
      ارجع ""
    لكل ج في نطاق(أصغر(طول(أ), طول(ب))):
      لو أ[ج] != ب[ج]:
        لو ب[ج] ليس في تالي[أ[ج]]:
          تالي[أ[ج]].ألحق(ب[ج])
          دخل[ب[ج]] = دخل[ب[ج]] + 1
  طابور = []
  لكل ح في تالي:
    لو دخل[ح] == 0:
      طابور.ألحق(ح)
  ناتج = ""
  ع = 0
  طالما ع < طول(طابور):
    ح = طابور[ع]
    ع = ع + 1
    ناتج = ناتج + ح
    لكل ت في تالي[ح]:
      دخل[ت] = دخل[ت] - 1
      لو دخل[ت] == 0:
        طابور.ألحق(ت)
  لو طول(ناتج) != طول(تالي):
    ارجع ""
  ارجع ناتج

تأكد_يساوي(ترتيب_الحروف(["wrt","wrf","er","ett","rftt"]), "wertf", "مثال أول")
تأكد_يساوي(ترتيب_الحروف(["z","x"]), "zx", "حرفان")
تأكد_يساوي(ترتيب_الحروف(["z","x","z"]), "", "دورة")
