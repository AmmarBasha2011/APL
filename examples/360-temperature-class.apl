# مثال 360 — صنف درجة حرارة
# Temperature class
# Demonstrates: تحويلات بين الوحدات
#
# Run:  python apl.py examples/360-temperature-class.apl

صنف حرارة_ج:
    دالة_إنشاء(ذات, مئوي):
        ذات.مئوي = مئوي

    دالة إلى_فهرنهايت(ذات):
        ارجع ذات.مئوي * 9 / 5 + 32

    دالة إلى_كلفن(ذات):
        ارجع ذات.مئوي + 273.15

    دالة صف(ذات):
        اطبع ذات.مئوي, "°C =", ذات.إلى_فهرنهايت(), "°F =", ذات.إلى_كلفن(), "K"

حرارة_ج(0).صف()
حرارة_ج(100).صف()
المتغير غليان = حرارة_ج((212 - 32) * 5 / 9)
اطبع "212°F =", غليان.مئوي, "°C"
