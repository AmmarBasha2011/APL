# مثال 2647 — ملء الأصفار لعرض 13
# Zero pad to width 13
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2647-pad-number-with-zeros-to-width-13.apl

# # ندخل القيمة
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع نص(ن).zfill(13)

تأكد_يساوي(ف(7), "0000000000007", "حالة 1")
تأكد_يساوي(ف(42), "0000000000042", "حالة 2")
تأكد_يساوي(ف(123), "0000000000123", "حالة 3")
تأكد_يساوي(ف(99999), "0000000099999", "حالة 4")
