# مثال 1572 — أقل عدد أرصفة
# Minimum platforms for trains
# Demonstrates: جشع
#
# Run:  python apl.py examples/1572-minimum-platforms-needed.apl

# نرتب الوصول والمغادرة
# نتحرك بمؤشرين ونتتبع القمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أرصفة(وصول, مغادرة):
  وص = []
  مغ = []
  لكل ع في وصول:
    وص.append(ع)
  لكل ع في مغادرة:
    مغ.append(ع)
  وص.sort()
  مغ.sort()
  ي = 0
  ج = 0
  حالي = 0
  أقصى = 0
  طالما ي < طول(وص):
    لو وص[ي] <= مغ[ج]:
      حالي = حالي + 1
      ي = ي + 1
      لو حالي > أقصى:
        أقصى = حالي
    والا:
      حالي = حالي - 1
      ج = ج + 1
  ارجع أقصى

تأكد_يساوي(أرصفة([900, 940, 950, 1100, 1500, 1800], [910, 1200, 1120, 1130, 1900, 2000]), 3, "ثلاثة")
تأكد_يساوي(أرصفة([100, 300], [200, 400]), 1, "بلا تزامن")
