# مثال 903 — تباعد كولباك-لايبلر
# KL divergence
# Demonstrates: لوغاريتم نسبة التوزيعين
#
# Run:  python apl.py examples/903-kl-divergence.apl

# تباعد كولباك-لايبلر: قياس بعد توزيعين احتماليين
# D(P||Q) = مجموع p(x) * log2(p(x)/q(x))

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة لوغ2(س):
  ارجع لوغاريتم(س) / لوغاريتم(2)

دالة تباعد(ب, ق):
  مجموع = 0
  لكل i في نطاق(طول(ب)):
    لو ب[i] > 0:
      مجموع = مجموع + ب[i] * لوغ2(ب[i] / ق[i])
  ارجع مجموع

ب = [0.5, 0.25, 0.25]
ق = [0.25, 0.5, 0.25]
د = تباعد(ب, ق)
اطبع "D(P||Q) =", د

# بالضبط 0.25 بت: حساب مباشر
تأكد_يساوي(مقرب(د, 6), 0.25, "D(P||Q) = 0.25")

# ليس متماثلاً: توزيعان آخران يعطيان قيمتين مختلفتين بالاتجاهين
ب2 = [0.6, 0.4]
ق2 = [0.3, 0.7]
تأكد_يساوي(مقرب(تباعد(ب2, ق2), 6), 0.277058, "D(P2||Q2)")
تأكد_يساوي(مقرب(تباعد(ق2, ب2), 6), 0.265148, "D(Q2||P2) يختلف عن العكس")

# التوزيع نفسه يعطي صفراً
تأكد_يساوي(مقرب(تباعد(ب, ب), 9), 0, "D(P||P) = 0")
