# مثال 292 — أطول مقطع متناظر
# Longest palindromic substring
# Demonstrates: التوسع من المركز
#
# Run:  python apl.py examples/292-longest-palindrome-sub.apl

دالة وسع(نص_الدخل, أيسر, أيمن):
    طالما أيسر >= 0 و أيمن < طول(نص_الدخل) و نص_الدخل[أيسر] == نص_الدخل[أيمن]:
        أيسر = أيسر - 1
        أيمن = أيمن + 1
    ارجع نص_الدخل[أيسر + 1:أيمن]

دالة أطول_متناظر(نص_الدخل):
    المتغير أفضل = ""
    لكل ي في نطاق(طول(نص_الدخل)):
        المتغير فردي = وسع(نص_الدخل, ي, ي)
        المتغير زوجي = وسع(نص_الدخل, ي, ي + 1)
        لو طول(فردي) > طول(أفضل):
            أفضل = فردي
        لو طول(زوجي) > طول(أفضل):
            أفضل = زوجي
    ارجع أفضل

اطبع أطول_متناظر("babad")
اطبع أطول_متناظر("cbbd")
اطبع أطول_متناظر("racecar")
