# مثال 340 — قائمة تواريخ شهر
# Dates of a month
# Demonstrates: توليد كل أيام شهر
#
# Run:  python apl.py examples/340-date-list.apl

دالة تواريخ_الشهر(س, ش):
    المتغير ت = تاريخ(س, ش, 1)
    المتغير نتيجة = []
    طالما ت.month == ش:
        نتيجة.أضف(نص(ت))
        ت = ت + مدة(أيام=1)
    ارجع نتيجة

المتغير قائمة = تواريخ_الشهر(2026, 2)
اطبع "أيام فبراير 2026:", طول(قائمة)
اطبع "أولها:", قائمة[0]
اطبع "آخرها:", قائمة[-1]
