# مثال 1600 — هل الشجرة بحث ثنائية
# Validate binary search tree
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1600-valid-bst-check.apl

# اليسار أصغر من الجذر واليمين أكبر
# نمرر الحدين نزولاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صالحة(ش, أدنى, أعلى):
  لو ش == []:
    ارجع صواب
  لو ش[0] <= أدنى أو ش[0] >= أعلى:
    ارجع خطأ
  ارجع صالحة(ش[1], أدنى, ش[0]) و صالحة(ش[2], ش[0], أعلى)

دالة شجرة_بحث(ش):
  ارجع صالحة(ش, -1000000, 1000000)

تأكد_يساوي(شجرة_بحث([2, [1, [], []], [3, [], []]]), صواب, "صالحة")
تأكد_يساوي(شجرة_بحث([5, [1, [], []], [4, [3, [], []], [6, [], []]]]), خطأ, "حفيد خاطئ")
تأكد_يساوي(شجرة_بحث([]), صواب, "فارغة")
