# مثال 3025 — مجموع قوى 25
# Sum of powers of 25
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3025-sum-of-powers-of-25-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 25 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 26, "حالة 2")
تأكد_يساوي(ف(3), 16276, "حالة 3")
تأكد_يساوي(ف(6), 254313151, "حالة 4")
تأكد_يساوي(ف(10), 99341074625651, "حالة 5")
