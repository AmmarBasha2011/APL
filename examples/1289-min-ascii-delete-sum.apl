# مثال 1289 — أقل مجموع حذف
# Minimum ASCII delete sum for two strings
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1289-min-ascii-delete-sum.apl

# نحسب أكبر مجموع رموز لمتتالية مشتركة
# والباقي هو المحذوف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_مجموع_حذف(أ, ب):
  د = []
  لكل ع في نطاق(طول(أ) + 1):
    د.ألحق([0] * (طول(ب) + 1))
  لكل ع في نطاق(1, طول(أ) + 1):
    لكل ج في نطاق(1, طول(ب) + 1):
      لو أ[ع - 1] == ب[ج - 1]:
        د[ع][ج] = د[ع - 1][ج - 1] + ord(أ[ع - 1])
      والا:
        د[ع][ج] = أكبر(د[ع - 1][ج], د[ع][ج - 1])
  كل = 0
  لكل ح في أ + ب:
    كل = كل + ord(ح)
  ارجع كل - 2 * د[طول(أ)][طول(ب)]

تأكد_يساوي(اقل_مجموع_حذف("sea", "eat"), 231, "مثال أول")
تأكد_يساوي(اقل_مجموع_حذف("delete", "leet"), 403, "مثال ثان")
تأكد_يساوي(اقل_مجموع_حذف("a", "a"), 0, "متطابقان")
