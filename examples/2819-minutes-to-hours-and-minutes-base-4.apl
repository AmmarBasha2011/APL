# مثال 2819 — تحويل وحدة بأساس 4
# Split by base 4
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2819-minutes-to-hours-and-minutes-base-4.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 4, ن % 4]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [14, 3], "حالة 2")
تأكد_يساوي(ف(60), [15, 0], "حالة 3")
تأكد_يساوي(ف(125), [31, 1], "حالة 4")
تأكد_يساوي(ف(1000), [250, 0], "حالة 5")
