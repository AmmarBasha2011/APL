# مثال 3251 — مساحة مستطيل مكبر 9 مرات
# Rectangle area scaled by 9
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3251-rectangle-area-scaled-by-9.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 9) * (ق[1] * 9)

تأكد_يساوي(ف([1, 2]), 162, "حالة 1")
تأكد_يساوي(ف([3, 4]), 972, "حالة 2")
تأكد_يساوي(ف([5, 5]), 2025, "حالة 3")
تأكد_يساوي(ف([10, 1]), 810, "حالة 4")
