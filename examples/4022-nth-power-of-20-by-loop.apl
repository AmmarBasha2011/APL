# مثال 4022 — قوة 20 بالحلقة
# Power of 20 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4022-nth-power-of-20-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 20
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 20, "حالة 2")
تأكد_يساوي(ف(3), 8000, "حالة 3")
تأكد_يساوي(ف(6), 64000000, "حالة 4")
تأكد_يساوي(ف(10), 10240000000000, "حالة 5")
