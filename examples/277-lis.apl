# مثال 277 — أطول متتالية متزايدة
# Longest increasing subsequence
# Demonstrates: برمجة ديناميكية على المتتاليات
#
# Run:  python apl.py examples/277-lis.apl

دالة أطول_متزايدة(قائمة):
    المتغير ن = طول(قائمة)
    المتغير أطوال = [1 لكل _ في نطاق(ن)]
    لكل ي في نطاق(1, ن):
        لكل ز في نطاق(ي):
            لو قائمة[ز] < قائمة[ي] و أطوال[ز] + 1 > أطوال[ي]:
                أطوال[ي] = أطوال[ز] + 1
    المتغير أطول = أطوال[0]
    لكل ط في أطوال:
        لو ط > أطول:
            أطول = ط
    ارجع أطول

اطبع أطول_متزايدة([10, 9, 2, 5, 3, 7, 101, 18])
اطبع أطول_متزايدة([0, 1, 0, 3, 2, 3])
