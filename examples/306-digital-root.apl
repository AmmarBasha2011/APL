# مثال 306 — الجذر الرقمي
# Digital root
# Demonstrates: جمع الأرقام حتى خانة واحدة
#
# Run:  python apl.py examples/306-digital-root.apl

دالة جذر_رقمي(عدد):
    طالما عدد >= 10:
        المتغير مجموع = 0
        لكل رقم في نص(عدد):
            مجموع = مجموع + صحيح(رقم)
        عدد = مجموع
    ارجع عدد

اطبع "38:", جذر_رقمي(38)
اطبع "999:", جذر_رقمي(999)
اطبع "12345:", جذر_رقمي(12345)
