# مثال 1111 — مصفوفة اللقطات
# Snapshot array
# Demonstrates: تاريخ لكل فهرس
#
# Run:  python apl.py examples/1111-snapshot-array.apl

# لكل فهرس قائمة أزواج (رقم اللقطة، القيمة)
# والقراءة تأخذ آخر قيمة رقم لقطتها لا يتجاوز المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مصفوفة_لقطات:
    دالة_إنشاء(ذات, ن):
        ذات.تاريخ = []
        لكل ع في نطاق(ن):
            ذات.تاريخ.ألحق([[0, 0]])
        ذات.رقم = 0

    دالة ضع(ذات, فهرس, قيمة):
        ذات.تاريخ[فهرس].ألحق([ذات.رقم, قيمة])

    دالة لقطة(ذات):
        ذات.رقم = ذات.رقم + 1
        ارجع ذات.رقم - 1

    دالة اقرأ(ذات, فهرس, رقم_لقطة):
        نتيجة = 0
        لكل زوج في ذات.تاريخ[فهرس]:
            لو زوج[0] <= رقم_لقطة:
                نتيجة = زوج[1]
        ارجع نتيجة

م = مصفوفة_لقطات(3)
م.ضع(0, 5)
تأكد_يساوي(م.لقطة(), 0, "اللقطة الأولى")
م.ضع(0, 6)
تأكد_يساوي(م.اقرأ(0, 0), 5, "القيمة في اللقطة 0")
تأكد_يساوي(م.لقطة(), 1, "اللقطة الثانية")
تأكد_يساوي(م.اقرأ(0, 1), 6, "القيمة في اللقطة 1")
تأكد_يساوي(م.اقرأ(2, 1), 0, "فهرس لم يتغير")
