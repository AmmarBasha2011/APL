# مثال 1437 — ثلاث نقاط على استقامة
# Three points collinear check
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1437-collinear-three-points.apl

# الجداء التقاطعي للفرقين صفر عند الاستقامة
# لا حاجة لقسمة أو جذر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة على_استقامة(أ, ب, ج):
  ارجع (ب[0] - أ[0]) * (ج[1] - أ[1]) - (ب[1] - أ[1]) * (ج[0] - أ[0]) == 0

تأكد_يساوي(على_استقامة([0,0], [1,1], [2,2]), صواب, "استقامة")
تأكد_يساوي(على_استقامة([0,0], [1,1], [2,3]), خطأ, "ليست مستقيمة")
تأكد_يساوي(على_استقامة([1,1], [1,1], [5,7]), صواب, "نقطتان متطابقتان")
