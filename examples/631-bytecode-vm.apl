# مثال 631 — آلة بايت-كود افتراضية
# Bytecode VM
# Demonstrates: آلة افتراضية، مكدس، تعليمات
#
# Run:  python apl.py examples/631-bytecode-vm.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# آلة افتراضية كومة: مفسر بايت-كود مصغر
# Demonstrates: حلقة إرسال, مكدس operands, تعليمات
# هكذا تنفذ الآلات الافتراضية البرامج المترجمة

دالة نفذ(برنامج):
  مكدس = []
  مؤشر = 0
  مطبوع = []
  طالما مؤشر < طول(برنامج):
    تعليمة = برنامج[مؤشر]
    مؤشر = مؤشر + 1
    لو تعليمة[0] == "ادفع":
      مكدس.append(تعليمة[1])
    لو تعليمة[0] == "اجمع":
      ب = مكدس.pop()
      أ = مكدس.pop()
      مكدس.append(أ + ب)
    لو تعليمة[0] == "اضرب":
      ب = مكدس.pop()
      أ = مكدس.pop()
      مكدس.append(أ * ب)
    لو تعليمة[0] == "اطرح":
      ب = مكدس.pop()
      أ = مكدس.pop()
      مكدس.append(أ - ب)
    لو تعليمة[0] == "اطبع":
      مطبوع.append(مكدس.pop())
  ارجع مطبوع

برنامج = [["ادفع", 2], ["ادفع", 3], ["اجمع"], ["ادفع", 4], ["اضرب"], ["اطبع"], ["ادفع", 10], ["ادفع", 3], ["اطرح"], ["اطبع"]]
ناتج = نفذ(برنامج)
اطبع "المطبوع:", ناتج
تأكد_يساوي(ناتج, [20, 7], "(2+3)*4 ثم 10-3")
تأكد_يساوي(نفذ([["ادفع", 6], ["ادفع", 7], ["اضرب"], ["اطبع"]]), [42], "ضرب وحيد")
