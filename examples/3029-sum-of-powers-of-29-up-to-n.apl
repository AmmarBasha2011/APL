# مثال 3029 — مجموع قوى 29
# Sum of powers of 29
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3029-sum-of-powers-of-29-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 29 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 30, "حالة 2")
تأكد_يساوي(ف(3), 25260, "حالة 3")
تأكد_يساوي(ف(6), 616067011, "حالة 4")
تأكد_يساوي(ف(10), 435732491632351, "حالة 5")
