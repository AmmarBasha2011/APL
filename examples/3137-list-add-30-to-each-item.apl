# مثال 3137 — إضافة 30 لكل عنصر
# Add 30 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3137-list-add-30-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 30]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [33, 31, 32], "حالة 1")
تأكد_يساوي(ف([5]), [35], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [31, 32, 33, 34, 35, 36], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [28, 30, 37, 37, 34], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [40, 50, 40, 60, 50, 40], "حالة 5")
