# مثال 1108 — دليل أرقام الهاتف
# Phone directory
# Demonstrates: قائمة الأرقام الحرة
#
# Run:  python apl.py examples/1108-phone-directory.apl

# قائمة بالأرقام المتاحة نأخذ منها أول رقم
# ونعيد الرقم المحرر لنهاية القائمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف دليل:
    دالة_إنشاء(ذات, سعة):
        ذات.حرة = قائمة(نطاق(سعة))

    دالة هات(ذات):
        لو طول(ذات.حرة) == 0:
            ارجع -1
        ارجع ذات.حرة.pop(0)

    دالة متاح(ذات, رقم):
        ارجع رقم في ذات.حرة

    دالة حرر(ذات, رقم):
        لو رقم ليس في ذات.حرة:
            ذات.حرة.ألحق(رقم)

د = دليل(3)
تأكد_يساوي(د.هات(), 0, "أول رقم")
تأكد_يساوي(د.هات(), 1, "ثاني رقم")
تأكد_يساوي(د.متاح(2), صواب, "2 متاح")
تأكد_يساوي(د.هات(), 2, "ثالث رقم")
تأكد_يساوي(د.متاح(2), خطأ, "2 محجوز")
تأكد_يساوي(د.هات(), -1, "نفدت الأرقام")
د.حرر(2)
تأكد_يساوي(د.متاح(2), صواب, "2 عاد")
