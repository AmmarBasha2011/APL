# مثال 4423 — قوة 35 بالحلقة
# Power of 35 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4423-nth-power-of-35-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 35
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 35, "حالة 2")
تأكد_يساوي(ف(3), 42875, "حالة 3")
تأكد_يساوي(ف(6), 1838265625, "حالة 4")
تأكد_يساوي(ف(10), 2758547353515625, "حالة 5")
