# مثال 3909 — الحد النوني بخطوة 54
# Nth term step 54
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3909-nth-term-arithmetic-sequence-step-54.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 54

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 57, "حالة 2")
تأكد_يساوي(ف(10), 489, "حالة 3")
تأكد_يساوي(ف(100), 5349, "حالة 4")
