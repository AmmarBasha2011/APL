# مثال 4266 — إضافة 61 لكل عنصر
# Add 61 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4266-list-add-61-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 61]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [64, 62, 63], "حالة 1")
تأكد_يساوي(ف([5]), [66], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [62, 63, 64, 65, 66, 67], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [59, 61, 68, 68, 65], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [71, 81, 71, 91, 81, 71], "حالة 5")
