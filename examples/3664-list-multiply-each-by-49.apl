# مثال 3664 — ضرب كل عنصر في 49
# Multiply each item by 49
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3664-list-multiply-each-by-49.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 49]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [147, 49, 98], "حالة 1")
تأكد_يساوي(ف([5]), [245], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [49, 98, 147, 196, 245, 294], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-98, 0, 343, 343, 196], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [490, 980, 490, 1470, 980, 490], "حالة 5")
