# مثال 1374 — لعبة الحجارة الثانية
# Stone game II
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1374-stone-game-two.apl

# م يتغير بحسب آخر أخذ
# نستخدم مجاميع اللواحق وجدول الحالات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقصى_حجارة(أكوام):
  ن = طول(أكوام)
  لاحقة = [0] * (ن + 1)
  لكل ع في نطاق(ن - 1, -1, -1):
    لاحقة[ع] = لاحقة[ع + 1] + أكوام[ع]
  د = []
  لكل ع في نطاق(ن + 1):
    د.ألحق([0] * (ن + 1))
  لكل ع في نطاق(ن - 1, -1, -1):
    لكل م في نطاق(1, ن + 1):
      لو ع + 2 * م >= ن:
        د[ع][م] = لاحقة[ع]
      والا:
        افضل = 0
        لكل س في نطاق(1, 2 * م + 1):
          قيمة = لاحقة[ع] - د[ع + س][أكبر(م, س)]
          لو قيمة > افضل:
            افضل = قيمة
        د[ع][م] = افضل
  ارجع د[0][1]

تأكد_يساوي(اقصى_حجارة([2,7,9,4,4]), 10, "عشرة")
تأكد_يساوي(اقصى_حجارة([1,2,3,4,5,100]), 104, "مئة وأربعة")
تأكد_يساوي(اقصى_حجارة([5]), 5, "كومة واحدة")
