# مثال 601 — شجرة AVL
# AVL tree
# Demonstrates: AVL، تدويرات، اتزان
#
# Run:  python apl.py examples/601-avl-tree.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شجرة AVL: شجرة بحث ذاتية الاتزان بالتدويرات
# Demonstrates: تدوير يمين ويسار, عامل الاتزان, إدراج متزن
# إدراج 10 ثم 20 ثم 30 يسبب تدويرا يساريا

دالة ارتفاع(عقدة):
  لو عقدة == لا_شيء:
    ارجع 0
  ارجع عقدة["ارتفاع"]

دالة حدّث_ارتفاع(عقدة):
  عقدة["ارتفاع"] = 1 + أكبر(ارتفاع(عقدة["يسار"]), ارتفاع(عقدة["يمين"]))

دالة دوّر_يسار(جذر):
  جديد = جذر["يمين"]
  جذر["يمين"] = جديد["يسار"]
  جديد["يسار"] = جذر
  حدّث_ارتفاع(جذر)
  حدّث_ارتفاع(جديد)
  ارجع جديد

دالة دوّر_يمين(جذر):
  جديد = جذر["يسار"]
  جذر["يسار"] = جديد["يمين"]
  جديد["يمين"] = جذر
  حدّث_ارتفاع(جذر)
  حدّث_ارتفاع(جديد)
  ارجع جديد

دالة أدرج(عقدة, قيمة):
  لو عقدة == لا_شيء:
    ارجع {"قيمة": قيمة, "يسار": لا_شيء, "يمين": لا_شيء, "ارتفاع": 1}
  لو قيمة < عقدة["قيمة"]:
    عقدة["يسار"] = أدرج(عقدة["يسار"], قيمة)
  والا:
    عقدة["يمين"] = أدرج(عقدة["يمين"], قيمة)
  حدّث_ارتفاع(عقدة)
  اتزان = ارتفاع(عقدة["يسار"]) - ارتفاع(عقدة["يمين"])
  لو اتزان < -1:
    لو قيمة < عقدة["يمين"]["قيمة"]:
      عقدة["يمين"] = دوّر_يمين(عقدة["يمين"])
    ارجع دوّر_يسار(عقدة)
  لو اتزان > 1:
    لو قيمة > عقدة["يسار"]["قيمة"]:
      عقدة["يسار"] = دوّر_يسار(عقدة["يسار"])
    ارجع دوّر_يمين(عقدة)
  ارجع عقدة

جذر = لا_شيء
لكل قيمة في [10, 20, 30, 40, 50, 25]:
  جذر = أدرج(جذر, قيمة)
اطبع "الجذر:", جذر["قيمة"], " والارتفاع:", جذر["ارتفاع"]
تأكد_يساوي(جذر["قيمة"], 30, "الجذر بعد التدويرات")
تأكد_يساوي(جذر["ارتفاع"], 3, "ارتفاع متزن لست قيم")
تأكد_يساوي(جذر["يسار"]["قيمة"], 20, "يسار الجذر")
