# مثال 472 — محدد محاولات الدخول
# Login attempt limiter
# Demonstrates: قفل بعد 3 محاولات
#
# Run:  python apl.py examples/472-login-limiter.apl

المتغير كلمة_صحيحة = "سر123"
المتغير محاولات = ["خطأ1", "خطأ2", "خطأ3", "سر123"]
المتغير فاشلة = 0
المتغير مقفل = خطأ

لكل محاولة في محاولات:
    لو مقفل:
        اطبع "الحساب مقفل"
        توقف
    لو محاولة == كلمة_صحيحة:
        اطبع "دخول ناجح"
        توقف
    الا:
        فاشلة = فاشلة + 1
        اطبع "محاولة خاطئة", فاشلة
        لو فاشلة >= 3:
            مقفل = صواب
