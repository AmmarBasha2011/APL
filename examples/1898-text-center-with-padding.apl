# مثال 1898 — توسيط نص بحشو
# Center text with padding
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1898-text-center-with-padding.apl

# نحسب الحشو الكلي
# اليسار نصف والباقي لليمين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كرر(ح, ن):
  خرج = ""
  لكل ك في نطاق(ن):
    خرج = خرج + ح
  ارجع خرج

دالة وسط(نص, عرض, ح):
  لو طول(نص) >= عرض:
    ارجع نص
  كلي = عرض - طول(نص)
  يسار = كلي // 2
  ارجع كرر(ح, يسار) + نص + كرر(ح, كلي - يسار)

تأكد_يساوي(وسط("hi", 6, "*"), "**hi**", "زوجي")
تأكد_يساوي(وسط("abc", 6, "-"), "-abc--", "فردي")
تأكد_يساوي(وسط("long", 2, "*"), "long", "أطول من العرض")
