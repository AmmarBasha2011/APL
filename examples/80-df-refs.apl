# مثال 80 — المراجع والسياق والفروق (مكتبة datafiles)
# Weak references, context managers and diffs
# (weakref / contextlib / contextvars / difflib)
#
# Run:  python apl.py examples/80-df-refs.apl

صنف عنصر:
    دالة_إنشاء(ذات, اسم):
        ذات.اسم = اسم

اطبع "=== قاموس قيم ضعيفة ==="
المتغير ق = قاموس_قيم_ضعيفة()
المتغير ك = عنصر("أول")
ق["م"] = ك
اطبع "القيمة:", ق["م"].اسم
اطبع "عدد العناصر:", طول(ق)

اطبع ""
اطبع "=== مرجع ضعيف مباشر ==="
المتغير مرجع = مرجع_نوع(ك)
اطبع "إلى ماذا يشير:", مرجع().اسم

اطبع ""
اطبع "=== سياق متغير ==="
المتغير م = سياق_متغير("افتراضي")
م.سياق_متغير_عيّن("قيمة جديدة")
اطبع "القيمة:", م.سياق_متغير_احصل()

اطبع ""
اطبع "=== فروق نصية ==="
المتغير أ = "أهلاً بالعالم"
المتغير ب = "أهلاً بالكوكب"
المتغير م_ط = مطابق_التسلسل(None, أ, ب)
اطبع "نسبة التطابق:", م_ط.تسلسل_مطابِق_نسبة()

اطبع ""
اطبع "=== أقرب التطابقات ==="
المتغير كلمات = ["تفاح", "موز", "عنب", "برتقال"]
اطبع احصل_على_أقرب_التطابقات("تفاحة", كلمات, 3)

