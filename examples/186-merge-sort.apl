# مثال 186 — ترتيب الدمج
# Merge sort
# Demonstrates: العودية، تقسيم القوائم
#
# Run:  python apl.py examples/186-merge-sort.apl

دالة دمج(أيسر, أيمن):
    المتغير نتيجة = []
    طالما طول(أيسر) > 0 و طول(أيمن) > 0:
        لو أيسر[0] <= أيمن[0]:
            نتيجة.أضف(أيسر.pop(0))
        الا:
            نتيجة.أضف(أيمن.pop(0))
    ارجع نتيجة + أيسر + أيمن

دالة ترتيب_دمج(قائمة):
    لو طول(قائمة) <= 1:
        ارجع قائمة
    المتغير منتصف = طول(قائمة) // 2
    المتغير أيسر = ترتيب_دمج(قائمة[0:منتصف])
    المتغير أيمن = ترتيب_دمج(قائمة[منتصف:])
    ارجع دمج(أيسر, أيمن)

المتغير أرقام = [38, 27, 43, 3, 9, 82, 10]
اطبع "قبل:", أرقام
اطبع "بعد:", ترتيب_دمج(أرقام)
