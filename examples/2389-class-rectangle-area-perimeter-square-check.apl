# مثال 2389 — صنف مستطيل
# Rectangle class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2389-class-rectangle-area-perimeter-square-check.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مستطيل:
    دالة_إنشاء(ذات, ط, ع):
        ذات.ط = ط
        ذات.ع = ع

    دالة مساحة(ذات):
        ارجع ذات.ط * ذات.ع

    دالة محيط(ذات):
        ارجع 2 * (ذات.ط + ذات.ع)

    دالة مربع(ذات):
        ارجع ذات.ط == ذات.ع

م = مستطيل(3, 4)
تأكد_يساوي(م.مساحة(), 12, "مساحة")
تأكد_يساوي(م.محيط(), 14, "محيط")
تأكد_يساوي(م.مربع(), خطأ, "ليس مربعا")
تأكد_يساوي(مستطيل(5, 5).مربع(), صواب, "مربع")
