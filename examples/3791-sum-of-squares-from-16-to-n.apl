# مثال 3791 — مجموع المربعات من 16 إلى ن
# Sum of squares from 16
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3791-sum-of-squares-from-16-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(16, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(16), 256, "حالة 1")
تأكد_يساوي(ف(17), 545, "حالة 2")
تأكد_يساوي(ف(26), 4961, "حالة 3")
تأكد_يساوي(ف(100), 337110, "حالة 4")
