# مثال 3115 — إزاحة يمين 8
# Shift right by 8
# Demonstrates: بتات
#
# Run:  python apl.py examples/3115-shift-right-by-8-bits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 8

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(16), 0, "حالة 2")
تأكد_يساوي(ف(255), 0, "حالة 3")
تأكد_يساوي(ف(1000), 3, "حالة 4")
تأكد_يساوي(ف(65535), 255, "حالة 5")
