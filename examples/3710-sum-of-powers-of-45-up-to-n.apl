# مثال 3710 — مجموع قوى 45
# Sum of powers of 45
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3710-sum-of-powers-of-45-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 45 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 46, "حالة 2")
تأكد_يساوي(ف(3), 93196, "حالة 3")
تأكد_يساوي(ف(6), 8492487571, "حالة 4")
تأكد_يساوي(ف(10), 34824506845925071, "حالة 5")
