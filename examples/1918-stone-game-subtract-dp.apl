# مثال 1918 — لعبة الحجارة بالطرح
# Subtract stones game DP
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1918-stone-game-subtract-dp.apl

# نأخذ ١ أو ٢ أو ٣ حجارة
# نبني الحالات من الصغير للكبير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يربح(ن):
  ر = [خطأ]
  لكل ك في نطاق(1, ن + 1):
    ربح = خطأ
    لكل خ في [1, 2, 3]:
      لو ك - خ >= 0 و ر[ك - خ] == خطأ:
        ربح = صواب
    ر = ر + [ربح]
  ارجع ر[ن]

تأكد_يساوي(يربح(4), خطأ, "٤ خسارة")
تأكد_يساوي(يربح(5), صواب, "٥ ربح")
تأكد_يساوي(يربح(8), خطأ, "٨ خسارة")
تأكد_يساوي(يربح(7), صواب, "٧ ربح")
