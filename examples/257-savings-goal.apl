# مثال 257 — هدف الادخار
# Savings goal planner
# Demonstrates: أشهر الوصول للهدف
#
# Run:  python apl.py examples/257-savings-goal.apl

دالة أشهر_الوصول(هدف, شهري, نسبة_سنوية):
    المتغير رصيد = 0
    المتغير أشهر = 0
    المتغير ر = نسبة_سنوية / 100 / 12
    طالما رصيد < هدف و أشهر < 1200:
        رصيد = رصيد * (1 + ر) + شهري
        أشهر = أشهر + 1
    ارجع [أشهر, مقرب(رصيد, 2)]

المتغير ن = أشهر_الوصول(50000, 1000, 4)
اطبع "للوصول إلى 50000 ادخارا:", ن[0], "شهرا"
اطبع "الرصيد حينها:", ن[1]
اطبع "أي حوالي", مقرب(ن[0] / 12, 1), "سنة"
