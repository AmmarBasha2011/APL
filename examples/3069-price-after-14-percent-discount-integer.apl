# مثال 3069 — السعر بعد خصم 14 بالمئة
# Price after 14 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3069-price-after-14-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 14 // 100

تأكد_يساوي(ف(100), 86, "حالة 1")
تأكد_يساوي(ف(250), 215, "حالة 2")
تأكد_يساوي(ف(999), 860, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
