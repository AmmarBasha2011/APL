# مثال 3938 — مجموع الأعداد من 38 إلى ن
# Sum from 38 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3938-sum-of-integers-from-38-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(38, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(38), 38, "حالة 1")
تأكد_يساوي(ف(39), 77, "حالة 2")
تأكد_يساوي(ف(48), 473, "حالة 3")
تأكد_يساوي(ف(100), 4347, "حالة 4")
