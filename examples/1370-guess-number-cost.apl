# مثال 1370 — كلفة التخمين
# Guess number higher or lower cost
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1370-guess-number-cost.apl

# كل تخمين خاطئ يكلف قيمة الرقم
# نختار التخمين الذي يقلل أسوأ حالة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كلفة_ضمان(ن):
  د = []
  لكل ع في نطاق(ن + 2):
    د.ألحق([0] * (ن + 2))
  لكل طول_ في نطاق(2, ن + 1):
    لكل بداية في نطاق(1, ن - طول_ + 2):
      نهاية = بداية + طول_ - 1
      افضل = 1000000000
      لكل ك في نطاق(بداية, نهاية + 1):
        كلفة = ك + أكبر(د[بداية][ك - 1], د[ك + 1][نهاية])
        لو كلفة < افضل:
          افضل = كلفة
      د[بداية][نهاية] = افضل
  ارجع د[1][ن]

تأكد_يساوي(كلفة_ضمان(10), 16, "عشرة")
تأكد_يساوي(كلفة_ضمان(1), 0, "واحد")
تأكد_يساوي(كلفة_ضمان(2), 1, "اثنان")
