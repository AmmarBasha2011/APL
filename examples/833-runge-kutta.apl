# مثال 833 — رونغه-كوتا
# Runge-Kutta RK4
# Demonstrates: أربعة ميول مرجحة
#
# Run:  python apl.py examples/833-runge-kutta.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تكامل رونغه-كوتا الرابع: أربعة ميول مرجحة لكل خطوة
# Demonstrates: ميول k1..k4, وزن 1/6, دقة من الدرجة الرابعة

دالة ميل(ز, قيمة):
  ارجع قيمة

دالة ار_كي_فور(خطوة, عدد):
  قيمة = 1.0
  ز = 0.0
  لكل ي في نطاق(عدد):
    ك1 = ميل(ز, قيمة)
    ك2 = ميل(ز + خطوة / 2, قيمة + خطوة * ك1 / 2)
    ك3 = ميل(ز + خطوة / 2, قيمة + خطوة * ك2 / 2)
    ك4 = ميل(ز + خطوة, قيمة + خطوة * ك3)
    قيمة = قيمة + خطوة * (ك1 + 2 * ك2 + 2 * ك3 + ك4) / 6
    ز = ز + خطوة
  ارجع قيمة

تأكد_يساوي(مقرب(ار_كي_فور(0.1, 10), 6), 2.71828, "تقدير هـ بعد عشر خطوات")
تأكد_يساوي(مقرب(ار_كي_فور(0.05, 20), 6), 2.718282, "خطوة أدق")
تأكد_يساوي(مقرب(ار_كي_فور(0.1, 5), 4), 1.6487, "منتصف الطريق")
تأكد_يساوي(مقرب(ار_كي_فور(0.2, 10), 5), 7.38889, "حتى ز=2")
