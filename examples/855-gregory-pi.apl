# مثال 855 — ط بلايبنتز
# Leibniz series for pi
# Demonstrates: متناوبة، تقارب بطيء
#
# Run:  python apl.py examples/855-gregory-pi.apl

# متسلسلة غريغوري-لايبنتز: ط/4 = 1 - 1/3 + 1/5 - 1/7 + ...
# أبسط متسلسلة لط لكنها الأبطأ تقارباً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ط_لايبنتز(حدود):
  مجموع = 0.0
  لكل ك في نطاق(حدود):
    حد = 1.0 / (2 * ك + 1)
    لو ك % 2 == 1:
      حد = -حد
    مجموع = مجموع + حد
  ارجع مجموع * 4.0

ط = ط_لايبنتز(10000)
اطبع "ط بعد 10000 حد:", ط

تأكد_يساوي(مقرب(ط, 2), 3.14, "خانتان عشريتان صحيحتان")
تأكد_يساوي(مقرب(ط, 3), 3.141, "ثلاث خانات")

# التقارب متناوب: الحد الفردي يقلل والزوجي يزيد
ط9 = ط_لايبنتز(9)
ط10 = ط_لايبنتز(10)
تأكد_يساوي(ط9 > ط10, 1 == 1, "التقارب متناوب حول القيمة")
