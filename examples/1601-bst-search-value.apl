# مثال 1601 — البحث في شجرة بحث
# Search in a binary search tree
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1601-bst-search-value.apl

# القيمة الأصغر في اليسار
# نصل إلى العقدة أو إلى الفراغ

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ابحث(ش, قيمة):
  لو ش == []:
    ارجع خطأ
  لو قيمة == ش[0]:
    ارجع صواب
  لو قيمة < ش[0]:
    ارجع ابحث(ش[1], قيمة)
  ارجع ابحث(ش[2], قيمة)

شجرة = [8, [3, [1, [], []], [6, [], []]], [10, [], [14, [], []]]]
تأكد_يساوي(ابحث(شجرة, 6), صواب, "موجود")
تأكد_يساوي(ابحث(شجرة, 7), خطأ, "غير موجود")
تأكد_يساوي(ابحث([], 1), خطأ, "فارغة")
