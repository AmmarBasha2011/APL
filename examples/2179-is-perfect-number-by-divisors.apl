# مثال 2179 — هل العدد تام
# Is number perfect
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2179-is-perfect-number-by-divisors.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن):
    لو ن % ي == 0:
      م = م + ي
  ارجع م == ن و ن > 1

تأكد_يساوي(ف(6), صواب, "حالة 6")
تأكد_يساوي(ف(28), صواب, "حالة 28")
تأكد_يساوي(ف(12), خطأ, "حالة 12")
تأكد_يساوي(ف(496), صواب, "حالة 496")
تأكد_يساوي(ف(1), خطأ, "حالة 1")
