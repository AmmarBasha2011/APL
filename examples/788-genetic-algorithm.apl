# مثال 788 — خوارزمية جينية
# Genetic algorithm
# Demonstrates: انتقاء، عبور، طفرة، LCG حتمي
#
# Run:  python apl.py examples/788-genetic-algorithm.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# خوارزمية جينية لمشكلة Ones-Max: انتقاء، عبور، طفرة
# Demonstrates: مولد عشوائي LCG حتمي, لياقة, نخبة, عبور نقطة واحدة

دالة اهتزاز(حالة):
  ارجع (حالة * 1103515245 + 12345) % 2147483648

دالة لياقة(فرد):
  واحدات = 0
  لكل جين في فرد:
    واحدات = واحدات + جين
  ارجع واحدات

دالة خوارزمية_جينية(بذرة, حجم, طول_كروموسوم, أجيال):
  حالة = بذرة
  سكان = []
  لكل ي في نطاق(حجم):
    فرد = []
    لكل ج في نطاق(طول_كروموسوم):
      حالة = اهتزاز(حالة)
      فرد.append(حالة % 2)
    سكان.append(فرد)
  لكل جيل في نطاق(أجيال):
    لكل ي في نطاق(حجم):
      افضل = ي
      لكل ج في نطاق(ي + 1, حجم):
        لو لياقة(سكان[ج]) > لياقة(سكان[افضل]):
          افضل = ج
      مؤقت = سكان[ي]
      سكان[ي] = سكان[افضل]
      سكان[افضل] = مؤقت
    لو لياقة(سكان[0]) == طول_كروموسوم:
      ارجع [جيل, لياقة(سكان[0])]
    جدد = [سكان[0], سكان[1]]
    طالما طول(جدد) < حجم:
      حالة = اهتزاز(حالة)
      أ = سكان[حالة % 10]
      حالة = اهتزاز(حالة)
      ب = سكان[حالة % 10]
      حالة = اهتزاز(حالة)
      قطع = 1 + حالة % (طول_كروموسوم - 1)
      طفل = []
      لكل ج في نطاق(قطع):
        طفل.append(أ[ج])
      لكل ج في نطاق(قطع, طول_كروموسوم):
        طفل.append(ب[ج])
      طفل_مطفر = []
      لكل جين في طفل:
        حالة = اهتزاز(حالة)
        لو حالة % 100 < 5:
          طفل_مطفر.append(1 - جين)
        والا:
          طفل_مطفر.append(جين)
      جدد.append(طفل_مطفر)
    سكان = جدد
  ارجع [أجيال, لياقة(سكان[0])]

ن = خوارزمية_جينية(7, 20, 16, 50)
تأكد_يساوي(ن[1], 16, "لياقة كاملة")
تأكد_يساوي(ن[0], 14, "التقارب في الجيل 14")
ن2 = خوارزمية_جينية(7, 20, 16, 50)
تأكد_يساوي(ن2[0], ن[0], "حتمية التكرار")
تأكد_يساوي(لياقة([1, 0, 1, 1]), 3, "لياقة بسيطة")
