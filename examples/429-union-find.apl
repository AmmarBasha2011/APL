# مثال 429 — مجموعات منفصلة
# Union-Find
# Demonstrates: دمج واستعلام
#
# Run:  python apl.py examples/429-union-find.apl

دالة جذر_مجموعة(أصل, عقدة):
    طالما أصل[عقدة] != عقدة:
        عقدة = أصل[عقدة]
    ارجع عقدة

دالة ادمج(أصل, أ, ب):
    أصل[جذر_مجموعة(أصل, أ)] = جذر_مجموعة(أصل, ب)

المتغير أصل = {}
لكل ي في نطاق(6):
    أصل[ي] = ي

ادمج(أصل, 0, 1)
ادمج(أصل, 2, 3)
ادمج(أصل, 1, 2)

اطبع "0 و 3 معا؟", جذر_مجموعة(أصل, 0) == جذر_مجموعة(أصل, 3)
اطبع "0 و 4 معا؟", جذر_مجموعة(أصل, 0) == جذر_مجموعة(أصل, 4)
