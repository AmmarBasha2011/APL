# مثال 199 — نظام بنكي بسيط بالكائنات
# Simple banking system with classes
# Demonstrates: صنف، دوال، كشف حساب
#
# Run:  python apl.py examples/199-banking-oop.apl

صنف حساب:
    دالة_إنشاء(ذات, مالك, رصيد):
        ذات.مالك = مالك
        ذات.رصيد = رصيد
        ذات.سجل = []

    دالة أودع(ذات, مبلغ):
        ذات.رصيد = ذات.رصيد + مبلغ
        ذات.سجل.أضف("إيداع: " + نص(مبلغ))
        ارجع ذات.رصيد

    دالة اسحب(ذات, مبلغ):
        لو مبلغ > ذات.رصيد:
            ارجع "رصيد غير كاف"
        ذات.رصيد = ذات.رصيد - مبلغ
        ذات.سجل.أضف("سحب: " + نص(مبلغ))
        ارجع ذات.رصيد

    دالة كشف(ذات):
        اطبع "=== كشف حساب:", ذات.مالك, "==="
        لكل حركة في ذات.سجل:
            اطبع " -", حركة
        اطبع "الرصيد الحالي:", ذات.رصيد

المتغير ح = حساب("أحمد", 1000)
ح.أودع(500)
ح.اسحب(200)
ح.اسحب(5000)
ح.كشف()
