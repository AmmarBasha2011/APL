# مثال 627 — شفرة هامنغ
# Hamming error correction
# Demonstrates: هامنغ، توازع، تصحيح خطأ
#
# Run:  python apl.py examples/627-hamming-ecc.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شفرة هامنغ (7,4): تصحيح خطأ أحادي البت
# Demonstrates: بتات توازع, متلازمة الخطأ, تصحيح ذاتي
# أساس ذاكرة ECC والاتصالات الموثوقة

دالة شفر(بيانات):
  د1 = بيانات[0]
  د2 = بيانات[1]
  د3 = بيانات[2]
  د4 = بيانات[3]
  ت1 = د1 ^ د2 ^ د4
  ت2 = د1 ^ د3 ^ د4
  ت4 = د2 ^ د3 ^ د4
  ارجع [ت1, ت2, د1, ت4, د2, د3, د4]

دالة متلازمة(شفرة):
  س1 = شفرة[0] ^ شفرة[2] ^ شفرة[4] ^ شفرة[6]
  س2 = شفرة[1] ^ شفرة[2] ^ شفرة[5] ^ شفرة[6]
  س4 = شفرة[3] ^ شفرة[4] ^ شفرة[5] ^ شفرة[6]
  ارجع س1 + س2 * 2 + س4 * 4

دالة صحح(شفرة):
  موضع = متلازمة(شفرة)
  لو موضع > 0:
    شفرة[موضع - 1] = 1 - شفرة[موضع - 1]
  ارجع [شفرة[2], شفرة[4], شفرة[5], شفرة[6]]

شفرة = شفر([1, 0, 1, 1])
اطبع "الشفرة:", شفرة
تأكد_يساوي(شفرة, [0, 1, 1, 0, 0, 1, 1], "ترميز 1011")
تأكد_يساوي(صحح(شفرة), [1, 0, 1, 1], "فك سليم")
تالفة = شفرة.copy()
تالفة[4] = 1 - تالفة[4]
تأكد_يساوي(متلازمة(تالفة), 5, "المتلازمة تشير للموضع 5")
تأكد_يساوي(صحح(تالفة), [1, 0, 1, 1], "تصحيح خطأ أحادي")
