# مثال 2454 — اقتطاع أول 5 أحرف
# First 5 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2454-truncate-text-to-first-5-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:5]

تأكد_يساوي(ف("hello world"), "hello", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abcde", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
