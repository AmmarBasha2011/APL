# مثال 4165 — تحويل وحدة بأساس 40
# Split by base 40
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4165-minutes-to-hours-and-minutes-base-40.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 40, ن % 40]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 19], "حالة 2")
تأكد_يساوي(ف(60), [1, 20], "حالة 3")
تأكد_يساوي(ف(125), [3, 5], "حالة 4")
تأكد_يساوي(ف(1000), [25, 0], "حالة 5")
