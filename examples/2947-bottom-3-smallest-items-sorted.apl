# مثال 2947 — أصغر 3 عناصر مرتبة
# Bottom 3 smallest items
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2947-bottom-3-smallest-items-sorted.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع sorted(ق)[:3]

تأكد_يساوي(ف([3, 1, 2]), [1, 2, 3], "حالة 1")
تأكد_يساوي(ف([5]), [5], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [1, 2, 3], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-2, 0, 4], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [10, 10, 10], "حالة 5")
