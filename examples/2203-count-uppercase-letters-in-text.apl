# مثال 2203 — عدد الأحرف الكبيرة
# Count uppercase letters
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2203-count-uppercase-letters-in-text.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح.isupper():
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("Hello World"), 2, "حالة 1")
تأكد_يساوي(ف("abc"), 0, "حالة 2")
تأكد_يساوي(ف("ABC"), 3, "حالة 3")
تأكد_يساوي(ف("aBcD"), 2, "حالة 4")
