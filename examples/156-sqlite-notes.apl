# مثال 156 — دفتر ملاحظات بقاعدة بيانات
# Notes notebook with SQLite
# Demonstrates: افتح_قاعدة، نفذ، جلب_الكل، تأكد
#
# Run:  python apl.py examples/156-sqlite-notes.apl

المتغير مسار = "/tmp/apl_notes.db"
لو موجود(مسار):
    احذف_ملف(مسار)

المتغير قاعدة = افتح_قاعدة(مسار)
المتغير م = قاعدة.مؤشر()
م.نفذ("CREATE TABLE ملاحظات (id INTEGER PRIMARY KEY, النص TEXT, المهمة TEXT)")
م.نفذ("INSERT INTO ملاحظات VALUES (?, ?, ?)", (1, "مراجعة التوثيق", "عمل"))
م.نفذ("INSERT INTO ملاحظات VALUES (?, ?, ?)", (2, "شراء خبز", "بيت"))
م.نفذ("INSERT INTO ملاحظات VALUES (?, ?, ?)", (3, "إصدار APL جديد", "عمل"))
قاعدة.تأكد()

اطبع "ملاحظات العمل:"
لكل صف في م.execute("SELECT id, النص FROM ملاحظات WHERE المهمة = 'عمل'").جلب_الكل():
    اطبع "-", صف[0], ":", صف[1]

قاعدة.أغلق_قاعدة()
احذف_ملف(مسار)
