# مثال 2149 — مكدس يعرف أصغر عنصر فيه
# Min stack class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2149-min-stack-class-constant-time-minimum.apl

# # كل دفع يحدث الأصغر عند الحاجة
# # والسحب يحدثه عند الإزالة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مكدس_ادنى:
    دالة_إنشاء(ذات):
        ذات.عناصر = []
        ذات.ادنى = []

    دالة ادفع(ذات, ع):
        ذات.عناصر = ذات.عناصر + [ع]
        لو طول(ذات.ادنى) == 0 أو ع <= ذات.ادنى[طول(ذات.ادنى) - 1]:
            ذات.ادنى = ذات.ادنى + [ع]

    دالة اسحب(ذات):
        ع = ذات.عناصر.pop()
        لو ع == ذات.ادنى[طول(ذات.ادنى) - 1]:
            ذات.ادنى.pop()
        ارجع ع

    دالة اقل(ذات):
        ارجع ذات.ادنى[طول(ذات.ادنى) - 1]

م = مكدس_ادنى()
م.ادفع(5)
م.ادفع(3)
م.ادفع(7)
م.ادفع(3)
تأكد_يساوي(م.اقل(), 3, "الأصغر ٣")
تأكد_يساوي(م.اسحب(), 3, "سحب ٣")
تأكد_يساوي(م.اقل(), 3, "ما زال ٣")
تأكد_يساوي(م.اسحب(), 7, "سحب ٧")
تأكد_يساوي(م.اسحب(), 3, "سحب ٣ ثانية")
تأكد_يساوي(م.اقل(), 5, "الأصغر ٥")
