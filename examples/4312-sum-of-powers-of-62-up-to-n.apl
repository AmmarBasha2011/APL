# مثال 4312 — مجموع قوى 62
# Sum of powers of 62
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4312-sum-of-powers-of-62-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 62 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 63, "حالة 2")
تأكد_يساوي(ف(3), 242235, "حالة 3")
تأكد_يساوي(ف(6), 57731386987, "حالة 4")
تأكد_يساوي(ف(10), 853058371866181867, "حالة 5")
