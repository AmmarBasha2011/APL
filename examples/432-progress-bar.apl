# مثال 432 — شريط تقدم نصي
# Text progress bar
# Demonstrates: رسم نسبة مئوية
#
# Run:  python apl.py examples/432-progress-bar.apl

دالة شريط(نسبة):
    المتغير ممتلئ = صحيح(نسبة / 10)
    المتغير رسم = ""
    لكل ي في نطاق(10):
        لو ي < ممتلئ:
            رسم = رسم + "#"
        الا:
            رسم = رسم + "-"
    ارجع "[" + رسم + "] " + نص(نسبة) + "%"

لكل نسبة في [0, 25, 50, 75, 100]:
    اطبع شريط(نسبة)
