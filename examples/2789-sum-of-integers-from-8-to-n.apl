# مثال 2789 — مجموع الأعداد من 8 إلى ن
# Sum from 8 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2789-sum-of-integers-from-8-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(8, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(8), 8, "حالة 1")
تأكد_يساوي(ف(9), 17, "حالة 2")
تأكد_يساوي(ف(18), 143, "حالة 3")
تأكد_يساوي(ف(100), 5022, "حالة 4")
