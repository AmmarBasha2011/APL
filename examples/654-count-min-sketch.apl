# مثال 654 — عداد count-min
# Count-min sketch
# Demonstrates: تقدير تكرارات، تجزئات متعددة، أدنى
#
# Run:  python apl.py examples/654-count-min-sketch.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# عداد count-min: تقدير تكرارات بذاكرة ثابتة
# Demonstrates: عدة تجزئات ببذور, أخذ الأدنى, خطأ جانبي واحد
# التقدير أبدا أقل من الحقيقة

عرض = 101
بذور = [7, 13, 19]

دالة جدول_جديد():
  جدول = []
  لكل صف في نطاق(3):
    جدول.append([0] * عرض)
  ارجع جدول

دالة تجزئة(نص, بذرة):
  ح = 0
  لكل حرف في نص:
    ح = (ح * 31 + ترميز_حرف(حرف) + بذرة) % عرض
  ارجع ح

دالة أضف(جدول, نص, عدد):
  لكل ي في نطاق(3):
    جدول[ي][تجزئة(نص, بذور[ي])] = جدول[ي][تجزئة(نص, بذور[ي])] + عدد

دالة تقدير(جدول, نص):
  أدنى = جدول[0][تجزئة(نص, بذور[0])]
  لكل ي في نطاق(1, 3):
    ق = جدول[ي][تجزئة(نص, بذور[ي])]
    لو ق < أدنى:
      أدنى = ق
  ارجع أدنى

جدول = جدول_جديد()
أضف(جدول, "تفاح", 5)
أضف(جدول, "برتقال", 3)
أضف(جدول, "عنب", 2)
تأكد_يساوي(تقدير(جدول, "تفاح"), 5, "تفاح بلا تصادم")
تأكد_يساوي(تقدير(جدول, "برتقال"), 3, "برتقال بلا تصادم")
تأكد_يساوي(تقدير(جدول, "عنب"), 2, "عنب بلا تصادم")
تأكد_يساوي(تقدير(جدول, "تفاح") >= 5, صواب, "التقدير لا ينقص")
تأكد_يساوي(تقدير(جدول, "مانجو") >= 0, صواب, "غير موجود صفر أو تصادم")
اطبع "تقدير تفاح:", تقدير(جدول, "تفاح")
