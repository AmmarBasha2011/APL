# مثال 106 — التقريب بكل أنواعه
# Rounding modes
# Demonstrates: سقف، أرضي، اقتطاع، مقرب، مطلق_عشري، باقي_قسمة
#
# Run:  python apl.py examples/106-rounding.apl

المتغير أرقام = [3.2, 3.5, 3.7, -3.2, -3.7]
لكل ر في أرقام:
    اطبع ر, "-> سقف:", سقف(ر), "، أرضي:", أرضي(ر), "، اقتطاع:", اقتطاع(ر), "، مقرب:", مقرب(ر)

اطبع ""
اطبع "مقرب(3.14159, 2) =", مقرب(3.14159, 2)
اطبع "مطلق_عشري(-7.5) =", مطلق_عشري(-7.5)
اطبع "باقي_قسمة(10, 3) =", باقي_قسمة(10, 3)
اطبع "كسر_صحيح(3.75) =", كسر_صحيح(3.75)
