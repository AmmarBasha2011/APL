# مثال 4369 — تحويل وحدة بأساس 49
# Split by base 49
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4369-minutes-to-hours-and-minutes-base-49.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 49, ن % 49]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 10], "حالة 2")
تأكد_يساوي(ف(60), [1, 11], "حالة 3")
تأكد_يساوي(ف(125), [2, 27], "حالة 4")
تأكد_يساوي(ف(1000), [20, 20], "حالة 5")
