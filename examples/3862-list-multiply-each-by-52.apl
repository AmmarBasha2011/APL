# مثال 3862 — ضرب كل عنصر في 52
# Multiply each item by 52
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3862-list-multiply-each-by-52.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 52]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [156, 52, 104], "حالة 1")
تأكد_يساوي(ف([5]), [260], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [52, 104, 156, 208, 260, 312], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-104, 0, 364, 364, 208], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [520, 1040, 520, 1560, 1040, 520], "حالة 5")
