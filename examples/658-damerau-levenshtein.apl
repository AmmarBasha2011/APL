# مثال 658 — مسافة داميراو-لفنشتاين
# Damerau-Levenshtein
# Demonstrates: مسافة تحرير، تبديل جيران، برمجة ديناميكية
#
# Run:  python apl.py examples/658-damerau-levenshtein.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مسافة داميراو-لفنشتاين: تحرير مع تبديل الجيران
# Demonstrates: برمجة ديناميكية, حذف وإدراج واستبدال وتبديل
# يحسب خطأ إملائيا شائعا بتكلفة واحدة

دالة مسافة(أ, ب):
  ن = طول(أ)
  م = طول(ب)
  جدول = []
  لكل ي في نطاق(ن + 1):
    صف = []
    لكل ج في نطاق(م + 1):
      صف.append(0)
    جدول.append(صف)
  لكل ي في نطاق(ن + 1):
    جدول[ي][0] = ي
  لكل ج في نطاق(م + 1):
    جدول[0][ج] = ج
  لكل ي في نطاق(1, ن + 1):
    لكل ج في نطاق(1, م + 1):
      تكلفة = 0
      لو أ[ي - 1] != ب[ج - 1]:
        تكلفة = 1
      أدنى = جدول[ي - 1][ج] + 1
      لو جدول[ي][ج - 1] + 1 < أدنى:
        أدنى = جدول[ي][ج - 1] + 1
      لو جدول[ي - 1][ج - 1] + تكلفة < أدنى:
        أدنى = جدول[ي - 1][ج - 1] + تكلفة
      لو ي > 1 و ج > 1 و أ[ي - 1] == ب[ج - 2] و أ[ي - 2] == ب[ج - 1]:
        لو جدول[ي - 2][ج - 2] + 1 < أدنى:
          أدنى = جدول[ي - 2][ج - 2] + 1
      جدول[ي][ج] = أدنى
  ارجع جدول[ن][م]

تأكد_يساوي(مسافة("كتاب", "كتبا"), 1, "تبديل جار واحد")
تأكد_يساوي(مسافة("مرحبا", "مرحبا"), 0, "تطابق تام")
تأكد_يساوي(مسافة("سلام", "سلم"), 1, "حذف حرف")
تأكد_يساوي(مسافة("بيت", "بنت"), 1, "استبدال حرف")
تأكد_يساوي(مسافة("مدرسة", "مدرس"), 1, "حذف أخير")
تأكد_يساوي(مسافة("", "أب"), 2, "من فارغ")
تأكد_يساوي(مسافة("كتاب", "قلم"), 4, "مختلفان تماما")
اطبع "انتهت المسافات"
