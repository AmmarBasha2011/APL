# مثال 599 — خوارزمية ماناكر
# Manacher algorithm
# Demonstrates: ماناكر، متناظرة، مراكز
#
# Run:  python apl.py examples/599-manacher.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# خوارزمية ماناكر: أطول سلسلة متناظرة بخطية
# Demonstrates: توسيع حول مراكز مع مرايا, نص مفصول بعلامات
# أسرع من البرمجة الديناميكية لهذه المسألة

دالة أطول_متناظرة(نص):
  مفصول = "#"
  لكل حرف في نص:
    مفصول = مفصول + حرف + "#"
  ن = طول(مفصول)
  نصف = [0] * ن
  مركز = 0
  يمين = 0
  لكل ي في نطاق(ن):
    مرآة = 2 * مركز - ي
    لو ي < يمين:
      نصف[ي] = أصغر(يمين - ي, نصف[مرآة])
    أ = ي + نصف[ي] + 1
    ب = ي - نصف[ي] - 1
    طالما أ < ن و ب >= 0 و مفصول[أ] == مفصول[ب]:
      نصف[ي] = نصف[ي] + 1
      أ = أ + 1
      ب = ب - 1
    لو ي + نصف[ي] > يمين:
      مركز = ي
      يمين = ي + نصف[ي]
  أقصى = 0
  لكل قيمة في نصف:
    لو قيمة > أقصى:
      أقصى = قيمة
  ارجع أقصى

تأكد_يساوي(أطول_متناظرة("abacaba"), 7, "كامل النص متناظر")
تأكد_يساوي(أطول_متناظرة("abaxyzx"), 3, "أطولها aba")
تأكد_يساوي(أطول_متناظرة("abba"), 4, "زوجي الطول")
اطبع "أطول متناظرة في abacaba:", أطول_متناظرة("abacaba")
