# مثال 264 — نظام تصويت
# Voting system
# Demonstrates: فرز الأصوات وإعلان الفائز
#
# Run:  python apl.py examples/264-voting.apl

بذرة(23)
المتغير مرشحون = ["أحمد", "سارة", "خالد"]
المتغير أصوات = {"أحمد": 0, "سارة": 0, "خالد": 0}

لكل _ في نطاق(100):
    المتغير صوت = عشوائي(مرشحون)
    أصوات[صوت] = أصوات[صوت] + 1

لكل مرشح في مرشحون:
    اطبع مرشح, ":", أصوات[مرشح], "صوتا"

المتغير فائز = مرشحون[0]
لكل مرشح في مرشحون:
    لو أصوات[مرشح] > أصوات[فائز]:
        فائز = مرشح

اطبع "الفائز:", فائز
