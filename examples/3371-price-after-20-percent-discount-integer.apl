# مثال 3371 — السعر بعد خصم 20 بالمئة
# Price after 20 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3371-price-after-20-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 20 // 100

تأكد_يساوي(ف(100), 80, "حالة 1")
تأكد_يساوي(ف(250), 200, "حالة 2")
تأكد_يساوي(ف(999), 800, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
