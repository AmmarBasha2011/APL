# مثال 1197 — مناطق محاصرة
# Surrounded regions
# Demonstrates: بحث بالعمق
#
# Run:  python apl.py examples/1197-surrounded-regions.apl

# نحدد الخانات المتصلة بالحافة ونحميها
# وكل ما بقي من O يصبح X

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة احصر(ش):
  ر_ = طول(ش)
  ك_ = طول(ش[0])
  مكدس = []
  لكل ص في نطاق(ر_):
    لكل ج في نطاق(ك_):
      حافة = (ص == 0) أو (ص == ر_ - 1) أو (ج == 0) أو (ج == ك_ - 1)
      لو حافة و (ش[ص][ج] == "O"):
        مكدس.ألحق([ص, ج])
  اتجاهات = [[1, 0], [-1, 0], [0, 1], [0, -1]]
  طالما طول(مكدس) > 0:
    ن = مكدس.pop()
    لو ش[ن[0]][ن[1]] == "O":
      ش[ن[0]][ن[1]] = "S"
      لكل د في اتجاهات:
        ر = ن[0] + د[0]
        ك = ن[1] + د[1]
        لو (ر >= 0) و (ر < ر_) و (ك >= 0) و (ك < ك_):
          لو ش[ر][ك] == "O":
            مكدس.ألحق([ر, ك])
  لكل ص في نطاق(ر_):
    لكل ج في نطاق(ك_):
      لو ش[ص][ج] == "O":
        ش[ص][ج] = "X"
      والا_لو ش[ص][ج] == "S":
        ش[ص][ج] = "O"
  ارجع ش

م = [["X","X","X","X"],["X","O","O","X"],["X","X","O","X"],["X","O","X","X"]]
تأكد_يساوي(احصر(م), [["X","X","X","X"],["X","X","X","X"],["X","X","X","X"],["X","O","X","X"]], "مثال أول")
تأكد_يساوي(احصر([["O"]]), [["O"]], "حافة")
