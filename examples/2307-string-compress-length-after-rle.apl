# مثال 2307 — طول النص بعد الضغط
# Length after RLE
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2307-string-compress-length-after-rle.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == "":
    ارجع 0
  ط = 0
  ع = 1
  لكل ي في نطاق(1, طول(ن)):
    لو ن[ي] == ن[ي - 1]:
      ع = ع + 1
    والا:
      ط = ط + 1 + طول(نص(ع))
      ع = 1
  ارجع ط + 1 + طول(نص(ع))

تأكد_يساوي(ف("aaabb"), 4, "حالة 1")
تأكد_يساوي(ف("abc"), 6, "حالة 2")
تأكد_يساوي(ف("zzzzzzzzzzzz"), 3, "حالة 3")
تأكد_يساوي(ف("a"), 2, "حالة 4")
