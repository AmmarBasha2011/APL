# مثال 390 — تحقق كلمة المرور بالأنماط
# Password validation with regex
# Demonstrates: عدة أنماط معا
#
# Run:  python apl.py examples/390-password-regex.apl

دالة قوية(كلمة):
    لو طول(كلمة) < 8:
        ارجع خطأ
    لو بحث_نمطي("[A-Z]", كلمة) == لا_شيء:
        ارجع خطأ
    لو بحث_نمطي("[a-z]", كلمة) == لا_شيء:
        ارجع خطأ
    لو بحث_نمطي("[0-9]", كلمة) == لا_شيء:
        ارجع خطأ
    ارجع صواب

اطبع "abc:", قوية("abc")
اطبع "Abcdefgh:", قوية("Abcdefgh")
اطبع "Abcd1234:", قوية("Abcd1234")
