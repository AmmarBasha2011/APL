# مثال 3768 — تحويل وحدة بأساس 33
# Split by base 33
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3768-minutes-to-hours-and-minutes-base-33.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 33, ن % 33]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [1, 26], "حالة 2")
تأكد_يساوي(ف(60), [1, 27], "حالة 3")
تأكد_يساوي(ف(125), [3, 26], "حالة 4")
تأكد_يساوي(ف(1000), [30, 10], "حالة 5")
