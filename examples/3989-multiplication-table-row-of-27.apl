# مثال 3989 — صف جدول ضرب 27
# Multiplication row of 27
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3989-multiplication-table-row-of-27.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 27]
  ارجع ر

تأكد_يساوي(ف(1), [27], "حالة 1")
تأكد_يساوي(ف(5), [27, 54, 81, 108, 135], "حالة 2")
تأكد_يساوي(ف(10), [27, 54, 81, 108, 135, 162, 189, 216, 243, 270], "حالة 3")
