# مثال 2120 — عدد يساوي مجموع مضروبات أرقامه
# Factorion check
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2120-factorion-digit-factorial-sum-check.apl

# # نحسب مضروب كل رقم
# # ونقارن المجموع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مضروب(ن):
  ناتج = 1
  لكل ك في نطاق(2, ن + 1):
    ناتج = ناتج * ك
  ارجع ناتج

دالة فاكتوريون(ن):
  مج = 0
  لكل ر في نص(ن):
    مج = مج + مضروب(int(ر))
  ارجع مج == ن

تأكد_يساوي(فاكتوريون(145), صواب, "١٤٥")
تأكد_يساوي(فاكتوريون(40585), صواب, "٤٠٥٨٥")
تأكد_يساوي(فاكتوريون(100), خطأ, "١٠٠")
تأكد_يساوي(فاكتوريون(1), صواب, "١")
تأكد_يساوي(فاكتوريون(2), صواب, "٢")
