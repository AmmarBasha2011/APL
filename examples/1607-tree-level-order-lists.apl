# مثال 1607 — مستويات الشجرة
# Binary tree level order
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1607-tree-level-order-lists.apl

# نعالج مستوى كاملاً في كل جولة
# نجمع أبناء المستوى للتالي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مستويات(ش):
  لو ش == []:
    ارجع []
  ناتج = []
  حالي = [ش]
  طالما طول(حالي) > 0:
    قيم = []
    تالي = []
    لكل ع في حالي:
      قيم.append(ع[0])
      لو ع[1] != []:
        تالي.append(ع[1])
      لو ع[2] != []:
        تالي.append(ع[2])
    ناتج.append(قيم)
    حالي = تالي
  ارجع ناتج

تأكد_يساوي(مستويات([3, [9, [], []], [20, [15, [], []], [7, [], []]]]), [[3], [9, 20], [15, 7]], "ثلاثة مستويات")
تأكد_يساوي(مستويات([]), [], "فارغة")
تأكد_يساوي(مستويات([1, [], []]), [[1]], "جذر")
