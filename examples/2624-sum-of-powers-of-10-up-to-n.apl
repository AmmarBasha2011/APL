# مثال 2624 — مجموع قوى 10
# Sum of powers of 10
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2624-sum-of-powers-of-10-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 10 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 11, "حالة 2")
تأكد_يساوي(ف(3), 1111, "حالة 3")
تأكد_يساوي(ف(6), 1111111, "حالة 4")
تأكد_يساوي(ف(10), 11111111111, "حالة 5")
