# مثال 1378 — طلاء بيوت بألوان كثيرة
# Paint house II minimum cost
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1378-paint-house-k-colors.apl

# نحتفظ بأصغر تكلفتين من الصف السابق
# اللون المماثل لأصغرهما يأخذ ثانيهما

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_تكلفة_طلاء(تكاليف):
  ك = طول(تكاليف[0])
  سابق = [0] * ك
  لكل صف في تكاليف:
    ادنى1 = 1000000000
    ادنى2 = 1000000000
    موضع = -1
    لكل ج في نطاق(ك):
      لو سابق[ج] < ادنى1:
        ادنى2 = ادنى1
        ادنى1 = سابق[ج]
        موضع = ج
      والا_لو سابق[ج] < ادنى2:
        ادنى2 = سابق[ج]
    جديد = [0] * ك
    لكل ج في نطاق(ك):
      لو ج == موضع:
        جديد[ج] = صف[ج] + ادنى2
      والا:
        جديد[ج] = صف[ج] + ادنى1
    سابق = جديد
  افضل = سابق[0]
  لكل ق في سابق:
    لو ق < افضل:
      افضل = ق
  ارجع افضل

تأكد_يساوي(اقل_تكلفة_طلاء([[1,5,3],[2,9,4]]), 5, "بيتان")
تأكد_يساوي(اقل_تكلفة_طلاء([[1,3],[2,4]]), 5, "لونان")
تأكد_يساوي(اقل_تكلفة_طلاء([[3,1,2]]), 1, "بيت واحد")
