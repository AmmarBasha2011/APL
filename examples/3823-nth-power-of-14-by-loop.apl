# مثال 3823 — قوة 14 بالحلقة
# Power of 14 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3823-nth-power-of-14-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 14
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 14, "حالة 2")
تأكد_يساوي(ف(3), 2744, "حالة 3")
تأكد_يساوي(ف(6), 7529536, "حالة 4")
تأكد_يساوي(ف(10), 289254654976, "حالة 5")
