# مثال 1658 — هل العدد قوة كاملة
# Perfect power check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1658-perfect-power-check.apl

# نجرب الأسس من 2
# ونجرب الأساسات حتى يتجاوز العدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة_كاملة(ن):
  لو ن < 2:
    ارجع صواب
  لكل أ في نطاق(2, ن):
    لو أ * أ > ن:
      ارجع خطأ
    ق = أ * أ
    طالما ق < ن:
      ق = ق * أ
    لو ق == ن:
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(قوة_كاملة(16), صواب, "ستة عشر")
تأكد_يساوي(قوة_كاملة(27), صواب, "سبعة وعشرون")
تأكد_يساوي(قوة_كاملة(18), خطأ, "ثمانية عشر")
تأكد_يساوي(قوة_كاملة(1), صواب, "واحد")
