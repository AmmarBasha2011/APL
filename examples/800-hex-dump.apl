# مثال 800 — تفريغ سداسي
# Hex dump
# Demonstrates: إزاحة، أعمدة، ASCII
#
# Run:  python apl.py examples/800-hex-dump.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تفريغ سداسي عشري بأسلوب hexdump: إزاحة وبايتات وحرف ASCII
# Demonstrates: تنسيق بخانة سداسية ثابتة, محاذاة الأعمدة, نقطة للمحرف غير القابل للطباعة

سداسي = "0123456789abcdef"

دالة سداسي2(ب):
  ارجع سداسي[ب // 16] + سداسي[ب % 16]

دالة سداسي4(ن):
  ارجع سداسي2(ن // 256) + سداسي2(ن % 256)

دالة كرر(نص, عدد):
  ناتج = ""
  لكل ي في نطاق(عدد):
    ناتج = ناتج + نص
  ارجع ناتج

دالة تفريغ(بيانات, عرض):
  ب = []
  لكل حرف في بيانات:
    ب.append(ترميز_حرف(حرف))
  أسطر = []
  ي = 0
  طالما ي < طول(ب):
    قطعة = []
    نص = ""
    لكل ك في نطاق(عرض):
      لو ي + ك < طول(ب):
        قطعة.append(سداسي2(ب[ي + ك]))
        كود = ب[ي + ك]
        لو كود >= 32 و كود < 127:
          نص = نص + فك_ترميز_حرف(كود)
        والا:
          نص = نص + "."
    سطر = سداسي4(ي) + "  " + " ".ضم(قطعة)
    نقص = عرض - طول(قطعة)
    سطر = سطر + كرر("   ", نقص) + "  |" + نص + "|"
    أسطر.append(سطر)
    ي = ي + عرض
  ارجع أسطر

نتيجة = تفريغ("Hello, World!", 8)
تأكد_يساوي(نتيجة[0], "0000  48 65 6c 6c 6f 2c 20 57  |Hello, W|", "السطر الأول")
تأكد_يساوي(نتيجة[1], "0008  6f 72 6c 64 21           |orld!|", "سطر غير مكتمل")
تأكد_يساوي(سداسي2(255), "ff", "أعلى بايت")
تأكد_يساوي(سداسي4(30), "001e", "إزاحة من أربع خانات")
تأكد_يساوي(طول(تفريغ("ABCDEFGHIJKLMNOP", 16)), 1, "سطر واحد كامل")
