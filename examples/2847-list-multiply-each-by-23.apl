# مثال 2847 — ضرب كل عنصر في 23
# Multiply each item by 23
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2847-list-multiply-each-by-23.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 23]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [69, 23, 46], "حالة 1")
تأكد_يساوي(ف([5]), [115], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [23, 46, 69, 92, 115, 138], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-46, 0, 161, 161, 92], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [230, 460, 230, 690, 460, 230], "حالة 5")
