# مثال 313 — مثلث باسكال
# Pascal's triangle
# Demonstrates: بناء صفوف من السابق
#
# Run:  python apl.py examples/313-pascal.apl

دالة مثلث_باسكال(صفوف):
    المتغير نتيجة = []
    لكل ي في نطاق(صفوف):
        المتغير سطر = [1 لكل _ في نطاق(ي + 1)]
        لكل ز في نطاق(1, ي):
            سطر[ز] = نتيجة[ي - 1][ز - 1] + نتيجة[ي - 1][ز]
        نتيجة.أضف(سطر)
    ارجع نتيجة

لكل سطر في مثلث_باسكال(6):
    اطبع سطر
