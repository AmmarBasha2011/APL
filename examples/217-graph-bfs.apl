# مثال 217 — المسح بالعرض للرسم البياني
# Graph BFS
# Demonstrates: طابور + مجموعة زيارات
#
# Run:  python apl.py examples/217-graph-bfs.apl

دالة مسح_عرض(رسم, بداية):
    المتغير مزارة = []
    المتغير طابور = [بداية]
    المتغير في_الطابور = {بداية: صواب}
    طالما طول(طابور) > 0:
        المتغير عقدة = طابور.pop(0)
        مزارة.أضف(عقدة)
        لكل جار في رسم[عقدة]:
            لو جار ليس في في_الطابور:
                في_الطابور[جار] = صواب
                طابور.أضف(جار)
    ارجع مزارة

المتغير رسم = {
    "أ": ["ب", "ج"],
    "ب": ["أ", "د", "ه"],
    "ج": ["أ", "د"],
    "د": ["ب", "ج", "ه"],
    "ه": ["ب", "د"]
}
اطبع "المسح بالعرض من أ:", مسح_عرض(رسم, "أ")
