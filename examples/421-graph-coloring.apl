# مثال 421 — تلوين الرسم البياني
# Graph coloring (greedy)
# Demonstrates: خوارزمية جشعة للتلوين
#
# Run:  python apl.py examples/421-graph-coloring.apl

المتغير جيران = {
    0: [1, 2],
    1: [0, 2, 3],
    2: [0, 1, 3],
    3: [1, 2]
}

المتغير ألوان = {}
لكل عقدة في جيران.keys():
    المتغير مستخدمة = []
    لكل جار in جيران[عقدة]:
        لو ألوان.get(جار) != لا_شيء:
            مستخدمة.append(ألوان[جار])
    المتغير لون = 0
    طالما مستخدمة.count(لون) > 0:
        لون = لون + 1
    ألوان[عقدة] = لون

اطبع "التلوين:", ألوان
