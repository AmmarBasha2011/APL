# مثال 2689 — عدد الحرف o في النص
# Count letter o
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2689-count-letter-o-in-text-v3.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن.count("o")

تأكد_يساوي(ف("elephant"), 0, "حالة 1")
تأكد_يساوي(ف("aaa"), 0, "حالة 2")
تأكد_يساوي(ف("status quo"), 1, "حالة 3")
تأكد_يساوي(ف("mississippi"), 0, "حالة 4")
