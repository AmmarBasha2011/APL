# مثال 2439 — مجموع قوى 4
# Sum of powers of 4
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2439-sum-of-powers-of-4-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 4 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 5, "حالة 2")
تأكد_يساوي(ف(3), 85, "حالة 3")
تأكد_يساوي(ف(6), 5461, "حالة 4")
تأكد_يساوي(ف(10), 1398101, "حالة 5")
