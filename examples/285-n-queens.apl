# مثال 285 — ملكات الشطرنج (عد الحلول)
# N-Queens (count solutions)
# Demonstrates: تراجع مع فحص الأعمدة والأقطار
#
# Run:  python apl.py examples/285-n-queens.apl

دالة آمن(صفوف, رقم_الصف, عمود):
    لكل سابق في نطاق(رقم_الصف):
        المتغير عمود_سابق = صفوف[سابق]
        لو عمود_سابق == عمود:
            ارجع خطأ
        المتغير فرق = عمود_سابق - عمود
        لو فرق < 0:
            فرق = -فرق
        لو فرق == رقم_الصف - سابق:
            ارجع خطأ
    ارجع صواب

دالة حل_ملكات(ن, رقم_الصف, صفوف, عداد):
    لو رقم_الصف == ن:
        عداد["عدد"] = عداد["عدد"] + 1
        ارجع
    لكل عمود في نطاق(ن):
        لو آمن(صفوف, رقم_الصف, عمود):
            صفوف.أضف(عمود)
            حل_ملكات(ن, رقم_الصف + 1, صفوف, عداد)
            صفوف.pop()

دالة عد_الحلول(ن):
    المتغير عداد = {"عدد": 0}
    حل_ملكات(ن, 0, [], عداد)
    ارجع عداد["عدد"]

اطبع "حلول 4x4:", عد_الحلول(4)
اطبع "حلول 6x6:", عد_الحلول(6)
اطبع "حلول 8x8:", عد_الحلول(8)
