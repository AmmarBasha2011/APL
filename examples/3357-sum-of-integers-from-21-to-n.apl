# مثال 3357 — مجموع الأعداد من 21 إلى ن
# Sum from 21 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3357-sum-of-integers-from-21-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(21, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(21), 21, "حالة 1")
تأكد_يساوي(ف(22), 43, "حالة 2")
تأكد_يساوي(ف(31), 286, "حالة 3")
تأكد_يساوي(ف(100), 4840, "حالة 4")
