# مثال 3254 — مجموع زوايا مضلع زائد 8
# Polygon angle sum plus 8
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3254-interior-angle-sum-of-polygon-plus-8.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 8

تأكد_يساوي(ف(3), 188, "حالة 1")
تأكد_يساوي(ف(4), 368, "حالة 2")
تأكد_يساوي(ف(5), 548, "حالة 3")
تأكد_يساوي(ف(6), 728, "حالة 4")
تأكد_يساوي(ف(12), 1808, "حالة 5")
