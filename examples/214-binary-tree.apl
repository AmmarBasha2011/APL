# مثال 214 — الشجرة الثنائية وجولاتها
# Binary tree traversals
# Demonstrates: عودية على الشجرة، ترتيبات الجولة
#
# Run:  python apl.py examples/214-binary-tree.apl

صنف عقدة:
    دالة_إنشاء(ذات, قيمة):
        ذات.قيمة = قيمة
        ذات.أيسر = لا_شيء
        ذات.أيمن = لا_شيء

دالة داخلية(عقدة, نتيجة):
    لو عقدة == لا_شيء:
        ارجع
    داخلية(عقدة.أيسر, نتيجة)
    نتيجة.أضف(عقدة.قيمة)
    داخلية(عقدة.أيمن, نتيجة)

دالة قبلية(عقدة, نتيجة):
    لو عقدة == لا_شيء:
        ارجع
    نتيجة.أضف(عقدة.قيمة)
    قبلية(عقدة.أيسر, نتيجة)
    قبلية(عقدة.أيمن, نتيجة)

دالة بعدية(عقدة, نتيجة):
    لو عقدة == لا_شيء:
        ارجع
    بعدية(عقدة.أيسر, نتيجة)
    بعدية(عقدة.أيمن, نتيجة)
    نتيجة.أضف(عقدة.قيمة)

المتغير جذر = عقدة(1)
جذر.أيسر = عقدة(2)
جذر.أيمن = عقدة(3)
جذر.أيسر.أيسر = عقدة(4)
جذر.أيسر.أيمن = عقدة(5)

المتغير أ = []
داخلية(جذر, أ)
اطبع "داخلية:", أ
المتغير ب = []
قبلية(جذر, ب)
اطبع "قبلية:", ب
المتغير ج = []
بعدية(جذر, ج)
اطبع "بعدية:", ج
