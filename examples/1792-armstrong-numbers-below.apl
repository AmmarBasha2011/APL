# مثال 1792 — أعداد أرمسترونغ تحت حد
# Armstrong numbers below limit
# Demonstrates: أرقام
#
# Run:  python apl.py examples/1792-armstrong-numbers-below.apl

# نحسب عدد الأرقام
# نقارن المجموع بالعدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أرمسترونغ(ن):
  أرقام = []
  ك = ن
  طالما ك > 0:
    أرقام.append(ك % 10)
    ك = ك // 10
  عدد = طول(أرقام)
  مجموع = 0
  لكل ر في أرقام:
    مجموع = مجموع + ر ** عدد
  ارجع مجموع == ن

دالة قائمة_أرمسترونغ(حد):
  ناتج = []
  لكل ن في نطاق(1, حد):
    لو أرمسترونغ(ن):
      ناتج.append(ن)
  ارجع ناتج

تأكد_يساوي(قائمة_أرمسترونغ(10), [1, 2, 3, 4, 5, 6, 7, 8, 9], "رقم واحد")
تأكد_يساوي(قائمة_أرمسترونغ(500), [1, 2, 3, 4, 5, 6, 7, 8, 9, 153, 370, 371, 407], "حتى 500")
