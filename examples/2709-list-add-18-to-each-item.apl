# مثال 2709 — إضافة 18 لكل عنصر
# Add 18 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2709-list-add-18-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 18]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [21, 19, 20], "حالة 1")
تأكد_يساوي(ف([5]), [23], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [19, 20, 21, 22, 23, 24], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [16, 18, 25, 25, 22], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [28, 38, 28, 48, 38, 28], "حالة 5")
