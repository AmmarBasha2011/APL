# مثال 385 — محلل سجل بالأنماط
# Regex log parser
# Demonstrates: مجموعات التقاط
#
# Run:  python apl.py examples/385-log-parser.apl

المتغير سجلات = [
    "[INFO] 2026-11-23 المستخدم دخل",
    "[ERROR] 2026-11-23 فشل الدفع",
    "[INFO] 2026-11-23 المستخدم خرج"
]

لكل سطر in سجلات:
    المتغير م = بحث_نمطي("\[([A-Z]+)\] (.+)", سطر)
    لو م != لا_شيء:
        اطبع "المستوى:", م.group(1)
        اطبع "الرسالة:", م.group(2)
