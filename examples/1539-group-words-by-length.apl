# مثال 1539 — تجميع الكلمات حسب الطول
# Group words by length
# Demonstrates: قواميس
#
# Run:  python apl.py examples/1539-group-words-by-length.apl

# الطول هو المفتاح
# القيمة قائمة تتسع للكلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جمّع_بالطول(كلمات):
  مجموعات = {}
  لكل ك في كلمات:
    ط = طول(ك)
    لو ط في مجموعات:
      مجموعات[ط].append(ك)
    والا:
      مجموعات[ط] = [ك]
  ارجع مجموعات

تأكد_يساوي(جمّع_بالطول(["ab", "cd", "e"]), {2: ["ab", "cd"], 1: ["e"]}, "طولان")
تأكد_يساوي(جمّع_بالطول([]), {}, "فارغ")
