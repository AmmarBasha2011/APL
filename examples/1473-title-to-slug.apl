# مثال 1473 — عنوان إلى رابط مختصر
# Title to URL slug
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1473-title-to-slug.apl

# نصغر الحروف
# نستبدل كل ما ليس حرفاً أو رقماً بشرطة واحدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رابط(عنوان):
  ناتج = ""
  سابق_شرطة = خطأ
  لكل ح في عنوان.lower():
    لو ح.isalpha() أو ح.isdigit():
      ناتج = ناتج + ح
      سابق_شرطة = خطأ
    والا_لو سابق_شرطة == خطأ و ناتج != "":
      ناتج = ناتج + "-"
      سابق_شرطة = صواب
  لو ناتج.endswith("-"):
    ناتج = ناتج[0:طول(ناتج) - 1]
  ارجع ناتج

تأكد_يساوي(رابط("Hello World"), "hello-world", "مسافة")
تأكد_يساوي(رابط("  Hi,  there!! "), "hi-there", "رموز ومسافات")
تأكد_يساوي(رابط("APL 2024"), "apl-2024", "أرقام")
