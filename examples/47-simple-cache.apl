# مثال 47 — كاش بسيط من الصفر
# Simple Cache from Scratch
# Demonstrates: class, dict lookup, cache hit/miss counting
#
# Run:  python apl.py examples/47-simple-cache.apl

صنف خزائن:
    دالة_إنشاء(ذات, حد):
        ذات.البيانات = {}
        ذات.الحد = حد
        ذات.إصابات = 0
        ذات.أخطاء = 0

    دالة اجلب(ذات, مفتاح, رقم):
        إذا مفتاح في ذات.البيانات:
            ذات.إصابات = ذات.إصابات + 1
            ارجع ذات.البيانات[مفتاح]
        ذات.أخطاء = ذات.أخطاء + 1
        قيمة = رقم * رقم
        ذات.البيانات[مفتاح] = قيمة
        ارجع قيمة

    دالة إحصاء(ذات):
        ارجع "إصابات=" + نص(ذات.إصابات) + " أخطاء=" + نص(ذات.أخطاء)

دالة_مربع(رقم):
    ارجع رقم * رقم

اطبع "=== كاش بسيط ==="
اطبع ""
المتغير مخزن = خزائن(100)

اطبع "أول جلب لمربع(5): " + نص(مخزن.اجلب("m1", 5))
اطبع "مربع(5) مرة ثانية: " + نص(مخزن.اجلب("m1", 5))
اطبع "مربع(5) مرة ثالثة: " + نص(مخزن.اجلب("m1", 5))
اطبع ""
اطبع "مفتاح جديد مربع(7): " + نص(مخزن.اجلب("m2", 7))
اطبع ""
اطبع "الإحصاء: " + مخزن.إحصاء()
اطبع "المفاتيح المخزنة: " + نص(طول(مخزن.البيانات))
