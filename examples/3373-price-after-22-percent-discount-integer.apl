# مثال 3373 — السعر بعد خصم 22 بالمئة
# Price after 22 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3373-price-after-22-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 22 // 100

تأكد_يساوي(ف(100), 78, "حالة 1")
تأكد_يساوي(ف(250), 195, "حالة 2")
تأكد_يساوي(ف(999), 780, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
