# مثال 2961 — صف جدول ضرب 9
# Multiplication row of 9
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2961-multiplication-table-row-of-9.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 9]
  ارجع ر

تأكد_يساوي(ف(1), [9], "حالة 1")
تأكد_يساوي(ف(5), [9, 18, 27, 36, 45], "حالة 2")
تأكد_يساوي(ف(10), [9, 18, 27, 36, 45, 54, 63, 72, 81, 90], "حالة 3")
