# مثال 1358 — لغز الانزلاق
# Sliding puzzle 2x3
# Demonstrates: بحث بالعرض
#
# Run:  python apl.py examples/1358-sliding-puzzle.apl

# الحالة نص من ستة أرقام
# نبدل الصفر مع جاره ونبحث بالعرض

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقل_حركات(بداية):
  هدف = "123450"
  جيران = [[1,3],[0,2,4],[1,5],[0,4],[1,3,5],[2,4]]
  مرئي = {}
  مرئي[بداية] = صواب
  طابور = [[بداية, 0]]
  ع = 0
  طالما ع < طول(طابور):
    حالة = طابور[ع][0]
    خطوات = طابور[ع][1]
    ع = ع + 1
    لو حالة == هدف:
      ارجع خطوات
    ص = حالة.find("0")
    لكل ج في جيران[ص]:
      حروف = قائمة(حالة)
      حروف[ص] = حروف[ج]
      حروف[ج] = "0"
      جديد = ""
      لكل ح في حروف:
        جديد = جديد + ح
      لو جديد ليس في مرئي:
        مرئي[جديد] = صواب
        طابور.ألحق([جديد, خطوات + 1])
  ارجع -1

تأكد_يساوي(اقل_حركات("123405"), 1, "حركة واحدة")
تأكد_يساوي(اقل_حركات("123540"), -1, "غير قابل للحل")
تأكد_يساوي(اقل_حركات("412503"), 5, "خمس حركات")
