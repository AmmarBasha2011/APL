# مثال 294 — من أرقام عشرية إلى رومانية
# Integer to Roman
# Demonstrates: جدول قيم تنازلي
#
# Run:  python apl.py examples/294-int-to-roman.apl

دالة إلى_روماني(عدد):
    المتغير جدول = [[1000, "M"], [900, "CM"], [500, "D"], [400, "CD"], [100, "C"], [90, "XC"], [50, "L"], [40, "XL"], [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"]]
    المتغير نتيجة = ""
    لكل زوج في جدول:
        طالما عدد >= زوج[0]:
            نتيجة = نتيجة + زوج[1]
            عدد = عدد - زوج[0]
    ارجع نتيجة

اطبع "3 =", إلى_روماني(3)
اطبع "58 =", إلى_روماني(58)
اطبع "1994 =", إلى_روماني(1994)
اطبع "2024 =", إلى_روماني(2024)
