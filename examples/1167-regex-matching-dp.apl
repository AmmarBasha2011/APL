# مثال 1167 — مطابقة تعبير
# Regular expression matching dot star
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1167-regex-matching-dp.apl

# النقطة تطابق أي حرف
# والنجمة تكرر العنصر السابق صفراً أو أكثر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تطابق_تعبير(س, ن):
  د = []
  لكل ع في نطاق(طول(س) + 1):
    د.ألحق([خطأ] * (طول(ن) + 1))
  د[0][0] = صواب
  لكل ج في نطاق(2, طول(ن) + 1):
    لو ن[ج - 1] == "*":
      د[0][ج] = د[0][ج - 2]
  لكل ع في نطاق(1, طول(س) + 1):
    لكل ج في نطاق(1, طول(ن) + 1):
      لو ن[ج - 1] == "*":
        صفر = د[ع][ج - 2]
        ازيد = خطأ
        لو (ن[ج - 2] == ".") أو (ن[ج - 2] == س[ع - 1]):
          ازيد = د[ع - 1][ج]
        د[ع][ج] = صفر أو ازيد
      والا_لو (ن[ج - 1] == ".") أو (ن[ج - 1] == س[ع - 1]):
        د[ع][ج] = د[ع - 1][ج - 1]
  ارجع د[طول(س)][طول(ن)]

تأكد_يساوي(تطابق_تعبير("aa", "a"), خطأ, "قصير")
تأكد_يساوي(تطابق_تعبير("aa", "a*"), صواب, "نجمة")
تأكد_يساوي(تطابق_تعبير("ab", ".*"), صواب, "نقطة نجمة")
تأكد_يساوي(تطابق_تعبير("aab", "c*a*b"), صواب, "نجمة صفرية")
تأكد_يساوي(تطابق_تعبير("mississippi", "mis*is*p*."), خطأ, "طويل")
