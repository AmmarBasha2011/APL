# مثال 1313 — ترتيب مجموعات غراي
# Subsets in gray code order
# Demonstrates: شيفرة غراي
#
# Run:  python apl.py examples/1313-gray-subsets-order.apl

# نستخدم شيفرة غراي كقناع
# فيتغير عنصر واحد بين كل مجموعتين متجاورتين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجموعات_غراي(أ):
  ناتج = []
  لكل ع في نطاق(1 << طول(أ)):
    قناع = ع ^ (ع >> 1)
    ق = []
    لكل ب في نطاق(طول(أ)):
      لو (قناع >> ب) & 1:
        ق.ألحق(أ[ب])
    ناتج.ألحق(ق)
  ارجع ناتج

دالة فرق(أ, ب):
  ع = 0
  لكل س في أ:
    لو س ليس في ب:
      ع = ع + 1
  لكل س في ب:
    لو س ليس في أ:
      ع = ع + 1
  ارجع ع

ق = مجموعات_غراي([1, 2, 3])
تأكد_يساوي(طول(ق), 8, "ثماني مجموعات")
سليم = صواب
لكل ع في نطاق(7):
  لو فرق(ق[ع], ق[ع + 1]) != 1:
    سليم = خطأ
تأكد_يساوي(سليم, صواب, "فرق عنصر واحد")
