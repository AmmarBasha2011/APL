# مثال 124 — التحقق من المدخلات بالأنماط
# Input validation with regex
# Demonstrates: مطابقة، دوال، نمط_أرقام
#
# Run:  python apl.py examples/124-text-validate.apl

دالة اسم_صالح(اسم):
    ارجع مطابقة("[A-Za-z_][A-Za-z0-9_]*", اسم) != لا_شيء

دالة هاتف_صالح(هاتف):
    ارجع مطابقة("01[0-9]{9}", هاتف) != لا_شيء

اطبع "اسم_صالح(ammar_2026):", اسم_صالح("ammar_2026")
اطبع "اسم_صالح(2026ammar):", اسم_صالح("2026ammar")
اطبع "هاتف_صالح(01012345678):", هاتف_صالح("01012345678")
اطبع "هاتف_صالح(12345):", هاتف_صالح("12345")
