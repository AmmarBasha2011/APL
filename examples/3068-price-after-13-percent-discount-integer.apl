# مثال 3068 — السعر بعد خصم 13 بالمئة
# Price after 13 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3068-price-after-13-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 13 // 100

تأكد_يساوي(ف(100), 87, "حالة 1")
تأكد_يساوي(ف(250), 218, "حالة 2")
تأكد_يساوي(ف(999), 870, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
