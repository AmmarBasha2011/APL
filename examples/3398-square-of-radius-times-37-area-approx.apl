# مثال 3398 — مساحة دائرة بتقريب 37
# Circle area with pi approx 37/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3398-square-of-radius-times-37-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 37 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 5, "حالة 2")
تأكد_يساوي(ف(7), 259, "حالة 3")
تأكد_يساوي(ف(14), 1036, "حالة 4")
تأكد_يساوي(ف(21), 2331, "حالة 5")
