# مثال 1452 — روبوت يدور في دائرة
# Robot bounded in a circle
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1452-robot-bounded-circle.apl

# نكرر التعليمات أربع مرات
# إذا عاد للأصل فهو محدود

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة محدود(تعليمات):
  س = 0
  ص = 0
  اتجاه = 0
  حركة = [[0, 1], [1, 0], [0, -1], [-1, 0]]
  لكل مرة في نطاق(4):
    لكل ح في تعليمات:
      لو ح == "G":
        س = س + حركة[اتجاه][0]
        ص = ص + حركة[اتجاه][1]
      والا_لو ح == "L":
        اتجاه = (اتجاه + 3) % 4
      والا_لو ح == "R":
        اتجاه = (اتجاه + 1) % 4
  ارجع س == 0 و ص == 0

تأكد_يساوي(محدود("GGLLGG"), صواب, "يعود")
تأكد_يساوي(محدود("GG"), خطأ, "مستقيم")
تأكد_يساوي(محدود("GL"), صواب, "مربع")
