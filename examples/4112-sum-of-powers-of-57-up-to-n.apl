# مثال 4112 — مجموع قوى 57
# Sum of powers of 57
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4112-sum-of-powers-of-57-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 57 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 58, "حالة 2")
تأكد_يساوي(ف(3), 188500, "حالة 3")
تأكد_يساوي(ف(6), 34908883807, "حالة 4")
تأكد_يساوي(ف(10), 368498212375764307, "حالة 5")
