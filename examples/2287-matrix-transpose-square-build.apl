# مثال 2287 — منقول المصفوفة
# Matrix transpose
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2287-matrix-transpose-square-build.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ر = []
  لكل ي في نطاق(طول(م)):
    ص = []
    لكل ك في نطاق(طول(م)):
      ص = ص + [م[ك][ي]]
    ر = ر + [ص]
  ارجع ر

تأكد_يساوي(ف([[1, 2], [3, 4]]), [[1, 3], [2, 4]], "حالة 1")
تأكد_يساوي(ف([[5]]), [[5]], "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), [[1, 4, 7], [2, 5, 8], [3, 6, 9]], "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), [[0, 1], [1, 0]], "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), [[2, 0, 1], [-1, 3, 1], [0, 1, 1]], "حالة 5")
