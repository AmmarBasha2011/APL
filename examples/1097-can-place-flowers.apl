# مثال 1097 — زراعة الزهور
# Can place flowers
# Demonstrates: فحص الجيران
#
# Run:  python apl.py examples/1097-can-place-flowers.apl

# نزرع في أي موضع فارغ جيرانه فارغان أو حدود
# وكل زرع يغير حالة الجار التالي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يمكن_زرع(ارض, ن):
  ق = قائمة(ارض)
  عدد_ = 0
  لكل ع في نطاق(طول(ق)):
    لو ق[ع] == 0:
      يسار_فارغ = (ع == 0) أو (ق[ع - 1] == 0)
      يمين_فارغ = (ع == (طول(ق) - 1)) أو (ق[ع + 1] == 0)
      لو يسار_فارغ و يمين_فارغ:
        ق[ع] = 1
        عدد_ = عدد_ + 1
  ارجع عدد_ >= ن

تأكد_يساوي(يمكن_زرع([1, 0, 0, 0, 1], 1), صواب, "زهرة واحدة")
تأكد_يساوي(يمكن_زرع([1, 0, 0, 0, 1], 2), خطأ, "زهرتان")
تأكد_يساوي(يمكن_زرع([0, 0, 1, 0, 0], 2), صواب, "الطرفان")
تأكد_يساوي(يمكن_زرع([0], 1), صواب, "خانة واحدة")
