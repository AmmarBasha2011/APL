# مثال 1350 — السباحة في الماء المرتفع
# Swim in rising water
# Demonstrates: رسوم بيانية
#
# Run:  python apl.py examples/1350-swim-rising-water.apl

# الزمن هو أكبر ارتفاع على المسار
# نبحث ثنائياً عن أقل زمن يسمح بالوصول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يمكن_العبور(ش, زمن):
  ن = طول(ش)
  لو ش[0][0] > زمن:
    ارجع خطأ
  مرئي = []
  لكل ع في نطاق(ن):
    مرئي.ألحق([خطأ] * ن)
  مرئي[0][0] = صواب
  مكدس = [[0, 0]]
  طالما طول(مكدس) > 0:
    ق = مكدس.pop()
    لو (ق[0] == ن - 1) و (ق[1] == ن - 1):
      ارجع صواب
    لكل د في [[1,0],[-1,0],[0,1],[0,-1]]:
      ص = ق[0] + د[0]
      ج = ق[1] + د[1]
      لو (ص >= 0) و (ص < ن) و (ج >= 0) و (ج < ن):
        لو (ليس مرئي[ص][ج]) و (ش[ص][ج] <= زمن):
          مرئي[ص][ج] = صواب
          مكدس.ألحق([ص, ج])
  ارجع خطأ

دالة اقل_زمن(ش):
  ادنى = 0
  اعلى = طول(ش) * طول(ش)
  طالما ادنى < اعلى:
    وسط = (ادنى + اعلى) // 2
    لو يمكن_العبور(ش, وسط):
      اعلى = وسط
    والا:
      ادنى = وسط + 1
  ارجع ادنى

تأكد_يساوي(اقل_زمن([[0,2],[1,3]]), 3, "شبكة صغيرة")
تأكد_يساوي(اقل_زمن([[0,1,2,3,4],[24,23,22,21,5],[12,13,14,15,16],[11,17,18,19,20],[10,9,8,7,6]]), 16, "شبكة كبيرة")
تأكد_يساوي(اقل_زمن([[0]]), 0, "خلية")
