# مثال 812 — لعبة نيم
# Nim game
# Demonstrates: nim-sum بXOR، نقلة فائزة
#
# Run:  python apl.py examples/812-nim-game.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# لعبة نيم: المجموع الصفري بXOR يحدد الوضعية الخاسرة والنقلة الفائزة
# Demonstrates: nim-sum بالحصر الثنائي, استراتيجية برتراند, محاكاة نقلات

دالة مجموع_نيم(أكوام):
  س = 0
  لكل كومة في أكوام:
    س = س ^ كومة
  ارجع س

دالة نقلة_فائزة(أكوام):
  س = مجموع_نيم(أكوام)
  لو س == 0:
    ارجع [0 - 1, 0 - 1]
  لكل ي في نطاق(طول(أكوام)):
    هدف = أكوام[ي] ^ س
    لو هدف < أكوام[ي]:
      ارجع [ي, هدف]
  ارجع [0 - 1, 0 - 1]

تأكد_يساوي(مجموع_نيم([3, 4, 5]), 2, "مجموع 3 4 5")
تأكد_يساوي(مجموع_نيم([1, 2, 3]), 0, "وضعية خاسرة")
تأكد_يساوي(نقلة_فائزة([3, 4, 5]), [0, 1], "الكومة الأولى إلى واحد")
تأكد_يساوي(نقلة_فائزة([1, 2, 3]), [0 - 1, 0 - 1], "لا نقلة فائزة")
أكوام = [3, 4, 5]
نقلة = نقلة_فائزة(أكوام)
أكوام[نقلة[0]] = نقلة[1]
تأكد_يساوي(مجموع_نيم(أكوام), 0, "النقلة تصفي المجموع")
تأكد_يساوي(مجموع_نيم([7, 7, 7]), 7, "ثلاثة متساوية")
