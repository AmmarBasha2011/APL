# مثال 3552 — السعر بعد خصم 28 بالمئة
# Price after 28 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3552-price-after-28-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 28 // 100

تأكد_يساوي(ف(100), 72, "حالة 1")
تأكد_يساوي(ف(250), 180, "حالة 2")
تأكد_يساوي(ف(999), 720, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
