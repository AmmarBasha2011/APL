# مثال 2905 — قيصر بإزاحة 20
# Caesar shift 20
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2905-caesar-shift-by-20-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 20) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "uvw", "حالة 1")
تأكد_يساوي(ف("xyz"), "rst", "حالة 2")
تأكد_يساوي(ف("hello world"), "byffi qilfx", "حالة 3")
تأكد_يساوي(ف("a1"), "u1", "حالة 4")
