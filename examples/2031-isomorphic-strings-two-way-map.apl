# مثال 2031 — نصان متشابهان في البنية
# Isomorphic strings
# Demonstrates: قواميس
#
# Run:  python apl.py examples/2031-isomorphic-strings-two-way-map.apl

# # نبني خريطتين من الأول للثاني والعكس
# # أي تعارض يعني أنهما غير متشابهين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متشابهان(ا, ب):
  لو طول(ا) != طول(ب):
    ارجع خطأ
  خ1 = {}
  خ2 = {}
  لكل ك في نطاق(طول(ا)):
    لو ا[ك] في خ1 و خ1[ا[ك]] != ب[ك]:
      ارجع خطأ
    لو ب[ك] في خ2 و خ2[ب[ك]] != ا[ك]:
      ارجع خطأ
    خ1[ا[ك]] = ب[ك]
    خ2[ب[ك]] = ا[ك]
  ارجع صواب

تأكد_يساوي(متشابهان("egg", "add"), صواب, "egg")
تأكد_يساوي(متشابهان("foo", "bar"), خطأ, "foo")
تأكد_يساوي(متشابهان("paper", "title"), صواب, "paper")
تأكد_يساوي(متشابهان("ab", "aa"), خطأ, "اتجاه عكسي")
