# مثال 353 — صنف مصفوفة
# Matrix class
# Demonstrates: جمع وضرب مصفوفات 2x2
#
# Run:  python apl.py examples/353-matrix-class.apl

صنف مصفوفة:
    دالة_إنشاء(ذات, خلايا):
        ذات.خلايا = خلايا

    دالة اجمع(ذات, أخرى):
        المتغير نتيجة = []
        لكل ي في نطاق(2):
            المتغير سطر = []
            لكل ز في نطاق(2):
                سطر.أضف(ذات.خلايا[ي][ز] + أخرى.خلايا[ي][ز])
            نتيجة.أضف(سطر)
        ارجع مصفوفة(نتيجة)

    دالة محدد(ذات):
        ارجع ذات.خلايا[0][0] * ذات.خلايا[1][1] - ذات.خلايا[0][1] * ذات.خلايا[1][0]

    دالة اطبعها(ذات):
        لكل سطر في ذات.خلايا:
            اطبع سطر

المتغير أ = مصفوفة([[1, 2], [3, 4]])
المتغير ب = مصفوفة([[5, 6], [7, 8]])
أ.اجمع(ب).اطبعها()
اطبع "محدد أ:", أ.محدد()
