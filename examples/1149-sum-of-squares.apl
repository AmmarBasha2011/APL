# مثال 1149 — مجموع مربعين
# Sum of two squares
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1149-sum-of-squares.apl

# نبدأ بمؤشرين من الصفر والجذر
# ونحرك أحدهما حسب المقارنة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجموع_مربعين(ن):
  أ = 0
  ب = صحيح(ن ** 0.5)
  طالما أ <= ب:
    س = أ * أ + ب * ب
    لو س == ن:
      ارجع صواب
    والا_لو س < ن:
      أ = أ + 1
    والا:
      ب = ب - 1
  ارجع خطأ

تأكد_يساوي(مجموع_مربعين(5), صواب, "خمسة")
تأكد_يساوي(مجموع_مربعين(3), خطأ, "ثلاثة")
تأكد_يساوي(مجموع_مربعين(0), صواب, "صفر")
تأكد_يساوي(مجموع_مربعين(25), صواب, "خمسة وعشرون")
تأكد_يساوي(مجموع_مربعين(21), خطأ, "واحد وعشرون")
