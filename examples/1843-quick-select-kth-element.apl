# مثال 1843 — اختيار العنصر ذو الترتيب ك
# Quickselect kth smallest
# Demonstrates: فرز
#
# Run:  python apl.py examples/1843-quick-select-kth-element.apl

# نقسم حول المحور
# نكمل في الجزء الذي فيه الترتيب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اختر(ق, ك):
  محور = ق[0]
  أصغر_قائمة = []
  مساوي = []
  أكبر_قائمة = []
  لكل ع في ق:
    لو ع < محور:
      أصغر_قائمة.append(ع)
    والا_لو ع == محور:
      مساوي.append(ع)
    والا:
      أكبر_قائمة.append(ع)
  لو ك < طول(أصغر_قائمة):
    ارجع اختر(أصغر_قائمة, ك)
  لو ك < طول(أصغر_قائمة) + طول(مساوي):
    ارجع محور
  ارجع اختر(أكبر_قائمة, ك - طول(أصغر_قائمة) - طول(مساوي))

تأكد_يساوي(اختر([7, 2, 9, 4, 1], 0), 1, "الأصغر")
تأكد_يساوي(اختر([7, 2, 9, 4, 1], 2), 4, "الأوسط")
تأكد_يساوي(اختر([7, 2, 9, 4, 1], 4), 9, "الأكبر")
