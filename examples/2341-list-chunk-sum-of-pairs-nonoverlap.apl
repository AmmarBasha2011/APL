# مثال 2341 — مجموع أزواج غير متداخلة
# Non overlapping pair sums
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2341-list-chunk-sum-of-pairs-nonoverlap.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ي في نطاق(0, طول(ق), 2):
    لو ي + 1 < طول(ق):
      ر = ر + [ق[ي] + ق[ي + 1]]
    والا:
      ر = ر + [ق[ي]]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3, 4]), [3, 7], "حالة 1")
تأكد_يساوي(ف([1, 2, 3]), [3, 3], "حالة 2")
تأكد_يساوي(ف([5]), [5], "حالة 3")
تأكد_يساوي(ف([]), [], "حالة 4")
