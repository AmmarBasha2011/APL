# مثال 2213 — حذف المتجاورات المكررة
# Collapse adjacent duplicates
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2213-remove-adjacent-duplicate-letters.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ر == "" أو ر[-1] != ح:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("aabbcc"), "abc", "حالة 1")
تأكد_يساوي(ف("abc"), "abc", "حالة 2")
تأكد_يساوي(ف("aaaa"), "a", "حالة 3")
تأكد_يساوي(ف("abba"), "aba", "حالة 4")
