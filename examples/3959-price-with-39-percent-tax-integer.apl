# مثال 3959 — السعر مع ضريبة 39 بالمئة
# Price with 39 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3959-price-with-39-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 39 // 100

تأكد_يساوي(ف(100), 139, "حالة 1")
تأكد_يساوي(ف(250), 347, "حالة 2")
تأكد_يساوي(ف(999), 1388, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
