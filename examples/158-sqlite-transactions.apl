# مثال 158 — المعاملات والتراجع
# Transactions and rollback
# Demonstrates: تأكد، تراجع، حاول/إمسك
#
# Run:  python apl.py examples/158-sqlite-transactions.apl

المتغير مسار = "/tmp/apl_bank.db"
لو موجود(مسار):
    احذف_ملف(مسار)

المتغير قاعدة = افتح_قاعدة(مسار)
المتغير م = قاعدة.مؤشر()
م.نفذ("CREATE TABLE حسابات (الاسم TEXT PRIMARY KEY, الرصيد INTEGER)")
م.نفذ("INSERT INTO حسابات VALUES ('عمار', 1000)")
م.نفذ("INSERT INTO حسابات VALUES ('سارة', 500)")
قاعدة.تأكد()

حاول:
    م.نفذ("UPDATE حسابات SET الرصيد = الرصيد - 200 WHERE الاسم = 'عمار'")
    م.نفذ("UPDATE حسابات SET الرصيد = الرصيد + 200 WHERE الاسم = 'سارة'")
    قاعدة.تأكد()
    اطبع "التحويل تم بنجاح"
إمسك مثل خطأ:
    قاعدة.تراجع()
    اطبع "فشل، تم التراجع:", خطأ

اطبع "رصيد عمار:", م.execute("SELECT الرصيد FROM حسابات WHERE الاسم = 'عمار'").جلب_واحد()[0]
اطبع "رصيد سارة:", م.execute("SELECT الرصيد FROM حسابات WHERE الاسم = 'سارة'").جلب_واحد()[0]

قاعدة.أغلق_قاعدة()
احذف_ملف(مسار)
