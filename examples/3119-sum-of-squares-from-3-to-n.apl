# مثال 3119 — مجموع المربعات من 3 إلى ن
# Sum of squares from 3
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3119-sum-of-squares-from-3-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(3, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(3), 9, "حالة 1")
تأكد_يساوي(ف(4), 25, "حالة 2")
تأكد_يساوي(ف(13), 814, "حالة 3")
تأكد_يساوي(ف(100), 338345, "حالة 4")
