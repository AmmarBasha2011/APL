# مثال 3958 — السعر مع ضريبة 38 بالمئة
# Price with 38 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3958-price-with-38-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 38 // 100

تأكد_يساوي(ف(100), 138, "حالة 1")
تأكد_يساوي(ف(250), 345, "حالة 2")
تأكد_يساوي(ف(999), 1378, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
