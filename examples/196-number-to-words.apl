# مثال 196 — تحويل الأرقام إلى كلمات عربية
# Numbers to Arabic words
# Demonstrates: قواميس، بناء نصوص شرطي
#
# Run:  python apl.py examples/196-number-to-words.apl

المتغير آحاد = {0: "صفر", 1: "واحد", 2: "اثنان", 3: "ثلاثة", 4: "أربعة", 5: "خمسة", 6: "ستة", 7: "سبعة", 8: "ثمانية", 9: "تسعة", 10: "عشرة", 11: "أحد عشر", 12: "اثنا عشر", 13: "ثلاثة عشر", 14: "أربعة عشر", 15: "خمسة عشر", 16: "ستة عشر", 17: "سبعة عشر", 18: "ثمانية عشر", 19: "تسعة عشر"}
المتغير عشرات = {2: "عشرون", 3: "ثلاثون", 4: "أربعون", 5: "خمسون", 6: "ستون", 7: "سبعون", 8: "ثمانون", 9: "تسعون"}

دالة بالكلمات(ن):
    لو ن < 20:
        ارجع آحاد[ن]
    المتغير ع = ن // 10
    المتغير أ = ن % 10
    لو أ == 0:
        ارجع عشرات[ع]
    ارجع آحاد[أ] + " و" + عشرات[ع]

لكل ن في [0, 5, 11, 20, 23, 57, 99]:
    اطبع ن, "=", بالكلمات(ن)
