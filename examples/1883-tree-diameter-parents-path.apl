# مثال 1883 — قطر الشجرة
# Tree diameter by BFS twice
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1883-tree-diameter-parents-path.apl

# نبحث عن أبعد عقدة من أي بداية
# ثم أبعد عقدة منها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أبعد(جيران, بداية):
  مسافة = {}
  مسافة[نص(بداية)] = 0
  طابور = [بداية]
  أفضل = بداية
  طالما طول(طابور) > 0:
    ع = طابور.pop(0)
    لكل ج في جيران[ع]:
      لو (نص(ج) في مسافة) == خطأ:
        مسافة[نص(ج)] = مسافة[نص(ع)] + 1
        طابور.append(ج)
        لو مسافة[نص(ج)] > مسافة[نص(أفضل)]:
          أفضل = ج
  ارجع [أفضل, مسافة[نص(أفضل)]]

دالة قطر(ن, حواف):
  جيران = []
  لكل ك في نطاق(ن):
    جيران.append([])
  لكل ح في حواف:
    جيران[ح[0]].append(ح[1])
    جيران[ح[1]].append(ح[0])
  أول = أبعد(جيران, 0)
  ارجع أبعد(جيران, أول[0])[1]

تأكد_يساوي(قطر(5, [[0, 1], [1, 2], [2, 3], [1, 4]]), 3, "خمس عقد")
تأكد_يساوي(قطر(2, [[0, 1]]), 1, "عقدتان")
تأكد_يساوي(قطر(4, [[0, 1], [0, 2], [0, 3]]), 2, "نجمة")
