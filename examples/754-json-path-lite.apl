# مثال 754 — مسارات JSON
# JSONPath lite
# Demonstrates: تحليل مسار، حقول، فهارس معقوفة
#
# Run:  python apl.py examples/754-json-path-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مقيّم مسارات JSON مبسط: $.a.b[0].c
# Demonstrates: تحليل مسار نصي, نزول في قواميس وقوائم, فهارس معقوفة
# يدعم النقطة للحقول والأقواس المعقوفة للفهارس

دالة حلل_مسار(مسار):
  خطوات = []
  حالي = ""
  ي = 0
  طالما ي < طول(مسار):
    حرف = مسار[ي]
    لو حرف == ".":
      لو حالي != "":
        خطوات.append(["حقل", حالي])
        حالي = ""
    والا_لو حرف == "[":
      لو حالي != "":
        خطوات.append(["حقل", حالي])
        حالي = ""
      نهاية = مسار.index("]", ي)
      خطوات.append(["فهرس", صحيح(مسار[ي + 1:نهاية])])
      ي = نهاية
    والا_لو حرف != "$":
      حالي = حالي + حرف
    ي = ي + 1
  لو حالي != "":
    خطوات.append(["حقل", حالي])
  ارجع خطوات

دالة طبق(بيانات, مسار):
  حالي = بيانات
  لكل خطوة في حلل_مسار(مسار):
    لو خطوة[0] == "حقل":
      حالي = حالي.get(خطوة[1], لا_شيء)
    والا:
      لو حالي == لا_شيء:
        ارجع لا_شيء
      لو خطوة[1] < 0 أو خطوة[1] >= طول(حالي):
        ارجع لا_شيء
      حالي = حالي[خطوة[1]]
  ارجع حالي

بيانات = {
  "متجر": {
    "كتب": [
      {"عنوان": "الأول", "سعر": 8},
      {"عنوان": "الثاني", "سعر": 12}
    ],
    "دراجة": {"لون": "أحمر"}
  },
  "غالي": صواب
}

تأكد_يساوي(طبق(بيانات, "$.متجر.دراجة.لون"), "أحمر", "حقل متداخل")
تأكد_يساوي(طبق(بيانات, "$.متجر.كتب[0].عنوان"), "الأول", "فهرس ثم حقل")
تأكد_يساوي(طبق(بيانات, "$.متجر.كتب[1].سعر"), 12, "سعر الكتاب الثاني")
تأكد_يساوي(طبق(بيانات, "$.غالي"), صواب, "قيمة منطقية")
تأكد_يساوي(طبق(بيانات, "$.متجر.غيرموجود"), لا_شيء, "حقل مفقود")
تأكد_يساوي(طبق(بيانات, "$.متجر.كتب[5]"), لا_شيء, "فهرس خارج النطاق")
تأكد_يساوي(طبق(بيانات, "$.متجر.غيرموجود[0].عميق"), لا_شيء, "سلسلة مفقودة")

تأكد_يساوي(حلل_مسار("$.a.b[2]"), [["حقل", "a"], ["حقل", "b"], ["فهرس", 2]], "خطوات المسار")

اطبع "اللون:", طبق(بيانات, "$.متجر.دراجة.لون")
