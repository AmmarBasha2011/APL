# مثال 4310 — مجموع قوى 60
# Sum of powers of 60
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4310-sum-of-powers-of-60-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 60 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 61, "حالة 2")
تأكد_يساوي(ف(3), 219661, "حالة 3")
تأكد_يساوي(ف(6), 47446779661, "حالة 4")
تأكد_يساوي(ف(10), 614910264406779661, "حالة 5")
