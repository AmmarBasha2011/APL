# مثال 3986 — مجموع ord مع إزاحة 20
# Sum of ord values plus 20 each
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3986-sum-of-ord-values-offset-20.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ح في ن:
    م = م + ord(ح) + 20
  ارجع م

تأكد_يساوي(ف("a"), 117, "حالة 1")
تأكد_يساوي(ف("abc"), 354, "حالة 2")
تأكد_يساوي(ف("xyz"), 423, "حالة 3")
تأكد_يساوي(ف(""), 0, "حالة 4")
