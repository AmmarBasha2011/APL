# مثال 433 — محاذاة النصوص
# Text alignment
# Demonstrates: يمين ويسار ووسط
#
# Run:  python apl.py examples/433-column-align.apl

دالة حاذي(نص_الدخل, عرض_مطلوب, اتجاه):
    المتغير نقص = عرض_مطلوب - طول(نص_الدخل)
    لو نقص <= 0:
        ارجع نص_الدخل
    المتغير فراغ = ""
    لكل _ في نطاق(نقص):
        فراغ = فراغ + " "
    لو اتجاه == "يمين":
        ارجع فراغ + نص_الدخل
    الا لو اتجاه == "وسط":
        ارجع نص_الدخل + فراغ
    ارجع نص_الدخل + فراغ

اطبع "[" + حاذي("42", 8, "يمين") + "]"
اطبع "[" + حاذي("42", 8, "يسار") + "]"
