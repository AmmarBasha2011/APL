# مثال 1439 — مربع صالح
# Valid square from four points
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1439-valid-square-points.apl

# نحسب مربعات المسافات الست
# أربع متساوية وموجبة واثنتان ضعفها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مربع_صالح(ن):
  م = []
  لكل ي في نطاق(4):
    لكل ك في نطاق(ي + 1, 4):
      فس = ن[ي][0] - ن[ك][0]
      فص = ن[ي][1] - ن[ك][1]
      م.ألحق(فس * فس + فص * فص)
  م = مفرز(م)
  ارجع (م[0] > 0) و (م[0] == م[3]) و (م[4] == م[5]) و (م[4] == 2 * م[0])

تأكد_يساوي(مربع_صالح([[0,0],[1,1],[1,0],[0,1]]), صواب, "مربع")
تأكد_يساوي(مربع_صالح([[0,0],[1,1],[1,0],[0,12]]), خطأ, "ليس مربعاً")
تأكد_يساوي(مربع_صالح([[1,0],[-1,0],[0,1],[0,-1]]), صواب, "مائل")
