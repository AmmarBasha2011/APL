# مثال 237 — آلة الحالات (إشارة مرور)
# State machine (traffic light)
# Demonstrates: انتقالات الحالات
#
# Run:  python apl.py examples/237-state-machine.apl

صنف إشارة:
    دالة_إنشاء(ذات):
        ذات.حالة = "أحمر"

    دالة التالي(ذات):
        حالة ذات.حالة:
            قيمة "أحمر":
                ذات.حالة = "أخضر"
            قيمة "أخضر":
                ذات.حالة = "أصفر"
            افتراضي:
                ذات.حالة = "أحمر"
        ارجع ذات.حالة

المتغير إ = إشارة()
اطبع "البداية:", إ.حالة
لكل _ في نطاق(4):
    اطبع "->", إ.التالي()
