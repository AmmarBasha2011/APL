# مثال 2027 — هل النص الأول تتابع من الثاني
# Is subsequence two pointers
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/2027-is-subsequence-two-pointer-scan.apl

# # مؤشر على النص الأول يتقدم عند التطابق
# # ننجح إذا استنفدنا النص الأول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تتابع(ا, ب):
  ي = 0
  لكل ح في ب:
    لو ي < طول(ا) و ح == ا[ي]:
      ي = ي + 1
  ارجع ي == طول(ا)

تأكد_يساوي(تتابع("abc", "ahbgdc"), صواب, "موجود")
تأكد_يساوي(تتابع("axc", "ahbgdc"), خطأ, "غير موجود")
تأكد_يساوي(تتابع("", "abc"), صواب, "فارغ")
