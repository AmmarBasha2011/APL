# مثال 814 — شفرة ADFGVX
# ADFGVX cipher
# Demonstrates: مربع 6x6، نقل عمودي
#
# Run:  python apl.py examples/814-adfgvx.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شفرة ADFGVX الألمانية: استبدال بمربع 6x6 ثم نقل عمودي
# Demonstrates: مربع مختلط بالأرقام, تسميات ستة محارف, نقل بترتيب مفتاح

مربع = "NA1C3H8TB2OME5WRPD4F6G7I9J0KQLSUXVYZ"
تسميات = "ADFGVX"

دالة موقع_مربع(ح):
  لكل ي في نطاق(36):
    لو مربع[ي] == ح:
      ارجع ي
  ارجع 0 - 1

دالة استبدال(نص):
  أزواج = ""
  لكل ح في نص:
    م = موقع_مربع(ح)
    أزواج = أزواج + تسميات[م // 6] + تسميات[م % 6]
  ارجع أزواج

دالة ترتيب_مفتاح(مفتاح):
  دلائل = []
  لكل ي في نطاق(طول(مفتاح)):
    دلائل.append(ي)
  لكل ي في نطاق(طول(دلائل)):
    أدنى = ي
    لكل ج في نطاق(ي + 1, طول(دلائل)):
      لو مفتاح[دلائل[ج]] < مفتاح[دلائل[أدنى]]:
        أدنى = ج
    مؤقت = دلائل[ي]
    دلائل[ي] = دلائل[أدنى]
    دلائل[أدنى] = مؤقت
  ارجع دلائل

دالة شفر(نص, مفتاح):
  أزواج = استبدال(نص)
  ن = طول(مفتاح)
  ناتج = ""
  لكل عمود في ترتيب_مفتاح(مفتاح):
    صف = 0
    طالما صف * ن + عمود < طول(أزواج):
      ناتج = ناتج + أزواج[صف * ن + عمود]
      صف = صف + 1
  ارجع ناتج

تأكد_يساوي(استبدال("A1"), "ADAF", "استبدال A1")
تأكد_يساوي(استبدال("ATTACK"), "ADDDDDADAGVG", "استبدال ATTACK")
تأكد_يساوي(شفر("ATTACK", "GOLD"), "DDGADADAVDDG", "تشفير ATTACK")
تأكد_يساوي(شفر("HELLO123", "KEY"), "XVXAGAAVVDVFXDFA", "تشفير مع أرقام")
تأكد_يساوي(طول(شفر("HELLO123", "KEY")), 16, "الطول مضاعف")
