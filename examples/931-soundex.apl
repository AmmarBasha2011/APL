# مثال 931 — ترميز ساوندكس
# Soundex
# Demonstrates: فئات نطق مرقمة
#
# Run:  python apl.py examples/931-soundex.apl

# ترميز ساوندكس: تمثيل صوتي للأسماء الإنجليزية
# حرف أول + ثلاثة أرقام من فئات النطق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حرف_كبير(حرف):
  رمز = ترميز_حرف(حرف)
  لو رمز >= 97 و رمز <= 122:
    ارجع فك_ترميز_حرف(رمز - 32)
  ارجع حرف

دالة رقم_حرف(حرف0):
  حرف = حرف_كبير(حرف0)
  لو حرف == "B" أو حرف == "F" أو حرف == "P" أو حرف == "V":
    ارجع 1
  لو حرف == "C" أو حرف == "G" أو حرف == "J" أو حرف == "K" أو حرف == "Q" أو حرف == "S" أو حرف == "X" أو حرف == "Z":
    ارجع 2
  لو حرف == "D" أو حرف == "T":
    ارجع 3
  لو حرف == "L":
    ارجع 4
  لو حرف == "M" أو حرف == "N":
    ارجع 5
  لو حرف == "R":
    ارجع 6
  ارجع 0

دالة ساوندكس(اسم):
  أول = اسم[0]
  خرج = أول
  سابق = رقم_حرف(أول)
  لكل i في نطاق(1, طول(اسم)):
    رقم = رقم_حرف(اسم[i])
    لو (رقم != 0) و (رقم != سابق):
      خرج = خرج + نص(رقم)
    لو رقم != 0:
      سابق = رقم
  # اقتطع لثلاثة أرقام واملأ بالأصفار
  طالما طول(خرج) < 4:
    خرج = خرج + "0"
  لو طول(خرج) > 4:
    خرج = خرج[:4]
  ارجع خرج

اطبع "Robert:", ساوندكس("Robert")
اطبع "Rupert:", ساوندكس("Rupert")
اطبع "Ashcraft:", ساوندكس("Ashcraft")

تأكد_يساوي(ساوندكس("Robert"), "R163", "روبرت")
تأكد_يساوي(ساوندكس("Rupert"), "R163", "روبرت مثل روبرت")
تأكد_يساوي(ساوندكس("Ashcraft"), "A261", "آشكرافت")
تأكد_يساوي(ساوندكس("Lee"), "L000", "حشوة أصفار")
