# مثال 375 — إشارة حد التزامن بين الخيوط
# Thread semaphore
# Demonstrates: تقييد عدد الخيوط النشطة
#
# Run:  python apl.py examples/375-thread-semaphore.apl

المتغير إشارة = أنشئ_إشارة(2)
المتغير نشطة = {"عدد": 0, "أعلى": 0}
المتغير قفل = أنشئ_قفل()

دالة مهمة(رقم):
    إشارة.acquire()
    قفل.acquire()
    نشطة["عدد"] = نشطة["عدد"] + 1
    لو نشطة["عدد"] > نشطة["أعلى"]:
        نشطة["أعلى"] = نشطة["عدد"]
    قفل.release()
    نوم_خيوط(0.01)
    قفل.acquire()
    نشطة["عدد"] = نشطة["عدد"] - 1
    قفل.release()
    إشارة.release()

المتغير خيوط = []
لكل ي في نطاق(6):
    المتغير ت = أنشئ_ثريد(target=مهمة, args=(ي,))
    خيوط.أضف(ت)
    ت.start()
لكل ت في خيوط:
    ت.join()

اطبع "أعلى تزامن (يجب ألا يتجاوز 2):", نشطة["أعلى"]
