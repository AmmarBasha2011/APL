# مثال 540 — مصفوفة Z
# Z-algorithm
# Demonstrates: مصفوفة Z، مطابقة أنماط خطية
#
# Run:  python apl.py examples/540-z-algorithm.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# مصفوفة Z للبحث عن نمط
دالة مصفوفة_زد(نص):
    المتغير ن = طول(نص)
    المتغير ز = [0] * ن
    المتغير ب = 0
    المتغير ي = 0
    لكل i في نطاق(1, ن):
        لو i <= ي:
            ز[i] = أصغر(ي - i + 1, ز[i - ب])
        طالما i + ز[i] < ن و نص[ز[i]] == نص[i + ز[i]]:
            ز[i] = ز[i] + 1
        لو i + ز[i] - 1 > ي:
            ب = i
            ي = i + ز[i] - 1
    ارجع ز

دالة بحث_زد(نص, نمط):
    المتغير مدمج = نمط + "#" + نص
    المتغير ز = مصفوفة_زد(مدمج)
    المتغير مواضع = قائمة()
    لكل i في نطاق(طول(نمط) + 1, طول(مدمج)):
        لو ز[i] == طول(نمط):
            مواضع.أضف(i - طول(نمط) - 1)
    ارجع مواضع

تأكد_يساوي(مصفوفة_زد("aabxaab"), [0, 1, 0, 0, 3, 1, 0], "مصفوفة Z")
تأكد_يساوي(بحث_زد("abxabcabcaby", "abc"), [3, 6], "مواضع التطابق")
