# مثال 1267 — كاشف الألغام
# Minesweeper neighbor counts
# Demonstrates: شبكة
#
# Run:  python apl.py examples/1267-minesweeper-count.apl

# نمر على الخانات ونعد الألغام في الجيران الثمانية
# ونتجاهل خانة اللغم نفسها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عد_الغام(ش):
  ر_ = طول(ش)
  ك_ = طول(ش[0])
  ناتج = []
  لكل ص في نطاق(ر_):
    صف = []
    لكل ج في نطاق(ك_):
      لو ش[ص][ج] == "*":
        صف.ألحق("*")
      والا:
        ع = 0
        لكل د1 في [-1, 0, 1]:
          لكل د2 في [-1, 0, 1]:
            ر = ص + د1
            ك = ج + د2
            لو (ر >= 0) و (ر < ر_) و (ك >= 0) و (ك < ك_):
              لو ش[ر][ك] == "*":
                ع = ع + 1
        صف.ألحق(نص(ع))
    ناتج.ألحق(صف)
  ارجع ناتج

تأكد_يساوي(عد_الغام([[".","*","."],[".",".","."],["*",".","."]]), [["1","*","1"],["2","2","1"],["*","1","0"]], "لوحة صغيرة")
تأكد_يساوي(عد_الغام([["."]]), [["0"]], "خانة")
تأكد_يساوي(عد_الغام([["*","*"]]), [["*","*"]], "ألغام فقط")
