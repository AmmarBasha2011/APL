# مثال 1796 — جمع عددين ثنائيين نصاً
# Add two binary strings
# Demonstrates: ترميز
#
# Run:  python apl.py examples/1796-binary-add-two-strings.apl

# نمر من آخر الرقم
# نحمل الواحد للتالي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اجمع_ثنائي(أ, ب):
  ي = طول(أ) - 1
  ك = طول(ب) - 1
  حمل = 0
  ناتج = ""
  طالما ي >= 0 أو ك >= 0 أو حمل > 0:
    مجموع = حمل
    لو ي >= 0:
      مجموع = مجموع + صحيح(أ[ي])
      ي = ي - 1
    لو ك >= 0:
      مجموع = مجموع + صحيح(ب[ك])
      ك = ك - 1
    ناتج = نص(مجموع % 2) + ناتج
    حمل = مجموع // 2
  ارجع ناتج

تأكد_يساوي(اجمع_ثنائي("11", "1"), "100", "حمل")
تأكد_يساوي(اجمع_ثنائي("1010", "1011"), "10101", "أربعة")
تأكد_يساوي(اجمع_ثنائي("0", "0"), "0", "صفر")
