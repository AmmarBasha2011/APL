# مثال 270 — بطاقات مراجعة
# Flashcards
# Demonstrates: خلط ومراجعة ذاتية
#
# Run:  python apl.py examples/270-flashcards.apl

بذرة(41)
المتغير بطاقات = [
    {"س": "عاصمة مصر؟", "ج": "القاهرة"},
    {"س": "5 × 6؟", "ج": "30"},
    {"س": "أكبر كوكب؟", "ج": "المشتري"}
]

خلط(بطاقات)
المتغير صحيحة = 0
لكل بطاقة في بطاقات:
    اطبع "سؤال:", بطاقة["س"]
    اطبع "جواب:", بطاقة["ج"]
    صحيحة = صحيحة + 1

اطبع "راجعت", صحيحة, "بطاقات"
