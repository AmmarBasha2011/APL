# مثال 480 — كاشف شذوذ السجلات
# Log anomaly detector
# Demonstrates: عد المحاولات الفاشلة لكل عنوان
#
# Run:  python apl.py examples/480-log-anomaly.apl

اكتب("/tmp/apl-480.log", "192.168.1.1 LOGIN_OK\n10.0.0.9 LOGIN_FAIL\n10.0.0.9 LOGIN_FAIL\n10.0.0.9 LOGIN_FAIL\n10.0.0.9 LOGIN_FAIL\n192.168.1.1 LOGIN_OK")

المتغير فاشلة = {}
المتغير سطور = اقرأ("/tmp/apl-480.log").تقليم().تقسيم("\n")
لكل سطر in سطور:
    المتغير أجزاء = سطر.تقسيم(" ")
    لو أجزاء[1] == "LOGIN_FAIL":
        المتغير قديم = فاشلة.get(أجزاء[0], 0)
        فاشلة[أجزاء[0]] = قديم + 1

لكل عنوان في فاشلة.keys():
    لو فاشلة[عنوان] >= 3:
        اطبع "تنبيه: محاولات مشبوهة من", عنوان, ":", فاشلة[عنوان]

احذف_ملف("/tmp/apl-480.log")
