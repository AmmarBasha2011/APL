# مثال 37 — قراءة وكتابة ملفات CSV
# CSV Report
# Demonstrates: csv library, file writing, parsing
#
# Run:  python apl.py examples/37-csv-report.apl

المتغير المسار = "_apl_report.csv"

# كتابة يدوية بصفوف نصية
المتغير المحتوى = "الاسم,القسم,الراتب\nأحمد,هندسة,8500\nسارة,طبيب,12000\nمحمد,محاسبة,7000"
اكتب(المسار, المحتوى)

اطبع "=== تقرير CSV ==="
اطبع ""
اطبع "--- الملف المكتوب ---"
اطبع اقرأ(المسار)

اطبع ""
اطبع "--- قراءة الصفوف ---"
المتغير الصفوف = []
لكل سطر في تقسيم(إزالة_التفافات(اقرأ(المسار)), "\n"):
    الصفوف.ألحق(تقسيم(سطر, ","))
اطبع "عدد الصفوف: " + نص(طول(الصفوف))
اطبع ""
اطبع "--- الرواتب ---"
رقم = 1
طالما رقم < طول(الصفوف):
    صف = الصفوف[رقم]
    اطبع "  " + صف[0] + " (" + صف[1] + "): " + صف[2]
    رقم = رقم + 1

احذف_ملف(المسار)
اطبع ""
اطبع "تم حذف الملف."
