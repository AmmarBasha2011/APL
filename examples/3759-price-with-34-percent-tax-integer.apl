# مثال 3759 — السعر مع ضريبة 34 بالمئة
# Price with 34 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3759-price-with-34-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 34 // 100

تأكد_يساوي(ف(100), 134, "حالة 1")
تأكد_يساوي(ف(250), 335, "حالة 2")
تأكد_يساوي(ف(999), 1338, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
