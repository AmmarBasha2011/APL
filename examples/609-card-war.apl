# مثال 609 — لعبة الحرب بالورق
# Card war simulation
# Demonstrates: ورق، محاكاة، جولات
#
# Run:  python apl.py examples/609-card-war.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# لعبة الحرب بالورق: محاكاة كاملة بمجموعتين ثابتتين
# Demonstrates: طابوران, جولات حرب بالتعادل, ثوابت اللعبة
# القاعدة: الأعلى يأخذ الورقتين، وعند التعادل حرب بثلاث ورقات

دالة العب_الحرب(يد_أ, يد_ب):
  جولات = 0
  طالما طول(يد_أ) > 0 و طول(يد_ب) > 0 و جولات < 5000:
    جولات = جولات + 1
    غنيمة = []
    أ = يد_أ.pop(0)
    ب = يد_ب.pop(0)
    غنيمة.append(أ)
    غنيمة.append(ب)
    طالما أ == ب و طول(يد_أ) >= 2 و طول(يد_ب) >= 2:
      لكل ك في نطاق(2):
        غنيمة.append(يد_أ.pop(0))
        غنيمة.append(يد_ب.pop(0))
      أ = يد_أ.pop(0)
      ب = يد_ب.pop(0)
      غنيمة.append(أ)
      غنيمة.append(ب)
    لو أ > ب:
      لكل ورقة في غنيمة:
        يد_أ.append(ورقة)
    والا:
      لكل ورقة في غنيمة:
        يد_ب.append(ورقة)
  ارجع [طول(يد_أ), طول(يد_ب), جولات]

يد_أ = [2, 5, 8, 11, 3, 6]
يد_ب = [4, 7, 10, 12, 9, 1]
نتيجة = العب_الحرب(يد_أ, يد_ب)
اطبع "النهاية: أ =", نتيجة[0], " ب =", نتيجة[1], " جولات =", نتيجة[2]
تأكد_يساوي(نتيجة[0] + نتيجة[1], 12, "الأوراق محفوظة")
تأكد_يساوي(نتيجة[0] == 0 أو نتيجة[1] == 0, صواب, "فائز حاسم")
تأكد_يساوي(نتيجة[2] > 0, صواب, "جولة واحدة على الأقل")
