# مثال 444 — صحة المثلث ونوعه
# Triangle validity and type
# Demonstrates: متباينة المثلث
#
# Run:  python apl.py examples/444-triangle-check.apl

دالة نوع_مثلث(أ, ب, ج):
    لو أ + ب <= ج أو أ + ج <= ب أو ب + ج <= أ:
        ارجع "غير صالح"
    لو أ == ب و ب == ج:
        ارجع "متساوي الأضلاع"
    لو أ == ب أو ب == ج أو أ == ج:
        ارجع "متساوي الساقين"
    ارجع "مختلف الأضلاع"

اطبع نوع_مثلث(3, 4, 5)
اطبع نوع_مثلث(5, 5, 5)
اطبع نوع_مثلث(5, 5, 8)
اطبع نوع_مثلث(1, 2, 10)
