# مثال 160 — اشتقاق مفاتيح كلمات السر
# Password key derivation with PBKDF2
# Demonstrates: اشتق_مفتاح، سر_بايتات
#
# Run:  python apl.py examples/160-hash-pbkdf2.apl

المتغير ملح = سر_بايتات(16)
المتغير مفتاح = اشتق_مفتاح("sha256", "كلمة-سر-قوية".encode(), ملح, 1000)
اطبع "المفتاح المشتق:", مفتاح.hex()[:24], "..."
اطبع "طول المفتاح (بايت):", طول(مفتاح)

المتغير مفتاح2 = اشتق_مفتاح("sha256", "كلمة-سر-قوية".encode(), ملح, 1000)
اطبع "نفس الملح = نفس المفتاح؟", مفتاح == مفتاح2
