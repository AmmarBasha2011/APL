# مثال 1166 — مطابقة بنجوم
# Wildcard pattern matching
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1166-wildcard-matching.apl

# علامة الاستفهام تطابق حرفاً واحداً
# والنجمة تطابق أي تسلسل حتى الفارغ

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تطابق(س, ن):
  د = []
  لكل ع في نطاق(طول(س) + 1):
    د.ألحق([خطأ] * (طول(ن) + 1))
  د[0][0] = صواب
  لكل ج في نطاق(1, طول(ن) + 1):
    لو ن[ج - 1] == "*":
      د[0][ج] = د[0][ج - 1]
  لكل ع في نطاق(1, طول(س) + 1):
    لكل ج في نطاق(1, طول(ن) + 1):
      لو ن[ج - 1] == "*":
        ا = د[ع - 1][ج]
        ب = د[ع][ج - 1]
        د[ع][ج] = ا أو ب
      والا_لو (ن[ج - 1] == "?") أو (ن[ج - 1] == س[ع - 1]):
        د[ع][ج] = د[ع - 1][ج - 1]
  ارجع د[طول(س)][طول(ن)]

تأكد_يساوي(تطابق("aa", "a"), خطأ, "قصير")
تأكد_يساوي(تطابق("aa", "*"), صواب, "نجمة")
تأكد_يساوي(تطابق("cb", "?a"), خطأ, "استفهام")
تأكد_يساوي(تطابق("adceb", "*a*b"), صواب, "نجمتان")
تأكد_يساوي(تطابق("", "***"), صواب, "فارغ")
