# مثال 212 — الطابور كصنف
# Queue as a class
# Demonstrates: صنف، إدخال وإخراج بالترتيب
#
# Run:  python apl.py examples/212-queue-class.apl

صنف طابور:
    دالة_إنشاء(ذات):
        ذات.عناصر = []

    دالة أدخل(ذات, عنصر):
        ذات.عناصر.أضف(عنصر)

    دالة أخرج_أول(ذات):
        لو ذات.فارغ():
            ارجع "طابور فارغ"
        ارجع ذات.عناصر.pop(0)

    دالة فارغ(ذات):
        ارجع طول(ذات.عناصر) == 0

المتغير ط = طابور()
ط.أدخل("أول")
ط.أدخل("ثاني")
ط.أدخل("ثالث")
اطبع ط.أخرج_أول()
اطبع ط.أخرج_أول()
ط.أدخل("رابع")
اطبع ط.أخرج_أول()
اطبع ط.أخرج_أول()
