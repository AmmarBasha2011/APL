# مثال 3329 — الحد النوني بخطوة 38
# Nth term step 38
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3329-nth-term-arithmetic-sequence-step-38.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 38

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 41, "حالة 2")
تأكد_يساوي(ف(10), 345, "حالة 3")
تأكد_يساوي(ف(100), 3765, "حالة 4")
