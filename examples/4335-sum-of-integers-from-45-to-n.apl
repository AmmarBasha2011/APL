# مثال 4335 — مجموع الأعداد من 45 إلى ن
# Sum from 45 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4335-sum-of-integers-from-45-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(45, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(45), 45, "حالة 1")
تأكد_يساوي(ف(46), 91, "حالة 2")
تأكد_يساوي(ف(55), 550, "حالة 3")
تأكد_يساوي(ف(100), 4060, "حالة 4")
