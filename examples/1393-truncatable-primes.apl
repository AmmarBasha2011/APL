# مثال 1393 — أولية قابلة للبتر
# Truncatable primes
# Demonstrates: رياضيات
#
# Run:  python apl.py examples/1393-truncatable-primes.apl

# نبتر من اليمين ومن اليسار
# كل ناتج يجب أن يكون أولياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  ع = 2
  طالما ع * ع <= ن:
    لو ن % ع == 0:
      ارجع خطأ
    ع = ع + 1
  ارجع صواب

دالة قابل_للبتر(ن):
  لو ن < 10:
    ارجع خطأ
  ن_نص = نص(ن)
  لكل ع في نطاق(طول(ن_نص)):
    لو ليس اولي(صحيح(ن_نص[ع:])):
      ارجع خطأ
    لو ليس اولي(صحيح(ن_نص[:ع + 1])):
      ارجع خطأ
  ارجع صواب

دالة ابحث(حد):
  ناتج = []
  لكل ن في نطاق(10, حد):
    لو قابل_للبتر(ن):
      ناتج.ألحق(ن)
  ارجع ناتج

تأكد_يساوي(قابل_للبتر(3797), صواب, "ثلاثة آلاف")
تأكد_يساوي(قابل_للبتر(313), صواب, "ثلاثمئة وثلاثة عشر")
تأكد_يساوي(قابل_للبتر(13), خطأ, "ثلاثة عشر")
تأكد_يساوي(ابحث(1000), [23,37,53,73,313,317,373,797], "أقل من ألف")
