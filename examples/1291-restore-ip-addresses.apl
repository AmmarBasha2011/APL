# مثال 1291 — استعادة عناوين
# Restore IP addresses
# Demonstrates: حلقات متداخلة
#
# Run:  python apl.py examples/1291-restore-ip-addresses.apl

# نجرب أربعة أجزاء كل منها بين صفر و255
# ولا يبدأ جزء متعدد الأرقام بصفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة صالح_جزء(ج):
  لو (طول(ج) == 0) أو (طول(ج) > 3):
    ارجع خطأ
  لو (طول(ج) > 1) و (ج[0] == "0"):
    ارجع خطأ
  ارجع صحيح(ج) <= 255

دالة عناوين(س):
  ناتج = []
  ن = طول(س)
  لكل ا في نطاق(1, 4):
    لكل ب في نطاق(1, 4):
      لكل ج في نطاق(1, 4):
        د = ن - ا - ب - ج
        لو (د >= 1) و (د <= 3):
          ج1 = س[:ا]
          ج2 = س[ا:ا + ب]
          ج3 = س[ا + ب:ا + ب + ج]
          ج4 = س[ا + ب + ج:]
          ك1 = صالح_جزء(ج1)
          ك2 = صالح_جزء(ج2)
          ك3 = صالح_جزء(ج3)
          ك4 = صالح_جزء(ج4)
          لو ك1 و ك2 و ك3 و ك4:
            ناتج.ألحق(ج1 + "." + ج2 + "." + ج3 + "." + ج4)
  ارجع ناتج

تأكد_يساوي(عناوين("25525511135"), ["255.255.11.135", "255.255.111.35"], "مثال أول")
تأكد_يساوي(عناوين("0000"), ["0.0.0.0"], "أصفار")
تأكد_يساوي(عناوين("101023"), ["1.0.10.23","1.0.102.3","10.1.0.23","10.10.2.3","101.0.2.3"], "ست خانات")
تأكد_يساوي(عناوين("1111"), ["1.1.1.1"], "واحدات")
