# مثال 469 — سجلات إلى جدول HTML
# Records to HTML table
# Demonstrates: توليد وسوم من بيانات
#
# Run:  python apl.py examples/469-html-table.apl

المتغير سجلات = [
    {"اسم": "عمار", "مدينة": "المنصورة"},
    {"اسم": "سارة", "مدينة": "القاهرة"}
]

المتغير صفحة = "<table>\n<tr><th>الاسم</th><th>المدينة</th></tr>\n"
لكل سجل في سجلات:
    صفحة = صفحة + "<tr><td>" + سجل["اسم"] + "</td><td>" + سجل["مدينة"] + "</td></tr>\n"
صفحة = صفحة + "</table>"

اكتب("/tmp/apl-469.html", صفحة)
اطبع "تم إنشاء الجدول:", موجود("/tmp/apl-469.html")
احذف_ملف("/tmp/apl-469.html")
