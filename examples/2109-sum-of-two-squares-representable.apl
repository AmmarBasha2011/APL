# مثال 2109 — العدد كمجموع مربعين
# Sum of two squares check
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/2109-sum-of-two-squares-representable.apl

# # نبحث عن a وb يحققان a²+b² = n
# # الصفر مسموح

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مربعين(ن):
  ا = 0
  طالما ا * ا <= ن:
    ب = ا
    طالما ا * ا + ب * ب <= ن:
      لو ا * ا + ب * ب == ن:
        ارجع صواب
      ب = ب + 1
    ا = ا + 1
  ارجع خطأ

تأكد_يساوي(مربعين(5), صواب, "٥")
تأكد_يساوي(مربعين(3), خطأ, "٣")
تأكد_يساوي(مربعين(25), صواب, "٢٥")
تأكد_يساوي(مربعين(0), صواب, "صفر")
تأكد_يساوي(مربعين(50), صواب, "٥٠")
تأكد_يساوي(مربعين(7), خطأ, "٧")
