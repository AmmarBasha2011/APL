# مثال 548 — أكبر مستطيل في هيستوجرام
# Largest rectangle in histogram
# Demonstrates: هيستوجرام، مكدس، مساحة قصوى
#
# Run:  python apl.py examples/548-largest-rectangle.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# أكبر مستطيل في هيستوجرام بمكدس
دالة أكبر_مستطيل(ارتفاعات):
    المتغير مكدس = قائمة()
    المتغير أقصى = 0
    المتغير ن = طول(ارتفاعات)
    لكل i في نطاق(ن + 1):
        المتغير حالي = 0
        لو i < ن:
            حالي = ارتفاعات[i]
        طالما طول(مكدس) > 0 و ارتفاعات[مكدس[طول(مكدس) - 1]] > حالي:
            المتغير ارتفاع = ارتفاعات[مكدس.pop()]
            المتغير عرض = i
            لو طول(مكدس) > 0:
                عرض = i - مكدس[طول(مكدس) - 1] - 1
            لو ارتفاع * عرض > أقصى:
                أقصى = ارتفاع * عرض
        مكدس.أضف(i)
    ارجع أقصى

تأكد_يساوي(أكبر_مستطيل([2, 1, 5, 6, 2, 3]), 10, "الكلاسيكي")
تأكد_يساوي(أكبر_مستطيل([2, 4]), 4, "شريطتان")
