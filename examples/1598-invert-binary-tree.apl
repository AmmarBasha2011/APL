# مثال 1598 — قلب شجرة ثنائية
# Invert a binary tree
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1598-invert-binary-tree.apl

# نقلب الفرعين أولاً
# ثم نبدل موضعيهما

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اقلب_الشجرة(ش):
  لو ش == []:
    ارجع []
  ارجع [ش[0], اقلب_الشجرة(ش[2]), اقلب_الشجرة(ش[1])]

تأكد_يساوي(اقلب_الشجرة([]), [], "فارغة")
تأكد_يساوي(اقلب_الشجرة([1, [2, [], []], [3, [], []]]), [1, [3, [], []], [2, [], []]], "عقدتان")
تأكد_يساوي(اقلب_الشجرة(اقلب_الشجرة([1, [2, [], []], []])), [1, [2, [], []], []], "مرتان")
