# مثال 203 — الترتيب بالعد
# Counting sort
# Demonstrates: مصفوفة التكرار، إعادة البناء
#
# Run:  python apl.py examples/203-counting-sort.apl

دالة ترتيب_عد(قائمة, أكبر):
    المتغير عد = [0 لكل _ في نطاق(أكبر + 1)]
    لكل ع في قائمة:
        عد[ع] = عد[ع] + 1
    المتغير نتيجة = []
    لكل قيمة في نطاق(أكبر + 1):
        لكل _ في نطاق(عد[قيمة]):
            نتيجة.أضف(قيمة)
    ارجع نتيجة

المتغير أرقام = [4, 2, 2, 8, 3, 3, 1]
اطبع "قبل:", أرقام
اطبع "بعد:", ترتيب_عد(أرقام, 8)
