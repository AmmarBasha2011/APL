# مثال 697 — تقاطع دائرتين
# Circle-circle intersection
# Demonstrates: مسافة مراكز، ارتفاع، تماس
#
# Run:  python apl.py examples/697-circle-circle-intersection.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تقاطع دائرتين في المستوى
# Demonstrates: مسافة مراكز, ارتفاع المثلث, حالات خاصة
# قائمة فارغة تعني لا تقاطع، نقطة واحدة تعني تماس

دالة تقاطع(س0, ع0, ن0, س1, ع1, ن1):
  فرق_س = س1 - س0
  فرق_ع = ع1 - ع0
  د = جذر(فرق_س * فرق_س + فرق_ع * فرق_ع)
  لو د > ن0 + ن1:
    ارجع []
  لو د < جذر((ن0 - ن1) * (ن0 - ن1)) - 0.0000001:
    ارجع []
  لو د == 0:
    ارجع []
  أ = (ن0 * ن0 - ن1 * ن1 + د * د) / (2.0 * د)
  ه2 = ن0 * ن0 - أ * أ
  لو ه2 < 0:
    ه2 = 0.0
  ه = جذر(ه2)
  س2 = س0 + أ * فرق_س / د
  ع2 = ع0 + أ * فرق_ع / د
  لو ه == 0:
    ارجع [[س2, ع2]]
  س3 = س2 - ه * فرق_ع / د
  ع3 = ع2 + ه * فرق_س / د
  س4 = س2 + ه * فرق_ع / د
  ع4 = ع2 - ه * فرق_س / د
  ارجع [[س3, ع3], [س4, ع4]]

نقاط = تقاطع(0.0, 0.0, 2.0, 3.0, 0.0, 2.0)
تأكد_يساوي(طول(نقاط), 2, "نقطتا تقاطع")
تأكد_يساوي(مقرب(نقاط[0][0], 3), 1.5, "س المشتركة")
تأكد_يساوي(مقرب(نقاط[0][1], 3), 1.323, "ع الموجبة")
تأكد_يساوي(مقرب(نقاط[1][1], 3), -1.323, "ع السالبة")
تأكد_يساوي(تقاطع(0.0, 0.0, 1.0, 5.0, 0.0, 1.0), [], "منفصلتان")
تأكد_يساوي(طول(تقاطع(0.0, 0.0, 1.0, 2.0, 0.0, 1.0)), 1, "متماسستان نقطة واحدة")
تأكد_يساوي(تقاطع(0.0, 0.0, 5.0, 1.0, 0.0, 1.0), [], "محتواة لا تتقاطع")
اطبع "التقاطع:", نقاط
