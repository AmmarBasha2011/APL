# مثال 3426 — مجموع أول 5 عناصر
# Sum of first 5 items
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3426-list-sum-of-first-5-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع sum(ق[:5])

تأكد_يساوي(ف([3, 1, 2]), 6, "حالة 1")
تأكد_يساوي(ف([5]), 5, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 15, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 16, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 90, "حالة 5")
