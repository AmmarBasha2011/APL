# مثال 491 — نظام رواتب
# Payroll system
# Demonstrates: موظفون وصافي الراتب
#
# Run:  python apl.py examples/491-payroll-system.apl

صنف موظف:
    دالة_إنشاء(ذات, اسم, أساسي, بدلات):
        ذات.اسم = اسم
        ذات.أساسي = أساسي
        ذات.بدلات = بدلات

    دالة صافي(ذات):
        المتغير إجمالي = ذات.أساسي + ذات.بدلات
        المتغير ضريبة = إجمالي * 10 / 100
        ارجع إجمالي - ضريبة

    دالة كشف(ذات):
        اطبع ذات.اسم, "- أساسي:", ذات.أساسي, "- صافي:", ذات.صافي()

المتغير م1 = موظف("عمار", 8000, 1500)
المتغير م2 = موظف("سارة", 9500, 2000)
م1.كشف()
م2.كشف()
