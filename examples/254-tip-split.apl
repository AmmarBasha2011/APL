# مثال 254 — تقسيم الالحساب والإكرامية
# Bill and tip splitter
# Demonstrates: حساب نسبة وتقسيم
#
# Run:  python apl.py examples/254-tip-split.apl

دالة قسم_الالحساب(الحساب, نسبة_إكرامية, أشخاص):
    المتغير إكرامية = الحساب * نسبة_إكرامية / 100
    المتغير إجمالي = الحساب + إكرامية
    ارجع {"إكرامية": مقرب(إكرامية, 2), "إجمالي": مقرب(إجمالي, 2), "للشخص": مقرب(إجمالي / أشخاص, 2)}

المتغير ن = قسم_الالحساب(250, 10, 4)
اطبع "الإكرامية:", ن["إكرامية"]
اطبع "الإجمالي:", ن["إجمالي"]
اطبع "نصيب كل شخص:", ن["للشخص"]
