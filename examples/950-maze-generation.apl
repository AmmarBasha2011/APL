# مثال 950 — توليد المتاهات
# Maze generation
# Demonstrates: تراجع عودي مع خلط
#
# Run:  python apl.py examples/950-maze-generation.apl

# توليد متاهة بالتراجع العودي: نحت الممرات من شبكة جدران
# كل خلية تُزار مرة واحدة: متاهة مثالية بمسار وحيد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شبكة 5x5 خلايا: الجدران قائمة أزواج (خليتان متجاورتان لا ممر بينهما)
# نمثل الممرات بمصفوفة جوار ثنائية
صفوف = 5
أعمدة = 5

دالة فهرس(صف, عمود):
  ارجع صف * 5 + عمود

# مولد عشوائي حتمي (LCG) لاختيار الترتيب
بذرة = [12345]
دالة عشوائي(حد):
  بذرة[0] = (بذرة[0] * 1103515245 + 12345) % 2147483648
  ارجع بذرة[0] % حد

جوار = []
لكل _ في نطاق(25):
  صف = []
  لكل __ في نطاق(25):
    صف.ألحق(0)
  جوار.ألحق(صف)

مزار = []
لكل _ في نطاق(25):
  مزار.ألحق(0)

دالة احفر(خلية):
  مزار[خلية] = 1
  صف = خلية // 5
  عمود = خلية % 5
  # جيران: أعلى، يمين، أسفل، يسار بترتيب عشوائي حتمي
  اتجاهات = [0, 1, 2, 3]
  # خلط فيشر-ييتس بالبذرة الحتمية
  لكل i في نطاق(3, 0, -1):
    ج = عشوائي(i + 1)
    مؤقت = اتجاهات[i]
    اتجاهات[i] = اتجاهات[ج]
    اتجاهات[ج] = مؤقت
  لكل اتجاه في اتجاهات:
    صف2 = صف
    عمود2 = عمود
    لو اتجاه == 0:
      صف2 = صف - 1
    لو اتجاه == 1:
      عمود2 = عمود + 1
    لو اتجاه == 2:
      صف2 = صف + 1
    لو اتجاه == 3:
      عمود2 = عمود - 1
    لو صف2 >= 0 و صف2 < 5 و عمود2 >= 0 و عمود2 < 5:
      جار = صف2 * 5 + عمود2
      لو مزار[جار] == 0:
        جوار[خلية][جار] = 1
        جوار[جار][خلية] = 1
        احفر(جار)

احفر(0)

# كل خلية زُارت
مجموع = 0
لكل x في مزار:
  مجموع = مجموع + x
اطبع "خلايا مزارة:", مجموع
تأكد_يساوي(مجموع, 25, "كل الخلايا مزارة")

# متاهة مثالية على 25 خلية لها 24 ممراً بالضبط
ممرات = 0
لكل i في نطاق(25):
  لكل ج في نطاق(i + 1, 25):
    ممرات = ممرات + جوار[i][ج]
اطبع "الممرات:", ممرات
تأكد_يساوي(ممرات, 24, "شجرة: ن-1 ممر")

# حتمية البذرة: نفس النتيجة عند إعادة التوليد
بذرة[0] = 12345
مزار2 = []
لكل _ في نطاق(25):
  مزار2.ألحق(0)
مزار = مزار2
جوار2 = []
لكل _ في نطاق(25):
  صف2 = []
  لكل __ في نطاق(25):
    صف2.ألحق(0)
  جوار2.ألحق(صف2)
جوار = جوار2
احفر(0)
ممرات2 = 0
لكل i في نطاق(25):
  لكل ج في نطاق(i + 1, 25):
    ممرات2 = ممرات2 + جوار[i][ج]
تأكد_يساوي(ممرات2, 24, "حتمية البذرة")
