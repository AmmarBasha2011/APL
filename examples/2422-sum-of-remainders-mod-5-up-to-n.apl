# مثال 2422 — مجموع البواقي على 5
# Sum of remainders mod 5
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2422-sum-of-remainders-mod-5-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(1, ن + 1):
    م = م + ي % 5
  ارجع م

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(7), 13, "حالة 2")
تأكد_يساوي(ف(12), 23, "حالة 3")
تأكد_يساوي(ف(50), 100, "حالة 4")
تأكد_يساوي(ف(100), 200, "حالة 5")
