# مثال 2955 — إزاحة يمين 4
# Shift right by 4
# Demonstrates: بتات
#
# Run:  python apl.py examples/2955-shift-right-by-4-bits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 4

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(16), 1, "حالة 2")
تأكد_يساوي(ف(255), 15, "حالة 3")
تأكد_يساوي(ف(1000), 62, "حالة 4")
تأكد_يساوي(ف(65535), 4095, "حالة 5")
