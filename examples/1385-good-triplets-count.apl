# مثال 1385 — ثلاثيات جيدة
# Count good triplets
# Demonstrates: بحث شامل
#
# Run:  python apl.py examples/1385-good-triplets-count.apl

# نجرب كل ثلاثة مواضع مرتبة
# ونتحقق من الفروق المطلقة الثلاثة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مطلق(س):
  لو س < 0:
    ارجع -س
  ارجع س

دالة عد_جيدة(أرقام, أ, ب, ج):
  عدد = 0
  ن = طول(أرقام)
  لكل ي في نطاق(ن):
    لكل ك في نطاق(ي + 1, ن):
      لو مطلق(أرقام[ي] - أرقام[ك]) <= أ:
        لكل ل في نطاق(ك + 1, ن):
          لو (مطلق(أرقام[ك] - أرقام[ل]) <= ب) و (مطلق(أرقام[ي] - أرقام[ل]) <= ج):
            عدد = عدد + 1
  ارجع عدد

تأكد_يساوي(عد_جيدة([3,0,1,1,9,7], 7, 2, 3), 4, "أربع")
تأكد_يساوي(عد_جيدة([1,1,2,2,3], 0, 0, 1), 0, "لا شيء")
تأكد_يساوي(عد_جيدة([1,1,1], 0, 0, 0), 1, "ثلاثة متساوية")
