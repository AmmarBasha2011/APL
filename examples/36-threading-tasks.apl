# مثال 36 — تنفيذ مهام متوازية
# Parallel Tasks with Threads
# Demonstrates: threading library, concurrency, join
#
# Run:  python apl.py examples/36-threading-tasks.apl

دالة_مهمة_متوازية(رقم):
    مجموع = 0
    قيمة = 0
    طالما قيمة < 100000:
        مجموع = مجموع + قيمة
        قيمة = قيمة + 1
    print(f"  عامل {رقم} انتهى: المجموع = {مجموع}")

اطبع "=== المهام المتوازية ==="
اطبع ""
اطبع "--- تنفيذ متسلسل ---"
لكل رقم في [1, 2, 3]:
    دالة_مهمة_متوازية(رقم)

اطبع ""
اطبع "--- تنفيذ متوازٍ (threads) ---"
المتغير المهام = []
لكل رقم في [1, 2, 3]:
    المهمة = ثريد(target=دالة_مهمة_متوازية, args=(رقم,))
    المهمة.ابدأ()
    المهام.ألحق(المهمة)
لكل مهمة في المهام:
    مهمة.انتظر()
اطبع ""
اطبع "انتهت كل المهام."
