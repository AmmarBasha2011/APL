# مثال 162 — توليد الرموز الآمنة
# Secure token generation
# Demonstrates: سر_سداسي، سر_آمن_لرابط، سر_في_مجال، مقارنة_آمنة
#
# Run:  python apl.py examples/162-secrets-tokens.apl

اطبع "رمز API:", سر_سداسي(16)
اطبع "رمز رابط:", سر_آمن_لرابط(12)
اطبع "رمز تحقق من 6 أرقام:", سر_في_مجال(100000, 999999)

المتغير رمز = سر_سداسي(8)
اطبع "مقارنة آمنة صحيحة:", مقارنة_آمنة(رمز, رمز)
اطبع "مقارنة آمنة خاطئة:", مقارنة_آمنة(رمز, "wrong")

المتغير فائز = اختر_عشوائي(["أحمد", "سارة", "عمار"])
اطبع "الفائز موجود في القائمة؟", فائز في ["أحمد", "سارة", "عمار"]
