# مثال 3783 — مجموع زوايا مضلع زائد 21
# Polygon angle sum plus 21
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3783-interior-angle-sum-of-polygon-plus-21.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 21

تأكد_يساوي(ف(3), 201, "حالة 1")
تأكد_يساوي(ف(4), 381, "حالة 2")
تأكد_يساوي(ف(5), 561, "حالة 3")
تأكد_يساوي(ف(6), 741, "حالة 4")
تأكد_يساوي(ف(12), 1821, "حالة 5")
