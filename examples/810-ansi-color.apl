# مثال 810 — ألوان ANSI
# ANSI colors
# Demonstrates: محرف هروب، SGR، مؤشر
#
# Run:  python apl.py examples/810-ansi-color.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تسلسلات ANSI للطرفية: ألوان وأنماط وتحريك المؤشر
# Demonstrates: محرف الهروب 27, رموز SGR المركبة, أوامر المؤشر

هروب = فك_ترميز_حرف(27)

دالة نمط(رموز):
  أجزاء = []
  لكل رمز في رموز:
    أجزاء.append(نص(رمز))
  ارجع هروب + "[" + ";".ضم(أجزاء) + "m"

دالة ملون(نص, لون):
  ارجع نمط([لون]) + نص + نمط([0])

دالة مؤشر_أعلى(عدد):
  ارجع هروب + "[" + نص(عدد) + "A"

تأكد_يساوي(نمط([31]), هروب + "[31m", "أحمر")
تأكد_يساوي(نمط([1, 34]), هروب + "[1;34m", "أزرق غامق")
تأكد_يساوي(نمط([0]), هروب + "[0m", "إعادة ضبط")
تأكد_يساوي(ملون("خطر", 31), هروب + "[31mخطر" + هروب + "[0m", "نص ملون")
تأكد_يساوي(مؤشر_أعلى(3), هروب + "[3A", "مؤشر أعلى ثلاثة")
تأكد_يساوي(هروب + "[2J", فك_ترميز_حرف(27) + "[2J", "مسح الشاشة")
تأكد_يساوي(طول(ملون("س", 32)), طول("س") + 9, "طول مع الغلاف")
