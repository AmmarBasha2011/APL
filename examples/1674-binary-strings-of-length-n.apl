# مثال 1674 — كل السلاسل الثنائية بطول ن
# All binary strings of length n
# Demonstrates: توافيق
#
# Run:  python apl.py examples/1674-binary-strings-of-length-n.apl

# العدد 2 أس ن
# نحول كل رقم إلى ثنائي بحشو الأصفار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة سلاسل(ن):
  ناتج = []
  لكل ع في نطاق(2 ** ن):
    س = ""
    ك = ع
    لكل ي في نطاق(ن):
      س = نص(ك % 2) + س
      ك = ك // 2
    ناتج.append(س)
  ارجع ناتج

تأكد_يساوي(سلاسل(2), ["00", "01", "10", "11"], "اثنان")
تأكد_يساوي(طول(سلاسل(4)), 16, "أربعة")
تأكد_يساوي(سلاسل(1), ["0", "1"], "واحد")
