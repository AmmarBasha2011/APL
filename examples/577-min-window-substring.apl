# مثال 577 — أصغر نافذة شاملة
# Minimum window substring
# Demonstrates: نافذة منزلقة، تغطية أحرف
#
# Run:  python apl.py examples/577-min-window-substring.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# أصغر نافذة تحوي كل حروف النمط
دالة أصغر_نافذة(نص, نمط):
    المتغير مطلوب = قاموس()
    لكل حرف في نمط:
        لو حرف في مطلوب:
            مطلوب[حرف] = مطلوب[حرف] + 1
        الا:
            مطلوب[حرف] = 1
    المتغير ناقص = طول(مطلوب)
    المتغير بداية = 0
    المتغير أفضل = ""
    المتغير أقل = طول(نص) + 1
    المتغير عدّاد = قاموس()
    لكل نهاية في نطاق(طول(نص)):
        المتغير حرف = نص[نهاية]
        لو حرف في مطلوب:
            لو حرف في عدّاد:
                عدّاد[حرف] = عدّاد[حرف] + 1
            الا:
                عدّاد[حرف] = 1
            لو عدّاد[حرف] == مطلوب[حرف]:
                ناقص = ناقص - 1
        طالما ناقص == 0:
            لو نهاية - بداية + 1 < أقل:
                أقل = نهاية - بداية + 1
                أفضل = نص[بداية:نهاية + 1]
            المتغير أول = نص[بداية]
            لو أول في مطلوب:
                لو عدّاد[أول] == مطلوب[أول]:
                    ناقص = ناقص + 1
                عدّاد[أول] = عدّاد[أول] - 1
            بداية = بداية + 1
    ارجع أفضل

تأكد_يساوي(أصغر_نافذة("ADOBECODEBANC", "ABC"), "BANC", "الكلاسيكي")
تأكد_يساوي(أصغر_نافذة("aa", "aa"), "aa", "تكرار")
تأكد_يساوي(أصغر_نافذة("abc", "d"), "", "مستحيل")
