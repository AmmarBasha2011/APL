# مثال 3386 — تحويل وحدة بأساس 20
# Split by base 20
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3386-minutes-to-hours-and-minutes-base-20.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 20, ن % 20]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 19], "حالة 2")
تأكد_يساوي(ف(60), [3, 0], "حالة 3")
تأكد_يساوي(ف(125), [6, 5], "حالة 4")
تأكد_يساوي(ف(1000), [50, 0], "حالة 5")
