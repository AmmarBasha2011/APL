# مثال 1261 — محاكاة مصعد
# Elevator simulation
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1261-elevator-sim.apl

# المصعد يتحرك إلى أقرب طلب
# ونحسب مجموع الطوابق المقطوعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تشغيل(بداية, طلبات):
  موقع = بداية
  متبقية = قائمة(طلبات)
  مجموع = 0
  ترتيب = []
  طالما طول(متبقية) > 0:
    اقرب = 0
    لكل ع في نطاق(طول(متبقية)):
      لو (متبقية[ع] - موقع) ** 2 < (متبقية[اقرب] - موقع) ** 2:
        اقرب = ع
    هدف = متبقية.pop(اقرب)
    فرق = هدف - موقع
    لو فرق < 0:
      فرق = -فرق
    مجموع = مجموع + فرق
    موقع = هدف
    ترتيب.ألحق(هدف)
  ارجع [ترتيب, مجموع]

تأكد_يساوي(تشغيل(5, [3, 8, 4]), [[4, 3, 8], 7], "ثلاثة طلبات")
تأكد_يساوي(تشغيل(0, []), [[], 0], "لا طلبات")
تأكد_يساوي(تشغيل(1, [1]), [[1], 0], "نفس الطابق")
