# مثال 3446 — ربط أول 5 أحرف بنقاط
# Join first 5 chars with dots
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3446-join-first-5-chars-with-dots.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ".".join(ن[:5])

تأكد_يساوي(ف("hello"), "h.e.l.l.o", "حالة 1")
تأكد_يساوي(ف("ab"), "a.b", "حالة 2")
تأكد_يساوي(ف("abcdefghijklmn"), "a.b.c.d.e", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
