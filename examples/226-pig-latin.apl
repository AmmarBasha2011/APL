# مثال 226 — لغة الخنزير اللاتينية
# Pig Latin
# Demonstrates: معالجة كلمات، المتحركات
#
# Run:  python apl.py examples/226-pig-latin.apl

دالة خنزيرية(كلمة):
    المتغير متحركات = "aeiou"
    لو كلمة[0] في متحركات:
        ارجع كلمة + "way"
    ارجع كلمة[1:] + كلمة[0] + "ay"

دالة حول_جملة(جملة):
    المتغير كلمات = جملة.تقسيم(" ")
    المتغير محولة = [خنزيرية(ك) لكل ك في كلمات]
    ارجع " ".ضم(محولة)

اطبع حول_جملة("hello world")
اطبع حول_جملة("apple banana cherry")
