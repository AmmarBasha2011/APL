# مثال 2017 — الأوليات التوأم حتى حد
# Twin primes up to limit
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/2017-twin-primes-pairs-up-to-limit.apl

# # نختبر كل عدد p وp+2
# # ونجمع الأزواج التي كلاها أولي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  د = 2
  طالما د * د <= ن:
    لو ن % د == 0:
      ارجع خطأ
    د = د + 1
  ارجع صواب

دالة توائم(حد):
  خرج = []
  لكل ع في نطاق(2, حد - 1):
    لو اولي(ع) و اولي(ع + 2):
      خرج = خرج + [[ع, ع + 2]]
  ارجع خرج

تأكد_يساوي(توائم(30), [[3, 5], [5, 7], [11, 13], [17, 19]], "حتى ٣٠")
تأكد_يساوي(طول(توائم(100)), 8, "حتى ١٠٠")
تأكد_يساوي(توائم(4), [], "لا توجد")
