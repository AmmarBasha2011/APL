# مثال 2091 — الأحاد التي وافقت أول الشهر
# Sundays on first of month
# Demonstrates: تواريخ
#
# Run:  python apl.py examples/2091-first-of-month-sundays-count-century.apl

# # نستخدم طريقة ساكاموتو
# # الناتج المعروف 171

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يوم(س, ش, ي):
  ج = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
  لو ش < 3:
    س = س - 1
  ارجع (س + س // 4 - س // 100 + س // 400 + ج[ش - 1] + ي) % 7

عدد = 0
لكل س في نطاق(1901, 2001):
  لكل ش في نطاق(1, 13):
    لو يوم(س, ش, 1) == 0:
      عدد = عدد + 1
تأكد_يساوي(عدد, 171, "قرن كامل")
