# مثال 2034 — هل تكفي الأحرف لبناء الرسالة
# Ransom note letter budget
# Demonstrates: قواميس
#
# Run:  python apl.py examples/2034-ransom-note-letter-budget.apl

# # نعد حروف المجلة
# # ونخصم لكل حرف في الرسالة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تكفي(رسالة, مجلة):
  رصيد = {}
  لكل ح في مجلة:
    رصيد[ح] = رصيد.get(ح, 0) + 1
  لكل ح في رسالة:
    لو رصيد.get(ح, 0) == 0:
      ارجع خطأ
    رصيد[ح] = رصيد[ح] - 1
  ارجع صواب

تأكد_يساوي(تكفي("a", "b"), خطأ, "ناقص")
تأكد_يساوي(تكفي("aa", "aab"), صواب, "كاف")
تأكد_يساوي(تكفي("aa", "ab"), خطأ, "حرف واحد")
