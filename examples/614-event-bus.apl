# مثال 614 — ناقل أحداث
# Event bus
# Demonstrates: نشر واشتراك، معالجات، أحداث
#
# Run:  python apl.py examples/614-event-bus.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ناقل أحداث: نشر واشتراك بين مكونات منفصلة
# Demonstrates: معالجات لكل حدث, حمولة, فصل المرسل عن المستقبل
# أساس بنية الأنظمة الموجهة بالأحداث

دالة أنشئ_ناقل():
  ارجع {"معالجات": {}, "سجل": []}

دالة اشترك(ناقل, حدث, معالج):
  لو حدث في ناقل["معالجات"]:
    ناقل["معالجات"][حدث].append(معالج)
  والا:
    ناقل["معالجات"][حدث] = [معالج]

دالة انشر(ناقل, حدث, حمولة):
  ناقل["سجل"].append(حدث)
  لو حدث في ناقل["معالجات"]:
    لكل معالج في ناقل["معالجات"][حدث]:
      معالج(حمولة)

وصلت = []
دالة عالج_الطلب(حمولة):
  وصلت.append("طلب:" + حمولة)

دالة عالج_الدفع(حمولة):
  وصلت.append("دفع:" + حمولة)

ناقل = أنشئ_ناقل()
اشترك(ناقل, "طلب_جديد", عالج_الطلب)
اشترك(ناقل, "دفع_تم", عالج_الدفع)
اشترك(ناقل, "طلب_جديد", عالج_الدفع)
انشر(ناقل, "طلب_جديد", "٤٢")
انشر(ناقل, "دفع_تم", "٩٩")
انشر(ناقل, "بدون_مشتركين", "س")
اطبع "الوارد:", وصلت
تأكد_يساوي(طول(وصلت), 3, "ثلاث رسائل وصلت")
تأكد_يساوي(وصلت[0], "طلب:٤٢", "معالج الطلب أولا")
تأكد_يساوي(وصلت[1], "دفع:٤٢", "معالج ثان على نفس الحدث")
تأكد_يساوي(طول(ناقل["سجل"]), 3, "السجل يحفظ حتى بلا مشتركين")
