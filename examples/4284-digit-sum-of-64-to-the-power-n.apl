# مثال 4284 — مجموع أرقام 64 أس ن
# Digit sum of 64 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4284-digit-sum-of-64-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 64 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 10, "حالة 2")
تأكد_يساوي(ف(5), 37, "حالة 3")
تأكد_يساوي(ف(10), 82, "حالة 4")
تأكد_يساوي(ف(20), 172, "حالة 5")
