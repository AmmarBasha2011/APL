# مثال 719 — مجموع أدلر-32
# Adler-32 checksum
# Demonstrates: مجاميع متراكمة، مودولو، دمج
#
# Run:  python apl.py examples/719-adler32.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مجموع أدلر-32 الاختباري (كما في zlib)
# Demonstrates: مجموعان متدحرجان, باقي 65521, دمج 16-بتين
# أسرع من CRC لكنه أضعف ضد التبديلات البعيدة

دالة أدلر(بايتات):
  أ = 1
  ب = 0
  لكل بايت في بايتات:
    أ = (أ + بايت) % 65521
    ب = (ب + أ) % 65521
  ارجع ب * 65536 + أ

دالة بايتات(نص):
  ناتج = []
  لكل ي في نطاق(طول(نص)):
    ناتج.append(ترميز_حرف(نص[ي]) % 256)
  ارجع ناتج

تأكد_يساوي(أدلر(بايتات("Wikipedia")), 300286872, "مثال ويكيبيديا الرسمي")
تأكد_يساوي(أدلر(بايتات("")), 1, "الفارغ واحد")
تأكد_يساوي(أدلر(بايتات("a")), 6422626, "حرف واحد")
تأكد_يساوي(أدلر(بايتات("abc")) != أدلر(بايتات("acb")), صواب, "الترتيب يهم")
تأكد_يساوي(أدلر(بايتات("abc")) != أدلر(بايتات("abd")), صواب, "آخر حرف يهم")
# النسخة المجزأة تطابق الكاملة
كامل = بايتات("hello world")
جزء1 = بايتات("hello ")
جزء2 = بايتات("world")
تأكد_يساوي(أدلر(كامل), أدلر(جزء1 + جزء2), "التقسيم لا يغير")
اطبع "أدلر(Wikipedia):", أدلر(بايتات("Wikipedia"))
