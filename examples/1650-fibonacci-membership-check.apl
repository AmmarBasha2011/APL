# مثال 1650 — هل العدد من فيبوناتشي
# Is a Fibonacci number
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1650-fibonacci-membership-check.apl

# نبدأ بصفر وواحد
# نتوقف عند تجاوز العدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فيبوناتشي_عدد(ن):
  أ = 0
  ب = 1
  طالما أ < ن:
    ت = أ + ب
    أ = ب
    ب = ت
  ارجع أ == ن

تأكد_يساوي(فيبوناتشي_عدد(13), صواب, "ثلاثة عشر")
تأكد_يساوي(فيبوناتشي_عدد(14), خطأ, "أربعة عشر")
تأكد_يساوي(فيبوناتشي_عدد(0), صواب, "صفر")
تأكد_يساوي(فيبوناتشي_عدد(144), صواب, "144")
