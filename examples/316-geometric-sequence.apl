# مثال 316 — المتتالية الهندسية
# Geometric sequence
# Demonstrates: الحد النوني والمجموع الهندسي
#
# Run:  python apl.py examples/316-geometric-sequence.apl

دالة حد_هندسي(أول, نسبة, ن):
    ارجع أول * نسبة ** (ن - 1)

دالة مجموع_هندسية(أول, نسبة, ن):
    لو نسبة == 1:
        ارجع أول * ن
    ارجع أول * (نسبة ** ن - 1) // (نسبة - 1)

اطبع "الحد الخامس (أول=2، نسبة=3):", حد_هندسي(2, 3, 5)
اطبع "مجموع أول 5 حدود:", مجموع_هندسية(2, 3, 5)
اطبع "مجموع قوى 2 العشر الأولى:", مجموع_هندسية(1, 2, 10)
