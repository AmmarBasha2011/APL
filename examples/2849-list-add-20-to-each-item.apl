# مثال 2849 — إضافة 20 لكل عنصر
# Add 20 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2849-list-add-20-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 20]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [23, 21, 22], "حالة 1")
تأكد_يساوي(ف([5]), [25], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [21, 22, 23, 24, 25, 26], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [18, 20, 27, 27, 24], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [30, 40, 30, 50, 40, 30], "حالة 5")
