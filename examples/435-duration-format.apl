# مثال 435 — تنسيق المدد الزمنية
# Duration formatting
# Demonstrates: ثواني إلى نص مقروء
#
# Run:  python apl.py examples/435-duration-format.apl

دالة نص_مدة(ثواني):
    المتغير ساعة_ق = ثواني // 3600
    المتغير دقيقة = (ثواني % 3600) // 60
    المتغير ثانية = ثواني % 60
    المتغير أجزاء = []
    لو ساعة_ق > 0:
        أجزاء.append(نص(ساعة_ق) + " ساعة")
    لو دقيقة > 0:
        أجزاء.append(نص(دقيقة) + " دقيقة")
    لو ثانية > 0:
        أجزاء.append(نص(ثانية) + " ثانية")
    لو طول(أجزاء) == 0:
        ارجع "صفر"
    ارجع " و ".ضم(أجزاء)

اطبع نص_مدة(3661)
اطبع نص_مدة(125)
اطبع نص_مدة(59)
