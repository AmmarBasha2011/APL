# مثال 822 — مولد PCG32
# PCG32
# Demonstrates: LCG 64-بت، تبديل إخراج دوار
#
# Run:  python apl.py examples/822-pcg-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مولد PCG32: مولد خطي 64-بت مع تبديل إخراج دوار
# Demonstrates: LCG عالي الجودة, XSH-RR, تهيئة ببذرة وتسلسل

م64 = 18446744073709551616

دالة بي_سي_جي(بذرة, تسلسل, عدد):
  حالة = 0
  زيادة = تسلسل * 2 + 1
  حالة = (حالة * 6364136223846793005 + زيادة) % م64
  حالة = (حالة + بذرة) % م64
  ناتج = []
  لكل ي في نطاق(عدد + 1):
    قديم = حالة
    حالة = (قديم * 6364136223846793005 + زيادة) % م64
    س = ((قديم >> 18) ^ قديم) >> 27
    دوران = قديم >> 59
    عكس = 32 - دوران
    لو دوران == 0:
      ناتج.append(س)
    والا:
      ناتج.append(((س >> دوران) | (س << عكس)) % 4294967296)
  ارجع ناتج

قيم = بي_سي_جي(42, 54, 3)
تأكد_يساوي(قيم[1], 3780903607, "أول قيمة")
تأكد_يساوي(قيم[2], 2068313097, "ثاني قيمة")
تأكد_يساوي(قيم[3], 3122508592, "ثالث قيمة")
تأكد_يساوي(طول(قيم), 4, "تهيئة زائد ثلاث")
قيم2 = بي_سي_جي(42, 55, 1)
تأكد_يساوي(قيم2[1] != قيم[1] == خطأ, خطأ, "تسلسل مختلف يغير الناتج")
