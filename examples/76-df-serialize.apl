# مثال 76 — تسلسل البيانات (مكتبة datafiles)
# Serialisation (pickle / marshal / plistlib / shelve)
#
# Run:  python apl.py examples/76-df-serialize.apl

اطبع "=== pickle ==="
المتغير بيانات = {"الاسم": "أحمد", "الأعمار": [3, 7, 11]}
المتغير مُحوَّل = أفرغ_بايكن(بيانات)
اطبع "النوع:", نوع(مُحوَّل)
اطبع "مفكوك:", حمّل_بايكن(مُحوَّل)

اطبع ""
اطبع "=== marshal ==="
المتغير م = أفرغ_مارشال([1, "نص", {"م": True}])
اطبع "marshal:", حمّل_مارشال(م)

اطبع ""
اطبع "=== plistlib ==="
المتغير ق = أفرغ_قائمة({"لغة": "عربية", "عدد": 7})
اطبع "plist:", ق[:40]
اطبع "مفكوك:", حمّل_قائمة(ق)

اطبع ""
اطبع "=== رف دائم (shelve) ==="
المتغير ر = رفوف_افتح("/tmp/apl-df-shelf")
ر["مفتاح"] = [1, 2, 3]
اطبع "القيمة:", ر["مفتاح"]
ر.رف_أغلق()
