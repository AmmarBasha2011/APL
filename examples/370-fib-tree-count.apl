# مثال 370 — عد استدعاءات فيبوناتشي
# Count fibonacci calls
# Demonstrates: تكلفة العودية الساذجة
#
# Run:  python apl.py examples/370-fib-tree-count.apl

المتغير عداد = {"عدد": 0}

دالة فيب(ن):
    عداد["عدد"] = عداد["عدد"] + 1
    لو ن < 2:
        ارجع ن
    ارجع فيب(ن - 1) + فيب(ن - 2)

اطبع "فيب(10) =", فيب(10)
اطبع "عدد الاستدعاءات:", عداد["عدد"]
