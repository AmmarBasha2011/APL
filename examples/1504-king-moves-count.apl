# مثال 1504 — حركات الملك المتاحة
# Legal king moves on empty board
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1504-king-moves-count.apl

# كل الجيران الثمانية
# نستبعد من خرج عن الرقعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حركات_الملك(ص, ع):
  عد = 0
  لكل ز_ص في [-1, 0, 1]:
    لكل ز_ع في [-1, 0, 1]:
      لو ز_ص != 0 أو ز_ع != 0:
        ن_ص = ص + ز_ص
        ن_ع = ع + ز_ع
        لو ن_ص >= 0 و ن_ص < 8 و ن_ع >= 0 و ن_ع < 8:
          عد = عد + 1
  ارجع عد

تأكد_يساوي(حركات_الملك(0, 0), 3, "ركن")
تأكد_يساوي(حركات_الملك(0, 4), 5, "حافة")
تأكد_يساوي(حركات_الملك(4, 4), 8, "وسط")
