# مثال 462 — تحويل CSV إلى JSON
# CSV to JSON
# Demonstrates: صفوف إلى قواميس وحفظ
#
# Run:  python apl.py examples/462-csv-to-json.apl

اكتب("/tmp/apl-462.csv", "اسم,عمر\nعمار,26\nسارة,24")

المتغير سطور = اقرأ("/tmp/apl-462.csv").تقليم().تقسيم("\n")
المتغير عناوين = سطور[0].تقسيم(",")
المتغير سجلات = []
لكل ي في نطاق(1, طول(سطور)):
    المتغير قيم = سطور[ي].تقسيم(",")
    المتغير سجل = {}
    لكل ز في نطاق(طول(عناوين)):
        سجل[عناوين[ز]] = قيم[ز]
    سجلات.append(سجل)

اكتب_ملف_جسون(سجلات, "/tmp/apl-462.json")
اطبع "تم التحويل:", طول(سجلات), "سجل"
اطبع اقرأ_ملف_جسون("/tmp/apl-462.json")[0]["اسم"]

احذف_ملف("/tmp/apl-462.csv")
احذف_ملف("/tmp/apl-462.json")
