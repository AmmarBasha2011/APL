# مثال 4181 — مجموع زوايا مضلع زائد 27
# Polygon angle sum plus 27
# Demonstrates: هندسة
#
# Run:  python apl.py examples/4181-interior-angle-sum-of-polygon-plus-27.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 27

تأكد_يساوي(ف(3), 207, "حالة 1")
تأكد_يساوي(ف(4), 387, "حالة 2")
تأكد_يساوي(ف(5), 567, "حالة 3")
تأكد_يساوي(ف(6), 747, "حالة 4")
تأكد_يساوي(ف(12), 1827, "حالة 5")
