# مثال 3132 — ضرب كل عنصر في 30
# Multiply each item by 30
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3132-list-multiply-each-by-30.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 30]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [90, 30, 60], "حالة 1")
تأكد_يساوي(ف([5]), [150], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [30, 60, 90, 120, 150, 180], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-60, 0, 210, 210, 120], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [300, 600, 300, 900, 600, 300], "حالة 5")
