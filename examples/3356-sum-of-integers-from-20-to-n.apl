# مثال 3356 — مجموع الأعداد من 20 إلى ن
# Sum from 20 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3356-sum-of-integers-from-20-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(20, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(20), 20, "حالة 1")
تأكد_يساوي(ف(21), 41, "حالة 2")
تأكد_يساوي(ف(30), 275, "حالة 3")
تأكد_يساوي(ف(100), 4860, "حالة 4")
