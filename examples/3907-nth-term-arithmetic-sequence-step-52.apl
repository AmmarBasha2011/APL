# مثال 3907 — الحد النوني بخطوة 52
# Nth term step 52
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3907-nth-term-arithmetic-sequence-step-52.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 52

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 55, "حالة 2")
تأكد_يساوي(ف(10), 471, "حالة 3")
تأكد_يساوي(ف(100), 5151, "حالة 4")
