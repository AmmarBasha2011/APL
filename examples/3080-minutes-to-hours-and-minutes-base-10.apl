# مثال 3080 — تحويل وحدة بأساس 10
# Split by base 10
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3080-minutes-to-hours-and-minutes-base-10.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 10, ن % 10]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [5, 9], "حالة 2")
تأكد_يساوي(ف(60), [6, 0], "حالة 3")
تأكد_يساوي(ف(125), [12, 5], "حالة 4")
تأكد_يساوي(ف(1000), [100, 0], "حالة 5")
