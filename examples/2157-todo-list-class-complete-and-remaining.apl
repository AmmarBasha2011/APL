# مثال 2157 — صنف قائمة مهام
# Todo list class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2157-todo-list-class-complete-and-remaining.apl

# # كل مهمة لها حالة
# # المتبقي هو غير المنجز

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مهام:
    دالة_إنشاء(ذات):
        ذات.قائمة = []

    دالة اضف(ذات, عنوان):
        ذات.قائمة = ذات.قائمة + [[عنوان, خطأ]]

    دالة انجز(ذات, عنوان):
        لكل م في ذات.قائمة:
            لو م[0] == عنوان:
                م[1] = صواب
                ارجع صواب
        ارجع خطأ

    دالة متبقي(ذات):
        عدد = 0
        لكل م في ذات.قائمة:
            لو م[1] == خطأ:
                عدد = عدد + 1
        ارجع عدد

ت = مهام()
ت.اضف("a")
ت.اضف("b")
ت.اضف("c")
تأكد_يساوي(ت.متبقي(), 3, "ثلاث")
تأكد_يساوي(ت.انجز("b"), صواب, "إنجاز")
تأكد_يساوي(ت.انجز("z"), خطأ, "غير موجودة")
تأكد_يساوي(ت.متبقي(), 2, "اثنتان")
