# مثال 439 — توسيط وتعبئة النصوص
# Pad and center strings
# Demonstrates: توسيط عناوين
#
# Run:  python apl.py examples/439-pad-center.apl

دالة وسطي(نص_الدخل, عرض_مطلوب):
    المتغير نقص = عرض_مطلوب - طول(نص_الدخل)
    لو نقص <= 0:
        ارجع نص_الدخل
    المتغير قبل = ""
    لكل _ في نطاق(نقص // 2):
        قبل = قبل + " "
    المتغير ناتج = قبل + نص_الدخل
    طالما طول(ناتج) < عرض_مطلوب:
        ناتج = ناتج + " "
    ارجع ناتج

اطبع "=" * 40
اطبع وسطي("تقرير المبيعات", 40)
اطبع "=" * 40
