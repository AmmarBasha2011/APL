# مثال 954 — وزن TF-IDF
# TF-IDF weighting
# Demonstrates: تكرار في ندرة
#
# Run:  python apl.py examples/954-tf-idf.apl

# TF-IDF: وزن مصطلح في وثيقة ضمن مجموعة
# يرتفع بالتكرار محلياً وبالندرة عبر المجموعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عدد_ظهور(كلمات, مصطلح):
  عد = 0
  لكل كلمة في كلمات:
    لو كلمة == مصطلح:
      عد = عد + 1
  ارجع عد

دالة tfidf(وثائق, مصطلح, فهرس):
  وثيقة = وثائق[فهرس]
  tf = عدد_ظهور(وثيقة, مصطلح) / طول(وثيقة)
  df = 0
  لكل وث في وثائق:
    لو عدد_ظهور(وث, مصطلح) > 0:
      df = df + 1
  لو df == 0:
    ارجع 0
  ارجع tf * لوغاريتم(طول(وثائق) / df)

وثائق = [["the", "cat", "sat"], ["the", "dog", "ran"], ["a", "cat", "ran"]]

وزن_cat = tfidf(وثائق, "cat", 0)
وزن_sat = tfidf(وثائق, "sat", 0)
اطبع "cat:", وزن_cat
اطبع "sat:", وزن_sat

# cat في وثيقتين: (1/3)*ln(3/2) = 0.135155
تأكد_يساوي(مقرب(وزن_cat, 6), 0.135155, "وزن cat")
# sat في وثيقة واحدة: (1/3)*ln(3) = 0.366204
تأكد_يساوي(مقرب(وزن_sat, 6), 0.366204, "وزن sat")

# النادر أثقل من الشائع
لو وزن_sat <= وزن_cat:
  اطبع "فشل: النادر يجب أن يثقل"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: الندرة تثقل"

# مصطلح غائب عن الوثيقة: صفر
تأكد_يساوي(tfidf(وثائق, "dog", 0), 0, "غائب")
