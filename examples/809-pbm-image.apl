# مثال 809 — صورة PBM
# PBM image
# Demonstrates: نسق P1 نصي، إطار، تحليل
#
# Run:  python apl.py examples/809-pbm-image.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# صورة نقطية PBM بنسق P1 النصي: كتابة الرأس والبتات وقراءتها
# Demonstrates: تنسيق netpbm النصي, إطار حدود, تحليل عكسي

دالة إطار(عرض, ارتفاع):
  شبكة = []
  لكل ص في نطاق(ارتفاع):
    سطر = []
    لكل ع في نطاق(عرض):
      لو ص == 0 أو ص == ارتفاع - 1 أو ع == 0 أو ع == عرض - 1:
        سطر.append(1)
      والا:
        سطر.append(0)
    شبكة.append(سطر)
  ارجع شبكة

دالة إلى_pbm(شبكة):
  مخرج = "P1\n" + نص(طول(شبكة[0])) + " " + نص(طول(شبكة)) + "\n"
  لكل سطر في شبكة:
    خلايا = []
    لكل خلية في سطر:
      خلايا.append(نص(خلية))
    مخرج = مخرج + " ".ضم(خلايا) + "\n"
  ارجع مخرج

دالة من_pbm(مدخل):
  أسطر = مدخل.split("\n")
  أبعاد = أسطر[1].split(" ")
  شبكة = []
  لكل ي في نطاق(2, 2 + صحيح(أبعاد[1])):
    سطر = []
    لكل خلية في أسطر[ي].split(" "):
      سطر.append(صحيح(خلية))
    شبكة.append(سطر)
  ارجع شبكة

شبكة = إطار(8, 6)
تأكد_يساوي(شبكة[0], [1, 1, 1, 1, 1, 1, 1, 1], "الحد العلوي")
تأكد_يساوي(شبكة[2], [1, 0, 0, 0, 0, 0, 0, 1], "سطر وسطي")
مشفر = إلى_pbm(شبكة)
تأكد_يساوي(مشفر.split("\n")[0], "P1", "رقم سحري")
تأكد_يساوي(مشفر.split("\n")[1], "8 6", "الأبعاد")
مفكوك = من_pbm(مشفر)
تأكد_يساوي(مفكوك, شبكة, "دورة كاملة")
مجموع = 0
لكل سطر في شبكة:
  لكل خلية في سطر:
    مجموع = مجموع + خلية
تأكد_يساوي(مجموع, 24, "عدد بتات الإطار")
