# مثال 32 — خط أنابيب بالمولدات
# Generator Pipeline
# Demonstrates: yield, yield from, generators, lazy evaluation
#
# Run:  python apl.py examples/32-generator-pipeline.apl

دالة_أعداد(الحد):
    رقم = 0
    طالما رقم < الحد:
        ولد رقم
        رقم = رقم + 1

دالة_مربعات(المصدر):
    لكل رقم في المصدر:
        ولد رقم * رقم

دالة_الأعداد_الزوجية(المصدر):
    لكل رقم في المصدر:
        لو رقم % 2 == 0:
            ولد رقم

دالة_مجموع(المصدر):
    المجموع = 0
    لكل رقم في المصدر:
        المجموع = المجموع + رقم
    ارجع المجموع

اطبع "=== خط أنابيب بالمولدات ==="
اطبع ""
اطبع "1) مربعات أول 6 أعداد: " + نص(قائمة(دالة_مربعات(دالة_أعداد(6))))
اطبع "2) زوجية من أول 10: " + نص(قائمة(دالة_الأعداد_الزوجية(دالة_أعداد(10))))
اطبع "3) مجموع مربعات أول 5: " + نص(دالة_مجموع(دالة_مربعات(دالة_أعداد(5))))
اطبع ""
اطبع "4) خط أنابيب كامل (زوجية من مربعات):"
لكل قيمة في دالة_الأعداد_الزوجية(دالة_مربعات(دالة_أعداد(8))):
    اطبع "   " + نص(قيمة)
