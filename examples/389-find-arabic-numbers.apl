# مثال 389 — الأرقام العربية المشرقية في نص
# Eastern Arabic digits
# Demonstrates: تحويل ٠١٢٣ إلى 0123
#
# Run:  python apl.py examples/389-find-arabic-numbers.apl

المتغير شرقية = "٠١٢٣٤٥٦٧٨٩"

دالة إلى_غربية(نص_الدخل):
    المتغير نتيجة = ""
    لكل حرف in نص_الدخل:
        المتغير موضع = شرقية.find(حرف)
        لو موضع >= 0:
            نتيجة = نتيجة + نص(موضع)
        الا:
            نتيجة = نتيجة + حرف
    ارجع نتيجة

اطبع إلى_غربية("الرقم ٤٢ والعام ٢٠٢٦")
اطبع إلى_غربية("٣٦٥")
