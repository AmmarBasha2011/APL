# مثال 4307 — الحد النوني بخطوة 62
# Nth term step 62
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4307-nth-term-arithmetic-sequence-step-62.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 62

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 65, "حالة 2")
تأكد_يساوي(ف(10), 561, "حالة 3")
تأكد_يساوي(ف(100), 6141, "حالة 4")
