# مثال 1294 — تقويم بلا تداخل
# My calendar no double booking
# Demonstrates: مجالات
#
# Run:  python apl.py examples/1294-my-calendar.apl

# لا نقبل مجالاً يتقاطع مع مجال محجوز
# والتقاطع لو بدأ الجديد قبل نهاية القديم وانتهى بعد بدايته

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف تقويم:
  دالة_إنشاء(ذات):
    ذات.حجوزات = []

  دالة احجز(ذات, بداية, نهاية):
    لكل ح في ذات.حجوزات:
      لو (بداية < ح[1]) و (نهاية > ح[0]):
        ارجع خطأ
    ذات.حجوزات.ألحق([بداية, نهاية])
    ارجع صواب

ت = تقويم()
تأكد_يساوي(ت.احجز(10, 20), صواب, "أول")
تأكد_يساوي(ت.احجز(15, 25), خطأ, "تداخل")
تأكد_يساوي(ت.احجز(20, 30), صواب, "متلاصق")
تأكد_يساوي(ت.احجز(5, 10), صواب, "قبله مباشرة")
تأكد_يساوي(ت.احجز(0, 40), خطأ, "يحوي الكل")
