# مثال 572 — وسيط التدفق
# Running median
# Demonstrates: وسيط تدفق، كوميتان، موازنة
#
# Run:  python apl.py examples/572-median-stream.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# وسيط تدفق بكوميتين (أدنى وأقصى)
المتغير أدنى_كومة = قائمة()
المتغير أقصى_كومة = قائمة()

دالة ادفع(كومة, قيمة, أدنى):
    كومة.أضف(قيمة)
    المتغير i = طول(كومة) - 1
    طالما i > 0:
        المتغير أب = (i - 1) // 2
        لو أدنى و كومة[i] < كومة[أب]:
            المتغير م = كومة[i]
            كومة[i] = كومة[أب]
            كومة[أب] = م
            i = أب
        الا لو ليس أدنى و كومة[i] > كومة[أب]:
            المتغير م = كومة[i]
            كومة[i] = كومة[أب]
            كومة[أب] = م
            i = أب
        الا:
            توقف

دالة اسحب(كومة, أدنى):
    المتغير قمة = كومة[0]
    كومة[0] = كومة[طول(كومة) - 1]
    كومة.pop()
    المتغير i = 0
    طالما صواب:
        المتغير أفضل = i
        لكل ابن في [2 * i + 1, 2 * i + 2]:
            لو ابن < طول(كومة):
                لو أدنى و كومة[ابن] < كومة[أفضل]:
                    أفضل = ابن
                لو ليس أدنى و كومة[ابن] > كومة[أفضل]:
                    أفضل = ابن
        لو أفضل == i:
            توقف
        المتغير م = كومة[i]
        كومة[i] = كومة[أفضل]
        كومة[أفضل] = م
        i = أفضل
    ارجع قمة

دالة أضف_رقم(ن):
    لو طول(أقصى_كومة) == 0 أو ن <= 0 - أقصى_كومة[0]:
        ادفع(أقصى_كومة, 0 - ن, صواب)
    الا:
        ادفع(أدنى_كومة, ن, صواب)
    لو طول(أقصى_كومة) > طول(أدنى_كومة) + 1:
        ادفع(أدنى_كومة, 0 - اسحب(أقصى_كومة, صواب), صواب)
    لو طول(أدنى_كومة) > طول(أقصى_كومة):
        ادفع(أقصى_كومة, 0 - اسحب(أدنى_كومة, صواب), صواب)

دالة الوسيط():
    لو طول(أقصى_كومة) > طول(أدنى_كومة):
        ارجع 0 - أقصى_كومة[0]
    ارجع ((0 - أقصى_كومة[0]) + أدنى_كومة[0]) / 2

لكل ن في [5, 15, 1, 3]:
    أضف_رقم(ن)
    اطبع "بعد", ن, ":", الوسيط()
تأكد_يساوي(الوسيط(), 4, "وسيط [5,15,1,3]")
أضف_رقم(8)
تأكد_يساوي(الوسيط(), 5, "وسيط [5,15,1,3,8]")
