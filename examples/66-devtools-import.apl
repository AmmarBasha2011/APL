# مثال 66 — الاستيراد الديناميكي والتحذيرات (مكتبة devtools)
# importlib, codeop, warnings and linecache in Arabic
#
# Run:  python apl.py examples/66-devtools-import.apl

اطبع "=== الاستيراد الديناميكي (importlib) ==="
المتغير رياضيات = استيراد_وحدة("math")
اطبع "هو_وحدة(رياضيات):", هو_وحدة(رياضيات)
اطبع "اسم_الوحدة_من_مسار:", اسم_الوحدة_من_مسار("math.py")
اطبع "جذر(16):", جذر(16)
اطبع "أعد_التحميل:", هو_دالة(أعد_التحميل)
اطبع "أبطِل_الذاكرة_المؤقتة:", هو_دالة(أبطِل_الذاكرة_المؤقتة)

اطبع ""
اطبع "=== ترجمة الأوامر (codeop) ==="
المتغير شيفرة = ترجم_أمراً("1 + 2")
اطبع "ترجم_أمراً('1 + 2'):", نص(نوع(شيفرة))
المتغير ناقص = ترجم_أمراً("def س(")
اطبع "ترجم_أمراً ناقص:", ناقص

اطبع ""
اطبع "=== التحذيرات (warnings) ==="
أعد_ضبط_التحذيرات()
نبّه("تنبيه تجريبي من APL")
اطبع "عدد_المرشّحات:", طول(المرشّحات)

اطبع ""
اطبع "=== ذاكرة الأسطر (linecache) ==="
المتغير س = سطر_من_الذاكرة("examples/66-devtools-import.apl", 1)
اطبع "السطر الأول:", س
اطبع "حدّث_الذاكرة:", هو_دالة(حدّث_الذاكرة)
