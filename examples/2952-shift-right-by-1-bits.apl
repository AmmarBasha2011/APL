# مثال 2952 — إزاحة يمين 1
# Shift right by 1
# Demonstrates: بتات
#
# Run:  python apl.py examples/2952-shift-right-by-1-bits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 1

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(16), 8, "حالة 2")
تأكد_يساوي(ف(255), 127, "حالة 3")
تأكد_يساوي(ف(1000), 500, "حالة 4")
تأكد_يساوي(ف(65535), 32767, "حالة 5")
