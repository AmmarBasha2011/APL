# مثال 2721 — مجموع أرقام 15 أس ن
# Digit sum of 15 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2721-digit-sum-of-15-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 15 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 6, "حالة 2")
تأكد_يساوي(ف(5), 36, "حالة 3")
تأكد_يساوي(ف(10), 54, "حالة 4")
تأكد_يساوي(ف(20), 108, "حالة 5")
