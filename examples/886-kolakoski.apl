# مثال 886 — متتابعة كولاكوسكي
# Kolakoski sequence
# Demonstrates: وصف ذاتي بأطوال الركضات
#
# Run:  python apl.py examples/886-kolakoski.apl

# متتابعة كولاكوسكي: متتابعة ذاتية الوصف من الواحدات والثنائيات
# أطوال ركضاتها هي المتتابعة نفسها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كولاكوسكي(عدد):
  ت = [1, 2, 2]
  موضع = 2
  طالما طول(ت) < عدد:
    تالية = 3 - ت[طول(ت) - 1]
    تكرار = ت[موضع]
    لكل _ في نطاق(تكرار):
      لو طول(ت) < عدد:
        ت.ألحق(تالية)
    موضع = موضع + 1
  ارجع ت

ت = كولاكوسكي(15)
اطبع "أول 15 حداً:", ت

تأكد_يساوي(طول(ت), 15, "الطول")
تأكد_يساوي(ت[0], 1, "تبدأ 1")
تأكد_يساوي(ت[2], 2, "ت[2] = 2")
تأكد_يساوي(ت[4], 1, "ت[4] = 1")
تأكد_يساوي(ت[8], 2, "ت[8] = 2")
تأكد_يساوي(ت[14], 2, "ت[14] = 2")

# الوصف الذاتي: أطوال الركضات تعيد المتتابعة
ركضات = []
جارية = ت[0]
عد = 1
لكل i في نطاق(1, طول(ت)):
  لو ت[i] == جارية:
    عد = عد + 1
  والا:
    ركضات.ألحق(عد)
    جارية = ت[i]
    عد = 1
ركضات.ألحق(عد)
اطبع "أطوال الركضات:", ركضات

# كل ركضة مكتملة (ما عدا ربما الأخيرة) يطابق طولها الحد الموافق
لكل i في نطاق(طول(ركضات) - 1):
  تأكد_يساوي(ركضات[i], ت[i], "الوصف الذاتي عند " + نص(i))
