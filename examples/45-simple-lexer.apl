# مثال 45 — محلّل نصوص بسيط
# Simple Tokenizer
# Demonstrates: string scanning, state machines, accumulation
#
# Run:  python apl.py examples/45-simple-lexer.apl

دالة_تقطيع(نص):
    الرموز = []
    الحالي = ""
    رقم = 0
    طالما رقم < طول(نص):
        حرف = نص[رقم]
        إذا حرف == " " أو حرف == "," أو حرف == ".":
            إذا طول(الحالي) > 0:
                الرموز.ألحق(الحالي)
                الحالي = ""
        والا:
            الحالي = الحالي + حرف
        رقم = رقم + 1
    إذا طول(الحالي) > 0:
        الرموز.ألحق(الحالي)
    ارجع الرموز

دالة_نوع(رمز):
    إذا طول(رمز) > 0:
        أول = رمز[0]
        لو أول >= "0" و أول <= "9":
            ارجع "رقم"
        لو أول >= "a" و أول <= "z":
            ارجع "كلمة"
    ارجع "أخرى"

اطبع "=== محلّل الرموز ==="
اطبع ""
المتغير نص = "مرحبا, بالعالم. هذا 2026 اختبار"
الرموز = تقطيع(نص)
اطبع "النص: " + نص
اطبع ""
اطبع "عدد الرموز: " + نص(طول(الرموز))
اطبع ""
اطبع "--- الرموز وأنواعها ---"
لكل رمز في الرموز:
    اطبع "  " + رمز + "  ->  " + نوع(رمز)
