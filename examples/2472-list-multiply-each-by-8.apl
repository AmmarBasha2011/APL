# مثال 2472 — ضرب كل عنصر في 8
# Multiply each item by 8
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2472-list-multiply-each-by-8.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 8]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [24, 8, 16], "حالة 1")
تأكد_يساوي(ف([5]), [40], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [8, 16, 24, 32, 40, 48], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-16, 0, 56, 56, 32], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [80, 160, 80, 240, 160, 80], "حالة 5")
