# مثال 4157 — السعر مع ضريبة 42 بالمئة
# Price with 42 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4157-price-with-42-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 42 // 100

تأكد_يساوي(ف(100), 142, "حالة 1")
تأكد_يساوي(ف(250), 355, "حالة 2")
تأكد_يساوي(ف(999), 1418, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
