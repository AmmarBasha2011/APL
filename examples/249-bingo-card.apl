# مثال 249 — بطاقة بنغو
# Bingo card
# Demonstrates: عشوائي_عينة لكل عمود، شبكة 5x5
#
# Run:  python apl.py examples/249-bingo-card.apl

بذرة(17)
المتغير بطاقة = []
لكل عمود في نطاق(5):
    المتغير أرقام = عشوائي_عينة(نطاق(عمود * 15 + 1, عمود * 15 + 16), 5)
    بطاقة.أضف(مفرز(أرقام))

اطبع " B   I   N   G   O"
لكل صف في نطاق(5):
    المتغير سطر = ""
    لكل عمود في نطاق(5):
        لو صف == 2 و عمود == 2:
            سطر = سطر + "  * "
        الا:
            سطر = سطر + " " + نص(بطاقة[عمود][صف]) + " "
    اطبع سطر
