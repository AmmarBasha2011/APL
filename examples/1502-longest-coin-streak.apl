# مثال 1502 — أطول سلسلة متتالية في رمي العملة
# Longest coin flip streak
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1502-longest-coin-streak.apl

# نعد التكرار المتصل
# نحتفظ بأكبر عدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أطول_سلسلة(رميات):
  لو رميات == "":
    ارجع 0
  أقصى = 1
  حالي = 1
  لكل ع في نطاق(1, طول(رميات)):
    لو رميات[ع] == رميات[ع - 1]:
      حالي = حالي + 1
    والا:
      حالي = 1
    لو حالي > أقصى:
      أقصى = حالي
  ارجع أقصى

تأكد_يساوي(أطول_سلسلة("HHTTTH"), 3, "ثلاثة")
تأكد_يساوي(أطول_سلسلة("HTHT"), 1, "متناوبة")
تأكد_يساوي(أطول_سلسلة(""), 0, "فارغة")
