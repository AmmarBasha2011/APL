# مثال 935 — مطابق تعابير مبسط
# Simple regex matcher
# Demonstrates: نقطة ونجمة بديناميكية
#
# Run:  python apl.py examples/935-regex-matcher.apl

# مطابق تعابير نمطية مبسط: نقطة (أي حرف) ونجمة (صفر أو أكثر)
# برمجة ديناميكية على النص والنمط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة يطابق(نص, نمط):
  ن = طول(نص)
  م = طول(نمط)
  ع = []
  لكل _ في نطاق(ن + 1):
    صف = []
    لكل __ في نطاق(م + 1):
      صف.ألحق(خطأ)
    ع.ألحق(صف)
  ع[0][0] = 1 == 1
  لكل ج في نطاق(1, م + 1):
    لو نمط[ج - 1] == "*":
      ع[0][ج] = ع[0][ج - 2]
  لكل i في نطاق(1, ن + 1):
    لكل ج في نطاق(1, م + 1):
      لو نمط[ج - 1] == "*":
        ع[i][ج] = ع[i][ج - 2]
        لو نمط[ج - 2] == "." أو نمط[ج - 2] == نص[i - 1]:
          لو ع[i - 1][ج]:
            ع[i][ج] = 1 == 1
      والا:
        لو نمط[ج - 1] == "." أو نمط[ج - 1] == نص[i - 1]:
          ع[i][ج] = ع[i - 1][ج - 1]
  ارجع ع[ن][م]

اطبع "aab ~ c*a*b:", يطابق("aab", "c*a*b")
اطبع "ab ~ .*:", يطابق("ab", ".*")

تأكد_يساوي(يطابق("aab", "c*a*b"), 1 == 1, "نجمة صفر c")
تأكد_يساوي(يطابق("ab", ".*"), 1 == 1, "نقطة نجمة تطابق الكل")
تأكد_يساوي(يطابق("mississippi", "mis*is*p*."), خطأ, "مثال سالب")
تأكد_يساوي(يطابق("aa", "a"), خطأ, "أطول من النمط")
تأكد_يساوي(يطابق("aa", "a*"), 1 == 1, "نجمة تكرار")
تأكد_يساوي(يطابق("", "a*b*"), 1 == 1, "فارغ مع نجوم")
