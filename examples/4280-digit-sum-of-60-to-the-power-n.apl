# مثال 4280 — مجموع أرقام 60 أس ن
# Digit sum of 60 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4280-digit-sum-of-60-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 60 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 6, "حالة 2")
تأكد_يساوي(ف(5), 27, "حالة 3")
تأكد_يساوي(ف(10), 36, "حالة 4")
تأكد_يساوي(ف(20), 72, "حالة 5")
