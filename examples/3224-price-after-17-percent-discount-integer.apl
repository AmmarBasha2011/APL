# مثال 3224 — السعر بعد خصم 17 بالمئة
# Price after 17 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3224-price-after-17-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 17 // 100

تأكد_يساوي(ف(100), 83, "حالة 1")
تأكد_يساوي(ف(250), 208, "حالة 2")
تأكد_يساوي(ف(999), 830, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
