# مثال 1782 — أطول متتالية عددية
# Longest consecutive sequence
# Demonstrates: مجموعات
#
# Run:  python apl.py examples/1782-longest-consecutive-run-set.apl

# قاموس كمجموعة
# نعد من العنصر الذي لا سابق له

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أطول_متتالية(ق):
  مجموعة = {}
  لكل ع في ق:
    مجموعة[نص(ع)] = 1
  أفضل = 0
  لكل ع في ق:
    لو (نص(ع - 1) في مجموعة) == خطأ:
      طول_حالي = 1
      طالما نص(ع + طول_حالي) في مجموعة:
        طول_حالي = طول_حالي + 1
      أفضل = أكبر(أفضل, طول_حالي)
  ارجع أفضل

تأكد_يساوي(أطول_متتالية([100, 4, 200, 1, 3, 2]), 4, "أربعة")
تأكد_يساوي(أطول_متتالية([]), 0, "فارغة")
تأكد_يساوي(أطول_متتالية([5, 5, 5]), 1, "مكررة")
