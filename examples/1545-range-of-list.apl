# مثال 1545 — مدى القائمة
# Range of a list
# Demonstrates: إحصاء
#
# Run:  python apl.py examples/1545-range-of-list.apl

# نبحث عن الأكبر والأصغر معاً
# المدى الفارق بينهما

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة المدى(أ):
  صغرى = أ[0]
  كبرى = أ[0]
  لكل ع في أ:
    لو ع < صغرى:
      صغرى = ع
    لو ع > كبرى:
      كبرى = ع
  ارجع كبرى - صغرى

تأكد_يساوي(المدى([3, 9, 1, 7]), 8, "أربعة")
تأكد_يساوي(المدى([5]), 0, "وحيد")
تأكد_يساوي(المدى([-4, 4]), 8, "سالب")
