# مثال 2317 — أقواس متوازنة
# Balanced round brackets
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2317-balanced-brackets-round-only.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح == "(":
      ع = ع + 1
    والا_لو ح == ")":
      ع = ع - 1
      لو ع < 0:
        ارجع خطأ
  ارجع ع == 0

تأكد_يساوي(ف("(())"), صواب, "حالة 1")
تأكد_يساوي(ف("(()"), خطأ, "حالة 2")
تأكد_يساوي(ف("())("), خطأ, "حالة 3")
تأكد_يساوي(ف(""), صواب, "حالة 4")
تأكد_يساوي(ف("()()"), صواب, "حالة 5")
