# مثال 2209 — هل الجملة تحوي كل الحروف
# Is pangram
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2209-is-pangram-all-letters-present.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لكل ك في نطاق(26):
    لو ن.lower().find(chr(97 + ك)) == -1:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف("The quick brown fox jumps over the lazy dog"), صواب, "حالة 1")
تأكد_يساوي(ف("hello"), خطأ, "حالة 2")
تأكد_يساوي(ف("abcdefghijklmnopqrstuvwxyz"), صواب, "حالة 3")
تأكد_يساوي(ف("abc"), خطأ, "حالة 4")
