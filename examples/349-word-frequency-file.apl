# مثال 349 — تكرار كلمات ملف
# File word frequency
# Demonstrates: عد وتوب 3
#
# Run:  python apl.py examples/349-word-frequency-file.apl

المتغير مسار = "/tmp/apl_words_349.txt"
اكتب(مسار, "البرمجة بالعربية جميلة والبرمجة متعة والعربية لغة البرمجة\n")

المتغير كلمات_النص = اقرأ(مسار).تقليم().تقسيم(" ")
المتغير عدد = {}
لكل كلمة في كلمات_النص:
    لو كلمة in عدد:
        عدد[كلمة] = عدد[كلمة] + 1
    الا:
        عدد[كلمة] = 1

المتغير أزواج = []
لكل كلمة في عدد:
    أزواج.أضف({"كلمة": كلمة, "عدد": عدد[كلمة]})

المتغير مرتبة = مفرز(أزواج, key=(ز) => ز["عدد"], reverse=True)
اطبع "الأكثر تكرارا:"
لكل ي في نطاق(3):
    اطبع " ", مرتبة[ي]["كلمة"], ":", مرتبة[ي]["عدد"]

احذف_ملف(مسار)
