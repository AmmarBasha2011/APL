# مثال 3351 — اقتطاع أول 35 أحرف
# First 35 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/3351-truncate-text-to-first-35-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:35]

تأكد_يساوي(ف("hello world"), "hello world", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abcdefghijkl", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
