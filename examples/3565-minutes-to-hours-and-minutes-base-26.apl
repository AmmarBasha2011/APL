# مثال 3565 — تحويل وحدة بأساس 26
# Split by base 26
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3565-minutes-to-hours-and-minutes-base-26.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 26, ن % 26]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 7], "حالة 2")
تأكد_يساوي(ف(60), [2, 8], "حالة 3")
تأكد_يساوي(ف(125), [4, 21], "حالة 4")
تأكد_يساوي(ف(1000), [38, 12], "حالة 5")
