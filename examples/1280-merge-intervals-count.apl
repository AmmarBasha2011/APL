# مثال 1280 — عدد المجالات بعد الدمج
# Merged intervals count
# Demonstrates: ترتيب
#
# Run:  python apl.py examples/1280-merge-intervals-count.apl

# نرتب بالبداية
# وندمج كل مجال يبدأ قبل نهاية السابق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادمج_مجالات(م):
  لو طول(م) == 0:
    ارجع []
  ق = مفرز(م)
  ناتج = [ق[0]]
  لكل ع في نطاق(1, طول(ق)):
    اخر = ناتج[-1]
    لو ق[ع][0] <= اخر[1]:
      لو ق[ع][1] > اخر[1]:
        اخر[1] = ق[ع][1]
    والا:
      ناتج.ألحق(ق[ع])
  ارجع ناتج

تأكد_يساوي(ادمج_مجالات([[1,3],[2,6],[8,10],[15,18]]), [[1,6],[8,10],[15,18]], "مثال أول")
تأكد_يساوي(ادمج_مجالات([[1,4],[4,5]]), [[1,5]], "متلاصقة")
تأكد_يساوي(طول(ادمج_مجالات([[1,10],[2,3],[4,5]])), 1, "مجال يحوي الباقي")
تأكد_يساوي(ادمج_مجالات([]), [], "فارغة")
