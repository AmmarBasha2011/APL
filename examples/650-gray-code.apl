# مثال 650 — شفرة جراي
# Gray code
# Demonstrates: شفرة جراي، بت واحد، دورة
#
# Run:  python apl.py examples/650-gray-code.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شفرة جراي: تتابع يختلف في بت واحد
# Demonstrates: صيغة ي ^ (ي >> 1), خاصية الجوار, دورة مغلقة
# ترتيب يقلل الأخطاء في المشفرات الدوارة

دالة عد_البتات(س):
  عدد = 0
  طالما س > 0:
    عدد = عدد + س % 2
    س = س // 2
  ارجع عدد

ن = 3
رمز = []
لكل ي في نطاق(2 ** ن):
  رمز.append(ي ^ (ي // 2))
تأكد_يساوي(رمز, [0, 1, 3, 2, 6, 7, 5, 4], "شفرة جراي لثلاثة بتات")
لكل ي في نطاق(طول(رمز) - 1):
  تأكد_يساوي(عد_البتات(رمز[ي] ^ رمز[ي + 1]), 1, "بت واحد بين متتاليتين")
تأكد_يساوي(عد_البتات(رمز[0] ^ رمز[طول(رمز) - 1]), 1, "الدورة مغلقة")
اطبع "الشفرة:", رمز
