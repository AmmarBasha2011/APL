# مثال 3822 — قوة 13 بالحلقة
# Power of 13 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3822-nth-power-of-13-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 13
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 13, "حالة 2")
تأكد_يساوي(ف(3), 2197, "حالة 3")
تأكد_يساوي(ف(6), 4826809, "حالة 4")
تأكد_يساوي(ف(10), 137858491849, "حالة 5")
