# مثال 734 — كتلة ببتيد
# Peptide mass
# Demonstrates: جدول كتل، جزيء ماء، جمع تراكمي
#
# Run:  python apl.py examples/734-protein-mass.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# حساب كتلة ببتيد من حروف الأحماض الأمينية
# Demonstrates: جدول كتل ثابت, قاموس.get بقيمة افتراضية, جمع تراكمي
# الكتلة الكلية = مجموع كتل البقايا + كتلة جزيء ماء (طرفا الببتيد)

كتلة_ماء = 18.0153

كتل = {
  "A": 71.0788, "R": 156.1875, "N": 114.1038, "D": 115.0886,
  "C": 103.1388, "E": 129.1155, "Q": 128.1307, "G": 57.0519,
  "H": 137.1411, "I": 113.1594, "L": 113.1594, "K": 128.1741,
  "M": 131.1926, "F": 147.1766, "P": 97.1167, "S": 87.0782,
  "T": 101.1051, "W": 186.2132, "Y": 163.1760, "V": 99.1326
}

دالة كتلة_ببتيد(ببتيد):
  مجموع = 0.0
  لكل ي في نطاق(طول(ببتيد)):
    مجموع = مجموع + كتل.get(ببتيد[ي], 0.0)
  ارجع مجموع + كتلة_ماء

دالة متوسط_كتلة_بقية(ببتيد):
  لو طول(ببتيد) == 0:
    ارجع 0.0
  ارجع (كتلة_ببتيد(ببتيد) - كتلة_ماء) / طول(ببتيد)

دالة عدد_حرف(ببتيد, حرف):
  عدد = 0
  لكل ي في نطاق(طول(ببتيد)):
    لو ببتيد[ي] == حرف:
      عدد = عدد + 1
  ارجع عدد

تأكد_يساوي(مقرب(كتلة_ببتيد("G"), 4), 75.0672, "غلايسين وحيد")
تأكد_يساوي(مقرب(كتلة_ببتيد("AC"), 4), 192.2329, "ثنائي")
تأكد_يساوي(مقرب(كتلة_ببتيد("GLY"), 4), 351.4026, "ثلاثي")
تأكد_يساوي(مقرب(كتلة_ببتيد("PEPTIDE"), 4), 799.8328, "سباعي")
تأكد_يساوي(مقرب(كتلة_ببتيد("MKWVTFISLL"), 4), 1237.5659, "عشاري")

تأكد_يساوي(مقرب(متوسط_كتلة_بقية("GLY"), 4), 111.1291, "متوسط البقايا")
تأكد_يساوي(عدد_حرف("PEPTIDE", "E"), 2, "تكرار E")
تأكد_يساوي(عدد_حرف("PEPTIDE", "W"), 0, "بلا W")

# حروف غير معروفة تُهمل عبر .get
تأكد_يساوي(مقرب(كتلة_ببتيد("GXG"), 4), مقرب(2 * 57.0519 + 18.0153, 4), "حرف مجهول مهمل")

اطبع "كتلة PEPTIDE:", مقرب(كتلة_ببتيد("PEPTIDE"), 2)
