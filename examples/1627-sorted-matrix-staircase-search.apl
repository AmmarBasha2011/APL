# مثال 1627 — بحث الدرج في مصفوفة مرتبة
# Staircase search in sorted matrix
# Demonstrates: بحث ثنائي
#
# Run:  python apl.py examples/1627-sorted-matrix-staircase-search.apl

# إن زاد العنصر عن الهدف نتحرك يساراً
# وإن نقص ننزل صفاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ابحث_في_المصفوفة(م, هدف):
  ص = 0
  ع = طول(م[0]) - 1
  طالما ص < طول(م) و ع >= 0:
    لو م[ص][ع] == هدف:
      ارجع صواب
    والا_لو م[ص][ع] > هدف:
      ع = ع - 1
    والا:
      ص = ص + 1
  ارجع خطأ

مصفوفة = [[1, 4, 7], [2, 5, 8], [3, 6, 9]]
تأكد_يساوي(ابحث_في_المصفوفة(مصفوفة, 5), صواب, "موجود")
تأكد_يساوي(ابحث_في_المصفوفة(مصفوفة, 10), خطأ, "غائب")
تأكد_يساوي(ابحث_في_المصفوفة(مصفوفة, 1), صواب, "الركن")
