# مثال 312 — أعداد كاتالان
# Catalan numbers
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/312-catalan.apl

دالة كاتالان(ن):
    المتغير جدول = [0 لكل _ في نطاق(ن + 1)]
    جدول[0] = 1
    لو ن >= 1:
        جدول[1] = 1
    لكل ي في نطاق(2, ن + 1):
        لكل ز في نطاق(ي):
            جدول[ي] = جدول[ي] + جدول[ز] * جدول[ي - 1 - ز]
    ارجع جدول[ن]

اطبع [كاتالان(ن) لكل ن في نطاق(10)]
