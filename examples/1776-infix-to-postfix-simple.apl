# مثال 1776 — من الصيغة العادية إلى اللاحقة
# Infix to postfix conversion
# Demonstrates: مكدسات
#
# Run:  python apl.py examples/1776-infix-to-postfix-simple.apl

# الضرب والقسمة أعلى أولوية
# نفرغ المكدس في النهاية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أولوية(ع):
  لو ع == "*" أو ع == "/":
    ارجع 2
  ارجع 1

دالة للاحقة(رموز):
  خرج = []
  مكدس = []
  لكل ر في رموز:
    لو ر.isdigit():
      خرج.append(ر)
    والا:
      طالما طول(مكدس) > 0 و أولوية(مكدس[طول(مكدس) - 1]) >= أولوية(ر):
        خرج.append(مكدس.pop())
      مكدس.append(ر)
  طالما طول(مكدس) > 0:
    خرج.append(مكدس.pop())
  ارجع خرج

تأكد_يساوي(للاحقة(["1", "+", "2", "*", "3"]), ["1", "2", "3", "*", "+"], "أولوية")
تأكد_يساوي(للاحقة(["1", "*", "2", "+", "3"]), ["1", "2", "*", "3", "+"], "عكس")
تأكد_يساوي(للاحقة(["4"]), ["4"], "عدد")
