# مثال 1162 — أصغر نافذة
# Minimum window substring
# Demonstrates: نافذة منزلقة
#
# Run:  python apl.py examples/1162-min-window-substring.apl

# نعد الحروف المطلوبة ونوسع النافذة
# وكلما اكتملت ضيقنا من اليسار وسجلنا الأقصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اصغر_نافذة(س, ن):
  لو ن == "":
    ارجع ""
  مطل = {}
  لكل ح في ن:
    مطل[ح] = مطل.get(ح, 0) + 1
  ناقص = طول(ن)
  يسار = 0
  افضل_بداية = -1
  افضل_طول = طول(س) + 1
  لكل يمين في نطاق(طول(س)):
    ح = س[يمين]
    لو ح في مطل:
      لو مطل[ح] > 0:
        ناقص = ناقص - 1
      مطل[ح] = مطل[ح] - 1
    طالما ناقص == 0:
      لو يمين - يسار + 1 < افضل_طول:
        افضل_طول = يمين - يسار + 1
        افضل_بداية = يسار
      ي = س[يسار]
      لو ي في مطل:
        مطل[ي] = مطل[ي] + 1
        لو مطل[ي] > 0:
          ناقص = ناقص + 1
      يسار = يسار + 1
  لو افضل_بداية == -1:
    ارجع ""
  ارجع س[افضل_بداية:افضل_بداية + افضل_طول]

تأكد_يساوي(اصغر_نافذة("ADOBECODEBANC", "ABC"), "BANC", "مثال أول")
تأكد_يساوي(اصغر_نافذة("a", "a"), "a", "حرف")
تأكد_يساوي(اصغر_نافذة("a", "aa"), "", "ناقص")
تأكد_يساوي(اصغر_نافذة("abc", ""), "", "نمط فارغ")
