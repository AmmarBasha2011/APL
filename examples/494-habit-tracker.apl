# مثال 494 — متتبع العادات
# Habit tracker
# Demonstrates: أسبوع عادات ونسبة إنجاز
#
# Run:  python apl.py examples/494-habit-tracker.apl

المتغير أيام_أسبوع = ["السبت", "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة"]
المتغير عادات = {
    "قراءة": [صواب, صواب, خطأ, صواب, صواب, خطأ, صواب],
    "رياضة": [خطأ, صواب, صواب, خطأ, صواب, صواب, خطأ]
}

لكل عادة في عادات.keys():
    المتغير إنجاز = 0
    لكل تمت في عادات[عادة]:
        لو تمت:
            إنجاز = إنجاز + 1
    اطبع عادة, ":", إنجاز, "/ 7 أيام"

اطبع "أفضل يوم للقراءة: السبت"
