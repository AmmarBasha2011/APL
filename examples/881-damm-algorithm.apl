# مثال 881 — خوارزمية دام
# Damm algorithm
# Demonstrates: زمرة شبه مرتبة
#
# Run:  python apl.py examples/881-damm-algorithm.apl

# خوارزمية دام: رقم تحقق يكشف كل خطأ مفرد وكل تبديل جار
# تستخدم جدول زمرة شبه مرتبة ضد التبديلات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

جدول = [
  [0, 3, 1, 7, 5, 9, 8, 6, 4, 2],
  [7, 0, 9, 2, 1, 5, 4, 8, 6, 3],
  [4, 2, 0, 6, 8, 7, 1, 3, 5, 9],
  [1, 7, 5, 9, 2, 3, 8, 4, 0, 6],
  [8, 4, 2, 0, 3, 1, 9, 6, 7, 5],
  [9, 8, 6, 4, 0, 2, 3, 1, 5, 7],
  [2, 5, 8, 6, 7, 0, 4, 9, 3, 1],
  [3, 9, 7, 1, 4, 8, 6, 5, 2, 0],
  [5, 1, 3, 2, 9, 6, 7, 0, 8, 4],
  [6, 0, 5, 8, 3, 1, 2, 7, 9, 4]
]

دالة دام(أرقام):
  حالة = 0
  لكل رقم في أرقام:
    حالة = جدول[حالة][رقم]
  ارجع حالة

اطبع "دام(572) =", دام([5, 7, 2])
اطبع "دام(5729) =", دام([5, 7, 2, 9])

# الحالة بعد 572 هي 7، ورقم التحقق هو 9 (حيث جدول[7][9] = 0)
تأكد_يساوي(دام([5, 7, 2]), 7, "رقم تحقق 572 هو 7")
تأكد_يساوي(دام([5, 7, 2, 9]), 0, "5729 صحيح")

# خطأ مفرد يكشف دائماً
تأكد_يساوي(دام([5, 9, 2, 9]) != 0, 1 == 1, "خطأ مفرد يكشف")
# تبديل جار يكشف دائماً (ميزة على لون)
تأكد_يساوي(دام([5, 2, 7, 9]) != 0, 1 == 1, "تبديل جار يكشف")
# تبديل آخر موضعين في رقم صحيح يكشف أيضاً
تأكد_يساوي(دام([5, 7, 2, 6]) != 0, 1 == 1, "تبديل 29 إلى 26 يكشف")
