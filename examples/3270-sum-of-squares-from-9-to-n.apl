# مثال 3270 — مجموع المربعات من 9 إلى ن
# Sum of squares from 9
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3270-sum-of-squares-from-9-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(9, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(9), 81, "حالة 1")
تأكد_يساوي(ف(10), 181, "حالة 2")
تأكد_يساوي(ف(19), 2266, "حالة 3")
تأكد_يساوي(ف(100), 338146, "حالة 4")
