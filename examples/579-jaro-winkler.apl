# مثال 579 — تشابه جارو-وينكلر
# Jaro-Winkler similarity
# Demonstrates: تشابه نصوص، أسماء، بادئة
#
# Run:  python apl.py examples/579-jaro-winkler.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تشابه جارو-وينكلر بين سلسلتين
دالة جارو(أ, ب):
    المتغير نطاق_بحث = أكبر(طول(أ), طول(ب)) // 2 - 1
    لو نطاق_بحث < 0:
        نطاق_بحث = 0
    المتغير تطابق_أ = [خطأ] * طول(أ)
    المتغير تطابق_ب = [خطأ] * طول(ب)
    المتغير تطابقات = 0
    لكل i في نطاق(طول(أ)):
        المتغير من = أكبر(0, i - نطاق_بحث)
        المتغير الى = أصغر(طول(ب), i + نطاق_بحث + 1)
        لكل j في نطاق(من, الى):
            لو ليس تطابق_ب[j] و أ[i] == ب[j]:
                تطابق_أ[i] = صواب
                تطابق_ب[j] = صواب
                تطابقات = تطابقات + 1
                توقف
    لو تطابقات == 0:
        ارجع 0
    المتغير نقلات = 0
    المتغير ك = 0
    لكل i في نطاق(طول(أ)):
        لو تطابق_أ[i]:
            طالما ليس تطابق_ب[ك]:
                ك = ك + 1
            لو أ[i] != ب[ك]:
                نقلات = نقلات + 1
            ك = ك + 1
    نقلات = نقلات // 2
    ارجع (تطابقات / طول(أ) + تطابقات / طول(ب) + (تطابقات - نقلات) / تطابقات) / 3

دالة وينكلر(أ, ب):
    المتغير ج = جارو(أ, ب)
    المتغير بادئة = 0
    لكل i في نطاق(أصغر(4, أصغر(طول(أ), طول(ب)))):
        لو أ[i] == ب[i]:
            بادئة = بادئة + 1
    ارجع ج + بادئة * 0.1 * (1 - ج)

تأكد_يساوي(مقرب(جارو("MARTHA", "MARHTA"), 3), 0.944, "جارو MARTHA/MARHTA")
تأكد_يساوي(مقرب(وينكلر("MARTHA", "MARHTA"), 3), 0.961, "وينكلر MARTHA/MARHTA")
تأكد_يساوي(جارو("abc", "xyz"), 0, "لا تطابق")
