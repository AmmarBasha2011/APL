# مثال 484 — طابور عيادة
# Clinic queue
# Demonstrates: حجز ونداء بالترتيب
#
# Run:  python apl.py examples/484-clinic-queue.apl

المتغير طابور = []

دالة احجز(اسم):
    طابور.append(اسم)
    اطبع "حجز:", اسم, "- رقمك", طول(طابور)

دالة ناد_التالي():
    لو طول(طابور) == 0:
        اطبع "لا أحد في الانتظار"
        ارجع
    المتغير تالي = طابور.pop(0)
    اطبع "ادخل:", تالي, "- متبقي", طول(طابور)

احجز("أحمد")
احجز("منى")
احجز("سامي")
ناد_التالي()
ناد_التالي()
ناد_التالي()
ناد_التالي()
