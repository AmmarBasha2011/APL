# مثال 1441 — أصغر مستطيل
# Minimum area axis-parallel rectangle
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1441-min-area-rectangle.apl

# نجرب كل زوج كقطر
# ونتحقق من وجود الرأسين الآخرين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اصغر_مساحة(نقاط):
  موجود = {}
  لكل ن في نقاط:
    موجود[نص(ن[0]) + "," + نص(ن[1])] = صواب
  افضل = 0
  لكل ي في نطاق(طول(نقاط)):
    لكل ك في نطاق(ي + 1, طول(نقاط)):
      أ = نقاط[ي]
      ب = نقاط[ك]
      لو (أ[0] != ب[0]) و (أ[1] != ب[1]):
        ج = نص(أ[0]) + "," + نص(ب[1])
        د = نص(ب[0]) + "," + نص(أ[1])
        لو موجود.get(ج, خطأ) و موجود.get(د, خطأ):
          ع = ب[0] - أ[0]
          لو ع < 0:
            ع = -ع
          ط = ب[1] - أ[1]
          لو ط < 0:
            ط = -ط
          لو (افضل == 0) أو (ع * ط < افضل):
            افضل = ع * ط
  ارجع افضل

تأكد_يساوي(اصغر_مساحة([[1,1],[1,3],[3,1],[3,3],[2,2]]), 4, "أربعة")
تأكد_يساوي(اصغر_مساحة([[1,1],[1,3],[3,1],[3,3],[4,1],[4,3]]), 2, "اثنان")
تأكد_يساوي(اصغر_مساحة([[0,0],[1,1]]), 0, "لا مستطيل")
