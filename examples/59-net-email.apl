# مثال 59 — بناء رسالة بريد كاملة، حفظها كملف .eml، ثم قراءتها مرة أخرى
# Build an email, save it as .eml, parse it back
# Demonstrates: رسالة_بريد_كاملة, عين_المحتوى, أضف_بديلاً, أضف_مرفقاً,
#               إلى_نص, إلى_بايتات, رسالة_من_نص_عام, كرر_الأجزاء,
#               نوع_محتوى_البريد, اقرأ_اسم_المرفق, نسّق_تاريخ_البريد,
#               نسّق_عنوان_بريد, حلّل_عنوان_بريد, ولّد_معرّف_رسالة
#
# Run:  python apl.py examples/59-net-email.apl

المتغير ملف_الرسالة = "_apl_بريد_تجربة.eml"

# ---------- 1) بناء الرسالة ----------
اطبع "=== 1) بناء الرسالة ==="

المتغير رسالة = رسالة_بريد_كاملة()
رسالة["From"] = "أمير <amir@example.com>"
رسالة["To"] = "فريق التطوير <team@example.com>"
رسالة["Subject"] = "تقرير الشهر — نوفمبر"
رسالة["Date"] = نسّق_تاريخ_البريد()
رسالة["Message-ID"] = ولّد_معرّف_رسالة()

رسالة.عين_المحتوى("السلام عليكم،\nالتقرير مرفق. الإجمالي 12500.\n")
رسالة.أضف_بديلاً("<h2>التقرير</h2><p>الإجمالي: 12500</p>", نوع_فرعي = "html")

المتغير بيانات_csv = "الشهر,المبيعات\nيناير,4000\nفبراير,3800\nمارس,4700\n"
رسالة.أضف_مرفقاً(بيانات_csv.encode(), "application", "csv", ملف_المرفق = "تقرير.csv")

اطبع "الموضوع: " + رسالة["Subject"]
اطبع "النوع: " + رسالة.نوع_محتوى_البريد()
اطبع "عدد الأجزاء: " + نص(طول(قائمة(رسالة.كرر_الأجزاء())))

# ---------- 2) الحفظ كملف .eml ----------
اطبع "=== 2) الحفظ على القرص ==="
المتغير خام = رسالة.إلى_بايتات()
المتغير ملف = فتح(ملف_الرسالة, "wb")
ملف.write(خام)
ملف.close()
اطبع "حجم الملف: " + نص(حجم_ملف(ملف_الرسالة)) + " بايت"

# ---------- 3) قراءتها مرة أخرى ----------
اطبع "=== 3) القراءة من الملف ==="
المتغير ملف_قراءة = فتح(ملف_الرسالة, "rb")
المتغير بايتات = ملف_قراءة.read()
ملف_قراءة.close()

المتغير مقروءة = رسالة_من_نص_عام(بايتات.decode("utf-8"))
# الرؤوس غير اللاتينية تُرمَّز RFC 2047 عند التسلسل، فنفكها للعرض
دالة افك_رأس(خام):
    المتغير قطع = فك_رأس_بريد(خام)
    المتغير ناتج = ""
    لكل قطعة في قطع:
        لو نوع(قطعة[0]) == bytes:
            ناتج = ناتج + قطعة[0].decode(قطعة[1] أو "utf-8")
        الا:
            ناتج = ناتج + قطعة[0]
    ارجع ناتج

اطبع "من: " + افك_رأس(مقروءة["From"])
اطبع "إلى: " + افك_رأس(مقروءة["To"])
اطبع "الموضوع: " + افك_رأس(مقروءة["Subject"])
اطبع "هل هي متعددة الأجزاء؟ " + نص(مقروءة.جزء_متعدد_أجزاء())

اطبع "الأجزاء:"
لكل جزء في مقروءة.كرر_الأجزاء():
    المتغير اسم = جزء.اقرأ_اسم_المرفق()
    المتغير تسمية = اسم if اسم else "-"
    اطبع "  " + جزء.نوع_محتوى_البريد() + "  |  " + نص(تسمية)

# ---------- 4) المرفق ----------
اطبع "=== 4) محتوى المرفق ==="
لكل جزء في مقروءة.كرر_الأجزاء():
    المتغير اسم = جزء.اقرأ_اسم_المرفق()
    إذا اسم:
        اطبع "الملف: " + نص(اسم)
        اطبع "الحجم: " + نص(طول(جزء.اقرأ_الحمولة())) + " حرفاً"

# ---------- 5) أدوات العناوين ----------
اطبع "=== 5) العناوين ==="
اطبع نسّق_عنوان_بريد(("أمير", "amir@example.com"))
المتغير اسم_المرسل, بريد_المرسل = حلّل_عنوان_بريد("أمير <amir@example.com>")
اطبع "الاسم: " + اسم_المرسل
اطبع "البريد: " + بريد_المرسل

# ---------- 6) تنظيف ----------
احذف_ملف(ملف_الرسالة)
اطبع "حُذف ملف الاختبار: " + نص(موجود(ملف_الرسالة))
اطبع "تم."
