# مثال 2437 — الحد النوني بخطوة 5
# Nth term step 5
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2437-nth-term-arithmetic-sequence-step-5.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 5

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 8, "حالة 2")
تأكد_يساوي(ف(10), 48, "حالة 3")
تأكد_يساوي(ف(100), 498, "حالة 4")
