# مثال 2324 — ثنائي إلى عشري
# Binary string to decimal
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2324-binary-string-to-decimal-manual.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 0
  لكل ح في ن:
    ق = ق * 2 + int(ح)
  ارجع ق

تأكد_يساوي(ف("0"), 0, "حالة 1")
تأكد_يساوي(ف("1"), 1, "حالة 2")
تأكد_يساوي(ف("101"), 5, "حالة 3")
تأكد_يساوي(ف("11111111"), 255, "حالة 4")
تأكد_يساوي(ف("100000"), 32, "حالة 5")
