# مثال 3334 — مجموع قوى 38
# Sum of powers of 38
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3334-sum-of-powers-of-38-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 38 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 39, "حالة 2")
تأكد_يساوي(ف(3), 56355, "حالة 3")
تأكد_يساوي(ف(6), 3092313043, "حالة 4")
تأكد_يساوي(ف(10), 6447893249285203, "حالة 5")
