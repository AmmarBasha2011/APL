# مثال 2504 — أعداد دون المئة مجموع أرقامها 3
# Numbers below 100 with digit sum 3
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2504-count-numbers-below-hundred-with-digit-sum-3.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(ن):
    م = 0
    لكل ر في نص(ي):
      م = م + int(ر)
    لو م == 3:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(10), 1, "حالة 1")
تأكد_يساوي(ف(50), 4, "حالة 2")
تأكد_يساوي(ف(100), 4, "حالة 3")
تأكد_يساوي(ف(200), 7, "حالة 4")
