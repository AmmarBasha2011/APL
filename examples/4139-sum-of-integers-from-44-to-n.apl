# مثال 4139 — مجموع الأعداد من 44 إلى ن
# Sum from 44 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4139-sum-of-integers-from-44-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(44, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(44), 44, "حالة 1")
تأكد_يساوي(ف(45), 89, "حالة 2")
تأكد_يساوي(ف(54), 539, "حالة 3")
تأكد_يساوي(ف(100), 4104, "حالة 4")
