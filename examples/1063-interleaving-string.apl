# مثال 1063 — نص متشابك
# Interleaving string
# Demonstrates: جدول ثنائي
#
# Run:  python apl.py examples/1063-interleaving-string.apl

# جدول يقول هل أول ي حرفاً من الأول وأول ك من الثاني تصنع بادئة الثالث
# كل خلية تعتمد على الخلية العليا واليسرى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متشابك(أ, ب, ج):
  لو (طول(أ) + طول(ب)) != طول(ج):
    ارجع خطأ
  د = []
  لكل ي في نطاق(طول(أ) + 1):
    د.ألحق([خطأ] * (طول(ب) + 1))
  د[0][0] = صواب
  لكل ي في نطاق(طول(أ) + 1):
    لكل ك في نطاق(طول(ب) + 1):
      لو (ي > 0) و د[ي - 1][ك] و (أ[ي - 1] == ج[(ي + ك) - 1]):
        د[ي][ك] = صواب
      لو (ك > 0) و د[ي][ك - 1] و (ب[ك - 1] == ج[(ي + ك) - 1]):
        د[ي][ك] = صواب
  ارجع د[طول(أ)][طول(ب)]

تأكد_يساوي(متشابك("aabcc", "dbbca", "aadbbcbcac"), صواب, "ممكن")
تأكد_يساوي(متشابك("aabcc", "dbbca", "aadbbbaccc"), خطأ, "غير ممكن")
تأكد_يساوي(متشابك("", "", ""), صواب, "فارغة")
تأكد_يساوي(متشابك("a", "", "c"), خطأ, "حرف مختلف")
