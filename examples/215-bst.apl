# مثال 215 — شجرة البحث الثنائية
# Binary search tree
# Demonstrates: إدراج وبحث عوديان
#
# Run:  python apl.py examples/215-bst.apl

صنف عقدة:
    دالة_إنشاء(ذات, قيمة):
        ذات.قيمة = قيمة
        ذات.أيسر = لا_شيء
        ذات.أيمن = لا_شيء

دالة أدرج_عقدة(ع, قيمة):
    لو ع == لا_شيء:
        ارجع عقدة(قيمة)
    لو قيمة < ع.قيمة:
        ع.أيسر = أدرج_عقدة(ع.أيسر, قيمة)
    الا لو قيمة > ع.قيمة:
        ع.أيمن = أدرج_عقدة(ع.أيمن, قيمة)
    ارجع ع

دالة ابحث_عقدة(عقدة, قيمة):
    لو عقدة == لا_شيء:
        ارجع خطأ
    لو عقدة.قيمة == قيمة:
        ارجع صواب
    لو قيمة < عقدة.قيمة:
        ارجع ابحث_عقدة(عقدة.أيسر, قيمة)
    ارجع ابحث_عقدة(عقدة.أيمن, قيمة)

دالة جولة_داخلية(عقدة, نتيجة):
    لو عقدة == لا_شيء:
        ارجع
    جولة_داخلية(عقدة.أيسر, نتيجة)
    نتيجة.أضف(عقدة.قيمة)
    جولة_داخلية(عقدة.أيمن, نتيجة)

المتغير جذر = لا_شيء
لكل ق في [50, 30, 70, 20, 40, 60, 80]:
    جذر = أدرج_عقدة(جذر, ق)

المتغير مرتبة = []
جولة_داخلية(جذر, مرتبة)
اطبع "الجولة الداخلية (مرتبة):", مرتبة
اطبع "هل 40 موجود؟", ابحث_عقدة(جذر, 40)
اطبع "هل 90 موجود؟", ابحث_عقدة(جذر, 90)
