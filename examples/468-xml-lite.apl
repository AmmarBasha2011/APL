# مثال 468 — قارئ وسوم مبسط
# Simple tag parser
# Demonstrates: استخراج محتوى الوسوم
#
# Run:  python apl.py examples/468-xml-lite.apl

دالة محتوى_اسم_وسم(نص_الدخل, اسم_وسم):
    المتغير بداية_اسم_وسم = "<" + اسم_وسم + ">"
    المتغير نهاية_اسم_وسم = "</" + اسم_وسم + ">"
    المتغير ب = نص_الدخل.find(بداية_اسم_وسم) + طول(بداية_اسم_وسم)
    المتغير ن = نص_الدخل.find(نهاية_اسم_وسم)
    ارجع نص_الدخل[ب:ن]

المتغير مستند = "<user><name>عمار</name><age>26</age></user>"
اطبع "الاسم:", محتوى_اسم_وسم(مستند, "name")
اطبع "العمر:", محتوى_اسم_وسم(مستند, "age")
