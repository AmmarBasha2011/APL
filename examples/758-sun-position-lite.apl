# مثال 758 — موضع الشمس
# Solar position lite
# Demonstrates: معادلة كوبر، ميل، ارتفاع ظهيرة
#
# Run:  python apl.py examples/758-sun-position-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ارتفاع الشمس عند الظهيرة من يوم السنة وخط العرض
# Demonstrates: معادلة كوبر للميل, تحويل درجات إلى راديان, فصول السنة
# الميل δ = 23.45° × جا(360° × (284 + اليوم) / 365)

دالة ميل_الشمس(يوم):
  ارجع 23.45 * جب((360.0 * (284 + يوم) / 365) * 3.14159265358979 / 180)

دالة ارتفاع_الظهيرة(عرض, يوم):
  فرق = عرض - ميل_الشمس(يوم)
  لو فرق < 0:
    فرق = -فرق
  ارجع 90 - فرق

تأكد_يساوي(مقرب(ميل_الشمس(80), 2), -0.4, "ميل الاعتدال الربيعي")
تأكد_يساوي(مقرب(ميل_الشمس(172), 2), 23.45, "ميل الانقلاب الصيفي")
تأكد_يساوي(مقرب(ميل_الشمس(355), 2), -23.45, "ميل الانقلاب الشتوي")

تأكد_يساوي(مقرب(ارتفاع_الظهيرة(30, 80), 2), 59.6, "ظهيرة الاعتدال")
تأكد_يساوي(مقرب(ارتفاع_الظهيرة(30, 172), 2), 83.45, "ظهيرة الصيف")
تأكد_يساوي(مقرب(ارتفاع_الظهيرة(30, 355), 2), 36.55, "ظهيرة الشتاء")

تأكد_يساوي(ارتفاع_الظهيرة(30, 172) > ارتفاع_الظهيرة(30, 355), صواب, "الصيف أعلى من الشتاء")
تأكد_يساوي(مقرب(ارتفاع_الظهيرة(23.45, 172), 1), 90.0, "الشمس عمودية على مدار السرطان")

اطبع "ميل يوم 1:", مقرب(ميل_الشمس(1), 2)
