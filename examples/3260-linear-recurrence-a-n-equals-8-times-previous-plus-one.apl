# مثال 3260 — متتالية أ=8×السابق+1
# Recurrence times 8 plus one
# Demonstrates: متتاليات
#
# Run:  python apl.py examples/3260-linear-recurrence-a-n-equals-8-times-previous-plus-one.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  أ = 1
  لكل ي في نطاق(ن):
    أ = أ * 8 + 1
  ارجع أ

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 9, "حالة 2")
تأكد_يساوي(ف(2), 73, "حالة 3")
تأكد_يساوي(ف(5), 37449, "حالة 4")
تأكد_يساوي(ف(8), 19173961, "حالة 5")
