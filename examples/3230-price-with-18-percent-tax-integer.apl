# مثال 3230 — السعر مع ضريبة 18 بالمئة
# Price with 18 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3230-price-with-18-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 18 // 100

تأكد_يساوي(ف(100), 118, "حالة 1")
تأكد_يساوي(ف(250), 295, "حالة 2")
تأكد_يساوي(ف(999), 1178, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
