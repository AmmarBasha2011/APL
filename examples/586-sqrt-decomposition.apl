# مثال 586 — تحليل الجذر التربيعي
# Sqrt decomposition
# Demonstrates: كتل، مجاميع مدى، تحديث
#
# Run:  python apl.py examples/586-sqrt-decomposition.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحليل الجذر التربيعي: مجاميع المدى بسرعة
# Demonstrates: sqrt decomposition, تحديث عنصر, استعلام مدى O(√n)
# بديل بسيط عن شجرة الجزء للمصفوفات المتوسطة

أرقام = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8]
ن = طول(أرقام)
حجم_الكتلة = جذر_صحيح(ن)
كتل = [0] * (حجم_الكتلة + 1)
لكل ي في نطاق(ن):
  كتل[ي // حجم_الكتلة] = كتل[ي // حجم_الكتلة] + أرقام[ي]

دالة مجموع_المدى(أ, ب):
  مجموع = 0
  ي = أ
  طالما ي <= ب:
    لو ي % حجم_الكتلة == 0 و ي + حجم_الكتلة - 1 <= ب:
      مجموع = مجموع + كتل[ي // حجم_الكتلة]
      ي = ي + حجم_الكتلة
    والا:
      مجموع = مجموع + أرقام[ي]
      ي = ي + 1
  ارجع مجموع

دالة حدّث(فهرس, قيمة):
  أرقام[فهرس] = قيمة
  بداية_الكتلة = (فهرس // حجم_الكتلة) * حجم_الكتلة
  مجموع = 0
  لكل ي في نطاق(بداية_الكتلة, أصغر(بداية_الكتلة + حجم_الكتلة, ن)):
    مجموع = مجموع + أرقام[ي]
  كتل[فهرس // حجم_الكتلة] = مجموع

تأكد_يساوي(مجموع_المدى(0, ن - 1), 52, "مجموع الكل")
تأكد_يساوي(مجموع_المدى(3, 7), 23, "مجموع مدى جزئي")
حدّث(5, 0)
تأكد_يساوي(مجموع_المدى(0, ن - 1), 43, "مجموع بعد التحديث")
تأكد_يساوي(مجموع_المدى(4, 6), 7, "مدى يمر على كتلة محدثة")
