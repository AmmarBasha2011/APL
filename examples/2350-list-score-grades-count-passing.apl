# مثال 2350 — عدد الناجحين
# Count passing grades
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2350-list-score-grades-count-passing.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع = 0
  لكل د في ق:
    لو د >= 50:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([49, 50, 51]), 2, "حالة 1")
تأكد_يساوي(ف([100]), 1, "حالة 2")
تأكد_يساوي(ف([10, 20]), 0, "حالة 3")
تأكد_يساوي(ف([50, 50, 50, 49]), 3, "حالة 4")
