# مثال 940 — تحليل شوليسكي
# Cholesky decomposition
# Demonstrates: مثلثية في منقولها
#
# Run:  python apl.py examples/940-cholesky.apl

# تحليل شوليسكي: مصفوفة موجبة التعريف = مثلثية في منقولها
# أسرع من LU للأنظمة المتماثلة موجبة التعريف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة شوليسكي(مصفوفة):
  ن = طول(مصفوفة)
  ل = []
  لكل _ في نطاق(ن):
    صف = []
    لكل __ في نطاق(ن):
      صف.ألحق(0)
    ل.ألحق(صف)
  لكل i في نطاق(ن):
    لكل ج في نطاق(i + 1):
      مجموع = 0
      لكل ك في نطاق(ج):
        مجموع = مجموع + ل[i][ك] * ل[ج][ك]
      لو i == ج:
        ل[i][ج] = جذر(مصفوفة[i][i] - مجموع)
      والا:
        ل[i][ج] = (مصفوفة[i][ج] - مجموع) / ل[ج][ج]
  ارجع ل

مصفوفة = [[4, 12, -16], [12, 37, -43], [-16, -43, 98]]
ل = شوليسكي(مصفوفة)
اطبع "ل:", ل

تأكد_يساوي(مقرب(ل[0][0], 6), 2, "ل00")
تأكد_يساوي(مقرب(ل[1][0], 6), 6, "ل10")
تأكد_يساوي(مقرب(ل[1][1], 6), 1, "ل11")
تأكد_يساوي(مقرب(ل[2][0], 6), -8, "ل20")
تأكد_يساوي(مقرب(ل[2][1], 6), 5, "ل21")
تأكد_يساوي(مقرب(ل[2][2], 6), 3, "ل22")

# التحقق: ل * منقول ل = المصفوفة الأصلية
لكل i في نطاق(3):
  لكل ج في نطاق(3):
    مجموع = 0
    لكل ك في نطاق(3):
      مجموع = مجموع + ل[i][ك] * ل[ج][ك]
    تأكد_يساوي(مقرب(مجموع, 4), مصفوفة[i][ج], "إعادة بناء " + نص(i) + نص(ج))
