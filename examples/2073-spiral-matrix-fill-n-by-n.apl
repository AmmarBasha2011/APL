# مثال 2073 — ملء مصفوفة حلزونية
# Spiral matrix fill
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2073-spiral-matrix-fill-n-by-n.apl

# # أربع حدود تضيق بعد كل ضلع
# # نملأ من الخارج للداخل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حلزون(ن):
  م = []
  لكل ي في نطاق(ن):
    م = م + [[0] * ن]
  اعلى = 0
  اسفل = ن - 1
  يسار = 0
  يمين = ن - 1
  ع = 1
  طالما اعلى <= اسفل و يسار <= يمين:
    لكل ك في نطاق(يسار, يمين + 1):
      م[اعلى][ك] = ع
      ع = ع + 1
    اعلى = اعلى + 1
    لكل ك في نطاق(اعلى, اسفل + 1):
      م[ك][يمين] = ع
      ع = ع + 1
    يمين = يمين - 1
    لو اعلى <= اسفل:
      لكل ك في نطاق(يمين, يسار - 1, -1):
        م[اسفل][ك] = ع
        ع = ع + 1
      اسفل = اسفل - 1
    لو يسار <= يمين:
      لكل ك في نطاق(اسفل, اعلى - 1, -1):
        م[ك][يسار] = ع
        ع = ع + 1
      يسار = يسار + 1
  ارجع م

تأكد_يساوي(حلزون(3), [[1, 2, 3], [8, 9, 4], [7, 6, 5]], "٣")
تأكد_يساوي(حلزون(1), [[1]], "١")
تأكد_يساوي(حلزون(4), [[1, 2, 3, 4], [12, 13, 14, 5], [11, 16, 15, 6], [10, 9, 8, 7]], "٤")
