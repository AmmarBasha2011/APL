# مثال 1569 — عكس حالة الأحرف
# Swap letter case
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1569-swap-letter-case.apl

# نفحص كل حرف
# نقلب حالته إن كان حرفاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اعكس_الحالة(نص_):
  ناتج = ""
  لكل ح في نص_:
    لو ح.isupper():
      ناتج = ناتج + ح.lower()
    والا_لو ح.islower():
      ناتج = ناتج + ح.upper()
    والا:
      ناتج = ناتج + ح
  ارجع ناتج

تأكد_يساوي(اعكس_الحالة("Hello World"), "hELLO wORLD", "جملة")
تأكد_يساوي(اعكس_الحالة("A1b2"), "a1B2", "أرقام")
تأكد_يساوي(اعكس_الحالة(""), "", "فارغ")
