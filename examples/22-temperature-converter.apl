# مثال 22 — محول درجات الحرارة
# Temperature Converter
# Demonstrates: math library, user functions, loops, formatting
#
# Run:  python apl.py examples/22-temperature-converter.apl

دالة_إلى_فهرنهايت(مئوية):
    ارجع مئوية * 9 / 5 + 32

دالة_إلى_مئوية(فهرنهايت):
    ارجع (فهرنهايت - 32) * 5 / 9

دالة_إلى_كلفين(مئوية):
    ارجع مئوية + 273.15

اطبع "=== محول درجات الحرارة ==="
اطبع ""
اطبع "مئوية -> فهرنهايت -> كلفن"
اطبع "-----------------------------------"
المتغير الحرارة = [-10, 0, 20, 25, 37, 100]
لكل مئوية في الحرارة:
    ف = دالة_إلى_فهرنهايت(مئوية)
    ك = دالة_إلى_كلفين(مئوية)
    اطبع f"{مئوية:>6} -> {مقرب(ف, 1):>6} -> {مقرب(ك, 1):>7}"
اطبع ""
اطبع "عكس الاتجاه:"
لكل ف في [32, 68, 98, 212]:
    اطبع f"  {ف} فهرنهايت = {مقرب(دالة_إلى_مئوية(ف), 1)} مئوية"
