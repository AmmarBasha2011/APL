# مثال 1023 — تعبئة الصناديق
# Bin packing first fit decreasing
# Demonstrates: ترتيب تنازلي وأول ملاءمة
#
# Run:  python apl.py examples/1023-bin-packing-ffd.apl

# نرتب الأغراض من الأكبر للأصغر
# ونضع كل غرض في أول صندوق يتسع له وإلا فتحنا صندوقاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عبئ(اغراض, سعة):
  مرتبة = قائمة(اغراض)
  مرتبة.فرز()
  مرتبة.عكس()
  صناديق = []
  لكل غ في مرتبة:
    وضع = خطأ
    لكل ع في نطاق(طول(صناديق)):
      لو (وضع == خطأ) و ((صناديق[ع] + غ) <= سعة):
        صناديق[ع] = صناديق[ع] + غ
        وضع = صواب
    لو وضع == خطأ:
      صناديق.ألحق(غ)
  ارجع صناديق

تأكد_يساوي(طول(عبئ([4, 8, 1, 4, 2, 1], 10)), 2, "صندوقان")
تأكد_يساوي(عبئ([5, 5, 5], 10), [10, 5], "ثلاثة أغراض")
تأكد_يساوي(طول(عبئ([9, 9, 9], 10)), 3, "كل غرض وحده")
