# مثال 3400 — مساحة مستطيل مكبر 12 مرات
# Rectangle area scaled by 12
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3400-rectangle-area-scaled-by-12.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع (ق[0] * 12) * (ق[1] * 12)

تأكد_يساوي(ف([1, 2]), 288, "حالة 1")
تأكد_يساوي(ف([3, 4]), 1728, "حالة 2")
تأكد_يساوي(ف([5, 5]), 3600, "حالة 3")
تأكد_يساوي(ف([10, 1]), 1440, "حالة 4")
