# مثال 3433 — قوة 3 بالحلقة
# Power of 3 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3433-nth-power-of-3-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 3
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(3), 27, "حالة 3")
تأكد_يساوي(ف(6), 729, "حالة 4")
تأكد_يساوي(ف(10), 59049, "حالة 5")
