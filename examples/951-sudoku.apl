# مثال 951 — حل السودوكو
# Sudoku solver
# Demonstrates: تراجع مع فحص صلاحية
#
# Run:  python apl.py examples/951-sudoku.apl

# حل السودوكو بالتراجع: جرب رقماً صالحاً وتراجع عند الانسداد
# الصلاحية: لا تكرار في الصف أو العمود أو الصندوق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

شبكة = [[5, 3, 0, 0, 7, 0, 0, 0, 0], [6, 0, 0, 1, 9, 5, 0, 0, 0], [0, 9, 8, 0, 0, 0, 0, 6, 0], [8, 0, 0, 0, 6, 0, 0, 0, 3], [4, 0, 0, 8, 0, 3, 0, 0, 1], [7, 0, 0, 0, 2, 0, 0, 0, 6], [0, 6, 0, 0, 0, 0, 2, 8, 0], [0, 0, 0, 4, 1, 9, 0, 0, 5], [0, 0, 0, 0, 8, 0, 0, 7, 9]]

دالة صالح(صف, عمود, رقم):
  لكل i في نطاق(9):
    لو شبكة[صف][i] == رقم:
      ارجع خطأ
    لو شبكة[i][عمود] == رقم:
      ارجع خطأ
  صف_صندوق = (صف // 3) * 3
  عمود_صندوق = (عمود // 3) * 3
  لكل i في نطاق(3):
    لكل ج في نطاق(3):
      لو شبكة[صف_صندوق + i][عمود_صندوق + ج] == رقم:
        ارجع خطأ
  ارجع 1 == 1

دالة احلل():
  لكل صف في نطاق(9):
    لكل عمود في نطاق(9):
      لو شبكة[صف][عمود] == 0:
        لكل رقم في نطاق(1, 10):
          لو صالح(صف, عمود, رقم):
            شبكة[صف][عمود] = رقم
            لو احلل():
              ارجع 1 == 1
            شبكة[صف][عمود] = 0
        ارجع خطأ
  ارجع 1 == 1

لو احلل():
  اطبع "حُلت"
والا:
  اطبع "فشل: لا حل"
  قياسي_نظام_اخرج(1)

# الصف الأول من الحل المعروف
متوقع = [5, 3, 4, 6, 7, 8, 9, 1, 2]
لكل ج في نطاق(9):
  تأكد_يساوي(شبكة[0][ج], متوقع[ج], "صف أول " + نص(ج))

# لا أصفار ولا تكرار في أي صف
لكل صف في نطاق(9):
  مجموع = 0
  لكل عمود في نطاق(9):
    مجموع = مجموع + شبكة[صف][عمود]
  تأكد_يساوي(مجموع, 45, "مجموع صف " + نص(صف))
