# مثال 2035 — هل أحد النصين دوران للآخر
# String rotation check
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2035-string-rotation-doubled-search.apl

# # الدوران يظهر داخل النص مضاعفا
# # بشرط تساوي الطولين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة دوران(ا, ب):
  لو طول(ا) != طول(ب):
    ارجع خطأ
  ارجع (ب + ب).find(ا) != -1

تأكد_يساوي(دوران("waterbottle", "erbottlewat"), صواب, "دوران")
تأكد_يساوي(دوران("abc", "acb"), خطأ, "ترتيب مختلف")
تأكد_يساوي(دوران("a", "aa"), خطأ, "طول مختلف")
