# مثال 1421 — مقاطع ثنائية متساوية
# Count binary substrings
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1421-count-binary-substrings.apl

# نحسب أطوال المجموعات المتتالية
# كل جارين يعطيان أقل طولهما من المقاطع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عد_ثنائية(نص_):
  سابق = 0
  حالي = 1
  مجموع = 0
  لكل ع في نطاق(1, طول(نص_)):
    لو نص_[ع] == نص_[ع - 1]:
      حالي = حالي + 1
    والا:
      مجموع = مجموع + أصغر(سابق, حالي)
      سابق = حالي
      حالي = 1
  ارجع مجموع + أصغر(سابق, حالي)

تأكد_يساوي(عد_ثنائية("00110011"), 6, "ستة")
تأكد_يساوي(عد_ثنائية("10101"), 4, "أربعة")
تأكد_يساوي(عد_ثنائية("0"), 0, "صفر")
