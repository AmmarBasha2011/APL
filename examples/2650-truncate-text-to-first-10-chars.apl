# مثال 2650 — اقتطاع أول 10 أحرف
# First 10 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2650-truncate-text-to-first-10-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:10]

تأكد_يساوي(ف("hello world"), "hello worl", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abcdefghij", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
