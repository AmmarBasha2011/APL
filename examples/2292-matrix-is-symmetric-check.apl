# مثال 2292 — هل المصفوفة متناظرة
# Is symmetric
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2292-matrix-is-symmetric-check.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  لكل ي في نطاق(طول(م)):
    لكل ك في نطاق(طول(م)):
      لو م[ي][ك] != م[ك][ي]:
        ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف([[1, 2], [3, 4]]), خطأ, "حالة 1")
تأكد_يساوي(ف([[5]]), صواب, "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), خطأ, "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), صواب, "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), خطأ, "حالة 5")
