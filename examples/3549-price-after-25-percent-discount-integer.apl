# مثال 3549 — السعر بعد خصم 25 بالمئة
# Price after 25 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3549-price-after-25-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 25 // 100

تأكد_يساوي(ف(100), 75, "حالة 1")
تأكد_يساوي(ف(250), 188, "حالة 2")
تأكد_يساوي(ف(999), 750, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
