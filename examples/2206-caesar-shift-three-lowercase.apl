# مثال 2206 — قيصر بإزاحة ثلاثة
# Caesar shift by three
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2206-caesar-shift-three-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 3) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "def", "حالة 1")
تأكد_يساوي(ف("xyz"), "abc", "حالة 2")
تأكد_يساوي(ف("hello world"), "khoor zruog", "حالة 3")
تأكد_يساوي(ف("a1"), "d1", "حالة 4")
