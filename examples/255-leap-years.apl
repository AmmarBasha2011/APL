# مثال 255 — السنوات الكبيسة
# Leap years
# Demonstrates: قاعدة الكبس، توليد قائمة
#
# Run:  python apl.py examples/255-leap-years.apl

دالة كبيسة(سنة):
    لو سنة % 400 == 0:
        ارجع صواب
    لو سنة % 100 == 0:
        ارجع خطأ
    ارجع سنة % 4 == 0

اطبع "2024:", كبيسة(2024)
اطبع "2100:", كبيسة(2100)
اطبع "2000:", كبيسة(2000)

المتغير قائمة = [سنة لكل سنة في نطاق(2020, 2051) لو كبيسة(سنة)]
اطبع "الكبيسة 2020-2050:", قائمة
