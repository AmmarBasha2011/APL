# مثال 481 — نظام مخزون
# Inventory system
# Demonstrates: أصناف وكميات وتنبيه نقص
#
# Run:  python apl.py examples/481-inventory-system.apl

المتغير مخزون = [
    {"صنف": "أرز", "كمية": 50, "حد": 10},
    {"صنف": "سكر", "كمية": 5, "حد": 10},
    {"صنف": "زيت", "كمية": 20, "حد": 8}
]

اطبع "تقرير المخزون:"
لكل صنف_مخزون في مخزون:
    المتغير حالة = "متوفر"
    لو صنف_مخزون["كمية"] < صنف_مخزون["حد"]:
        حالة = "تحتاج إعادة طلب"
    اطبع صنف_مخزون["صنف"], صنف_مخزون["كمية"], "->", حالة
