# مثال 776 — ترتيب BM25
# BM25 ranking
# Demonstrates: idf لوغاريتمي، تشبع tf، تطبيع طول
#
# Run:  python apl.py examples/776-bm25-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# ترتيب BM25 للمستندات: تكرار المصطلح مشبع مع تطبيع الطول
# Demonstrates: idf لوغاريتمي, تشبع tf بمعامل k1, تطبيع متوسط الطول b

دالة عدد_في(قائمة, عنصر):
  عد = 0
  لكل ق في قائمة:
    لو ق == عنصر:
      عد = عد + 1
  ارجع عد

دالة في_قائمة(قائمة, عنصر):
  لكل ق في قائمة:
    لو ق == عنصر:
      ارجع صواب
  ارجع خطأ

دالة بي_ام(مستندات, استعلام, ك1, ب):
  ن = طول(مستندات)
  مجموع_اطوال = 0
  لكل مستند في مستندات:
    مجموع_اطوال = مجموع_اطوال + طول(مستند)
  متوسط = مجموع_اطوال * 1.0 / ن
  درجات = []
  لكل مستند في مستندات:
    درجة = 0.0
    لكل كلمة في استعلام:
      تكرار_مستندات = 0
      لكل م2 في مستندات:
        لو في_قائمة(م2, كلمة):
          تكرار_مستندات = تكرار_مستندات + 1
      لو تكرار_مستندات > 0:
        ايدف = لوغاريتم(1 + (ن - تكرار_مستندات + 0.5) / (تكرار_مستندات + 0.5)) / لوغاريتم(2.718281828459045)
        تف = عدد_في(مستند, كلمة)
        مقام = تف + ك1 * (1 - ب + ب * طول(مستند) / متوسط)
        درجة = درجة + ايدف * تف * (ك1 + 1) / مقام
    درجات.append(مقرب(درجة * 10000) / 10000)
  ارجع درجات

مستندات = [["القط", "يجلس", "على", "الحصيرة"], ["الكلب", "يلعب", "في", "الحديقة"], ["القط", "والكلب", "صديقان"]]
د1 = بي_ام(مستندات, ["القط"], 1.5, 0.75)
تأكد_يساوي(د1[0], 0.4515, "bm25 القط مستند 1")
تأكد_يساوي(د1[1], 0.0, "bm25 القط مستند 2")
تأكد_يساوي(د1[2], 0.5119, "bm25 القط مستند 3")
د2 = بي_ام(مستندات, ["الكلب", "يلعب"], 1.5, 0.75)
تأكد_يساوي(د2[0], 0.0, "bm25 كلب يلعب مستند 1")
تأكد_يساوي(د2[1], 1.8846, "bm25 كلب يلعب مستند 2")
تأكد_يساوي(د2[2], 0.0, "bm25 كلب يلعب مستند 3")
تأكد_يساوي(د2[1] > د1[0], صواب, "ترتيب منطقي")
