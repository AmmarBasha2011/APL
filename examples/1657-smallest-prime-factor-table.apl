# مثال 1657 — جدول أصغر عامل أولي
# Smallest prime factor sieve
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/1657-smallest-prime-factor-table.apl

# نبدأ بكل عدد عاملاً لنفسه
# نحدث مضاعفات كل أولي لم يحدث بعد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جدول_العوامل(ن):
  أصغر_عامل = []
  لكل ع في نطاق(ن + 1):
    أصغر_عامل.append(ع)
  ك = 2
  طالما ك * ك <= ن:
    لو أصغر_عامل[ك] == ك:
      لكل م في نطاق(ك * ك, ن + 1, ك):
        لو أصغر_عامل[م] == م:
          أصغر_عامل[م] = ك
    ك = ك + 1
  ارجع أصغر_عامل

دالة حلل(ن, جدول):
  عوامل = []
  طالما ن > 1:
    عوامل.append(جدول[ن])
    ن = ن // جدول[ن]
  ارجع عوامل

ج = جدول_العوامل(100)
تأكد_يساوي(حلل(84, ج), [2, 2, 3, 7], "أربعة وثمانون")
تأكد_يساوي(حلل(97, ج), [97], "أولي")
تأكد_يساوي(حلل(1, ج), [], "واحد")
