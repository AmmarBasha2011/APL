# مثال 1722 — مجموع حركة المصعد
# Elevator total floors travelled
# Demonstrates: محاكاة
#
# Run:  python apl.py examples/1722-elevator-floor-travel-sum.apl

# يبدأ من الطابق صفر
# كل طلب يضيف المسافة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حركة(طلبات):
  موضع = 0
  مجموع = 0
  لكل ط في طلبات:
    لو ط > موضع:
      مجموع = مجموع + ط - موضع
    والا:
      مجموع = مجموع + موضع - ط
    موضع = ط
  ارجع مجموع

تأكد_يساوي(حركة([3, 1, 5]), 9, "ثلاثة")
تأكد_يساوي(حركة([]), 0, "لا طلب")
تأكد_يساوي(حركة([0, 0]), 0, "ثابت")
