# مثال 1839 — البحث في مصفوفة مرتبة
# Search in row-column sorted matrix
# Demonstrates: بحث
#
# Run:  python apl.py examples/1839-matrix-search-sorted-rows.apl

# أكبر من الهدف نذهب يساراً
# أصغر منه ننزل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ابحث_مصفوفة(م, هدف):
  ي = 0
  ك = طول(م[0]) - 1
  طالما ي < طول(م) و ك >= 0:
    لو م[ي][ك] == هدف:
      ارجع صواب
    لو م[ي][ك] > هدف:
      ك = ك - 1
    والا:
      ي = ي + 1
  ارجع خطأ

م = [[1, 4, 7], [2, 5, 8], [3, 6, 9]]
تأكد_يساوي(ابحث_مصفوفة(م, 5), صواب, "وسط")
تأكد_يساوي(ابحث_مصفوفة(م, 10), خطأ, "غائب")
تأكد_يساوي(ابحث_مصفوفة(م, 3), صواب, "زاوية")
