# مثال 1371 — هل أفوز
# Can I win picking numbers
# Demonstrates: تراجع
#
# Run:  python apl.py examples/1371-can-i-win.apl

# اللاعب الذي يصل للمجموع أولاً يفوز
# نخزن الحالات بحسب الأرقام المستخدمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة افوز(اقصى, هدف):
  لو هدف <= 0:
    ارجع صواب
  لو اقصى * (اقصى + 1) // 2 < هدف:
    ارجع خطأ
  مستخدم = [0] * (اقصى + 1)
  ذاكرة = {}
  دالة فوز(باقي):
    مفتاح = نص(مستخدم)
    لو مفتاح في ذاكرة:
      ارجع ذاكرة[مفتاح]
    لكل ر في نطاق(1, اقصى + 1):
      لو مستخدم[ر] == 0:
        لو ر >= باقي:
          ذاكرة[مفتاح] = صواب
          ارجع صواب
        مستخدم[ر] = 1
        نتيجة = فوز(باقي - ر)
        مستخدم[ر] = 0
        لو نتيجة == خطأ:
          ذاكرة[مفتاح] = صواب
          ارجع صواب
    ذاكرة[مفتاح] = خطأ
    ارجع خطأ
  ارجع فوز(هدف)

تأكد_يساوي(افوز(10, 11), خطأ, "يخسر")
تأكد_يساوي(افوز(10, 0), صواب, "هدف صفر")
تأكد_يساوي(افوز(10, 40), خطأ, "هدف كبير")
