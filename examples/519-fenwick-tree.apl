# مثال 519 — شجرة فينويك
# Fenwick tree (BIT)
# Demonstrates: شجرة فينويك، مجاميع بادئة
#
# Run:  python apl.py examples/519-fenwick-tree.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# شجرة فينويك (BIT) للمجاميع البادئة
المتغير ن = 6
المتغير شجرة = [0, 0, 0, 0, 0, 0, 0]

دالة زد(i, فرق):
    طالما i <= ن:
        شجرة[i] = شجرة[i] + فرق
        i = i + (i & (0 - i))

دالة بادئة(i):
    المتغير م = 0
    طالما i > 0:
        م = م + شجرة[i]
        i = i - (i & (0 - i))
    ارجع م

المتغير قيم = [3, 2, -1, 6, 5, 4]
لكل i في نطاق(ن):
    زد(i + 1, قيم[i])
تأكد_يساوي(بادئة(6), 19, "المجموع الكلي")
تأكد_يساوي(بادئة(3), 4, "بادئة حتى 3")
زد(4, 2)
تأكد_يساوي(بادئة(4), 12, "بعد إضافة 2 للعنصر 4")
