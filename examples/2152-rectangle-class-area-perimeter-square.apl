# مثال 2152 — صنف مستطيل
# Rectangle class
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2152-rectangle-class-area-perimeter-square.apl

# # الأبعاد صفتان
# # وثلاث دوال

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مستطيل:
    دالة_إنشاء(ذات, عرض, ارتفاع):
        ذات.عرض = عرض
        ذات.ارتفاع = ارتفاع

    دالة مساحة(ذات):
        ارجع ذات.عرض * ذات.ارتفاع

    دالة محيط(ذات):
        ارجع 2 * (ذات.عرض + ذات.ارتفاع)

    دالة مربع(ذات):
        ارجع ذات.عرض == ذات.ارتفاع

م = مستطيل(3, 4)
تأكد_يساوي(م.مساحة(), 12, "المساحة")
تأكد_يساوي(م.محيط(), 14, "المحيط")
تأكد_يساوي(م.مربع(), خطأ, "ليس مربعا")
تأكد_يساوي(مستطيل(5, 5).مربع(), صواب, "مربع")
