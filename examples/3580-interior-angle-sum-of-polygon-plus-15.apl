# مثال 3580 — مجموع زوايا مضلع زائد 15
# Polygon angle sum plus 15
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3580-interior-angle-sum-of-polygon-plus-15.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 15

تأكد_يساوي(ف(3), 195, "حالة 1")
تأكد_يساوي(ف(4), 375, "حالة 2")
تأكد_يساوي(ف(5), 555, "حالة 3")
تأكد_يساوي(ف(6), 735, "حالة 4")
تأكد_يساوي(ف(12), 1815, "حالة 5")
