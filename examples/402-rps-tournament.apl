# مثال 402 — بطولة حجر ورقة مقص
# RPS tournament
# Demonstrates: 100 جولة عشوائية وإحصاء
#
# Run:  python apl.py examples/402-rps-tournament.apl

بذرة(11)
المتغير خيارات = ["حجر", "ورقة", "مقص"]
المتغير فوز_أ = 0
المتغير فوز_ب = 0
المتغير تعادل = 0

لكل _ في نطاق(100):
    المتغير أ = خيارات[عشوائي_عدد(0, 2)]
    المتغير ب = خيارات[عشوائي_عدد(0, 2)]
    لو أ == ب:
        تعادل = تعادل + 1
    الا لو (أ == "حجر" و ب == "مقص") أو (أ == "ورقة" و ب == "حجر") أو (أ == "مقص" و ب == "ورقة"):
        فوز_أ = فوز_أ + 1
    الا:
        فوز_ب = فوز_ب + 1

اطبع "اللاعب أ:", فوز_أ
اطبع "اللاعب ب:", فوز_ب
اطبع "تعادل:", تعادل
