# مثال 2359 — AND لكل العناصر
# Bitwise AND of all
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2359-list-bits-and-of-all-items.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = ق[0]
  لكل ع في ق:
    ن = ن & ع
  ارجع ن

تأكد_يساوي(ف([7, 3]), 3, "حالة 1")
تأكد_يساوي(ف([5]), 5, "حالة 2")
تأكد_يساوي(ف([12, 10, 8]), 8, "حالة 3")
تأكد_يساوي(ف([1, 2]), 0, "حالة 4")
