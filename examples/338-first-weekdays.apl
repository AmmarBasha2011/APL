# مثال 338 — أول اثنين من كل شهر
# First Monday of each month
# Demonstrates: بحث عن أول يوم مطابق
#
# Run:  python apl.py examples/338-first-weekdays.apl

المتغير أيام = ["الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت", "الأحد"]

لكل شهر_م في نطاق(1, 13):
    المتغير ت = تاريخ(2026, شهر_م, 1)
    طالما ت.weekday() != 0:
        ت = ت + مدة(أيام=1)
    اطبع "أول اثنين في شهر", شهر_م, ":", ت
