# مثال 1740 — زمن إنهاء المهام بالتناوب
# Round robin completion times
# Demonstrates: جدولة
#
# Run:  python apl.py examples/1740-round-robin-turnaround-time.apl

# نكرر على المهام بحصة ثابتة
# نسجل زمن انتهاء كل مهمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تناوب(مهام, حصة):
  باقي = مهام + []
  انتهاء = []
  لكل ك في نطاق(طول(مهام)):
    انتهاء.append(0)
  زمن = 0
  متبقي = طول(مهام)
  طالما متبقي > 0:
    لكل ك في نطاق(طول(باقي)):
      لو باقي[ك] > 0:
        خطوة = أصغر(حصة, باقي[ك])
        زمن = زمن + خطوة
        باقي[ك] = باقي[ك] - خطوة
        لو باقي[ك] == 0:
          انتهاء[ك] = زمن
          متبقي = متبقي - 1
  ارجع انتهاء

تأكد_يساوي(تناوب([5, 3, 1], 2), [9, 8, 5], "ثلاث مهام")
تأكد_يساوي(تناوب([4], 4), [4], "مهمة")
