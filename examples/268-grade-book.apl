# مثال 268 — سجل درجات فصل
# Class grade book
# Demonstrates: متوسطات وتقديرات وترتيب
#
# Run:  python apl.py examples/268-grade-book.apl

المتغير طلاب = {
    "علي": [80, 75, 90],
    "سارة": [95, 88, 92],
    "خالد": [60, 70, 65]
}

دالة متوسط(قائمة):
    المتغير م = 0
    لكل ع في قائمة:
        م = م + ع
    ارجع م / طول(قائمة)

دالة تقدير(درجة):
    لو درجة >= 90:
        ارجع "ممتاز"
    الا لو درجة >= 75:
        ارجع "جيد جدا"
    الا لو درجة >= 60:
        ارجع "جيد"
    الا:
        ارجع "ضعيف"

المتغير نتائج = []
لكل اسم في طلاب:
    المتغير م = متوسط(طلاب[اسم])
    نتائج.أضف({"اسم": اسم, "متوسط": مقرب(م, 1), "تقدير": تقدير(م)})

المتغير مرتبون = مفرز(نتائج, key=(س) => س["متوسط"], reverse=True)
لكل ي في نطاق(طول(مرتبون)):
    اطبع ي + 1, "-", مرتبون[ي]["اسم"], ":", مرتبون[ي]["متوسط"], "(", مرتبون[ي]["تقدير"], ")"
