# مثال 2638 — قيصر بإزاحة 12
# Caesar shift 12
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2638-caesar-shift-by-12-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 12) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "mno", "حالة 1")
تأكد_يساوي(ف("xyz"), "jkl", "حالة 2")
تأكد_يساوي(ف("hello world"), "tqxxa iadxp", "حالة 3")
تأكد_يساوي(ف("a1"), "m1", "حالة 4")
