# مثال 2225 — فروق العناصر المتجاورة
# Adjacent differences
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2225-list-differences-adjacent-pairs.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ي في نطاق(طول(ق) - 1):
    ر = ر + [ق[ي + 1] - ق[ي]]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [-2, 1], "حالة 1")
تأكد_يساوي(ف([5]), [], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [1, 1, 1, 1, 1], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [2, 7, 0, -3], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [10, -10, 20, -10, -10], "حالة 5")
