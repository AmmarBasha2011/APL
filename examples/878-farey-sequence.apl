# مثال 878 — متتابعة فاري
# Farey sequence
# Demonstrates: كسور مختزلة مرتبة
#
# Run:  python apl.py examples/878-farey-sequence.apl

# متتابعة فاري: كل الكسور المختزلة بين 0 و1 بمقامات لا تتجاوز n
# خاصية الجارين: ب*ج - أ*د = 1 دائماً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قاسم_مشترك(أ, ب):
  طالما ب != 0:
    مؤقت = أ % ب
    أ = ب
    ب = مؤقت
  ارجع أ

دالة فاري(رتبة):
  كسور = []
  لكل مقام في نطاق(1, رتبة + 1):
    لكل بسط في نطاق(0, مقام + 1):
      لو قاسم_مشترك(بسط, مقام) == 1:
        كسور.ألحق([بسط, مقام])
  # فرز بالقيمة: ب1*م2 مقابل ب2*م1
  ن = طول(كسور)
  لكل i في نطاق(ن):
    لكل ج في نطاق(ن - 1):
      لو كسور[ج][0] * كسور[ج + 1][1] > كسور[ج + 1][0] * كسور[ج][1]:
        مؤقت = كسور[ج]
        كسور[ج] = كسور[ج + 1]
        كسور[ج + 1] = مؤقت
  ارجع كسور

ف5 = فاري(5)
اطبع "فاري(5):", ف5

تأكد_يساوي(طول(ف5), 11, "أحد عشر كسراً")
تأكد_يساوي(ف5[0][1], 1, "تبدأ 0/1")
تأكد_يساوي(ف5[10][0], 1, "تنتهي 1/1")
تأكد_يساوي(ف5[5][0], 1, "الوسط 1/2 بسطاً")
تأكد_يساوي(ف5[5][1], 2, "الوسط 1/2 مقاماً")

# خاصية الجارين لكل زوج متتال
لكل i في نطاق(طول(ف5) - 1):
  ب1 = ف5[i][0]
  م1 = ف5[i][1]
  ب2 = ف5[i + 1][0]
  م2 = ف5[i + 1][1]
  تأكد_يساوي(ب2 * م1 - ب1 * م2, 1, "خاصية الجارين عند " + نص(i))
