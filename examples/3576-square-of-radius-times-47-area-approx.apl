# مثال 3576 — مساحة دائرة بتقريب 47
# Circle area with pi approx 47/7
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3576-square-of-radius-times-47-area-approx.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن * 47 // 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 6, "حالة 2")
تأكد_يساوي(ف(7), 329, "حالة 3")
تأكد_يساوي(ف(14), 1316, "حالة 4")
تأكد_يساوي(ف(21), 2961, "حالة 5")
