# مثال 707 — حلال SAT بـDPLL
# DPLL SAT solver
# Demonstrates: نشر وحدة، فرع، رجوع
#
# Run:  python apl.py examples/707-dpll-sat-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# حلال SAT بخوارزمية DPLL المصغرة
# Demonstrates: نشر الوحدة, اختيار حرف, عودية مع رجوع
# الصيغة قائمة عبارات، كل عبارة قائمة حروف موجبة أو سالبة

دالة بسط(عبارات, حرف):
  جديد = []
  لكل عبارة في عبارات:
    لو حرف في عبارة:
      جديد = جديد
    والا:
      مصفاة = []
      لكل ح في عبارة:
        لو ح != -حرف:
          مصفاة.append(ح)
      جديد.append(مصفاة)
  ارجع جديد

دالة وحدة(عبارات):
  لكل عبارة في عبارات:
    لو طول(عبارة) == 1:
      ارجع عبارة[0]
  ارجع 0

دالة dpll(عبارات, تعيين):
  طالما صواب:
    ح_وحدة = وحدة(عبارات)
    لو ح_وحدة == 0:
      ارجع فرع(عبارات, تعيين)
    تعيين.append(ح_وحدة)
    عبارات = بسط(عبارات, ح_وحدة)
    لو [] في عبارات:
      ارجع لا_شيء

دالة فرع(عبارات, تعيين):
  لو طول(عبارات) == 0:
    ارجع تعيين
  لو [] في عبارات:
    ارجع لا_شيء
  حرف = عبارات[0][0]
  تعيين_ص = تعيين + [حرف]
  نتيجة = dpll(بسط(عبارات, حرف), تعيين_ص)
  لو نتيجة != لا_شيء:
    ارجع نتيجة
  تعيين_خ = تعيين + [-حرف]
  ارجع dpll(بسط(عبارات, -حرف), تعيين_خ)

# (أ ∨ ب) ∧ (¬أ ∨ ب) ∧ (¬ب): غير قابلة للإشباع
تأكد_يساوي(dpll([[1, 2], [-1, 2], [-2]], []), لا_شيء, "غير قابلة")
# (أ ∨ ب) ∧ (¬أ ∨ ج): قابلة
ن = dpll([[1, 2], [-1, 3]], [])
تأكد_يساوي(ن != لا_شيء, صواب, "قابلة للإشباع")
# تحقق من صحة التعيين
دالة صحح(عبارات, تعيين):
  لكل عبارة في عبارات:
    صحيحة = خطأ
    لكل ح في عبارة:
      لو ح في تعيين:
        صحيحة = صواب
    لو صحيحة == خطأ:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(صحح([[1, 2], [-1, 3]], ن), صواب, "التعيين يحقق الصيغة")
ن2 = dpll([[1], [-1, 2], [-2, 3]], [])
تأكد_يساوي(صحح([[1], [-1, 2], [-2, 3]], ن2), صواب, "سلسلة نشر وحدة")
تأكد_يساوي(1 في ن2, صواب, "أ حقيقية")
اطبع "تعيين:", ن
