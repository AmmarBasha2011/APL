# مثال 2342 — استبدال السالب بصفر
# Replace negatives with zero
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2342-list-replace-negatives-with-zero.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    لو ع < 0:
      ر = ر + [0]
    والا:
      ر = ر + [ع]
  ارجع ر

تأكد_يساوي(ف([-1, 2, -3]), [0, 2, 0], "حالة 1")
تأكد_يساوي(ف([1, 2]), [1, 2], "حالة 2")
تأكد_يساوي(ف([-5]), [0], "حالة 3")
تأكد_يساوي(ف([0, 0]), [0, 0], "حالة 4")
