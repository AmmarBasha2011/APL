# مثال 450 — أعداد مركبة يدويا
# Manual complex numbers
# Demonstrates: جمع وضرب ومقياس
#
# Run:  python apl.py examples/450-complex-manual.apl

دالة اجمع_مركب(أ, ب):
    ارجع [أ[0] + ب[0], أ[1] + ب[1]]

دالة اضرب_مركب(أ, ب):
    ارجع [أ[0] * ب[0] - أ[1] * ب[1], أ[0] * ب[1] + أ[1] * ب[0]]

دالة مقياس(أ):
    ارجع جذر(أ[0] * أ[0] + أ[1] * أ[1])

دالة نص_مركب(أ):
    لو أ[1] >= 0:
        ارجع نص(أ[0]) + " + " + نص(أ[1]) + "i"
    ارجع نص(أ[0]) + " - " + نص(مطلق(أ[1])) + "i"

المتغير ع1 = [2, 3]
المتغير ع2 = [1, -1]
اطبع "الجمع:", نص_مركب(اجمع_مركب(ع1, ع2))
اطبع "الضرب:", نص_مركب(اضرب_مركب(ع1, ع2))
اطبع "المقياس:", مقياس(ع1)
