# مثال 4389 — صف جدول ضرب 33
# Multiplication row of 33
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4389-multiplication-table-row-of-33.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 33]
  ارجع ر

تأكد_يساوي(ف(1), [33], "حالة 1")
تأكد_يساوي(ف(5), [33, 66, 99, 132, 165], "حالة 2")
تأكد_يساوي(ف(10), [33, 66, 99, 132, 165, 198, 231, 264, 297, 330], "حالة 3")
