# مثال 4034 — آخر رقم من ن×25
# Last digit of n times 25
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4034-last-digit-of-n-times-25.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 25) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 5, "حالة 2")
تأكد_يساوي(ف(7), 5, "حالة 3")
تأكد_يساوي(ف(12), 0, "حالة 4")
تأكد_يساوي(ف(99), 5, "حالة 5")
