# مثال 2621 — الحد النوني بخطوة 12
# Nth term step 12
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2621-nth-term-arithmetic-sequence-step-12.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 12

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 15, "حالة 2")
تأكد_يساوي(ف(10), 111, "حالة 3")
تأكد_يساوي(ف(100), 1191, "حالة 4")
