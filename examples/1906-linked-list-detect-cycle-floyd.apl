# مثال 1906 — كشف دورة في قائمة مرتبطة
# Detect a cycle in a linked list
# Demonstrates: هياكل بيانات
#
# Run:  python apl.py examples/1906-linked-list-detect-cycle-floyd.apl

# إن وجدت دورة يلتقي المؤشران
# وإلا يصل السريع للنهاية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فيها_دورة(تالي, رأس):
  بطيء = رأس
  سريع = رأس
  طالما سريع != -1 و تالي[سريع] != -1:
    بطيء = تالي[بطيء]
    سريع = تالي[تالي[سريع]]
    لو بطيء == سريع:
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(فيها_دورة([1, 2, 3, -1], 0), خطأ, "بلا دورة")
تأكد_يساوي(فيها_دورة([1, 2, 3, 1], 0), صواب, "دورة")
تأكد_يساوي(فيها_دورة([0], 0), صواب, "حلقة ذاتية")
