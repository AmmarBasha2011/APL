# مثال 682 — نملة لانغتون
# Langton's ant
# Demonstrates: نملة، اتجاهات دوارة، طريق سريع
#
# Run:  python apl.py examples/682-langton-ant.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# نملة لانغتون: فوضى ثم طريق سريع
# Demonstrates: آلة خلوية متحركة, اتجاهات دوارة, شبكة قابلة للالتفاف ممنوع
# الاتجاهات: 0=أعلى 1=يمين 2=أسفل 3=يسار

دالة محاكاة(خطوات, مقاس):
  شبكة = []
  لكل ي في نطاق(مقاس):
    صف = []
    لكل ج في نطاق(مقاس):
      صف.append(0)
    شبكة.append(صف)
  ص = مقاس // 2
  ع = مقاس // 2
  اتجاه = 0
  دص = [-1, 0, 1, 0]
  دع = [0, 1, 0, -1]
  لكل خ في نطاق(خطوات):
    لو شبكة[ص][ع] == 0:
      اتجاه = (اتجاه + 1) % 4
      شبكة[ص][ع] = 1
    والا:
      اتجاه = (اتجاه + 3) % 4
      شبكة[ص][ع] = 0
    ص = ص + دص[اتجاه]
    ع = ع + دع[اتجاه]
  سوداء = 0
  لكل ص2 في نطاق(مقاس):
    لكل ع2 في نطاق(مقاس):
      سوداء = سوداء + شبكة[ص2][ع2]
  ارجع [سوداء, ص, ع, اتجاه]

ن4 = محاكاة(4, 21)
تأكد_يساوي(ن4[0], 4, "بعد 4 خطوات أربع خلايا سوداء")
ن10 = محاكاة(10, 21)
تأكد_يساوي(ن10[0], 6, "بعد 10 خطوات ست خلايا سوداء")
ن100 = محاكاة(100, 21)
تأكد_يساوي(ن100[0], 20, "بعد 100 خطوة 20 خلية سوداء")
ن11000 = محاكاة(11000, 101)
اطبع "سوداء بعد 11000:", ن11000[0]
تأكد_يساوي(ن11000[0] > 700 و ن11000[0] < 900, صواب, "الطريق السريع شكل نمطا كثيفا")
