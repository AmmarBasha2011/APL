# مثال 775 — بحث ضبابي
# Fuzzy search
# Demonstrates: مطابقة تتبعية، تسجيل نقاط
#
# Run:  python apl.py examples/775-fuzzy-search.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# بحث ضبابي بأسلوب fzf: مطابقة تتبعية مع تسجيل نقاط
# Demonstrates: مطابقة subsequence, مكافأة التتالي وبدايات الكلمات, خصم الفجوات

دالة درجة_ضبابي(استعلام, مرشح):
  س = 0
  درجة = 0
  سابق = 0 - 2
  لكل ي في نطاق(طول(مرشح)):
    لو س < طول(استعلام) و مرشح[ي] == استعلام[س]:
      درجة = درجة + 10
      لو ي == سابق + 1:
        درجة = درجة + 6
      لو ي == 0 أو مرشح[ي - 1] == "_" أو مرشح[ي - 1] == "-" أو مرشح[ي - 1] == " " أو مرشح[ي - 1] == "/":
        درجة = درجة + 8
      درجة = درجة - (ي - سابق - 1)
      سابق = ي
      س = س + 1
  لو س == طول(استعلام):
    ارجع درجة
  ارجع 0 - 1

تأكد_يساوي(درجة_ضبابي("fb", "fb"), 33, "تطابق تام")
تأكد_يساوي(درجة_ضبابي("fb", "foo_bar"), 32, "بداية كلمة")
تأكد_يساوي(درجة_ضبابي("fb", "fubar"), 26, "فجوة")
تأكد_يساوي(درجة_ضبابي("fb", "bar_foo"), 0 - 1, "لا مطابقة")

مرشحون = ["foo_bar", "fb", "fubar", "bar_foo"]
درجات = []
لكل م في مرشحون:
  درجات.append(درجة_ضبابي("fb", م))
لكل ي في نطاق(طول(مرشحون)):
  اقصى = ي
  لكل ج في نطاق(ي + 1, طول(مرشحون)):
    لو درجات[ج] > درجات[اقصى]:
      اقصى = ج
  مؤقت1 = درجات[ي]
  درجات[ي] = درجات[اقصى]
  درجات[اقصى] = مؤقت1
  مؤقت2 = مرشحون[ي]
  مرشحون[ي] = مرشحون[اقصى]
  مرشحون[اقصى] = مؤقت2
تأكد_يساوي(مرشحون[0], "fb", "الأفضل أولاً")
تأكد_يساوي(مرشحون[1], "foo_bar", "الثاني")
تأكد_يساوي(مرشحون[2], "fubar", "الثالث")
تأكد_يساوي(مرشحون[3], "bar_foo", "الأخير")
