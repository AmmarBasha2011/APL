# مثال 3509 — مجموع قوى 40
# Sum of powers of 40
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3509-sum-of-powers-of-40-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 40 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 41, "حالة 2")
تأكد_يساوي(ف(3), 65641, "حالة 3")
تأكد_يساوي(ف(6), 4201025641, "حالة 4")
تأكد_يساوي(ف(10), 10754625641025641, "حالة 5")
