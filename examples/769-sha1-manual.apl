# مثال 769 — SHA-1 يدوي
# SHA-1 from spec
# Demonstrates: حشوة، 80 دورة، دوران 32-بت
#
# Run:  python apl.py examples/769-sha1-manual.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# SHA-1 من المواصفة: حشوة، 80 دورة، خمس كلمات حالة
# Demonstrates: دوران 32-بت, جدولة مفاتيح موسعة, حشوة ميركل-دامغارد

قوى2 = [1]
لكل ي في نطاق(65):
  قوى2.append(قوى2[طول(قوى2) - 1] * 2)

دالة دوّر(س, ر):
  ارجع ((س * قوى2[ر]) + (س // قوى2[32 - ر])) % قوى2[32]

دالة شا1(رسالة):
  م32 = قوى2[32]
  بايتات = []
  لكل حرف في رسالة:
    بايتات.append(ترميز_حرف(حرف))
  طول_بت = طول(بايتات) * 8
  بايتات.append(128)
  طالما طول(بايتات) % 64 != 56:
    بايتات.append(0)
  لكل ي في نطاق(8):
    بايتات.append((طول_بت // قوى2[8 * (7 - ي)]) % 256)
  ه0 = 1732584193
  ه1 = 4023233417
  ه2 = 2562383102
  ه3 = 271733878
  ه4 = 3285377520
  لكل كتلة في نطاق(طول(بايتات) // 64):
    ش = []
    لكل ت في نطاق(16):
      ع = كتلة * 64 + ت * 4
      ش.append(بايتات[ع] * 16777216 + بايتات[ع + 1] * 65536 + بايتات[ع + 2] * 256 + بايتات[ع + 3])
    لكل ت في نطاق(16, 80):
      ش.append(دوّر(((ش[ت - 3] ^ ش[ت - 8]) ^ ش[ت - 14]) ^ ش[ت - 16], 1))
    أ = ه0
    ب = ه1
    ج = ه2
    د = ه3
    هـ = ه4
    لكل ت في نطاق(80):
      لو ت < 20:
        ف = (ب & ج) | ((م32 - 1 - ب) & د)
        ك = 1518500249
      والا_لو ت < 40:
        ف = (ب ^ ج) ^ د
        ك = 1859775393
      والا_لو ت < 60:
        ف = ((ب & ج) | (ب & د)) | (ج & د)
        ك = 2400959708
      والا:
        ف = (ب ^ ج) ^ د
        ك = 3395469782
      مؤقت = ((((دوّر(أ, 5) + ف) % م32 + هـ) % م32 + ك) % م32 + ش[ت]) % م32
      هـ = د
      د = ج
      ج = دوّر(ب, 30)
      ب = أ
      أ = مؤقت
    ه0 = (ه0 + أ) % م32
    ه1 = (ه1 + ب) % م32
    ه2 = (ه2 + ج) % م32
    ه3 = (ه3 + د) % م32
    ه4 = (ه4 + هـ) % م32
  سداسي = "0123456789abcdef"
  ناتج = ""
  لكل كلمة في [ه0, ه1, ه2, ه3, ه4]:
    لكل ي في نطاق(8):
      ناتج = ناتج + سداسي[(كلمة // قوى2[4 * (7 - ي)]) % 16]
  ارجع ناتج

تأكد_يساوي(شا1(""), "da39a3ee5e6b4b0d3255bfef95601890afd80709", "sha1 فارغ")
تأكد_يساوي(شا1("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 abc")
تأكد_يساوي(شا1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "84983e441c3bd26ebaae4aa1f95129e5e54670f1", "sha1 رسالة طويلة")
تأكد_يساوي(شا1("The quick brown fox jumps over the lazy dog"), "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12", "sha1 الثعلب")
