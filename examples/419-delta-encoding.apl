# مثال 419 — ترميز الفروقات
# Delta encoding
# Demonstrates: ضغط وفك تسلسل
#
# Run:  python apl.py examples/419-delta-encoding.apl

دالة فرق_ترميز(قائمة):
    المتغير ناتج = [قائمة[0]]
    لكل ي في نطاق(1, طول(قائمة)):
        ناتج.append(قائمة[ي] - قائمة[ي - 1])
    ارجع ناتج

دالة فرق_فك(مشفر):
    المتغير ناتج = [مشفر[0]]
    لكل ي في نطاق(1, طول(مشفر)):
        ناتج.append(ناتج[ي - 1] + مشفر[ي])
    ارجع ناتج

المتغير أسعار = [100, 105, 103, 110, 108, 115]
المتغير مشفر = فرق_ترميز(أسعار)
اطبع "مشفر:", مشفر
اطبع "مفكوك:", فرق_فك(مشفر)
