# مثال 2674 — السعر مع ضريبة 2 بالمئة
# Price with 2 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2674-price-with-2-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 2 // 100

تأكد_يساوي(ف(100), 102, "حالة 1")
تأكد_يساوي(ف(250), 255, "حالة 2")
تأكد_يساوي(ف(999), 1018, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
