# مثال 2174 — العدد المستطيل
# Pronic number
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2174-pronic-number-product-of-consecutive.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * (ن + 1)

تأكد_يساوي(ف(0), 0, "حالة 0")
تأكد_يساوي(ف(3), 12, "حالة 3")
تأكد_يساوي(ف(7), 56, "حالة 7")
تأكد_يساوي(ف(12), 156, "حالة 12")
