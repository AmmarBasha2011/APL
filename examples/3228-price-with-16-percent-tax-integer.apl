# مثال 3228 — السعر مع ضريبة 16 بالمئة
# Price with 16 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3228-price-with-16-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 16 // 100

تأكد_يساوي(ف(100), 116, "حالة 1")
تأكد_يساوي(ف(250), 290, "حالة 2")
تأكد_يساوي(ف(999), 1158, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
