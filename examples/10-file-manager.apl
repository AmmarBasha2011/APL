# مثال 10 — مدير الملفات والمجلدات
# File & Directory Manager
# Demonstrates: pathlib, shutil, os library, recursive directory listing
#
# Run:  python apl.py examples/10-file-manager.apl

دالة ملف(المجلد, الاسم):
    ارجع مسار_جديد(المجلد).ادمج(الاسم)

المتغير المجلد = "_apl_demo_files"
أنشئ_مجلد_مسار(مسار_جديد(المجلد), آباء=صواب, موجود_سلفا=صواب)

اطبع "=== مدير الملفات ==="
اطبع ""

# إنشاء ملفات تجريبية
المتغير الأسماء = ["تقرير.txt", "بيانات.csv", "ملاحظات.md", "سجل.log"]
لكل اسم في الأسماء:
    مسار_اكتب(ملف(المجلد, اسم), "محتوى تجريبي للملف " + اسم)

اطبع "--- الملفات المنشأة ---"
لكل عنصر في مسار_محتويات(مسار_جديد(المجلد)):
    اطبع "  " + عنصر.مسار_اسم + "  (" + نص(طول(مسار_اقرأ(عنصر))) + " حرف)"

اطبع ""
اطبع "--- النسخ الاحتياطي ---"
أنشئ_مجلد_مسار(مسار_جديد(المجلد).ادمج("_نسخة"), آباء=صواب, موجود_سلفا=صواب)
انسخ_شجرة(ملف(المجلد, "_نسخة"), ملف(المجلد, "_backup"))
اطبع "تم النسخ: " + نص(مسار_موجود(ملف(المجلد, "_backup")))

اطبع ""
اطبع "--- البحث عن ملفات .txt ---"
لكل مطابق في مسار_ابحث(مسار_جديد(المجلد), "*.txt"):
    اطبع "  وجد: " + مطابق.مسار_اسم

اطبع ""
اطبع "--- التنظيف ---"
لكل عنصر في مسار_محتويات(مسار_جديد(ملف(المجلد, "_نسخة"))):
    مسار_احذف(عنصر)
احذف_شجرة(ملف(المجلد, "_نسخة"))
اطبع "ملفات في المجلد الأصلي: " + نص(طول(قائمة_ملفات(المجلد)))

احذف_شجرة(المجلد)
اطبع "تم حذف المجلد التجريبي: " + نص(مسار_موجود(المجلد) == خطأ)
