# مثال 222 — شيفرة فيجنير
# Vigenere cipher
# Demonstrates: مفتاح متكرر، إزاحات متغيرة
#
# Run:  python apl.py examples/222-vigenere.apl

دالة فيجنير(نص_الدخل, مفتاح, فك):
    المتغير نتيجة = ""
    المتغير ي = 0
    لكل حرف في نص_الدخل:
        لو حرف >= "a" و حرف <= "z":
            المتغير إزاحة = ترميز_حرف(مفتاح[ي % طول(مفتاح)]) - 97
            لو فك:
                إزاحة = 26 - إزاحة
            نتيجة = نتيجة + فك_ترميز_حرف((ترميز_حرف(حرف) - 97 + إزاحة) % 26 + 97)
            ي = ي + 1
        الا:
            نتيجة = نتيجة + حرف
    ارجع نتيجة

المتغير رسالة = "attack at dawn"
المتغير مشفرة = فيجنير(رسالة, "lemon", خطأ)
اطبع "الأصل:", رسالة
اطبع "المشفرة:", مشفرة
اطبع "المفكوكة:", فيجنير(مشفرة, "lemon", صواب)
