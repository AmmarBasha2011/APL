# مثال 2817 — تقسيم الفاتورة على 8
# Split bill among 8
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2817-split-bill-among-8-people-ceiling.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن + 8 - 1) // 8

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(10), 2, "حالة 2")
تأكد_يساوي(ف(100), 13, "حالة 3")
تأكد_يساوي(ف(101), 13, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
