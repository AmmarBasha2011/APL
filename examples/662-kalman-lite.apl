# مثال 662 — مرشح كالمان الأحادي
# 1D Kalman filter
# Demonstrates: كالمان، ربح، عدم يقين
#
# Run:  python apl.py examples/662-kalman-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# مرشح كالمان الأحادي
# Demonstrates: تنبؤ وتحديث, ربح كالمان, تناقص عدم اليقين
# يدمج قياسات مزعجة في تقدير أهدأ

تقدير = 0.0
يقين = 1.0
ضجيج_عملية = 0.01
ضجيج_قياس = 0.5

دالة خطوة(تقدير, يقين, قياس):
  يقين_متنبأ = يقين + ضجيج_عملية
  ربح = يقين_متنبأ / (يقين_متنبأ + ضجيج_قياس)
  تقدير_جديد = تقدير + ربح * (قياس - تقدير)
  يقين_جديد = (1.0 - ربح) * يقين_متنبأ
  ارجع [تقدير_جديد, يقين_جديد]

قياسات = [19.5, 20.4, 19.8, 20.2, 19.9, 20.1, 20.3, 19.7, 20.0, 20.2]
حالة = [تقدير, يقين]
لكل ق في قياسات:
  حالة = خطوة(حالة[0], حالة[1], ق)

تأكد_يساوي(حالة[0] > 19.0 و حالة[0] < 20.5, صواب, "التقدير قرب الحقيقة")
تأكد_يساوي(حالة[1] < يقين, صواب, "عدم اليقين تناقص")
تأكد_يساوي(حالة[1] > 0.0, صواب, "عدم اليقين موجب")
حالة2 = [حالة[0], حالة[1]]
لكل ي في نطاق(5):
  حالة2 = خطوة(حالة2[0], حالة2[1], 20.0)
تأكد_يساوي(حالة2[0] > حالة[0] أو حالة[0] > 20.0, صواب, "يتجه نحو 20")
اطبع "تقدير نهائي:", حالة[0]
اطبع "يقين نهائي:", حالة[1]
