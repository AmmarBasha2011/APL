# مثال 3358 — مجموع الأعداد من 22 إلى ن
# Sum from 22 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3358-sum-of-integers-from-22-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(22, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(22), 22, "حالة 1")
تأكد_يساوي(ف(23), 45, "حالة 2")
تأكد_يساوي(ف(32), 297, "حالة 3")
تأكد_يساوي(ف(100), 4819, "حالة 4")
