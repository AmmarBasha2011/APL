# مثال 542 — ترميز هافمان
# Huffman coding
# Demonstrates: ضغط، أكواد متغيرة الطول، شجرة هافمان
#
# Run:  python apl.py examples/542-huffman-coding.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# ترميز هافمان: شجرة أكواد متغيرة الطول
المتغير نص = "abaabcaaaa"
المتغير تكرار = قاموس()
لكل حرف في نص:
    لو حرف في تكرار:
        تكرار[حرف] = تكرار[حرف] + 1
    الا:
        تكرار[حرف] = 1

المتغير أكواد = قاموس()
لكل حرف في تكرار:
    أكواد[حرف] = ""

طالما طول(تكرار) > 1:
    المتغير مفاتيح = مفرز(قائمة(تكرار))
    مفاتيح = مفرز(مفاتيح)
    المتغير أ1 = ""
    المتغير أ2 = ""
    المتغير ق1 = 999999
    المتغير ق2 = 999999
    لكل مفتاح في مفاتيح:
        لو تكرار[مفتاح] < ق1:
            أ2 = أ1
            ق2 = ق1
            أ1 = مفتاح
            ق1 = تكرار[مفتاح]
        الا لو تكرار[مفتاح] < ق2:
            أ2 = مفتاح
            ق2 = تكرار[مفتاح]
    لكل حرف في أ1:
        أكواد[حرف] = "0" + أكواد[حرف]
    لكل حرف في أ2:
        أكواد[حرف] = "1" + أكواد[حرف]
    المتغير جديد = قاموس()
    جديد[أ1 + أ2] = ق1 + ق2
    لكل مفتاح في تكرار:
        لو مفتاح != أ1 و مفتاح != أ2:
            جديد[مفتاح] = تكرار[مفتاح]
    تكرار = جديد

اطبع "الأكواد:", أكواد
المتغير مرمز = ""
لكل حرف في نص:
    مرمز = مرمز + أكواد[حرف]
اطبع "المرمز:", مرمز
اطبع "الطول:", طول(مرمز), "بت بدلاً من", طول(نص) * 8
تأكد_يساوي(طول(أكواد["a"]), 1, "الأكثر تكراراً أقصر كود")
تأكد_يساوي(طول(مرمز), 13, "طول الترميز")
