# مثال 1145 — ترتيب متذبذب
# Wiggle sort
# Demonstrates: مسح واحد
#
# Run:  python apl.py examples/1145-wiggle-sort.apl

# نتأكد في كل موضع من اتجاه المقارنة
# ونبدل الجارين لو خالفا الاتجاه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تذبذب(أ):
  ق = قائمة(أ)
  لكل ع في نطاق(1, طول(ق)):
    لو ع % 2 == 1:
      لو ق[ع] < ق[ع - 1]:
        ت = ق[ع]
        ق[ع] = ق[ع - 1]
        ق[ع - 1] = ت
    والا:
      لو ق[ع] > ق[ع - 1]:
        ت = ق[ع]
        ق[ع] = ق[ع - 1]
        ق[ع - 1] = ت
  ارجع ق

دالة متذبذبة(ق):
  لكل ع في نطاق(1, طول(ق)):
    لو ع % 2 == 1:
      لو ق[ع] < ق[ع - 1]:
        ارجع خطأ
    والا:
      لو ق[ع] > ق[ع - 1]:
        ارجع خطأ
  ارجع صواب

لكل عينة في [[3,5,2,1,6,4], [1,2,3,4,5], [5,4,3,2,1], [1,1,1]]:
  تأكد_يساوي(متذبذبة(تذبذب(عينة)), صواب, "عينة " + نص(عينة))
تأكد_يساوي(تذبذب([1,2]), [1,2], "اثنان")
