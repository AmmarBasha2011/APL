# مثال 4352 — السعر بعد خصم 47 بالمئة
# Price after 47 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4352-price-after-47-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 47 // 100

تأكد_يساوي(ف(100), 53, "حالة 1")
تأكد_يساوي(ف(250), 133, "حالة 2")
تأكد_يساوي(ف(999), 530, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
