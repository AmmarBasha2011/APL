# مثال 762 — تجميع UPGMA
# UPGMA clustering
# Demonstrates: أقرب زوج، متوسط مجموعات، ارتفاع
#
# Run:  python apl.py examples/762-upgma-tree.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تجميع UPGMA: بناء شجرة تطور من مصفوفة مسافات
# Demonstrates: أقرب زوج, مسافة متوسط المجموعات, ارتفاعات الدمج
# الارتفاع = نصف المسافة، والدمج يعيد حساب المسافات بالمتوسط

مسافات = {
  "A,B": 2.0, "A,C": 4.0, "A,D": 6.0,
  "B,C": 4.0, "B,D": 6.0, "C,D": 5.0
}

دالة مسافة(أ, ب):
  مفتاح = أ + "," + ب
  لو مفتاح في مسافات:
    ارجع مسافات[مفتاح]
  ارجع مسافات[ب + "," + أ]

دالة مسافة_مجموعتين(ع1, ع2):
  مجموع = 0.0
  عدد = 0
  لكل أ في ع1:
    لكل ب في ع2:
      مجموع = مجموع + مسافة(أ, ب)
      عدد = عدد + 1
  ارجع مجموع / عدد

دالة ابن_شجرة(أصناف):
  مجموعات = []
  لكل صنف في أصناف:
    مجموعات.append([صنف])
  دمج = []
  طالما طول(مجموعات) > 1:
    أدنى = 1000000.0
    أفضل_أ = 0
    أفضل_ب = 1
    لكل ي في نطاق(طول(مجموعات)):
      لكل ج في نطاق(ي + 1, طول(مجموعات)):
        د = مسافة_مجموعتين(مجموعات[ي], مجموعات[ج])
        لو د < أدنى:
          أدنى = د
          أفضل_أ = ي
          أفضل_ب = ج
    دمج.append([مجموعات[أفضل_أ] + مجموعات[أفضل_ب], مقرب(أدنى / 2, 2)])
    جديدة = مجموعات[أفضل_أ] + مجموعات[أفضل_ب]
    باقية = []
    لكل ي في نطاق(طول(مجموعات)):
      لو ي != أفضل_أ و ي != أفضل_ب:
        باقية.append(مجموعات[ي])
    باقية.append(جديدة)
    مجموعات = باقية
  ارجع دمج

دالة نص_مجموعة(ع):
  ناتج = ع[0]
  لكل ي في نطاق(1, طول(ع)):
    ناتج = ناتج + ع[ي]
  ارجع ناتج

دمج = ابن_شجرة(["A", "B", "C", "D"])

تأكد_يساوي(طول(دمج), 3, "ثلاث خطوات دمج")
تأكد_يساوي(دمج[0][1], 1.0, "أول ارتفاع")
تأكد_يساوي(دمج[1][1], 2.0, "ثاني ارتفاع")
تأكد_يساوي(دمج[2][1], 2.83, "الجذر")
تأكد_يساوي(نص_مجموعة(دمج[0][0]), "AB", "A وB الأقرب")
تأكد_يساوي(نص_مجموعة(دمج[1][0]), "CAB", "انضمام C")
تأكد_يساوي(نص_مجموعة(دمج[2][0]), "DCAB", "انضمام D أخيراً")

اطبع "الدمج الأول:", نص_مجموعة(دمج[0][0]), "عند", دمج[0][1]
