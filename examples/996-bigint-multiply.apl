# مثال 996 — ضرب الأعداد الضخمة
# Big integer multiplication
# Demonstrates: أرقام بمصفوفة وحمل
#
# Run:  python apl.py examples/996-bigint-multiply.apl

# ضرب الأعداد الضخمة: أرقام بأطوال تتجاوز نطاق الصحيح المدمج
# خوارزمية المدرسة على مصفوفتي أرقام مع الحمل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة أرقام(سلسلة):
  ناتج = []
  لكل i في نطاق(طول(سلسلة) - 1, -1, -1):
    ناتج.ألحق(صحيح(سلسلة[i]))
  ارجع ناتج

دالة اضرب(سلسلة1, سلسلة2):
  أ = أرقام(سلسلة1)
  ب = أرقام(سلسلة2)
  ناتج = []
  لكل _ في نطاق(طول(أ) + طول(ب)):
    ناتج.ألحق(0)
  لكل i في نطاق(طول(أ)):
    حمل = 0
    لكل j في نطاق(طول(ب)):
      مجموع = (ناتج[i + j] + (أ[i] * ب[j])) + حمل
      ناتج[i + j] = مجموع % 10
      حمل = مجموع // 10
    ناتج[i + طول(ب)] = ناتج[i + طول(ب)] + حمل
  أعلى = طول(ناتج) - 1
  طالما (أعلى > 0) و (ناتج[أعلى] == 0):
    أعلى = أعلى - 1
  سلسلة = ""
  لكل i في نطاق(أعلى, -1, -1):
    سلسلة = سلسلة + نص(ناتج[i])
  ارجع سلسلة

تأكد_يساوي(اضرب("123456789", "987654321"), "121932631112635269", "ضرب كبير")
تأكد_يساوي(اضرب("999", "999"), "998001", "مربع كبير")
تأكد_يساوي(اضرب("12", "3"), "36", "حالة صغيرة")
