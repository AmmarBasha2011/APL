# مثال 2248 — العنصر الأغلبي
# Majority element
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2248-list-majority-element-over-half.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لكل ع في ق:
    لو ق.count(ع) * 2 > طول(ق):
      ارجع ع
  ارجع -1

تأكد_يساوي(ف([1, 1, 2]), 1, "حالة 1")
تأكد_يساوي(ف([1, 2, 3]), -1, "حالة 2")
تأكد_يساوي(ف([4, 4, 4, 1]), 4, "حالة 3")
تأكد_يساوي(ف([7]), 7, "حالة 4")
