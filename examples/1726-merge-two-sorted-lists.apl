# مثال 1726 — دمج قائمتين مرتبتين
# Merge two sorted lists
# Demonstrates: فرز
#
# Run:  python apl.py examples/1726-merge-two-sorted-lists.apl

# مؤشر لكل قائمة
# نضيف الباقي في النهاية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ادمج(أ, ب):
  ي = 0
  ك = 0
  ناتج = []
  طالما ي < طول(أ) و ك < طول(ب):
    لو أ[ي] <= ب[ك]:
      ناتج.append(أ[ي])
      ي = ي + 1
    والا:
      ناتج.append(ب[ك])
      ك = ك + 1
  طالما ي < طول(أ):
    ناتج.append(أ[ي])
    ي = ي + 1
  طالما ك < طول(ب):
    ناتج.append(ب[ك])
    ك = ك + 1
  ارجع ناتج

تأكد_يساوي(ادمج([1, 3, 5], [2, 4, 6]), [1, 2, 3, 4, 5, 6], "متداخلة")
تأكد_يساوي(ادمج([], [1]), [1], "فارغة")
تأكد_يساوي(ادمج([1, 1], [1]), [1, 1, 1], "متساوية")
