# مثال 1190 — ذاكرة الأقل استخداماً
# LFU cache
# Demonstrates: عدّاد تكرار
#
# Run:  python apl.py examples/1190-lfu-cache.apl

# نعد استخدام كل مفتاح
# وعند الامتلاء نطرد الأقل عدداً والأقدم عند التعادل

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف ذاكرة_تكرار:
  دالة_إنشاء(ذات, سعة):
    ذات.سعة = سعة
    ذات.قيم = {}
    ذات.عدادات = {}
    ذات.اخر = {}
    ذات.ساعة = 0

  دالة قرأ(ذات, م):
    لو م ليس في ذات.قيم:
      ارجع -1
    ذات.ساعة = ذات.ساعة + 1
    ذات.عدادات[م] = ذات.عدادات[م] + 1
    ذات.اخر[م] = ذات.ساعة
    ارجع ذات.قيم[م]

  دالة ضع(ذات, م, ق):
    لو ذات.سعة == 0:
      ارجع 0
    ذات.ساعة = ذات.ساعة + 1
    لو م في ذات.قيم:
      ذات.قيم[م] = ق
      ذات.عدادات[م] = ذات.عدادات[م] + 1
      ذات.اخر[م] = ذات.ساعة
      ارجع 0
    لو طول(ذات.قيم) >= ذات.سعة:
      ضحية = ""
      افضل = []
      لكل ك في ذات.قيم:
        مرشح = [ذات.عدادات[ك], ذات.اخر[ك], ك]
        لو (طول(افضل) == 0) أو (مرشح < افضل):
          افضل = مرشح
      ضحية = افضل[2]
      ذات.قيم.pop(ضحية)
      ذات.عدادات.pop(ضحية)
      ذات.اخر.pop(ضحية)
    ذات.قيم[م] = ق
    ذات.عدادات[م] = 1
    ذات.اخر[م] = ذات.ساعة
    ارجع 0

ذ = ذاكرة_تكرار(2)
ذ.ضع(1, 1)
ذ.ضع(2, 2)
تأكد_يساوي(ذ.قرأ(1), 1, "قراءة")
ذ.ضع(3, 3)
تأكد_يساوي(ذ.قرأ(2), -1, "طُرد الأقل")
تأكد_يساوي(ذ.قرأ(3), 3, "موجود")
ذ.ضع(4, 4)
تأكد_يساوي(ذ.قرأ(1), -1, "طُرد الأقدم")
تأكد_يساوي(ذ.قرأ(3), 3, "ثلاثة باقٍ")
تأكد_يساوي(ذ.قرأ(4), 4, "أربعة")
