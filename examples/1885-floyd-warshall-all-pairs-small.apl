# مثال 1885 — أقصر المسافات بين كل الأزواج
# Floyd Warshall all pairs
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1885-floyd-warshall-all-pairs-small.apl

# مصفوفة المسافات المبدئية
# نحدثها بكل وسيط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فلويد(م):
  ن = طول(م)
  د = []
  لكل ص في م:
    د.append(ص + [])
  لكل و_ك في نطاق(ن):
    لكل ي في نطاق(ن):
      لكل ج في نطاق(ن):
        لو د[ي][و_ك] + د[و_ك][ج] < د[ي][ج]:
          د[ي][ج] = د[ي][و_ك] + د[و_ك][ج]
  ارجع د

ك = 1000
م = [[0, 3, ك], [ك, 0, 1], [2, ك, 0]]
ن = فلويد(م)
تأكد_يساوي(ن[0][2], 4, "عبر عقدة")
تأكد_يساوي(ن[1][0], 3, "دورة")
تأكد_يساوي(ن[2][1], 5, "طويل")
