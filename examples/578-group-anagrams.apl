# مثال 578 — تجميع المتناقضات
# Group anagrams
# Demonstrates: أناجرام، تجميع، مفاتيح مرتبة
#
# Run:  python apl.py examples/578-group-anagrams.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تجميع المتشابهات الأبجدية بمفتاح الفرز
دالة جمّع(كلمات):
    المتغير مجموعات = قاموس()
    لكل كلمة في كلمات:
        المتغير مفتاح = "".ضم(مفرز(قائمة(كلمة)))
        لو مفتاح في مجموعات:
            مجموعات[مفتاح].أضف(كلمة)
        الا:
            مجموعات[مفتاح] = [كلمة]
    المتغير نتيجة = قائمة()
    لكل مفتاح في مجموعات:
        نتيجة.أضف(مفرز(مجموعات[مفتاح]))
    ارجع مفرز(نتيجة)

تأكد_يساوي(جمّع(["eat", "tea", "tan", "ate", "nat", "bat"]), [["ate", "eat", "tea"], ["bat"], ["nat", "tan"]], "ثلاث مجموعات")
تأكد_يساوي(جمّع(["a"]), [["a"]], "كلمة واحدة")
