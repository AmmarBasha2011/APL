# مثال 441 — المسافة بين نقطتين
# Point distance
# Demonstrates: إقليدية ومانهاتن
#
# Run:  python apl.py examples/441-point-distance.apl

دالة إقليدية(س1, ص1, س2, ص2):
    ارجع جذر((س2 - س1) * (س2 - س1) + (ص2 - ص1) * (ص2 - ص1))

دالة مانهاتن(س1, ص1, س2, ص2):
    ارجع مطلق(س2 - س1) + مطلق(ص2 - ص1)

اطبع "إقليدية:", إقليدية(0, 0, 3, 4)
اطبع "مانهاتن:", مانهاتن(0, 0, 3, 4)
