# مثال 3638 — عدد ظهور الرقم 6 حتى ن
# Occurrences of digit 6 up to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3638-count-digit-6-occurrences-up-to-n-v6.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في نطاق(1, ن + 1):
    ع = ع + نص(ي).count("6")
  ارجع ع

تأكد_يساوي(ف(9), 1, "حالة 1")
تأكد_يساوي(ف(10), 1, "حالة 2")
تأكد_يساوي(ف(50), 5, "حالة 3")
تأكد_يساوي(ف(100), 20, "حالة 4")
تأكد_يساوي(ف(200), 40, "حالة 5")
