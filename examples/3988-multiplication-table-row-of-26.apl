# مثال 3988 — صف جدول ضرب 26
# Multiplication row of 26
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3988-multiplication-table-row-of-26.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 26]
  ارجع ر

تأكد_يساوي(ف(1), [26], "حالة 1")
تأكد_يساوي(ف(5), [26, 52, 78, 104, 130], "حالة 2")
تأكد_يساوي(ف(10), [26, 52, 78, 104, 130, 156, 182, 208, 234, 260], "حالة 3")
