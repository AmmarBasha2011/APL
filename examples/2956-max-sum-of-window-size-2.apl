# مثال 2956 — أكبر مجموع لنافذة بحجم 2
# Max window sum size 2
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2956-max-sum-of-window-size-2.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ك = sum(ق[:2])
  لكل ي في نطاق(طول(ق) - 2 + 1):
    م = sum(ق[ي:ي + 2])
    لو م > ك:
      ك = م
  ارجع ك

تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 11, "حالة 1")
تأكد_يساوي(ف([5, 1, 5, 1, 5, 1, 9]), 10, "حالة 2")
تأكد_يساوي(ف([3, 3, 3, 3]), 6, "حالة 3")
تأكد_يساوي(ف([-1, 2, -3, 4, 5, 6]), 11, "حالة 4")
