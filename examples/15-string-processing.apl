# مثال 15 — معالجة النصوص
# String Processing
# Demonstrates: textwrap, string methods, slicing, re library
#
# Run:  python apl.py examples/15-string-processing.apl

المتغير الجملة = "لغة APL هي لغة برمجة عربية كاملة تحوّل الكود المكتوب بالعربي إلى كود بايثون جاهز للتنفيذ مباشرة"

اطبع "=== معالجة النصوص ==="
اطبع ""
اطبع "أول 40 حرف: " + الجملة[0:40] + "..."
اطبع "الطول: " + نص(طول(الجملة))
اطبع "عدد الكلمات: " + نص(طول(تقسيم(الجملة, " ")))
اطبع ""
اطبع "--- البحث ---"
اطبع "هل يحتوي 'بايثون'؟ " + نص(بحث_نمطي("بايثون", الجملة) != لا_شيء)
اطبع "عدد حرف 'ا': " + نص(طول(بحث_شامل("ا", الجملة)))
اطبع ""
اطبع "--- التحويل ---"
اطبع "أحرف كبيرة: " + علوي(الجملة[0:20])
اطبع "أحرف صغيرة: " + سفلي(الجملة[0:20])
اطبع "بعد استبدال: " + الجملة.استبدال("APL", "APL_lang")
اطبع ""
اطبع "--- لفّ النص ---"
اطبع الالتفاف_نص(الجملة, 40)
اطبع ""
اطبع "--- مسافة بادئة ---"
اطبع إزاحة_نص(الالتفاف_نص(الجملة, 30), "    ")
