# مثال 55 — الضغط: gzip و bz2 و lzma و TAR
# Compression head-to-head: gzip vs bz2 vs xz, plus TAR archives
# Demonstrates: ضغط_نص, فك_ضغط_نص, ضغط_قوي, فك_ضغط_قوي, ضغط_فائق,
#               فك_ضغط_فائق, نسبة_الضغط, حجم_بشري, اكتب_مضغوط, اقرأ_مضغوط,
#               اكتب_bz2, اقرأ_bz2, اكتب_xz, اقرأ_xz,
#               أنشئ_طر, أسماء_الطر, أعضاء_الطر, نص_من_الطر, استخرج_طر
#
# Run:  python apl.py examples/55-archive-compress.apl

المتغير المجلد = "_apl_ضغط_تجربة"
انشئ_مجلدات(المجلد)

# ---------- 1) نص كبير قابل للضغط ----------
المتغير سطور = []
لكل رقم في نطاق(1, 301):
    سطور.أضف("السطر " + نص(رقم) + " — بيانات متكررة لقياس نسبة الضغط\n")
المتغير النص_الأصلي = "".ضم(سطور)

اطبع "=== 1) النص الأصلي ==="
اطبع "الحجم: " + حجم_بشري(طول(النص_الأصلي))
اطبع ""

# ---------- 2) مقارنة الخوارزميات الثلاث ----------
اطبع "=== 2) مقارنة الضغط ==="
المتغير مضغوط_gz = ضغط_نص(النص_الأصلي)
المتغير مضغوط_bz2 = ضغط_قوي(النص_الأصلي)
المتغير مضغوط_xz = ضغط_فائق(النص_الأصلي)

اطبع "gzip : " + حجم_بشري(طول(مضغوط_gz)) + "  ←  " + نص(نسبة_الضغط(طول(النص_الأصلي), طول(مضغوط_gz))) + "%"
اطبع "bz2  : " + حجم_بشري(طول(مضغوط_bz2)) + "  ←  " + نص(نسبة_الضغط(طول(النص_الأصلي), طول(مضغوط_bz2))) + "%"
اطبع "xz   : " + حجم_بشري(طول(مضغوط_xz)) + "  ←  " + نص(نسبة_الضغط(طول(النص_الأصلي), طول(مضغوط_xz))) + "%"

# ---------- 3) الرجوع للنص الأصلي ----------
اطبع ""
اطبع "=== 3) فك الضغط ==="
اطبع "gzip سليم؟ " + نص(فك_ضغط_نص(مضغوط_gz) == النص_الأصلي)
اطبع "bz2  سليم؟ " + نص(فك_ضغط_قوي(مضغوط_bz2) == النص_الأصلي)
اطبع "xz   سليم؟ " + نص(فك_ضغط_فائق(مضغوط_xz) == النص_الأصلي)

# ---------- 4) مستوى الضغط ----------
اطبع ""
اطبع "=== 4) مستوى الضغط ==="
المتغير سريع = ضغط_نص(النص_الأصلي, درجة_الضغط = أسرع_ضغط)
المتغير أقصى = ضغط_نص(النص_الأصلي, درجة_الضغط = أقصى_ضغط)
اطبع "أسرع (1): " + حجم_بشري(طول(سريع))
اطبع "أقصى (9): " + حجم_بشري(طول(أقصى))

# ---------- 5) ملفات مضغوطة على القرص ----------
اطبع ""
اطبع "=== 5) ملفات مضغوطة ==="
اكتب_مضغوط(المجلد + "/تقرير.txt.gz", النص_الأصلي)
اكتب_bz2(المجلد + "/تقرير.txt.bz2", النص_الأصلي)
اكتب_xz(المجلد + "/تقرير.txt.xz", النص_الأصلي)

اطبع "gz  : " + حجم_بشري(حجم_الأرشيف(المجلد + "/تقرير.txt.gz")) + " | النوع: " + نوع_الأرشيف(المجلد + "/تقرير.txt.gz")
اطبع "bz2 : " + حجم_بشري(حجم_الأرشيف(المجلد + "/تقرير.txt.bz2"))
اطبع "xz  : " + حجم_بشري(حجم_الأرشيف(المجلد + "/تقرير.txt.xz"))
المتغير مقروء_gz = اقرأ_مضغوط(المجلد + "/تقرير.txt.gz")
اطبع "قراءة gz  أول 24 حرفاً: " + مقروء_gz[0:24]
المتغير مقروء_xz = اقرأ_xz(المجلد + "/تقرير.txt.xz")
اطبع "قراءة xz  أول 24 حرفاً: " + مقروء_xz[0:24]

# ---------- 6) ضغط ملف موجود كما هو ----------
اطبع ""
اطبع "=== 6) ضغط ملف كامل ==="
اكتب(المجلد + "/خام.txt", النص_الأصلي)
المتغير ملف_gz = ضغط_ملف(المجلد + "/خام.txt")
اطبع "أُنشئ: " + ملف_gz
اطبع "الحجم قبل: " + حجم_بشري(حجم_الأرشيف(المجلد + "/خام.txt"))
اطبع "الحجم بعد: " + حجم_بشري(حجم_الأرشيف(ملف_gz))

# ---------- 7) أرشيف TAR بثلاثة أوضاع ضغط ----------
اطبع ""
اطبع "=== 7) أرشيف TAR ==="
اكتب(المجلد + "/ملف1.txt", "محتوى الملف الأول\n")
اكتب(المجلد + "/ملف2.txt", "محتوى الملف الثاني\n")

أنشئ_طر(المجلد + "/نصوص.tar", [المجلد + "/ملف1.txt", المجلد + "/ملف2.txt"], طر_بدون_ضغط)
أنشئ_طر(المجلد + "/نصوص.tar.gz", [المجلد + "/ملف1.txt", المجلد + "/ملف2.txt"], طر_مع_gz)
أنشئ_طر(المجلد + "/نصوص.tar.bz2", [المجلد + "/ملف1.txt", المجلد + "/ملف2.txt"], طر_مع_bz2)
أنشئ_طر(المجلد + "/نصوص.tar.xz", [المجلد + "/ملف1.txt", المجلد + "/ملف2.txt"], طر_مع_xz)

اطبع "tar     : " + حجم_بشري(حجم_الأرشيف(المجلد + "/نصوص.tar"))
اطبع "tar.gz  : " + حجم_بشري(حجم_الأرشيف(المجلد + "/نصوص.tar.gz"))
اطبع "tar.bz2 : " + حجم_بشري(حجم_الأرشيف(المجلد + "/نصوص.tar.bz2"))
اطبع "tar.xz  : " + حجم_بشري(حجم_الأرشيف(المجلد + "/نصوص.tar.xz"))
اطبع "النوع المكتشف: " + نوع_الأرشيف(المجلد + "/نصوص.tar.gz")
اطبع "طر سليم؟ " + نص(افحص_طر(المجلد + "/نصوص.tar.gz"))

# ---------- 8) أعضاء TAR ----------
اطبع ""
اطبع "=== 8) داخل أرشيف TAR ==="
اطبع "الأسماء: " + نص(أسماء_الطر(المجلد + "/نصوص.tar.gz"))
المتغير الأعضاء = أعضاء_الطر(المجلد + "/نصوص.tar.gz")
لكل عضو في الأعضاء:
    اطبع "  " + عضو.اسم_الطر + " — " + حجم_بشري(عضو.حجم_الطر)
اطبع "نص العضو: " + نص_من_الطر(المجلد + "/نصوص.tar.gz", "ملف1.txt")

المستخرج = استخرج_طر(المجلد + "/نصوص.tar.gz", المجلد + "/طر_مستخرج")
اطبع "مستخرج: " + نص(المستخرج)

# ---------- 9) تنظيف ----------
احذف_شجرة(المجلد)
اطبع ""
اطبع "تم تنظيف ملفات التجربة."
