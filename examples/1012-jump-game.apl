# مثال 1012 — لعبة القفز
# Jump game
# Demonstrates: أبعد مدى بالجشع
#
# Run:  python apl.py examples/1012-jump-game.apl

# كل خانة تحدد أقصى قفزة منها
# نتتبع أبعد خانة يمكن بلوغها ونتوقف لو علقنا

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نصل(قفزات):
  ابعد = 0
  لكل ع في نطاق(طول(قفزات)):
    لو ع > ابعد:
      ارجع خطأ
    لو (ع + قفزات[ع]) > ابعد:
      ابعد = ع + قفزات[ع]
  ارجع صواب

تأكد_يساوي(نصل([2, 3, 1, 1, 4]), صواب, "نصل")
تأكد_يساوي(نصل([3, 2, 1, 0, 4]), خطأ, "نعلق عند الصفر")
تأكد_يساوي(نصل([0]), صواب, "خانة واحدة")
