# مثال 2038 — نص متماثل بحذف حرف واحد على الأكثر
# Palindrome with one deletion
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2038-palindrome-allow-one-deletion.apl

# # نمشي من الطرفين
# # ونجرب حذف اليسار أو اليمين مرة واحدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة متماثل(س, ي, ل):
  طالما ي < ل:
    لو س[ي] != س[ل]:
      ارجع خطأ
    ي = ي + 1
    ل = ل - 1
  ارجع صواب

دالة بحذف_واحد(س):
  ي = 0
  ل = طول(س) - 1
  طالما ي < ل:
    لو س[ي] != س[ل]:
      ارجع متماثل(س, ي + 1, ل) أو متماثل(س, ي, ل - 1)
    ي = ي + 1
    ل = ل - 1
  ارجع صواب

تأكد_يساوي(بحذف_واحد("aba"), صواب, "متماثل")
تأكد_يساوي(بحذف_واحد("abca"), صواب, "حذف حرف")
تأكد_يساوي(بحذف_واحد("abc"), خطأ, "لا يكفي")
تأكد_يساوي(بحذف_واحد(""), صواب, "فارغ")
