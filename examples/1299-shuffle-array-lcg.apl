# مثال 1299 — خلط قائمة
# Shuffle with linear congruential generator
# Demonstrates: مولد خطي
#
# Run:  python apl.py examples/1299-shuffle-array-lcg.apl

# مولد خطي يعطي أرقاماً ثابتة من نفس البذرة
# فيتكرر الخلط نفسه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مولد:
  دالة_إنشاء(ذات, بذرة):
    ذات.ح = بذرة

  دالة تالي(ذات):
    ذات.ح = (ذات.ح * 1103515245 + 12345) % 2147483648
    ارجع ذات.ح

دالة اخلط(أ, بذرة):
  ق = قائمة(أ)
  م = مولد(بذرة)
  لكل ع في نطاق(طول(ق) - 1, 0, -1):
    ج = م.تالي() % (ع + 1)
    ت = ق[ع]
    ق[ع] = ق[ج]
    ق[ج] = ت
  ارجع ق

اصل = [1, 2, 3, 4, 5, 6]
ا = اخلط(اصل, 42)
تأكد_يساوي(مفرز(ا), اصل, "نفس العناصر")
تأكد_يساوي(اخلط(اصل, 42), ا, "نفس البذرة نفس الخلط")
تأكد_يساوي(اصل, [1, 2, 3, 4, 5, 6], "الأصل لم يتغير")
