# مثال 3788 — صف جدول ضرب 23
# Multiplication row of 23
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3788-multiplication-table-row-of-23.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في نطاق(1, ن + 1):
    ر = ر + [ي * 23]
  ارجع ر

تأكد_يساوي(ف(1), [23], "حالة 1")
تأكد_يساوي(ف(5), [23, 46, 69, 92, 115], "حالة 2")
تأكد_يساوي(ف(10), [23, 46, 69, 92, 115, 138, 161, 184, 207, 230], "حالة 3")
