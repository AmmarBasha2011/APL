# مثال 2378 — عكس بتات البايت
# Reverse bits of a byte
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2378-reverse-bits-of-byte-value.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  لكل ي في نطاق(8):
    ر = (ر << 1) | (ن & 1)
    ن = ن >> 1
  ارجع ر

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 128, "حالة 2")
تأكد_يساوي(ف(128), 1, "حالة 3")
تأكد_يساوي(ف(170), 85, "حالة 4")
تأكد_يساوي(ف(255), 255, "حالة 5")
تأكد_يساوي(ف(13), 176, "حالة 6")
