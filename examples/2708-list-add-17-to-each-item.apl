# مثال 2708 — إضافة 17 لكل عنصر
# Add 17 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2708-list-add-17-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 17]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [20, 18, 19], "حالة 1")
تأكد_يساوي(ف([5]), [22], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [18, 19, 20, 21, 22, 23], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [15, 17, 24, 24, 21], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [27, 37, 27, 47, 37, 27], "حالة 5")
