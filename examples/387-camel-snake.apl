# مثال 387 — تحويل camelCase إلى snake_case
# Camel to snake case
# Demonstrates: إدراج شرطة قبل الحروف الكبيرة
#
# Run:  python apl.py examples/387-camel-snake.apl

دالة إلى_ثعبان(نص_الدخل):
    المتغير نتيجة = ""
    لكل حرف في نص_الدخل:
        لو حرف >= "A" و حرف <= "Z":
            لو طول(نتيجة) > 0:
                نتيجة = نتيجة + "_"
            نتيجة = نتيجة + حرف.سفلي()
        الا:
            نتيجة = نتيجة + حرف
    ارجع نتيجة

دالة إلى_جمل(نص_الدخل):
    المتغير أجزاء = نص_الدخل.تقسيم("_")
    المتغير نتيجة = أجزاء[0]
    لكل ي في نطاق(1, طول(أجزاء)):
        نتيجة = نتيجة + أجزاء[ي][0].علوي() + أجزاء[ي][1:]
    ارجع نتيجة

اطبع إلى_ثعبان("helloWorldExample")
اطبع إلى_جمل("hello_world_example")
