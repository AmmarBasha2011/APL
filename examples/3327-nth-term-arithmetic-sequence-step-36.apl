# مثال 3327 — الحد النوني بخطوة 36
# Nth term step 36
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3327-nth-term-arithmetic-sequence-step-36.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 36

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 39, "حالة 2")
تأكد_يساوي(ف(10), 327, "حالة 3")
تأكد_يساوي(ف(100), 3567, "حالة 4")
