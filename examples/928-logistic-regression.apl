# مثال 928 — الانحدار اللوجستي
# Logistic regression
# Demonstrates: سيغمويد ونزول تدريجي
#
# Run:  python apl.py examples/928-logistic-regression.apl

# الانحدار اللوجستي: تصنيف ثنائي بدالة سيغمويد والنزول التدريجي
# الاحتمال = 1 / (1 + أس(-(وزن*س + انحياز)))

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة احتمال(س, وزن, انحياز):
  ارجع 1 / (1 + أس(-(وزن * س + انحياز)))

# بيانات: س من 1 لـ 4، الصنف 0 للأولين و1 للأخيرين
مداخل = [1, 2, 3, 4]
أهداف = [0, 0, 1, 1]

وزن = 0
انحياز = 0
معدل = 0.1
لكل تكرار في نطاق(2000):
  تدرج_وزن = 0
  تدرج_انحياز = 0
  لكل i في نطاق(4):
    احت = احتمال(مداخل[i], وزن, انحياز)
    تدرج_وزن = تدرج_وزن + (احت - أهداف[i]) * مداخل[i]
    تدرج_انحياز = تدرج_انحياز + (احت - أهداف[i])
  وزن = وزن - معدل * تدرج_وزن / 4
  انحياز = انحياز - معدل * تدرج_انحياز / 4

اطبع "الوزن:", وزن
اطبع "الانحياز:", انحياز
اطبع "احتمال(1):", احتمال(1, وزن, انحياز)
اطبع "احتمال(4):", احتمال(4, وزن, انحياز)

# التصنيف صحيح على بيانات التدريب
لو احتمال(1, وزن, انحياز) >= 0.05:
  اطبع "فشل: 1 يجب أن تصنف صفراً"
  قياسي_نظام_اخرج(1)
لو احتمال(2, وزن, انحياز) >= 0.5:
  اطبع "فشل: 2 يجب أن تصنف صفراً"
  قياسي_نظام_اخرج(1)
لو احتمال(3, وزن, انحياز) <= 0.5:
  اطبع "فشل: 3 يجب أن تصنف واحداً"
  قياسي_نظام_اخرج(1)
لو احتمال(4, وزن, انحياز) <= 0.95:
  اطبع "فشل: 4 يجب أن تصنف واحداً بثقة"
  قياسي_نظام_اخرج(1)
اطبع "ناجح: تصنيف كل نقاط التدريب صحيح"

# الاحتمالات رتيبة تزايدية مع س
سابقة = 0
لكل س في [1, 2, 3, 4]:
  حالية = احتمال(س, وزن, انحياز)
  لو حالية <= سابقة:
    اطبع "فشل: ليست رتيبة"
    قياسي_نظام_اخرج(1)
  سابقة = حالية
اطبع "ناجح: رتابة الاحتمالات"
