# مثال 1130 — شيفرة غراي
# Gray code sequence
# Demonstrates: تحويل ثنائي
#
# Run:  python apl.py examples/1130-gray-code.apl

# الرقم ن يُحوَّل بإزاحة بت وعملية XOR
# فيختلف كل رقمين متجاورين ببت واحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة غراي(ن):
  ناتج = []
  لكل ع في نطاق(2 ** ن):
    ناتج.ألحق(ع ^ (ع >> 1))
  ارجع ناتج

دالة بتات_مختلفة(أ, ب):
  س = أ ^ ب
  ع = 0
  طالما س > 0:
    ع = ع + (س & 1)
    س = س >> 1
  ارجع ع

تأكد_يساوي(غراي(1), [0, 1], "بت")
تأكد_يساوي(غراي(2), [0, 1, 3, 2], "بتان")
تأكد_يساوي(غراي(3), [0, 1, 3, 2, 6, 7, 5, 4], "ثلاثة")
ق = غراي(4)
سليم = صواب
لكل ع في نطاق(طول(ق) - 1):
  لو بتات_مختلفة(ق[ع], ق[ع + 1]) != 1:
    سليم = خطأ
تأكد_يساوي(سليم, صواب, "فرق بت واحد")
