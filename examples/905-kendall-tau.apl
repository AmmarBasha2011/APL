# مثال 905 — معامل كيندال تاو
# Kendall tau
# Demonstrates: أزواج متفقة ومخالفة
#
# Run:  python apl.py examples/905-kendall-tau.apl

# معامل كيندال تاو: ارتباط ترتيبي بين قائمتين
# تاو = (متفقة - مخالفة) / (ن(ن-1)/2)

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كيندال(أ, ب):
  ن = طول(أ)
  متفقة = 0
  مخالفة = 0
  لكل i في نطاق(ن):
    لكل ج في نطاق(i + 1, ن):
      فرق_أ = أ[i] - أ[ج]
      فرق_ب = ب[i] - ب[ج]
      لو فرق_أ * فرق_ب > 0:
        متفقة = متفقة + 1
      والا_لو فرق_أ * فرق_ب < 0:
        مخالفة = مخالفة + 1
  ارجع (متفقة - مخالفة) / (ن * (ن - 1) // 2)

ت1 = كيندال([1, 2, 3, 4], [1, 3, 2, 4])
اطبع "تاو =", ت1

تأكد_يساوي(مقرب(ت1, 4), 0.6667, "زوج مخالف واحد من 6")

# تطابق تام
تأكد_يساوي(كيندال([1, 2, 3], [1, 2, 3]), 1, "تطابق تام = 1")

# انعكاس تام
تأكد_يساوي(كيندال([1, 2, 3], [3, 2, 1]), -1, "انعكاس تام = -1")
