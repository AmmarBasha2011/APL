# مثال 326 — إزالة التكرار المتتالي
# Remove consecutive duplicates
# Demonstrates: ضغط المتتاليات
#
# Run:  python apl.py examples/326-dedupe-consecutive.apl

دالة بدون_تكرار_متتالي(قائمة):
    لو طول(قائمة) == 0:
        ارجع []
    المتغير نتيجة = [قائمة[0]]
    لكل ي في نطاق(1, طول(قائمة)):
        لو قائمة[ي] != نتيجة[-1]:
            نتيجة.أضف(قائمة[ي])
    ارجع نتيجة

اطبع بدون_تكرار_متتالي([1, 1, 2, 2, 2, 3, 1, 1])
اطبع بدون_تكرار_متتالي(["أ", "أ", "ب"])
