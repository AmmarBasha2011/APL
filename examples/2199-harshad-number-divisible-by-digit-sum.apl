# مثال 2199 — عدد هارشاد
# Harshad number
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2199-harshad-number-divisible-by-digit-sum.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ر في نص(ن):
    م = م + int(ر)
  ارجع ن % م == 0

تأكد_يساوي(ف(18), صواب, "حالة 18")
تأكد_يساوي(ف(19), خطأ, "حالة 19")
تأكد_يساوي(ف(21), صواب, "حالة 21")
تأكد_يساوي(ف(100), صواب, "حالة 100")
تأكد_يساوي(ف(111), صواب, "حالة 111")
تأكد_يساوي(ف(12), صواب, "حالة 12")
