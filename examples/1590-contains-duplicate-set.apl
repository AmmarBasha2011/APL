# مثال 1590 — هل فيها مكرر
# Contains duplicate
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/1590-contains-duplicate-set.apl

# نخزن ما رأيناه
# إن رأينا العنصر مرتين نرجع صواباً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فيها_مكرر(أ):
  رأينا = {}
  لكل ع في أ:
    لو ع في رأينا:
      ارجع صواب
    رأينا[ع] = صواب
  ارجع خطأ

تأكد_يساوي(فيها_مكرر([1, 2, 3, 1]), صواب, "مكرر")
تأكد_يساوي(فيها_مكرر([1, 2, 3]), خطأ, "لا مكرر")
تأكد_يساوي(فيها_مكرر([]), خطأ, "فارغة")
