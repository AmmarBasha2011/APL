# مثال 3536 — مجموع الأعداد من 27 إلى ن
# Sum from 27 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3536-sum-of-integers-from-27-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(27, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(27), 27, "حالة 1")
تأكد_يساوي(ف(28), 55, "حالة 2")
تأكد_يساوي(ف(37), 352, "حالة 3")
تأكد_يساوي(ف(100), 4699, "حالة 4")
