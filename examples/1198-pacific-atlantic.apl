# مثال 1198 — المحيطان
# Pacific Atlantic water flow
# Demonstrates: بحث بالعمق
#
# Run:  python apl.py examples/1198-pacific-atlantic.apl

# نبدأ من حافة كل محيط ونصعد إلى الأعلى ارتفاعاً
# والتقاطع هو الخانات المطلوبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة وصول(ش, بدايات):
  ر_ = طول(ش)
  ك_ = طول(ش[0])
  مرئي = []
  لكل ص في نطاق(ر_):
    مرئي.ألحق([خطأ] * ك_)
  مكدس = قائمة(بدايات)
  اتجاهات = [[1, 0], [-1, 0], [0, 1], [0, -1]]
  لكل ب في بدايات:
    مرئي[ب[0]][ب[1]] = صواب
  طالما طول(مكدس) > 0:
    ن = مكدس.pop()
    لكل د في اتجاهات:
      ر = ن[0] + د[0]
      ك = ن[1] + د[1]
      لو (ر >= 0) و (ر < ر_) و (ك >= 0) و (ك < ك_):
        لو (ليس مرئي[ر][ك]) و (ش[ر][ك] >= ش[ن[0]][ن[1]]):
          مرئي[ر][ك] = صواب
          مكدس.ألحق([ر, ك])
  ارجع مرئي

دالة محيطان(ش):
  ر_ = طول(ش)
  ك_ = طول(ش[0])
  هادي = []
  اطلسي = []
  لكل ص في نطاق(ر_):
    هادي.ألحق([ص, 0])
    اطلسي.ألحق([ص, ك_ - 1])
  لكل ج في نطاق(ك_):
    هادي.ألحق([0, ج])
    اطلسي.ألحق([ر_ - 1, ج])
  أ = وصول(ش, هادي)
  ب = وصول(ش, اطلسي)
  ناتج = []
  لكل ص في نطاق(ر_):
    لكل ج في نطاق(ك_):
      لو أ[ص][ج] و ب[ص][ج]:
        ناتج.ألحق([ص, ج])
  ارجع ناتج

م = [[1,2,2,3,5],[3,2,3,4,4],[2,4,5,3,1],[6,7,1,4,5],[5,1,1,2,4]]
تأكد_يساوي(محيطان(م), [[0,4],[1,3],[1,4],[2,2],[3,0],[3,1],[4,0]], "مثال أول")
تأكد_يساوي(محيطان([[1]]), [[0,0]], "خلية")
