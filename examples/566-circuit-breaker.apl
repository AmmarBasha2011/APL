# مثال 566 — قاطع الدائرة
# Circuit breaker
# Demonstrates: قاطع دائرة، حالات، تهدئة
#
# Run:  python apl.py examples/566-circuit-breaker.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# قاطع الدائرة: حماية من تكرار الفشل
صنف قاطع:
    دالة_إنشاء(ذات, عتبة, تهدئة):
        ذات.عتبة = عتبة
        ذات.تهدئة = تهدئة
        ذات.فشل = 0
        ذات.حالة = "مغلق"
        ذات.منذ_فتح = 0
    دالة ناد(ذات, تنجح):
        لو ذات.حالة == "مفتوح":
            ذات.منذ_فتح = ذات.منذ_فتح + 1
            لو ذات.منذ_فتح < ذات.تهدئة:
                ارجع "مرفوض: القاطع مفتوح"
            ذات.حالة = "نصف مفتوح"
        لو تنجح:
            ذات.فشل = 0
            ذات.حالة = "مغلق"
            ارجع "نجاح"
        ذات.فشل = ذات.فشل + 1
        لو ذات.حالة == "نصف مفتوح" أو ذات.فشل >= ذات.عتبة:
            ذات.حالة = "مفتوح"
            ذات.منذ_فتح = 0
        ارجع "فشل"

المتغير ق = قاطع(3, 2)
تأكد_يساوي(ق.ناد(خطأ), "فشل", "فشل 1")
تأكد_يساوي(ق.ناد(خطأ), "فشل", "فشل 2")
تأكد_يساوي(ق.ناد(خطأ), "فشل", "فشل 3 يفتح")
تأكد_يساوي(ق.حالة, "مفتوح", "الحالة مفتوح")
تأكد_يساوي(ق.ناد(صواب), "مرفوض: القاطع مفتوح", "يرفض أثناء الفتح")
تأكد_يساوي(ق.ناد(صواب), "نجاح", "بعد التهدئة نصف مفتوح ثم نجاح")
تأكد_يساوي(ق.حالة, "مغلق", "عاد مغلقاً")
