# مثال 2978 — ضرب كل عنصر في 28
# Multiply each item by 28
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2978-list-multiply-each-by-28.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 28]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [84, 28, 56], "حالة 1")
تأكد_يساوي(ف([5]), [140], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [28, 56, 84, 112, 140, 168], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-56, 0, 196, 196, 112], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [280, 560, 280, 840, 560, 280], "حالة 5")
