# مثال 3795 — عدد العناصر الأقل من 14
# Count items below 14
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3795-list-count-items-below-14.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع = 0
  لكل خ في ق:
    لو خ < 14:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([3, 1, 2]), 3, "حالة 1")
تأكد_يساوي(ف([5]), 1, "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), 6, "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), 5, "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), 3, "حالة 5")
