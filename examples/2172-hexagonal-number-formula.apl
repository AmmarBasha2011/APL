# مثال 2172 — العدد السداسي
# Hexagonal number
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2172-hexagonal-number-formula.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * (2 * ن - 1)

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(3), 15, "حالة 3")
تأكد_يساوي(ف(6), 66, "حالة 6")
تأكد_يساوي(ف(20), 780, "حالة 20")
