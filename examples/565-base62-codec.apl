# مثال 565 — ترميز base62
# Base62 codec
# Demonstrates: base62، روابط قصيرة، ترميز وفك
#
# Run:  python apl.py examples/565-base62-codec.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# ترميز base62 لروابط قصيرة
المتغير أبجدية = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

دالة رمّز(ن):
    لو ن == 0:
        ارجع "0"
    المتغير م = ""
    طالما ن > 0:
        م = أبجدية[(ن % 62)] + م
        ن = ن // 62
    ارجع م

دالة فكّ(نص):
    المتغير ن = 0
    لكل حرف في نص:
        المتغير فهرس = 0
        لكل i في نطاق(62):
            لو أبجدية[i] == حرف:
                فهرس = i
        ن = ن * 62 + فهرس
    ارجع ن

تأكد_يساوي(رمّز(12345), "3d7", "ترميز 12345")
تأكد_يساوي(فكّ("3d7"), 12345, "فك 3d7")
تأكد_يساوي(فكّ(رمّز(987654321)), 987654321, "رحلة ذهاب وعودة")
تأكد_يساوي(رمّز(0), "0", "الصفر")
