# مثال 4222 — قوة 27 بالحلقة
# Power of 27 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4222-nth-power-of-27-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 27
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 27, "حالة 2")
تأكد_يساوي(ف(3), 19683, "حالة 3")
تأكد_يساوي(ف(6), 387420489, "حالة 4")
تأكد_يساوي(ف(10), 205891132094649, "حالة 5")
