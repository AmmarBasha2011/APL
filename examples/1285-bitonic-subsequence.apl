# مثال 1285 — متتالية جبلية
# Longest bitonic subsequence
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1285-bitonic-subsequence.apl

# نحسب أطول متزايدة تنتهي بكل موضع
# وأطول متناقصة تبدأ منه ونجمعهما

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اطول_جبلية(أ):
  ن = طول(أ)
  لو ن == 0:
    ارجع 0
  ز = [1] * ن
  ن_ = [1] * ن
  لكل ع في نطاق(ن):
    لكل ج في نطاق(ع):
      لو (أ[ج] < أ[ع]) و (ز[ج] + 1 > ز[ع]):
        ز[ع] = ز[ج] + 1
  لكل ع في نطاق(ن - 1, -1, -1):
    لكل ج في نطاق(ع + 1, ن):
      لو (أ[ج] < أ[ع]) و (ن_[ج] + 1 > ن_[ع]):
        ن_[ع] = ن_[ج] + 1
  اقصى = 0
  لكل ع في نطاق(ن):
    لو ز[ع] + ن_[ع] - 1 > اقصى:
      اقصى = ز[ع] + ن_[ع] - 1
  ارجع اقصى

تأكد_يساوي(اطول_جبلية([1,11,2,10,4,5,2,1]), 6, "مثال أول")
تأكد_يساوي(اطول_جبلية([12,11,40,5,3,1]), 5, "مثال ثان")
تأكد_يساوي(اطول_جبلية([1,2,3]), 3, "تصاعدي")
