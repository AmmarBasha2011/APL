# مثال 2117 — أولي صوفي جيرمان
# Sophie Germain prime v2
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/2117-sophie-germain-prime-double-plus-one.apl

# # نختبر العددين
# # 11 مثال لأن 23 أولي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  د = 2
  طالما د * د <= ن:
    لو ن % د == 0:
      ارجع خطأ
    د = د + 1
  ارجع صواب

دالة صوفي(ن):
  ارجع اولي(ن) و اولي(2 * ن + 1)

تأكد_يساوي(صوفي(2), صواب, "٢")
تأكد_يساوي(صوفي(3), صواب, "٣")
تأكد_يساوي(صوفي(5), صواب, "٥")
تأكد_يساوي(صوفي(7), خطأ, "٧")
تأكد_يساوي(صوفي(11), صواب, "١١")
تأكد_يساوي(صوفي(13), خطأ, "١٣")
