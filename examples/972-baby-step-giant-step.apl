# مثال 972 — خطوة صغيرة وخطوة عملاقة
# Baby-step giant-step
# Demonstrates: جدول صغير وقفزات كبيرة
#
# Run:  python apl.py examples/972-baby-step-giant-step.apl

# خطوة صغيرة خطوة عملاقة: اللوغاريتم المنفصل في زمن جذر المرتبة
# نبحث عن س حيث ز^س تطابق هـ بترد ب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جذر_صحيح(ن):
  ك = 0
  طالما ((ك + 1) * (ك + 1)) <= ن:
    ك = ك + 1
  ارجع ك

دالة قوة_مود(أ, هـ, م):
  ناتج = 1
  قاعدة = أ % م
  باقي = هـ
  طالما باقي > 0:
    لو (باقي % 2) == 1:
      ناتج = (ناتج * قاعدة) % م
    قاعدة = (قاعدة * قاعدة) % م
    باقي = باقي // 2
  ارجع ناتج

دالة لوغاريتم_منفصل(ز, هـ, ب):
  م = جذر_صحيح(ب) + 1
  قيم = []
  ط = 1
  لكل ج في نطاق(م):
    قيم.ألحق(ط)
    ط = (ط * ز) % ب
  معامل = قوة_مود(ز, م * (ب - 2), ب)
  ط = هـ
  لكل i في نطاق(م):
    لكل ج في نطاق(م):
      لو قيم[ج] == ط:
        ارجع (i * م) + ج
    ط = (ط * معامل) % ب
  ارجع -1

س = لوغاريتم_منفصل(2, 28, 37)
تأكد_يساوي(س, 34, "الأس المطلوب")
تأكد_يساوي(قوة_مود(2, س, 37), 28, "التحقق بالرفع")
تأكد_يساوي(لوغاريتم_منفصل(2, 1, 37), 0, "الأس الصفري")
