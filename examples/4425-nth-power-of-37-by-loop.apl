# مثال 4425 — قوة 37 بالحلقة
# Power of 37 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4425-nth-power-of-37-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 37
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 37, "حالة 2")
تأكد_يساوي(ف(3), 50653, "حالة 3")
تأكد_يساوي(ف(6), 2565726409, "حالة 4")
تأكد_يساوي(ف(10), 4808584372417849, "حالة 5")
