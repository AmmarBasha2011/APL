# مثال 466 — قارئ YAML مبسط
# Simple YAML-ish parser
# Demonstrates: مفتاح: قيمة
#
# Run:  python apl.py examples/466-yaml-lite.apl

اكتب("/tmp/apl-466.yml", "الاسم: عمار\nالمدينة: المنصورة\nالعمر: 26")

المتغير بيانات = {}
المتغير سطور = اقرأ("/tmp/apl-466.yml").تقليم().تقسيم("\n")
لكل سطر في سطور:
    المتغير موضع = سطر.find(":")
    المتغير مفتاح = سطر[0:موضع]
    المتغير قيمة = سطر[موضع + 2:]
    بيانات[مفتاح] = قيمة

اطبع بيانات
احذف_ملف("/tmp/apl-466.yml")
