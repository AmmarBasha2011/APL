# مثال 2387 — صنف مكدس مع الحجم
# Stack class with size
# Demonstrates: أصناف
#
# Run:  python apl.py examples/2387-class-stack-push-pop-size.apl

# # نعرف صنفا
# # ونختبر سلوكه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مكدس:
    دالة_إنشاء(ذات):
        ذات.ع = []

    دالة ادفع(ذات, ق):
        ذات.ع = ذات.ع + [ق]

    دالة اسحب(ذات):
        ق = ذات.ع[-1]
        ذات.ع = ذات.ع[:-1]
        ارجع ق

    دالة حجم(ذات):
        ارجع طول(ذات.ع)

م = مكدس()
م.ادفع(1)
م.ادفع(2)
م.ادفع(3)
تأكد_يساوي(م.حجم(), 3, "ثلاثة")
تأكد_يساوي(م.اسحب(), 3, "الأخير")
تأكد_يساوي(م.حجم(), 2, "اثنان")
