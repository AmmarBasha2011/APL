# مثال 1881 — ارتفاع الشجرة من مصفوفة الآباء
# Tree height from parent list
# Demonstrates: أشجار
#
# Run:  python apl.py examples/1881-tree-heights-from-parent-list.apl

# نحسب عمق كل عقدة
# الارتفاع أكبر عمق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ارتفاع(آباء):
  عمق = []
  لكل ك في آباء:
    عمق.append(-1)
  أعلى = 0
  لكل ك في نطاق(طول(آباء)):
    مسار = []
    ع = ك
    طالما ع != -1 و عمق[ع] == -1:
      مسار.append(ع)
      ع = آباء[ع]
    د = 0
    لو ع != -1:
      د = عمق[ع] + 1
    مسار.reverse()
    لكل ن في مسار:
      عمق[ن] = د
      د = د + 1
    أعلى = أكبر(أعلى, عمق[ك])
  ارجع أعلى

تأكد_يساوي(ارتفاع([-1, 0, 0, 1, 1, 3]), 3, "ثلاثة")
تأكد_يساوي(ارتفاع([-1]), 0, "جذر")
تأكد_يساوي(ارتفاع([-1, 0, 0, 0]), 1, "نجمة")
