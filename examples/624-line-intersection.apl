# مثال 624 — تقاطع القطع المستقيمة
# Segment intersection
# Demonstrates: اتجاه، تقاطع، هندسة
#
# Run:  python apl.py examples/624-line-intersection.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تقاطع القطع المستقيمة باختبارات الاتجاه
# Demonstrates: جداء اتجاهي, فحص تداخل, حالات عامة
# أساس الرسوميات وأنظمة المعلومات الجغرافية

دالة اتجاه(ن1, ن2, ن3):
  ارجع (ن2[0] - ن1[0]) * (ن3[1] - ن1[1]) - (ن2[1] - ن1[1]) * (ن3[0] - ن1[0])

دالة يتقاطعان(أ1, أ2, ب1, ب2):
  ج1 = اتجاه(أ1, أ2, ب1)
  ج2 = اتجاه(أ1, أ2, ب2)
  ج3 = اتجاه(ب1, ب2, أ1)
  ج4 = اتجاه(ب1, ب2, أ2)
  ارجع (ج1 > 0 و ج2 < 0 أو ج1 < 0 و ج2 > 0) و (ج3 > 0 و ج4 < 0 أو ج3 < 0 و ج4 > 0)

تأكد_يساوي(يتقاطعان([0,0],[4,4],[0,4],[4,0]), صواب, "قطرا مربع")
تأكد_يساوي(يتقاطعان([0,0],[1,1],[0,2],[2,3]), خطأ, "متوازيان بعيدان")
تأكد_يساوي(يتقاطعان([0,0],[4,0],[2,-1],[2,1]), صواب, "عمودي على أفقي")
اطبع "قطران يتقاطعان:", يتقاطعان([0,0],[4,4],[0,4],[4,0])
