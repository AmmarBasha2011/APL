# مثال 1367 — نمط واحد ثلاثة اثنين
# Pattern 132 detection
# Demonstrates: مكدس أحادي
#
# Run:  python apl.py examples/1367-pattern-one-three-two.apl

# نمر من اليمين مع مكدس متناقص
# نحتفظ بأكبر قيمة كانت وسطاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نمط_132(أرقام):
  ثالث = -1000000000
  مكدس = []
  لكل ع في نطاق(طول(أرقام) - 1, -1, -1):
    لو أرقام[ع] < ثالث:
      ارجع صواب
    طالما (طول(مكدس) > 0) و (مكدس[طول(مكدس) - 1] < أرقام[ع]):
      ثالث = مكدس.pop()
    مكدس.ألحق(أرقام[ع])
  ارجع خطأ

تأكد_يساوي(نمط_132([1,2,3,4]), خطأ, "لا نمط")
تأكد_يساوي(نمط_132([3,1,4,2]), صواب, "يوجد")
تأكد_يساوي(نمط_132([-1,3,2,0]), صواب, "سالبة")
