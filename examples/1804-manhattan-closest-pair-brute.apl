# مثال 1804 — أقرب نقطتين بمسافة مانهاتن
# Closest pair by Manhattan distance
# Demonstrates: هندسة
#
# Run:  python apl.py examples/1804-manhattan-closest-pair-brute.apl

# المسافة مجموع الفروق المطلقة
# نحتفظ بالأصغر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مسافة(أ, ب):
  س = أ[0] - ب[0]
  ص = أ[1] - ب[1]
  لو س < 0:
    س = -س
  لو ص < 0:
    ص = -ص
  ارجع س + ص

دالة أقرب_زوج(نقاط):
  أفضل = 1000000
  لكل ي في نطاق(طول(نقاط)):
    لكل ك في نطاق(ي + 1, طول(نقاط)):
      أفضل = أصغر(أفضل, مسافة(نقاط[ي], نقاط[ك]))
  ارجع أفضل

تأكد_يساوي(أقرب_زوج([[0, 0], [5, 5], [1, 1]]), 2, "ثلاث")
تأكد_يساوي(أقرب_زوج([[0, 0], [0, 1]]), 1, "اثنتان")
