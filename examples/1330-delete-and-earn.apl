# مثال 1330 — احذف واكسب
# Delete and earn
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1330-delete-and-earn.apl

# حذف رقم يحذف جيرانه بفارق واحد
# نجمع نقاط كل رقم ونطبق منطق السارق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اكسب(أرقام):
  لو طول(أرقام) == 0:
    ارجع 0
  اكبر_رقم = أكبر(أرقام)
  نقاط = [0] * (اكبر_رقم + 1)
  لكل ر في أرقام:
    نقاط[ر] = نقاط[ر] + ر
  سابق = 0
  حالي = 0
  لكل ع في نطاق(اكبر_رقم + 1):
    جديد = أكبر(حالي, سابق + نقاط[ع])
    سابق = حالي
    حالي = جديد
  ارجع حالي

تأكد_يساوي(اكسب([3,4,2]), 6, "مثال أول")
تأكد_يساوي(اكسب([2,2,3,3,3,4]), 9, "مثال ثان")
تأكد_يساوي(اكسب([]), 0, "فارغة")
