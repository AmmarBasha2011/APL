# مثال 2116 — الأولي الدائري
# Circular prime check v2
# Demonstrates: نظرية الأعداد
#
# Run:  python apl.py examples/2116-circular-prime-all-rotations-prime.apl

# # ندور الأرقام حرفا حرفا
# # 197 مثال

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولي(ن):
  لو ن < 2:
    ارجع خطأ
  د = 2
  طالما د * د <= ن:
    لو ن % د == 0:
      ارجع خطأ
    د = د + 1
  ارجع صواب

دالة دائري(ن):
  س = نص(ن)
  لكل ك في نطاق(طول(س)):
    لو اولي(int(س[ك:] + س[:ك])) == خطأ:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(دائري(197), صواب, "١٩٧")
تأكد_يساوي(دائري(13), صواب, "١٣")
تأكد_يساوي(دائري(19), خطأ, "١٩")
تأكد_يساوي(دائري(2), صواب, "٢")
تأكد_يساوي(دائري(11), صواب, "١١")
