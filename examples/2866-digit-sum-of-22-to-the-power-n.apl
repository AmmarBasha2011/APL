# مثال 2866 — مجموع أرقام 22 أس ن
# Digit sum of 22 power n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2866-digit-sum-of-22-to-the-power-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 22 ** ن
  م = 0
  لكل ر في نص(ق):
    م = م + int(ر)
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 4, "حالة 2")
تأكد_يساوي(ف(5), 25, "حالة 3")
تأكد_يساوي(ف(10), 67, "حالة 4")
تأكد_يساوي(ف(20), 133, "حالة 5")
