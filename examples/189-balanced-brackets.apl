# مثال 189 — فحص توازن الأقواس
# Balanced brackets check
# Demonstrates: المكدس بالقائمة، القواميس
#
# Run:  python apl.py examples/189-balanced-brackets.apl

دالة متوازن(نص_الدخل):
    المتغير مكدس = []
    المتغير أزواج = {")": "(", "]": "[", "}": "{"}
    لكل حرف في نص_الدخل:
        لو حرف == "(" أو حرف == "[" أو حرف == "{":
            مكدس.أضف(حرف)
        الا لو حرف == ")" أو حرف == "]" أو حرف == "}":
            لو طول(مكدس) == 0:
                ارجع خطأ
            لو مكدس.pop() != أزواج[حرف]:
                ارجع خطأ
    ارجع طول(مكدس) == 0

اطبع "()", متوازن("()")
اطبع "([{}])", متوازن("([{}])")
اطبع "(]", متوازن("(]")
اطبع "((", متوازن("((")
