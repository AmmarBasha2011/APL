# مثال 649 — اللقاء في المنتصف
# Meet in the middle
# Demonstrates: تقسيم نصفين، تعداد أسس، قواميس
#
# Run:  python apl.py examples/649-meet-in-middle.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# اللقاء في المنتصف: عد مجموعات جزئية بهدف
# Demonstrates: تقسيم النصفين, تعداد الأسس, عد بالقواميس
# 2^12 بدل 2^24 عندما ينقسم العمل نصفين

أوزان = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8]
هدف = 15

دالة مجموع_مجموعات(عناصر):
  نتائج = {}
  لكل قناع في نطاق(2 ** طول(عناصر)):
    حاصل = 0
    لكل ي في نطاق(طول(عناصر)):
      لو قناع & (1 << ي):
        حاصل = حاصل + عناصر[ي]
    لو حاصل في نتائج:
      نتائج[حاصل] = نتائج[حاصل] + 1
    والا:
      نتائج[حاصل] = 1
  ارجع نتائج

يسار = مجموع_مجموعات(أوزان[:6])
يمين = مجموع_مجموعات(أوزان[6:])
عدد = 0
لكل ح في يسار.keys():
  باقي = هدف - ح
  لو باقي في يمين:
    عدد = عدد + يسار[ح] * يمين[باقي]

مرجع = 0
لكل قناع في نطاق(2 ** 12):
  حاصل = 0
  لكل ي في نطاق(12):
    لو قناع & (1 << ي):
      حاصل = حاصل + أوزان[ي]
  لو حاصل == هدف:
    مرجع = مرجع + 1

تأكد_يساوي(عدد, مرجع, "يطابق التعداد الشامل")
تأكد_يساوي(عدد, 91, "العدد الدقيق")
اطبع "عدد المجموعات:", عدد
