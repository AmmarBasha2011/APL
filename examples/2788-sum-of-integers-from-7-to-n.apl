# مثال 2788 — مجموع الأعداد من 7 إلى ن
# Sum from 7 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2788-sum-of-integers-from-7-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(7, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(7), 7, "حالة 1")
تأكد_يساوي(ف(8), 15, "حالة 2")
تأكد_يساوي(ف(17), 132, "حالة 3")
تأكد_يساوي(ف(100), 5029, "حالة 4")
