# مثال 633 — شجرة ميركل
# Merkle tree
# Demonstrates: ميركل، تجزئة، سلامة
#
# Run:  python apl.py examples/633-merkle-tree.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# شجرة ميركل: إثبات سلامة البيانات بالتجزئة
# Demonstrates: تجزئة أزواج متدرجة, جذر واحد, كشف التعديل
# تغيير صفقة واحدة يغير جذر الشجرة كلها

دالة هاش(نص):
  ارجع تجزئة_md5(نص.encode("utf-8")).hexdigest()

دالة جذر_ميركل(أوراق):
  طبقة = []
  لكل ورقة في أوراق:
    طبقة.append(هاش(ورقة))
  طالما طول(طبقة) > 1:
    تالية = []
    لكل ي في نطاق(0, طول(طبقة), 2):
      لو ي + 1 < طول(طبقة):
        تالية.append(هاش(طبقة[ي] + طبقة[ي + 1]))
      والا:
        تالية.append(طبقة[ي])
    طبقة = تالية
  ارجع طبقة[0]

أوراق = ["صفقة1", "صفقة2", "صفقة3", "صفقة4"]
جذر = جذر_ميركل(أوراق)
اطبع "جذر ميركل:", جذر[:12]
تأكد_يساوي(جذر, جذر_ميركل(["صفقة1", "صفقة2", "صفقة3", "صفقة4"]), "حتمي")
تأكد_يساوي(جذر != جذر_ميركل(["صفقة1", "صفقة2", "صفقة3", "صفقة5"]), صواب, "تعديل ورقة يغير الجذر")
تأكد_يساوي(طول(جذر), 32, "طول md5")
