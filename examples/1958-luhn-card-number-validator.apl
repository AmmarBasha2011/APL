# مثال 1958 — التحقق من رقم البطاقة بخوارزمية لون
# Luhn card validator
# Demonstrates: أرقام
#
# Run:  python apl.py examples/1958-luhn-card-number-validator.apl

# # إن زاد الرقم المضاعف على 9 نطرح منه 9
# # الرقم صحيح إذا كان المجموع من مضاعفات عشرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة لون(س):
  مج = 0
  ثاني = خطأ
  لكل ك في نطاق(طول(س)):
    ر = int(س[طول(س) - 1 - ك])
    لو ثاني:
      ر = ر * 2
      لو ر > 9:
        ر = ر - 9
    مج = مج + ر
    ثاني = ثاني == خطأ
  ارجع مج % 10 == 0

تأكد_يساوي(لون("4539578763621486"), صواب, "صحيح")
تأكد_يساوي(لون("4539578763621487"), خطأ, "خاطئ")
تأكد_يساوي(لون("79927398713"), صواب, "مثال ويكيبيديا")
