# مثال 910 — فرز الدورات
# Cycle sort
# Demonstrates: تدوير العناصر لمواضعها
#
# Run:  python apl.py examples/910-cycle-sort.apl

# فرز الدورات: أقل عدد ممكن من الكتابات على المصفوفة
# مفيد حين الكتابة مكلفة (ذاكرة فلاش)

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة فرز_دورات(قيم):
  م = []
  لكل x في قيم:
    م.ألحق(x)
  ن = طول(م)
  كتابات = 0
  لكل بداية في نطاق(ن - 1):
    عنصر = م[بداية]
    موضع = بداية
    لكل i في نطاق(بداية + 1, ن):
      لو م[i] < عنصر:
        موضع = موضع + 1
    لو موضع == بداية:
      # لا دورة هنا
      كتابات = كتابات + 0
    والا:
      طالما عنصر == م[موضع]:
        موضع = موضع + 1
      مؤقت = م[موضع]
      م[موضع] = عنصر
      عنصر = مؤقت
      كتابات = كتابات + 1
      طالما موضع != بداية:
        موضع = بداية
        لكل i في نطاق(بداية + 1, ن):
          لو م[i] < عنصر:
            موضع = موضع + 1
        طالما عنصر == م[موضع]:
          موضع = موضع + 1
        مؤقت = م[موضع]
        م[موضع] = عنصر
        عنصر = مؤقت
        كتابات = كتابات + 1
  ارجع [م, كتابات]

نتيجة = فرز_دورات([4, 3, 2, 1])
م = نتيجة[0]
ك = نتيجة[1]
اطبع "المرتبة:", م
اطبع "الكتابات:", ك

تأكد_يساوي(م[0], 1, "أول")
تأكد_يساوي(م[3], 4, "أخير")
تأكد_يساوي(ك, 4, "أربع كتابات بالضبط")

# مرتبة أصلاً: صفر كتابات
نتيجة2 = فرز_دورات([1, 2, 3])
تأكد_يساوي(نتيجة2[1], 0, "لا كتابات للمرتبة")

# مع تكرارات
نتيجة3 = فرز_دورات([3, 1, 3, 1])
تأكد_يساوي(نتيجة3[0][0], 1, "تكرار أول")
تأكد_يساوي(نتيجة3[0][3], 3, "تكرار أخير")
