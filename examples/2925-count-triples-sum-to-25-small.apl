# مثال 2925 — ثلاثيات مجموعها 25
# Triples summing to 25
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2925-count-triples-sum-to-25-small.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل أ في نطاق(1, ن + 1):
    لكل ب في نطاق(أ, ن + 1):
      لكل ج في نطاق(ب, ن + 1):
        لو أ + ب + ج == 25:
          ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(5), 0, "حالة 1")
تأكد_يساوي(ف(25), 52, "حالة 2")
تأكد_يساوي(ف(28), 52, "حالة 3")
