# مثال 2256 — صف جدول الضرب
# Multiplication row
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2256-list-build-multiplication-row.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 3]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [9, 3, 6], "حالة 1")
تأكد_يساوي(ف([5]), [15], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [3, 6, 9, 12, 15, 18], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-6, 0, 21, 21, 12], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [30, 60, 30, 90, 60, 30], "حالة 5")
