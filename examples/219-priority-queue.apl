# مثال 219 — طابور الأولوية اليدوي
# Manual priority queue
# Demonstrates: قائمة مرتبة بالأولوية
#
# Run:  python apl.py examples/219-priority-queue.apl

صنف طابور_أولوية:
    دالة_إنشاء(ذات):
        ذات.عناصر = []

    دالة أدخل(ذات, عنصر, أولوية):
        ذات.عناصر.أضف({"عنصر": عنصر, "أولوية": أولوية})

    دالة أخرج_أعلى(ذات):
        لو طول(ذات.عناصر) == 0:
            ارجع "فارغ"
        المتغير أعلى = 0
        لكل ي في نطاق(1, طول(ذات.عناصر)):
            لو ذات.عناصر[ي]["أولوية"] > ذات.عناصر[أعلى]["أولوية"]:
                أعلى = ي
        ارجع ذات.عناصر.pop(أعلى)["عنصر"]

المتغير ط = طابور_أولوية()
ط.أدخل("مهمة عادية", 1)
ط.أدخل("طارئة", 10)
ط.أدخل("مهمة", 5)
اطبع ط.أخرج_أعلى()
اطبع ط.أخرج_أعلى()
اطبع ط.أخرج_أعلى()
