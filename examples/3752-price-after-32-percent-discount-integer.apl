# مثال 3752 — السعر بعد خصم 32 بالمئة
# Price after 32 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3752-price-after-32-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 32 // 100

تأكد_يساوي(ف(100), 68, "حالة 1")
تأكد_يساوي(ف(250), 170, "حالة 2")
تأكد_يساوي(ف(999), 680, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
