# مثال 4151 — السعر بعد خصم 41 بالمئة
# Price after 41 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4151-price-after-41-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 41 // 100

تأكد_يساوي(ف(100), 59, "حالة 1")
تأكد_يساوي(ف(250), 148, "حالة 2")
تأكد_يساوي(ف(999), 590, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
