# مثال 2173 — العدد المربع المركزي
# Centered square number
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2173-centered-square-number-formula.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن * ن + (ن - 1) * (ن - 1)

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 5, "حالة 2")
تأكد_يساوي(ف(5), 41, "حالة 5")
تأكد_يساوي(ف(10), 181, "حالة 10")
