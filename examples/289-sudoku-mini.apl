# مثال 289 — سودوكو مصغر 4x4
# Mini sudoku 4x4
# Demonstrates: تراجع مع فحص الصف والعمود والمربع
#
# Run:  python apl.py examples/289-sudoku-mini.apl

دالة صالح(شبكة, س, ص, قيمة):
    لكل ي في نطاق(4):
        لو شبكة[س][ي] == قيمة أو شبكة[ي][ص] == قيمة:
            ارجع خطأ
    المتغير س0 = (س // 2) * 2
    المتغير ص0 = (ص // 2) * 2
    لكل أ في نطاق(س0, س0 + 2):
        لكل ب في نطاق(ص0, ص0 + 2):
            لو شبكة[أ][ب] == قيمة:
                ارجع خطأ
    ارجع صواب

دالة حل(شبكة, موضع):
    لو موضع == 16:
        ارجع صواب
    المتغير س = موضع // 4
    المتغير ص = موضع % 4
    لو شبكة[س][ص] != 0:
        ارجع حل(شبكة, موضع + 1)
    لكل قيمة في نطاق(1, 5):
        لو صالح(شبكة, س, ص, قيمة):
            شبكة[س][ص] = قيمة
            لو حل(شبكة, موضع + 1):
                ارجع صواب
            شبكة[س][ص] = 0
    ارجع خطأ

المتغير شبكة = [
    [1, 0, 0, 4],
    [0, 4, 1, 0],
    [0, 1, 4, 0],
    [4, 0, 0, 1]
]
لو حل(شبكة, 0):
    لكل صف في شبكة:
        اطبع صف
الا:
    اطبع "لا حل"
