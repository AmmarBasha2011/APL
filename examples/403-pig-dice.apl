# مثال 403 — لعبة نرد الخنزير
# Pig dice game
# Demonstrates: قرار التوقف الآلي
#
# Run:  python apl.py examples/403-pig-dice.apl

بذرة(4)
المتغير نقاط = 0

طالما نقاط < 100:
    المتغير جولة = 0
    المتغير مستمر = صواب
    طالما مستمر:
        المتغير رمية = عشوائي_عدد(1, 6)
        لو رمية == 1:
            جولة = 0
            مستمر = خطأ
        الا لو جولة + رمية >= 20:
            جولة = جولة + رمية
            مستمر = خطأ
        الا:
            جولة = جولة + رمية
    نقاط = نقاط + جولة
    اطبع "النقاط الآن:", نقاط

اطبع "فاز!"
