# مثال 3136 — ضرب كل عنصر في 34
# Multiply each item by 34
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3136-list-multiply-each-by-34.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 34]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [102, 34, 68], "حالة 1")
تأكد_يساوي(ف([5]), [170], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [34, 68, 102, 136, 170, 204], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-68, 0, 238, 238, 136], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [340, 680, 340, 1020, 680, 340], "حالة 5")
