# مثال 3568 — تحويل وحدة بأساس 29
# Split by base 29
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3568-minutes-to-hours-and-minutes-base-29.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 29, ن % 29]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [2, 1], "حالة 2")
تأكد_يساوي(ف(60), [2, 2], "حالة 3")
تأكد_يساوي(ف(125), [4, 9], "حالة 4")
تأكد_يساوي(ف(1000), [34, 14], "حالة 5")
