# مثال 2032 — مطابقة نمط الحروف مع الكلمات
# Word pattern bijection
# Demonstrates: قواميس
#
# Run:  python apl.py examples/2032-word-pattern-bijection-check.apl

# # نقسم الجملة إلى كلمات
# # ونتحقق من التقابل في الاتجاهين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة نمط(ن, جملة):
  كلمات = جملة.split(" ")
  لو طول(كلمات) != طول(ن):
    ارجع خطأ
  خ1 = {}
  خ2 = {}
  لكل ك في نطاق(طول(ن)):
    لو ن[ك] في خ1 و خ1[ن[ك]] != كلمات[ك]:
      ارجع خطأ
    لو كلمات[ك] في خ2 و خ2[كلمات[ك]] != ن[ك]:
      ارجع خطأ
    خ1[ن[ك]] = كلمات[ك]
    خ2[كلمات[ك]] = ن[ك]
  ارجع صواب

تأكد_يساوي(نمط("abba", "dog cat cat dog"), صواب, "مطابق")
تأكد_يساوي(نمط("abba", "dog cat cat fish"), خطأ, "كلمة مختلفة")
تأكد_يساوي(نمط("aaaa", "dog cat cat dog"), خطأ, "حرف واحد")
