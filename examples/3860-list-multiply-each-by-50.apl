# مثال 3860 — ضرب كل عنصر في 50
# Multiply each item by 50
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3860-list-multiply-each-by-50.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 50]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [150, 50, 100], "حالة 1")
تأكد_يساوي(ف([5]), [250], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [50, 100, 150, 200, 250, 300], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-100, 0, 350, 350, 200], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [500, 1000, 500, 1500, 1000, 500], "حالة 5")
