# مثال 446 — عمليات المتجهات
# Vector operations
# Demonstrates: جمع وضرب نقطي وطول
#
# Run:  python apl.py examples/446-vector-ops.apl

دالة اجمع_متجه(أ, ب):
    ارجع [أ[0] + ب[0], أ[1] + ب[1]]

دالة نقطي(أ, ب):
    ارجع أ[0] * ب[0] + أ[1] * ب[1]

دالة طول_متجه(أ):
    ارجع جذر(أ[0] * أ[0] + أ[1] * أ[1])

المتغير م1 = [3, 4]
المتغير م2 = [1, 2]
اطبع "الجمع:", اجمع_متجه(م1, م2)
اطبع "النقطي:", نقطي(م1, م2)
اطبع "الطول:", طول_متجه(م1)
