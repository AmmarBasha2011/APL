# مثال 1534 — هل العدد قوة للأربعة
# Is power of four
# Demonstrates: بتات
#
# Run:  python apl.py examples/1534-power-of-four-check.apl

# قوة الأربعة قوة للاثنين أولاً
# وبتها المضيء في موضع زوجي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قوة_أربعة(ن):
  لو ن <= 0:
    ارجع خطأ
  لو ن & (ن - 1) != 0:
    ارجع خطأ
  ارجع ن & 1431655765 != 0

تأكد_يساوي(قوة_أربعة(16), صواب, "ستة عشر")
تأكد_يساوي(قوة_أربعة(8), خطأ, "ثمانية")
تأكد_يساوي(قوة_أربعة(1), صواب, "واحد")
تأكد_يساوي(قوة_أربعة(0), خطأ, "صفر")
