# مثال 2446 — قيصر بإزاحة 13
# Caesar shift 13
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2446-caesar-shift-by-13-lowercase.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح.islower():
      ر = ر + chr((ord(ح) - 97 + 13) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "nop", "حالة 1")
تأكد_يساوي(ف("xyz"), "klm", "حالة 2")
تأكد_يساوي(ف("hello world"), "uryyb jbeyq", "حالة 3")
تأكد_يساوي(ف("a1"), "n1", "حالة 4")
