# مثال 2167 — هل العدد متناظر
# Is number a palindrome
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2167-is-number-palindrome-digits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع نص(ن) == نص(ن)[::-1]

تأكد_يساوي(ف(1), صواب, "حالة 1")
تأكد_يساوي(ف(121), صواب, "حالة 121")
تأكد_يساوي(ف(123), خطأ, "حالة 123")
تأكد_يساوي(ف(1221), صواب, "حالة 1221")
تأكد_يساوي(ف(10), خطأ, "حالة 10")
