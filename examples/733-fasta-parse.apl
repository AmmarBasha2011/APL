# مثال 733 — تحليل FASTA
# FASTA parsing
# Demonstrates: عناوين، سجلات، دمج سطور
#
# Run:  python apl.py examples/733-fasta-parse.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# تحليل ملف FASTA (تنسيق تسلسلات جينية)
# Demonstrates: سطور تبدأ بـ >, بناء قاموس سجلات, تجميع تسلسل متعدد السطور
# كل سجل يبدأ بسطر عنوان >id ثم سطور تسلسل تُدمج

دالة حلل_fasta(سطور):
  سجلات = {}
  ترتيب = []
  حالي = لا_شيء
  لكل سطر في سطور:
    لو سطر.startswith(">"):
      حالي = سطر[1:طول(سطر)]
      سجلات[حالي] = ""
      ترتيب.append(حالي)
    والا_لو حالي != لا_شيء:
      سجلات[حالي] = سجلات[حالي] + سطر
  ارجع [ترتيب, سجلات]

دالة أطوال(سطور):
  ناتج = حلل_fasta(سطور)
  ترتيب = ناتج[0]
  سجلات = ناتج[1]
  قياسات = {}
  لكل مفتاح في ترتيب:
    قياسات[مفتاح] = طول(سجلات[مفتاح])
  ارجع قياسات

دالة أطول_سجل(سطور):
  ناتج = حلل_fasta(سطور)
  ترتيب = ناتج[0]
  سجلات = ناتج[1]
  أفضل = ترتيب[0]
  لكل مفتاح في ترتيب:
    لو طول(سجلات[مفتاح]) > طول(سجلات[أفضل]):
      أفضل = مفتاح
  ارجع [أفضل, طول(سجلات[أفضل])]

عينة = [">seq1", "ATGC", "ATGC", ">seq2", "GG", "CC", ">seq3", "A"]
ناتج = حلل_fasta(عينة)
ترتيب = ناتج[0]
سجلات = ناتج[1]

تأكد_يساوي(ترتيب, ["seq1", "seq2", "seq3"], "ترتيب السجلات")
تأكد_يساوي(سجلات["seq1"], "ATGCATGC", "دمج سطرين")
تأكد_يساوي(سجلات["seq2"], "GGCC", "سجل ثان")
تأكد_يساوي(سجلات["seq3"], "A", "سجل قصير")

قياسات = أطوال(عينة)
تأكد_يساوي(قياسات["seq1"], 8, "طول الأول")
تأكد_يساوي(قياسات["seq3"], 1, "طول الثالث")
تأكد_يساوي(أطول_سجل(عينة), ["seq1", 8], "الأطول")

تأكد_يساوي(طول(حلل_fasta([">x", "AC"])[0]), 1, "سجل واحد")
تأكد_يساوي(حلل_fasta(["AC", "GT"])[0], [], "بلا عناوين")

اطبع "سجلات:", طول(ترتيب)
اطبع "seq1:", سجلات["seq1"]
