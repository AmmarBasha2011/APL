# مثال 1000 — الالتفاف
# Convolution
# Demonstrates: انزلاق نواة على إشارة
#
# Run:  python apl.py examples/1000-convolution.apl

# الالتفاف: تراكب إشارة مع نواة لإنتاج تأثير أو ترشيح
# كل عينة ناتجة مجموع حاصل ضرب الانزلاقات المتقاطعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة التفاف(إشارة, نواة):
  ن = (طول(إشارة) + طول(نواة)) - 1
  ناتج = []
  لكل _ في نطاق(ن):
    ناتج.ألحق(0)
  لكل i في نطاق(طول(إشارة)):
    لكل j في نطاق(طول(نواة)):
      ناتج[i + j] = ناتج[i + j] + (إشارة[i] * نواة[j])
  ارجع ناتج

ناتج = التفاف([1, 2, 3], [0, 1, 0.5])
تأكد_يساوي(طول(ناتج), 5, "الطول المجمع")
تأكد_يساوي(مقرب(ناتج[0], 4), 0, "العينة الأولى")
تأكد_يساوي(مقرب(ناتج[1], 4), 1, "العينة الثانية")
تأكد_يساوي(مقرب(ناتج[2], 4), 2.5, "العينة الثالثة")
تأكد_يساوي(مقرب(ناتج[3], 4), 4, "العينة الرابعة")
تأكد_يساوي(مقرب(ناتج[4], 4), 1.5, "العينة الأخيرة")
