# مثال 54 — أرشيف ZIP كامل: إنشاء، سرد، قراءة، تعديل، استخراج
# ZIP archives end to end
# Demonstrates: أنشئ_أرشيف, قائمة_الأرشيف, عدد_الأعضاء, داخل_الأرشيف,
#               نص_العضو, عرض_الأرشيف, بيانات_الأرشيف, أضف_للأرشيف,
#               احذف_من_الأرشيف, استخرج_الأرشيف, حجم_بشري, نوع_الأرشيف
#
# Run:  python apl.py examples/54-archive-zip.apl

المتغير المجلد = "_apl_أرشيف_تجربة"
المتغير مسار_الأرشيف = المجلد + "/تقارير.zip"

# ---------- 1) تجهيز ملفات للاختبار ----------
انشئ_مجلدات(المجلد + "/مصدر/بيانات")
اكتب(المجلد + "/مصدر/تقرير.txt", "تقرير المبيعات — الربع الأول\nالإجمالي: 12500\n")
اكتب(المجلد + "/مصدر/بيانات/يناير.txt", "يناير: 4000\n")
اكتب(المجلد + "/مصدر/بيانات/فبراير.txt", "فبراير: 3800\n")
اكتب(المجلد + "/مصدر/بيانات/مارس.txt", "مارس: 4700\n")

# ملف سجل طويل ومتكرر — لتوضيح أثر الضغط الحقيقي
المتغير سطور = []
لكل رقم في نطاق(1, 201):
    سطور.أضف("سطر رقم " + نص(رقم) + ": عملية مسجّلة في سجل المبيعات\n")
اكتب(المجلد + "/مصدر/سجل.txt", "".ضم(سطور))

# ---------- 2) إنشاء الأرشيف من مجلد كامل ----------
اطبع "=== 1) إنشاء الأرشيف ==="
أنشئ_أرشيف(مسار_الأرشيف, [المجلد + "/مصدر"])
اطبع "نوع الملف: " + نوع_الأرشيف(مسار_الأرشيف)
اطبع "عدد الأعضاء: " + نص(عدد_الأعضاء(مسار_الأرشيف))
اطبع "حجم الأرشيف: " + حجم_بشري(حجم_الأرشيف(مسار_الأرشيف))
اطبع ""

# ---------- 3) سرد المحتويات ----------
اطبع "=== 2) محتويات الأرشيف ==="
عرض_الأرشيف(مسار_الأرشيف)
اطبع ""

# ---------- 4) قراءة عضو واحد كنص ----------
اطبع "=== 3) قراءة عضو ==="
اطبع نص_العضو(مسار_الأرشيف, "مصدر/تقرير.txt")

# ---------- 5) إضافة وحذف أعضاء ----------
اطبع "=== 4) تعديل الأرشيف ==="
اكتب(المجلد + "/ملحق.txt", "ملحق: أرقام مؤكدة\n")
أضف_للأرشيف(مسار_الأرشيف, [المجلد + "/ملحق.txt"])
اطبع "بعد الإضافة: " + نص(عدد_الأعضاء(مسار_الأرشيف)) + " عضواً"
اطبع "هل الملحق داخل الأرشيف؟ " + نص(داخل_الأرشيف(مسار_الأرشيف, "ملحق.txt"))

احذف_من_الأرشيف(مسار_الأرشيف, ["ملحق.txt"])
اطبع "بعد الحذف: " + نص(عدد_الأعضاء(مسار_الأرشيف)) + " عضواً"
اطبع ""

# ---------- 6) إحصاءات الضغط ----------
اطبع "=== 5) إحصاءات الضغط ==="
المتغير إحصاء = بيانات_الأرشيف(مسار_الأرشيف)
اطبع "الأعضاء: " + نص(إحصاء["عدد_الأعضاء"])
اطبع "قبل الضغط: " + حجم_بشري(إحصاء["الحجم_الأصلي"])
اطبع "بعد الضغط: " + حجم_بشري(إحصاء["الحجم_المضغوط"])
اطبع "نسبة الحجم النهائي: " + نص(إحصاء["نسبة_الضغط"]) + "%"
اطبع ""

# ---------- 7) الاستخراج الآمن ----------
اطبع "=== 6) الاستخراج ==="
المتغير مستخرج = استخرج_الأرشيف(مسار_الأرشيف, المجلد + "/مستخرج")
اطبع "عدد ما استُخرج: " + نص(طول(مستخرج))
اطبع "محتوى الملف المستخرج:"
اطبع اقرأ(المجلد + "/مستخرج/مصدر/بيانات/فبراير.txt")

# ---------- 8) الحماية من الخروج عن المجلد ----------
اطبع ""
اطبع "=== 7) فحص الأمان ==="
المتغير مسار_شرير = المجلد + "/شرير.zip"
المتغير شرير = افتح_أرشيف(مسار_شرير, "w")
شرير.اكتب_عضو("../هروب.txt", "محاولة كتابة خارج المجلد")
شرير.أغلق_الأرشيف()

حاول:
    استخرج_الأرشيف(مسار_شرير, المجلد + "/آمن")
إمسك مثل خلل:
    اطبع "تم رفض الأرشيف الخبيث ✓"
    اطبع "السبب: " + نص(خلل)

# ---------- 9) تنظيف ----------
احذف_شجرة(المجلد)
اطبع ""
اطبع "تم تنظيف ملفات التجربة."
