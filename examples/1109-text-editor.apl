# مثال 1109 — محرر نصوص بمؤشر
# Text editor with cursor
# Demonstrates: نصان يمين ويسار المؤشر
#
# Run:  python apl.py examples/1109-text-editor.apl

# نخزن النص الذي على يسار المؤشر والذي على يمينه
# وكل عملية تعيد آخر عشرة أحرف على يسار المؤشر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف محرر:
    دالة_إنشاء(ذات):
        ذات.يسار = ""
        ذات.يمين = ""

    دالة اخر_عشرة(ذات):
        ارجع ذات.يسار[-10:]

    دالة اضف_نص(ذات, نص_):
        ذات.يسار = ذات.يسار + نص_

    دالة امسح(ذات, ك):
        م = ك
        لو م > طول(ذات.يسار):
            م = طول(ذات.يسار)
        ذات.يسار = ذات.يسار[:طول(ذات.يسار) - م]
        ارجع م

    دالة حرك_يمين(ذات, ك):
        م = ك
        لو م > طول(ذات.يمين):
            م = طول(ذات.يمين)
        ذات.يسار = ذات.يسار + ذات.يمين[:م]
        ذات.يمين = ذات.يمين[م:]
        ارجع ذات.اخر_عشرة()

    دالة حرك_يسار(ذات, ك):
        م = ك
        لو م > طول(ذات.يسار):
            م = طول(ذات.يسار)
        ذات.يمين = ذات.يسار[طول(ذات.يسار) - م:] + ذات.يمين
        ذات.يسار = ذات.يسار[:طول(ذات.يسار) - م]
        ارجع ذات.اخر_عشرة()

م = محرر()
م.اضف_نص("leetcode")
تأكد_يساوي(م.امسح(4), 4, "مسح أربعة")
م.اضف_نص("practice")
تأكد_يساوي(م.حرك_يمين(3), "etpractice", "يمين بلا مجال")
تأكد_يساوي(م.حرك_يسار(8), "leet", "يسار ثمانية")
تأكد_يساوي(م.امسح(10), 4, "مسح ما يمكن")
تأكد_يساوي(م.حرك_يسار(2), "", "يسار بلا نص")
تأكد_يساوي(م.حرك_يمين(6), "practi", "يمين ستة")
