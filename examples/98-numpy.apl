المتغير أ = مصفوفة_2([1, 2, 3, 4])
اطبع "المصفوفة:", أ
اطبع "المجموع:", مجموع_2(أ)
اطبع "المتوسط:", متوسط_2(أ)

المتغير ب = مصفوفة_2([[1, 2], [3, 4]])
اطبع "الضرب النقطي:", ضرب_نقطي(ب, ب)
اطبع "الترتيب:", رتّب_2(مصفوفة_2([5, 1, 4, 2]))
