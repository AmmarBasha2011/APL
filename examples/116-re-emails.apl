# مثال 116 — استخراج البريد الإلكتروني والأرقام من نص
# Extracting emails and numbers with regex
# Demonstrates: بحث_شامل، بحث_نمطي
#
# Run:  python apl.py examples/116-re-emails.apl

المتغير نص = "للتواصل: ahmed@example.com أو support@company.org، والهاتف 01012345678 أو الرقم الموحد 16123"

المتغير بريدات = بحث_شامل("[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+", نص)
اطبع "البريدات المستخرجة:", بريدات

المتغير أرقام = بحث_شامل("[0-9]+", نص)
اطبع "الأرقام المستخرجة:", أرقام

المتغير م = بحث_نمطي("@", نص)
اطبع "أول @ في الموضع:", م.start()
