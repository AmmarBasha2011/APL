# مثال 125 — حسابات التواريخ والمدد
# Date arithmetic and durations
# Demonstrates: التاريخ_اليوم، تاريخ، مدة، أيام
#
# Run:  python apl.py examples/125-datetime-arithmetic.apl

المتغير اليوم = التاريخ_اليوم()
اطبع "اليوم:", اليوم
اطبع "بعد 30 يوماً:", اليوم + مدة(أيام=30)
اطبع "قبل أسبوعين:", اليوم - مدة(أسابيع=2)

المتغير رأس_السنة = تاريخ(2027, 1, 1)
المتغير فرق = رأس_السنة - اليوم
اطبع "الأيام حتى رأس السنة 2027:", فرق.days

المتغير رحلة = مدة(أيام=3, ساعات=5, دقائق=30)
اطبع "مدة الرحلة بالثواني:", رحلة.total_seconds()
