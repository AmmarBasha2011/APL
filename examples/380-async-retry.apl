# مثال 380 — إعادة المحاولة غير المتزامنة
# Async retry
# Demonstrates: محاولات بتأخير
#
# Run:  python apl.py examples/380-async-retry.apl

المتغير عداد = {"محاولات": 0}

async def خدمة_متذبذبة():
    عداد["محاولات"] = عداد["محاولات"] + 1
    لو عداد["محاولات"] < 3:
        ارجع لا_شيء
    ارجع "نجحت"

async def الرئيسية():
    لكل محاولة في نطاق(1, 6):
        المتغير نتيجة = await خدمة_متذبذبة()
        لو نتيجة != لا_شيء:
            اطبع "المحاولة", محاولة, ":", نتيجة
            توقف
        اطبع "المحاولة", محاولة, ": فشلت، إعادة..."
        await نوم(0.001)

شغل_تزامن(الرئيسية())
