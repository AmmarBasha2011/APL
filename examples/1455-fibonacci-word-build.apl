# مثال 1455 — كلمة فيبوناتشي
# Fibonacci word construction
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1455-fibonacci-word-build.apl

# نبدأ بـ a ثم ab
# كل كلمة هي السابقة مضافاً إليها ما قبلها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة كلمة_فيبو(ن):
  لو ن == 1:
    ارجع "a"
  سابق = "a"
  حالي = "ab"
  لكل ع في نطاق(2, ن):
    تالي = حالي + سابق
    سابق = حالي
    حالي = تالي
  ارجع حالي

تأكد_يساوي(كلمة_فيبو(1), "a", "أولى")
تأكد_يساوي(كلمة_فيبو(2), "ab", "ثانية")
تأكد_يساوي(كلمة_فيبو(4), "abaab", "رابعة")
تأكد_يساوي(طول(كلمة_فيبو(7)), 21, "طول سابعة")
