# مثال 2549 — اقتطاع أول 1 أحرف
# First 1 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2549-truncate-text-to-first-1-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:1]

تأكد_يساوي(ف("hello world"), "h", "حالة 1")
تأكد_يساوي(ف("ab"), "a", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "a", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
