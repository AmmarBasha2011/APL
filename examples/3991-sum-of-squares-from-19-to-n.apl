# مثال 3991 — مجموع المربعات من 19 إلى ن
# Sum of squares from 19
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3991-sum-of-squares-from-19-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(19, ن + 1):
    م = م + ي * ي
  ارجع م

تأكد_يساوي(ف(19), 361, "حالة 1")
تأكد_يساوي(ف(20), 761, "حالة 2")
تأكد_يساوي(ف(29), 6446, "حالة 3")
تأكد_يساوي(ف(100), 336241, "حالة 4")
