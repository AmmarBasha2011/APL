# مثال 2845 — ضرب كل عنصر في 21
# Multiply each item by 21
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2845-list-multiply-each-by-21.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 21]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [63, 21, 42], "حالة 1")
تأكد_يساوي(ف([5]), [105], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [21, 42, 63, 84, 105, 126], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-42, 0, 147, 147, 84], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [210, 420, 210, 630, 420, 210], "حالة 5")
