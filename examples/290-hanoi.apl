# مثال 290 — أبراج هانوي
# Tower of Hanoi
# Demonstrates: عودية كلاسيكية
#
# Run:  python apl.py examples/290-hanoi.apl

دالة هانوي(ن, من, إلى, مساعد):
    لو ن == 1:
        اطبع "انقل قرصا من", من, "إلى", إلى
        ارجع
    هانوي(ن - 1, من, مساعد, إلى)
    اطبع "انقل قرصا من", من, "إلى", إلى
    هانوي(ن - 1, مساعد, إلى, من)

هانوي(3, "أ", "ج", "ب")
