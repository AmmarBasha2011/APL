# مثال 269 — موقف سيارات
# Parking lot
# Demonstrates: أماكن وشاغل/فارغ، حساب رسوم
#
# Run:  python apl.py examples/269-parking.apl

صنف موقف:
    دالة_إنشاء(ذات, سعة):
        ذات.أماكن = ["فارغ" لكل _ في نطاق(سعة)]

    دالة أوقف(ذات, لوحة):
        لكل ي في نطاق(طول(ذات.أماكن)):
            لو ذات.أماكن[ي] == "فارغ":
                ذات.أماكن[ي] = لوحة
                ارجع ي
        ارجع -1

    دالة غادر(ذات, لوحة, ساعات):
        لكل ي في نطاق(طول(ذات.أماكن)):
            لو ذات.أماكن[ي] == لوحة:
                ذات.أماكن[ي] = "فارغ"
                ارجع ساعات * 10
        ارجع 0

    دالة متاح(ذات):
        المتغير عدد = 0
        لكل مكان في ذات.أماكن:
            لو مكان == "فارغ":
                عدد = عدد + 1
        ارجع عدد

المتغير م = موقف(5)
اطبع "ركن في مكان:", م.أوقف("أ ب ج 123")
اطبع "ركن في مكان:", م.أوقف("س ص ع 456")
اطبع "متاح:", م.متاح()
اطبع "رسوم 3 ساعات:", م.غادر("أ ب ج 123", 3)
اطبع "متاح:", م.متاح()
