# مثال 3835 — آخر رقم من ن×19
# Last digit of n times 19
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3835-last-digit-of-n-times-19.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 19) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 9, "حالة 2")
تأكد_يساوي(ف(7), 3, "حالة 3")
تأكد_يساوي(ف(12), 8, "حالة 4")
تأكد_يساوي(ف(99), 1, "حالة 5")
