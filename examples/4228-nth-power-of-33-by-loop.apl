# مثال 4228 — قوة 33 بالحلقة
# Power of 33 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4228-nth-power-of-33-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 33
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 33, "حالة 2")
تأكد_يساوي(ف(3), 35937, "حالة 3")
تأكد_يساوي(ف(6), 1291467969, "حالة 4")
تأكد_يساوي(ف(10), 1531578985264449, "حالة 5")
