# مثال 314 — متتالية انظر وقل
# Look and say
# Demonstrates: قراءة الحد بالوصف
#
# Run:  python apl.py examples/314-look-and-say.apl

دالة انظر_وقل(حد):
    المتغير نتيجة = ""
    المتغير ي = 0
    طالما ي < طول(حد):
        المتغير عدد = 1
        طالما ي + عدد < طول(حد) و حد[ي + عدد] == حد[ي]:
            عدد = عدد + 1
        نتيجة = نتيجة + نص(عدد) + حد[ي]
        ي = ي + عدد
    ارجع نتيجة

المتغير حد = "1"
لكل _ في نطاق(6):
    اطبع حد
    حد = انظر_وقل(حد)
