# مثال 3508 — الحد النوني بخطوة 44
# Nth term step 44
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3508-nth-term-arithmetic-sequence-step-44.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 44

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 47, "حالة 2")
تأكد_يساوي(ف(10), 399, "حالة 3")
تأكد_يساوي(ف(100), 4359, "حالة 4")
