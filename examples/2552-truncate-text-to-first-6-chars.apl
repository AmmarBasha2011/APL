# مثال 2552 — اقتطاع أول 6 أحرف
# First 6 chars
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2552-truncate-text-to-first-6-chars.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[:6]

تأكد_يساوي(ف("hello world"), "hello ", "حالة 1")
تأكد_يساوي(ف("ab"), "ab", "حالة 2")
تأكد_يساوي(ف("abcdefghijkl"), "abcdef", "حالة 3")
تأكد_يساوي(ف(""), "", "حالة 4")
