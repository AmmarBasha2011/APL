# مثال 288 — حروف لوحة الهاتف
# Phone keypad letter combinations
# Demonstrates: تراجع على خريطة أرقام-حروف
#
# Run:  python apl.py examples/288-phone-letters.apl

المتغير خريطة = {"2": "abc", "3": "def", "4": "ghi", "5": "jkl", "6": "mno", "7": "pqrs", "8": "tuv", "9": "wxyz"}

دالة ولد(أرقام, مؤشر, حالية, نتيجة):
    لو مؤشر == طول(أرقام):
        نتيجة.أضف(حالية)
        ارجع
    لكل حرف في خريطة[أرقام[مؤشر]]:
        ولد(أرقام, مؤشر + 1, حالية + حرف, نتيجة)

دالة تركيبات(أرقام):
    لو طول(أرقام) == 0:
        ارجع []
    المتغير نتيجة = []
    ولد(أرقام, 0, "", نتيجة)
    ارجع نتيجة

اطبع تركيبات("23")
اطبع "عدد تركيبات 234:", طول(تركيبات("234"))
