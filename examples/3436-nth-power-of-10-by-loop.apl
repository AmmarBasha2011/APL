# مثال 3436 — قوة 10 بالحلقة
# Power of 10 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3436-nth-power-of-10-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 10
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 10, "حالة 2")
تأكد_يساوي(ف(3), 1000, "حالة 3")
تأكد_يساوي(ف(6), 1000000, "حالة 4")
تأكد_يساوي(ف(10), 10000000000, "حالة 5")
