# مثال 223 — ROT13
# ROT13 encoding
# Demonstrates: إزاحة ثابتة ذاتية العكس
#
# Run:  python apl.py examples/223-rot13.apl

دالة روت13(نص_الدخل):
    المتغير نتيجة = ""
    لكل حرف في نص_الدخل:
        لو حرف >= "a" و حرف <= "z":
            نتيجة = نتيجة + فك_ترميز_حرف((ترميز_حرف(حرف) - 97 + 13) % 26 + 97)
        الا لو حرف >= "A" و حرف <= "Z":
            نتيجة = نتيجة + فك_ترميز_حرف((ترميز_حرف(حرف) - 65 + 13) % 26 + 65)
        الا:
            نتيجة = نتيجة + حرف
    ارجع نتيجة

المتغير مشفر = روت13("APL Language")
اطبع "مشفر:", مشفر
اطبع "مرتين = الأصل:", روت13(مشفر)
