# مثال 165 — قراءة بيانات من XML
# Reading data from XML
# Demonstrates: إكس_إم_إل_من_نص، تجد_الكل، تجد_نص، اقرأ_خاصية
#
# Run:  python apl.py examples/165-xml-parse.apl

المتغير نص = "<مكتبة><كتاب id='1'><عنوان>أساسيات البرمجة</عنوان><سعر>120</سعر></كتاب><كتاب id='2'><عنوان>لغة APL</عنوان><سعر>150</سعر></كتاب></مكتبة>"

المتغير جذر = إكس_إم_إل_من_نص(نص)
المتغير كتب = تجد_الكل(جذر, "كتاب")
اطبع "عدد الكتب:", طول(كتب)

لكل كتاب في كتب:
    اطبع "-", تجد_نص(كتاب, "عنوان"), ":", تجد_نص(كتاب, "سعر"), "جنيه، معرف:", اقرأ_خاصية(كتاب, "id")

اطبع "أول كتاب:", تجد_نص(جذر, "كتاب/عنوان")
