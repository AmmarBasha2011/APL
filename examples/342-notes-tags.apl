# مثال 342 — ملاحظات بوسوم
# Notes with tags
# Demonstrates: بحث بالوسم في JSON
#
# Run:  python apl.py examples/342-notes-tags.apl

المتغير مسار = "/tmp/apl_notes_342.json"

المتغير ملاحظات = [
    {"نص": "اشتري حليبا", "وسوم": ["تسوق", "منزل"]},
    {"نص": "راجع PR الريبو", "وسوم": ["عمل", "APL"]},
    {"نص": "موعد الدكتور", "وسوم": ["صحة"]},
    {"نص": "حدّث التوثيق", "وسوم": ["عمل", "APL"]}
]

اكتب_ملف_جسون(ملاحظات, مسار)
المتغير محملة = اقرأ_ملف_جسون(مسار)

اطبع "ملاحظات وسم عمل:"
لكل م in محملة:
    لو "عمل" في م["وسوم"]:
        اطبع " -", م["نص"]

احذف_ملف(مسار)
