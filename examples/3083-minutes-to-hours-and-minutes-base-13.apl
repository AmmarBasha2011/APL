# مثال 3083 — تحويل وحدة بأساس 13
# Split by base 13
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3083-minutes-to-hours-and-minutes-base-13.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 13, ن % 13]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [4, 7], "حالة 2")
تأكد_يساوي(ف(60), [4, 8], "حالة 3")
تأكد_يساوي(ف(125), [9, 8], "حالة 4")
تأكد_يساوي(ف(1000), [76, 12], "حالة 5")
