# مثال 3784 — مجموع زوايا مضلع زائد 22
# Polygon angle sum plus 22
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3784-interior-angle-sum-of-polygon-plus-22.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 22

تأكد_يساوي(ف(3), 202, "حالة 1")
تأكد_يساوي(ف(4), 382, "حالة 2")
تأكد_يساوي(ف(5), 562, "حالة 3")
تأكد_يساوي(ف(6), 742, "حالة 4")
تأكد_يساوي(ف(12), 1822, "حالة 5")
