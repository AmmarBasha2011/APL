# مثال 251 — حاسبة كتلة الجسم
# BMI calculator
# Demonstrates: حساب وتصنيف
#
# Run:  python apl.py examples/251-bmi.apl

دالة كتلة_الجسم(وزن_كجم, طول_م):
    ارجع وزن_كجم / (طول_م * طول_م)

دالة صنف_الكتلة(قيمة):
    لو قيمة < 18.5:
        ارجع "نحافة"
    الا لو قيمة < 25:
        ارجع "طبيعي"
    الا لو قيمة < 30:
        ارجع "زيادة وزن"
    الا:
        ارجع "سمنة"

لكل شخص في [{"اسم": "أحمد", "وزن": 70, "طول": 1.75}, {"اسم": "سارة", "وزن": 55, "طول": 1.60}, {"اسم": "خالد", "وزن": 95, "طول": 1.70}]:
    المتغير قيمة = كتلة_الجسم(شخص["وزن"], شخص["طول"])
    اطبع شخص["اسم"], ":", مقرب(قيمة, 1), "-", صنف_الكتلة(قيمة)
