# مثال 178 — الخواص المحسوبة والمحددات
# Properties and setters
# Demonstrates: خاصية، محدد، صنف
#
# Run:  python apl.py examples/178-decorators-property.apl

صنف حرارة:
    دالة_إنشاء(ذات, مئوي):
        ذات._مئوي = مئوي

    خاصية مئوي:
        ارجع ذات._مئوي

    محدد مئوي:
        ذات._مئوي = قيمة

    خاصية فهرنهايت:
        ارجع ذات._مئوي * 9 / 5 + 32

    خاصية كلفن:
        ارجع ذات._مئوي + 273.15

المتغير ح = حرارة(25)
اطبع "مئوي:", ح.مئوي
اطبع "فهرنهايت:", ح.فهرنهايت
اطبع "كلفن:", ح.كلفن

ح.مئوي = 100
اطبع "بعد التعديل فهرنهايت:", ح.فهرنهايت
