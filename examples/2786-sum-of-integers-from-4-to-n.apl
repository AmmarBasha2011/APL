# مثال 2786 — مجموع الأعداد من 4 إلى ن
# Sum from 4 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2786-sum-of-integers-from-4-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(4, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(4), 4, "حالة 1")
تأكد_يساوي(ف(5), 9, "حالة 2")
تأكد_يساوي(ف(14), 99, "حالة 3")
تأكد_يساوي(ف(100), 5044, "حالة 4")
