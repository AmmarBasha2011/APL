# مثال 4427 — قوة 39 بالحلقة
# Power of 39 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4427-nth-power-of-39-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 39
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 39, "حالة 2")
تأكد_يساوي(ف(3), 59319, "حالة 3")
تأكد_يساوي(ف(6), 3518743761, "حالة 4")
تأكد_يساوي(ف(10), 8140406085191601, "حالة 5")
