# مثال 2147 — رتبة التبديلة بالترتيب المعجمي
# Permutation rank
# Demonstrates: توافيق
#
# Run:  python apl.py examples/2147-permutation-lexicographic-rank-factorial.apl

# # الرتبة تبدأ من صفر
# # نحذف الحرف بعد استخدامه

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة رتبة(س):
  باقي = sorted(س)
  رتب = 0
  مض = 1
  لكل ك في نطاق(2, طول(س)):
    مض = مض * ك
  لكل ك في نطاق(طول(س)):
    موضع = باقي.index(س[ك])
    رتب = رتب + موضع * مض
    باقي.pop(موضع)
    لو طول(س) - 1 - ك > 0:
      مض = مض // (طول(س) - 1 - ك)
  ارجع رتب

تأكد_يساوي(رتبة("abc"), 0, "الأولى")
تأكد_يساوي(رتبة("bca"), 3, "الرابعة")
تأكد_يساوي(رتبة("cba"), 5, "الأخيرة")
