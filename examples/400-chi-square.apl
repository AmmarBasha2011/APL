# مثال 400 — احتمالات بسيطة
# Simple probabilities
# Demonstrates: توزيع نتائج حجرتين نرد
#
# Run:  python apl.py examples/400-chi-square.apl

المتغير تكرار = {}
لكل أ في نطاق(1, 7):
    لكل ب في نطاق(1, 7):
        المتغير مجموع_نرد = أ + ب
        المتغير قديم = تكرار.get(مجموع_نرد, 0)
        تكرار[مجموع_نرد] = قديم + 1

اطبع "توزيع مجموع نردين:"
لكل مجموع_نرد في نطاق(2, 13):
    المتغير احتمال = تكرار[مجموع_نرد] / 36 * 100
    اطبع مجموع_نرد, "->", نص(احتمال) + "%"
