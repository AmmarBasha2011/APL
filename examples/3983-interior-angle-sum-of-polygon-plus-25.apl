# مثال 3983 — مجموع زوايا مضلع زائد 25
# Polygon angle sum plus 25
# Demonstrates: هندسة
#
# Run:  python apl.py examples/3983-interior-angle-sum-of-polygon-plus-25.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن - 2) * 180 + 25

تأكد_يساوي(ف(3), 205, "حالة 1")
تأكد_يساوي(ف(4), 385, "حالة 2")
تأكد_يساوي(ف(5), 565, "حالة 3")
تأكد_يساوي(ف(6), 745, "حالة 4")
تأكد_يساوي(ف(12), 1825, "حالة 5")
