# مثال 115 — تنسيق التقارير النصية
# Text report formatting
# Demonstrates: التفاف_نص، اختصار_نص، إزاحة_نص
#
# Run:  python apl.py examples/115-textwrap-report.apl

المتغير خبر = "أطلقت الشركة اليوم منتجها الجديد الذي يهدف إلى تحسين تجربة المستخدمين في التعامل مع التقنية بشكل يومي وبأسعار مناسبة للجميع"

اطبع "=== النص ملفوفاً في 40 عموداً ==="
اطبع الالتفاف_نص(خبر, 40)

اطبع ""
اطبع "=== مختصراً ==="
اطبع اختصار_نص(خبر, 50)

اطبع ""
اطبع "=== مع إزاحة ==="
اطبع إزاحة_نص(الالتفاف_نص(خبر, 36), "  » ")
