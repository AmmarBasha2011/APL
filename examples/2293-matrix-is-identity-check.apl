# مثال 2293 — هل هي مصفوفة الوحدة
# Is identity
# Demonstrates: مصفوفات
#
# Run:  python apl.py examples/2293-matrix-is-identity-check.apl

# # مصفوفة من قوائم
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  لكل ي في نطاق(طول(م)):
    لكل ك في نطاق(طول(م)):
      لو ي == ك و م[ي][ك] != 1:
        ارجع خطأ
      لو ي != ك و م[ي][ك] != 0:
        ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف([[1, 2], [3, 4]]), خطأ, "حالة 1")
تأكد_يساوي(ف([[5]]), خطأ, "حالة 2")
تأكد_يساوي(ف([[1, 2, 3], [4, 5, 6], [7, 8, 9]]), خطأ, "حالة 3")
تأكد_يساوي(ف([[0, 1], [1, 0]]), خطأ, "حالة 4")
تأكد_يساوي(ف([[2, -1, 0], [0, 3, 1], [1, 1, 1]]), خطأ, "حالة 5")
تأكد_يساوي(ف([[1, 0], [0, 1]]), صواب, "حالة 6")
