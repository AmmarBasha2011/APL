# مثال 3628 — قوة 12 بالحلقة
# Power of 12 by loop
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3628-nth-power-of-12-by-loop.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ق = 1
  لكل ي في نطاق(ن):
    ق = ق * 12
  ارجع ق

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 12, "حالة 2")
تأكد_يساوي(ف(3), 1728, "حالة 3")
تأكد_يساوي(ف(6), 2985984, "حالة 4")
تأكد_يساوي(ف(10), 61917364224, "حالة 5")
