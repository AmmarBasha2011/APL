# مثال 3937 — مجموع الأعداد من 37 إلى ن
# Sum from 37 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3937-sum-of-integers-from-37-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(37, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(37), 37, "حالة 1")
تأكد_يساوي(ف(38), 75, "حالة 2")
تأكد_يساوي(ف(47), 462, "حالة 3")
تأكد_يساوي(ف(100), 4384, "حالة 4")
