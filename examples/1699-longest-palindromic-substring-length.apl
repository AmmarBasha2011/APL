# مثال 1699 — أطول جزء متناظر
# Longest palindromic substring length
# Demonstrates: نصوص
#
# Run:  python apl.py examples/1699-longest-palindromic-substring-length.apl

# نجرب مركزاً فردياً وزوجياً
# نوسع ما دام الطرفان متساويين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة توسيع(س, ي, ك):
  طالما ي >= 0 و ك < طول(س) و س[ي] == س[ك]:
    ي = ي - 1
    ك = ك + 1
  ارجع ك - ي - 1

دالة أطول_متناظر(س):
  أفضل = 0
  لكل م في نطاق(طول(س)):
    أفضل = أكبر(أفضل, توسيع(س, م, م))
    أفضل = أكبر(أفضل, توسيع(س, م, م + 1))
  ارجع أفضل

تأكد_يساوي(أطول_متناظر("babad"), 3, "ثلاثة")
تأكد_يساوي(أطول_متناظر("cbbd"), 2, "اثنان")
تأكد_يساوي(أطول_متناظر("a"), 1, "حرف")
