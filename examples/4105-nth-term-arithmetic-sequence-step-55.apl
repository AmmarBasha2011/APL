# مثال 4105 — الحد النوني بخطوة 55
# Nth term step 55
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4105-nth-term-arithmetic-sequence-step-55.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 55

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 58, "حالة 2")
تأكد_يساوي(ف(10), 498, "حالة 3")
تأكد_يساوي(ف(100), 5448, "حالة 4")
