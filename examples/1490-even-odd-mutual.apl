# مثال 1490 — زوجي وفردي بتراجع متبادل
# Even odd by mutual recursion
# Demonstrates: تراجع
#
# Run:  python apl.py examples/1490-even-odd-mutual.apl

# الصفر زوجي
# العدد زوجي إذا كان سابقه فردياً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة زوجي_ت(ن):
  لو ن == 0:
    ارجع صواب
  ارجع فردي_ت(ن - 1)

دالة فردي_ت(ن):
  لو ن == 0:
    ارجع خطأ
  ارجع زوجي_ت(ن - 1)

تأكد_يساوي(زوجي_ت(10), صواب, "عشرة")
تأكد_يساوي(فردي_ت(7), صواب, "سبعة")
تأكد_يساوي(زوجي_ت(7), خطأ, "سبعة ليست زوجية")
