# مثال 319 — المعكوس الضربي التراكبي
# Modular multiplicative inverse
# Demonstrates: خوارزمية إقليدس الممتدة
#
# Run:  python apl.py examples/319-modular-inverse.apl

دالة معكوس_تراكبي(أ, م):
    المتغير م0 = م
    المتغير س = 1
    المتغير ص = 0
    طالما أ > 1:
        المتغير خارج = أ // م
        المتغير مؤقت = م
        م = أ % م
        أ = مؤقت
        مؤقت = ص
        ص = س - خارج * ص
        س = مؤقت
    لو س < 0:
        س = س + م0
    ارجع س

اطبع "معكوس 3 mod 11 =", معكوس_تراكبي(3, 11)
اطبع "تحقق: 3 × 4 mod 11 =", (3 * 4) % 11
اطبع "معكوس 10 mod 17 =", معكوس_تراكبي(10, 17)
