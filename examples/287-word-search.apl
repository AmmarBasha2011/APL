# مثال 287 — البحث عن كلمة في شبكة
# Word search in a grid
# Demonstrates: تراجع رباعي الاتجاهات
#
# Run:  python apl.py examples/287-word-search.apl

دالة ابحث_من(شبكة, كلمة, س, ص, مؤشر, مزارة):
    لو مؤشر == طول(كلمة):
        ارجع صواب
    لو س < 0 أو ص < 0 أو س >= طول(شبكة) أو ص >= طول(شبكة[0]):
        ارجع خطأ
    لو شبكة[س][ص] != كلمة[مؤشر]:
        ارجع خطأ
    المتغير مفتاح = نص(س) + "," + نص(ص)
    لو مفتاح في مزارة:
        ارجع خطأ
    مزارة[مفتاح] = صواب
    المتغير تم_العثور = ابحث_من(شبكة, كلمة, س + 1, ص, مؤشر + 1, مزارة) أو ابحث_من(شبكة, كلمة, س - 1, ص, مؤشر + 1, مزارة) أو ابحث_من(شبكة, كلمة, س, ص + 1, مؤشر + 1, مزارة) أو ابحث_من(شبكة, كلمة, س, ص - 1, مؤشر + 1, مزارة)
    لو ليس تم_العثور:
        مزارة.pop(مفتاح)
    ارجع تم_العثور

دالة موجودة(شبكة, كلمة):
    لكل س في نطاق(طول(شبكة)):
        لكل ص في نطاق(طول(شبكة[0])):
            لو ابحث_من(شبكة, كلمة, س, ص, 0, {}):
                ارجع صواب
    ارجع خطأ

المتغير شبكة = [
    ["A", "B", "C", "E"],
    ["S", "F", "C", "S"],
    ["A", "D", "E", "E"]
]
اطبع "ABCCED:", موجودة(شبكة, "ABCCED")
اطبع "SEE:", موجودة(شبكة, "SEE")
اطبع "ABCB:", موجودة(شبكة, "ABCB")
