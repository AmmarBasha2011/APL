# مثال 1187 — من وسطي إلى لاحق
# Infix to postfix converter
# Demonstrates: شنتنغ يارد
#
# Run:  python apl.py examples/1187-infix-to-postfix.apl

# نرتب العمليات بحسب أولويتها
# ونفرغ المكدس عند ظهور عملية أقل أولوية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة اولوية(ع):
  لو ع في "*/":
    ارجع 2
  لو ع في "+-":
    ارجع 1
  ارجع 0

دالة الى_لاحق(رموز):
  ناتج = []
  مكدس = []
  لكل ر في رموز:
    لو ر.isdigit():
      ناتج.ألحق(ر)
    والا_لو ر == "(":
      مكدس.ألحق(ر)
    والا_لو ر == ")":
      طالما مكدس[-1] != "(":
        ناتج.ألحق(مكدس.pop())
      مكدس.pop()
    والا:
      طالما (طول(مكدس) > 0) و (اولوية(مكدس[-1]) >= اولوية(ر)):
        ناتج.ألحق(مكدس.pop())
      مكدس.ألحق(ر)
  طالما طول(مكدس) > 0:
    ناتج.ألحق(مكدس.pop())
  ارجع ناتج

تأكد_يساوي(الى_لاحق(["1","+","2","*","3"]), ["1","2","3","*","+"], "أولوية")
تأكد_يساوي(الى_لاحق(["(","1","+","2",")","*","3"]), ["1","2","+","3","*"], "قوس")
تأكد_يساوي(الى_لاحق(["8","-","3","-","2"]), ["8","3","-","2","-"], "ترابط يساري")
