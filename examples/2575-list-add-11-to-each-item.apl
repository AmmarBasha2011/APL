# مثال 2575 — إضافة 11 لكل عنصر
# Add 11 to each item
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2575-list-add-11-to-each-item.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع + 11]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [14, 12, 13], "حالة 1")
تأكد_يساوي(ف([5]), [16], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [12, 13, 14, 15, 16, 17], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [9, 11, 18, 18, 15], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [21, 31, 21, 41, 31, 21], "حالة 5")
