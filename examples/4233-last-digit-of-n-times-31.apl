# مثال 4233 — آخر رقم من ن×31
# Last digit of n times 31
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4233-last-digit-of-n-times-31.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن * 31) % 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(7), 7, "حالة 3")
تأكد_يساوي(ف(12), 2, "حالة 4")
تأكد_يساوي(ف(99), 9, "حالة 5")
