# مثال 3332 — مجموع قوى 36
# Sum of powers of 36
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3332-sum-of-powers-of-36-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 36 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 37, "حالة 2")
تأكد_يساوي(ف(3), 47989, "حالة 3")
تأكد_يساوي(ف(6), 2238976117, "حالة 4")
تأكد_يساوي(ف(10), 3760620109779061, "حالة 5")
