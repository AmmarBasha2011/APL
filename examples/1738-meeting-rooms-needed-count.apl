# مثال 1738 — عدد قاعات الاجتماعات
# Minimum meeting rooms needed
# Demonstrates: فترات
#
# Run:  python apl.py examples/1738-meeting-rooms-needed-count.apl

# نفرز البدايات والنهايات
# نتتبع العدد الحالي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة قاعات(اجتماعات):
  بدايات = []
  نهايات = []
  لكل ا في اجتماعات:
    بدايات.append(ا[0])
    نهايات.append(ا[1])
  بدايات.sort()
  نهايات.sort()
  ي = 0
  ك = 0
  حالي = 0
  أعلى = 0
  طالما ي < طول(بدايات):
    لو بدايات[ي] < نهايات[ك]:
      حالي = حالي + 1
      ي = ي + 1
      أعلى = أكبر(أعلى, حالي)
    والا:
      حالي = حالي - 1
      ك = ك + 1
  ارجع أعلى

تأكد_يساوي(قاعات([[0, 30], [5, 10], [15, 20]]), 2, "اثنتان")
تأكد_يساوي(قاعات([[1, 2], [3, 4]]), 1, "واحدة")
تأكد_يساوي(قاعات([[1, 5], [2, 6], [3, 7]]), 3, "ثلاث")
