# مثال 1907 — دمج قائمتين مرتبتين
# Merge two sorted linked lists
# Demonstrates: هياكل بيانات
#
# Run:  python apl.py examples/1907-merge-two-sorted-linked-lists.apl

# نقارن رأسي القائمتين
# نأخذ الأصغر ونتقدم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة دمج(قيم1, قيم2):
  خرج = []
  أ = 0
  ب = 0
  طالما أ < طول(قيم1) و ب < طول(قيم2):
    لو قيم1[أ] <= قيم2[ب]:
      خرج = خرج + [قيم1[أ]]
      أ = أ + 1
    والا:
      خرج = خرج + [قيم2[ب]]
      ب = ب + 1
  لكل ك في نطاق(أ, طول(قيم1)):
    خرج = خرج + [قيم1[ك]]
  لكل ك في نطاق(ب, طول(قيم2)):
    خرج = خرج + [قيم2[ك]]
  ارجع خرج

تأكد_يساوي(دمج([1, 3, 5], [2, 4, 6]), [1, 2, 3, 4, 5, 6], "متداخلة")
تأكد_يساوي(دمج([], [1, 2]), [1, 2], "الأولى فارغة")
تأكد_يساوي(دمج([1, 1], [1]), [1, 1, 1], "مكررة")
