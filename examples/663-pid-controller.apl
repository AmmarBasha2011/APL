# مثال 663 — متحكم PID
# PID controller
# Demonstrates: PID، نسبي تكاملي تفاضلي، استقرار
#
# Run:  python apl.py examples/663-pid-controller.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# متحكم PID: تنظيم بثلاثة حدود
# Demonstrates: خطأ نسبي وتكاملي وتفاضلي, محاكاة نظام, استقرار
# هكذا تثبت الروبوتات والأفران على الهدف

هدف = 100.0
موضع = 0.0
تكامل = 0.0
انحراف_سابق = 0.0
ك_ن = 0.6
ك_ت = 0.1
ك_خ = 0.05

لكل خطوة في نطاق(400):
  انحراف = هدف - موضع
  تكامل = تكامل + انحراف
  تفاضل = خطأ - انحراف_سابق
  دفع = ك_ن * انحراف + ك_ت * تكامل + ك_خ * تفاضل
  لو دفع > 20.0:
    دفع = 20.0
  لو دفع < 0 - 20.0:
    دفع = 0 - 20.0
  موضع = موضع + دفع * 0.1
  انحراف_سابق = خطأ

تأكد_يساوي(موضع > 99.0 و موضع < 101.0, صواب, "استقر قرب الهدف")
تأكد_يساوي(انحراف > 0 - 1.0 و انحراف < 1.0, صواب, "انحراف أخير صغير")
اطبع "موضع نهائي:", موضع
