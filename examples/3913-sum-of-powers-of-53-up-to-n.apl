# مثال 3913 — مجموع قوى 53
# Sum of powers of 53
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3913-sum-of-powers-of-53-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 53 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 54, "حالة 2")
تأكد_يساوي(ف(3), 151740, "حالة 3")
تأكد_يساوي(ف(6), 22590598843, "حالة 4")
تأكد_يساوي(ف(10), 178250690949465223, "حالة 5")
