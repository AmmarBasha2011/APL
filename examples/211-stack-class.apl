# مثال 211 — المكدس كصنف
# Stack as a class
# Demonstrates: صنف، أضف، pop، peek
#
# Run:  python apl.py examples/211-stack-class.apl

صنف مكدس:
    دالة_إنشاء(ذات):
        ذات.عناصر = []

    دالة ادفع(ذات, عنصر):
        ذات.عناصر.أضف(عنصر)

    دالة اسحب(ذات):
        لو ذات.فارغ():
            ارجع "مكدس فارغ"
        ارجع ذات.عناصر.pop()

    دالة قمة(ذات):
        لو ذات.فارغ():
            ارجع "مكدس فارغ"
        ارجع ذات.عناصر[-1]

    دالة فارغ(ذات):
        ارجع طول(ذات.عناصر) == 0

    دالة حجم_المكدس(ذات):
        ارجع طول(ذات.عناصر)

المتغير م = مكدس()
م.ادفع(10)
م.ادفع(20)
م.ادفع(30)
اطبع "القمة:", م.قمة()
اطبع "اسحب:", م.اسحب()
اطبع "الحجم:", م.حجم_المكدس()
