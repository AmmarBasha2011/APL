# مثال 1228 — عد الأوليات
# Count primes with bit sieve
# Demonstrates: غربال
#
# Run:  python apl.py examples/1228-count-primes-segment.apl

# نشطب مضاعفات كل أولي بدءاً من مربعه
# ونعد ما بقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عد_اوليات(ن):
  لو ن < 3:
    ارجع 0
  اولي = [صواب] * ن
  اولي[0] = خطأ
  اولي[1] = خطأ
  ع = 2
  طالما ع * ع < ن:
    لو اولي[ع]:
      لكل ك في نطاق(ع * ع, ن, ع):
        اولي[ك] = خطأ
    ع = ع + 1
  ناتج = 0
  لكل ق في اولي:
    لو ق:
      ناتج = ناتج + 1
  ارجع ناتج

تأكد_يساوي(عد_اوليات(10), 4, "عشرة")
تأكد_يساوي(عد_اوليات(100), 25, "مئة")
تأكد_يساوي(عد_اوليات(2), 0, "اثنان")
تأكد_يساوي(عد_اوليات(1000), 168, "ألف")
