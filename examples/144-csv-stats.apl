# مثال 144 — إحصاءات على عمود CSV
# Statistics over a CSV column
# Demonstrates: اقرأ_csv، صحيح، متوسط
#
# Run:  python apl.py examples/144-csv-stats.apl

المتغير نص = "المنتج,الكمية,السعر\nتفاح,10,5\nموز,20,3\nعنب,15,8"
المتغير صفوف = قائمة(اقرأ_csv(نص.تقسيم("\n")))

المتغير كميات = []
المتغير إجمالي_مبيعات = 0
لكل صف في صفوف[1:]:
    كميات.أضف(صحيح(صف[1]))
    إجمالي_مبيعات = إجمالي_مبيعات + صحيح(صف[1]) * صحيح(صف[2])

اطبع "الكميات:", كميات
اطبع "متوسط الكمية:", متوسط(كميات)
اطبع "إجمالي المبيعات:", إجمالي_مبيعات
