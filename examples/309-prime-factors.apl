# مثال 309 — العوامل الأولية
# Prime factorization
# Demonstrates: القسمة المتكررة على العوامل
#
# Run:  python apl.py examples/309-prime-factors.apl

دالة عوامل_أولية(عدد):
    المتغير عوامل = []
    المتغير قاسم = 2
    طالما قاسم * قاسم <= عدد:
        طالما عدد % قاسم == 0:
            عوامل.أضف(قاسم)
            عدد = عدد // قاسم
        قاسم = قاسم + 1
    لو عدد > 1:
        عوامل.أضف(عدد)
    ارجع عوامل

اطبع "12 =", عوامل_أولية(12)
اطبع "315 =", عوامل_أولية(315)
اطبع "97 =", عوامل_أولية(97)
