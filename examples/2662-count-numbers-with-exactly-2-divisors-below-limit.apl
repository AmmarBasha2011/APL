# مثال 2662 — أعداد لها 2 قواسم
# Numbers with exactly 2 divisors
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2662-count-numbers-with-exactly-2-divisors-below-limit.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ك = 0
  لكل ي في نطاق(1, ن):
    د = 0
    لكل ج في نطاق(1, ي + 1):
      لو ي % ج == 0:
        د = د + 1
    لو د == 2:
      ك = ك + 1
  ارجع ك

تأكد_يساوي(ف(10), 4, "حالة 1")
تأكد_يساوي(ف(30), 10, "حالة 2")
تأكد_يساوي(ف(60), 17, "حالة 3")
