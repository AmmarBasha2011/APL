# مثال 265 — مكتبة كتب بسيطة
# Mini library system
# Demonstrates: إعارة واسترجاع
#
# Run:  python apl.py examples/265-library-books.apl

صنف مكتبة:
    دالة_إنشاء(ذات):
        ذات.كتب = {}

    دالة أضف_كتابا(ذات, عنوان, نسخ):
        ذات.كتب[عنوان] = نسخ

    دالة أعِر(ذات, عنوان):
        لو عنوان ليس في ذات.كتب:
            ارجع "غير موجود"
        لو ذات.كتب[عنوان] == 0:
            ارجع "لا نسخ متاحة"
        ذات.كتب[عنوان] = ذات.كتب[عنوان] - 1
        ارجع "تمت الإعارة"

    دالة استرجع(ذات, عنوان):
        لو عنوان في ذات.كتب:
            ذات.كتب[عنوان] = ذات.كتب[عنوان] + 1

المتغير م = مكتبة()
م.أضف_كتابا("البداية والنهاية", 2)
م.أضف_كتابا("مقدمة ابن خلدون", 1)
اطبع م.أعِر("البداية والنهاية")
اطبع م.أعِر("مقدمة ابن خلدون")
اطبع م.أعِر("مقدمة ابن خلدون")
م.استرجع("مقدمة ابن خلدون")
اطبع م.أعِر("مقدمة ابن خلدون")
