# مثال 1846 — ثلاثيات مجموعها صفر
# Count triplets summing to zero
# Demonstrates: مؤشران
#
# Run:  python apl.py examples/1846-three-sum-zero-count.apl

# نرتب القائمة
# نتجاوز المكرر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ثلاثيات(ق):
  ق = ق + []
  ق.sort()
  عد = 0
  لكل ي في نطاق(طول(ق) - 2):
    لو ي == 0 أو ق[ي] != ق[ي - 1]:
      ك = ي + 1
      ج = طول(ق) - 1
      طالما ك < ج:
        مجموع = ق[ي] + ق[ك] + ق[ج]
        لو مجموع == 0:
          عد = عد + 1
          ك = ك + 1
          طالما ك < ج و ق[ك] == ق[ك - 1]:
            ك = ك + 1
        والا_لو مجموع < 0:
          ك = ك + 1
        والا:
          ج = ج - 1
  ارجع عد

تأكد_يساوي(ثلاثيات([-1, 0, 1, 2, -1, -4]), 2, "اثنان")
تأكد_يساوي(ثلاثيات([0, 0, 0]), 1, "أصفار")
تأكد_يساوي(ثلاثيات([1, 2, 3]), 0, "لا يوجد")
