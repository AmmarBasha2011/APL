# مثال 670 — المجرية المصغرة للإسناد
# Hungarian-lite assignment
# Demonstrates: إسناد، مصفوفة كلفة، جشع
#
# Run:  python apl.py examples/670-hungarian-lite.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# الخوارزمية المجرية: تعيين بأقل كلفة
# Demonstrates: إمكانات الصفوف والأعمدة, شجرة متناوبة, مسار زيادة
# يوزع العمال على المهام بأقل كلفة كلية في O(n^3)

ن = 3
لانهائي = 1000000
كلفة = [[4, 1, 3], [2, 0, 5], [3, 2, 2]]

دالة وسع_عمود(أ, ف, ق, ع, مسار, ص):
  ع[0] = ص
  أدنى = [لانهائي, لانهائي, لانهائي, لانهائي]
  مستخدم = [خطأ, خطأ, خطأ, خطأ]
  ج0 = 0
  طالما صواب:
    مستخدم[ج0] = صواب
    ص0 = ع[ج0]
    دلتا = لانهائي
    ج1 = 0
    لكل ج في نطاق(1, ن + 1):
      لو مستخدم[ج] == خطأ:
        حالية = أ[ص0 - 1][ج - 1] - ف[ص0] - ق[ج]
        لو حالية < أدنى[ج]:
          أدنى[ج] = حالية
          مسار[ج] = ج0
        لو أدنى[ج] < دلتا:
          دلتا = أدنى[ج]
          ج1 = ج
    لكل ج في نطاق(0, ن + 1):
      لو مستخدم[ج]:
        ف[ع[ج]] = ف[ع[ج]] + دلتا
        ق[ج] = ق[ج] - دلتا
      والا:
        أدنى[ج] = أدنى[ج] - دلتا
    ج0 = ج1
    لو ع[ج0] == 0:
      ارجع ج0

دالة مجري(أ):
  ف = [0, 0, 0, 0]
  ق = [0, 0, 0, 0]
  ع = [0, 0, 0, 0]
  مسار = [0, 0, 0, 0]
  لكل ص في نطاق(1, ن + 1):
    ج0 = وسع_عمود(أ, ف, ق, ع, مسار, ص)
    طالما ج0 != 0:
      ج1 = مسار[ج0]
      ع[ج0] = ع[ج1]
      ج0 = ج1
  ارجع [0 - ق[0], ع]

نتيجة = مجري(كلفة)
تأكد_يساوي(نتيجة[0], 5, "أقل كلفة كلية")
تعيين = نتيجة[1]
تأكد_يساوي(كلفة[تعيين[1] - 1][0] + كلفة[تعيين[2] - 1][1] + كلفة[تعيين[3] - 1][2], 5, "التعيين يحقق الكلفة")
اطبع "كلفة:", نتيجة[0]
اطبع "تعيين الأعمدة إلى الصفوف:", تعيين
