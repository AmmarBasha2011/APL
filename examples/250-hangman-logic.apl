# مثال 250 — منطق لعبة الرجل المشنوق
# Hangman logic
# Demonstrates: كشف الحروف تدريجيا، عداد أخطاء
#
# Run:  python apl.py examples/250-hangman-logic.apl

المتغير كلمة = "برمجة"
المتغير تخمينات = ["ب", "م", "ر", "ج", "ة", "x"]
المتغير مكشوف = []
لكل _ في كلمة:
    مكشوف.أضف("_")

المتغير أخطاء = 0
لكل حرف في تخمينات:
    لو حرف في كلمة:
        لكل ي في نطاق(طول(كلمة)):
            لو كلمة[ي] == حرف:
                مكشوف[ي] = حرف
    الا:
        أخطاء = أخطاء + 1
    اطبع " ".ضم(مكشوف), "(أخطاء:", أخطاء, ")"

لو "_" ليس في مكشوف:
    اطبع "فزت!"
