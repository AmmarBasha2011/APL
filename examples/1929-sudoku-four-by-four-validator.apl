# مثال 1929 — التحقق من سودوكو ٤ في ٤
# Validate a four by four sudoku
# Demonstrates: ألعاب
#
# Run:  python apl.py examples/1929-sudoku-four-by-four-validator.apl

# نجمع كل مجموعة من أربع خلايا
# نتأكد أنها تحوي أربع قيم مختلفة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مجموعة_صحيحة(قيم):
  لكل ف في [1, 2, 3, 4]:
    لو (ف في قيم) == خطأ:
      ارجع خطأ
  ارجع صواب

دالة صحيح(ش):
  لكل ص في نطاق(4):
    لو مجموعة_صحيحة(ش[ص]) == خطأ:
      ارجع خطأ
    عمود = []
    لكل ج في نطاق(4):
      عمود = عمود + [ش[ج][ص]]
    لو مجموعة_صحيحة(عمود) == خطأ:
      ارجع خطأ
  لكل ب في [0, 2]:
    لكل ت في [0, 2]:
      مربع = [ش[ب][ت], ش[ب][ت + 1], ش[ب + 1][ت], ش[ب + 1][ت + 1]]
      لو مجموعة_صحيحة(مربع) == خطأ:
        ارجع خطأ
  ارجع صواب

جيد = [[1, 2, 3, 4], [3, 4, 1, 2], [2, 1, 4, 3], [4, 3, 2, 1]]
سيئ = [[1, 2, 3, 4], [3, 4, 1, 2], [2, 1, 4, 3], [4, 3, 1, 2]]
مربع_خاطئ = [[1, 2, 3, 4], [2, 3, 4, 1], [3, 4, 1, 2], [4, 1, 2, 3]]
تأكد_يساوي(صحيح(جيد), صواب, "صحيح")
تأكد_يساوي(صحيح(سيئ), خطأ, "عمود مكرر")
تأكد_يساوي(صحيح(مربع_خاطئ), خطأ, "مربع مكرر")
