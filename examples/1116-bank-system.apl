# مثال 1116 — نظام بنكي بسيط
# Simple bank system
# Demonstrates: التحقق قبل التنفيذ
#
# Run:  python apl.py examples/1116-bank-system.apl

# كل عملية تتحقق من وجود الحساب وكفاية الرصيد
# فلا تنفذ جزئياً أبداً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف بنك:
    دالة_إنشاء(ذات, ارصدة):
        ذات.ارصدة = قائمة(ارصدة)

    دالة صالح(ذات, حساب):
        ارجع (حساب >= 1) و (حساب <= طول(ذات.ارصدة))

    دالة اودع(ذات, حساب, مبلغ):
        لو ليس ذات.صالح(حساب):
            ارجع خطأ
        ذات.ارصدة[حساب - 1] = ذات.ارصدة[حساب - 1] + مبلغ
        ارجع صواب

    دالة اسحب_مبلغ(ذات, حساب, مبلغ):
        لو ليس ذات.صالح(حساب):
            ارجع خطأ
        لو ذات.ارصدة[حساب - 1] < مبلغ:
            ارجع خطأ
        ذات.ارصدة[حساب - 1] = ذات.ارصدة[حساب - 1] - مبلغ
        ارجع صواب

    دالة حول(ذات, من, الى, مبلغ):
        ص1 = ذات.صالح(من)
        ص2 = ذات.صالح(الى)
        لو ليس ص1:
            ارجع خطأ
        لو ليس ص2:
            ارجع خطأ
        لو ليس ذات.اسحب_مبلغ(من, مبلغ):
            ارجع خطأ
        ذات.اودع(الى, مبلغ)
        ارجع صواب

ب = بنك([10, 100, 20, 50, 30])
تأكد_يساوي(ب.اسحب_مبلغ(3, 10), صواب, "سحب ناجح")
تأكد_يساوي(ب.حول(5, 1, 20), صواب, "تحويل ناجح")
تأكد_يساوي(ب.اودع(5, 20), صواب, "إيداع")
تأكد_يساوي(ب.حول(3, 4, 15), خطأ, "رصيد غير كاف")
تأكد_يساوي(ب.اسحب_مبلغ(10, 50), خطأ, "حساب غير موجود")
تأكد_يساوي(ب.ارصدة, [30, 100, 10, 50, 30], "الأرصدة النهائية")
