# مثال 3753 — السعر بعد خصم 33 بالمئة
# Price after 33 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3753-price-after-33-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 33 // 100

تأكد_يساوي(ف(100), 67, "حالة 1")
تأكد_يساوي(ف(250), 168, "حالة 2")
تأكد_يساوي(ف(999), 670, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
