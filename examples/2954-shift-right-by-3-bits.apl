# مثال 2954 — إزاحة يمين 3
# Shift right by 3
# Demonstrates: بتات
#
# Run:  python apl.py examples/2954-shift-right-by-3-bits.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 3

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(16), 2, "حالة 2")
تأكد_يساوي(ف(255), 31, "حالة 3")
تأكد_يساوي(ف(1000), 125, "حالة 4")
تأكد_يساوي(ف(65535), 8191, "حالة 5")
