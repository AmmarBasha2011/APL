# مثال 3134 — ضرب كل عنصر في 32
# Multiply each item by 32
# Demonstrates: قوائم
#
# Run:  python apl.py examples/3134-list-multiply-each-by-32.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 32]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [96, 32, 64], "حالة 1")
تأكد_يساوي(ف([5]), [160], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [32, 64, 96, 128, 160, 192], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-64, 0, 224, 224, 128], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [320, 640, 320, 960, 640, 320], "حالة 5")
