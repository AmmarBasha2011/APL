# مثال 273 — مسألة العلم الهولندي
# Dutch national flag
# Demonstrates: فرز ثلاث فئات في مرور واحد
#
# Run:  python apl.py examples/273-dutch-flag.apl

دالة علم(قائمة):
    المتغير منخفض = 0
    المتغير منتصف = 0
    المتغير مرتفع = طول(قائمة) - 1
    طالما منتصف <= مرتفع:
        لو قائمة[منتصف] == 0:
            المتغير مؤقت = قائمة[منخفض]
            قائمة[منخفض] = قائمة[منتصف]
            قائمة[منتصف] = مؤقت
            منخفض = منخفض + 1
            منتصف = منتصف + 1
        الا لو قائمة[منتصف] == 1:
            منتصف = منتصف + 1
        الا:
            المتغير مؤقت = قائمة[منتصف]
            قائمة[منتصف] = قائمة[مرتفع]
            قائمة[مرتفع] = مؤقت
            مرتفع = مرتفع - 1
    ارجع قائمة

اطبع علم([2, 0, 2, 1, 1, 0])
اطبع علم([2, 0, 1])
