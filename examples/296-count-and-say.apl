# مثال 296 — عد وقل
# Count and say sequence
# Demonstrates: بناء الحد التالي من السابق
#
# Run:  python apl.py examples/296-count-and-say.apl

دالة التالي(حد):
    المتغير نتيجة = ""
    المتغير ي = 0
    طالما ي < طول(حد):
        المتغير عدد = 1
        طالما ي + عدد < طول(حد) و حد[ي + عدد] == حد[ي]:
            عدد = عدد + 1
        نتيجة = نتيجة + نص(عدد) + حد[ي]
        ي = ي + عدد
    ارجع نتيجة

المتغير حد = "1"
لكل ن في نطاق(5):
    اطبع ن + 1, ":", حد
    حد = التالي(حد)
