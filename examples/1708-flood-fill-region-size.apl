# مثال 1708 — حجم المنطقة المتصلة
# Connected region size flood fill
# Demonstrates: رسوم
#
# Run:  python apl.py examples/1708-flood-fill-region-size.apl

# نبدأ من خلية
# نتوسع في الاتجاهات الأربعة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة حجم_المنطقة(شبكة, ص0, س0):
  قيمة = شبكة[ص0][س0]
  رأينا = {}
  مكدس = [[ص0, س0]]
  رأينا[نص(ص0) + "," + نص(س0)] = 1
  عد = 0
  اتجاهات = [[1, 0], [-1, 0], [0, 1], [0, -1]]
  طالما طول(مكدس) > 0:
    ح = مكدس.pop()
    عد = عد + 1
    لكل ا في اتجاهات:
      ي = ح[0] + ا[0]
      ك = ح[1] + ا[1]
      لو ي >= 0 و ي < طول(شبكة) و ك >= 0 و ك < طول(شبكة[0]):
        مفتاح = نص(ي) + "," + نص(ك)
        لو شبكة[ي][ك] == قيمة:
          لو (مفتاح في رأينا) == خطأ:
            رأينا[مفتاح] = 1
            مكدس.append([ي, ك])
  ارجع عد

ش = [[1, 1, 0], [0, 1, 0], [0, 0, 1]]
تأكد_يساوي(حجم_المنطقة(ش, 0, 0), 3, "ثلاث")
تأكد_يساوي(حجم_المنطقة(ش, 2, 2), 1, "منفردة")
تأكد_يساوي(حجم_المنطقة(ش, 0, 2), 2, "أصفار")
