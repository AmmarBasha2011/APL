# مثال 1687 — مسافة التحرير بين كلمتين
# Edit distance between two words
# Demonstrates: برمجة ديناميكية
#
# Run:  python apl.py examples/1687-edit-distance-two-words.apl

# جدول من البادئات
# نأخذ أقل كلفة من الثلاث عمليات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مسافة_تحرير(أ, ب):
  ن = طول(أ)
  م = طول(ب)
  جدول = []
  لكل ي في نطاق(ن + 1):
    صف = []
    لكل ك في نطاق(م + 1):
      صف.append(0)
    جدول.append(صف)
  لكل ي في نطاق(ن + 1):
    جدول[ي][0] = ي
  لكل ك في نطاق(م + 1):
    جدول[0][ك] = ك
  لكل ي في نطاق(1, ن + 1):
    لكل ك في نطاق(1, م + 1):
      كلفة = 1
      لو أ[ي - 1] == ب[ك - 1]:
        كلفة = 0
      جدول[ي][ك] = أصغر(أصغر(جدول[ي - 1][ك] + 1, جدول[ي][ك - 1] + 1), جدول[ي - 1][ك - 1] + كلفة)
  ارجع جدول[ن][م]

تأكد_يساوي(مسافة_تحرير("kitten", "sitting"), 3, "كلاسيكي")
تأكد_يساوي(مسافة_تحرير("abc", "abc"), 0, "متطابقتان")
تأكد_يساوي(مسافة_تحرير("", "abc"), 3, "فارغة")
