# مثال 1278 — الترتيب k بالاختيار السريع
# Kth largest with partition
# Demonstrates: تقسيم
#
# Run:  python apl.py examples/1278-kth-largest-quickselect.apl

# نقسم حول محور
# ونكمل في الجهة التي فيها الترتيب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة الاكبر_ك(أ, ك):
  ق = قائمة(أ)
  هدف = طول(ق) - ك
  يسار = 0
  يمين = طول(ق) - 1
  طالما يسار < يمين:
    محور = ق[يمين]
    ع = يسار
    لكل ج في نطاق(يسار, يمين):
      لو ق[ج] < محور:
        ت = ق[ع]
        ق[ع] = ق[ج]
        ق[ج] = ت
        ع = ع + 1
    ت = ق[ع]
    ق[ع] = ق[يمين]
    ق[يمين] = ت
    لو ع == هدف:
      ارجع ق[ع]
    والا_لو ع < هدف:
      يسار = ع + 1
    والا:
      يمين = ع - 1
  ارجع ق[هدف]

تأكد_يساوي(الاكبر_ك([3,2,1,5,6,4], 2), 5, "الثاني")
تأكد_يساوي(الاكبر_ك([3,2,3,1,2,4,5,5,6], 4), 4, "الرابع")
تأكد_يساوي(الاكبر_ك([1], 1), 1, "عنصر")
