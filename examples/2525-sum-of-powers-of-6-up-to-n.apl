# مثال 2525 — مجموع قوى 6
# Sum of powers of 6
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2525-sum-of-powers-of-6-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 6 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 7, "حالة 2")
تأكد_يساوي(ف(3), 259, "حالة 3")
تأكد_يساوي(ف(6), 55987, "حالة 4")
تأكد_يساوي(ف(10), 72559411, "حالة 5")
