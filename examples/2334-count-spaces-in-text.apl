# مثال 2334 — عدد المسافات
# Count spaces
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2334-count-spaces-in-text.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن.count(" ")

تأكد_يساوي(ف("a b c"), 2, "حالة 1")
تأكد_يساوي(ف("abc"), 0, "حالة 2")
تأكد_يساوي(ف("  "), 2, "حالة 3")
تأكد_يساوي(ف("hello world"), 1, "حالة 4")
