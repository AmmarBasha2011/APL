# مثال 496 — مولد فواتير لملف
# Invoice file generator
# Demonstrates: بناء فاتورة نصية وحفظها
#
# Run:  python apl.py examples/496-invoice-generator.apl

المتغير بنود = [
    {"بند": "تصميم موقع", "سعر": 3000},
    {"بند": "استضافة سنة", "سعر": 1200},
    {"بند": "صيانة", "سعر": 800}
]

المتغير نص_فاتورة = "===== فاتورة رقم 1042 =====\n"
المتغير إجمالي = 0
لكل بند في بنود:
    نص_فاتورة = نص_فاتورة + بند["بند"] + ": " + نص(بند["سعر"]) + " ج.م\n"
    إجمالي = إجمالي + بند["سعر"]
نص_فاتورة = نص_فاتورة + "------------------------\nالإجمالي: " + نص(إجمالي) + " ج.م\n"

اكتب("/tmp/apl-496.txt", نص_فاتورة)
اطبع اقرأ("/tmp/apl-496.txt")
احذف_ملف("/tmp/apl-496.txt")
