# مثال 1121 — مكرر يطلع على التالي
# Peeking iterator
# Demonstrates: تخزين العنصر التالي
#
# Run:  python apl.py examples/1121-peeking-iterator.apl

# نخزن العنصر التالي مسبقاً
# فيمكن عرضه دون تحريك المؤشر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مكرر_مطلع:
    دالة_إنشاء(ذات, عناصر):
        ذات.عناصر = قائمة(عناصر)
        ذات.موضع = 0

    دالة لديه_تالي(ذات):
        ارجع ذات.موضع < طول(ذات.عناصر)

    دالة اطلع(ذات):
        ارجع ذات.عناصر[ذات.موضع]

    دالة تالي(ذات):
        س = ذات.عناصر[ذات.موضع]
        ذات.موضع = ذات.موضع + 1
        ارجع س

م = مكرر_مطلع([1, 2, 3])
تأكد_يساوي(م.تالي(), 1, "التالي الأول")
تأكد_يساوي(م.اطلع(), 2, "اطلاع")
تأكد_يساوي(م.تالي(), 2, "التالي بعد الاطلاع")
تأكد_يساوي(م.تالي(), 3, "التالي الأخير")
تأكد_يساوي(م.لديه_تالي(), خطأ, "انتهى")
