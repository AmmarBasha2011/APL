# مثال 2436 — الحد النوني بخطوة 4
# Nth term step 4
# Demonstrates: أرقام
#
# Run:  python apl.py examples/2436-nth-term-arithmetic-sequence-step-4.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 4

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 7, "حالة 2")
تأكد_يساوي(ف(10), 39, "حالة 3")
تأكد_يساوي(ف(100), 399, "حالة 4")
