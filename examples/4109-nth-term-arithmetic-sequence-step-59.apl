# مثال 4109 — الحد النوني بخطوة 59
# Nth term step 59
# Demonstrates: أرقام
#
# Run:  python apl.py examples/4109-nth-term-arithmetic-sequence-step-59.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع 3 + (ن - 1) * 59

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 62, "حالة 2")
تأكد_يساوي(ف(10), 534, "حالة 3")
تأكد_يساوي(ف(100), 5844, "حالة 4")
