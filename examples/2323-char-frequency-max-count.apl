# مثال 2323 — أكبر تكرار لحرف
# Max character frequency
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2323-char-frequency-max-count.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ك = 0
  لكل ح في ن:
    لو ن.count(ح) > ك:
      ك = ن.count(ح)
  ارجع ك

تأكد_يساوي(ف("hello"), 2, "حالة 1")
تأكد_يساوي(ف("abc"), 1, "حالة 2")
تأكد_يساوي(ف("aaaa"), 4, "حالة 3")
تأكد_يساوي(ف("mississippi"), 4, "حالة 4")
