# مثال 2681 — تحويل وحدة بأساس 3
# Split by base 3
# Demonstrates: حسابات
#
# Run:  python apl.py examples/2681-minutes-to-hours-and-minutes-base-3.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 3, ن % 3]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(59), [19, 2], "حالة 2")
تأكد_يساوي(ف(60), [20, 0], "حالة 3")
تأكد_يساوي(ف(125), [41, 2], "حالة 4")
تأكد_يساوي(ف(1000), [333, 1], "حالة 5")
