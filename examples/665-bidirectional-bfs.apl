# مثال 665 — بحث عرضي ثنائي
# Bidirectional BFS
# Demonstrates: بحث ثنائي، جبهتان، أقصر طريق
#
# Run:  python apl.py examples/665-bidirectional-bfs.apl

# Assertion style:
#   دالة تأكد_يساوي(فعلي, متوقع, اسم):
#     لو فعلي != متوقع:
#       اطبع "فشل:", اسم
#       اطبع "  متوقع:", متوقع
#       اطبع "  فعلي:", فعلي
#       قياسي_نظام_اخرج(1)
#     اطبع "ناجح:", اسم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

# بحث عرضي ثنائي الاتجاه
# Demonstrates: جبهتان متعاكستان, لقاء في المنتصف, طول أقصر طريق
# نصفان من البحث أسرع من بحث كامل

رسم = {"أ": ["ب", "ج"], "ب": ["أ", "د", "ه"], "ج": ["أ", "و"], "د": ["ب"], "ه": ["ب", "ز"], "و": ["ج", "ح"], "ز": ["ه"], "ح": ["و", "ط"], "ط": ["ح"]}

دالة أقصر_ثنائي(بداية, نهاية):
  لو بداية == نهاية:
    ارجع 0
  أمام = {بداية: 0}
  خلف = {نهاية: 0}
  طالما صواب:
    أصغر = 0 - 1
    لكل عقدة في أمام:
      لو عقدة في خلف:
        م = أمام[عقدة] + خلف[عقدة]
        لو أصغر == 0 - 1 أو م < أصغر:
          أصغر = م
    لو أصغر != 0 - 1:
      ارجع أصغر
    جديدة = {}
    لكل عقدة في أمام:
      لو أمام[عقدة] == أعمق(أمام):
        لكل جار في رسم[عقدة]:
          لو (جار في أمام) == خطأ:
            جديدة[جار] = أمام[عقدة] + 1
    لكل مفتاح في جديدة:
      أمام[مفتاح] = جديدة[مفتاح]
    لو طول(أمام) >= 100:
      ارجع 0 - 1
    ت = أمام
    أمام = خلف
    خلف = ت
  ارجع 0 - 1

دالة أعمق(قاموس):
  أقصى = 0
  لكل مفتاح في قاموس:
    لو قاموس[مفتاح] > أقصى:
      أقصى = قاموس[مفتاح]
  ارجع أقصى

تأكد_يساوي(أقصر_ثنائي("أ", "ط"), 4, "من أ إلى ط")
تأكد_يساوي(أقصر_ثنائي("د", "ز"), 3, "من د إلى ز")
تأكد_يساوي(أقصر_ثنائي("أ", "أ"), 0, "نفس العقدة")
تأكد_يساوي(أقصر_ثنائي("ز", "ط"), 7, "من ز إلى ط")
اطبع "انتهى البحث"
