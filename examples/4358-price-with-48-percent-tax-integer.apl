# مثال 4358 — السعر مع ضريبة 48 بالمئة
# Price with 48 percent tax
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4358-price-with-48-percent-tax-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن + ن * 48 // 100

تأكد_يساوي(ف(100), 148, "حالة 1")
تأكد_يساوي(ف(250), 370, "حالة 2")
تأكد_يساوي(ف(999), 1478, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
