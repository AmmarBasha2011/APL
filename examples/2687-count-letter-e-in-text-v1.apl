# مثال 2687 — عدد الحرف e في النص
# Count letter e
# Demonstrates: نصوص
#
# Run:  python apl.py examples/2687-count-letter-e-in-text-v1.apl

# # ندخل النص
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن.count("e")

تأكد_يساوي(ف("elephant"), 2, "حالة 1")
تأكد_يساوي(ف("aaa"), 0, "حالة 2")
تأكد_يساوي(ف("status quo"), 0, "حالة 3")
تأكد_يساوي(ف("mississippi"), 0, "حالة 4")
