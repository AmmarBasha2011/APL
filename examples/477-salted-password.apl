# مثال 477 — تجزئة كلمة مرور بملح
# Salted password hash
# Demonstrates: ملح عشوائي وتجزئة
#
# Run:  python apl.py examples/477-salted-password.apl

بذرة(42)

دالة تجزئة(نص_الدخل):
    المتغير ناتج = 2166136261
    لكل حرف في نص_الدخل:
        ناتج = ناتج ^ ترميز_حرف(حرف)
        ناتج = (ناتج * 16777619) % 4294967296
    ارجع ناتج

المتغير ملح = نص(عشوائي_عدد(100000, 999999))
المتغير مخزنة = تجزئة("كلمتي123" + ملح)

اطبع "الملح:", ملح
اطبع "المخزنة:", مخزنة
اطبع "تحقق صحيح:", تجزئة("كلمتي123" + ملح) == مخزنة
اطبع "تحقق خاطئ:", تجزئة("خاطئة" + ملح) == مخزنة
