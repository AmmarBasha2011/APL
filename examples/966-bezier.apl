# مثال 966 — منحنى بيزيه التربيعي
# Quadratic Bezier curve
# Demonstrates: ترجيح ثلاثي بالتحكم
#
# Run:  python apl.py examples/966-bezier.apl

# منحنى بيزيه التربيعي: تقييم نقطة على المنحنى عند معامل ت
# ترجيح ثلاثي بنقاط التحكم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بيزيه(ن0, ن1, ن2, ت):
  أ = (1 - ت) * (1 - ت)
  ب = 2 * (1 - ت) * ت
  ج = ت * ت
  س = (أ * ن0[0]) + (ب * ن1[0]) + (ج * ن2[0])
  ص = (أ * ن0[1]) + (ب * ن1[1]) + (ج * ن2[1])
  ارجع [س, ص]

نقطة1 = بيزيه([0, 0], [2, 4], [4, 0], 0.5)
نقطة2 = بيزيه([0, 0], [2, 4], [4, 0], 0.25)
تأكد_يساوي(مقرب(نقطة1[0], 6), 2, "س عند المنتصف")
تأكد_يساوي(مقرب(نقطة1[1], 6), 2, "ص عند المنتصف")
تأكد_يساوي(مقرب(نقطة2[0], 6), 1, "س عند الربع")
تأكد_يساوي(مقرب(نقطة2[1], 6), 1.5, "ص عند الربع")
