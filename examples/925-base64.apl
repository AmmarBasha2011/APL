# مثال 925 — ترميز Base64
# Base64 encoding
# Demonstrates: ثلاثة بايتات لأربعة أحرف
#
# Run:  python apl.py examples/925-base64.apl

# ترميز Base64: تمثيل البايتات بأبجدية 64 حرفاً قابلة للطباعة
# كل 3 بايتات تتحول لـ 4 أحرف سداسية البتات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

أبجدية = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

دالة رمز64(نص):
  خرج = ""
  بايتات = []
  لكل i في نطاق(طول(نص)):
    بايتات.ألحق(ترميز_حرف(نص[i]))
  i = 0
  طالما i < طول(بايتات):
    عدد = 0
    لكل ج في نطاق(3):
      لو i + ج < طول(بايتات):
        عدد = عدد * 256 + بايتات[i + ج]
      والا:
        عدد = عدد * 256
    حروف = ""
    لكل ج في نطاق(4):
      حروف = حروف + أبجدية[(عدد >> (18 - ج * 6)) & 63]
    # حشوة = للبايتات الناقصة
    ناقص = 3 - (طول(بايتات) - i)
    لو ناقص > 2:
      ناقص = 2
    لو ناقص < 0:
      ناقص = 0
    حروف = حروف[:4 - ناقص]
    لكل _ في نطاق(ناقص):
      حروف = حروف + "="
    خرج = خرج + حروف
    i = i + 3
  ارجع خرج

اطبع "APL ->", رمز64("APL")
اطبع "Ma ->", رمز64("Ma")
اطبع "M ->", رمز64("M")

تأكد_يساوي(رمز64("APL"), "QVBM", "ثلاثة بايتات كاملة")
تأكد_يساوي(رمز64("Ma"), "TWE=", "بايتان وحشوة")
تأكد_يساوي(رمز64("M"), "TQ==", "بايت وحشوتان")
تأكد_يساوي(رمز64("hello"), "aGVsbG8=", "كلمة أطول")

# كل حرف ناتج من الأبجدية أو حشوة
ناتج = رمز64("Instinct")
لكل i في نطاق(طول(ناتج)):
  حرف = ناتج[i]
  موجود = حرف == "="
  لكل ج في نطاق(64):
    لو أبجدية[ج] == حرف:
      موجود = 1 == 1
  لو موجود == خطأ:
    اطبع "فشل: حرف غريب", حرف
    قياسي_نظام_اخرج(1)
اطبع "ناجح: كل الأحرف شرعية"
