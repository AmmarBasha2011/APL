# مثال 1134 — مسارات مع عوائق
# Unique paths with obstacles
# Demonstrates: جدول
#
# Run:  python apl.py examples/1134-unique-paths-obstacles.apl

# كل خانة تساوي مسارات الأعلى والأيسر
# والعائق صفر مسارات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة مسارات(ش):
  ص = طول(ش)
  ج = طول(ش[0])
  د = []
  لكل ر في نطاق(ص):
    د.ألحق([0] * ج)
  لكل ر في نطاق(ص):
    لكل ك في نطاق(ج):
      لو ش[ر][ك] == 1:
        د[ر][ك] = 0
      والا_لو (ر == 0) و (ك == 0):
        د[ر][ك] = 1
      والا:
        من_اعلى = 0
        من_يسار = 0
        لو ر > 0:
          من_اعلى = د[ر - 1][ك]
        لو ك > 0:
          من_يسار = د[ر][ك - 1]
        د[ر][ك] = من_اعلى + من_يسار
  ارجع د[ص - 1][ج - 1]

تأكد_يساوي(مسارات([[0,0,0],[0,1,0],[0,0,0]]), 2, "عائق في الوسط")
تأكد_يساوي(مسارات([[0,1],[0,0]]), 1, "عائق صغير")
تأكد_يساوي(مسارات([[1,0]]), 0, "البداية مسدودة")
تأكد_يساوي(مسارات([[0,0,0],[0,0,0],[0,0,0]]), 6, "بلا عوائق")
