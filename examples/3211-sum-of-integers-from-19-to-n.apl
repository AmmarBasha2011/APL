# مثال 3211 — مجموع الأعداد من 19 إلى ن
# Sum from 19 to n
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3211-sum-of-integers-from-19-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(19, ن + 1):
    م = م + ي
  ارجع م

تأكد_يساوي(ف(19), 19, "حالة 1")
تأكد_يساوي(ف(20), 39, "حالة 2")
تأكد_يساوي(ف(29), 264, "حالة 3")
تأكد_يساوي(ف(100), 4879, "حالة 4")
