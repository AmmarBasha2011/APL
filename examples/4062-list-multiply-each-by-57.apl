# مثال 4062 — ضرب كل عنصر في 57
# Multiply each item by 57
# Demonstrates: قوائم
#
# Run:  python apl.py examples/4062-list-multiply-each-by-57.apl

# # نمرر القائمة
# # ونتحقق من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل ع في ق:
    ر = ر + [ع * 57]
  ارجع ر

تأكد_يساوي(ف([3, 1, 2]), [171, 57, 114], "حالة 1")
تأكد_يساوي(ف([5]), [285], "حالة 2")
تأكد_يساوي(ف([1, 2, 3, 4, 5, 6]), [57, 114, 171, 228, 285, 342], "حالة 3")
تأكد_يساوي(ف([-2, 0, 7, 7, 4]), [-114, 0, 399, 399, 228], "حالة 4")
تأكد_يساوي(ف([10, 20, 10, 30, 20, 10]), [570, 1140, 570, 1710, 1140, 570], "حالة 5")
