# مثال 528 — تحقق لون للبطاقات
# Luhn card check
# Demonstrates: خوارزمية لون، تحقق بطاقات
#
# Run:  python apl.py examples/528-luhn-check.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# تحقق لون لأرقام البطاقات
دالة لون_صالح(رقم):
    المتغير م = 0
    المتغير ضاعف = خطأ
    لكل i في نطاق(طول(رقم), 0, -1):
        المتغير ر = صحيح(رقم[i-1])
        لو ضاعف:
            ر = ر * 2
            لو ر > 9:
                ر = ر - 9
        م = م + ر
        ضاعف = ليس ضاعف
    ارجع م % 10 == 0

تأكد_يساوي(لون_صالح("4539578763621486"), صواب, "لون: صالح")
تأكد_يساوي(لون_صالح("4539578763621487"), خطأ, "لون: خاطئ")
تأكد_يساوي(لون_صالح("79927398713"), صواب, "لون: مثال كلاسيكي")
