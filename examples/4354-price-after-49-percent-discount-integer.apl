# مثال 4354 — السعر بعد خصم 49 بالمئة
# Price after 49 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/4354-price-after-49-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 49 // 100

تأكد_يساوي(ف(100), 51, "حالة 1")
تأكد_يساوي(ف(250), 128, "حالة 2")
تأكد_يساوي(ف(999), 510, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
