# مثال 2009 — التحقق من مصفوفة جبلية
# Valid mountain array
# Demonstrates: قوائم
#
# Run:  python apl.py examples/2009-valid-mountain-array-check.apl

# # نصعد ما أمكن ثم ننزل ما أمكن
# # يجب أن نصل للنهاية وأن تكون القمة داخلية

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جبل(ق):
  ن = طول(ق)
  لو ن < 3:
    ارجع خطأ
  ك = 0
  طالما ك + 1 < ن و ق[ك] < ق[ك + 1]:
    ك = ك + 1
  لو ك == 0 أو ك == ن - 1:
    ارجع خطأ
  طالما ك + 1 < ن و ق[ك] > ق[ك + 1]:
    ك = ك + 1
  ارجع ك == ن - 1

تأكد_يساوي(جبل([0, 3, 2, 1]), صواب, "جبل")
تأكد_يساوي(جبل([3, 5, 5]), خطأ, "قمة مسطحة")
تأكد_يساوي(جبل([2, 1]), خطأ, "قصير")
تأكد_يساوي(جبل([0, 2, 3, 4, 5, 2, 1, 0]), صواب, "طويل")
