# مثال 1293 — مجموعة بالتجزئة
# Design a hash set
# Demonstrates: جداول تجزئة
#
# Run:  python apl.py examples/1293-hash-set-design.apl

# المجموعة سطول قوائم
# الإضافة لا تكرر العنصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف مجموعة_تجزئة:
  دالة_إنشاء(ذات):
    ذات.سطول = []
    لكل ع في نطاق(11):
      ذات.سطول.ألحق([])

  دالة اضف(ذات, م):
    لو م ليس في ذات.سطول[م % 11]:
      ذات.سطول[م % 11].ألحق(م)

  دالة ازل(ذات, م):
    لو م في ذات.سطول[م % 11]:
      ذات.سطول[م % 11].remove(م)

  دالة يحوي(ذات, م):
    ارجع م في ذات.سطول[م % 11]

م = مجموعة_تجزئة()
م.اضف(1)
م.اضف(2)
م.اضف(1)
تأكد_يساوي(م.يحوي(1), صواب, "موجود")
تأكد_يساوي(م.يحوي(3), خطأ, "غير موجود")
م.ازل(2)
تأكد_يساوي(م.يحوي(2), خطأ, "بعد الإزالة")
م.ازل(1)
تأكد_يساوي(م.يحوي(1), خطأ, "إزالة بعد تكرار")
