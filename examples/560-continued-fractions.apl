# مثال 560 — الكسر المستمر لجذر
# Continued fractions
# Demonstrates: كسر مستمر، جذر غير نسبي، دورة
#
# Run:  python apl.py examples/560-continued-fractions.apl

دالة تأكد_يساوي(فعلي, متوقع, اسم):
    لو فعلي != متوقع:
        اطبع "فشل:", اسم, "| متوقع:", متوقع, "| فعلي:", فعلي
        قياسي_نظام_اخرج(1)
    اطبع "ناجح:", اسم


# الكسر المستمر لجذر غير نسبي
دالة كسر_مستمر_جذر(ن, حد):
    المتغير أ0 = جذر_صحيح(ن)
    المتغير نتيجة = [أ0]
    المتغير م = 0
    المتغير د = 1
    المتغير أ = أ0
    لكل i في نطاق(حد):
        م = د * أ - م
        د = (ن - م * م) // د
        أ = (أ0 + م) // د
        نتيجة.أضف(أ)
    ارجع نتيجة

تأكد_يساوي(كسر_مستمر_جذر(23, 4), [4, 1, 3, 1, 8], "جذر 23")
تأكد_يساوي(كسر_مستمر_جذر(2, 5), [1, 2, 2, 2, 2, 2], "جذر 2 دوري")
