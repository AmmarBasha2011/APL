# مثال 998 — ترددات نوتات MIDI
# MIDI note frequency
# Demonstrates: سلم معتدل بأس ثنائي
#
# Run:  python apl.py examples/998-midi-freq.apl

# نوتات MIDI إلى ترددات: السلم المعتدل باثنتي عشرة درجة نصفية
# كل نوتة تبعد عن لا المرجعية بأس ثنائي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة تردد(نوتة):
  ارجع 440 * (2 ** ((نوتة - 69) / 12))

تأكد_يساوي(مقرب(تردد(69), 2), 440, "لا المرجعية")
تأكد_يساوي(مقرب(تردد(60), 2), 261.63, "دو الوسطى")
تأكد_يساوي(مقرب(تردد(81), 2), 880, "لا الأوكتاف الأعلى")
تأكد_يساوي(مقرب(تردد(57), 2), 220, "لا الأوكتاف الأدنى")
