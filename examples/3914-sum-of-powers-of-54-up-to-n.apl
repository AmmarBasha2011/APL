# مثال 3914 — مجموع قوى 54
# Sum of powers of 54
# Demonstrates: أرقام
#
# Run:  python apl.py examples/3914-sum-of-powers-of-54-up-to-n.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في نطاق(ن + 1):
    م = م + 54 ** ي
  ارجع م

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 55, "حالة 2")
تأكد_يساوي(ف(3), 160435, "حالة 3")
تأكد_يساوي(ف(6), 25262739811, "حالة 4")
تأكد_يساوي(ف(10), 214810491326522851, "حالة 5")
