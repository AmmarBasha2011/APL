# مثال 1212 — قطر شجرة
# Diameter of binary tree
# Demonstrates: تكرار ذاتي
#
# Run:  python apl.py examples/1212-tree-diameter-list.apl

# نحسب عمق كل فرع عند كل عقدة
# وأطول مسار يمر بها هو مجموع عمقي فرعيها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة عمق_وقطر(ش):
  لو طول(ش) == 0:
    ارجع [0, 0]
  ي = عمق_وقطر(ش[1])
  ن = عمق_وقطر(ش[2])
  عمق_ = 1 + أكبر(ي[0], ن[0])
  قطر_ = أكبر(ي[0] + ن[0], أكبر(ي[1], ن[1]))
  ارجع [عمق_, قطر_]

شجرة = [1, [2, [4, [], []], [5, [], []]], [3, [], []]]
تأكد_يساوي(عمق_وقطر(شجرة)[1], 3, "ثلاثة")
تأكد_يساوي(عمق_وقطر([1, [2, [], []], []])[1], 1, "واحد")
تأكد_يساوي(عمق_وقطر([])[1], 0, "فارغة")
