# مثال 3750 — السعر بعد خصم 30 بالمئة
# Price after 30 percent discount
# Demonstrates: حسابات
#
# Run:  python apl.py examples/3750-price-after-30-percent-discount-integer.apl

# # ندخل القيم
# # ونقارن النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن - ن * 30 // 100

تأكد_يساوي(ف(100), 70, "حالة 1")
تأكد_يساوي(ف(250), 175, "حالة 2")
تأكد_يساوي(ف(999), 700, "حالة 3")
تأكد_يساوي(ف(0), 0, "حالة 4")
