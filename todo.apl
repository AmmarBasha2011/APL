# مدير المهام (To-Do List)
استورد json

المتغير ملف_المهام = "tasks.json"

دالة تحميل_المهام():
    حاول:
        المتغير م = فتح(ملف_المهام, "r", ترميز="utf-8")
        المتغير محتوى = اقرأ(م)
        المتغير بيانات = جسون(محتوى)
        اغلق(م)
        ارجع بيانات
    إمسك:
        ارجع []

دالة حفظ_المهام(مهام):
    المتغير م = فتح(ملف_المهام, "w", ترميز="utf-8")
    المتغير نص = جسون_تحويل(مهام, تأكد_من_ascii=خطأ, مسافة_بادئة=2)
    اكتب(م, نص)
    اغلق(م)

دالة عرض_المهام(مهام):
    لو طول(مهام) == 0:
        اطبع "لا توجد مهام"
        ارجع
    
    اطبع "------- المهام -------"
    المتغير ع = 1
    لكل مهمة في مهام:
        المتغير         حالة = "✓" إذا مهمة[1] والا "✗"
        اطبع ع, "-", حالة, مهمة[0]
        ع = ع + 1
    اطبع "---------------------"

دالة إضافة_مهمة(مهام, نص):
    مهام.أضف([نص, خطأ])
    حفظ_المهام(مهام)
    اطبع "تمت الإضافة:", نص

دالة إكمال_مهمة(مهام, رقم):
    لو رقم >= 1 و رقم <= طول(مهام):
        مهام[رقم - 1][1] = صواب
        حفظ_المهام(مهام)
        اطبع "تم الإكمال:", مهام[رقم - 1][0]
    الا:
        اطبع "رقم غير صحيح"

دالة حذف_مهمة(مهام, رقم):
    لو رقم >= 1 و رقم <= طول(مهام):
        المتغير محذوف = مهام.حذف(رقم - 1)
        حفظ_المهام(مهام)
        اطبع "تم الحذف:", محذوف[0]
    الا:
        اطبع "رقم غير صحيح"

المتغير المهام = تحميل_المهام()
اطبع "=== مدير المهام ==="

طالما صواب:
    اطبع ""
    اطبع "1- عرض المهام"
    اطبع "2- إضافة مهمة"
    اطبع "3- إكمال مهمة"
    اطبع "4- حذف مهمة"
    اطبع "5- خروج"
    
    المتغير خيار = صحيح(ادخل("اختر: "))
    
    لو خيار == 1:
        عرض_المهام(المهام)
    الا لو خيار == 2:
        المتغير نص = ادخل("أدخل المهمة: ")
        إضافة_مهمة(المهام, نص)
    الا لو خيار == 3:
        عرض_المهام(المهام)
        المتغير ر = صحيح(ادخل("رقم المهمة للإكمال: "))
        إكمال_مهمة(المهام, ر)
    الا لو خيار == 4:
        عرض_المهام(المهام)
        المتغير ر = صحيح(ادخل("رقم المهمة للحذف: "))
        حذف_مهمة(المهام, ر)
    الا لو خيار == 5:
        اطبع "مع السلامة"
        توقف
    الا:
        اطبع "اختيار غير صحيح"
