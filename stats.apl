# محلل إحصائي بسيط
استورد math

دالة أدخل_أرقام():
    المتغير أرقام = []
    اطبع "أدخل أرقاما (اكتب 'q' للانتهاء):"
    
    طالما صواب:
        المتغير مدخل = ادخل("> ")
        لو مدخل == "q":
            توقف
        حاول:
            أرقام.أضف(عشري(مدخل))
        إمسك:
            اطبع "إدخال غير صحيح"
    
    ارجع أرقام

دالة متوسط(أرقام):
    ارجع مجموع(أرقام) / طول(أرقام)

دالة تباين(أرقام):
    المتغير م = متوسط(أرقام)
    المتغير مجموع_تربيع = 0
    لكل س في أرقام:
        مجموع_تربيع = مجموع_تربيع + (س - م) ** 2
    ارجع مجموع_تربيع / طول(أرقام)

دالة انحراف_معياري(أرقام):
    ارجع جذر(تباين(أرقام))

دالة أصغر_وكبير(أرقام):
    ارجع [أصغر(أرقام), أكبر(أرقام)]

المتغير أرقام = أدخل_أرقام()

لو طول(أرقام) == 0:
    اطبع "لم تدخل أي أرقام"
    اخرج

اطبع "=== النتائج ==="
اطبع "الأرقام:", أرقام
اطبع "العدد:", طول(أرقام)
اطبع "المجموع:", مجموع(أرقام)
اطبع "المتوسط:", متوسط(أرقام)
اطبع "التباين:", تباين(أرقام)
اطبع "الانحراف المعياري:", انحراف_معياري(أرقام)
المتغير م = أصغر_وكبير(أرقام)
اطبع "الأصغر:", م[0], "الأكبر:", م[1]
اطبع "الفرز:", مفرز(أرقام)
