{
  "name": "ammar-apl", "displayName": "APL Arabic", "version": "0.1.0",
  "description": "Arabic APL syntax, snippets, completion, hover and diagnostics",
  "engines": {"vscode": "^1.90.0"}, "categories": ["Programming Languages"],
  "main": "./extension.js", "activationEvents": ["onLanguage:apl"],
  "contributes": {
    "languages": [{"id": "apl", "aliases": ["APL Arabic"], "extensions": [".apl"], "configuration": "./language-configuration.json"}],
    "grammars": [{"language": "apl", "scopeName": "source.apl", "path": "./syntaxes/apl.tmLanguage.json"}],
    "snippets": [{"language": "apl", "path": "./snippets/apl.json"}],
    "configuration": {"title": "APL", "properties": {
      "apl.executable": {"type": "string", "default": "apl", "description": "Installed APL command or absolute executable path."}
    }}
  },
  "scripts": {"test": "node --test test/*.test.js"}
}
