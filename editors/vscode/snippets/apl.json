{
  "اطبع": {
    "prefix": "اطبع",
    "body": [
      "اطبع ${1:نص}"
    ],
    "description": "طباعة"
  },
  "دالة": {
    "prefix": "دالة",
    "body": [
      "دالة ${1:اسم}(${2:وسائط}):",
      "    ${3:ارجع ${4:القيمة}}"
    ],
    "description": "تعريف دالة"
  },
  "صنف": {
    "prefix": "صنف",
    "body": [
      "صنف ${1:الاسم}:",
      "    دالة_إنشاء(ذات, ${2:وسائط}):",
      "        ذات.${3:خاصية} = ${4:قيمة}"
    ],
    "description": "تعريف صنف"
  },
  "حاول": {
    "prefix": "حاول",
    "body": [
      "حاول:",
      "    ${1:الكود}",
      "امسك مثل خطأ:",
      "    اطبع \"حصل خطأ: \" + نص(خطأ)",
      "أخيراً:",
      "    ${2:تمرير}"
    ],
    "description": "معالجة الأخطاء"
  },
  "لكل": {
    "prefix": "لكل",
    "body": [
      "لكل ${1:عنصر} في ${2:قائمة}:",
      "    ${3:اطبع ${1:عنصر}}"
    ],
    "description": "حلقة تكرار"
  },
  "لو": {
    "prefix": "لو",
    "body": [
      "لو ${1:شرط}:",
      "    ${2:الكود}",
      "والا:",
      "    ${3:الكود}"
    ],
    "description": "شرط"
  },
  "ادخل": {
    "prefix": "ادخل",
    "body": [
      "المتغير ${1:اسم} = ادخل(\"${2:سؤالك؟} \")"
    ],
    "description": "قراءة من المستخدم"
  },
  "استورد ملف": {
    "prefix": "استورد",
    "body": [
      "استورد \"${1:ملف}.apl\""
    ],
    "description": "استيراد ملف APL"
  }
}
