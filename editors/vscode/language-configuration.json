{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\\\s*(حاول|امسك.*|أخيراً|صنف .*|دالة .*|لو .*|الا لو .*|والا|لكل .*|طالما .*|قيمة.*|حالة.*|مع .*):\\\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\\\s*(والا|الا لو|امسك|أخيراً|قيمة|حالة)\\\\b"
  },
  "wordPattern": "[\\\\p{L}\\\\p{N}_]+"
}
